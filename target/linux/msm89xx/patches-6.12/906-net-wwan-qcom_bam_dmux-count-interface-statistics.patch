From: Yoonji Park <koreapyj@dcmys.kr>
Subject: [PATCH] net: wwan: qcom_bam_dmux: count interface statistics

The driver never updates the netdev statistics, so rx/tx packet and byte
counters of the BAM-DMUX network interfaces always read 0 while traffic
flows. Count received/transmitted packets (payload length, without the
BAM-DMUX header) and dropped packets.

--- a/drivers/net/wwan/qcom_bam_dmux.c	2026-11-12 18:07:16.022955964 +0000
+++ b/drivers/net/wwan/qcom_bam_dmux.c	2026-11-12 18:07:16.035956123 +0000
@@ -337,6 +337,7 @@
 	struct bam_dmux_netdev *bndev = netdev_priv(netdev);
 	struct bam_dmux *dmux = bndev->dmux;
 	struct bam_dmux_skb_dma *skb_dma;
+	unsigned int len = skb->len;
 	int active, ret;
 
 	skb_dma = bam_dmux_tx_queue(dmux, skb);
@@ -359,16 +360,20 @@
 		if (!atomic_long_fetch_or(BIT(skb_dma - dmux->tx_skbs),
 					  &dmux->tx_deferred_skb))
 			queue_pm_work(&dmux->tx_wakeup_work);
-		return NETDEV_TX_OK;
+		goto out;
 	}
 
 	if (!bam_dmux_skb_dma_submit_tx(skb_dma))
 		goto drop;
 
 	dma_async_issue_pending(dmux->tx);
+out:
+	DEV_STATS_INC(netdev, tx_packets);
+	DEV_STATS_ADD(netdev, tx_bytes, len);
 	return NETDEV_TX_OK;
 
 drop:
+	DEV_STATS_INC(netdev, tx_dropped);
 	bam_dmux_tx_done(skb_dma);
 	dev_kfree_skb_any(skb);
 	return NETDEV_TX_OK;
@@ -514,6 +519,7 @@
 	if (hdr->len > BAM_DMUX_MAX_DATA_SIZE) {
 		dev_err(dmux->dev, "Data larger than buffer? (%u > %u)\n",
 			hdr->len, (u16)BAM_DMUX_MAX_DATA_SIZE);
+		DEV_STATS_INC(netdev, rx_dropped);
 		return;
 	}
 
@@ -536,6 +542,8 @@
 		break;
 	}
 
+	DEV_STATS_INC(netdev, rx_packets);
+	DEV_STATS_ADD(netdev, rx_bytes, skb->len);
 	netif_receive_skb(skb);
 }
 

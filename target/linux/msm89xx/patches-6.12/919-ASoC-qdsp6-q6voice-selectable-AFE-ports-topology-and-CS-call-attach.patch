+static void q6voice_path_unwind(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *rt = p->runtime;
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm = rt->sessions[Q6VOICE_SERVICE_MVM];
+	struct q6voice_session *cvs = rt->sessions[Q6VOICE_SERVICE_CVS];
+	struct q6voice_session *cvp = rt->sessions[Q6VOICE_SERVICE_CVP];
+	int ret;
+
+	if (rt->voice_started) {
+		ret = q6mvm_start(mvm, false);
+		if (ret)
+			dev_err(dev, "failed to stop voice: %d\n", ret);
+		rt->voice_started = false;
+	}
+
+	if (rt->attached_cvs) {
+		ret = q6cvs_attach(cvs, cvp, false);
+		if (ret)
+			dev_err(dev, "failed to detach cvp from cvs: %d\n", ret);
+		rt->attached_cvs = false;
+	}
+
+	if (rt->attached_mvm) {
+		ret = q6mvm_attach(mvm, cvp, false);
+		if (ret)
+			dev_err(dev, "failed to detach cvp from mvm: %d\n", ret);
+		rt->attached_mvm = false;
+	}
+
+	if (rt->cvp_enabled) {
+		ret = q6cvp_enable(cvp, false);
+		if (ret)
+			dev_err(dev, "failed to disable cvp: %d\n", ret);
+		rt->cvp_enabled = false;
+	}
+}
+
+static void q6voice_path_release_sessions(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *rt = p->runtime;
+	enum q6voice_service_type svc;
+
+	/* destroy the vocproc first, the passive sessions last */
+	if (rt->sessions[Q6VOICE_SERVICE_CVP]) {
+		q6voice_session_release(rt->sessions[Q6VOICE_SERVICE_CVP]);
+		rt->sessions[Q6VOICE_SERVICE_CVP] = NULL;
+	}
+	for (svc = 0; svc < Q6VOICE_SERVICE_COUNT; ++svc) {
+		if (rt->sessions[svc]) {
+			q6voice_session_release(rt->sessions[svc]);
+			rt->sessions[svc] = NULL;
+		}
+	}
+}

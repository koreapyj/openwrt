-			hdr->opcode, s->result);
+			opcode, status);
+		q6voice_trace_cmd(s, opcode, -EIO, status);
 		return -EIO;
 	}
 
+	q6voice_trace_cmd(s, opcode, 0, status);
 	return 0;
 }

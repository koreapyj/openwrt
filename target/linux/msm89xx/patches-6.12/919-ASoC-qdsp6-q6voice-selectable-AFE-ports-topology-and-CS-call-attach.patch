 #include "q6cvs.h"
 #include "q6voice-common.h"
 
+#define VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION	0x00011140
+
+struct vss_istream_cmd_create_passive_control_session_cmd {
+	struct apr_hdr hdr;
+
+	/* Name of the session to share with its full controller */
+	char name[20];
+} __packed;
+
+#define VSS_ISTREAM_CMD_ATTACH_VOCPROC			0x000110F8
+#define VSS_ISTREAM_CMD_DETACH_VOCPROC			0x000110F9
+
+/* Attach/detach a vocproc to/from the stream */
+struct vss_istream_cmd_attach_vocproc_cmd {
+	struct apr_hdr hdr;
+
+	/* Handle of the vocproc */
+	u16 handle;
+} __packed;
+
+static const char *q6cvs_session_name(enum q6voice_path_type path)
+{
+	switch (path) {
+	case Q6VOICE_PATH_VOICE:
+		return "default modem voice";
+	case Q6VOICE_PATH_VOLTE:
+		return "default volte voice";
+	default:
+		return NULL;
+	}
+}
+
+/*
+ * Join the stream the modem created for the circuit switched call as passive
+ * controller.
+ */
+struct q6voice_session *q6cvs_session_create(enum q6voice_path_type path)
+{
+	struct vss_istream_cmd_create_passive_control_session_cmd cmd = {};
+	const char *name = q6cvs_session_name(path);
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION;
+	if (name)
+		strscpy(cmd.name, name, sizeof(cmd.name));
+
+	return q6voice_session_create(Q6VOICE_SERVICE_CVS, path, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_session_create);
+
+int q6cvs_attach(struct q6voice_session *cvs, struct q6voice_session *cvp,
+		 bool state)
+{
+	struct vss_istream_cmd_attach_vocproc_cmd cmd = {};
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = state ? VSS_ISTREAM_CMD_ATTACH_VOCPROC :
+				 VSS_ISTREAM_CMD_DETACH_VOCPROC;
+	cmd.handle = cvp->handle;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_attach);
+
 static int q6cvs_probe(struct apr_device *adev)
 {
 	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVS);

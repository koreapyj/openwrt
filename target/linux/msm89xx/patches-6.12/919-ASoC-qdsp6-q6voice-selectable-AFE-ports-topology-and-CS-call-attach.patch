+static int q6voice_resolve_port(int afe_port, int index)
+{
+	if (afe_port == Q6VOICE_PORT_AUTO)
+		afe_port = q6afe_get_port_id(index);
+	if (afe_port <= 0 || afe_port >= 0xffff)
+		return -EINVAL;
+	return afe_port;

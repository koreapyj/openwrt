+/**
+ * q6voice_start_path() - start a voice path with an explicit configuration
+ *
+ * @v: voice instance
+ * @path: voice path
+ * @cfg: AFE ports, topologies and call flow variant to use. The ports are
+ *	raw AFE port ids, so that ports without a DAI (e.g. the RT proxy
+ *	ports 0x2000/0x2001) can be used. The AFE ports must already be
+ *	started by the caller.
+ *
+ * Unlike the DAI path (q6voice_start()) this does not wait for both
+ * directions: the path is started immediately and marked as running for both,
+ * until q6voice_stop_path() is called. On failure nothing is left behind on
+ * the DSP, so the call can be retried with another configuration.
+ */
+int q6voice_start_path(struct q6voice *v, enum q6voice_path_type path,
+		       const struct q6voice_path_cfg *cfg)
+{
+	struct q6voice_path *p = &v->paths[path];
+	struct q6voice_path_cfg saved;
+	int ret;
+
+	mutex_lock(&p->lock);
+	if (p->runtime) {
+		ret = -EBUSY;
+		goto out;
+	}
+	p->runtime = kzalloc(sizeof(*p->runtime), GFP_KERNEL);
+	if (!p->runtime) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	saved = p->cfg;
+	p->cfg = *cfg;
+	ret = q6voice_path_start(p);
+	p->cfg = saved;
+	if (ret) {
+		q6voice_path_destroy(p);
+		goto out;
+	}
+	p->runtime->started = 3;
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_start_path);
+
+int q6voice_stop_path(struct q6voice *v, enum q6voice_path_type path)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (p->runtime->started == 3)
+		q6voice_path_stop(p);
+	q6voice_path_destroy(p);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_stop_path);
+
+/**
+ * q6voice_set_path_cfg() - set the configuration used by the DAI path
+ */
+void q6voice_set_path_cfg(struct q6voice *v, enum q6voice_path_type path,
+			  const struct q6voice_path_cfg *cfg)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	mutex_lock(&p->lock);
+	p->cfg = *cfg;
+	mutex_unlock(&p->lock);
+}
+EXPORT_SYMBOL_GPL(q6voice_set_path_cfg);

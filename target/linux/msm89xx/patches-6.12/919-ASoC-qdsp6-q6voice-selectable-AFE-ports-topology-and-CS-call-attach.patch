-	s->expected_opcode = hdr->opcode;
-	s->result = 0;
+	s->expected_opcode = opcode;
+	s->result = Q6VOICE_STATUS_NO_RESPONSE;
 	spin_unlock_irqrestore(&s->lock, flags);
 
 	ret = apr_send_pkt(s->svc->adev, (struct apr_pkt *)hdr);
-	if (ret < 0)
+	if (ret < 0) {
+		q6voice_trace_cmd(s, opcode, ret, Q6VOICE_STATUS_NO_RESPONSE);
 		return ret;
+	}
 
 	ret = wait_event_timeout(s->wait, (s->expected_opcode == 0),
 				 msecs_to_jiffies(TIMEOUT_MS));
 	if (!ret) {
+		spin_lock_irqsave(&s->lock, flags);
 		s->expected_opcode = 0;
+		spin_unlock_irqrestore(&s->lock, flags);
+		q6voice_trace_cmd(s, opcode, -ETIMEDOUT,
+				  Q6VOICE_STATUS_NO_RESPONSE);
 		return -ETIMEDOUT;
 	}
 
-	if (s->result > 0) {
+	status = s->result;
+	if (status > 0) {

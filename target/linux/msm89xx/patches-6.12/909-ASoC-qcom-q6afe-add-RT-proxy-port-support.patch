+/**
+ * q6afe_rt_proxy_port_prepare() - Prepare a real-time proxy afe port.
+ *
+ * @port: Instance of afe port
+ * @cfg: RT proxy port configuration
+ *
+ * The configuration is sent to the DSP by q6afe_port_start().
+ */
+void q6afe_rt_proxy_port_prepare(struct q6afe_port *port,
+				 struct q6afe_rt_proxy_cfg *cfg)
+{
+	struct afe_param_id_rt_proxy_port_cfg *pcfg = &port->port_cfg.rtproxy;
+
+	pcfg->rt_proxy_cfg_minor_version = AFE_API_VERSION_RT_PROXY_CONFIG;
+	pcfg->bit_width = cfg->bit_width;
+	pcfg->interleaved = 1;
+	pcfg->frame_size = cfg->frame_size;
+	pcfg->jitter_allowance = cfg->jitter_allowance;
+	pcfg->low_water_mark = cfg->low_water_mark;
+	pcfg->high_water_mark = cfg->high_water_mark;
+	pcfg->sample_rate = cfg->sample_rate;
+	pcfg->num_channels = cfg->num_channels;
+	pcfg->reserved = 0;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_prepare);
+
+static int q6afe_rt_proxy_port_driver_cmd(struct q6afe_port *port, u32 opcode)
+{
+	struct afe_service_cmd_rt_port_driver *cmd;
+	struct q6afe *afe = port->afe;
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+	void *p;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd);
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = 0;
+	pkt->hdr.dest_port = 0;
+	pkt->hdr.token = port->token;
+	pkt->hdr.opcode = opcode;
+	cmd->port_id = port->id;
+
+	ret = afe_apr_send_pkt(afe, pkt, port, opcode);
+	if (ret)
+		dev_err(afe->dev, "AFE RT port driver cmd 0x%x for port 0x%x failed %d\n",
+			opcode, port->id, ret);
+
+	kfree(pkt);
+	return ret;
+}
+
+/**
+ * q6afe_rt_proxy_port_register() - Register as the driver of a RT proxy port
+ *
+ * @port: Instance of RT proxy afe port
+ * @ops: callbacks for read/write completions and port events
+ * @priv: passed back to the callbacks
+ *
+ * The callbacks are installed before the DSP is told, so no event is missed.
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_rt_proxy_port_register(struct q6afe_port *port,
+				 const struct q6afe_rt_proxy_ops *ops,
+				 void *priv)
+{
+	int ret;
+
+	if (!q6afe_port_is_rt_proxy(port) || !ops)
+		return -EINVAL;
+
+	mutex_lock(&port->rt_lock);
+	if (port->rt_ops) {
+		mutex_unlock(&port->rt_lock);
+		return -EBUSY;
+	}
+	port->rt_ops = ops;
+	port->rt_priv = priv;
+	mutex_unlock(&port->rt_lock);
+
+	ret = q6afe_rt_proxy_port_driver_cmd(port,
+				AFE_SERVICE_CMD_REGISTER_RT_PORT_DRIVER);
+	if (ret) {
+		mutex_lock(&port->rt_lock);
+		port->rt_ops = NULL;
+		port->rt_priv = NULL;
+		mutex_unlock(&port->rt_lock);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_register);
+
+/**
+ * q6afe_rt_proxy_port_unregister() - Unregister from a RT proxy port
+ *
+ * @port: Instance of RT proxy afe port
+ *
+ * The callbacks are removed even if the DSP does not acknowledge the
+ * command; once this returns no callback is running or will run.
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_rt_proxy_port_unregister(struct q6afe_port *port)
+{
+	int ret;
+
+	if (!q6afe_port_is_rt_proxy(port))
+		return -EINVAL;
+
+	ret = q6afe_rt_proxy_port_driver_cmd(port,
+				AFE_SERVICE_CMD_UNREGISTER_RT_PORT_DRIVER);
+
+	mutex_lock(&port->rt_lock);
+	port->rt_ops = NULL;
+	port->rt_priv = NULL;
+	mutex_unlock(&port->rt_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_unregister);
+
+static int q6afe_rt_proxy_port_data_cmd(struct q6afe_port *port, u32 opcode,
+					dma_addr_t buf, u32 mem_map_handle,
+					u32 bytes, u32 cookie)
+{
+	struct afe_port_data_cmd_rt_proxy_port *cmd;
+	struct q6afe *afe = port->afe;
+	struct {
+		struct apr_hdr hdr;
+		struct afe_port_data_cmd_rt_proxy_port cmd;
+	} __packed pkt = {};
+	int ret;
+
+	if (!q6afe_port_is_rt_proxy(port) || !bytes ||
+	    cookie > AFE_TOKEN_COOKIE_MAX)
+		return -EINVAL;
+
+	/* the data direction is fixed by the port: 0x2000 out, 0x2001 in */
+	if ((opcode == AFE_PORT_DATA_CMD_RT_PROXY_PORT_READ_V2) !=
+	    (port->id == AFE_PORT_ID_RT_PROXY_PORT_001_RX))
+		return -EINVAL;
+
+	cmd = &pkt.cmd;
+	pkt.hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					  APR_HDR_LEN(APR_HDR_SIZE),
+					  APR_PKT_VER);
+	pkt.hdr.pkt_size = sizeof(pkt);
+	pkt.hdr.src_port = 0;
+	pkt.hdr.dest_port = 0;
+	pkt.hdr.token = port->token | (cookie << AFE_TOKEN_COOKIE_SHIFT);
+	pkt.hdr.opcode = opcode;
+
+	cmd->port_id = port->id;
+	cmd->buffer_address_lsw = lower_32_bits(buf);
+	cmd->buffer_address_msw = upper_32_bits(buf);
+	cmd->mem_map_handle = mem_map_handle;
+	cmd->available_bytes = bytes;
+
+	/* completion is reported through ops->data_done, nothing to wait for */
+	ret = apr_send_pkt(afe->apr, (struct apr_pkt *)&pkt);
+	if (ret < 0) {
+		dev_err(afe->dev, "RT proxy cmd 0x%x not transmitted (%d)\n",
+			opcode, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * q6afe_rt_proxy_port_read() - Hand an empty buffer to the RT proxy RX port
+ *
+ * @port: Instance of RT proxy RX afe port (0x2000)
+ * @buf: bus address of the buffer, inside a region mapped with
+ *	q6afe_memory_map()
+ * @mem_map_handle: handle of that mapping
+ * @bytes: number of bytes, must equal the configured frame size
+ * @cookie: returned in &q6afe_rt_proxy_ops.data_done, at most 24 bits
+ *
+ * Does not sleep. Completion is reported asynchronously.
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_rt_proxy_port_read(struct q6afe_port *port, dma_addr_t buf,
+			     u32 mem_map_handle, u32 bytes, u32 cookie)
+{
+	return q6afe_rt_proxy_port_data_cmd(port,
+				AFE_PORT_DATA_CMD_RT_PROXY_PORT_READ_V2,
+				buf, mem_map_handle, bytes, cookie);
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_read);
+
+/**
+ * q6afe_rt_proxy_port_write() - Send a buffer of data to the RT proxy TX port
+ *
+ * @port: Instance of RT proxy TX afe port (0x2001)
+ * @buf: bus address of the buffer, inside a region mapped with
+ *	q6afe_memory_map()
+ * @mem_map_handle: handle of that mapping
+ * @bytes: number of valid bytes, must equal the configured frame size
+ * @cookie: returned in &q6afe_rt_proxy_ops.data_done, at most 24 bits
+ *
+ * Does not sleep. Completion is reported asynchronously.
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_rt_proxy_port_write(struct q6afe_port *port, dma_addr_t buf,
+			      u32 mem_map_handle, u32 bytes, u32 cookie)
+{
+	return q6afe_rt_proxy_port_data_cmd(port,
+				AFE_PORT_DATA_CMD_RT_PROXY_PORT_WRITE_V2,
+				buf, mem_map_handle, bytes, cookie);
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_write);
+
+/**
+ * q6afe_memory_map() - Map a physically contiguous buffer into the AFE
+ *
+ * @dev: Pointer to afe child device.
+ * @phys: physical address of the buffer, 4 KiB aligned
+ * @size: size of the buffer in bytes, multiple of 4 KiB
+ * @mem_map_handle: returns the handle to use in data commands
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_memory_map(struct device *dev, phys_addr_t phys, size_t size,
+		     u32 *mem_map_handle)
+{
+	struct afe_service_shared_map_region_payload *region;
+	struct afe_service_cmd_shared_mem_map_regions *cmd;
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+	void *p;
+
+	if (!IS_ALIGNED(phys, SZ_4K) || !size || !IS_ALIGNED(size, SZ_4K) ||
+	    size > U32_MAX)
+		return -EINVAL;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + sizeof(*region);
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	region = p + APR_HDR_SIZE + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = 0;
+	pkt->hdr.dest_port = 0;
+	pkt->hdr.token = 0;
+	pkt->hdr.opcode = AFE_SERVICE_CMD_SHARED_MEM_MAP_REGIONS;
+
+	cmd->mem_pool_id = AFE_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+	region->shm_addr_lsw = lower_32_bits(phys);
+	region->shm_addr_msw = upper_32_bits(phys);
+	region->mem_size_bytes = size;
+
+	mutex_lock(&afe->map_lock);
+	ret = afe_apr_send_pkt(afe, pkt, NULL,
+			       AFE_SERVICE_CMDRSP_SHARED_MEM_MAP_REGIONS);
+	if (ret)
+		dev_err(afe->dev, "AFE memory map failed %d\n", ret);
+	else
+		*mem_map_handle = afe->mem_map_handle;
+	mutex_unlock(&afe->map_lock);
+
+	kfree(pkt);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_memory_map);
+
+/**
+ * q6afe_memory_unmap() - Remove a mapping created by q6afe_memory_map()
+ *
+ * @dev: Pointer to afe child device.
+ * @mem_map_handle: handle returned by q6afe_memory_map()
+ *
+ * Return: Will be an negative value on failure or zero on success
+ */
+int q6afe_memory_unmap(struct device *dev, u32 mem_map_handle)
+{
+	struct afe_service_cmd_shared_mem_unmap_regions *cmd;
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+	void *p;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd);
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = 0;
+	pkt->hdr.dest_port = 0;
+	pkt->hdr.token = 0;
+	pkt->hdr.opcode = AFE_SERVICE_CMD_SHARED_MEM_UNMAP_REGIONS;
+	cmd->mem_map_handle = mem_map_handle;
+
+	ret = afe_apr_send_pkt(afe, pkt, NULL,
+			       AFE_SERVICE_CMD_SHARED_MEM_UNMAP_REGIONS);
+	if (ret)
+		dev_err(afe->dev, "AFE memory unmap failed %d\n", ret);
+
+	kfree(pkt);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_memory_unmap);
+
+/**
+ * q6afe_get_last_dsp_status() - Status of the last DSP command that waited
+ *
+ * @dev: Pointer to afe child device.
+ *
+ * Diagnostic helper: the raw DSP status (ADSP_E*) of the most recent
+ * synchronous AFE command, or 0xffffffff if the DSP did not answer it.
+ */
+u32 q6afe_get_last_dsp_status(struct device *dev)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+
+	return READ_ONCE(afe->last_status);
+}
+EXPORT_SYMBOL_GPL(q6afe_get_last_dsp_status);

+ * @data_done: a read/write submitted with q6afe_rt_proxy_port_read() or
+ *	q6afe_rt_proxy_port_write() completed. @cookie is the value passed at
+ *	submission, @status the DSP status (0 on success; for a read the buffer
+ *	has been filled on success).
+ * @event: the DSP sent a Q6AFE_RT_PROXY_EVENT_* notification.
+ *
+ * Both callbacks run in process context from the APR receive workqueue and
+ * must neither sleep for long nor call q6afe_rt_proxy_port_unregister().
+ */
+struct q6afe_rt_proxy_ops {
+	void (*data_done)(void *priv, u32 cookie, u32 status);
+	void (*event)(void *priv, u32 event);
+};

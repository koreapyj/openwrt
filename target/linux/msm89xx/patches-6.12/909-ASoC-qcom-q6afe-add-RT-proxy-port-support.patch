+static struct q6afe_port *q6afe_find_port_by_id(struct q6afe *afe, int port_id)
+{
+	struct q6afe_port *p;
+	struct q6afe_port *ret = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&afe->port_list_lock, flags);
+	list_for_each_entry(p, &afe->port_list, node)
+		if (p->id == port_id) {
+			ret = p;
+			kref_get(&p->refcount);
+			break;
+		}
+
+	spin_unlock_irqrestore(&afe->port_list_lock, flags);
+	return ret;
+}
+
+static bool q6afe_port_is_rt_proxy(struct q6afe_port *port)
+{
+	return port->id == AFE_PORT_ID_RT_PROXY_PORT_001_RX ||
+	       port->id == AFE_PORT_ID_RT_PROXY_PORT_001_TX;
+}
+
+static void q6afe_rt_proxy_data_done(struct q6afe_port *port, u32 cookie,
+				     u32 status)
+{
+	mutex_lock(&port->rt_lock);
+	if (port->rt_ops && port->rt_ops->data_done)
+		port->rt_ops->data_done(port->rt_priv, cookie, status);
+	mutex_unlock(&port->rt_lock);
+}
+
+static void q6afe_rt_proxy_event(struct q6afe *afe,
+				 struct afe_event_rt_proxy_port_status *ev)
+{
+	struct q6afe_port *port;
+
+	port = q6afe_find_port_by_id(afe, ev->port_id);
+	if (!port)
+		return;
+
+	mutex_lock(&port->rt_lock);
+	if (port->rt_ops && port->rt_ops->event)
+		port->rt_ops->event(port->rt_priv, ev->event);
+	mutex_unlock(&port->rt_lock);
+	kref_put(&port->refcount, q6afe_port_free);
+}

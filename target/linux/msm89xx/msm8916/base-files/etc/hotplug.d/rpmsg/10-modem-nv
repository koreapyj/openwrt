#
# The HiMI modem firmware on these boards reads NV item 2500 once, 300 s
# after every modem start, and stops its RF task 600 s later unless the item
# holds "HiMI_OK". The firmware clears the item itself while it starts, so
# the stock userspace rewrites it after each modem start. Do the same over
# the modem DIAG channel, once the start-up clear is safely over.

[ "$ACTION" = add ] || exit 0

case "$DEVICENAME" in
*:smd-edge.DIAG.-1.-1) ;;
*) exit 0 ;;
esac

. /lib/functions.sh

case "$(board_name)" in
generic,ufi-esim) ;;
*) exit 0 ;;
esac

# one read() on the channel returns one DIAG message
diag_xfer() {
	dd bs=4096 count=1 <&3 2>/dev/null | hexdump -v -e '1/1 "%02x"' > "$tmp" &
	cat >&3
	sleep 1
	kill $! 2>/dev/null
	cat "$tmp"
}

himi_nv() {
	local sys="/sys$DEVPATH" drv=/sys/bus/rpmsg/drivers/rpmsg_chrdev
	local tmp="/tmp/modem_nv.$$" node i resp

	sleep 45

	[ -e "$sys" ] || return
	[ -e "$sys/driver" ] && {
		logger -t modem_nv "modem DIAG channel is in use, NV 2500 not written"
		return
	}

	echo rpmsg_chrdev > "$sys/driver_override"
	echo "$DEVICENAME" > "$drv/bind"
	for i in 1 2 3 4 5; do
		node=$(ls "$sys/rpmsg" 2>/dev/null | head -n1)
		[ -n "$node" ] && [ -c "/dev/$node" ] && break
		node=
		sleep 1
	done

	if [ -n "$node" ]; then
		exec 3<>"/dev/$node"
		# DIAG NV_WRITE_F (0x27), item 2500, 128 data bytes, HDLC-framed
		{
			printf '\047\304\011HiMI_OK'
			head -c 123 /dev/zero
			printf '\027\135\176'
		} | diag_xfer > /dev/null
		# DIAG NV_READ_F (0x26), item 2500
		resp=$({
			printf '\046\304\011'
			head -c 130 /dev/zero
			printf '\215\175\135\176'
		} | diag_xfer)
		exec 3>&-
		rm -f "$tmp"

		case "$resp" in
		26c40948694d495f4f4b*)
			logger -t modem_nv "NV 2500 set to HiMI_OK"
			;;
		*)
			logger -t modem_nv "NV 2500 not set, read back: $(echo "$resp" | head -c 22)"
			;;
		esac
	else
		logger -t modem_nv "DIAG char device did not appear"
	fi

	echo "$DEVICENAME" > "$drv/unbind"
	echo > "$sys/driver_override"
}

himi_nv < /dev/null > /dev/null 2>&1 &

From: akbar-npj <https://github.com/akbar-npj/msm8916-openwrt>
Subject: [PATCH] wifi: wcn36xx: only send the multicast list when associated as a station

The firmware handles multicast filtering only for an associated station.
Sending the list in AP mode or before association fails with
HAL_8023_MULTICAST_LIST err=16.

Source: https://github.com/akbar-npj/msm8916-openwrt (openwrt-overlay/package/kernel/mac80211/patches/ath/450-wcn36xx-only-send-mc-list-when-sta-associated.patch)
---
--- a/drivers/net/wireless/ath/wcn36xx/main.c
+++ b/drivers/net/wireless/ath/wcn36xx/main.c
@@ -445,10 +445,13 @@ static void wcn36xx_configure_filter(str
 		vif = wcn36xx_priv_to_vif(tmp);
 
 		/* FW handles MC filtering only when connected as STA */
-		if (*total & FIF_ALLMULTI)
-			wcn36xx_smd_set_mc_list(wcn, vif, NULL);
-		else if (NL80211_IFTYPE_STATION == vif->type && tmp->sta_assoc)
-			wcn36xx_smd_set_mc_list(wcn, vif, fp);
+		if (NL80211_IFTYPE_STATION == vif->type && tmp->sta_assoc &&
+		    tmp->bss_index != WCN36XX_HAL_BSS_INVALID_IDX) {
+			if (*total & FIF_ALLMULTI)
+				wcn36xx_smd_set_mc_list(wcn, vif, NULL);
+			else
+				wcn36xx_smd_set_mc_list(wcn, vif, fp);
+		}
 	}
 
 	mutex_unlock(&wcn->conf_mutex);

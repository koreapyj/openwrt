#!/bin/sh /etc/rc.common

START=60
STOP=40
USE_PROCD=1

PROG=/usr/bin/rmtfs

start_service() {
	# -P: modem EFS partitions by label (resolved via sysfs, no udev needed)
	# -s: shared memory from sysfs. Never pass -r: modem EFS writes must persist.
	procd_open_instance
	procd_set_param command "$PROG" -P -s
	procd_set_param respawn 3600 1 0
	procd_set_param stderr 1
	procd_close_instance
}

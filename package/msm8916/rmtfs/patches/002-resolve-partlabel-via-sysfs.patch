+/*
+ * Without udev there is no /dev/disk/by-partlabel: find the block device
+ * whose PARTNAME matches in /sys/class/block/<dev>/uevent instead.
+ */
+static int resolve_partlabel(const char *label, char *out, size_t outlen)
+{
+	char path[300], line[128], devname[64];
+	struct dirent *de;
+	DIR *dir;
+	FILE *f;
+	int found = 0;
+
+	dir = opendir("/sys/class/block");
+	if (!dir)
+		return -1;
+
+	while (!found && (de = readdir(dir))) {
+		if (de->d_name[0] == '.')
+			continue;
+		snprintf(path, sizeof(path), "/sys/class/block/%s/uevent", de->d_name);
+		f = fopen(path, "r");
+		if (!f)
+			continue;
+		devname[0] = '\0';
+		while (fgets(line, sizeof(line), f)) {
+			line[strcspn(line, "\n")] = '\0';
+			if (!strncmp(line, "DEVNAME=", 8))
+				snprintf(devname, sizeof(devname), "%s", line + 8);
+			else if (!strncmp(line, "PARTNAME=", 9) && !strcmp(line + 9, label))
+				found = 1;
+		}
+		fclose(f);
+		if (found && devname[0])
+			snprintf(out, outlen, "/dev/%s", devname);
+		else
+			found = 0;
+	}
+	closedir(dir);
+
+	return found ? 0 : -1;
+}

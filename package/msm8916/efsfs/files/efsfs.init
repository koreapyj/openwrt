#!/bin/sh /etc/rc.common
# Read-only modem EFS view. Opt-in: set enabled=1 in /etc/config/efsfs.
# procd stops it with SIGTERM; libfuse then leaves its loop and unmounts.
START=90
STOP=10
USE_PROCD=1

start_service() {
	local enabled mountpoint

	config_load efsfs
	config_get_bool enabled main enabled 0
	config_get mountpoint main mountpoint /mnt/efs
	[ "$enabled" = 1 ] || return 0

	mkdir -p "$mountpoint"
	procd_open_instance
	procd_set_param command /usr/sbin/efsfs -f "$mountpoint"
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger efsfs
}

#!/bin/sh /etc/rc.common

START=65
STOP=35
USE_PROCD=1

PROG=/usr/sbin/msm-diag-bridge
TTY=/dev/ttyGS1

start_service() {
	# needs a gadget with a second ACM function, e.g. the msm8916-diag preset:
	#   uci set usbgadget.@preset[0].name=msm8916-diag; uci commit usbgadget
	[ -c "$TTY" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" "$TTY"
	procd_set_param respawn 3600 3 0
	procd_set_param stderr 1
	procd_close_instance
}

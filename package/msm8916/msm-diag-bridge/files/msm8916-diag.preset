config gadget 'g1'
	option idVendor '0x1d6b'
	option idProduct '0x0104'
	option bDeviceClass '0xef'
	option bDeviceSubClass '0x02'
	option bDeviceProtocol '0x01'
	option product 'OpenWrt MSM8916 LTE Stick'

config configuration 'cfg1'
	option configuration 'NCM+ACM+DIAG'
	option gadget 'g1'

# usb0: LAN
config function 'ncm1'
	option function 'ncm'
	option configuration 'cfg1'

# ttyGS0: console (usbgadget-console)
config function 'acm1'
	option function 'acm'
	option configuration 'cfg1'

# ttyGS1: modem DIAG (msm-diag-bridge)
config function 'acm2'
	option function 'acm'
	option configuration 'cfg1'

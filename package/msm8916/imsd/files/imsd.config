# imsd: AP side IMS stack (voice and SMS for LAN SIP clients). Opt-in.
config imsd 'main'
	option enabled '0'
	# error | warn | notice | info | debug
	option log_level 'info'

	# IMS bearer. Depending on the subscription the IMS APN is either its own PDN or the
	# LTE attach default bearer; imsd does the same in both cases (create_bearer + connect + get).
	option apn 'IMS'
	option ip_type 'ipv6'
	option profile_id '6'

	# P-CSCF: the list the network gave with the IMS bearer is used first. These static
	# addresses are only the fallback when the bearer has none. The ISIM FQDNs are never used
	# (they resolve to a server without IPsec sec-agree).
	# list pcscf '2001:db8::1'
	option pcscf_port '5060'

	# requested registration time in seconds (the network's grant wins)
	option expires '8000'
	# P-Access-Network-Info: by default built from the serving cell the modem reports
	# (3GPP-E-UTRAN-FDD; utran-cell-id-3gpp=<MCC><MNC><TAC><ECI>, refreshed at registration and when a call or SMS
	# starts). Set only to force a fixed value.
	# option pani '3GPP-E-UTRAN-FDD; utran-cell-id-3gpp=4500620EB3161703'

	# local ports for the unprotected and the protected (IPsec) SIP sockets, fresh pair for every registration
	option port_min '8000'
	option port_max '8999'
	# routing table (and rule priority) of the IMS netdev: ip rule from <ims address> lookup <table>
	option route_table '1006'
	# retry backoff after every P-CSCF failed, seconds
	option backoff_min '5'
	option backoff_max '900'

	# bench use: enable a disabled modem; pin the modem (device or object path); identity overrides
	option manage_modem '0'
	# option modem '/sys/devices/platform/soc@0/...'
	# option impi '450061051226862@lte-lguplus.co.kr'
	# option impu 'sip:01051226862@lte-lguplus.co.kr'
	# option domain 'lte-lguplus.co.kr'

	# LAN side: imsd is a small SIP registrar for softphones / ATAs on the LAN. The SIP socket is bound to the
	# lan_ifname interface only (SO_BINDTODEVICE), on its first IPv4 address unless lan_addr is given. If the
	# interface has no address yet imsd retries every few seconds (`ubus call imsd status`: lan.state).
	# Changing any of the options in this block restarts the LAN side on reload (devices register again).
	option lan_ifname 'br-lan'
	# option lan_addr '192.168.1.1'
	option lan_sip_port '5060'
	# REGISTER lifetime limits in seconds (a shorter request gets 423) and the default when the device names none
	option reg_min_expires '60'
	option reg_max_expires '3600'
	option reg_default_expires '3600'
	# registered devices at most (the next REGISTER gets 503)
	option max_bindings '16'
	# seconds between OPTIONS pings of every binding, 0 = off
	option keepalive '0'
	option user_agent 'imsd'

	# Media: RTP ports (even ports are used) of the LAN leg and of the carrier leg (IMS netdev). The two ranges
	# must not overlap each other or the Gm port range (port_min/port_max); 8 ports at least, ~2 per call.
	option rtp_port_min '16384'
	option rtp_port_max '16482'
	option carrier_rtp_port_min '50000'
	option carrier_rtp_port_max '50098'
	# Opus encoder towards the LAN device (bit/s, complexity 0..10; 5 suits a Cortex-A53)
	option opus_bitrate '24000'
	option opus_complexity '5'
	# 0 removes G.722 from the offer (also from lan_codecs)
	option g722 '1'
	# codec preference order offered to LAN devices: any of opus g722 pcma
	option lan_codecs 'opus g722 pcma'

	# Calls ---------------------------------------------------------------------------------------------
	# seconds an incoming call rings the LAN devices before the network gets 480 (0 = none: the network decides)
	option ring_timeout '60'
	# seconds without RTP from the network before a call is hung up (0 = off; not counted while on hold)
	option rtp_timeout '30'
	# Session-Expires asked for in our INVITEs (the network's answer wins; refreshed by imsd)
	option session_expires '1800'
	# phone-context of dialled local numbers; default: the home network domain of the ISIM (EF_DOMAIN)
	# option phone_context 'lte-lguplus.co.kr'
	# Contact feature tags of INVITE / 200 OK, with the leading ';'; default: the mmtel icsi tag
	# option contact_params ';+g.3gpp.icsi-ref="urn%3Aurn-7%3A3gpp-service.ims.icsi.mmtel"'
	# User-Agent towards the network; default 'TTA-VoLTE/3.0 imsd/<version> Device_Type/Android_Phone OMD'
	# (towards the LAN devices imsd sends the user_agent above)
	# option ims_user_agent 'TTA-VoLTE/3.0 imsd/0.1 Device_Type/Android_Phone OMD'
	# bench: an incoming call while no LAN device is registered waits for `ubus call imsd call_answer` instead of 480
	option bench_incoming '0'

	# Backend: IMS (VoLTE) or circuit switched calls through the modem -------------------------------------
	# auto | ims | cs. auto follows a handset: on 2G / 3G, and on LTE when the SIM has no usable IMS (or IMS did not register
	# within ims_grace seconds), calls go circuit switched through the modem (uqmid voice calls; the call audio is the modem's PCM
	# sound card). On LTE with IMS registered VoLTE is used. ims = IMS only (the CS call path is not started); cs = circuit switched
	# only (no IMS bearer, no registration, nothing IMS is touched; needs the voice sound card kernel modules). With cs / auto the
	# modem is taken from `modem` / `manage_modem` above. SMS over the circuit switched path goes through the modem; MMS works in that mode when the operator has an MMS APN (the built-in table: SKT, its MVNO 45011, KT; or uci mms_apn): see the MMS section.
	option backend 'auto'
	# the modem's PCM device: empty / auto = the first rtproxy sound card, device 0; auto,1 = modem-native VoLTE audio; or <card>,<device>
	# option cs_pcm_device 'auto'
	# MO: open the audio at the alerting state so the caller hears the network's ringback / announcements (0: only at the answer)
	option cs_early_media '1'
	# seconds an outgoing circuit switched call may alert before imsd hangs up (0 = off; the network decides)
	option cs_ring_timeout '120'
	# alerting shorter than this and then ended by the far end is reported as rejected (603), else as no answer (480)
	# option cs_short_ring_ms '4000'
	# circuit switched calls while registered as roaming
	# option cs_allow_roaming '1'
	# a stall of the modem's capture stream this long ends a connected circuit switched call (ms, 0 = off)
	# option cs_media_stall_ms '1500'
	# seconds after which a concatenated circuit switched SMS that is still missing parts is deleted from the modem
	# option cs_sms_incomplete '600'
	# auto: seconds the LTE attach waits for IMS to register before circuit switched takes over; seconds IMS is kept after its
	# registration was lost; seconds IMS must have been registered before circuit switched hands over to it
	option ims_grace '45'
	option backend_switch_delay '20'
	option backend_ims_settle '10'

	# SMS -----------------------------------------------------------------------------------------------
	# SMSC for outgoing SMS; default: the USIM (EF_SMSP). Without either, outgoing SMS get 503.
	# option smsc '+821080010585'
	# SMS-over-IP gateway (sip: URI), an explicit override. Default (empty), like a handset: the card's EF_PSISMSC when it has
	# one, else imsd's built-in operator table (keyed by the SIM's MCC/MNC; LG U+ is in it). For an operator that is in neither,
	# outgoing SMS get 503 until this is set. `ubus call imsd status` shows the value and its source under "sms".
	# option sms_psi 'sip:ipsmgw.lte-lguplus.co.kr'
	# put "(1/2) " in front of the parts of a concatenated SMS delivered to the LAN devices
	option sms_concat_prefix '1'
	# ask the network for delivery reports of outgoing SMS
	option sms_delivery_reports '0'
	# incoming SMS while no LAN device is registered AND the store (below) is off or unusable: ack (acknowledge, only logged) |
	# rperror22 (RP-ERROR "memory exceeded": the network keeps and retries it). With the store working nothing is ever lost this way.
	option sms_lost_policy 'ack'

	# MMS (receiving; sending through the MMS proxy below) ----------------------------------------------------
	# An incoming MMS is announced by the network in a WAP Push (binary SMS to port 2948). Like a handset, imsd fetches the message
	# by HTTP over the IMS bearer (names resolve only through the DNS servers of that bearer), delivers its text to the LAN devices as
	# SIP MESSAGE (X-MMS: 1) and tells the MMSC (M-NotifyResp.ind / M-Acknowledge.ind). Pictures and other attachments are not sent to
	# the devices: they are saved under mms_dir and the text carries a link (served by uhttpd through /www/imsd-mms, made by the init
	# script). Devices that register with the feature tags +g.imsd.mms / +g.imsd.carbons use the MMS proxy below (original messages,
	# sending, copies of what the other devices sent). https:// Content-Locations are not supported.
	option mms '1'
	# MMSC URL the confirmations (M-NotifyResp.ind / M-Acknowledge.ind) are POSTed to, an explicit override. Default (empty), like an
	# Android handset: imsd's built-in operator table keyed by the SIM's MCC/MNC (LG U+: http://omammsc.uplus.co.kr:9084). The SIM
	# is deliberately not consulted (EF_MMSICP is not read by handsets and often holds another operator's leftover template).
	# For an operator that is not in the table the confirmations go to the server of the Content-Location (a warning is logged
	# once); a server that refuses them (HTTP 404/405) makes the network resend the message: set the MMSC here then.
	# option mmsc 'http://omammsc.uplus.co.kr:9084'
	# The data connection of the MMS client, like a handset's APN table (src/carrier.c: the SIM's MCC/MNC first, then the registered network's):
	#  - an operator without an MMS APN in its entry (LG U+) uses the IMS PDN, as before;
	#  - an operator with one (SK Telecom and its MVNO 45011 Korea Cable Telecom: lte.sktelecom.com + the MMS proxy smart.nate.com:9093; KT: lte.ktfwing.com,
	#    NOT tested) gets an on-demand bearer: brought up through uqmid when there is MMS work, kept mms_bearer_linger seconds after the last,
	#    then disconnected and deleted. Nothing but MMS traffic (DNS of the bearer's servers, TCP to the MMS proxy / MMSC) may leave through it:
	#    imsd installs an nftables table of its own (imsd_mms) for that and brings no bearer up when it cannot. Values of the table, overridable:
	# option mms_apn 'lte.sktelecom.com'
	# option mms_ip_type 'ipv4v6'
	# option mms_proxy 'smart.nate.com:9093'
	# option mms_user_agent 'Android-Mms/2.0'
	# option mms_accept '*/*, application/vnd.wap.mms-message, application/vnd.wap.sic'
	option mms_bearer_linger '20'
	# routing table (and rule priority) of the MMS bearer's netdev; the main table is never touched
	option mms_route_table '1007'
	# x-wap-profile header (UAProf URL) of the requests; default: none
	# option mms_uaprof 'http://example.invalid/uaprof.xml'
	# largest message fetched, bytes (a bigger one is refused with M-NotifyResp.ind "Rejected")
	option mms_max_size '1048576'
	# attachments: a tmpfs directory (lost at reboot). Every message gets a random 128 bit directory name, files keep sanitised names.
	# Retention: at most this many messages, bytes and days (0 days = no age limit); the oldest goes first.
	option mms_dir '/tmp/imsd-mms'
	option mms_keep_messages '50'
	option mms_keep_bytes '16777216'
	option mms_keep_days '7'
	# prefix of the attachment links; default (empty): http://<LAN address>/imsd-mms/
	# option mms_url_base 'http://192.168.1.1/imsd-mms/'
	# bytes of text per SIP MESSAGE (a longer text is split on character boundaries and marked "(1/3) ")
	option mms_text_split '1000'

	# MMS proxy: imsd acts as an MMSC for the LAN. Standard MMS clients (devices that register with +g.imsd.mms) send M-Send.req and
	# fetch M-Retrieve.conf over plain HTTP on this TCP port of the LAN address (no TLS, no authentication: the LAN is trusted, like
	# the SIP side); imsd relays to the operator's MMSC over the IMS bearer. 0 = off (those devices then get the text like the others).
	option mms_proxy_port '8090'
	# seconds a message fetched through the proxy is kept (tmpfs, <mms_dir>-proxy) so that several devices do not fetch it again; 0 = no cache
	option mms_proxy_cache '600'
	# copies of the messages one device sent (SMS and MMS) to the other devices that register with +g.imsd.carbons: 1 = on, 0 = off
	option carbons '1'

	# Message store -----------------------------------------------------------------------------------------
	# Every received SMS / MMS and every copy of what another device sent gets a line-wide, increasing sequence number and is kept on
	# flash, so that a device that was not registered when it arrived (phones lose their registration often) gets it at its next
	# REGISTER, in order, with the header X-IMSD-Seq. Each device has a cursor; a device may report its own with the REGISTER header
	# X-IMSD-Ack-Seq. A device is identified by its Contact +sip.instance, else by the user name of the registered address (so plain
	# phones need distinct user names). Items leave only by the limits below (oldest first). Incoming MMS are always retrieved by imsd
	# itself and kept (including the message body), so /mms/fetch works for as long as the item is kept.
	# 0 = off: nothing is kept, a message that nobody takes is lost as before.
	option store '1'
	# FLASH (eMMC / f2fs overlay): created by the init script, mode 0700. Every message costs a few small synced writes (see docs/imsd.md).
	option store_dir '/srv/imsd'
	# 1 = the LAN registrar's bindings are saved to <store_dir>/bindings (also with store 0) and restored at start, so that the phones
	# stay reachable across `imsd restart`; 0 = off. Read at start. A few small writes per hour (see docs/imsd.md).
	option lan_persist '1'
	option store_keep_messages '500'
	# Age limit in days, 0 = none (default). It compares the wall clock at storage time with the current one. A stick without
	# RTC and without NTP (no internet) gets a different clock on every boot, and a jump forward would delete fresh messages:
	# set this only where the system clock is reliable. Device records unseen for 30 days are also only dropped with it set.
	option store_keep_days '0'
	# bytes, stored MMS bodies included
	option store_keep_bytes '33554432'

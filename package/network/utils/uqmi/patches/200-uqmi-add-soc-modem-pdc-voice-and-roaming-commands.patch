+
+/* --pdc-delete-config */
+
+#define cmd_pdc_delete_config_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_delete_config_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_pdc_delete_config_request data = {
+		QMI_INIT(config_type, pdc_config_type),
+		QMI_INIT(token, ++pdc_token),
+	};
+	uint8_t id[PDC_ID_MAX];
+	unsigned int id_n;
+
+	if (!pdc_id_parse(arg, id, &id_n)) {
+		uqmi_add_error("Invalid configuration ID (expected hex string)");
+		return QMI_CMD_EXIT;
+	}
+
+	qmi_set_ptr(&data, id, id);
+	data.data.id_n = id_n;
+	qmi_set_pdc_delete_config_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}

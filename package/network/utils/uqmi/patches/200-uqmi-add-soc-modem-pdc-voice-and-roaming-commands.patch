+ * Boston, MA 02110-1301 USA.
+ */
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "qmi-message.h"
+#include "voice-util.h"
+
+#define VOICE_IND_ALL_CALL_STATUS	0x002e
+
+/* Adds a "calls" array to the blob buffer; shared by get-all-call-info and the indications */
+static void voice_add_calls(struct blob_buf *b, const char *name,
+			    const struct voice_call_info *calls, unsigned int n_calls,
+			    const struct voice_call_number *numbers, unsigned int n_numbers)
+{
+	unsigned int i, j;
+	void *a, *c;
+
+	a = blobmsg_open_array(b, name);
+	for (i = 0; i < n_calls; i++) {
+		c = blobmsg_open_table(b, NULL);
+		blobmsg_add_u32(b, "id", calls[i].id);
+		blobmsg_add_string(b, "state", voice_call_state_name(calls[i].state));
+		blobmsg_add_string(b, "type", voice_call_type_name(calls[i].type));
+		blobmsg_add_string(b, "direction", voice_call_direction_name(calls[i].direction));
+		blobmsg_add_string(b, "mode", voice_call_mode_name(calls[i].mode));
+		for (j = 0; j < n_numbers; j++) {
+			if (numbers[j].id != calls[i].id || !numbers[j].number ||
+			    !numbers[j].number[0])
+				continue;
+
+			blobmsg_add_string(b, "number", numbers[j].number);
+			break;
+		}
+		blobmsg_close_table(b, c);
+	}
+	blobmsg_close_array(b, a);
+}
+
+static bool voice_parse_id(const char *arg, char **end, uint8_t *id)
+{
+	unsigned long val;
+
+	if (!arg[0])
+		return false;
+
+	val = strtoul(arg, end, 0);
+	if (*end == arg || val > 0xff)
+		return false;
+
+	*id = val;
+	return true;
+}
+
+static bool voice_parse_id_arg(char *arg, uint8_t *id)
+{
+	char *end;
+
+	if (voice_parse_id(arg, &end, id) && !*end)
+		return true;
+
+	uqmi_add_error("Invalid call ID");
+	return false;
+}
+
+/* Splits "<id>,<value>" and returns the value part */
+static char *voice_parse_id_value(char *arg, uint8_t *id)
+{
+	char *end;
+
+	if (!voice_parse_id(arg, &end, id) || *end != ',' || !end[1]) {
+		uqmi_add_error("Invalid argument (expected <id>,<value>)");
+		return NULL;
+	}
+
+	return end + 1;
+}
+
+/* --voice-dial */
+
+static void
+cmd_voice_dial_cb(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct qmi_voice_dial_call_response res;
+
+	qmi_parse_voice_dial_call_response(msg, &res);
+	if (res.set.call_id)
+		blobmsg_add_u32(&status, NULL, res.data.call_id);
+}
+
+static enum qmi_cmd_result
+cmd_voice_dial_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	/* keep call status indications arriving before --voice-indications runs */
+	qmi_indication_buffer(qmi, QMI_SERVICE_VOICE);
+	struct qmi_voice_dial_call_request data = {
+		QMI_INIT_PTR(calling_number, arg),
+	};
+
+	qmi_set_voice_dial_call_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-end-call */
+
+#define cmd_voice_end_call_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_end_call_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	/* keep call status indications arriving before --voice-indications runs */
+	qmi_indication_buffer(qmi, QMI_SERVICE_VOICE);
+	struct qmi_voice_end_call_request data = {};
+	uint8_t id;
+
+	if (!voice_parse_id_arg(arg, &id))
+		return QMI_CMD_EXIT;
+
+	qmi_set(&data, call_id, id);
+	qmi_set_voice_end_call_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-answer-call */
+
+#define cmd_voice_answer_call_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_answer_call_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	/* keep call status indications arriving before --voice-indications runs */
+	qmi_indication_buffer(qmi, QMI_SERVICE_VOICE);
+	struct qmi_voice_answer_call_request data = {};
+	uint8_t id;
+
+	if (!voice_parse_id_arg(arg, &id))
+		return QMI_CMD_EXIT;
+
+	qmi_set(&data, call_id, id);
+	qmi_set_voice_answer_call_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-get-all-call-info */
+
+static void
+cmd_voice_get_all_call_info_cb(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct qmi_voice_get_all_call_info_response res;
+	struct voice_call_info calls[VOICE_MAX_CALLS];
+	struct voice_call_number numbers[VOICE_MAX_CALLS];
+	unsigned int i, n_calls, n_numbers;
+
+	qmi_parse_voice_get_all_call_info_response(msg, &res);
+
+	n_calls = res.data.call_information_n;
+	if (n_calls > ARRAY_SIZE(calls))
+		n_calls = ARRAY_SIZE(calls);
+	for (i = 0; i < n_calls; i++) {
+		calls[i].id = res.data.call_information[i].id;
+		calls[i].state = res.data.call_information[i].state;
+		calls[i].type = res.data.call_information[i].type;
+		calls[i].direction = res.data.call_information[i].direction;
+		calls[i].mode = res.data.call_information[i].mode;
+	}
+
+	n_numbers = res.data.remote_party_number_n;
+	if (n_numbers > ARRAY_SIZE(numbers))
+		n_numbers = ARRAY_SIZE(numbers);
+	for (i = 0; i < n_numbers; i++) {
+		numbers[i].id = res.data.remote_party_number[i].id;
+		numbers[i].number = res.data.remote_party_number[i].type;
+	}
+
+	voice_add_calls(&status, NULL, calls, n_calls, numbers, n_numbers);
+}
+
+static enum qmi_cmd_result
+cmd_voice_get_all_call_info_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	qmi_set_voice_get_all_call_info_request(msg);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-burst-dtmf */
+
+#define cmd_voice_burst_dtmf_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_burst_dtmf_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_voice_burst_dtmf_request data = {};
+	uint8_t id;
+	char *digits;
+
+	digits = voice_parse_id_value(arg, &id);
+	if (!digits)
+		return QMI_CMD_EXIT;
+
+	if (strlen(digits) > 0xff) {
+		uqmi_add_error("Too many digits");
+		return QMI_CMD_EXIT;
+	}
+
+	data.set.data = 1;
+	data.data.data.call_id = id;
+	data.data.data.digit_buffer = digits;
+	qmi_set_voice_burst_dtmf_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-start-dtmf */
+
+#define cmd_voice_start_dtmf_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_start_dtmf_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_voice_start_continuous_dtmf_request data = {};
+	uint8_t id;
+	char *digit;
+
+	digit = voice_parse_id_value(arg, &id);
+	if (!digit)
+		return QMI_CMD_EXIT;
+
+	if (digit[1]) {
+		uqmi_add_error("Only a single digit is allowed");
+		return QMI_CMD_EXIT;
+	}
+
+	data.set.data = 1;
+	data.data.data.call_id = id;
+	data.data.data.digit = digit[0];
+	qmi_set_voice_start_continuous_dtmf_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/* --voice-stop-dtmf */
+
+#define cmd_voice_stop_dtmf_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_stop_dtmf_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_voice_stop_continuous_dtmf_request data = {};
+	uint8_t id;
+
+	if (!voice_parse_id_arg(arg, &id))
+		return QMI_CMD_EXIT;
+
+	data.set.data = 1;
+	data.data.data.call_id = id;
+	qmi_set_voice_stop_continuous_dtmf_request(msg, &data);
+	return QMI_CMD_REQUEST;
+}
+
+/*
+ * --voice-indications
+ *
+ * Prints each All Call Status indication as a single JSON line on stdout:
+ *   {"event":"all_call_status","calls":[{"id":1,"state":"incoming",
+ *    "type":"voice","direction":"mt","mode":"lte","number":"0123"}]}
+ * "number" is only present if the modem reported the remote party number.
+ * An empty "calls" array is possible. Runs until -t expires or SIGINT/SIGTERM.
+ */
+
+static struct blob_buf voice_ind_buf;
+
+static void voice_all_call_status_ind(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	struct voice_all_calls ind;
+	char *str;
+
+	if (!msg) {
+		/* -t expired, signalled, or (practically never) idle for too long */
+		qmi_indication_done(qmi, 0);
+		return;
+	}
+
+	if (le16_to_cpu(msg->svc.message) != VOICE_IND_ALL_CALL_STATUS)
+		return;
+
+	/* missing call information prints an empty "calls" array */
+	voice_parse_all_call_status(msg, &ind);
+
+	blob_buf_init(&voice_ind_buf, 0);
+	blobmsg_add_string(&voice_ind_buf, "event", "all_call_status");
+	voice_add_calls(&voice_ind_buf, "calls", ind.calls, ind.n_calls, ind.numbers, ind.n_numbers);
+
+	str = blobmsg_format_json_indent(voice_ind_buf.head, true, -1);
+	if (str) {
+		printf("%s\n", str);
+		fflush(stdout);
+		free(str);
+	}
+}
+
+#define cmd_voice_indications_cb no_cb
+static enum qmi_cmd_result
+cmd_voice_indications_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_voice_indication_register_request data = {
+		QMI_INIT(call_notification_events, true),
+	};
+
+	qmi_set_voice_indication_register_request(msg, &data);
+	/* the per-indication idle timeout is effectively disabled, -t ends the wait */
+	qmi_indication_listen(qmi, QMI_SERVICE_VOICE, voice_all_call_status_ind, INT_MAX);
+	return QMI_CMD_REQUEST;
+}

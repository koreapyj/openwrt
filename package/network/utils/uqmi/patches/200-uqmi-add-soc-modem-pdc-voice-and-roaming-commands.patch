+	qmi->ind.active = true;
+	qmi->ind.done = false;
+	qmi->ind.ret = 0;
+	qmi->ind.service = svc;
+	qmi->ind.cb = cb;
+	qmi->ind.timeout_ms = timeout_ms;
+	qmi->ind.timeout.cb = qmi_indication_timeout;
+	uloop_timeout_set(&qmi->ind.timeout, timeout_ms);

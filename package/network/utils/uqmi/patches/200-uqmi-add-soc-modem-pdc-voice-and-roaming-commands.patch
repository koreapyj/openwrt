+	qmi->ind.done = true;
+	qmi->ind.ret = ret;
+	uloop_timeout_cancel(&qmi->ind.timeout);
+	uloop_cancelled = true;
+}
+
+void qmi_indication_cancel(struct qmi_dev *qmi)
+{
+	uloop_timeout_cancel(&qmi->ind.timeout);
+	qmi->ind.active = false;
+	qmi->ind.done = false;

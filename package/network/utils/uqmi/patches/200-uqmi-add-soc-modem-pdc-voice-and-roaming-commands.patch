+#include "qmi-message.h"
+#include "pdc-util.h"
+
+/*
+ * Most PDC results are not part of the response to a request, but are sent
+ * as an indication (carrying the request's token) afterwards. The commands
+ * below register an indication listener (see qmi_indication_listen()) and
+ * drive multi-step operations from the indication callback.
+ */
+
+#define PDC_IND_TIMEOUT		10000	/* ms to wait for each indication */
+#define PDC_LOAD_SIZE_MAX	(16 * 1024 * 1024)
+
+enum {
+	PDC_IND_GET_SELECTED_CONFIG = 0x22,
+	PDC_IND_SET_SELECTED_CONFIG = 0x23,
+	PDC_IND_LIST_CONFIGS = 0x24,
+	PDC_IND_LOAD_CONFIG = 0x26,
+	PDC_IND_ACTIVATE_CONFIG = 0x27,
+	PDC_IND_GET_CONFIG_INFO = 0x28,
+	PDC_IND_DEACTIVATE_CONFIG = 0x2b,
+};
+
+static uint32_t pdc_config_type = QMI_PDC_CONFIGURATION_TYPE_SOFTWARE;
+static uint32_t pdc_token;
+static struct qmi_request pdc_req;
+
+static uint16_t pdc_ind_id(struct qmi_msg *msg)
+{
+	return le16_to_cpu(msg->svc.message);
+}
+
+static void pdc_fail(struct qmi_dev *qmi, const char *msg)
+{
+	uqmi_add_error(msg);
+	qmi_indication_done(qmi, -1);
+}
+
+/* Handles the response to a follow-up request sent from an indication callback */
+static void pdc_req_cb(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg)
+{
+	if (msg)
+		return;
+
+	if (req->ret == QMI_ERROR_CANCELLED && qmi->ind.cb) {
+		/* modem went away, let the listener decide whether this is expected */
+		qmi->ind.cb(qmi, NULL);
+		qmi_indication_done(qmi, -1);
+		return;
+	}
+
+	pdc_fail(qmi, qmi_get_error_str(req->ret));
+}
+
+static void pdc_send_request(struct qmi_dev *qmi)
+{
+	if (qmi_request_pending(&pdc_req))
+		qmi_request_cancel(qmi, &pdc_req);
+
+	qmi_request_start(qmi, &pdc_req, pdc_req_cb);
+}
+
+static void pdc_add_id(const char *name, const uint8_t *id, unsigned int len)
+{
+	char str[PDC_ID_STR_MAX];
+
+	if (pdc_id_format(id, len, str))
+		blobmsg_add_string(&status, name, str);
+}
+
+#define cmd_pdc_config_type_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_config_type_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	uint32_t type;
+
+	if (!pdc_type_parse(arg, &type)) {
+		uqmi_add_error("Invalid value (valid: software, platform)");
+		return QMI_CMD_EXIT;
+	}
+
+	pdc_config_type = type;
+	return QMI_CMD_DONE;
+}
+
+/* --pdc-get-selected-config */
+
+static void pdc_get_selected_config_ind(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	struct qmi_pdc_get_selected_config_indication res;
+	void *c;
+
+	if (!msg) {
+		pdc_fail(qmi, "Timed out waiting for indication");
+		return;
+	}
+
+	if (pdc_ind_id(msg) != PDC_IND_GET_SELECTED_CONFIG)
+		return;
+
+	qmi_parse_pdc_get_selected_config_indication(msg, &res);
+	if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+		return;
+
+	/* not provisioned: no configuration selected yet */
+	if (pdc_result_failed(res.set.indication_result, res.data.indication_result, true)) {
+		pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+		return;
+	}
+
+	c = blobmsg_open_table(&status, NULL);
+	blobmsg_add_string(&status, "type", pdc_type_name(pdc_config_type));
+	if (res.data.active_id_n)
+		pdc_add_id("active", res.data.active_id, res.data.active_id_n);
+	if (res.data.pending_id_n)
+		pdc_add_id("pending", res.data.pending_id, res.data.pending_id_n);
+	blobmsg_close_table(&status, c);
+
+	qmi_indication_done(qmi, 0);
+}
+
+#define cmd_pdc_get_selected_config_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_get_selected_config_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_pdc_get_selected_config_request data = {
+		QMI_INIT(config_type, pdc_config_type),
+		QMI_INIT(token, ++pdc_token),
+	};
+
+	qmi_set_pdc_get_selected_config_request(msg, &data);
+	qmi_indication_listen(qmi, QMI_SERVICE_PDC, pdc_get_selected_config_ind, PDC_IND_TIMEOUT);
+	return QMI_CMD_REQUEST;
+}
+
+/* --pdc-list-configs */
+
+static struct {
+	enum {
+		PDC_LIST_STEP_SELECTED,
+		PDC_LIST_STEP_LIST,
+		PDC_LIST_STEP_INFO,
+	} step;
+
+	uint8_t active[PDC_ID_MAX];
+	unsigned int active_n;
+	uint8_t pending[PDC_ID_MAX];
+	unsigned int pending_n;
+
+	struct pdc_list_config {
+		uint32_t type;
+		uint8_t id[PDC_ID_MAX];
+		unsigned int id_n;
+		char *description;
+		uint32_t version;
+		uint32_t size;
+	} *configs;
+	unsigned int n_configs;
+	unsigned int cur;
+} pdc_list;
+
+static void pdc_list_free(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < pdc_list.n_configs; i++)
+		free(pdc_list.configs[i].description);
+
+	free(pdc_list.configs);
+	memset(&pdc_list, 0, sizeof(pdc_list));
+}
+
+static void pdc_list_print(void)
+{
+	void *a, *c;
+	unsigned int i;
+
+	a = blobmsg_open_array(&status, NULL);
+	for (i = 0; i < pdc_list.n_configs; i++) {
+		struct pdc_list_config *cfg = &pdc_list.configs[i];
+
+		c = blobmsg_open_table(&status, NULL);
+		blobmsg_add_string(&status, "type", pdc_type_name(cfg->type));
+		pdc_add_id("id", cfg->id, cfg->id_n);
+		blobmsg_add_string(&status, "description", cfg->description ? cfg->description : "");
+		blobmsg_printf(&status, "version", "0x%x", cfg->version);
+		blobmsg_add_u32(&status, "size", cfg->size);
+		blobmsg_add_u8(&status, "active",
+			       pdc_id_equal(cfg->id, cfg->id_n, pdc_list.active, pdc_list.active_n));
+		blobmsg_add_u8(&status, "pending",
+			       pdc_id_equal(cfg->id, cfg->id_n, pdc_list.pending, pdc_list.pending_n));
+		blobmsg_close_table(&status, c);
+	}
+	blobmsg_close_array(&status, a);
+}
+
+static void pdc_list_request_info(struct qmi_dev *qmi)
+{
+	struct pdc_list_config *cfg = &pdc_list.configs[pdc_list.cur];
+	struct qmi_pdc_get_config_info_request data = {
+		QMI_INIT_SEQUENCE(type_with_id_v2,
+			.config_type = cfg->type,
+			.id_n = cfg->id_n,
+			.id = cfg->id
+		),
+		QMI_INIT(token, ++pdc_token),
+	};
+
+	qmi_set_pdc_get_config_info_request(qmi->buf, &data);
+	pdc_send_request(qmi);
+}
+
+static void pdc_list_ind(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	uint16_t id;
+
+	if (!msg) {
+		/* no configuration stored: the modem does not send any indication */
+		if (pdc_list.step == PDC_LIST_STEP_LIST) {
+			pdc_list_print();
+			qmi_indication_done(qmi, 0);
+		} else {
+			pdc_fail(qmi, "Timed out waiting for indication");
+		}
+		return;
+	}
+
+	id = pdc_ind_id(msg);
+	if (id == PDC_IND_GET_SELECTED_CONFIG && pdc_list.step == PDC_LIST_STEP_SELECTED) {
+		struct qmi_pdc_get_selected_config_indication res;
+		struct qmi_pdc_list_configs_request data = {
+			QMI_INIT(config_type, pdc_config_type),
+			QMI_INIT(token, 0),
+		};
+
+		qmi_parse_pdc_get_selected_config_indication(msg, &res);
+		if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+			return;
+
+		if (pdc_result_failed(res.set.indication_result, res.data.indication_result, true)) {
+			pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+			return;
+		}
+
+		if (res.data.active_id_n <= PDC_ID_MAX) {
+			pdc_list.active_n = res.data.active_id_n;
+			memcpy(pdc_list.active, res.data.active_id, pdc_list.active_n);
+		}
+		if (res.data.pending_id_n <= PDC_ID_MAX) {
+			pdc_list.pending_n = res.data.pending_id_n;
+			memcpy(pdc_list.pending, res.data.pending_id, pdc_list.pending_n);
+		}
+
+		pdc_list.step = PDC_LIST_STEP_LIST;
+		data.data.token = ++pdc_token;
+		qmi_set_pdc_list_configs_request(qmi->buf, &data);
+		pdc_send_request(qmi);
+	} else if (id == PDC_IND_LIST_CONFIGS && pdc_list.step == PDC_LIST_STEP_LIST) {
+		struct qmi_pdc_list_configs_indication res;
+		unsigned int i;
+
+		qmi_parse_pdc_list_configs_indication(msg, &res);
+		if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+			return;
+
+		if (res.set.indication_result && res.data.indication_result) {
+			pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+			return;
+		}
+
+		pdc_list.configs = calloc(res.data.configs_n, sizeof(*pdc_list.configs));
+		if (res.data.configs_n && !pdc_list.configs) {
+			pdc_fail(qmi, "Out of memory");
+			return;
+		}
+
+		for (i = 0; i < res.data.configs_n; i++) {
+			if (res.data.configs[i].id_n > PDC_ID_MAX) {
+				pdc_fail(qmi, "Configuration ID too long");
+				return;
+			}
+
+			pdc_list.configs[i].type = res.data.configs[i].config_type;
+			pdc_list.configs[i].id_n = res.data.configs[i].id_n;
+			memcpy(pdc_list.configs[i].id, res.data.configs[i].id, res.data.configs[i].id_n);
+		}
+		pdc_list.n_configs = res.data.configs_n;
+
+		if (!pdc_list.n_configs) {
+			pdc_list_print();
+			qmi_indication_done(qmi, 0);
+			return;
+		}
+
+		pdc_list.step = PDC_LIST_STEP_INFO;
+		pdc_list.cur = 0;
+		pdc_list_request_info(qmi);
+	} else if (id == PDC_IND_GET_CONFIG_INFO && pdc_list.step == PDC_LIST_STEP_INFO) {
+		struct qmi_pdc_get_config_info_indication res;
+		struct pdc_list_config *cfg = &pdc_list.configs[pdc_list.cur];
+
+		qmi_parse_pdc_get_config_info_indication(msg, &res);
+		if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+			return;
+
+		if (res.set.indication_result && res.data.indication_result) {
+			pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+			return;
+		}
+
+		cfg->size = res.data.total_size;
+		cfg->version = res.data.version;
+		if (res.data.description)
+			cfg->description = strdup(res.data.description);
+
+		if (++pdc_list.cur < pdc_list.n_configs) {
+			pdc_list_request_info(qmi);
+			return;
+		}
+
+		pdc_list_print();
+		qmi_indication_done(qmi, 0);
+	}
+}
+
+#define cmd_pdc_list_configs_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_list_configs_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_pdc_get_selected_config_request data = {
+		QMI_INIT(config_type, pdc_config_type),
+		QMI_INIT(token, ++pdc_token),
+	};
+
+	pdc_list_free();
+	qmi_set_pdc_get_selected_config_request(msg, &data);
+	qmi_indication_listen(qmi, QMI_SERVICE_PDC, pdc_list_ind, PDC_IND_TIMEOUT);
+	return QMI_CMD_REQUEST;
+}
+
+/* --pdc-load-config */
+
+static struct {
+	uint8_t *data;
+	size_t size;
+	size_t offset;
+	uint8_t id[PDC_ID_MAX];
+	unsigned int id_n;
+} pdc_load;
+
+static void pdc_load_request_chunk(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	size_t len = pdc_load.size - pdc_load.offset;
+	struct qmi_pdc_load_config_request data;
+
+	if (len > PDC_LOAD_CHUNK_SIZE)
+		len = PDC_LOAD_CHUNK_SIZE;
+
+	data = (struct qmi_pdc_load_config_request) {
+		QMI_INIT_SEQUENCE(config_chunk,
+			.type = pdc_config_type,
+			.id_n = pdc_load.id_n,
+			.id = pdc_load.id,
+			.total_size = pdc_load.size,
+			.chunk_n = len,
+			.chunk = pdc_load.data + pdc_load.offset
+		),
+		QMI_INIT(token, ++pdc_token),
+	};
+
+	qmi_set_pdc_load_config_request(msg, &data);
+	pdc_load.offset += len;
+}
+
+static void pdc_load_ind(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	struct qmi_pdc_load_config_indication res;
+	void *c;
+
+	if (!msg) {
+		pdc_fail(qmi, "Timed out waiting for indication");
+		return;
+	}
+
+	if (pdc_ind_id(msg) != PDC_IND_LOAD_CONFIG)
+		return;
+
+	qmi_parse_pdc_load_config_indication(msg, &res);
+	if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+		return;
+
+	if (res.set.indication_result && res.data.indication_result) {
+		pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+		return;
+	}
+
+	if (res.set.frame_reset && res.data.frame_reset) {
+		pdc_fail(qmi, "Frame reset requested by modem");
+		return;
+	}
+
+	if (!res.set.remaining_size) {
+		pdc_fail(qmi, "Invalid indication");
+		return;
+	}
+
+	if (res.data.remaining_size) {
+		if (pdc_load.offset >= pdc_load.size) {
+			pdc_fail(qmi, "Modem expects more data than the file contains");
+			return;
+		}
+
+		pdc_load_request_chunk(qmi, qmi->buf);
+		pdc_send_request(qmi);
+		return;
+	}
+
+	c = blobmsg_open_table(&status, NULL);
+	blobmsg_add_string(&status, "type", pdc_type_name(pdc_config_type));
+	pdc_add_id("id", pdc_load.id, pdc_load.id_n);
+	blobmsg_add_u32(&status, "size", pdc_load.size);
+	blobmsg_close_table(&status, c);
+
+	qmi_indication_done(qmi, 0);
+}
+
+#define cmd_pdc_load_config_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_load_config_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	FILE *f = fopen(arg, "rb");
+	long size;
+
+	free(pdc_load.data);
+	memset(&pdc_load, 0, sizeof(pdc_load));
+
+	if (!f) {
+		uqmi_add_error("Failed to open file");
+		return QMI_CMD_EXIT;
+	}
+
+	if (fseek(f, 0, SEEK_END) || (size = ftell(f)) <= 0 || size > PDC_LOAD_SIZE_MAX ||
+	    fseek(f, 0, SEEK_SET)) {
+		fclose(f);
+		uqmi_add_error("Invalid file size");
+		return QMI_CMD_EXIT;
+	}
+
+	pdc_load.data = malloc(size);
+	if (!pdc_load.data || fread(pdc_load.data, 1, size, f) != (size_t) size) {
+		fclose(f);
+		free(pdc_load.data);
+		pdc_load.data = NULL;
+		uqmi_add_error("Failed to read file");
+		return QMI_CMD_EXIT;
+	}
+	fclose(f);
+
+	pdc_load.size = size;
+	pdc_load.id_n = pdc_id_from_file(pdc_load.id, pdc_load.data, pdc_load.size);
+
+	pdc_load_request_chunk(qmi, msg);
+	qmi_indication_listen(qmi, QMI_SERVICE_PDC, pdc_load_ind, PDC_IND_TIMEOUT);
+	return QMI_CMD_REQUEST;
+}
+
+/* --pdc-activate-config */
+
+static struct {
+	enum {
+		PDC_ACTIVATE_STEP_SELECT,
+		PDC_ACTIVATE_STEP_ACTIVATE,
+	} step;
+	uint8_t id[PDC_ID_MAX];
+	unsigned int id_n;
+} pdc_activate;
+
+static void pdc_activate_print(const char *status_str)
+{
+	void *c = blobmsg_open_table(&status, NULL);
+
+	blobmsg_add_string(&status, "type", pdc_type_name(pdc_config_type));
+	pdc_add_id("id", pdc_activate.id, pdc_activate.id_n);
+	blobmsg_add_string(&status, "status", status_str);
+	blobmsg_close_table(&status, c);
+}
+
+static void pdc_activate_ind(struct qmi_dev *qmi, struct qmi_msg *msg)
+{
+	uint16_t id;
+
+	if (!msg) {
+		/* The modem restarts to apply the configuration, the indication
+		 * might never arrive. */
+		if (pdc_activate.step == PDC_ACTIVATE_STEP_ACTIVATE) {
+			pdc_activate_print("activation-requested");
+			qmi_indication_done(qmi, 0);
+		} else {
+			pdc_fail(qmi, "Timed out waiting for indication");
+		}
+		return;
+	}
+
+	id = pdc_ind_id(msg);
+	if (id == PDC_IND_SET_SELECTED_CONFIG && pdc_activate.step == PDC_ACTIVATE_STEP_SELECT) {
+		struct qmi_pdc_set_selected_config_indication res;
+		struct qmi_pdc_activate_config_request data = {
+			QMI_INIT(config_type, pdc_config_type),
+			QMI_INIT(token, 0),
+		};
+
+		qmi_parse_pdc_set_selected_config_indication(msg, &res);
+		if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+			return;
+
+		if (res.set.indication_result && res.data.indication_result) {
+			pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+			return;
+		}
+
+		pdc_activate.step = PDC_ACTIVATE_STEP_ACTIVATE;
+		data.data.token = ++pdc_token;
+		qmi_set_pdc_activate_config_request(qmi->buf, &data);
+		pdc_send_request(qmi);
+	} else if (id == PDC_IND_ACTIVATE_CONFIG && pdc_activate.step == PDC_ACTIVATE_STEP_ACTIVATE) {
+		struct qmi_pdc_activate_config_indication res;
+
+		qmi_parse_pdc_activate_config_indication(msg, &res);
+		if (!pdc_token_valid(res.set.token, res.data.token, pdc_token))
+			return;
+
+		if (res.set.indication_result && res.data.indication_result) {
+			pdc_fail(qmi, qmi_get_error_str(res.data.indication_result));
+			return;
+		}
+
+		pdc_activate_print("activation-requested");
+		qmi_indication_done(qmi, 0);
+	}
+}
+
+#define cmd_pdc_activate_config_cb no_cb
+static enum qmi_cmd_result
+cmd_pdc_activate_config_prepare(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg, char *arg)
+{
+	struct qmi_pdc_set_selected_config_request data = {
+		QMI_INIT_SEQUENCE(type_with_id_v2,
+			.config_type = pdc_config_type,
+			.id = pdc_activate.id
+		),
+		QMI_INIT(token, ++pdc_token),
+	};
+
+	memset(&pdc_activate, 0, sizeof(pdc_activate));
+	if (!pdc_id_parse(arg, pdc_activate.id, &pdc_activate.id_n)) {
+		uqmi_add_error("Invalid configuration ID (expected hex string)");
+		return QMI_CMD_EXIT;
+	}
+
+	data.data.type_with_id_v2.id_n = pdc_activate.id_n;
+	qmi_set_pdc_set_selected_config_request(msg, &data);
+	qmi_indication_listen(qmi, QMI_SERVICE_PDC, pdc_activate_ind, PDC_IND_TIMEOUT);
+	return QMI_CMD_REQUEST;
+}

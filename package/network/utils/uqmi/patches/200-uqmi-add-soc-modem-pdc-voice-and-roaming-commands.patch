+/*
+ * uqmi -- JSON output of a decoded SMS PDU (shared codec: common/sms_part.c)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "charsets.h"
+#include "sms_part.h"
+#include "sms-json.h"
+
+static void add_hex(struct blob_buf *b, const char *name, const uint8_t *data, size_t len)
+{
+	char *str = blobmsg_alloc_string_buffer(b, name, len * 2 + 1);
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		str += sprintf(str, "%02x", data[i]);
+	blobmsg_add_string_buffer(b);
+}
+
+/* ISO8601 "YYYY-MM-DDTHH:MM:SS+HH:MM" to the historic "YYYY-MM-DD HH:MM:SS" */
+static void add_timestamp(struct blob_buf *b, const char *iso)
+{
+	char ts[32];
+
+	if (!iso || strlen(iso) < 19)
+		return;
+
+	memcpy(ts, iso, 19);
+	ts[10] = ' ';
+	ts[19] = 0;
+	blobmsg_add_string(b, "timestamp", ts);
+}
+
+int uqmi_sms_pdu_to_blob(struct blob_buf *b, const uint8_t *pdu, size_t len, char *err, size_t errlen)
+{
+	struct sms_part *part = NULL;
+	bool sent;
+
+	if (sms_part_3gpp_from_pdu(0, pdu, len, false, &part, err, errlen))
+		return -1;
+
+	sent = part->pdu_type == SMS_PDU_SUBMIT;
+
+	if (part->smsc && *part->smsc)
+		blobmsg_add_string(b, "smsc", part->smsc);
+	if (part->number)
+		blobmsg_add_string(b, sent || part->pdu_type == SMS_PDU_STATUS_REPORT ? "receiver" : "sender",
+				   part->number);
+	if (part->class >= 0)
+		blobmsg_add_u32(b, "class", part->class);
+	if (!sent)
+		add_timestamp(b, part->timestamp);
+	if (part->should_concat) {
+		blobmsg_add_u32(b, "concat_ref", part->concat_reference);
+		blobmsg_add_u32(b, "concat_part", part->concat_sequence);
+		blobmsg_add_u32(b, "concat_parts", part->concat_max);
+	}
+
+	switch (part->encoding) {
+	case SMS_ENC_GSM7:
+		blobmsg_add_string(b, "text", part->text ? part->text : "");
+		break;
+	case SMS_ENC_UCS2:
+		if (part->text) {
+			size_t n = 0;
+			uint8_t *u16 = cs_utf8_to_utf16be(part->text, &n);
+
+			if (u16) {
+				add_hex(b, "ucs-2", u16, n);
+				free(u16);
+			} else {
+				blobmsg_add_string(b, "ucs-2", "");
+			}
+			blobmsg_add_string(b, "text", part->text);
+		}
+		break;
+	default:
+		if (part->data)
+			add_hex(b, "data", part->data, part->data_len);
+		break;
+	}
+
+	sms_part_free(part);
+	return 0;
+}

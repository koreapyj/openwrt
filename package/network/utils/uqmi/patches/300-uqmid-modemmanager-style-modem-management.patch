+#define ACT_LTE_NB_IOT (1U << 17)
+
+const char *reg_state_name(enum reg_state state);
+bool reg_state_is_registered(enum reg_state state);
+bool reg_state_is_roaming(enum reg_state state);
+/* "access_technologies" array */
+void uqmid_add_access_technologies(struct blob_buf *bb, const char *name, uint32_t act);
+
+/* modem object life cycle */
+void uqmid_3gpp_init(struct modem *modem);
+/* the version info of the device is known: allocate the WDS client of the initial EPS bearer (kept) */
+void uqmid_3gpp_probe(struct modem *modem);
+void uqmid_3gpp_cleanup(struct modem *modem);
+
+/* MM: mm_iface_modem_3gpp_enable() / _disable(). The callback is called exactly once, never fails the operation. */
+void uqmid_3gpp_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data);
+void uqmid_3gpp_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data);
+
+enum reg_state uqmid_3gpp_registration_state(struct modem *modem);
+uint32_t uqmid_3gpp_access_technologies(struct modem *modem);
+const char *uqmid_3gpp_operator_code(struct modem *modem);
+const char *uqmid_3gpp_operator_name(struct modem *modem);
+/* signal quality in percent, false if unknown */
+bool uqmid_3gpp_signal_quality(struct modem *modem, unsigned int *quality);
+
+/* MM: mm_iface_modem_refresh_signal(): after the modes or bands were changed */
+void uqmid_3gpp_refresh_signal(struct modem *modem);
+
+/* "registration_state", "operator_code", "operator_name", "access_technologies", "signal_quality",
+ * "initial_eps_bearer_settings" */
+void uqmid_3gpp_add_properties(struct modem *modem, struct blob_buf *bb);
+
+/*
+ * MM: mm_iface_modem_3gpp_register_in_network(). @operator_id NULL or empty selects the automatic
+ * registration. @force registers again even if registered as requested. The callback gets the result
+ * (MODEM_ERR_NETWORK_NOT_ALLOWED if denied, MODEM_ERR_NETWORK_TIMEOUT after @max_secs).
+ * It is called exactly once if 0 is returned (never from within this call).

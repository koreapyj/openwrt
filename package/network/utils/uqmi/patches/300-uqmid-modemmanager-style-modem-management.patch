+
+static int enc_channel_open(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_uim_open_logical_channel_request req = {
+		QMI_INIT(slot, a->slot),
+		QMI_INIT_ARRAY(aid, a->aid, a->aid_n),
+	};
+
+	return qmi_set_uim_open_logical_channel_request(msg, &req);
+}
+
+static int res_channel_open(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_uim_open_logical_channel_response res = {};
+
+	if (qmi_parse_uim_open_logical_channel_response(msg, &res))
+		return -1;
+	blobmsg_add_u32(bb, "channel_id", res.data.channel_id);
+	blobmsg_add_u32(bb, "sw1", res.data.card_result.sw1);
+	blobmsg_add_u32(bb, "sw2", res.data.card_result.sw2);
+	return 0;
+}

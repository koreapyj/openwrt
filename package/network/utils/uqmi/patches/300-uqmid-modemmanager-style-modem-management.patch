@@ -0,0 +1,461 @@
+/*
+ * uqmid -- SIM hot swap
+ *
+ * Follows ModemManager:
+ *  - mm-shared-qmi.c setup_sim_hot_swap_step(): register for slot status
+ *    events and UIM refresh (refresh register all; if not supported the files
+ *    EF_ICCID and EF_IMSI),
+ *  - uim_refresh_indication_cb(): a refresh of the types reset or init-full-fcn
+ *    triggers the SIM swap check when it ended (or 3 s after it started, the end
+ *    may never come); other refreshes are only completed,
+ *  - uim_slot_status_indication_cb(): a change of an active slot (card removed or
+ *    inserted, ICCID changed, slot switched) is a SIM event,
+ *  - mm-iface-modem.c check_basic_sim_details_ready(): the SIM swap check
+ *    compares presence, ICCID and IMSI with what was seen before.
+ *  - mm-iface-modem.c iface_modem_process_sim_event_internal(): a SIM event
+ *    disables the modem, then the modem object is invalidated and probed again.
+ *
+ * Deviation: MM only relies on the slot status and the refresh. Modems which
+ * do not support the slot status (e.g. the MSM8916 SoC modem answers 94/Not
+ * supported) would never notice a removed or inserted card, so for them the
+ * UIM card status event (UIM Register Events, card status bit) triggers the
+ * same SIM swap check.
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "modem_tx.h"
+#include "osmocom/fsm.h"
+#include "qmi-enums-uim.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sim_fsm.h"
+#include "sim_obj.h"
+#include "utils.h"
+
+enum {
+	UIM_IND_CARD_STATUS = 0x32,
+	UIM_IND_REFRESH = 0x33,
+	UIM_IND_SLOT_STATUS = 0x48,
+};
+
+/* MM: REFRESH_START_TIMEOUT_SECS */
+#define REFRESH_START_TIMEOUT_MS 3000
+/* the check waits for the init/sim round to settle, at most 30 times 2 s */
+#define CHECK_DEFER_MS 2000
+#define CHECK_DEFER_MAX 30
+
+/*****************************************************************************/
+/* SIM swap check (MM: mm_iface_modem_check_for_sim_swap) */
+
+struct sim_check {
+	bool present;
+	bool ready;
+	char iccid[24];
+	char imsi[16];
+};
+
+static void sim_check_finish(struct modem *modem)
+{
+	TALLOC_FREE(modem->sim.check_ctx);
+	modem->sim.check_busy = false;
+
+	if (modem->sim.check_again) {
+		modem->sim.check_again = false;
+		uqmid_sim_check_soon(modem, "another event during the check", 500);
+	}
+}
+
+static void sim_check_evaluate(struct modem *modem)
+{
+	struct sim_check *c = modem->sim.check_ctx;
+	bool iccid_changed = c->iccid[0] && modem->iccid && strcmp(c->iccid, modem->iccid);
+	bool imsi_changed = c->imsi[0] && modem->imsi[0] && strcmp(c->imsi, modem->imsi);
+
+	if (!modem->sim.present && !c->present) {
+		modem_log(modem, LOGL_INFO, "No SIM inserted before and after");
+	} else if (modem->sim.present && !c->present) {
+		modem_log(modem, LOGL_NOTICE, "SIM removed");
+		uqmid_modem_reprobe(modem);
+	} else if (!modem->sim.present && c->present) {
+		modem_log(modem, LOGL_NOTICE, "SIM inserted");
+		uqmid_modem_reprobe(modem);
+	} else if (iccid_changed || imsi_changed) {
+		modem_log(modem, LOGL_NOTICE, "new SIM detected (ICCID %s -> %s)", modem->iccid ? modem->iccid : "?",
+			  c->iccid[0] ? c->iccid : "?");
+		uqmid_modem_reprobe(modem);
+	} else {
+		modem_log(modem, LOGL_INFO, "SIM not changed");
+	}
+
+	sim_check_finish(modem);
+}
+
+static void sim_check_imsi_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct sim_check *c = modem->sim.check_ctx;
+	struct qmi_uim_read_transparent_response res = {};
+
+	if (!c || modem->dying)
+		return;
+
+	if (msg && !req->ret && !qmi_parse_uim_read_transparent_response(msg, &res) && res.data.read_result_n)
+		uqmi_sim_decode_imsi(res.data.read_result, res.data.read_result_n, c->imsi, sizeof(c->imsi));
+
+	sim_check_evaluate(modem);
+}
+
+static void sim_check_iccid_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct sim_check *c = modem->sim.check_ctx;
+	struct qmi_uim_read_transparent_response res = {};
+	/* EF_IMSI: MF, ADF (little endian path) */
+	uint8_t imsi_path[] = { 0x00, 0x3f, 0xff, 0x7f };
+
+	if (!c || modem->dying)
+		return;
+
+	if (msg && !req->ret && !qmi_parse_uim_read_transparent_response(msg, &res) && res.data.read_result_n)
+		uqmi_sim_decode_iccid(res.data.read_result, res.data.read_result_n, c->iccid, sizeof(c->iccid));
+
+	/* the IMSI is only readable if the SIM is not locked */
+	if (c->ready &&
+	    !tx_uim_read_transparent_file(modem, uqmi_service_find(modem->qmi, QMI_SERVICE_UIM), sim_check_imsi_cb,
+					  0x6f07, imsi_path, sizeof(imsi_path)))
+		return;
+
+	sim_check_evaluate(modem);
+}
+
+static void sim_check_card_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct sim_check *c = modem->sim.check_ctx;
+	struct sim_card_info ci;
+	uint8_t iccid_path[] = { 0x00, 0x3f };
+
+	if (!c || modem->dying)
+		return;
+
+	if (!msg || req->ret || sim_parse_card_status(msg, &ci)) {
+		modem_log(modem, LOGL_INFO, "SIM details check failed: card status %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+		sim_check_finish(modem);
+		return;
+	}
+
+	c->present = ci.present;
+	c->ready = ci.state == UQMI_SIM_READY;
+	if (ci.present &&
+	    !tx_uim_read_transparent_file(modem, uqmi_service_find(modem->qmi, QMI_SERVICE_UIM), sim_check_iccid_cb,
+					  0x2fe2, iccid_path, sizeof(iccid_path)))
+		return;
+
+	sim_check_evaluate(modem);
+}
+
+static void sim_check_start(struct modem *modem)
+{
+	struct qmi_service *uim = uqmi_service_find(modem->qmi, QMI_SERVICE_UIM);
+
+	if (modem->sim.check_busy) {
+		modem->sim.check_again = true;
+		return;
+	}
+
+	if (!uim)
+		return;
+
+	modem_log(modem, LOGL_INFO, "started checking for basic SIM details...");
+	modem->sim.check_busy = true;
+	modem->sim.check_ctx = talloc_zero(modem, struct sim_check);
+	if (uqmi_service_send_simple(uim, qmi_set_uim_get_card_status_request, sim_check_card_cb, modem))
+		sim_check_finish(modem);
+}
+
+static void sim_check_timer_cb(struct uloop_timeout *t)
+{
+	struct modem *modem = container_of(t, struct modem, sim.check_timer);
+	bool settled;
+
+	if (modem->dying)
+		return;
+
+	settled = modem->mm_state != MODEM_STATE_INITIALIZING && modem->mm_state != MODEM_STATE_UNKNOWN &&
+		  !modem->cur_op && (!modem->sim.fi || modem->sim.fi->state != SIM_ST_GET_INFO);
+	if (!settled && modem->sim.check_deferred < CHECK_DEFER_MAX) {
+		modem->sim.check_deferred++;
+		uloop_timeout_set(t, CHECK_DEFER_MS);
+		return;
+	}
+
+	modem->sim.check_deferred = 0;
+	sim_check_start(modem);
+}
+
+void uqmid_sim_check_soon(struct modem *modem, const char *why, unsigned int delay_ms)
+{
+	if (modem->dying)
+		return;
+
+	modem_log(modem, LOGL_DEBUG, "SIM check requested: %s", why);
+	modem->sim.check_timer.cb = sim_check_timer_cb;
+	uloop_timeout_set(&modem->sim.check_timer, delay_ms);
+}
+
+/*****************************************************************************/
+/* indications */
+
+/* The card status changed. Only used if the slot status is not available. */
+static void uim_card_status_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem *modem = data;
+
+	if (modem->sim.slot_status_known)
+		return;
+
+	uqmid_sim_check_soon(modem, "card status indication", 1000);
+}
+
+static void sim_refresh_timer_cb(struct uloop_timeout *t)
+{
+	struct modem *modem = container_of(t, struct modem, sim.refresh_timer);
+
+	modem_log(modem, LOGL_INFO, "refresh start timed out; trigger SIM change check");
+	uqmid_sim_check_soon(modem, "refresh start timeout", 0);
+}
+
+static void uim_refresh_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem *modem = data;
+	struct qmi_uim_refresh_indication res = {};
+	uint8_t stage, mode, session;
+	bool swap_mode;
+
+	if (qmi_parse_uim_refresh_indication(msg, &res) || !res.set.event) {
+		modem_log(modem, LOGL_INFO, "couldn't process UIM refresh indication");
+		return;
+	}
+
+	stage = res.data.event.stage;
+	mode = res.data.event.mode;
+	session = res.data.event.session_type;
+	modem_log(modem, LOGL_DEBUG, "refresh indication received: session type %u, stage %u, mode %u", session,
+		  stage, mode);
+
+	/* Support only the first slot for now. Primary GW provisioning is used in old modems. */
+	if (session != QMI_UIM_SESSION_TYPE_CARD_SLOT_1 && session != QMI_UIM_SESSION_TYPE_PRIMARY_GW_PROVISIONING) {
+		modem_log(modem, LOGL_INFO, "refresh session type not supported: %u", session);
+		return;
+	}
+
+	swap_mode = mode == QMI_UIM_REFRESH_MODE_RESET || mode == QMI_UIM_REFRESH_MODE_INIT_FULL_FCN;
+
+	/*
+	 * MM: UICC reset (profile switch) and init-full-fcn (IMSI switch) are handled
+	 * when the refresh ends. It's possible that 'end-with-success' never appears,
+	 * so a timer is started at the start stage. Other refreshes are only completed.
+	 */
+	if (stage == QMI_UIM_REFRESH_STAGE_START) {
+		if (swap_mode) {
+			if (!modem->sim.refresh_timer.pending) {
+				modem->sim.refresh_timer.cb = sim_refresh_timer_cb;
+				uloop_timeout_set(&modem->sim.refresh_timer, REFRESH_START_TIMEOUT_MS);
+			}
+		} else {
+			tx_uim_refresh_complete(modem, service, session);
+		}
+	} else if (stage == QMI_UIM_REFRESH_STAGE_END_WITH_SUCCESS) {
+		if (swap_mode) {
+			uloop_timeout_cancel(&modem->sim.refresh_timer);
+			uqmid_sim_check_soon(modem, "refresh ended", 0);
+		}
+	}
+}
+
+/* MM: slot_array_status_equal(.., check_active_slots_only = TRUE) */
+static bool slots_equal(const struct sim_slot *a, unsigned int a_n, const struct sim_slot *b, unsigned int b_n)
+{
+	unsigned int i;
+
+	if (a_n != b_n)
+		return false;
+
+	for (i = 0; i < a_n; i++) {
+		if (a[i].active != b[i].active)
+			return false;
+		/* inactive slots are ignored */
+		if (!a[i].active)
+			continue;
+		if (a[i].present != b[i].present || strcmp(a[i].iccid, b[i].iccid))
+			return false;
+	}
+
+	return true;
+}
+
+static void uim_slot_status_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem *modem = data;
+	struct qmi_uim_slot_status_indication res = {};
+	struct sim_slot slots[SIM_MAX_SLOTS];
+	unsigned int i, n;
+
+	modem_log(modem, LOGL_DEBUG, "received slot status indication");
+
+	if (!modem->sim.slot_status_known) {
+		modem_log(modem, LOGL_DEBUG, "initial slot status is not loaded yet");
+		return;
+	}
+
+	if (qmi_parse_uim_slot_status_indication(msg, &res) || !res.data.physical_slot_status_n) {
+		modem_log(modem, LOGL_INFO, "could not process slot status indication");
+		return;
+	}
+
+	n = res.data.physical_slot_status_n < SIM_MAX_SLOTS ? res.data.physical_slot_status_n : SIM_MAX_SLOTS;
+	for (i = 0; i < n; i++)
+		uqmid_sim_slot_set(&slots[i], res.data.physical_slot_status[i].physical_card_status,
+				   res.data.physical_slot_status[i].physical_slot_status,
+				   res.data.physical_slot_status[i].logical_slot,
+				   res.data.physical_slot_status[i].iccid, res.data.physical_slot_status[i].iccid_n);
+
+	/* A card removed or inserted, a changed ICCID or a switched slot: reprobe */
+	if (!slots_equal(modem->sim.slots, modem->sim.n_slots, slots, n)) {
+		modem_log(modem, LOGL_NOTICE, "An active slot had a status change, will reprobe the modem");
+		uqmid_modem_reprobe(modem);
+		return;
+	}
+
+	/* an inactive slot changed: only remember it */
+	memcpy(modem->sim.slots, slots, n * sizeof(slots[0]));
+}
+
+/*****************************************************************************/
+/* setup (MM: setup_sim_hot_swap_step) */
+
+enum {
+	HS_EVENTS,
+	HS_REFRESH_ALL,
+	HS_REFRESH_ICCID,
+	HS_REFRESH_IMSI,
+	HS_DONE,
+};
+
+static void hotswap_step(struct modem *modem);
+
+static void hotswap_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	bool ok = msg && !req->ret;
+
+	if (modem->dying)
+		return;
+
+	switch (modem->sim.hotswap_step) {
+	case HS_EVENTS:
+		/* If event registration fails, go on: refresh may still work */
+		if (ok)
+			modem_log(modem, LOGL_DEBUG, "registered for %s indications",
+				  modem->sim.slot_status_known ? "slot status" : "card status");
+		else
+			modem_log(modem, LOGL_DEBUG, "not registered for SIM indications: %d/%s", req->ret,
+				  qmi_get_error_str(req->ret));
+		break;
+	case HS_REFRESH_ALL:
+		if (ok) {
+			modem_log(modem, LOGL_DEBUG, "registered for all SIM refresh events");
+			modem->sim.refresh_all = true;
+		} else {
+			modem_log(modem, LOGL_DEBUG, "refresh register all operation failed: %d/%s", req->ret,
+				  qmi_get_error_str(req->ret));
+		}
+		break;
+	default:
+		if (!ok)
+			modem_log(modem, LOGL_DEBUG, "file refresh registration failed: %d/%s", req->ret,
+				  qmi_get_error_str(req->ret));
+		break;
+	}
+
+	modem->sim.hotswap_step++;
+	hotswap_step(modem);
+}
+
+static void hotswap_step(struct modem *modem)
+{
+	struct qmi_service *uim = uqmi_service_find(modem->qmi, QMI_SERVICE_UIM);
+	static const uint16_t iccid_path[] = { 0x3f00 };
+	static const uint16_t imsi_path[] = { 0x3f00, 0x7fff };
+	int ret = 1;
+
+	if (!uim)
+		return;
+
+	switch (modem->sim.hotswap_step) {
+	case HS_EVENTS:
+		ret = tx_uim_register_events(modem, uim, hotswap_cb,
+					     modem->sim.slot_status_known ? QMI_UIM_EVENT_REGISTRATION_FLAG_PHYSICAL_SLOT_STATUS :
+									    QMI_UIM_EVENT_REGISTRATION_FLAG_CARD_STATUS);
+		break;
+	case HS_REFRESH_ALL:
+		ret = tx_uim_refresh_register_all(modem, uim, hotswap_cb);
+		break;
+	case HS_REFRESH_ICCID:
+		/* If refresh all is not supported, register for a single file refresh notification */
+		if (modem->sim.refresh_all) {
+			modem->sim.hotswap_step++;
+			hotswap_step(modem);
+			return;
+		}
+		ret = tx_uim_refresh_register_file(modem, uim, hotswap_cb, 0x2fe2, iccid_path, 1);
+		break;
+	case HS_REFRESH_IMSI:
+		if (modem->sim.refresh_all) {
+			modem->sim.hotswap_step++;
+			hotswap_step(modem);
+			return;
+		}
+		ret = tx_uim_refresh_register_file(modem, uim, hotswap_cb, 0x6f07, imsi_path, 2);
+		break;
+	default:
+		modem_log(modem, LOGL_INFO, "SIM hot swap is set up (%s)",
+			  modem->sim.slot_status_known ? "slot status" : "card status");
+		return;
+	}
+
+	/* the request could not be queued: skip it */
+	if (ret) {
+		modem->sim.hotswap_step++;
+		hotswap_step(modem);
+	}
+}
+
+void uqmid_sim_hotswap_setup(struct modem *modem)
+{
+	struct qmi_service *uim;
+
+	if (modem->sim.hotswap_setup || modem->dying)
+		return;
+
+	uim = uqmi_service_find(modem->qmi, QMI_SERVICE_UIM);
+	if (!uim)
+		return;
+
+	modem->sim.hotswap_setup = true;
+	modem->sim.refresh_timer.cb = sim_refresh_timer_cb;
+	modem->sim.check_timer.cb = sim_check_timer_cb;
+	uqmi_service_register_indication(uim, UIM_IND_CARD_STATUS, uim_card_status_ind, modem);
+	uqmi_service_register_indication(uim, UIM_IND_REFRESH, uim_refresh_ind, modem);
+	uqmi_service_register_indication(uim, UIM_IND_SLOT_STATUS, uim_slot_status_ind, modem);
+
+	modem->sim.hotswap_step = HS_EVENTS;
+	hotswap_step(modem);
+}

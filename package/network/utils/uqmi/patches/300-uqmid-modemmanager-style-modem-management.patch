+static const char *pdp_type_to_ip_type(int pdp_type)
+{
+	switch (pdp_type) {
+	case QMI_WDS_PDP_TYPE_IPV4: return "ipv4";
+	case QMI_WDS_PDP_TYPE_IPV6: return "ipv6";
+	case QMI_WDS_PDP_TYPE_IPV4_OR_IPV6: return "ipv4v6";
+	default: return NULL;
+	}
+}
+
+void uqmid_3gpp_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	struct modem_3gpp *m = m3(modem);
+	void *t;
+
+	blobmsg_add_string(bb, "registration_state", reg_state_name(m->state));
+	blobmsg_add_string(bb, "operator_code", m->operator_code ? m->operator_code : "");
+	blobmsg_add_string(bb, "operator_name", m->operator_name ? m->operator_name : "");
+	uqmid_add_access_technologies(bb, "access_technologies", m->act);
+
+	t = blobmsg_open_table(bb, "signal_quality");
+	blobmsg_add_u32(bb, "value", m->signal_valid ? m->signal : 0);
+	/* MM: the value is recent if it was updated in the last minute (here: while the modem is enabled) */
+	blobmsg_add_u8(bb, "recent", m->signal_valid && m->enabled);
+	blobmsg_close_table(bb, t);
+
+	/* MM: InitialEpsBearerSettings (the password is not shown) */
+	t = blobmsg_open_table(bb, "initial_eps_bearer_settings");
+	if (m->eps_valid) {
+		const char *ip_type = pdp_type_to_ip_type(m->eps_pdp_type);
+
+		blobmsg_add_string(bb, "apn", m->eps_apn ? m->eps_apn : "");
+		if (ip_type)
+			blobmsg_add_string(bb, "ip_type", ip_type);
+		uqmid_add_allowed_auth(bb, "allowed_auth", m->eps_auth);
+		blobmsg_add_string(bb, "user", m->eps_user ? m->eps_user : "");
+		blobmsg_add_u32(bb, "profile_id", m->attach_pdn);
+	}
+	blobmsg_close_table(bb, t);
+}
+
+enum conn_forbidden uqmid_3gpp_connection_forbidden(struct modem *modem, bool allow_roaming)
+{
+	struct modem_3gpp *m = m3(modem);
+
+	switch (m->state) {
+	case REG_IDLE:
+	case REG_DENIED:
+	case REG_UNKNOWN:
+		return CONN_FORBIDDEN_UNREGISTERED;
+	case REG_HOME:
+	case REG_HOME_SMS_ONLY:
+	case REG_HOME_CSFB_NOT_PREFERRED:
+	case REG_SEARCHING:
+	case REG_ATTACHED_RLOS:
+		return CONN_FORBIDDEN_NONE;
+	case REG_ROAMING:
+	case REG_ROAMING_SMS_ONLY:
+	case REG_ROAMING_CSFB_NOT_PREFERRED:
+		return allow_roaming ? CONN_FORBIDDEN_NONE : CONN_FORBIDDEN_ROAMING;
+	case REG_EMERGENCY_ONLY:
+		return CONN_FORBIDDEN_EMERGENCY_ONLY;
+	}
+
+	return CONN_FORBIDDEN_NONE;
+}
+
+/*****************************************************************************/
+/* enable and disable (MM: mm_iface_modem_3gpp_enable() / mm_iface_modem_3gpp_disable()) */
+
+struct m3_enable {
+	struct modem_3gpp *m;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+	int step;
+};
+
+enum {
+	EN_FIRST,
+	EN_SIGNAL_INFO,
+	EN_EVENT_REPORT,
+	EN_REG_EVENTS_SYSTEM_INFO,
+	EN_REG_EVENTS_SERVING_SYSTEM,
+	EN_EPS,
+	EN_CHECK,
+	EN_LAST,
+};
+
+static void m3_enable_step(struct m3_enable *en);
+
+static void m3_enable_next(struct m3_enable *en)
+{
+	en->step++;
+	m3_enable_step(en);
+}
+
+static void m3_register_callbacks(struct modem_3gpp *m)
+{
+	if (m->callbacks || !m->nas)
+		return;
+
+	m->callbacks = true;
+	uqmi_service_register_indication(m->nas, NAS_IND_SYSTEM_INFO, nas_system_info_ind, m);
+	uqmi_service_register_indication(m->nas, NAS_IND_SERVING_SYSTEM, nas_serving_system_ind, m);
+	uqmi_service_register_indication(m->nas, NAS_IND_SIGNAL_INFO, nas_signal_info_ind, m);
+	uqmi_service_register_indication(m->nas, NAS_IND_EVENT_REPORT, nas_event_report_ind, m);
+}
+
+static void m3_unregister_callbacks(struct modem_3gpp *m)
+{
+	if (!m->callbacks || !m->nas)
+		return;
+
+	m->callbacks = false;
+	uqmi_service_remove_indication(m->nas, NAS_IND_SYSTEM_INFO, nas_system_info_ind, m);
+	uqmi_service_remove_indication(m->nas, NAS_IND_SERVING_SYSTEM, nas_serving_system_ind, m);
+	uqmi_service_remove_indication(m->nas, NAS_IND_SIGNAL_INFO, nas_signal_info_ind, m);
+	uqmi_service_remove_indication(m->nas, NAS_IND_EVENT_REPORT, nas_event_report_ind, m);
+}
+
+static void en_signal_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct m3_enable *en = req->cb_data;
+
+	if (!msg || req->ret) {
+		/* MM: falling back to the signal strength event report */
+		modem_log(en->m->modem, LOGL_DEBUG, "couldn't register signal info indications: %d/%s, using signal strength",
+			  req->ret, qmi_get_error_str(req->ret));
+		en->m->signal_ind = false;
+		en->step = EN_EVENT_REPORT;
+	} else {
+		/* signal info indications enabled: polling disabled */
+		en->m->signal_ind = true;
+		en->step = EN_REG_EVENTS_SYSTEM_INFO;
+	}
+
+	m3_enable_step(en);
+}
+
+static void en_event_report_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct m3_enable *en = req->cb_data;
+
+	en->m->event_report_ind = msg && !req->ret;
+	if (!en->m->event_report_ind)
+		modem_log(en->m->modem, LOGL_DEBUG, "couldn't enable signal strength reports: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+	m3_enable_next(en);
+}
+
+static void en_reg_events_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct m3_enable *en = req->cb_data;
+	struct modem_3gpp *m = en->m;
+
+	if (!msg || req->ret) {
+		if (en->step == EN_REG_EVENTS_SYSTEM_INFO) {
+			/* MM: couldn't register system info indications, falling back to serving system */
+			modem_log(m->modem, LOGL_DEBUG, "couldn't register system info indications: %d/%s, using the serving system",
+				  req->ret, qmi_get_error_str(req->ret));
+			en->step = EN_REG_EVENTS_SERVING_SYSTEM;
+			m3_enable_step(en);
+			return;
+		}
+
+		/* MM: assuming always enabled, and checking periodically */
+		modem_log(m->modem, LOGL_DEBUG, "couldn't register serving system indications: %d/%s, polling",
+			  req->ret, qmi_get_error_str(req->ret));
+		uloop_timeout_set(&m->check_timer, REGISTRATION_CHECK_TIMEOUT_MS);
+	} else if (en->step == EN_REG_EVENTS_SYSTEM_INFO) {
+		m->sys_info_ind = true;
+	} else {
+		m->serving_ind = true;
+	}
+
+	/* the next after the registration events is EN_EPS */
+	en->step = EN_EPS;
+	m3_enable_step(en);
+}
+
+static void en_eps_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct m3_enable *en = data;
+
+	m3_enable_next(en);
+}
+
+static void en_check_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct m3_enable *en = data;
+
+	if (err)
+		modem_log(m->modem, LOGL_INFO, "initial 3GPP registration check failed: %d/%s", err,
+			  qmi_get_error_str(err));
+
+	/* the registration state is published after the operator was loaded: wait for it */
+	if (m->reloading) {
+		m->enable_wait = en;
+		return;
+	}
+	m3_enable_next(en);
+}
+
+static void m3_enable_continue(struct modem_3gpp *m)
+{
+	struct m3_enable *en = m->enable_wait;
+
+	if (!en)
+		return;
+
+	m->enable_wait = NULL;
+	m3_enable_next(en);
+}
+
+static int en_send_signal_info(struct m3_enable *en)
+{
+	struct qmi_nas_register_indications_request rr = {};
+
+	qmi_set(&rr, signal_info, true);
+	return SEND_REQ(en->m->nas, qmi_set_nas_register_indications_request(_m, &rr), en_signal_info_cb, en, 5000);
+}
+
+static int en_send_event_report(struct m3_enable *en)
+{
+	/* The device doesn't really like many thresholds. Chosen towards their results through MM_RSSI_TO_QUALITY:
+	 * -106 dBm 11%, -94 dBm 30%, -82 dBm 50%, -69 dBm 70%, -57 dBm 90% */
+	static int8_t thresholds[] = { -106, -94, -82, -69, -57 };
+	struct qmi_nas_set_event_report_request er = {};
+
+	er.set.signal_strength_indicator = 1;
+	er.data.signal_strength_indicator.report = true;
+	er.data.signal_strength_indicator.thresholds_n = ARRAY_SIZE(thresholds);
+	er.data.signal_strength_indicator.thresholds = thresholds;
+	return SEND_REQ(en->m->nas, qmi_set_nas_set_event_report_request(_m, &er), en_event_report_cb, en, 5000);
+}
+
+static int en_send_system_info(struct m3_enable *en)
+{
+	/* MM: system info indications, serving system events are turned off since some modems have them active by
+	 * default */
+	struct qmi_nas_register_indications_request rr = {};
+
+	qmi_set(&rr, system_info, true);
+	qmi_set(&rr, serving_system_events, false);
+	return SEND_REQ(en->m->nas, qmi_set_nas_register_indications_request(_m, &rr), en_reg_events_cb, en, 5000);
+}
+
+static int en_send_serving_system(struct m3_enable *en)
+{
+	struct qmi_nas_register_indications_request rr = {};
+
+	qmi_set(&rr, serving_system_events, true);
+	return SEND_REQ(en->m->nas, qmi_set_nas_register_indications_request(_m, &rr), en_reg_events_cb, en, 5000);
+}
+
+static void m3_enable_step(struct m3_enable *en)
+{
+	struct modem_3gpp *m = en->m;
+
+	switch (en->step) {
+	case EN_FIRST:
+		/* Interface state is assumed enabled from the very beginning of the enabling sequence, so that
+		 * updates are taken into account and not ignored. */
+		m->enabled = true;
+		m->nas = uqmi_service_find(m->modem->qmi, QMI_SERVICE_NAS);
+		if (!m->nas) {
+			modem_log(m->modem, LOGL_NOTICE, "NAS not available, the registration is not tracked");
+			en->step = EN_LAST;
+			m3_enable_step(en);
+			return;
+		}
+		m->state = REG_UNKNOWN;
+		m->cs = m->ps = m->eps = REG_UNKNOWN;
+		m->act = 0;
+		m->signal_valid = false;
+		m3_register_callbacks(m);
+		en->step = EN_SIGNAL_INFO;
+		m3_enable_step(en);
+		return;
+
+	case EN_SIGNAL_INFO:
+		/* MM: setup/enable unsolicited events: signal info indications */
+		if (en_send_signal_info(en)) {
+			en->step = EN_EVENT_REPORT;
+			m3_enable_step(en);
+		}
+		return;
+
+	case EN_EVENT_REPORT:
+		if (en_send_event_report(en))
+			m3_enable_next(en);
+		return;
+
+	case EN_REG_EVENTS_SYSTEM_INFO:
+		if (en_send_system_info(en)) {
+			en->step = EN_REG_EVENTS_SERVING_SYSTEM;
+			m3_enable_step(en);
+		}
+		return;
+
+	case EN_REG_EVENTS_SERVING_SYSTEM:
+		if (en_send_serving_system(en)) {
+			uloop_timeout_set(&m->check_timer, REGISTRATION_CHECK_TIMEOUT_MS);
+			en->step = EN_EPS;
+			m3_enable_step(en);
+		}
+		return;
+
+	case EN_EPS:
+		/* MM: the initial EPS bearer is loaded while enabling, the settings are kept as a property */
+		if (m3_wds(m)) {
+			m3_load_eps(m, en_eps_done, en);
+			return;
+		}
+		en->step = EN_CHECK;
+		m3_enable_step(en);
+		return;
+
+	case EN_CHECK:
+		/* the registration state at the end of the enable (MM runs this check right after the enable) */
+		if (m3_run_check(m, en_check_done, en)) {
+			en->step = EN_LAST;
+			m3_enable_step(en);
+		}
+		return;
+
+	case EN_LAST: {
+		void (*done)(struct modem *modem, void *data) = en->done;
+		void *data = en->data;
+		struct modem *modem = m->modem;
+
+		talloc_free(en);
+		m3_refresh_signal(m);
+		done(modem, data);
+		return;
+	}
+
+	default:
+		break;
+	}
+}
+
+void uqmid_3gpp_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_3gpp *m = m3(modem);
+	struct m3_enable *en = talloc_zero(m, struct m3_enable);
+
+	en->m = m;
+	en->done = done;
+	en->data = data;
+	en->step = EN_FIRST;
+	m3_enable_step(en);
+}
+
+struct m3_disable {
+	struct modem_3gpp *m;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+};
+
+static void dis_finish(struct m3_disable *dis)
+{
+	struct modem_3gpp *m = dis->m;
+	void (*done)(struct modem *modem, void *data) = dis->done;
+	void *data = dis->data;
+	struct modem *modem = m->modem;
+	enum reg_state old = m->state;
+
+	talloc_free(dis);
+
+	/* MM: DISABLING_STEP_REGISTRATION_STATE */
+	m->state = REG_UNKNOWN;
+	m->cs = m->ps = m->eps = REG_UNKNOWN;
+	m->act = 0;
+	m->signal_valid = false;
+	m->manual = false;
+	TALLOC_FREE(m->manual_op);
+	TALLOC_FREE(m->operator_code);
+	TALLOC_FREE(m->operator_name);
+	TALLOC_FREE(m->op_id);
+	TALLOC_FREE(m->op_desc);
+	m->reloading = false;
+	/* Interface state is assumed enabled until the very end of the disabling sequence */
+	m->enabled = false;
+	modem->sub_state = MODEM_STATE_ENABLED;
+	if (old != m->state)
+		m3_notify_registration(m, old);
+
+	done(modem, data);
+}
+
+static void dis_unregistered(struct m3_disable *dis, int err)
+{
+	struct modem_3gpp *m = dis->m;
+	struct qmi_nas_set_event_report_request er = {};
+	static int8_t thresholds[] = { -106, -94, -82, -69, -57 };
+
+	if (err)
+		modem_log(m->modem, LOGL_DEBUG, "couldn't disable registration indications: %d/%s", err,
+			  qmi_get_error_str(err));
+
+	m3_unregister_callbacks(m);
+
+	/* MM: always set thresholds, both in enable and disable, or the protocol complains */
+	if (m->event_report_ind && m->nas) {
+		er.set.signal_strength_indicator = 1;
+		er.data.signal_strength_indicator.report = false;
+		er.data.signal_strength_indicator.thresholds_n = ARRAY_SIZE(thresholds);
+		er.data.signal_strength_indicator.thresholds = thresholds;
+		SEND_REQ(m->nas, qmi_set_nas_set_event_report_request(_m, &er), NULL, NULL, 5000);
+	}
+	m->event_report_ind = m->signal_ind = m->sys_info_ind = m->serving_ind = false;
+
+	dis_finish(dis);
+}
+
+static void dis_reg_events_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	dis_unregistered(req->cb_data, !msg || req->ret ? (req->ret ? req->ret : -EIO) : 0);
+}
+
+void uqmid_3gpp_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_3gpp *m = m3(modem);
+	struct m3_disable *dis = talloc_zero(m, struct m3_disable);
+	struct qmi_nas_register_indications_request rr = {};
+
+	dis->m = m;
+	dis->done = done;
+	dis->data = data;
+
+	/* MM: DISABLING_STEP_INITIAL_EPS_BEARER, DISABLING_STEP_PERIODIC_REGISTRATION_CHECKS */
+	uloop_timeout_cancel(&m->check_timer);
+	uloop_timeout_cancel(&m->signal_timer);
+	m->eps_valid = false;
+	TALLOC_FREE(m->eps_apn);
+	TALLOC_FREE(m->eps_user);
+	TALLOC_FREE(m->eps_password);
+
+	/* a pending registration is aborted */
+	reg_abort(m);
+
+	if (!m->enabled || !m->nas || !(m->sys_info_ind || m->serving_ind || m->signal_ind)) {
+		dis_unregistered(dis, 0);
+		return;
+	}
+
+	qmi_set(&rr, system_info, false);
+	qmi_set(&rr, serving_system_events, false);
+	qmi_set(&rr, signal_info, false);
+	if (SEND_REQ(m->nas, qmi_set_nas_register_indications_request(_m, &rr), dis_reg_events_cb, dis, 5000))
+		dis_unregistered(dis, -EIO);
+}
+
+void uqmid_3gpp_init(struct modem *modem)
+{
+	struct modem_3gpp *m = talloc_zero(modem, struct modem_3gpp);
+
+	if (!m)
+		return;
+
+	m->modem = modem;
+	m->state = REG_UNKNOWN;
+	m->cs = m->ps = m->eps = REG_UNKNOWN;
+	m->eps_pdp_type = -1;
+	m->check_timer.cb = periodic_check_cb;
+	m->signal_timer.cb = signal_timer_cb;
+	modem->m3gpp = m;
+}
+
+void uqmid_3gpp_cleanup(struct modem *modem)
+{
+	struct modem_3gpp *m = m3(modem);
+
+	if (!m)
+		return;
+
+	uloop_timeout_cancel(&m->check_timer);
+	uloop_timeout_cancel(&m->signal_timer);
+	m->enabled = false;
+	reg_abort(m);
+	if (m->scan_ur) {
+		struct ureq *ur = m->scan_ur;
+
+		m->scan_ur = NULL;
+		m->scan_pending = false;
+		uqmid_ubus_deferred_done(&ur->req, MODEM_ERR_ABORTED, "Modem went away", NULL);
+		talloc_free(ur);
+	}
+}
+
+/*****************************************************************************/
+/* register (MM: mm_iface_modem_3gpp_register_in_network(), mm_shared_qmi_3gpp_register_in_network()) */
+
+struct reg_req {
+	struct modem_3gpp *m;
+	char *operator_id;
+	bool force;
+	unsigned int max_secs;
+	struct timespec start;
+	uqmid_3gpp_register_cb cb;
+	void *cb_data;
+	struct uloop_timeout timer;
+	bool finished;
+	/* the owner plus the requests which are in flight */
+	unsigned int refs;
+	/* the failure of the request to report from the timer */
+	enum modem_error deferred_err;
+};
+
+static void reg_put(struct reg_req *rr)
+{
+	if (--rr->refs == 0)
+		talloc_free(rr);
+}
+
+static void reg_complete(struct reg_req *rr, enum modem_error err, const char *msg)
+{
+	struct modem_3gpp *m = rr->m;
+
+	if (rr->finished)
+		return;
+
+	rr->finished = true;
+	uloop_timeout_cancel(&rr->timer);
+	if (m->reg == rr)
+		m->reg = NULL;
+
+	rr->cb(m->modem, err, msg ? msg : modem_error_message(err), rr->cb_data);
+	reg_put(rr);
+}
+
+/* MM: register_in_network_context_complete_failed(): the states are idle again */
+static void reg_failed(struct reg_req *rr, enum modem_error err, const char *msg)
+{
+	struct modem_3gpp *m = rr->m;
+
+	if (m->enabled)
+		m3_set_idle(m);
+	reg_complete(rr, err, msg);
+}
+
+static void reg_abort(struct modem_3gpp *m)
+{
+	if (m->reg)
+		reg_complete(m->reg, MODEM_ERR_ABORTED, NULL);
+}
+
+static void reg_check_loop(struct reg_req *rr);
+
+static void reg_recheck_timer_cb(struct uloop_timeout *t)
+{
+	struct reg_req *rr = container_of(t, struct reg_req, timer);
+
+	if (rr->finished)
+		return;
+
+	reg_check_loop(rr);
+}
+
+static void reg_loop_check_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct reg_req *rr = data;
+	struct timespec now;
+	enum reg_state state;
+
+	if (rr->finished)
+		goto out;
+
+	if (err) {
+		modem_log(m->modem, LOGL_INFO, "3GPP registration check failed: %d/%s", err, qmi_get_error_str(err));
+		reg_failed(rr, MODEM_ERR_FAILED, "Couldn't check the registration");
+		goto out;
+	}
+
+	state = get_consolidated_reg_state(m);
+
+	/* If we got a final state and it's denied, we can assume the registration is finished */
+	if (state == REG_DENIED) {
+		modem_log(m->modem, LOGL_INFO, "registration denied");
+		reg_failed(rr, MODEM_ERR_NETWORK_NOT_ALLOWED, "Network not allowed");
+		goto out;
+	}
+
+	/* If we got registered, end registration checks */
+	if (reg_state_is_registered(state)) {
+		/* Request immediate signal update: we may have changed from home to roaming or viceversa */
+		m3_refresh_signal(m);
+		modem_log(m->modem, LOGL_INFO, "currently registered in a 3GPP network");
+		reg_complete(rr, MODEM_ERR_NONE, NULL);
+		goto out;
+	}
+
+	/* Don't spend too much time waiting to get registered */
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (now.tv_sec - rr->start.tv_sec > (long)rr->max_secs) {
+		modem_log(m->modem, LOGL_INFO, "3GPP registration check timed out");
+		reg_failed(rr, MODEM_ERR_NETWORK_TIMEOUT, "Network timeout");
+		goto out;
+	}
+
+	/* If we're still waiting for automatic registration to complete or fail, check again in a few seconds
+	 * (this timeout will catch results from automatic registrations as well). */
+	modem_log(m->modem, LOGL_DEBUG, "not yet registered in a 3GPP network... will recheck soon");
+	rr->timer.cb = reg_recheck_timer_cb;
+	uloop_timeout_set(&rr->timer, REGISTER_RECHECK_MS);
+out:
+	reg_put(rr);
+}
+
+static void reg_check_loop(struct reg_req *rr)
+{
+	/* Get fresh registration state */
+	rr->refs++;
+	if (m3_run_check(rr->m, reg_loop_check_done, rr)) {
+		reg_put(rr);
+		reg_failed(rr, MODEM_ERR_UNSUPPORTED, "Registration state not available");
+	}
+}
+
+static void inr_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct reg_req *rr = req->cb_data;
+
+	if (!rr->finished) {
+		if (msg && !req->ret) {
+			/* Now try to gather the current registration status until we're registered or the time goes off */
+			reg_check_loop(rr);
+		} else if (req->ret == QMI_PROTOCOL_ERROR_NO_EFFECT) {
+			/* No effect would mean we're already in the desired network */
+			reg_check_loop(rr);
+		} else {
+			modem_log(rr->m->modem, LOGL_INFO, "couldn't initiate the network register: %d/%s", req->ret,
+				  qmi_get_error_str(req->ret));
+			reg_failed(rr, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED,
+				   "Couldn't initiate network register");
+		}
+	}
+
+	reg_put(rr);
+}
+
+static void sssp_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct reg_req *rr = req->cb_data;
+
+	if (!rr->finished) {
+		if ((msg && !req->ret) || req->ret == QMI_PROTOCOL_ERROR_NO_EFFECT) {
+			reg_check_loop(rr);
+		} else {
+			modem_log(rr->m->modem, LOGL_INFO, "couldn't set the network selection preference: %d/%s",
+				  req->ret, qmi_get_error_str(req->ret));
+			reg_failed(rr, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED,
+				   "Couldn't set network selection preference");
+		}
+	}
+
+	reg_put(rr);
+}
+
+static bool parse_operator_id(const char *op, unsigned int *mcc, unsigned int *mnc, bool *pcs)
+{
+	size_t len = strlen(op), i;
+	char buf[4];
+
+	/* MM: mm_3gpp_parse_operator_id(): MCC always 3 digits, MNC 2 or 3 */
+	if (len < 5 || len > 6)
+		return false;
+	for (i = 0; i < len; i++) {
+		if (op[i] < '0' || op[i] > '9')
+			return false;
+	}
+
+	memcpy(buf, op, 3);
+	buf[3] = 0;
+	*mcc = strtoul(buf, NULL, 10);
+	*mnc = strtoul(op + 3, NULL, 10);
+	*pcs = len == 6;
+	return true;
+}
+
+/* sssp is used if the modem doesn't know the initiate network register request */
+static int reg_send_sssp(struct reg_req *rr, unsigned int mcc, unsigned int mnc, bool pcs)
+{
+	struct qmi_nas_set_system_selection_preference_request sr = {};
+	int ret;
+
+	sr.set.network_selection_preference = 1;
+	sr.data.network_selection_preference.mode = mcc ? QMI_NAS_NETWORK_SELECTION_PREFERENCE_MANUAL :
+							  QMI_NAS_NETWORK_SELECTION_PREFERENCE_AUTOMATIC;
+	sr.data.network_selection_preference.mcc = mcc;
+	sr.data.network_selection_preference.mnc = mnc;
+	if (pcs && mnc < 100)
+		qmi_set(&sr, mnc_pcs_digit_include_status, true);
+
+	rr->refs++;
+	ret = SEND_REQ(rr->m->nas, qmi_set_nas_set_system_selection_preference_request(_m, &sr), sssp_cb, rr,
+		       REGISTER_REQ_TIMEOUT_MS);
+	if (ret)
+		rr->refs--;
+
+	return ret;
+}
+
+static void inr_first_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct reg_req *rr = req->cb_data;
+	unsigned int mcc = 0, mnc = 0;
+	bool pcs = false;
+
+	if (!rr->finished && !(msg && !req->ret) && (req->ret == QMI_PROTOCOL_ERROR_INVALID_QMI_COMMAND ||
+						     req->ret == QMI_PROTOCOL_ERROR_NOT_SUPPORTED)) {
+		/* not implemented by the modem: the system selection preference does the same */
+		if (rr->operator_id && *rr->operator_id)
+			parse_operator_id(rr->operator_id, &mcc, &mnc, &pcs);
+		if (!reg_send_sssp(rr, mcc, mnc, pcs))
+			goto out;
+	}
+
+	inr_cb(service, req, msg);
+	return;
+out:
+	reg_put(rr);
+}
+
+static void reg_launch(struct reg_req *rr)
+{
+	struct modem_3gpp *m = rr->m;
+	struct qmi_nas_initiate_network_register_request nr = {};
+	unsigned int mcc = 0, mnc = 0;
+	bool pcs = false;
+
+	if (rr->operator_id && *rr->operator_id) {
+		parse_operator_id(rr->operator_id, &mcc, &mnc, &pcs);
+		/* If the user sent a specific network to use, lock it in. */
+		qmi_set(&nr, action, QMI_NAS_NETWORK_REGISTER_TYPE_MANUAL);
+		nr.set.manual_registration_info_3gpp = 1;
+		nr.data.manual_registration_info_3gpp.mcc = mcc;
+		nr.data.manual_registration_info_3gpp.mnc = mnc;
+		/* don't change the radio interface */
+		nr.data.manual_registration_info_3gpp.radio_interface = QMI_NAS_RADIO_INTERFACE_UNKNOWN;
+		if (pcs && mnc < 100)
+			qmi_set(&nr, mnc_pcs_digit_include_status, true);
+	} else {
+		/* Otherwise, automatic registration */
+		qmi_set(&nr, action, QMI_NAS_NETWORK_REGISTER_TYPE_AUTOMATIC);
+	}
+
+	clock_gettime(CLOCK_MONOTONIC, &rr->start);
+	rr->refs++;
+	if (SEND_REQ(m->nas, qmi_set_nas_initiate_network_register_request(_m, &nr), inr_first_cb, rr,
+		     REGISTER_REQ_TIMEOUT_MS)) {
+		reg_put(rr);
+		reg_failed(rr, MODEM_ERR_FAILED, "Couldn't initiate network register");
+	}
+}
+
+/* MM: initial_registration_checks_ready() */
+static void reg_initial_check_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct reg_req *rr = data;
+	const char *current_code;
+	enum reg_state state;
+
+	if (rr->finished)
+		goto out;
+
+	if (err)
+		modem_log(m->modem, LOGL_INFO, "initial 3GPP registration check failed: %d/%s", err,
+			  qmi_get_error_str(err));
+	/* Just continue as if nothing happened */
+
+	current_code = m->operator_code;
+	state = m->state;
+
+	if (rr->operator_id && *rr->operator_id) {
+		/* If already registered manually with the requested operator, we're done */
+		if (!rr->force && current_code && !strcmp(current_code, rr->operator_id) &&
+		    reg_state_is_registered(state) && m->manual) {
+			modem_log(m->modem, LOGL_INFO,
+				  "already registered manually in selected network '%s', manual registration not launched...",
+				  current_code);
+			reg_complete(rr, MODEM_ERR_NONE, NULL);
+			goto out;
+		}
+
+		/* Manual registration to a new operator required */
+		modem_log(m->modem, LOGL_INFO, "launching manual network registration in '%s'...", rr->operator_id);
+		m3_set_str(m->modem, &m->manual_op, rr->operator_id);
+		m->manual = true;
+	} else {
+		/* If the modem is already registered and the last time it was asked automatic registration, we're done */
+		if (!rr->force && reg_state_is_registered(state) && !m->manual) {
+			modem_log(m->modem, LOGL_INFO,
+				  "already registered automatically in network '%s', automatic registration not launched...",
+				  current_code ? current_code : "unknown");
+			reg_complete(rr, MODEM_ERR_NONE, NULL);
+			goto out;
+		}
+
+		/* Automatic registration to a new operator requested */
+		modem_log(m->modem, LOGL_INFO, "launching automatic network registration...");
+		TALLOC_FREE(m->manual_op);
+		m->manual = false;
+	}
+
+	reg_launch(rr);
+out:
+	reg_put(rr);
+}
+
+static void reg_deferred_cb(struct uloop_timeout *t)
+{
+	struct reg_req *rr = container_of(t, struct reg_req, timer);
+
+	reg_complete(rr, rr->deferred_err, NULL);
+}
+
+int uqmid_3gpp_register(struct modem *modem, const char *operator_id, bool force, unsigned int max_secs,
+			uqmid_3gpp_register_cb cb, void *data)
+{
+	struct modem_3gpp *m = m3(modem);
+	struct reg_req *rr;
+	unsigned int mcc, mnc;
+	bool pcs;
+
+	if (operator_id && *operator_id && !parse_operator_id(operator_id, &mcc, &mnc, &pcs))
+		return -EINVAL;
+
+	/* (Try to) cancel previous registration request */
+	reg_abort(m);
+
+	rr = talloc_zero(m, struct reg_req);
+	rr->m = m;
+	rr->refs = 1;
+	rr->force = force;
+	rr->max_secs = max_secs;
+	rr->cb = cb;
+	rr->cb_data = data;
+	if (operator_id && *operator_id)
+		rr->operator_id = talloc_strdup(rr, operator_id);
+	m->reg = rr;
+
+	/* Query initial registration state here in order to avoid re-registering. */
+	rr->refs++;
+	if (m3_run_check(m, reg_initial_check_done, rr)) {
+		reg_put(rr);
+		rr->deferred_err = MODEM_ERR_UNSUPPORTED;
+		rr->timer.cb = reg_deferred_cb;
+		uloop_timeout_set(&rr->timer, 0);
+	}
+
+	return 0;
+}
+
+int uqmid_3gpp_reregister(struct modem *modem, uqmid_3gpp_register_cb cb, void *data)
+{
+	/* MM: REREGISTER_IN_NETWORK_TIMEOUT 120, forced, with the last settings */
+	return uqmid_3gpp_register(modem, m3(modem)->manual_op, true, 120, cb, data);
+}
+
+/*****************************************************************************/
+/* ubus: replies of the deferred requests */
+
+static struct blob_buf b;
+
+static void register_done(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct ureq *ur = data;
+	struct modem_3gpp *m = m3(modem);
+
+	blob_buf_init(&b, 0);
+	if (!err) {
+		blobmsg_add_string(&b, "registration_state", reg_state_name(m->state));
+		blobmsg_add_string(&b, "operator_code", m->operator_code ? m->operator_code : "");
+		blobmsg_add_string(&b, "operator_name", m->operator_name ? m->operator_name : "");
+	}
+	uqmid_ubus_deferred_done(&ur->req, err, msg, b.head);
+	talloc_free(ur);
+}
+
+enum { RG_OPERATOR_ID, __RG_MAX };
+static const struct blobmsg_policy register_policy[__RG_MAX] = {
+	[RG_OPERATOR_ID] = { .name = "operator_id", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 register '{"operator_id": "45008"}' (empty or none: automatic registration) */
+static int h_register(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		      const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__RG_MAX];
+	const char *op = NULL;
+	struct ureq *ur;
+
+	blobmsg_parse(register_policy, __RG_MAX, tb, blob_data(msg), blob_len(msg));
+	if (tb[RG_OPERATOR_ID])
+		op = blobmsg_get_string(tb[RG_OPERATOR_ID]);
+
+	/* MM: handle_register_auth_ready() */
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Device not yet enabled");
+	if (modem->mm_state > MODEM_STATE_REGISTERED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE,
+					      "Operation not allowed while modem is connected");
+
+	ur = talloc_zero(modem, struct ureq);
+	ur->modem = modem;
+	ubus_defer_request(ctx, req, &ur->req);
+	if (op && *op)
+		modem_log(modem, LOGL_INFO, "processing user request to register modem in '%s'...", op);
+	else
+		modem_log(modem, LOGL_INFO, "processing user request to register modem...");
+	if (uqmid_3gpp_register(modem, op, false, REGISTER_MAX_SECS, register_done, ur)) {
+		uqmid_ubus_deferred_done(&ur->req, MODEM_ERR_INVALID_ARGS, "Invalid operator id", NULL);
+		talloc_free(ur);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* scan (MM: mm_shared_qmi_3gpp_scan_networks()) */
+
+struct scan_ctx {
+	struct ureq *ur;
+};
+
+static const char *scan_status_name(uint8_t status)
+{
+	/* MM: network_availability_from_qmi_nas_network_status() */
+	if (status & QMI_NAS_NETWORK_STATUS_CURRENT_SERVING)
+		return "current";
+	if (status & QMI_NAS_NETWORK_STATUS_AVAILABLE)
+		return status & QMI_NAS_NETWORK_STATUS_FORBIDDEN ? "forbidden" : "available";
+
+	return "unknown";
+}
+
+static void scan_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct ureq *ur = req->cb_data;
+	struct modem *modem = ur->modem;
+	struct modem_3gpp *m = m3(modem);
+	struct qmi_nas_network_scan_response res = {};
+	bool used[64] = {};
+	void *a, *t;
+	unsigned int i, j;
+
+	if (!msg || req->ret || qmi_parse_nas_network_scan_response(msg, &res)) {
+		modem_log(modem, LOGL_NOTICE, "failed scanning networks: %d/%s", req->ret, qmi_get_error_str(req->ret));
+		m->scan_pending = false;
+		m->scan_ur = NULL;
+		uqmid_ubus_deferred_done(&ur->req, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED,
+					 "Couldn't scan networks", NULL);
+		talloc_free(ur);
+		return;
+	}
+
+	blob_buf_init(&b, 0);
+	a = blobmsg_open_array(&b, "networks");
+	for (i = 0; i < res.data.network_information_n; i++) {
+		const typeof(*res.data.network_information) *ni = &res.data.network_information[i];
+		uint32_t act = 0;
+		char code[8];
+		bool pcs = false;
+
+		/* MCC always 3 digits. Guess about MNC, if < 100 assume it's 2 digits, unless it says otherwise. */
+		for (j = 0; j < res.data.mnc_pcs_digit_include_status_n; j++) {
+			if (res.data.mnc_pcs_digit_include_status[j].mcc == ni->mcc &&
+			    res.data.mnc_pcs_digit_include_status[j].mnc == ni->mnc)
+				pcs = res.data.mnc_pcs_digit_include_status[j].includes_pcs_digit;
+		}
+		if (ni->mnc >= 100 || pcs)
+			snprintf(code, sizeof(code), "%.3u%.3u", ni->mcc, ni->mnc);
+		else
+			snprintf(code, sizeof(code), "%.3u%.2u", ni->mcc, ni->mnc);
+
+		for (j = 0; j < res.data.radio_access_technology_n && j < ARRAY_SIZE(used); j++) {
+			if (used[j] || res.data.radio_access_technology[j].mcc != ni->mcc ||
+			    res.data.radio_access_technology[j].mnc != ni->mnc)
+				continue;
+			used[j] = true;
+			act = act_from_radio_interface(res.data.radio_access_technology[j].radio_interface);
+			break;
+		}
+
+		modem_log(modem, LOGL_INFO, "  mccmnc: %s, status: %s, access tech: 0x%x, long name: %s", code,
+			  scan_status_name(ni->network_status), act, ni->description ? ni->description : "n/a");
+
+		t = blobmsg_open_table(&b, NULL);
+		blobmsg_add_string(&b, "operator_code", code);
+		blobmsg_add_string(&b, "status", scan_status_name(ni->network_status));
+		uqmid_add_access_technologies(&b, "access_technology", act);
+		if (ni->description && *ni->description)
+			blobmsg_add_string(&b, "operator_long", ni->description);
+		blobmsg_close_table(&b, t);
+	}
+	blobmsg_close_array(&b, a);
+
+	modem_log(modem, LOGL_INFO, "network scan performed: %u found", res.data.network_information_n);
+	m->scan_pending = false;
+	m->scan_ur = NULL;
+	uqmid_ubus_deferred_done(&ur->req, MODEM_ERR_NONE, NULL, b.head);
+	talloc_free(ur);
+}
+
+/** ubus call uqmid.modem.0 scan */
+static int h_scan(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_3gpp *m = m3(modem);
+	struct qmi_nas_network_scan_request sr = {};
+	struct ureq *ur;
+	struct qmi_service *nas = uqmi_service_find(modem->qmi, QMI_SERVICE_NAS);
+
+	/* MM: mm_iface_modem_abort_invocation_if_state_not_reached(ENABLED) */
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+	if (!nas)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED,
+					      "Cannot scan networks: operation not supported");
+	if (m->scan_pending)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS, "A scan is already running");
+
+	/* the non-5GNR scan covers gsm, umts and lte */
+	qmi_set(&sr, network_type, QMI_NAS_NETWORK_SCAN_TYPE_GSM | QMI_NAS_NETWORK_SCAN_TYPE_UMTS |
+				   QMI_NAS_NETWORK_SCAN_TYPE_LTE);
+	ur = talloc_zero(modem, struct ureq);
+	ur->modem = modem;
+	ubus_defer_request(ctx, req, &ur->req);
+	m->scan_pending = true;
+	m->scan_ur = ur;
+	modem_log(modem, LOGL_INFO, "processing user request to scan networks...");
+	if (SEND_REQ(nas, qmi_set_nas_network_scan_request(_m, &sr), scan_cb, ur, SCAN_TIMEOUT_MS)) {
+		m->scan_pending = false;
+		m->scan_ur = NULL;
+		uqmid_ubus_deferred_done(&ur->req, MODEM_ERR_FAILED, "Couldn't start the scan", NULL);
+		talloc_free(ur);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* set_initial_eps_bearer_settings (MM: handle_set_initial_eps_bearer_settings_step()) */
+
+enum {
+	EPS_LOAD,
+	EPS_POWER_DOWN,
+	EPS_UPDATE,
+	EPS_PREVIOUS_POWER,
+	EPS_RELOAD,
+};
+
+struct eps_set {
+	int step;
+	char *apn;
+	char *user;
+	char *password;
+	int pdp_type;
+	int auth;
+	bool force;
+	enum modem_power_state prev_power;
+	enum modem_error err;
+	const char *err_msg;
+};
+
+static void eps_set_finish(struct modem_op *op)
+{
+	struct eps_set *es = op->priv;
+
+	uqmid_modem_op_done(op, es->err, es->err_msg);
+}
+
+static void eps_set_step(struct modem_op *op);
+
+static void eps_modify_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem_op *op = req->cb_data;
+	struct eps_set *es = op->priv;
+
+	if (!msg || req->ret) {
+		modem_log(op->modem, LOGL_NOTICE, "failed setting initial EPS bearer settings: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+		es->err = req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED;
+		es->err_msg = "Couldn't set the initial EPS bearer settings";
+		/* we continue the steps in order to power up after the failure if needed */
+	} else {
+		modem_log(op->modem, LOGL_INFO, "initial EPS bearer settings updated");
+	}
+
+	es->step = EPS_PREVIOUS_POWER;
+	eps_set_step(op);
+}
+
+static void eps_reload_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct modem_op *op = data;
+	struct eps_set *es = op->priv;
+
+	if (err) {
+		es->err = MODEM_ERR_FAILED;
+		es->err_msg = "Couldn't reload the initial EPS bearer settings";
+	} else if (strcmp(m->eps_apn ? m->eps_apn : "", es->apn ? es->apn : "") ||
+		   (es->pdp_type >= 0 && m->eps_pdp_type != es->pdp_type)) {
+		modem_log(op->modem, LOGL_NOTICE, "requested and reloaded initial EPS bearer settings don't match");
+		es->err = MODEM_ERR_FAILED;
+		es->err_msg = "Initial EPS bearer settings were not updated";
+	}
+
+	eps_set_finish(op);
+}
+
+static void eps_power_done(struct modem_op *op)
+{
+	struct eps_set *es = op->priv;
+
+	if (es->step == EPS_POWER_DOWN) {
+		if (op->power_err) {
+			modem_log(op->modem, LOGL_NOTICE,
+				  "failed to power down modem before updating initial EPS bearer settings");
+			es->err = op->power_err;
+			es->err_msg = "Couldn't power down the modem";
+			eps_set_finish(op);
+			return;
+		}
+
+		/* If we could not load the previous power state, assume it was 'on', the most likely case */
+		es->prev_power = op->prev_real == MODEM_POWER_UNKNOWN ? MODEM_POWER_ON : op->prev_real;
+		es->step = EPS_UPDATE;
+	} else {
+		if (op->power_err) {
+			modem_log(op->modem, LOGL_NOTICE,
+				  "failed to restore power state after updating initial EPS bearer settings");
+			if (!es->err) {
+				es->err = op->power_err;
+				es->err_msg = "Couldn't restore the power state";
+			}
+		}
+
+		/* Jump to last if there is any error */
+		es->step = es->err ? EPS_RELOAD + 1 : EPS_RELOAD;
+	}
+
+	eps_set_step(op);
+}
+
+static void eps_set_step(struct modem_op *op)
+{
+	struct eps_set *es = op->priv;
+	struct modem *modem = op->modem;
+	struct modem_3gpp *m = m3(modem);
+	struct qmi_wds_modify_profile_request pr = {};
+
+	switch (es->step) {
+	case EPS_POWER_DOWN:
+		modem_log(modem, LOGL_INFO, "set initial EPS bearer settings state (power down)");
+		op->power_done = eps_power_done;
+		uqmid_modem_op_power_start(op, MODEM_POWER_LOW);
+		return;
+
+	case EPS_UPDATE:
+		modem_log(modem, LOGL_INFO, "set initial EPS bearer settings state (update)");
+		pr.set.profile_identifier = 1;
+		pr.data.profile_identifier.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+		pr.data.profile_identifier.profile_index = m->attach_pdn;
+		if (es->apn)
+			pr.data.apn_name = es->apn;
+		if (es->pdp_type >= 0)
+			qmi_set(&pr, pdp_type, es->pdp_type);
+		if (es->auth >= 0)
+			qmi_set(&pr, authentication, es->auth);
+		if (es->user)
+			pr.data.username = es->user;
+		if (es->password)
+			pr.data.password = es->password;
+		if (SEND_REQ(m3_wds(m), qmi_set_wds_modify_profile_request(_m, &pr), eps_modify_cb, op, 10000)) {
+			es->err = MODEM_ERR_FAILED;
+			es->err_msg = "Couldn't set the initial EPS bearer settings";
+			es->step = EPS_PREVIOUS_POWER;
+			eps_set_step(op);
+		}
+		return;
+
+	case EPS_PREVIOUS_POWER:
+		modem_log(modem, LOGL_INFO, "set initial EPS bearer settings state (recover previous power state)");
+		op->power_done = eps_power_done;
+		uqmid_modem_op_power_start(op, es->prev_power);
+		return;
+
+	case EPS_RELOAD:
+		modem_log(modem, LOGL_INFO, "set initial EPS bearer settings state (reload)");
+		m3_load_eps(m, eps_reload_done, op);
+		return;
+
+	default:
+		eps_set_finish(op);
+		return;
+	}
+}
+
+static void eps_load_before_done(struct modem_3gpp *m, int err, void *data)
+{
+	struct modem_op *op = data;
+	struct eps_set *es = op->priv;
+
+	if (!m->attach_pdn) {
+		es->err = MODEM_ERR_FAILED;
+		es->err_msg = "Unknown default LTE attach APN index";
+		eps_set_finish(op);
+		return;
+	}
+
+	/* MM: skipped if the same configuration is provided */
+	if (!es->force && !err && m->eps_valid && !strcmp(m->eps_apn ? m->eps_apn : "", es->apn ? es->apn : "") &&
+	    (es->pdp_type < 0 || m->eps_pdp_type == es->pdp_type) &&
+	    (es->auth < 0 || m->eps_auth == es->auth) &&
+	    (!es->user || !strcmp(m->eps_user ? m->eps_user : "", es->user)) &&
+	    (!es->password || !strcmp(m->eps_password ? m->eps_password : "", es->password))) {
+		modem_log(op->modem, LOGL_INFO, "skipped setting initial EPS bearer settings: same configuration provided");
+		eps_set_finish(op);
+		return;
+	}
+
+	es->step = EPS_POWER_DOWN;
+	eps_set_step(op);
+}
+
+static void eps_set_start(struct modem_op *op)
+{
+	struct eps_set *es = op->priv;
+	struct modem *modem = op->modem;
+	struct modem_3gpp *m = m3(modem);
+
+	modem_log(modem, LOGL_INFO, "processing user request to set initial EPS bearer settings%s...",
+		  es->force ? " (forced)" : "");
+	if (!m3_wds(m)) {
+		es->err = MODEM_ERR_UNSUPPORTED;
+		es->err_msg = "Operation not supported";
+		eps_set_finish(op);
+		return;
+	}
+
+	/* the current settings (and the profile to update) */
+	es->step = EPS_LOAD;
+	m3_load_eps(m, eps_load_before_done, op);
+}
+
+enum { ES_APN, ES_IP_TYPE, ES_AUTH, ES_USER, ES_PASSWORD, ES_FORCE, __ES_MAX };
+static const struct blobmsg_policy eps_set_policy[__ES_MAX] = {
+	[ES_APN] = { .name = "apn", .type = BLOBMSG_TYPE_STRING },
+	[ES_IP_TYPE] = { .name = "ip_type", .type = BLOBMSG_TYPE_STRING },
+	[ES_AUTH] = { .name = "allowed_auth", .type = BLOBMSG_TYPE_UNSPEC },
+	[ES_USER] = { .name = "user", .type = BLOBMSG_TYPE_STRING },
+	[ES_PASSWORD] = { .name = "password", .type = BLOBMSG_TYPE_STRING },
+	[ES_FORCE] = { .name = "force", .type = BLOBMSG_TYPE_BOOL },
+};
+
+/** ubus call uqmid.modem.0 set_initial_eps_bearer_settings '{"apn":"internet","ip_type":"ipv4v6"}' */
+static int h_set_eps(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		     const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__ES_MAX];
+	struct modem_op *op;
+	struct eps_set *es;
+	int ip_type, auth = -1;
+
+	blobmsg_parse(eps_set_policy, __ES_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[ES_APN] && !tb[ES_IP_TYPE] && !tb[ES_AUTH] && !tb[ES_USER] && !tb[ES_PASSWORD])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	ip_type = tb[ES_IP_TYPE] ? uqmid_parse_ip_type(blobmsg_get_string(tb[ES_IP_TYPE])) : IP_TYPE_ANY;
+	if (ip_type < 0)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid IP type");
+	if (tb[ES_AUTH] && uqmid_parse_allowed_auth(tb[ES_AUTH], &auth))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED, "Unsupported authentication methods");
+
+	op = uqmid_modem_op_alloc(modem, req, eps_set_start);
+	if (!op)
+		return UBUS_STATUS_UNKNOWN_ERROR;
+
+	es = talloc_zero(op, struct eps_set);
+	op->priv = es;
+	if (tb[ES_APN])
+		es->apn = talloc_strdup(es, blobmsg_get_string(tb[ES_APN]));
+	if (tb[ES_USER])
+		es->user = talloc_strdup(es, blobmsg_get_string(tb[ES_USER]));
+	if (tb[ES_PASSWORD])
+		es->password = talloc_strdup(es, blobmsg_get_string(tb[ES_PASSWORD]));
+	es->pdp_type = uqmid_ip_type_to_pdp_type(ip_type);
+	es->auth = auth;
+	es->force = tb[ES_FORCE] && blobmsg_get_bool(tb[ES_FORCE]);
+	uqmid_modem_op_submit(op);
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* ubus */
+
+static const struct ubus_method m3_methods[] = {
+	UBUS_METHOD("register", h_register, register_policy),
+	UBUS_METHOD_NOARG("scan", h_scan),
+	UBUS_METHOD("set_initial_eps_bearer_settings", h_set_eps, eps_set_policy),
+};
+
+const struct ubus_method *uqmid_3gpp_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(m3_methods);
+	return m3_methods;
+}

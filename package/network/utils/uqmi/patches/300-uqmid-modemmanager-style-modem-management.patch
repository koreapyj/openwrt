+/*
+ * uqmid -- bearers (ModemManager: Bearer, MMBaseBearer + MMBearerQmi)
+ *
+ * ubus object uqmid.modem.<N>.bearer.<M>. The connection logic follows mm-bearer-qmi.c (connect_context_step(),
+ * disconnect_context_step()) and mm-base-bearer.c (status, connection error, forced disconnection).
+ */
+#ifndef __UQMID_BEARER_H
+#define __UQMID_BEARER_H
+
+#include <libubus.h>
+
+#include "modem.h"
+
+/* MMBearerIpFamily (the part we use) */
+enum bearer_ip_type {
+	IP_TYPE_ANY = 0,
+	IP_TYPE_IPV4 = 1,
+	IP_TYPE_IPV6 = 2,
+	IP_TYPE_IPV4V6 = 3,
+};
+
+/* MMBearerStatus */
+enum bearer_status {
+	BEARER_DISCONNECTED = 1,
+	BEARER_CONNECTING = 2,
+	BEARER_CONNECTED = 3,
+	BEARER_DISCONNECTING = 4,
+};
+
+/* MMBearerProperties (the 3GPP part) */
+struct bearer_props {
+	char *apn;
+	char *user;
+	char *password;
+	enum bearer_ip_type ip_type;
+	/* QMI authentication preference (PAP = 1, CHAP = 2), -1: not given (CHAP if there is a user or password) */
+	int auth;
+	bool allow_roaming;
+	/* profile index, -1: none */
+	int profile_id;
+};
+
+struct bearer;
+
+/* the bearer properties */
+int uqmid_parse_ip_type(const char *name);
+const char *uqmid_ip_type_name(int ip_type);
+/* QMI_WDS_PDP_TYPE_*, -1 for "any" */
+int uqmid_ip_type_to_pdp_type(int ip_type);
+/* allowed_auth: a string ("none", "pap", "chap", "pap|chap") or an array of them. 0 on success, *auth is the QMI mask */
+int uqmid_parse_allowed_auth(struct blob_attr *attr, int *auth);
+void uqmid_add_allowed_auth(struct blob_buf *bb, const char *name, uint8_t qmi_auth);
+
+/* ubus arguments {apn, ip_type, allowed_auth, user, password, allow_roaming, profile_id} of create_bearer and
+ * simple_connect. Fills @props (strings are children of @ctx). */
+enum modem_error uqmid_bearer_props_parse(void *ctx, struct blob_attr *apn, struct blob_attr *ip_type,
+					  struct blob_attr *auth, struct blob_attr *user, struct blob_attr *password,
+					  struct blob_attr *allow_roaming, struct blob_attr *profile_id,
+					  struct bearer_props *props, const char **msg);
+
+/* modem life cycle */
+void uqmid_bearers_cleanup(struct modem *modem);
+/* a bearer is connecting, connected or disconnecting */
+bool uqmid_bearers_busy(struct modem *modem);
+unsigned int uqmid_bearers_count_connected(struct modem *modem);
+/* MM: mm_bearer_list_find_by_profile_id(): a bearer which is connected through the profile (MM sets the profile id of
+ * the bearer when it is connected and clears it when it is disconnected) */
+bool uqmid_bearers_profile_in_use(struct modem *modem, int profile_id);
+/* MM: mm_bearer_list_disconnect_all_bearers(). The callback is called exactly once. */
+void uqmid_bearers_disconnect_all(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data);
+/* the registration changed (MM: modem_3gpp_registration_state_changed() of each bearer) */
+void uqmid_bearers_registration_changed(struct modem *modem);
+/* "bearers": the paths */
+void uqmid_bearers_add_paths(struct modem *modem, struct blob_buf *bb, const char *name);
+
+/* the bearers of the modem (at most @max) */
+unsigned int uqmid_bearers_list(struct modem *modem, struct bearer **out, unsigned int max);
+
+/* bearers (used by the simple interface) */
+typedef void (*bearer_cb)(struct modem *modem, enum modem_error err, const char *msg, void *data);
+struct bearer *uqmid_bearer_find(struct modem *modem, const char *path);
+struct bearer *uqmid_bearer_find_matching(struct modem *modem, const struct bearer_props *props);
+enum modem_error uqmid_bearer_create(struct modem *modem, const struct bearer_props *props, struct bearer **out,
+				     const char **msg);
+const char *uqmid_bearer_path(struct bearer *bearer);
+enum bearer_status uqmid_bearer_status(struct bearer *bearer);
+/* The callbacks are never called from within these calls. They are called exactly once. */
+void uqmid_bearer_connect(struct bearer *bearer, bearer_cb cb, void *data);
+void uqmid_bearer_disconnect(struct bearer *bearer, bearer_cb cb, void *data);
+
+/* the connection error of a failed connect: {name, message} (for the reply of the connect) */
+void uqmid_bearer_add_connection_error(struct bearer *bearer, struct blob_buf *bb, const char *name);
+
+/* modem methods: create_bearer, delete_bearer */
+const struct ubus_method *uqmid_bearer_modem_ubus_methods(unsigned int *n);
+
+#endif /* __UQMID_BEARER_H */

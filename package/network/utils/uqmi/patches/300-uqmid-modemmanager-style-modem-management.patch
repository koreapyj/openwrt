+/*****************************************************************************/
+/* lifecycle */
+
+struct reprobe_add {
+	struct uloop_timeout timer;
+	char *device;
+};
+
+/* probe the device again, a new modem object (new index) is created */
+static void reprobe_add_cb(struct uloop_timeout *t)
+{
+	struct reprobe_add *ra = container_of(t, struct reprobe_add, timer);
+	int ret = uqmid_modem_add(ra->device);
+
+	if (ret && ret != -EALREADY)
+		LOG_ERROR("reprobe of %s failed: %s\n", ra->device, strerror(-ret));
+	free(ra->device);
+	free(ra);
+}
+
+static void modem_closed_cb(struct qmi_dev *dev, void *data)
+{
+	struct modem *modem = data;
+	struct reprobe_add *ra = NULL;
+
+	if (modem->reprobe && !shutting_down) {
+		ra = calloc(1, sizeof(*ra));
+		if (ra) {
+			ra->device = strdup(modem->device);
+			if (!ra->device) {
+				free(ra);
+				ra = NULL;
+			}
+		}
+	}
+
+	uloop_timeout_cancel(&modem->ops_timer);
+	uloop_timeout_cancel(&modem->destroy_timer);
+	list_del(&modem->list);
+	talloc_free(modem);
+
+	if (ra) {
+		ra->timer.cb = reprobe_add_cb;
+		uloop_timeout_set(&ra->timer, 0);
+	}
+
+	if (shutting_down && list_empty(&uqmid_modems))
+		uloop_end();
+}
+
+/*
+ * Tear the modem down. Runs from a uloop timeout, never from one of the
+ * modem's own callbacks (stream, request or FSM), so everything can be freed.
+ */
+static void modem_destroy_cb(struct uloop_timeout *t)
+{
+	struct modem *modem = container_of(t, struct modem, destroy_timer);
+	char *path, *device;
+	bool graceful = modem->graceful;
+
+	modem_log(modem, LOGL_INFO, "removing modem %s (%s)", modem->device, graceful ? "release" : "gone");
+
+	/* fail the user requests first, the callbacks of in-flight requests are dropped by the close */
+	modem_ops_abort(modem);
+	TALLOC_FREE(modem->power_get);
+	uloop_timeout_cancel(&modem->sim.check_timer);
+	uloop_timeout_cancel(&modem->sim.refresh_timer);
+	uqmid_carrier_config_cancel(modem);
+	uqmid_simple_cleanup(modem);
+	uqmid_bearers_cleanup(modem);
+	uqmid_voice_cleanup(modem);
+	uqmid_cell_info_cleanup(modem);
+	uqmid_ext_cleanup(modem);
+	uqmid_modes_bands_cleanup(modem);
+	uqmid_profile_manager_cleanup(modem);
+	uqmid_signal_cleanup(modem);
+	uqmid_messaging_cleanup(modem);
+	uqmid_3gpp_cleanup(modem);
+
+	if (modem->fi) {
+		osmo_fsm_inst_term(modem->fi, OSMO_FSM_TERM_REGULAR, NULL);
+		modem->fi = NULL;
+		modem->sim.fi = NULL;

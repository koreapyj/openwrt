+static int parse_uim_apdu(struct modem *modem, struct blob_attr **tb, struct ext_args *a, const char **err)
+{
+	const char *apdu = ext_str(tb[U_AID]);
+
+	if (!apdu || !ext_hex_parse(apdu, a->apdu, sizeof(a->apdu), &a->apdu_n)) {
+		*err = "apdu has to be a hex string of 1 to 512 bytes";

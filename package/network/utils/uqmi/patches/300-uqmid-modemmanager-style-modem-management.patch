+	.parse = parse_uim_power,
+	.encode = enc_power_off,
+};
+
+static const struct ext_method m_uim_power_on = {
+	.name = "uim_power_on",
+	.service = QMI_SERVICE_UIM,
+	.change = true,
+	.timeout_ms = EXT_UIM_TIMEOUT_MS,
+	.what = "Power on the SIM card",

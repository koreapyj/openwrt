@@ -0,0 +1,330 @@
+/*
+ * uqmid -- cell info (ModemManager: Modem.GetCellInfo, handle_get_cell_info() in mm-iface-modem.c and
+ * "Cell info" (get_cell_info()) in mm-broadband-modem-qmi.c, MM 1.24.2)
+ *
+ * Method of the modem object:
+ *  - get_cell_info -> {cells: [{cell_type, serving, ...}]}: NAS Get Cell Location Info (10 s timeout), the modem
+ *    has to be at least enabled (mm_iface_modem_abort_invocation_if_state_not_reached(ENABLED)).
+ *
+ * Each cell is a table like the dictionary of mm_cell_info_get_dictionary(): `cell_type` (string instead of
+ * the MMCellType number: gsm, umts, lte, nr5g, cdma, tdscdma), `serving` (bool, always present), and the properties of
+ * the cell class with the dashes of the MM property names replaced by underscores. A property which MM has
+ * not set (the "invalid" value of mm-cell-info-*.c) is not in the table.
+ *  - gsm: operator_id, lac, ci, timing_advance, arfcn, base_station_id, rx_level
+ *  - lte: operator_id, tac, ci, physical_ci, earfcn, rsrp, rsrq, timing_advance
+ *  - nr5g: operator_id, tac, ci, physical_ci, nrarfcn, rsrp, rsrq, sinr
+ * (serving_cell_type and bandwidth exist in MM's lte/nr5g classes but are never set by the QMI implementation.)
+ *
+ * The QMI parsing is get_cell_info_ready() of MM 1.24.2 as it is, including what it does not do:
+ *  - the serving GSM cell comes first, followed by the GSM neighbours (which get the timing advance of the serving
+ *    cell, MM does the same); the intra-frequency LTE cells follow (the cell whose physical cell id is the serving
+ *    cell id is the serving cell, with ci and, if the TLV exists, the timing advance), then the inter-frequency
+ *    LTE cells (neighbours with earfcn, physical_ci, rsrp, rsrq only), then the NR5G serving cell;
+ *  - UMTS, CDMA and TD-SCDMA (and the other LTE neighbour TLVs) are not reported by MM's QMI implementation
+ *    (the cell_type names exist for the dictionary but are never produced);
+ *  - the PLMN is BCD, converted by str_from_bcd_plmn() (the filler 0xF of a two digit MNC is skipped); lac, tac,
+ *    ci, pci and the base station id are upper-case hexadecimal strings without leading zeros ("%X");
+ *  - LTE/NR5G rsrp, rsrq and the NR5G sinr are the QMI values times 0.1 (QMI: 0.1 dB(m) units).
+ *
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/list.h>
+#include <libubus.h>
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "modem_cell_info.h"
+#include "qmi-enums-nas.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "ubus.h"
+#include "utils.h"
+
+/* mm-broadband-modem-qmi.c get_cell_info(): qmi_client_nas_get_cell_location_info (..., 10, ...) */
+#define CELL_INFO_TIMEOUT_MS 10000
+
+struct modem_cell_info {
+	struct modem *modem;
+	struct list_head ops;
+};
+
+struct cell_op {
+	struct list_head list;
+	struct modem *modem;
+	struct ubus_request_data req;
+};
+
+static struct blob_buf b;
+
+/* SEND_REQ(): encode into _m and send */
+#define SEND_REQ(svc, ENC, cb, data, tmo) ({								\
+	struct qmi_msg *_m;										\
+	struct qmi_request *_r = uqmi_request_alloc((svc), &_m, (cb), (data), (tmo));			\
+	int _ret = -ENOMEM;										\
+	if (_r) {											\
+		if (ENC) {										\
+			talloc_free(_r);								\
+			_ret = -EINVAL;									\
+		} else {										\
+			_ret = uqmi_service_send_msg((svc), _r);					\
+		}											\
+	}												\
+	_ret;												\
+})
+
+/*
+ * MM: str_from_bcd_plmn() (stolen from qmicli-nas.c): the nibbles of the BCD PLMN, the filler 0xF of the MNC is
+ * skipped. Returns false (MM: NULL) for an empty PLMN.
+ */
+static bool str_from_bcd_plmn(const uint8_t *bcd, unsigned int n, char *out, size_t out_len)
+{
+	static const char bcd_chars[] = "0123456789*#abc\0\0";
+	unsigned int i, j;
+
+	if (!bcd || !n || out_len < 2 * n + 1)
+		return false;
+
+	for (i = 0, j = 0; i < n; i++) {
+		out[j] = bcd_chars[bcd[i] & 0xF];
+		if (out[j])
+			j++;
+		out[j] = bcd_chars[(bcd[i] >> 4) & 0xF];
+		if (out[j])
+			j++;
+	}
+	out[j] = '\0';
+	return true;
+}
+
+static void add_hex(const char *name, uint64_t v)
+{
+	char s[24];
+
+	snprintf(s, sizeof(s), "%llX", (unsigned long long)v);
+	blobmsg_add_string(&b, name, s);
+}
+
+static void add_plmn(const uint8_t plmn[3])
+{
+	char s[16];
+
+	if (str_from_bcd_plmn(plmn, 3, s, sizeof(s)))
+		blobmsg_add_string(&b, "operator_id", s);
+}
+
+/* mm_cell_info_get_dictionary(): the common part is added at the end by MM, the order is not relevant here */
+static void *cell_open(const char *type, bool serving)
+{
+	void *t = blobmsg_open_table(&b, NULL);
+
+	blobmsg_add_string(&b, "cell_type", type);
+	blobmsg_add_u8(&b, "serving", serving);
+	return t;
+}
+
+/* MM_CELL_INFO_GET_DICTIONARY_INSERT(): G_MAXUINT is the "not set" value of the uint32 properties */
+static void add_u32(const char *name, uint32_t v)
+{
+	if (v != UINT32_MAX)
+		blobmsg_add_u32(&b, name, v);
+}
+
+static void add_gsm(bool serving, const uint8_t plmn[3], uint32_t lac, uint32_t cell_id,
+		    uint32_t timing_advance, uint32_t arfcn, uint32_t bsic, uint32_t rxlev)
+{
+	void *t = cell_open("gsm", serving);
+
+	add_plmn(plmn);
+	add_hex("lac", lac);
+	add_hex("ci", cell_id);
+	add_u32("timing_advance", timing_advance);
+	add_u32("arfcn", arfcn);
+	add_hex("base_station_id", bsic);
+	add_u32("rx_level", rxlev);
+	blobmsg_close_table(&b, t);
+}
+
+static void build_cells(const struct qmi_nas_get_cell_location_info_response *res)
+{
+	unsigned int i, j;
+
+	/* GERAN info v2: the serving cell, then the neighbours (with the timing advance of the serving cell) */
+	if (res->set.geran_info_v2) {
+		const typeof(res->data.geran_info_v2) *g = &res->data.geran_info_v2;
+
+		add_gsm(true, g->plmn, g->lac, g->cell_id, g->timing_advance,
+			g->geran_absolute_rf_channel_number, g->base_station_identity_code, g->rx_level);
+		for (i = 0; i < g->cell_n; i++)
+			add_gsm(false, g->cell[i].plmn, g->cell[i].lac, g->cell[i].cell_id,
+				g->timing_advance, g->cell[i].geran_absolute_rf_channel_number,
+				g->cell[i].base_station_identity_code, g->cell[i].rx_level);
+	}
+
+	/* intra-frequency LTE info v2 */
+	if (res->set.intrafrequency_lte_info_v2) {
+		const typeof(res->data.intrafrequency_lte_info_v2) *l = &res->data.intrafrequency_lte_info_v2;
+
+		for (i = 0; i < l->cell_n; i++) {
+			bool serving = l->cell[i].physical_cell_id == l->serving_cell_id;
+			void *t = cell_open("lte", serving);
+
+			add_plmn(l->plmn);
+			add_hex("tac", l->tracking_area_code);
+			add_u32("earfcn", l->eutra_absolute_rf_channel_number);
+			add_hex("physical_ci", l->cell[i].physical_cell_id);
+			blobmsg_add_double(&b, "rsrp", 0.1 * (double)l->cell[i].rsrp);
+			blobmsg_add_double(&b, "rsrq", 0.1 * (double)l->cell[i].rsrq);
+			/* only for the serving cell there are the CGI and the timing advance */
+			if (serving) {
+				add_hex("ci", l->global_cell_id);
+				if (res->set.lte_info_timing_advance)
+					add_u32("timing_advance", res->data.lte_info_timing_advance);
+			}
+			blobmsg_close_table(&b, t);
+		}
+	}
+
+	/* inter-frequency LTE info: neighbours */
+	if (res->set.interfrequency_lte_info) {
+		const typeof(res->data.interfrequency_lte_info) *f = &res->data.interfrequency_lte_info;
+
+		for (i = 0; i < f->frequency_n; i++) {
+			for (j = 0; j < f->frequency[i].cell_n; j++) {
+				const typeof(*f->frequency[i].cell) *c = &f->frequency[i].cell[j];
+				void *t = cell_open("lte", false);
+
+				add_u32("earfcn", f->frequency[i].eutra_absolute_rf_channel_number);
+				add_hex("physical_ci", c->physical_cell_id);
+				blobmsg_add_double(&b, "rsrp", 0.1 * (double)c->rsrp);
+				blobmsg_add_double(&b, "rsrq", 0.1 * (double)c->rsrq);
+				blobmsg_close_table(&b, t);
+			}
+		}
+	}
+
+	/* NR5G cell information: the serving cell */
+	if (res->set.nr5g_cell_information) {
+		const typeof(res->data.nr5g_cell_information) *n = &res->data.nr5g_cell_information;
+		void *t = cell_open("nr5g", true);
+
+		add_plmn(n->plmn);

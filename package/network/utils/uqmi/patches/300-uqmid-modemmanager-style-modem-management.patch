+ */
+void
+uqmi_request_complete(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg, int err,
+		      bool invoke_cb)
+{
+	void *tlv_buf;
+	int tlv_len;
+
+	if (req->complete)
+		return;
+
+	req->pending = false;
+	req->complete = true;
+	uloop_timeout_cancel(&req->timeout);
+	if (req->queued) {
+		list_del(&req->list);
+		req->queued = false;
+	}
+
+	if (msg) {
+		tlv_buf = qmi_msg_get_tlv_buf(msg, &tlv_len);
+		req->ret = qmi_check_message_status(tlv_buf, tlv_len);
+	} else {
+		req->ret = err;
+	}
+
+	/* While the device is closing the owner (modem) is going away: only the
+	 * ctrl service, which releases the client ids, is still interested. */
+	if (service->service != QMI_SERVICE_CTL && service->qmi->state != QMI_RUNNING)
+		invoke_cb = false;
+
+	if (req->cb && invoke_cb)

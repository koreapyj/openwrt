+static void op_reset_fail(struct modem_op *op, struct qmi_request *req, const char *what)
+{
+	modem_log(op->modem, LOGL_ERROR, "reset: %s failed: %d/%s", what, req->ret, qmi_get_error_str(req->ret));
+	modem_op_done(op, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED, NULL);
+}
+
+static void dms_reset_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct modem_op *op = modem->cur_op;
+
+	if (!op)
+		return;
+
+	if (!msg || req->ret) {
+		op_reset_fail(op, req, "reset mode");
+		return;
+	}
+
+	modem_log(modem, LOGL_NOTICE, "modem accepted the reset, rebooting now");
+	modem_op_done(op, MODEM_ERR_NONE, NULL);
+}
+
+static void dms_reset_offline_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct modem_op *op = modem->cur_op;
+
+	if (!op)
+		return;
+
+	if (!msg || req->ret) {
+		op_reset_fail(op, req, "offline mode");
+		return;
+	}
+
+	uqmid_modem_update_power_state(modem, MODEM_POWER_OFF);
+	op->pstep = 1; /* reset requested: the modem may vanish before it answers */
+	op->gone_ok = true;
+	if (tx_dms_set_operating_mode(modem, service, QMI_DMS_OPERATING_MODE_RESET, dms_reset_cb, RESET_TIMEOUT_MS)) {
+		op->pstep = 0;
+		modem_op_done(op, MODEM_ERR_FAILED, NULL);
+	}
+}
+
+static void op_reset_start(struct modem_op *op);
+
+/* the reset steps inside another operation (MM: mm_shared_qmi_reset() of set_current_capabilities) */

+	device = talloc_strdup(NULL, modem->device);
+	uqmid_ubus_modem_destroy(modem);
+	uqmid_ubus_notify_modem_removed(path, device);
+	talloc_free(path);
+	talloc_free(device);
+
+	/* a vanished device can't release its client ids */
+	if (!graceful)
+		modem->qmi->state = QMI_ERROR;
+
+	/* frees the modem via modem_closed_cb() */
+	qmi_device_close(modem->qmi, graceful ? 3000 : 0);
+}
+
+int uqmid_modem_remove(struct modem *modem, bool graceful)
+{
+	if (!modem)
+		return -EINVAL;
+
+	if (modem->dying)
+		return 0;
+
+	modem->dying = true;
+	modem->graceful = graceful && modem->qmi && modem->qmi->state == QMI_RUNNING;
+	modem->destroy_timer.cb = modem_destroy_cb;
+	uloop_timeout_set(&modem->destroy_timer, 0);
+
+	return 0;
+}

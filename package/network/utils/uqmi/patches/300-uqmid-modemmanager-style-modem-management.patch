+++ b/uqmid/simple.c
@@ -0,0 +1,567 @@
+/*
+ * uqmid -- Simple interface of the modem (ModemManager: Modem.Simple, mm-iface-modem-simple.c)
+ *
+ * simple_connect follows connection_step(): unlock check (send the PIN if the modem is locked and a PIN was
+ * given), wait to get initialized, enable, wait for the enabled state, register in the network (max 60 s),
+ * create the bearer (or use the one with the same properties) and connect it. simple_disconnect aborts a running
+ * connect and disconnects the bearers; simple_get_status returns the state of the modem.
+ *
+ * Deviation: MM also waits for the packet service state to be attached (CONNECTION_STEP_PACKET_SERVICE_ATTACH).
+ * The PS registration of the NAS registration state covers it here.
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/uloop.h>
+#include <libubus.h>
+#include <talloc.h>
+
+#include "bearer.h"
+#include "logging.h"
+#include "modem.h"
+#include "modem_3gpp.h"
+#include "sim_obj.h"
+#include "ubus.h"
+
+/* MM: handle_register(): 60 s */
+#define SIMPLE_REGISTER_SECS 60
+/* MM: wait_for_final_state() */
+#define SIMPLE_WAIT_MS 250
+#define SIMPLE_WAIT_INIT_SECS 60
+#define SIMPLE_WAIT_ENABLED_SECS 60
+/* MM: CONNECTION_STEP_WAIT_AFTER_ENABLED */
+#define SIMPLE_AFTER_ENABLED_MS 100
+
+static struct blob_buf b;
+
+enum {
+	SC_FIRST,
+	SC_UNLOCK_CHECK,
+	SC_WAIT_FOR_INITIALIZED,
+	SC_ENABLE,
+	SC_WAIT_FOR_ENABLED,
+	SC_WAIT_AFTER_ENABLED,
+	SC_REGISTER,
+	SC_BEARER,
+	SC_CONNECT,
+	SC_LAST,
+};
+
+struct simple_ctx {
+	struct modem *modem;
+	struct ubus_request_data req;
+	int step;
+	char *pin;
+	char *operator_id;
+	struct bearer_props props;
+	struct bearer *bearer;
+	struct uloop_timeout timer;
+	unsigned int waited_ms;
+	/* the request was answered (cancelled): the pending operations only release the context */
+	bool finished;
+	unsigned int refs;
+};
+
+static void simple_step(struct simple_ctx *sc);
+
+static void sc_put(struct simple_ctx *sc)
+{
+	if (--sc->refs == 0)
+		talloc_free(sc);
+}
+
+static void sc_complete(struct simple_ctx *sc, enum modem_error err, const char *msg)
+{
+	struct modem *modem = sc->modem;
+
+	if (sc->finished)
+		return;
+
+	sc->finished = true;
+	uloop_timeout_cancel(&sc->timer);
+	if (modem->simple == sc)
+		modem->simple = NULL;
+
+	blob_buf_init(&b, 0);
+	if (!err && sc->bearer)
+		blobmsg_add_string(&b, "bearer", uqmid_bearer_path(sc->bearer));
+	else if (err && sc->bearer)
+		uqmid_bearer_add_connection_error(sc->bearer, &b, "connection_error");
+	if (err)
+		modem_log(modem, LOGL_NOTICE, "simple connect failed: %s", msg ? msg : modem_error_message(err));
+	else
+		modem_log(modem, LOGL_INFO, "simple connect done");
+	uqmid_ubus_deferred_done(&sc->req, err, msg, b.head);
+	sc_put(sc);
+}
+
+static void sc_next(struct simple_ctx *sc)
+{
+	sc->step++;
+	simple_step(sc);
+}
+
+/* a wait step finished, polling the state again soon */
+static void wait_timer_cb(struct uloop_timeout *t)
+{
+	struct simple_ctx *sc = container_of(t, struct simple_ctx, timer);
+
+	if (sc->finished)
+		return;
+
+	sc->waited_ms += SIMPLE_WAIT_MS;
+	simple_step(sc);
+}
+
+static void start_cb(struct uloop_timeout *t)
+{
+	struct simple_ctx *sc = container_of(t, struct simple_ctx, timer);
+
+	simple_step(sc);
+}
+
+static void after_enabled_cb(struct uloop_timeout *t)
+{
+	struct simple_ctx *sc = container_of(t, struct simple_ctx, timer);
+
+	if (!sc->finished)
+		sc_next(sc);
+}
+
+static void op_done_cb(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct simple_ctx *sc = data;
+
+	if (!sc->finished) {
+		if (err) {
+			sc_complete(sc, err, msg);
+		} else {
+			sc_next(sc);
+		}
+	}
+	sc_put(sc);
+}
+
+static void register_cb(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	op_done_cb(modem, err, msg, data);
+}
+
+static void connect_cb(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	op_done_cb(modem, err, msg, data);
+}
+
+static void simple_step(struct simple_ctx *sc)
+{
+	struct modem *modem = sc->modem;
+	enum modem_state state = modem->mm_state;
+	const char *what;
+	int ret = 0;
+
+	if (sc->finished)
+		return;
+
+	switch (sc->step) {
+	case SC_FIRST:
+		modem_log(modem, LOGL_INFO, "simple connect started...");
+		/* We may be able to skip some steps, so check that before doing anything */
+		switch (state) {
+		case MODEM_STATE_FAILED:
+			sc_complete(sc, MODEM_ERR_WRONG_STATE, "Modem is in failed state");
+			return;
+		case MODEM_STATE_UNKNOWN:
+		case MODEM_STATE_INITIALIZING:
+		case MODEM_STATE_DISABLING:
+			/* If we are transitioning to the DISABLED (initialized) state, wait to get there */
+			sc->step = SC_WAIT_FOR_INITIALIZED;
+			break;
+		case MODEM_STATE_LOCKED:
+			/* If we need unlocking, start from the very beginning */
+			sc->step = SC_UNLOCK_CHECK;
+			break;
+		case MODEM_STATE_DISABLED:
+			sc->step = SC_ENABLE;
+			break;
+		case MODEM_STATE_ENABLING:
+		case MODEM_STATE_DISCONNECTING:
+		case MODEM_STATE_CONNECTING:
+			/* Wait to get to a final state before going on */
+			sc->step = SC_WAIT_FOR_ENABLED;
+			break;
+		default:
+			/* If we are at least already enabled, start at the registration check right away */
+			sc->step = SC_REGISTER;
+			break;
+		}
+		simple_step(sc);
+		return;
+
+	case SC_UNLOCK_CHECK:
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): unlock check", sc->step, SC_LAST);
+		if (state != MODEM_STATE_LOCKED) {
+			sc->step = SC_WAIT_FOR_INITIALIZED;
+			simple_step(sc);
+			return;
+		}
+
+		/* During simple connect we are only allowed to use SIM PIN */
+		if (modem->sim.state != UQMI_SIM_PIN_REQUIRED || !sc->pin) {
+			what = modem->sim.state == UQMI_SIM_PUK_REQUIRED ? "sim-puk" : "sim-pin";
+			modem_log(modem, LOGL_NOTICE, "modem is locked with '%s'", what);
+			sc_complete(sc, MODEM_ERR_UNAUTHORIZED, "Modem is locked; cannot unlock it");
+			return;
+		}
+
+		/* Try to unlock the modem providing the PIN */
+		sc->refs++;
+		if (uqmid_sim_op_submit_internal(modem, SIM_OP_SEND_PIN, sc->pin, NULL, false, op_done_cb, sc)) {
+			sc_put(sc);
+			sc_complete(sc, MODEM_ERR_FAILED, "Cannot unlock modem, couldn't get access to the SIM");
+		}
+		return;
+
+	case SC_WAIT_FOR_INITIALIZED:
+		modem_log(modem, LOGL_DEBUG, "simple connect state (%d/%d): wait to get fully initialized", sc->step,
+			  SC_LAST);
+		if (state == MODEM_STATE_FAILED || state == MODEM_STATE_LOCKED) {
+			sc_complete(sc, state == MODEM_STATE_LOCKED ? MODEM_ERR_UNAUTHORIZED : MODEM_ERR_WRONG_STATE,
+				    state == MODEM_STATE_LOCKED ? "Modem is locked" : "Modem is in failed state");
+			return;
+		}
+		/* disabled == initialized */
+		if (state >= MODEM_STATE_DISABLED && state != MODEM_STATE_DISABLING) {
+			sc->waited_ms = 0;
+			sc->step = SC_ENABLE;
+			simple_step(sc);
+			return;
+		}
+		if (sc->waited_ms > SIMPLE_WAIT_INIT_SECS * 1000) {
+			sc_complete(sc, MODEM_ERR_WRONG_STATE, "Couldn't wait for 'disabled'");
+			return;
+		}
+		sc->timer.cb = wait_timer_cb;
+		uloop_timeout_set(&sc->timer, SIMPLE_WAIT_MS);
+		return;
+
+	case SC_ENABLE:
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): enable", sc->step, SC_LAST);
+		if (state >= MODEM_STATE_ENABLED) {
+			sc->step = SC_REGISTER;
+			simple_step(sc);
+			return;
+		}
+		sc->refs++;
+		if (uqmid_modem_op_enable_internal(modem, true, op_done_cb, sc)) {
+			sc_put(sc);
+			sc_complete(sc, MODEM_ERR_FAILED, "Couldn't enable the modem");
+			return;
+		}
+		/* once the enable is done (a final state), op_done_cb() goes on with the wait after the enable */
+		sc->step = SC_WAIT_FOR_ENABLED;
+		return;
+
+	case SC_WAIT_FOR_ENABLED:
+		modem_log(modem, LOGL_DEBUG, "simple connect state (%d/%d): wait to get fully enabled", sc->step,
+			  SC_LAST);
+		/* just a final state: not searching is also fine, the registration step waits for the network */
+		if (state == MODEM_STATE_ENABLING || state == MODEM_STATE_DISCONNECTING ||
+		    state == MODEM_STATE_CONNECTING || state == MODEM_STATE_DISABLING ||
+		    state == MODEM_STATE_INITIALIZING || state == MODEM_STATE_UNKNOWN) {
+			if (sc->waited_ms > SIMPLE_WAIT_ENABLED_SECS * 1000) {
+				sc_complete(sc, MODEM_ERR_WRONG_STATE, "Couldn't wait for 'enabled'");
+				return;
+			}
+			sc->timer.cb = wait_timer_cb;
+			uloop_timeout_set(&sc->timer, SIMPLE_WAIT_MS);
+			return;
+		}
+		if (state < MODEM_STATE_ENABLED) {
+			modem_log(modem, LOGL_NOTICE, "failed waiting for enabled state: %s", modem_state_name(state));
+			sc_complete(sc, MODEM_ERR_WRONG_STATE, "Couldn't wait for 'enabled'");
+			return;
+		}
+		sc->waited_ms = 0;
+		sc->step = SC_WAIT_AFTER_ENABLED;
+		simple_step(sc);
+		return;
+
+	case SC_WAIT_AFTER_ENABLED:
+		/* When we have just enabled, give it some time before starting the registration process, so that any
+		 * pending registration update is applied. We don't want to trigger a new automatic registration if
+		 * e.g. we're already registered. */
+		sc->timer.cb = after_enabled_cb;
+		uloop_timeout_set(&sc->timer, SIMPLE_AFTER_ENABLED_MS);
+		return;
+
+	case SC_REGISTER:
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): register", sc->step, SC_LAST);
+		if (state < MODEM_STATE_ENABLED) {
+			sc_complete(sc, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+			return;
+		}
+		sc->refs++;
+		ret = uqmid_3gpp_register(modem, sc->operator_id, false, SIMPLE_REGISTER_SECS, register_cb, sc);
+		if (ret) {
+			sc_put(sc);
+			sc_complete(sc, MODEM_ERR_INVALID_ARGS, "Invalid operator id");
+		}
+		return;
+
+	case SC_BEARER: {
+		const char *emsg = NULL;
+		enum modem_error err;
+
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): bearer", sc->step, SC_LAST);
+		/* Check if the bearer we want to create is already in the list */
+		sc->bearer = uqmid_bearer_find_matching(modem, &sc->props);
+		if (!sc->bearer) {
+			modem_log(modem, LOGL_DEBUG, "creating new bearer...");
+			err = uqmid_bearer_create(modem, &sc->props, &sc->bearer, &emsg);
+			if (err) {
+				sc_complete(sc, err, emsg);
+				return;
+			}
+		} else {
+			modem_log(modem, LOGL_DEBUG, "using already existing bearer at '%s'...",
+				  uqmid_bearer_path(sc->bearer));
+		}
+		sc_next(sc);
+		return;
+	}
+
+	case SC_CONNECT:
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): connect", sc->step, SC_LAST);
+		/* if we're already using an existing bearer, check if it is connected; and if so, don't do anything */
+		if (uqmid_bearer_status(sc->bearer) != BEARER_CONNECTED) {
+			sc->refs++;
+			uqmid_bearer_connect(sc->bearer, connect_cb, sc);
+			return;
+		}
+		modem_log(modem, LOGL_INFO, "bearer at '%s' is already connected...", uqmid_bearer_path(sc->bearer));
+		sc_next(sc);
+		return;
+
+	case SC_LAST:
+		/* All done, yey! */
+		modem_log(modem, LOGL_INFO, "simple connect state (%d/%d): all done", sc->step, SC_LAST);
+		sc_complete(sc, MODEM_ERR_NONE, NULL);
+		return;
+
+	default:
+		break;
+	}
+}
+
+/** the connect is aborted (simple_disconnect, the modem goes away) */
+static void simple_abort(struct modem *modem, enum modem_error err, const char *msg)
+{
+	struct simple_ctx *sc = modem->simple;
+
+	if (sc)
+		sc_complete(sc, err, msg);
+}
+
+void uqmid_simple_cleanup(struct modem *modem)
+{
+	simple_abort(modem, MODEM_ERR_ABORTED, "Modem went away");
+}
+
+/*****************************************************************************/
+/* ubus */
+
+enum { SCN_PIN, SCN_OPERATOR_ID, SCN_APN, SCN_IP_TYPE, SCN_AUTH, SCN_USER, SCN_PASSWORD, SCN_ROAMING, SCN_PROFILE,
+       __SCN_MAX };
+static const struct blobmsg_policy simple_connect_policy[__SCN_MAX] = {
+	[SCN_PIN] = { .name = "pin", .type = BLOBMSG_TYPE_STRING },
+	[SCN_OPERATOR_ID] = { .name = "operator_id", .type = BLOBMSG_TYPE_STRING },
+	[SCN_APN] = { .name = "apn", .type = BLOBMSG_TYPE_STRING },
+	[SCN_IP_TYPE] = { .name = "ip_type", .type = BLOBMSG_TYPE_STRING },
+	[SCN_AUTH] = { .name = "allowed_auth", .type = BLOBMSG_TYPE_UNSPEC },
+	[SCN_USER] = { .name = "user", .type = BLOBMSG_TYPE_STRING },
+	[SCN_PASSWORD] = { .name = "password", .type = BLOBMSG_TYPE_STRING },
+	[SCN_ROAMING] = { .name = "allow_roaming", .type = BLOBMSG_TYPE_BOOL },
+	[SCN_PROFILE] = { .name = "profile_id", .type = BLOBMSG_TYPE_INT32 },
+};
+
+/** ubus call uqmid.modem.0 simple_connect '{"apn":"internet","ip_type":"ipv4"}' -> {"bearer": "uqmid.modem.0.bearer.0"} */
+static int h_simple_connect(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			    const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__SCN_MAX];
+	struct simple_ctx *sc;
+	enum modem_error err;
+	const char *emsg = NULL;
+	struct bearer_props props;
+	void *tmp = talloc_new(NULL);
+
+	blobmsg_parse(simple_connect_policy, __SCN_MAX, tb, blob_data(msg), blob_len(msg));
+
+	/* MM: Only one connection attempt by Simple.Connect() may be handled at a time */
+	if (modem->simple) {
+		talloc_free(tmp);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS,
+					      "Connection request forbidden: operation already in progress");
+	}
+
+	err = uqmid_bearer_props_parse(tmp, tb[SCN_APN], tb[SCN_IP_TYPE], tb[SCN_AUTH], tb[SCN_USER], tb[SCN_PASSWORD],
+				       tb[SCN_ROAMING], tb[SCN_PROFILE], &props, &emsg);
+	if (err) {
+		talloc_free(tmp);
+		return uqmid_ubus_reply_error(ctx, req, err, emsg);
+	}
+
+	/* validate the operator id like the registration does (3 digit MCC, 2 or 3 digit MNC) */
+	if (tb[SCN_OPERATOR_ID] && *blobmsg_get_string(tb[SCN_OPERATOR_ID])) {
+		const char *op = blobmsg_get_string(tb[SCN_OPERATOR_ID]);
+		size_t i, len = strlen(op);
+		bool ok = len == 5 || len == 6;
+
+		for (i = 0; ok && i < len; i++)
+			ok = op[i] >= '0' && op[i] <= '9';
+		if (!ok) {
+			talloc_free(tmp);
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid operator id");
+		}
+	}
+
+	sc = talloc_zero(modem, struct simple_ctx);
+	sc->modem = modem;
+	sc->refs = 1;
+	sc->props = props;
+	sc->props.apn = props.apn ? talloc_strdup(sc, props.apn) : NULL;
+	sc->props.user = props.user ? talloc_strdup(sc, props.user) : NULL;
+	sc->props.password = props.password ? talloc_strdup(sc, props.password) : NULL;
+	if (tb[SCN_PIN])
+		sc->pin = talloc_strdup(sc, blobmsg_get_string(tb[SCN_PIN]));
+	if (tb[SCN_OPERATOR_ID] && *blobmsg_get_string(tb[SCN_OPERATOR_ID]))
+		sc->operator_id = talloc_strdup(sc, blobmsg_get_string(tb[SCN_OPERATOR_ID]));
+	talloc_free(tmp);
+
+	modem_log(modem, LOGL_INFO, "processing user request to connect modem (apn '%s', ip type %s)...",
+		  sc->props.apn ? sc->props.apn : "", uqmid_ip_type_name(sc->props.ip_type));
+	modem->simple = sc;
+	ubus_defer_request(ctx, req, &sc->req);
+	sc->step = SC_FIRST;
+	/* not from within the handler */
+	sc->timer.cb = start_cb;
+	uloop_timeout_set(&sc->timer, 0);
+
+	return UBUS_STATUS_OK;
+}
+
+enum { SD_BEARER, __SD_MAX };
+static const struct blobmsg_policy simple_disconnect_policy[__SD_MAX] = {
+	[SD_BEARER] = { .name = "bearer", .type = BLOBMSG_TYPE_STRING },
+};
+
+struct sd_ctx {
+	struct modem *modem;
+	struct ubus_request_data req;
+	unsigned int pending;
+	bool started;
+	enum modem_error err;
+	char msg[96];
+};
+
+static void sd_one_done(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct sd_ctx *sd = data;
+
+	if (err && !sd->err) {
+		sd->err = err;
+		snprintf(sd->msg, sizeof(sd->msg), "%s", msg ? msg : "");
+	}
+
+	if (--sd->pending == 0 && sd->started) {
+		uqmid_ubus_deferred_done(&sd->req, sd->err, sd->err ? sd->msg : NULL, NULL);
+		talloc_free(sd);
+	}
+}
+
+/** ubus call uqmid.modem.0 simple_disconnect '{"bearer": "uqmid.modem.0.bearer.0"}' (all bearers if none) */
+static int h_simple_disconnect(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			       const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__SD_MAX];
+	struct sd_ctx *sd;
+	const char *path = NULL;
+	struct bearer *list[16];
+	unsigned int n = 0, i;
+
+	blobmsg_parse(simple_disconnect_policy, __SD_MAX, tb, blob_data(msg), blob_len(msg));
+	if (tb[SD_BEARER] && *blobmsg_get_string(tb[SD_BEARER]))
+		path = blobmsg_get_string(tb[SD_BEARER]);
+
+	if (path && !uqmid_bearer_find(modem, path))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_NOT_FOUND, "Couldn't disconnect: bearer not found");
+
+	/* MM: mm_iface_modem_simple_abort_ongoing() */
+	simple_abort(modem, MODEM_ERR_ABORTED, "Connection attempt cancelled");
+
+	sd = talloc_zero(modem, struct sd_ctx);
+	sd->modem = modem;
+	ubus_defer_request(ctx, req, &sd->req);
+	modem_log(modem, LOGL_INFO, "processing user request to disconnect modem...");
+
+	/* the bearers are collected first: the list may change */
+	if (path) {
+		list[n++] = uqmid_bearer_find(modem, path);
+	} else {
+		n = uqmid_bearers_list(modem, list, ARRAY_SIZE(list));
+	}
+
+	for (i = 0; i < n; i++) {
+		if (uqmid_bearer_status(list[i]) == BEARER_DISCONNECTED)
+			continue;
+		sd->pending++;
+		uqmid_bearer_disconnect(list[i], sd_one_done, sd);
+	}
+	sd->started = true;
+	if (!sd->pending) {
+		/* nothing to wait for: the reply is not sent from the handler */
+		uqmid_ubus_deferred_done(&sd->req, MODEM_ERR_NONE, NULL, NULL);
+		talloc_free(sd);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+/** ubus call uqmid.modem.0 simple_get_status */
+static int h_simple_get_status(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			       const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	unsigned int quality;
+	void *t;
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "state", modem_state_name(modem->mm_state));
+	t = blobmsg_open_table(&b, "signal_quality");
+	blobmsg_add_u32(&b, "value", uqmid_3gpp_signal_quality(modem, &quality) ? quality : 0);
+	blobmsg_add_u8(&b, "recent", uqmid_3gpp_signal_quality(modem, &quality));
+	blobmsg_close_table(&b, t);
+	uqmid_add_access_technologies(&b, "access_technologies", uqmid_3gpp_access_technologies(modem));
+	blobmsg_add_string(&b, "m3gpp_registration_state", reg_state_name(uqmid_3gpp_registration_state(modem)));
+	blobmsg_add_string(&b, "m3gpp_operator_code", uqmid_3gpp_operator_code(modem));
+	blobmsg_add_string(&b, "m3gpp_operator_name", uqmid_3gpp_operator_name(modem));
+	uqmid_bearers_add_paths(modem, &b, "bearers");
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static const struct ubus_method simple_methods[] = {
+	UBUS_METHOD("simple_connect", h_simple_connect, simple_connect_policy),
+	UBUS_METHOD("simple_disconnect", h_simple_disconnect, simple_disconnect_policy),
+	UBUS_METHOD_NOARG("simple_get_status", h_simple_get_status),
+};
+
+const struct ubus_method *uqmid_simple_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(simple_methods);
+	return simple_methods;
+}

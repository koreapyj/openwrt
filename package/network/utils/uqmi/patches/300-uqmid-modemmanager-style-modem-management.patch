+/* mm_common_build_bands_string() */
+static char *bands_str(void *ctx, const struct band_list *bl)
+{
+	char *s;
+	unsigned int i;
+
+	if (!bl->n)
+		return talloc_strdup(ctx, "none");
+
+	s = talloc_strdup(ctx, "");
+	for (i = 0; s && i < bl->n; i++) {
+		const char *nick = band_nick(bl->v[i]);
+
+		if (nick)
+			s = talloc_asprintf_append(s, "%s%s", i ? ", " : "", nick);
+		else
+			s = talloc_asprintf_append(s, "%sband-%u", i ? ", " : "", bl->v[i]);
+	}
+
+	return s;
+}

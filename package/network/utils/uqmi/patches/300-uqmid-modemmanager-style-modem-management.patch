@@ -0,0 +1,1411 @@
+/*
+ * uqmid -- SMS objects (ModemManager: mm-base-sms.c, mm-sms-qmi.c and the list handling of mm-sms-list.c).
+ *
+ * Every SMS is an ubus object of its own (uqmid.modem.<N>.sms.<M>) with the methods get, send and store.
+ * Parts of the same multipart message (matched by concat reference, number and number of parts) are assembled
+ * into one object, which is listed from the first part on (state "receiving") and gets its text when the last
+ * part arrived. Deleting an object deletes all its parts.
+ *
+ * Deviations from MM:
+ *  - the state "sending" is never used (MM does not set it for QMI either);
+ *  - a send, store or delete of an SMS is refused with "in-progress" while another one of the same SMS runs;
+ *  - a failed store deletes the parts which were already written (MM leaves them);
+ *  - a received part without user data decodes to an empty text (see sms_part.c);
+ *  - a part is only added to a multipart message of the same PDU type (a stored submit set is never mixed with
+ *    a received one).
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/random.h>
+
+#include <libubox/blobmsg.h>
+#include <talloc.h>
+
+#include "messaging.h"
+#include "messaging_priv.h"
+
+/* MM: /SMS/<M>, incrementing per daemon lifetime */
+static uint32_t next_sms_index;
+
+static struct blob_buf b;
+
+/*****************************************************************************/
+/* names */
+
+static const char *sms_state_name(enum sms_state s)
+{
+	static const char *const names[] = { "unknown", "stored", "receiving", "received", "sending", "sent" };
+
+	return (unsigned int)s < ARRAY_SIZE(names) ? names[s] : "unknown";
+}
+
+static const char *sms_pdu_type_name(enum sms_pdu_type t)
+{
+	static const char *const names[] = { "unknown", "deliver", "submit", "status-report" };
+
+	return (unsigned int)t < ARRAY_SIZE(names) ? names[t] : "unknown";
+}
+
+const char *sms_storage_name(enum sms_storage storage)
+{
+	static const char *const names[] = { "unknown", "sm", "me", "mt", "sr", "bm", "ta" };
+
+	return (unsigned int)storage < ARRAY_SIZE(names) ? names[storage] : "unknown";
+}
+
+enum sms_storage sms_storage_from_name(const char *name)
+{
+	unsigned int i;
+
+	for (i = SMS_STORAGE_SM; i <= SMS_STORAGE_TA; i++) {
+		if (!strcasecmp(name, sms_storage_name(i)))
+			return i;
+	}
+
+	return SMS_STORAGE_UNKNOWN;
+}
+
+/* mm_sms_storage_to_qmi_storage_type() / mm_sms_storage_from_qmi_storage_type() */
+static uint8_t storage_to_qmi(enum sms_storage storage)
+{
+	switch (storage) {
+	case SMS_STORAGE_SM:
+		return QMI_WMS_STORAGE_TYPE_UIM;
+	case SMS_STORAGE_ME:
+		return QMI_WMS_STORAGE_TYPE_NV;
+	default:
+		return QMI_WMS_STORAGE_TYPE_NONE;
+	}
+}
+
+const char *msg_req_error_str(const struct qmi_request *req)
+{
+	if (req->ret == UQMID_ERROR_TIMEOUT)
+		return "timed out";
+	if (req->ret == QMI_ERROR_CANCELLED)
+		return "cancelled";
+
+	return qmi_get_error_str(req->ret);
+}
+
+enum modem_error msg_req_error(const struct qmi_request *req)
+{
+	if (req->ret == UQMID_ERROR_TIMEOUT)
+		return MODEM_ERR_TIMEOUT;
+	if (req->ret == QMI_ERROR_CANCELLED)
+		return MODEM_ERR_ABORTED;
+
+	return MODEM_ERR_FAILED;
+}
+
+void msg_modem_notify(struct modem *modem, const char *name, struct blob_buf *nb)
+{
+	if (modem->ubus.id)
+		ubus_notify(ubus_ctx, &modem->ubus, name, nb->head, -1);
+}
+
+struct qmi_service *msg_client(struct modem_messaging *m)
+{
+	if (m->dying || !m->active || !m->svc || !uqmi_service_valid(m->modem->qmi, m->svc))
+		return NULL;
+
+	return m->svc;
+}
+
+/*****************************************************************************/
+/* the parts of an SMS */
+
+static void parts_free(struct sms *sms)
+{
+	struct sms_part *p = sms->parts, *next;
+
+	for (; p; p = next) {
+		next = p->next;
+		sms_part_free(p);
+	}
+	sms->parts = NULL;
+	sms->n_parts = 0;
+}
+
+/* insert sorted by the concat sequence (after the parts with the same sequence) */
+static void parts_insert(struct sms *sms, struct sms_part *part)
+{
+	struct sms_part **pp = &sms->parts;
+
+	while (*pp && (*pp)->concat_sequence <= part->concat_sequence)
+		pp = &(*pp)->next;
+
+	part->next = *pp;
+	*pp = part;
+	sms->n_parts++;
+}
+
+static void parts_append(struct sms *sms, struct sms_part *part)
+{
+	struct sms_part **pp = &sms->parts;
+
+	while (*pp)
+		pp = &(*pp)->next;
+
+	part->next = NULL;
+	*pp = part;
+	sms->n_parts++;
+}
+
+static struct sms_part *part_find_sequence(struct sms *sms, unsigned int sequence)
+{
+	struct sms_part *p;
+
+	for (p = sms->parts; p; p = p->next) {
+		if (p->concat_sequence == sequence)
+			return p;
+	}
+
+	return NULL;
+}
+
+/*****************************************************************************/
+/* the object */
+
+static void sms_set_str(struct sms *sms, char **field, const char *value)
+{
+	TALLOC_FREE(*field);
+	if (value)
+		*field = talloc_strdup(sms, value);
+}
+
+static void sms_notify(struct sms *sms, const char *name, struct blob_buf *nb)
+{
+	if (sms->ubus.id)
+		ubus_notify(ubus_ctx, &sms->ubus, name, nb->head, -1);
+}
+
+static void sms_change_state(struct sms *sms, enum sms_state new)
+{
+	enum sms_state old = sms->state;
+	struct blob_buf nb = {};
+
+	if (old == new)
+		return;
+
+	modem_log(sms->m->modem, LOGL_INFO, "sms %s state changed: %s -> %s", sms->ubus.name ? sms->ubus.name : "?",
+		  sms_state_name(old), sms_state_name(new));
+	sms->state = new;
+
+	if (!sms->ubus.id)
+		return;
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "old", sms_state_name(old));
+	blobmsg_add_string(&nb, "new", sms_state_name(new));
+	sms_notify(sms, "state_changed", &nb);
+	blob_buf_free(&nb);
+
+	/* the same on the modem object for a single subscription (uqmid addition) */
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", sms->ubus.name);
+	blobmsg_add_string(&nb, "old", sms_state_name(old));
+	blobmsg_add_string(&nb, "new", sms_state_name(new));
+	msg_modem_notify(sms->m->modem, "messaging.state_changed", &nb);
+	blob_buf_free(&nb);
+}
+
+static void sms_add_properties(struct sms *sms, struct blob_buf *bb)
+{
+	char *hex;
+	size_t i;
+	void *t;
+
+	blobmsg_add_string(bb, "path", sms->ubus.name);
+	blobmsg_add_string(bb, "state", sms_state_name(sms->state));
+	blobmsg_add_string(bb, "pdu_type", sms_pdu_type_name(sms->pdu_type));
+	blobmsg_add_string(bb, "number", sms->number ? sms->number : "");
+	blobmsg_add_string(bb, "smsc", sms->smsc ? sms->smsc : "");
+	/* text and data are never both set by the user, the text of a received message is only there when complete */
+	if (sms->text)
+		blobmsg_add_string(bb, "text", sms->text);
+	if (sms->data) {
+		hex = talloc_array(sms, char, sms->data_len * 2 + 1);
+		if (hex) {
+			for (i = 0; i < sms->data_len; i++)
+				sprintf(hex + 2 * i, "%02x", sms->data[i]);
+			hex[sms->data_len * 2] = '\0';
+			blobmsg_add_string(bb, "data", hex);
+			talloc_free(hex);
+		}
+	}
+	blobmsg_add_string(bb, "validity_type", sms->validity ? "relative" : "unknown");
+	blobmsg_add_u32(bb, "validity", sms->validity);
+	blobmsg_add_u32(bb, "class", sms->class);
+	blobmsg_add_u8(bb, "delivery_report_request", sms->delivery_report_request);
+	blobmsg_add_u32(bb, "message_reference", sms->message_reference);
+	if (sms->timestamp)
+		blobmsg_add_string(bb, "timestamp", sms->timestamp);
+	if (sms->discharge_timestamp)
+		blobmsg_add_string(bb, "discharge_timestamp", sms->discharge_timestamp);
+	blobmsg_add_u32(bb, "delivery_state", sms->delivery_state);
+	blobmsg_add_string(bb, "storage", sms_storage_name(sms->storage));
+	/* uqmid additions: the state of a multipart message which is not complete yet */
+	blobmsg_add_u8(bb, "multipart", sms->multipart);
+	if (sms->multipart) {
+		blobmsg_add_u32(bb, "max_parts", sms->max_parts);
+		blobmsg_add_u32(bb, "received_parts", sms->n_parts);
+	}
+	/* uqmid addition: the storage indices of the stored parts (WMS memory index; `uqmi --uqmid` maps the
+	 * index based --get-message / --delete-message / --list-messages to the sms objects with this) */
+	t = blobmsg_open_array(bb, "indices");
+	if (sms->storage == SMS_STORAGE_SM || sms->storage == SMS_STORAGE_ME) {
+		struct sms_part *p;
+
+		for (p = sms->parts; p; p = p->next) {
+			if (p->index != SMS_PART_INVALID_INDEX)
+				blobmsg_add_u32(bb, NULL, p->index);
+		}
+	}
+	blobmsg_close_array(bb, t);
+}
+
+/** ubus call uqmid.modem.0.sms.0 get */
+static int sms_get(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		   const char *method, struct blob_attr *msg)
+{
+	struct sms *sms = container_of(obj, struct sms, ubus);
+
+	blob_buf_init(&b, 0);
+	sms_add_properties(sms, &b);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static struct ubus_object_type sms_object_type;
+
+static struct sms *sms_alloc(struct modem_messaging *m, enum sms_state state, enum sms_storage storage)
+{
+	struct sms *sms = talloc_zero(m, struct sms);
+
+	if (!sms)
+		return NULL;
+
+	sms->m = m;
+	sms->index = next_sms_index++;
+	sms->state = state;
+	sms->storage = storage;
+	sms->class = -1;
+	sms->delivery_state = SMS_DELIVERY_STATE_UNKNOWN;
+
+	return sms;
+}
+
+/* mm_base_sms_export() + the list: not announced yet */
+static int sms_export(struct sms *sms)
+{
+	struct modem_messaging *m = sms->m;
+	int ret;
+
+	sms->ubus.name = talloc_asprintf(sms, "%s.sms.%u", m->modem->ubus.name, sms->index);
+	sms->ubus.type = &sms_object_type;
+	sms->ubus.methods = sms_object_type.methods;
+	sms->ubus.n_methods = sms_object_type.n_methods;
+	ret = ubus_add_object(ubus_ctx, &sms->ubus);
+	if (ret) {
+		LOG_ERROR("failed to publish ubus object '%s' (ret = %d).\n", sms->ubus.name, ret);
+		return ret;
+	}
+
+	list_add(&sms->list, &m->smss);
+	m->n_smss++;
+
+	return 0;
+}
+
+static void sms_notify_added(struct sms *sms, bool received)
+{
+	struct blob_buf nb = {};
+
+	modem_log(sms->m->modem, LOGL_INFO, "added sms %s (%s, %s, %s)", sms->ubus.name,
+		  sms_pdu_type_name(sms->pdu_type), sms_state_name(sms->state), sms_storage_name(sms->storage));
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", sms->ubus.name);
+	blobmsg_add_u8(&nb, "received", received);
+	msg_modem_notify(sms->m->modem, "messaging.added", &nb);
+	blob_buf_free(&nb);
+}
+
+/* the SMS is already removed from the list (or was never added) */
+static void sms_destroy(struct sms *sms)
+{
+	if (sms->ubus.id)
+		ubus_remove_object(ubus_ctx, &sms->ubus);
+
+	parts_free(sms);
+	talloc_free(sms);
+}
+
+void sms_free(struct sms *sms)
+{
+	/* an object which was never added has no list links (list_del() clears them) */
+	if (sms->list.next) {
+		list_del(&sms->list);
+		sms->m->n_smss--;
+	}
+	sms_destroy(sms);
+}
+
+void sms_list_clear(struct modem_messaging *m)
+{
+	struct sms *sms, *tmp;
+
+	list_for_each_entry_safe(sms, tmp, &m->smss, list)
+		sms_free(sms);
+	m->n_smss = 0;
+}
+
+struct sms *sms_find_by_path(struct modem_messaging *m, const char *path)
+{
+	struct sms *sms;
+
+	list_for_each_entry(sms, &m->smss, list) {
+		if (!strcmp(sms->ubus.name, path))
+			return sms;
+	}
+
+	return NULL;
+}
+
+/* mm_sms_list_delete_sms(): the object is gone and the Deleted signal follows */
+static void sms_remove(struct sms *sms)
+{
+	struct modem_messaging *m = sms->m;
+	struct blob_buf nb = {};
+	char *path = talloc_strdup(NULL, sms->ubus.name);
+
+	modem_log(m->modem, LOGL_INFO, "deleted sms %s", path);
+	sms_free(sms);
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", path);
+	msg_modem_notify(m->modem, "messaging.deleted", &nb);
+	blob_buf_free(&nb);
+	talloc_free(path);
+}
+
+/*****************************************************************************/
+/* taking parts (MM: mm_sms_list_take_part(), mm_base_sms_singlepart_new(), mm_base_sms_multipart_new()) */
+
+/* initialize_sms() */
+static void sms_initialize(struct sms *sms, const struct sms_part *part)
+{
+	sms->pdu_type = part->pdu_type;
+	sms_set_str(sms, &sms->smsc, part->smsc);
+	sms->class = part->class;
+	sms_set_str(sms, &sms->number, part->number);
+	sms->validity = part->validity_relative;
+	sms_set_str(sms, &sms->timestamp, part->timestamp);
+	sms_set_str(sms, &sms->discharge_timestamp, part->discharge_timestamp);
+	sms->delivery_state = part->delivery_state;
+}
+
+/* assemble_sms() */
+static bool sms_assemble(struct sms *sms)
+{
+	struct modem *modem = sms->m->modem;
+	struct sms_part **sorted, *p;
+	unsigned int idx, n = sms->max_parts ? sms->max_parts : 1;
+	size_t text_len = 0, data_len = 0;
+	bool has_text = false, has_data = false;
+	char *text;
+	uint8_t *data;
+	size_t to = 0, dopos = 0;
+
+	sorted = talloc_zero_array(sms, struct sms_part *, n);
+	if (!sorted)
+		return false;
+
+	/* Note that sequence in multipart messages start with '1', while singlepart messages have '0' as sequence. */
+	if (!sms->multipart) {
+		if (sms->n_parts != 1) {
+			modem_log(modem, LOGL_NOTICE, "single part message with multiple parts (%u) found", sms->n_parts);
+			talloc_free(sorted);
+			return false;
+		}
+		sorted[0] = sms->parts;
+	} else {
+		/* Check if we have duplicate parts */
+		for (p = sms->parts; p; p = p->next) {
+			idx = p->concat_sequence;
+			if (idx < 1 || idx > n) {
+				modem_log(modem, LOGL_NOTICE, "invalid part index (%u) found, ignoring", idx);
+				continue;
+			}
+			if (sorted[idx - 1]) {
+				modem_log(modem, LOGL_NOTICE, "duplicate part index (%u) found, ignoring", idx);
+				continue;
+			}
+			sorted[idx - 1] = p;
+		}
+	}
+
+	for (idx = 0; idx < n; idx++) {
+		p = sorted[idx];
+		if (!p) {
+			modem_log(modem, LOGL_NOTICE, "cannot assemble SMS, missing part at index (%u)",
+				  sms->multipart ? idx + 1 : idx);
+			talloc_free(sorted);
+			return false;
+		}
+
+		/* Also status report PDUs may not have neither text nor data */
+		if (!p->text && !p->data && p->pdu_type != SMS_PDU_STATUS_REPORT) {
+			modem_log(modem, LOGL_NOTICE, "cannot assemble SMS, part at index (%u) has neither text nor data",
+				  sms->multipart ? idx + 1 : idx);
+			talloc_free(sorted);
+			return false;
+		}
+
+		if (p->text) {
+			has_text = true;
+			text_len += strlen(p->text);
+		}
+		if (p->data) {
+			has_data = true;
+			data_len += p->data_len;
+		}
+	}
+
+	text = has_text ? talloc_size(sms, text_len + 1) : NULL;
+	data = has_data ? talloc_size(sms, data_len ? data_len : 1) : NULL;
+	if ((has_text && !text) || (has_data && !data)) {
+		talloc_free(text);
+		talloc_free(data);
+		talloc_free(sorted);
+		return false;
+	}
+
+	for (idx = 0; idx < n; idx++) {
+		p = sorted[idx];
+		if (p->text) {
+			memcpy(text + to, p->text, strlen(p->text));
+			to += strlen(p->text);
+		}
+		if (p->data) {
+			memcpy(data + dopos, p->data, p->data_len);
+			dopos += p->data_len;
+		}
+	}
+	if (text)
+		text[to] = '\0';
+
+	TALLOC_FREE(sms->text);
+	TALLOC_FREE(sms->data);
+	sms->text = text;
+	sms->data = data;
+	sms->data_len = data_len;
+
+	/* delivery report request and message reference taken always from the last part */
+	p = sorted[n - 1];
+	sms->message_reference = p->message_reference;
+	sms->delivery_report_request = p->delivery_report_request;
+
+	talloc_free(sorted);
+	sms->assembled = true;
+
+	return true;
+}
+
+static bool sms_has_part(struct modem_messaging *m, enum sms_storage storage, unsigned int index)
+{
+	struct sms *sms;
+	struct sms_part *p;
+
+	if (storage == SMS_STORAGE_UNKNOWN || index == SMS_PART_INVALID_INDEX)
+		return false;
+
+	list_for_each_entry(sms, &m->smss, list) {
+		if (sms->storage != storage)
+			continue;
+		for (p = sms->parts; p; p = p->next) {
+			if (p->index == index)
+				return true;
+		}
+	}
+
+	return false;
+}
+
+static bool take_singlepart(struct modem_messaging *m, struct sms_part *part, enum sms_state state,
+			    enum sms_storage storage)
+{
+	struct sms *sms;
+
+	if (m->n_smss >= MAX_SMS) {
+		modem_log(m->modem, LOGL_NOTICE, "too many SMS, dropping a received message");
+		return false;
+	}
+
+	sms = sms_alloc(m, state, storage);
+	if (!sms)
+		return false;
+
+	/* Keep the single part in the list */
+	sms->parts = part;
+	sms->n_parts = 1;
+	part->next = NULL;
+	sms_initialize(sms, part);
+
+	if (!sms_assemble(sms)) {
+		/* the part is not ours */
+		sms->parts = NULL;
+		sms->n_parts = 0;
+		talloc_free(sms);
+		return false;
+	}
+
+	/* Only export once properly created */
+	if (sms_export(sms)) {
+		sms->parts = NULL;
+		sms->n_parts = 0;
+		talloc_free(sms);
+		return false;
+	}
+
+	sms_notify_added(sms, state == SMS_STATE_RECEIVED);
+	return true;
+}
+
+/* mm_base_sms_multipart_take_part() */
+static bool multipart_take_part(struct sms *sms, struct sms_part *part)
+{
+	struct modem *modem = sms->m->modem;
+
+	if (!sms->multipart || sms->n_parts >= sms->max_parts || part_find_sequence(sms, part->concat_sequence) ||
+	    part->concat_sequence > sms->max_parts)
+		return false;
+
+	/* Insert sorted by concat sequence */
+	parts_insert(sms, part);
+
+	/* We only populate contents when the multipart SMS is complete */
+	if (sms->n_parts == sms->max_parts) {
+		if (!sms_assemble(sms)) {
+			/* We DO NOT propagate the error. The part was properly taken. */
+			modem_log(modem, LOGL_NOTICE, "couldn't assemble SMS %s", sms->ubus.name);
+		} else if (sms->state == SMS_STATE_RECEIVING) {
+			/* Completed AND assembled. Change state RECEIVING->RECEIVED, and signal completeness */
+			sms_change_state(sms, SMS_STATE_RECEIVED);
+		}
+	}
+
+	return true;
+}
+
+static bool take_multipart(struct modem_messaging *m, struct sms_part *part, enum sms_state state,
+			   enum sms_storage storage)
+{
+	struct sms *sms;
+
+	list_for_each_entry(sms, &m->smss, list) {
+		/* cmp_sms_by_number_reference() */
+		if (!sms->multipart || sms->multipart_reference != part->concat_reference || sms->pdu_type != part->pdu_type ||
+		    !sms->number || !part->number || strcmp(sms->number, part->number) ||
+		    sms->max_parts != part->concat_max)
+			continue;
+
+		/* Try to take the part */
+		modem_log(m->modem, LOGL_DEBUG, "found existing multipart SMS object %s with reference '%u': adding new part",
+			  sms->ubus.name, part->concat_reference);
+		return multipart_take_part(sms, part);
+	}
+
+	if (m->n_smss >= MAX_SMS) {
+		modem_log(m->modem, LOGL_NOTICE, "too many SMS, dropping a received message");
+		return false;
+	}
+
+	/* If this is the first part of a RECEIVED SMS, we overwrite the state as RECEIVING, to indicate that it is not
+	 * completed yet. */
+	sms = sms_alloc(m, state == SMS_STATE_RECEIVED ? SMS_STATE_RECEIVING : state, storage);
+	if (!sms)
+		return false;
+
+	sms->multipart = true;
+	sms->max_parts = part->concat_max;
+	sms->multipart_reference = part->concat_reference;
+	sms_set_str(sms, &sms->number, part->number);
+
+	if (!multipart_take_part(sms, part)) {
+		talloc_free(sms);
+		return false;
+	}
+	sms_initialize(sms, part);
+
+	/* We do export incomplete multipart messages, in order to be able to request removal of all parts of those
+	 * multipart SMS that will never get completed. Only the state of the SMS object is valid then. */
+	if (sms_export(sms)) {
+		sms->parts = NULL;
+		sms->n_parts = 0;
+		talloc_free(sms);
+		return false;
+	}
+
+	modem_log(m->modem, LOGL_DEBUG, "created new multipart SMS object: need to receive %u parts with reference '%u'",
+		  part->concat_max, part->concat_reference);
+	sms_notify_added(sms, state == SMS_STATE_RECEIVED || state == SMS_STATE_RECEIVING);
+	return true;
+}
+
+bool sms_list_take_part(struct modem_messaging *m, struct sms_part *part, enum sms_state state,
+			enum sms_storage storage)
+{
+	bool taken;
+
+	if (!m->active) {
+		sms_part_free(part);
+		return false;
+	}
+
+	/* Ensure we don't have already taken a part with the same index */
+	if (sms_has_part(m, storage, part->index)) {
+		modem_log(m->modem, LOGL_DEBUG, "couldn't take part in SMS list: a part with index %u was already taken",
+			  part->index);
+		sms_part_free(part);
+		return false;
+	}
+
+	/* Did we just get a part of a multi-part SMS? */
+	if (part->should_concat) {
+		modem_log(m->modem, LOGL_DEBUG, "SMS part at '%s/%u' is from a multipart SMS (reference: '%u', sequence: '%u/%u')",
+			  sms_storage_name(storage), part->index, part->concat_reference, part->concat_sequence,
+			  part->concat_max);
+		taken = take_multipart(m, part, state, storage);
+	} else {
+		/* Otherwise, we build a whole new single-part SMS just from this part */
+		modem_log(m->modem, LOGL_DEBUG, "SMS part at '%s/%u' is from a singlepart SMS", sms_storage_name(storage),
+			  part->index);
+		taken = take_singlepart(m, part, state, storage);
+	}
+
+	/* If part wasn't taken, we need to free the part ourselves */
+	if (!taken)
+		sms_part_free(part);
+
+	return taken;
+}
+
+/*****************************************************************************/
+/* creating an SMS (mm_base_sms_new_from_properties()) */
+
+struct sms *sms_create(struct modem_messaging *m, const char *number, const char *text, const uint8_t *data,
+		       size_t data_len, const char *smsc, unsigned int validity, int class, bool dra)
+{
+	struct sms *sms = sms_alloc(m, SMS_STATE_UNKNOWN, SMS_STORAGE_UNKNOWN);
+
+	if (!sms)
+		return NULL;
+
+	sms->pdu_type = SMS_PDU_SUBMIT;
+	sms_set_str(sms, &sms->number, number);
+	sms_set_str(sms, &sms->smsc, smsc);
+	if (text) {
+		sms_set_str(sms, &sms->text, text);
+	} else {
+		sms->data = talloc_size(sms, data_len ? data_len : 1);
+		if (!sms->data) {
+			talloc_free(sms);
+			return NULL;
+		}
+		memcpy(sms->data, data, data_len);
+		sms->data_len = data_len;
+	}
+	sms->class = class;
+	sms->validity = validity;
+	sms->delivery_report_request = dra;
+
+	if (sms_export(sms)) {
+		talloc_free(sms);
+		return NULL;
+	}
+
+	/* mm_sms_list_add_sms(): Added with received = false */
+	sms_notify_added(sms, false);
+	return sms;
+}
+
+/*****************************************************************************/
+/* user requests */
+
+struct mop *mop_new(struct modem_messaging *m, struct ubus_context *ctx, struct ubus_request_data *req,
+		    enum mop_kind kind, struct sms *sms)
+{
+	struct mop *op = talloc_zero(m, struct mop);
+
+	if (!op)
+		return NULL;
+
+	op->m = m;
+	op->kind = kind;
+	op->sms = sms;
+	list_add_tail(&op->list, &m->ops);
+	ubus_defer_request(ctx, req, &op->req);
+	if (sms)
+		sms->busy = true;
+
+	return op;
+}
+
+void mop_done(struct mop *op, enum modem_error err, const char *msg, struct blob_attr *reply)
+{
+	if (op->sms)
+		op->sms->busy = false;
+
+	list_del(&op->list);
+	uqmid_ubus_deferred_done(&op->req, err, msg, reply);
+	talloc_free(op);
+}
+
+void mop_fail_req(struct mop *op, const struct qmi_request *req, const char *what)
+{
+	char msg[160];
+
+	snprintf(msg, sizeof(msg), "%s: QMI operation failed: %s", what, msg_req_error_str(req));
+	mop_done(op, msg_req_error(req), msg, NULL);
+}
+
+/* the modem goes away or is disabled: the QMI requests are cancelled without a callback */
+void sms_ops_abort(struct modem_messaging *m)
+{
+	struct mop *op, *tmp;
+
+	list_for_each_entry_safe(op, tmp, &m->ops, list)
+		mop_done(op, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+}
+
+static unsigned int rand_range(unsigned int lo, unsigned int hi)
+{
+	uint32_t r;
+
+	if (getrandom(&r, sizeof(r), 0) != sizeof(r))
+		r = random();
+
+	return lo + r % (hi - lo + 1);
+}
+
+/* mm_iface_modem_messaging_get_local_multipart_reference() */
+static unsigned int local_multipart_reference(struct modem_messaging *m, const char *number)
+{
+	unsigned int reference = rand_range(1, 254), first = reference;
+	struct sms *sms;
+	bool used;
+
+	do {
+		used = false;
+		list_for_each_entry(sms, &m->smss, list) {
+			/* mm_sms_list_has_local_multipart_reference() */
+			if (sms->multipart && sms->pdu_type == SMS_PDU_SUBMIT && sms->storage != SMS_STORAGE_UNKNOWN &&
+			    sms->multipart_reference == reference && sms->number && !strcmp(sms->number, number)) {
+				used = true;
+				break;
+			}
+		}
+		if (!used)
+			return reference;
+
+		reference = reference == 254 ? 1 : reference + 1;
+	} while (reference != first);
+
+	return 0;
+}
+
+/* generate_3gpp_submit_pdus() */
+static enum modem_error sms_generate_parts(struct sms *sms, char *err, size_t errlen)
+{
+	struct sms_chunk *chunks = NULL;
+	size_t n_chunks = 0, i;
+	enum sms_encoding encoding;
+
+	/* the parts are generated once (when storing or sending) */
+	if (sms->parts)
+		return MODEM_ERR_NONE;
+
+	if (sms->text) {
+		bool gsm7;
+
+		if (sms_split_text(sms->text, &gsm7, &chunks, &n_chunks)) {
+			snprintf(err, errlen, "Cannot generate PDUs: Error processing input text");
+			return MODEM_ERR_INVALID_ARGS;
+		}
+		encoding = gsm7 ? SMS_ENC_GSM7 : SMS_ENC_UCS2;
+	} else {
+		encoding = SMS_ENC_8BIT;
+		if (sms_split_data(sms->data_len, &chunks, &n_chunks)) {
+			snprintf(err, errlen, "Cannot generate PDUs: Error processing input data");
+			return MODEM_ERR_INVALID_ARGS;
+		}
+	}
+
+	if (n_chunks > 255) {
+		free(chunks);
+		snprintf(err, errlen, "Cannot generate PDUs: Text or Data too long");
+		return MODEM_ERR_INVALID_ARGS;
+	}
+
+	/* Loop text/data chunks */
+	for (i = 0; i < n_chunks; i++) {
+		struct sms_part *part = sms_part_new(SMS_PART_INVALID_INDEX, SMS_PDU_SUBMIT);
+
+		if (!part) {
+			free(chunks);
+			parts_free(sms);
+			snprintf(err, errlen, "out of memory");
+			return MODEM_ERR_FAILED;
+		}
+
+		if (sms->text) {
+			size_t l = chunks[i].len;
+			char *t = malloc(l + 1);
+
+			if (t) {
+				memcpy(t, sms->text + chunks[i].off, l);
+				t[l] = '\0';
+			}
+			sms_part_take_text(part, t);
+		} else {
+			size_t l = chunks[i].len;
+			uint8_t *d = malloc(l ? l : 1);
+
+			if (d)
+				memcpy(d, sms->data + chunks[i].off, l);
+			sms_part_take_data(part, d, l);
+		}
+		part->encoding = encoding;
+		sms_part_set_number(part, sms->number);
+		sms_part_set_smsc(part, sms->smsc);
+		part->validity_relative = sms->validity;
+		part->class = sms->class;
+		part->delivery_report_request = sms->delivery_report_request;
+
+		if (n_chunks > 1) {
+			/* We don't set a concat reference here */
+			part->concat_reference = 0;
+			part->concat_sequence = i + 1;
+			part->concat_max = n_chunks;
+		}
+		parts_append(sms, part);
+	}
+	free(chunks);
+
+	/* Set additional multipart specific properties */
+	if (n_chunks > 1) {
+		sms->multipart = true;
+		sms->max_parts = n_chunks;
+	}
+
+	/* No more parts are expected */
+	sms->assembled = true;
+
+	return MODEM_ERR_NONE;
+}
+
+static void sms_set_concat_reference(struct sms *sms, unsigned int reference)
+{
+	struct sms_part *p;
+
+	sms->multipart_reference = reference;
+	for (p = sms->parts; p; p = p->next) {
+		p->concat_reference = reference;
+		p->should_concat = true;
+	}
+}
+
+/*****************************************************************************/
+/* send (mm-sms-qmi.c: sms_send()) */
+
+static void send_next(struct mop *op);
+
+static void send_finish(struct mop *op)
+{
+	struct sms *sms = op->sms;
+	struct sms_part *last = sms->parts;
+
+	while (last && last->next)
+		last = last->next;
+
+	/* Transition from Unknown->Sent or Stored->Sent */
+	if (sms->state == SMS_STATE_UNKNOWN || sms->state == SMS_STATE_STORED) {
+		/* Grab last message reference */
+		if (last)
+			sms->message_reference = last->message_reference;
+		sms_change_state(sms, SMS_STATE_SENT);
+	}
+
+	modem_log(op->m->modem, LOGL_INFO, "sent SMS message %s", sms->ubus.name);
+	mop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+static void send_generic_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+	struct qmi_wms_raw_send_response res = {};
+
+	if (!msg || req->ret) {
+		if (msg && !qmi_parse_wms_raw_send_response(msg, &res) && res.set.gsm_wcdma_cause_info)
+			modem_log(op->m->modem, LOGL_NOTICE, "couldn't send SMS; RP cause (%u); TP cause (%u)",
+				  res.data.gsm_wcdma_cause_info.rp_cause, res.data.gsm_wcdma_cause_info.tp_cause);
+		mop_fail_req(op, req, "Couldn't send SMS part");
+		return;
+	}
+
+	if (!qmi_parse_wms_raw_send_response(msg, &res) && res.set.message_id)
+		op->cur->message_reference = res.data.message_id;
+
+	/* Go on with next part */
+	op->cur = op->cur->next;
+	send_next(op);
+}
+
+static void send_generic(struct mop *op)
+{
+	struct qmi_service *svc = msg_client(op->m);
+	struct qmi_wms_raw_send_request rs = {};
+	uint8_t pdu[SMS_PDU_MAX];
+	char err[100] = "";
+	size_t len = 0;
+
+	if (!svc) {
+		mop_done(op, MODEM_ERR_WRONG_STATE, "Modem is not enabled", NULL);
+		return;
+	}
+
+	if (sms_part_3gpp_get_submit_pdu(op->cur, pdu, &len, err, sizeof(err))) {
+		char text[160];
+
+		snprintf(text, sizeof(text), "Cannot create submit PDUs: %s", err);
+		mop_done(op, MODEM_ERR_INVALID_ARGS, text, NULL);
+		return;
+	}
+
+	rs.set.raw_message_data = 1;
+	rs.data.raw_message_data.format = QMI_WMS_MESSAGE_FORMAT_GSM_WCDMA_POINT_TO_POINT;
+	rs.data.raw_message_data.raw_data_n = len;
+	rs.data.raw_message_data.raw_data = pdu;
+	if (SEND_REQ(svc, qmi_set_wms_raw_send_request(_m, &rs), send_generic_cb, op, WMS_SEND_TIMEOUT_MS))
+		mop_done(op, MODEM_ERR_FAILED, "Couldn't send SMS part", NULL);
+}
+
+static void send_from_storage_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+	struct qmi_wms_send_from_memory_storage_response res = {};
+
+	if (!msg || req->ret) {
+		if (msg && req->ret == QMI_PROTOCOL_ERROR_INVALID_QMI_COMMAND) {
+			modem_log(op->m->modem, LOGL_DEBUG,
+				  "couldn't send SMS from storage: %s; trying generic send...", msg_req_error_str(req));
+			op->from_storage = false;
+			send_next(op);
+			return;
+		}
+
+		if (msg && !qmi_parse_wms_send_from_memory_storage_response(msg, &res) && res.set.gsm_wcdma_cause_info)
+			modem_log(op->m->modem, LOGL_NOTICE, "couldn't send SMS; RP cause (%u); TP cause (%u)",
+				  res.data.gsm_wcdma_cause_info.rp_cause, res.data.gsm_wcdma_cause_info.tp_cause);
+		mop_fail_req(op, req, "Couldn't send SMS part");
+		return;
+	}
+
+	if (!qmi_parse_wms_send_from_memory_storage_response(msg, &res) && res.set.message_id)
+		op->cur->message_reference = res.data.message_id;
+
+	/* Go on with next part */
+	op->cur = op->cur->next;
+	send_next(op);
+}
+
+static void send_from_storage(struct mop *op)
+{
+	struct qmi_service *svc = msg_client(op->m);
+	struct qmi_wms_send_from_memory_storage_request sr = {};
+
+	if (!svc) {
+		mop_done(op, MODEM_ERR_WRONG_STATE, "Modem is not enabled", NULL);
+		return;
+	}
+
+	sr.set.information = 1;
+	sr.data.information.storage_type = storage_to_qmi(op->sms->storage);
+	sr.data.information.memory_index = op->cur->index;
+	sr.data.information.message_mode = QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+	if (SEND_REQ(svc, qmi_set_wms_send_from_memory_storage_request(_m, &sr), send_from_storage_cb, op,
+		     WMS_SEND_TIMEOUT_MS))
+		mop_done(op, MODEM_ERR_FAILED, "Couldn't send SMS part", NULL);
+}
+
+static void send_next(struct mop *op)
+{
+	if (!op->cur) {
+		/* Done we are */
+		send_finish(op);
+		return;
+	}
+
+	/* Send from storage? */
+	if (op->from_storage)
+		send_from_storage(op);
+	else
+		send_generic(op);
+}
+
+/** ubus call uqmid.modem.0.sms.0 send */
+static int sms_send(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		    const char *method, struct blob_attr *msg)
+{
+	struct sms *sms = container_of(obj, struct sms, ubus);
+	struct modem_messaging *m = sms->m;
+	char err[120] = "";
+	enum modem_error e;
+	struct mop *op;
+
+	/* We can only send SMS created by the user */
+	if (sms->state == SMS_STATE_RECEIVED || sms->state == SMS_STATE_RECEIVING)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This SMS was received, cannot send it");
+
+	/* Don't allow sending the same SMS multiple times, we would lose the message reference */
+	if (sms->state == SMS_STATE_SENT)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This SMS was already sent, cannot send it again");
+
+	if (sms->busy)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS,
+					      "Another operation on this SMS is running");
+
+	if (!msg_client(m))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	modem_log(m->modem, LOGL_INFO, "processing user request to send SMS message %s...", sms->ubus.name);
+
+	/* prepare_sms_to_be_sent(): create the parts if we did not create them already before */
+	if (!sms->parts) {
+		e = sms_generate_parts(sms, err, sizeof(err));
+		if (e) {
+			char text[160];
+
+			snprintf(text, sizeof(text), "Cannot create submit PDUs: %s", err);
+			return uqmid_ubus_reply_error(ctx, req, e, text);
+		}
+
+		/* If the message is a multipart message, we need to set a proper multipart reference. When sending a
+		 * message which wasn't stored yet, we can just get a random multipart reference. */
+		if (sms->multipart)
+			sms_set_concat_reference(sms, rand_range(1, 254));
+	} else if (sms->multipart && sms->n_parts != sms->max_parts) {
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This SMS is not complete, cannot send it");
+	}
+
+	op = mop_new(m, ctx, req, MOP_SEND, sms);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	/* If the SMS is STORED, try to send from storage */
+	op->from_storage = sms->storage != SMS_STORAGE_UNKNOWN;
+	op->cur = sms->parts;
+	send_next(op);
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* store (mm-sms-qmi.c: sms_store()) */
+
+static void store_next(struct mop *op);
+
+static void rollback_written_parts(struct mop *op)
+{
+	struct qmi_service *svc = msg_client(op->m);
+	struct sms_part *p;
+
+	/* a part which was written is not left behind in the storage */
+	for (p = op->sms->parts; p; p = p->next) {
+		if (p->index == SMS_PART_INVALID_INDEX)
+			continue;
+
+		if (svc) {
+			struct qmi_wms_delete_request dr = {};
+
+			dr.set.memory_storage = 1;
+			dr.data.memory_storage = storage_to_qmi(op->storage);
+			dr.set.memory_index = 1;
+			dr.data.memory_index = p->index;
+			dr.set.message_mode = 1;
+			dr.data.message_mode = QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+			SEND_REQ(svc, qmi_set_wms_delete_request(_m, &dr), NULL, NULL, WMS_TIMEOUT_MS);
+		}
+		p->index = SMS_PART_INVALID_INDEX;
+	}
+}
+
+static void store_fail(struct mop *op, enum modem_error err, const char *msg)
+{
+	rollback_written_parts(op);
+	modem_log(op->m->modem, LOGL_NOTICE, "failed storing SMS message: %s", msg);
+	mop_done(op, err, msg, NULL);
+}
+
+static void store_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+	struct qmi_wms_raw_write_response res = {};
+
+	if (!msg || req->ret || qmi_parse_wms_raw_write_response(msg, &res) || !res.set.memory_index) {
+		char text[160];
+
+		snprintf(text, sizeof(text), "Couldn't write SMS part: QMI operation failed: %s", msg_req_error_str(req));
+		store_fail(op, !msg || req->ret ? msg_req_error(req) : MODEM_ERR_FAILED, text);
+		return;
+	}
+
+	/* Set the index in the part we hold */
+	op->cur->index = res.data.memory_index;
+
+	/* Go on with next one */
+	op->cur = op->cur->next;
+	store_next(op);
+}
+
+static void store_next(struct mop *op)
+{
+	struct qmi_service *svc = msg_client(op->m);
+	struct qmi_wms_raw_write_request rw = {};
+	struct sms *sms = op->sms;
+	uint8_t pdu[SMS_PDU_MAX];
+	char err[100] = "";
+	size_t len = 0;
+
+	if (!op->cur) {
+		/* Done we are */
+		sms->storage = op->storage;
+		/* Transition from Unknown->Stored for SMS which were created by the user */
+		if (sms->state == SMS_STATE_UNKNOWN)
+			sms_change_state(sms, SMS_STATE_STORED);
+		modem_log(op->m->modem, LOGL_INFO, "stored SMS message %s", sms->ubus.name);
+		mop_done(op, MODEM_ERR_NONE, NULL, NULL);
+		return;
+	}
+
+	if (!svc) {
+		store_fail(op, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+		return;
+	}
+
+	if (sms_part_3gpp_get_submit_pdu(op->cur, pdu, &len, err, sizeof(err))) {
+		char text[160];
+
+		snprintf(text, sizeof(text), "Cannot create submit PDUs: %s", err);
+		store_fail(op, MODEM_ERR_INVALID_ARGS, text);
+		return;
+	}
+
+	rw.set.raw_message_data = 1;
+	rw.data.raw_message_data.storage_type = storage_to_qmi(op->storage);
+	rw.data.raw_message_data.format = QMI_WMS_MESSAGE_FORMAT_GSM_WCDMA_POINT_TO_POINT;
+	rw.data.raw_message_data.raw_data_n = len;
+	rw.data.raw_message_data.raw_data = pdu;
+	if (SEND_REQ(svc, qmi_set_wms_raw_write_request(_m, &rw), store_cb, op, WMS_TIMEOUT_MS))
+		store_fail(op, MODEM_ERR_FAILED, "Couldn't write SMS part");
+}
+
+enum { ST_STORAGE, __ST_MAX };
+static const struct blobmsg_policy sms_store_policy[__ST_MAX] = {
+	[ST_STORAGE] = { .name = "storage", .type = BLOBMSG_TYPE_STRING },
+};
+
+/* mm_iface_modem_messaging_is_storage_supported_for_storing(): mem2 of the QMI modems is sm and me */
+bool msg_storage_supported(enum sms_storage storage)
+{
+	return storage == SMS_STORAGE_SM || storage == SMS_STORAGE_ME;
+}
+
+/** ubus call uqmid.modem.0.sms.0 store '{"storage": "sm"}' (the default storage if not given) */
+static int sms_store(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		     const char *method, struct blob_attr *msg)
+{
+	struct sms *sms = container_of(obj, struct sms, ubus);
+	struct modem_messaging *m = sms->m;
+	struct blob_attr *tb[__ST_MAX];
+	enum sms_storage storage = SMS_STORAGE_UNKNOWN;
+	char err[120] = "", text[200];
+	enum modem_error e;
+	struct mop *op;
+
+	blobmsg_parse(sms_store_policy, __ST_MAX, tb, blob_data(msg), blob_len(msg));
+	if (tb[ST_STORAGE]) {
+		const char *name = blobmsg_get_string(tb[ST_STORAGE]);
+
+		storage = sms_storage_from_name(name);
+		if (storage == SMS_STORAGE_UNKNOWN) {
+			snprintf(text, sizeof(text), "Unknown storage '%s'", name);
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, text);
+		}
+	}
+
+	/* We'll set now the proper storage, taken from the default mem2 one */
+	if (storage == SMS_STORAGE_UNKNOWN)
+		storage = m->default_storage;
+	if (storage == SMS_STORAGE_UNKNOWN)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "No default storage is known");
+
+	modem_log(m->modem, LOGL_INFO, "processing user request to store SMS message %s in storage '%s'...",
+		  sms->ubus.name, sms_storage_name(storage));
+
+	/* First of all, check if we already have the SMS stored. */
+	if (sms->storage != SMS_STORAGE_UNKNOWN) {
+		/* Check if SMS stored in some other storage */
+		if (sms->storage == storage) {
+			/* Good, same storage */
+			modem_log(m->modem, LOGL_INFO, "SMS message already stored");
+			return UBUS_STATUS_OK;
+		}
+
+		snprintf(text, sizeof(text), "SMS is already stored in storage '%s', cannot store it in storage '%s'",
+			 sms_storage_name(sms->storage), sms_storage_name(storage));
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, text);
+	}
+
+	/* Check if the requested storage is allowed for storing */
+	if (!msg_storage_supported(storage)) {
+		snprintf(text, sizeof(text), "Storage '%s' is not supported for storing", sms_storage_name(storage));
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED, text);
+	}
+
+	if (sms->busy)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS,
+					      "Another operation on this SMS is running");
+
+	if (!msg_client(m))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	/* prepare_sms_to_be_stored(): create the parts if we did not create them already before (e.g. when sending) */
+	if (!sms->parts) {
+		e = sms_generate_parts(sms, err, sizeof(err));
+		if (e) {
+			snprintf(text, sizeof(text), "Cannot create submit PDUs: %s", err);
+			return uqmid_ubus_reply_error(ctx, req, e, text);
+		}
+	}
+
+	/* If the message is a multipart message, we need to set a proper multipart reference. A random one chosen
+	 * when sending doesn't work when storing locally, as we could collide with the references used in other
+	 * existing messages. */
+	if (sms->multipart) {
+		unsigned int reference = local_multipart_reference(m, sms->number);
+
+		if (!reference)
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED,
+						      "Cannot get local multipart reference: no valid reference available for the destination number");
+		sms_set_concat_reference(sms, reference);
+	}
+
+	op = mop_new(m, ctx, req, MOP_STORE, sms);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	op->storage = storage;
+	op->cur = sms->parts;
+	store_next(op);
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* delete (mm-sms-qmi.c: sms_delete()) */
+
+static void delete_next(struct mop *op);
+
+static void delete_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+
+	if (!msg || req->ret) {
+		op->n_failed++;
+		modem_log(op->m->modem, LOGL_DEBUG, "couldn't delete SMS part with index %u: %s", op->cur->index,
+			  msg_req_error_str(req));
+	}
+
+	/* We reset the index, as there is no longer that part */
+	op->cur->index = SMS_PART_INVALID_INDEX;
+
+	op->cur = op->cur->next;
+	delete_next(op);
+}
+
+static void delete_next(struct mop *op)
+{
+	struct qmi_service *svc;
+	struct qmi_wms_delete_request dr = {};
+	struct sms *sms = op->sms;
+
+	/* Skip non-stored parts */
+	while (op->cur && op->cur->index == SMS_PART_INVALID_INDEX)
+		op->cur = op->cur->next;
+
+	/* If all removed, we're done */
+	if (!op->cur) {
+		if (op->n_failed > 0) {
+			char text[80];
+
+			snprintf(text, sizeof(text), "Couldn't delete %u parts from this SMS", op->n_failed);
+			mop_done(op, MODEM_ERR_FAILED, text, NULL);
+			return;
+		}
+
+		/* the SMS is deleted: the object goes, the request is answered */
+		op->sms = NULL;
+		sms->busy = false;
+		sms_remove(sms);
+		mop_done(op, MODEM_ERR_NONE, NULL, NULL);
+		return;
+	}
+
+	svc = msg_client(op->m);
+	if (!svc) {
+		mop_done(op, MODEM_ERR_WRONG_STATE, "Modem is not enabled", NULL);
+		return;
+	}
+
+	dr.set.memory_storage = 1;
+	dr.data.memory_storage = storage_to_qmi(sms->storage);
+	dr.set.memory_index = 1;
+	dr.data.memory_index = op->cur->index;
+	dr.set.message_mode = 1;
+	dr.data.message_mode = QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+	if (SEND_REQ(svc, qmi_set_wms_delete_request(_m, &dr), delete_cb, op, WMS_TIMEOUT_MS)) {
+		op->n_failed++;
+		op->cur->index = SMS_PART_INVALID_INDEX;
+		op->cur = op->cur->next;
+		delete_next(op);
+	}
+}
+
+void sms_delete_deferred(struct sms *sms, struct ubus_context *ctx, struct ubus_request_data *req)
+{
+	struct mop *op = mop_new(sms->m, ctx, req, MOP_DELETE, sms);
+
+	if (!op) {
+		uqmid_ubus_deferred_done(req, MODEM_ERR_FAILED, "out of memory", NULL);
+		return;
+	}
+
+	/* Go on deleting parts */
+	op->cur = sms->parts;
+	delete_next(op);
+}
+
+static const struct ubus_method sms_methods[] = {
+	UBUS_METHOD_NOARG("get", sms_get),
+	UBUS_METHOD_NOARG("send", sms_send),
+	UBUS_METHOD("store", sms_store, sms_store_policy),
+};
+
+static struct ubus_object_type sms_object_type = UBUS_OBJECT_TYPE("uqmid_sms", sms_methods);

+static const char *band_nick(unsigned int band)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(band_nicks); i++) {
+		if (band_nicks[i].value == band)
+			return band_nicks[i].nick;
+	}
+
+	return NULL;
+}
+
+static int band_from_nick(const char *nick)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(band_nicks); i++) {
+		if (!strcasecmp(band_nicks[i].nick, nick))
+			return band_nicks[i].value;
+	}
+
+	return -1;
+}

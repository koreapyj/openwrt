@@ -0,0 +1,82 @@
+/*
+ * uqmid -- own numbers (read only)
+ *
+ * ModemManager: Modem.OwnNumbers, mm-broadband-modem-qmi.c modem_load_own_numbers():
+ * DMS Get MSISDN (5 s timeout). The result is a list with the one MSISDN the modem
+ * reports (MM builds a one element GStrv; if the modem returns no number the list
+ * stays empty).
+ *
+ * mm-iface-modem.c, INITIALIZATION_STEP_OWN_NUMBERS (after unlock required, SIM and
+ * carrier config): "Own numbers is meant to be loaded only once during the whole
+ * lifetime of the modem. Therefore, if we already have them loaded, don't try to
+ * load them again." A failure is only logged (load_own_numbers_ready), the property
+ * stays unset and the next initialization (e.g. after the SIM has been unlocked)
+ * tries again. Here the step runs when the SIM becomes ready, i.e. when the modem
+ * leaves the init/locked states for disabled.
+ */
+
+#include <string.h>
+
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sim_obj.h"
+#include "utils.h"
+
+/* MM: qmi_client_dms_get_msisdn (..., 5, ...) */
+#define OWN_NUMBERS_TIMEOUT_MS 5000
+
+static void own_numbers_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct qmi_dms_get_msisdn_response res = {};
+
+	modem->own_numbers_busy = false;
+
+	if (!msg || req->ret || qmi_parse_dms_get_msisdn_response(msg, &res)) {
+		/* MM: "couldn't load list of own numbers: ..." and the property stays unset */
+		modem_log(modem, LOGL_DEBUG, "couldn't load list of own numbers: %s",
+			  !msg ? "request failed" : qmi_get_error_str(req->ret));
+		return;
+	}
+
+	talloc_free(modem->own_number);
+	/* MM: numbers[0] = g_strdup (str), a NULL str gives an empty list */
+	modem->own_number = res.data.msisdn && res.data.msisdn[0] ? talloc_strdup(modem, res.data.msisdn) : NULL;
+	modem->own_numbers_loaded = true;
+	modem_log(modem, LOGL_INFO, "own number: %s", modem->own_number ? modem->own_number : "-");
+}
+
+void uqmid_own_numbers_load(struct modem *modem)
+{
+	struct qmi_service *dms = uqmi_service_find(modem->qmi, QMI_SERVICE_DMS);
+	struct qmi_request *req;
+	struct qmi_msg *msg;
+
+	/* MM: loaded only once during the whole lifetime of the modem */
+	if (modem->own_numbers_loaded || modem->own_numbers_busy || !dms)
+		return;
+
+	req = talloc_zero(dms, struct qmi_request);
+	msg = talloc_zero_size(req, 1024);
+	if (qmi_set_dms_get_msisdn_request(msg)) {
+		talloc_free(req);
+		return;
+	}
+
+	req->msg = msg;
+	req->cb = own_numbers_cb;
+	req->cb_data = modem;
+	req->timeout_ms = OWN_NUMBERS_TIMEOUT_MS;
+	modem_log(modem, LOGL_DEBUG, "loading own numbers...");
+	modem->own_numbers_busy = true;
+	/* once queued the callback is called exactly once, also for timeouts and cancels */
+	if (uqmi_service_send_msg(dms, req) && modem->own_numbers_busy) {
+		modem->own_numbers_busy = false;
+		talloc_free(req);
+	}
+}

+/*
+ * uqmid -- SIM objects (ModemManager: org.freedesktop.ModemManager1.Sim)
+ *
+ * ubus object uqmid.modem.<N>.sim.<M>. The semantics of send_pin, send_puk,
+ * enable_pin and change_pin follow mm-base-sim.c and mm-sim-qmi.c:
+ *  - send_pin only if the modem is locked by the SIM PIN, send_puk only if by
+ *    the PUK (wrong-state otherwise),
+ *  - after the request the lock info is updated (the sim fsm runs again). A
+ *    modem which is not locked anymore becomes `disabled`,
+ *  - QMI IncorrectPin is `incorrect-password`, PinBlocked is `sim-puk`
+ *    (MM: reprobe_if_puk_discovered(), the modem is reprobed),
+ *  - the requests are serialized with the other requests of the modem.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <libubus.h>
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "modem_tx.h"
+#include "qmi-enums-uim.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sim_obj.h"
+#include "utils.h"
+#include "ubus.h"
+
+static struct blob_buf b;
+static uint32_t next_sim_index;
+
+/*****************************************************************************/
+/* operations */
+
+struct sim_op {
+	enum sim_op_kind kind;
+	const char *a;
+	const char *b;
+	bool enabled;
+};
+
+static void sim_op_start(struct modem_op *op);
+
+static struct modem_op *sim_current_op(struct modem *modem)
+{
+	struct modem_op *op = modem->cur_op;
+
+	return op && op->type == MODEM_OP_CUSTOM && op->start == sim_op_start ? op : NULL;
+}
+
+static const char *sim_op_what(enum sim_op_kind kind)
+{
+	switch (kind) {
+	case SIM_OP_SEND_PIN: return "verify PIN";
+	case SIM_OP_SEND_PUK: return "unblock PIN";
+	case SIM_OP_ENABLE_PIN: return "enable/disable PIN";
+	case SIM_OP_CHANGE_PIN: return "change PIN";
+	}
+
+	return "?";
+}
+
+/* retries are in the error response of all four requests */
+static void sim_update_retries(struct modem *modem, enum sim_op_kind kind, struct qmi_msg *msg)
+{
+	bool set = false;
+	int verify = 0, unblock = 0;
+
+	if (!msg)
+		return;
+
+	switch (kind) {
+	case SIM_OP_SEND_PIN: {
+		struct qmi_uim_verify_pin_response res = {};
+
+		if (!qmi_parse_uim_verify_pin_response(msg, &res) && res.set.retries_remaining) {
+			set = true;
+			verify = res.data.retries_remaining.verify_retries_left;
+			unblock = res.data.retries_remaining.unblock_retries_left;
+		}
+		break;
+	}
+	case SIM_OP_SEND_PUK: {
+		struct qmi_uim_unblock_pin_response res = {};
+
+		if (!qmi_parse_uim_unblock_pin_response(msg, &res) && res.set.retries_remaining) {
+			set = true;
+			verify = res.data.retries_remaining.verify_retries_left;
+			unblock = res.data.retries_remaining.unblock_retries_left;
+		}
+		break;
+	}
+	case SIM_OP_ENABLE_PIN: {
+		struct qmi_uim_set_pin_protection_response res = {};
+
+		if (!qmi_parse_uim_set_pin_protection_response(msg, &res) && res.set.retries_remaining) {
+			set = true;
+			verify = res.data.retries_remaining.verify_retries_left;
+			unblock = res.data.retries_remaining.unblock_retries_left;
+		}
+		break;
+	}
+	case SIM_OP_CHANGE_PIN: {
+		struct qmi_uim_change_pin_response res = {};
+
+		if (!qmi_parse_uim_change_pin_response(msg, &res) && res.set.retries_remaining) {
+			set = true;
+			verify = res.data.retries_remaining.verify_retries_left;
+			unblock = res.data.retries_remaining.unblock_retries_left;
+		}
+		break;
+	}
+	}
+
+	if (set) {
+		modem->sim.pin_retries = verify;
+		modem->sim.puk_retries = unblock;
+		modem->sim.retries_valid = true;
+	}
+}
+
+/* MM: update_lock_info_ready() / error_for_unlock_check() */
+static void sim_unlock_recheck_cb(struct modem *modem, int result, void *data)
+{
+	struct modem_op *op = sim_current_op(modem);
+	struct sim_op *so;
+
+	if (!op)
+		return;
+
+	so = op->priv;
+	if (so->kind != SIM_OP_SEND_PIN && so->kind != SIM_OP_SEND_PUK) {
+		/* only the retries were refreshed (MM: after_enable_update_lock_info_ready) */
+		uqmid_modem_op_done(op, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	switch (result) {
+	case SIM_RESULT_READY:
+		modem_log(modem, LOGL_NOTICE, "SIM unlocked");
+		uqmid_modem_op_done(op, MODEM_ERR_NONE, NULL);
+		break;
+	case SIM_RESULT_PIN:
+		uqmid_modem_op_done(op, MODEM_ERR_SIM_PIN, "Device is locked: 'sim-pin'");
+		break;
+	case SIM_RESULT_PUK:
+		uqmid_modem_op_done(op, MODEM_ERR_SIM_PUK, "Device is locked: 'sim-puk'");
+		break;
+	default:
+		uqmid_modem_op_done(op, MODEM_ERR_FAILED, "SIM failure after unlock");
+		break;
+	}
+}
+
+static void sim_op_qmi_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct modem_op *op = sim_current_op(modem);
+	struct sim_op *so;
+	enum modem_error err = MODEM_ERR_FAILED;
+	bool reprobe = false;
+	char text[128];
+
+	if (!op)
+		return;
+
+	so = op->priv;
+	if (!msg) {
+		uqmid_modem_op_done(op, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_ABORTED, NULL);
+		return;
+	}
+
+	if (req->ret) {
+		sim_update_retries(modem, so->kind, msg);
+		snprintf(text, sizeof(text), "Couldn't %s: %s", sim_op_what(so->kind), qmi_get_error_str(req->ret));
+
+		switch (req->ret) {
+		case QMI_PROTOCOL_ERROR_INCORRECT_PIN:
+			err = MODEM_ERR_INCORRECT_PASSWORD;
+			if (modem->sim.retries_valid)
+				snprintf(text, sizeof(text), "Couldn't %s: incorrect password (%d PIN, %d PUK retries left)",
+					 sim_op_what(so->kind), modem->sim.pin_retries, modem->sim.puk_retries);
+			break;
+		case QMI_PROTOCOL_ERROR_PIN_BLOCKED:
+			err = so->kind == SIM_OP_SEND_PUK ? MODEM_ERR_FAILED : MODEM_ERR_SIM_PUK;
+			/* MM: reprobe_if_puk_discovered() */
+			reprobe = so->kind != SIM_OP_SEND_PUK;
+			break;
+		case QMI_PROTOCOL_ERROR_PIN_ALWAYS_BLOCKED:
+		case QMI_PROTOCOL_ERROR_NO_SIM:
+			/* MM: handle_send_puk_ready(): SIM might be permanently blocked, reprobe */
+			err = MODEM_ERR_SIM_FAILURE;
+			reprobe = true;
+			break;
+		default:
+			break;
+		}
+
+		modem_log(modem, LOGL_NOTICE, "%s", text);
+		uqmid_modem_op_done(op, err, text);
+		if (reprobe)
+			uqmid_modem_reprobe(modem);
+		return;
+	}
+
+	/* update the lock info (retries, new state); fall back to success if the sim fsm is busy */
+	if (sim_fsm_recheck(modem, sim_unlock_recheck_cb, NULL)) {
+		if (so->kind == SIM_OP_SEND_PIN || so->kind == SIM_OP_SEND_PUK)
+			uqmid_modem_op_done(op, MODEM_ERR_FAILED, "Couldn't update the lock info");
+		else
+			uqmid_modem_op_done(op, MODEM_ERR_NONE, NULL);
+	}
+}
+
+static void sim_op_start(struct modem_op *op)
+{
+	struct modem *modem = op->modem;
+	struct sim_op *so = op->priv;
+	struct qmi_service *uim = uqmi_service_find(modem->qmi, QMI_SERVICE_UIM);
+	QmiUimPinId pin_id = modem->sim.use_upin ? QMI_UIM_PIN_ID_UPIN : QMI_UIM_PIN_ID_PIN1;
+	int ret = -1;
+
+	if (!modem->sim.obj || !uim || !modem->sim.use_uim) {
+		uqmid_modem_op_done(op, MODEM_ERR_UNSUPPORTED, "Operation not supported");
+		return;
+	}
+
+	/* the object only exists for the active SIM, so it is always active */
+
+	switch (so->kind) {
+	case SIM_OP_SEND_PIN:
+		/* MM: Only allow sending SIM-PIN if really SIM-PIN locked */
+		if (modem->mm_state != MODEM_STATE_LOCKED || modem->sim.state != UQMI_SIM_PIN_REQUIRED) {
+			uqmid_modem_op_done(op, MODEM_ERR_WRONG_STATE, "Cannot send PIN: device is not SIM-PIN locked");
+			return;
+		}
+		modem_log(modem, LOGL_INFO, "processing user request to send PIN...");
+		ret = tx_uim_verify_pin(modem, uim, sim_op_qmi_cb, pin_id, (char *)so->a);
+		break;
+	case SIM_OP_SEND_PUK:
+		if (modem->mm_state != MODEM_STATE_LOCKED || modem->sim.state != UQMI_SIM_PUK_REQUIRED) {
+			uqmid_modem_op_done(op, MODEM_ERR_WRONG_STATE, "Cannot send PUK: device is not SIM-PUK locked");
+			return;
+		}
+		modem_log(modem, LOGL_INFO, "processing user request to send PUK...");
+		ret = tx_uim_unblock_pin(modem, uim, sim_op_qmi_cb, pin_id, (char *)so->b, (char *)so->a);
+		break;
+	case SIM_OP_ENABLE_PIN:
+		modem_log(modem, LOGL_INFO, "processing user request to %s PIN...", so->enabled ? "enable" : "disable");
+		ret = tx_uim_set_pin_protection(modem, uim, sim_op_qmi_cb, pin_id, so->enabled, so->a);
+		break;
+	case SIM_OP_CHANGE_PIN:
+		modem_log(modem, LOGL_INFO, "processing user request to change PIN...");
+		ret = tx_uim_change_pin(modem, uim, sim_op_qmi_cb, pin_id, so->a, so->b);
+		break;
+	}
+
+	if (ret)
+		uqmid_modem_op_done(op, MODEM_ERR_FAILED, "Couldn't send the request");
+}
+
+static int sim_op_submit(struct modem *modem, struct ubus_request_data *req, enum sim_op_kind kind, const char *a,
+			 const char *b, bool enabled,
+			 void (*done)(struct modem *modem, enum modem_error err, const char *msg, void *data),
+			 void *data)
+{
+	struct modem_op *op = uqmid_modem_op_alloc(modem, req, sim_op_start);
+	struct sim_op *so;
+
+	if (!op)
+		return -ENOMEM;
+
+	so = talloc_zero(op, struct sim_op);
+	so->kind = kind;
+	so->a = talloc_strdup(so, a);
+	so->b = b ? talloc_strdup(so, b) : NULL;
+	so->enabled = enabled;
+	op->priv = so;
+	if (done)
+		uqmid_modem_op_set_done_cb(op, done, data);
+	uqmid_modem_op_submit(op);
+
+	return 0;
+}
+
+int uqmid_sim_op_submit(struct modem *modem, struct ubus_request_data *req, enum sim_op_kind kind, const char *a,
+			const char *b, bool enabled)
+{
+	return sim_op_submit(modem, req, kind, a, b, enabled, NULL, NULL);
+}
+
+int uqmid_sim_op_submit_internal(struct modem *modem, enum sim_op_kind kind, const char *a, const char *b,
+				 bool enabled,
+				 void (*done)(struct modem *modem, enum modem_error err, const char *msg, void *data),
+				 void *data)
+{
+	return sim_op_submit(modem, NULL, kind, a, b, enabled, done, data);
+}
+
+/*****************************************************************************/
+/* properties */
+
+#define STR(v) ((v) ? (v) : "")
+
+void uqmid_sim_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	bool euicc = modem->sim.active_slot && modem->sim.slots[modem->sim.active_slot - 1].euicc;
+
+	/* the object only exists for the active SIM */
+	blobmsg_add_u8(bb, "active", true);
+	blobmsg_add_string(bb, "sim_identifier", STR(modem->iccid));
+	blobmsg_add_string(bb, "imsi", modem->imsi);
+	blobmsg_add_string(bb, "eid", STR(modem->sim.eid));
+	blobmsg_add_string(bb, "operator_identifier", STR(modem->sim.operator_id));
+	blobmsg_add_string(bb, "operator_name", STR(modem->sim.operator_name));
+	/* MM: QMI modems do not load these, we know eUICCs from the slot status */
+	blobmsg_add_string(bb, "sim_type", euicc ? "esim" : "physical");
+	blobmsg_add_string(bb, "removability", "unknown");
+}
+
+/*****************************************************************************/
+/* ubus */
+
+static int sim_get(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		   const char *method, struct blob_attr *msg)
+{
+	struct sim_object *sim = container_of(obj, struct sim_object, ubus);
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "path", sim->ubus.name);
+	blobmsg_add_u32(&b, "index", sim->index);
+	uqmid_sim_add_properties(sim->modem, &b);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static int sim_submit(struct ubus_request_data *req, struct ubus_object *obj, enum sim_op_kind kind, const char *a,
+		      const char *b_, bool enabled)
+{
+	struct sim_object *sim = container_of(obj, struct sim_object, ubus);
+
+	bool need_b = kind == SIM_OP_SEND_PUK || kind == SIM_OP_CHANGE_PIN;
+
+	if (!a || !*a || (need_b && (!b_ || !*b_)))
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	if (uqmid_sim_op_submit(sim->modem, req, kind, a, b_, enabled))
+		return UBUS_STATUS_UNKNOWN_ERROR;
+
+	/* completed by the operation */
+	return UBUS_STATUS_OK;
+}
+
+enum { SP_PIN, __SP_MAX };
+static const struct blobmsg_policy send_pin_policy[__SP_MAX] = {
+	[SP_PIN] = { .name = "pin", .type = BLOBMSG_TYPE_STRING },
+};
+
+static int sim_send_pin(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			const char *method, struct blob_attr *msg)
+{
+	struct blob_attr *tb[__SP_MAX];
+
+	blobmsg_parse(send_pin_policy, __SP_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[SP_PIN])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	return sim_submit(req, obj, SIM_OP_SEND_PIN, blobmsg_get_string(tb[SP_PIN]), NULL, false);
+}
+
+enum { SK_PUK, SK_PIN, __SK_MAX };
+static const struct blobmsg_policy send_puk_policy[__SK_MAX] = {
+	[SK_PUK] = { .name = "puk", .type = BLOBMSG_TYPE_STRING },
+	[SK_PIN] = { .name = "pin", .type = BLOBMSG_TYPE_STRING },
+};
+
+static int sim_send_puk(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			const char *method, struct blob_attr *msg)
+{
+	struct blob_attr *tb[__SK_MAX];
+
+	blobmsg_parse(send_puk_policy, __SK_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[SK_PUK] || !tb[SK_PIN])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	return sim_submit(req, obj, SIM_OP_SEND_PUK, blobmsg_get_string(tb[SK_PUK]), blobmsg_get_string(tb[SK_PIN]),
+			  false);
+}
+
+enum { EP_PIN, EP_ENABLED, __EP_MAX };
+static const struct blobmsg_policy enable_pin_policy[__EP_MAX] = {
+	[EP_PIN] = { .name = "pin", .type = BLOBMSG_TYPE_STRING },
+	[EP_ENABLED] = { .name = "enabled", .type = BLOBMSG_TYPE_BOOL },
+};
+
+static int sim_enable_pin(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct blob_attr *tb[__EP_MAX];
+
+	blobmsg_parse(enable_pin_policy, __EP_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[EP_PIN] || !tb[EP_ENABLED])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	return sim_submit(req, obj, SIM_OP_ENABLE_PIN, blobmsg_get_string(tb[EP_PIN]), NULL,
+			  blobmsg_get_bool(tb[EP_ENABLED]));
+}
+
+enum { CP_OLD, CP_NEW, __CP_MAX };
+static const struct blobmsg_policy change_pin_policy[__CP_MAX] = {
+	[CP_OLD] = { .name = "old", .type = BLOBMSG_TYPE_STRING },
+	[CP_NEW] = { .name = "new", .type = BLOBMSG_TYPE_STRING },
+};
+
+static int sim_change_pin(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct blob_attr *tb[__CP_MAX];
+
+	blobmsg_parse(change_pin_policy, __CP_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[CP_OLD] || !tb[CP_NEW])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	return sim_submit(req, obj, SIM_OP_CHANGE_PIN, blobmsg_get_string(tb[CP_OLD]), blobmsg_get_string(tb[CP_NEW]),
+			  false);
+}
+
+static struct ubus_method sim_object_methods[] = {
+	UBUS_METHOD_NOARG("get", sim_get),
+	UBUS_METHOD("send_pin", sim_send_pin, send_pin_policy),
+	UBUS_METHOD("send_puk", sim_send_puk, send_puk_policy),
+	UBUS_METHOD("enable_pin", sim_enable_pin, enable_pin_policy),
+	UBUS_METHOD("change_pin", sim_change_pin, change_pin_policy),
+};
+
+static struct ubus_object_type sim_object_type = UBUS_OBJECT_TYPE("uqmid_sim", sim_object_methods);
+
+/* the object appears once the card is known to be there (also when it is locked), like MM's SIM */
+int uqmid_sim_object_ensure(struct modem *modem)
+{
+	struct sim_object *sim;
+	int ret;
+
+	if (modem->sim.obj || !modem->ubus.name)
+		return 0;
+
+	sim = talloc_zero(modem, struct sim_object);
+	sim->modem = modem;
+	sim->index = next_sim_index++;
+	sim->ubus.name = talloc_asprintf(sim, "%s.sim.%u", modem->ubus.name, sim->index);
+	sim->ubus.type = &sim_object_type;
+	sim->ubus.methods = sim_object_methods;
+	sim->ubus.n_methods = ARRAY_SIZE(sim_object_methods);
+
+	ret = ubus_add_object(ubus_ctx, &sim->ubus);
+	if (ret) {
+		LOG_ERROR("failed to publish ubus object '%s' (ret = %d).\n", sim->ubus.name, ret);
+		talloc_free(sim);
+		return ret;
+	}
+
+	modem->sim.obj = sim;
+	modem_log(modem, LOGL_INFO, "added SIM %s", sim->ubus.name);
+	return 0;
+}
+
+void uqmid_sim_object_remove(struct modem *modem)
+{
+	struct sim_object *sim = modem->sim.obj;
+
+	if (!sim)
+		return;
+
+	if (sim->ubus.id)
+		ubus_remove_object(ubus_ctx, &sim->ubus);
+	modem->sim.obj = NULL;
+	talloc_free(sim);
+}
+
+const char *uqmid_sim_path(struct modem *modem)
+{
+	return modem->sim.obj ? modem->sim.obj->ubus.name : "/";
+}

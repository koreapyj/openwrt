+		/* digits everywhere, [A-E] only after the issuer identification number */
+		if (nib > 9 && len < 6)
+			return -EINVAL;
+		out[len++] = hex[nib];
+	}
+	out[len] = 0;
+
+	if (len < 19 || len > 20)
+		return -EINVAL;
+
+	return len;

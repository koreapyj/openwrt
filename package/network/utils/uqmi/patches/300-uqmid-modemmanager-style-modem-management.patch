+void uqmid_add_access_technologies(struct blob_buf *bb, const char *name, uint32_t act)
+{
+	void *a = blobmsg_open_array(bb, name);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(act_names); i++) {
+		if (act & act_names[i].bit)
+			blobmsg_add_string(bb, NULL, act_names[i].name);
+	}
+	if (!act)
+		blobmsg_add_string(bb, NULL, "unknown");
+	blobmsg_close_array(bb, a);
+}

+/* mm_modem_mode_build_string_from_mask() */
+static void mode_mask_str(uint32_t mask, char *out, size_t len)
+{
+	unsigned int i;
+	size_t n = 0;
+
+	out[0] = '\0';
+	if (mask == MM_MODE_ANY) {
+		snprintf(out, len, "any");
+		return;
+	}
+	if (mask == MM_MODE_NONE) {
+		snprintf(out, len, "none");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mode_nicks); i++) {
+		if (!(mask & mode_nicks[i].value))
+			continue;
+		n += snprintf(out + n, n < len ? len - n : 0, "%s%s", n ? ", " : "", mode_nicks[i].nick);
+	}
+}

+
+static void get_cell_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct cell_op *op = req->cb_data;
+	struct modem *modem = op->modem;
+	struct qmi_nas_get_cell_location_info_response res = {};
+	void *a;
+
+	if (!msg || req->ret || qmi_parse_nas_get_cell_location_info_response(msg, &res)) {
+		/* MM: mm_obj_dbg (self, "failed retrieving cell info: %s", error->message) */
+		modem_log(modem, LOGL_DEBUG, "failed retrieving cell info: %d/%s", req->ret,
+			  req->ret == UQMID_ERROR_TIMEOUT ? "timed out" : qmi_get_error_str(req->ret));
+		list_del(&op->list);
+		uqmid_ubus_deferred_done(&op->req, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED,
+					 "Couldn't get cell info", NULL);
+		talloc_free(op);
+		return;
+	}
+
+	blob_buf_init(&b, 0);
+	a = blobmsg_open_array(&b, "cells");
+	build_cells(&res);
+	blobmsg_close_array(&b, a);
+	modem_log(modem, LOGL_DEBUG, "cell info retrieved");
+	list_del(&op->list);
+	uqmid_ubus_deferred_done(&op->req, MODEM_ERR_NONE, NULL, b.head);
+	talloc_free(op);
+}
+
+/** ubus call uqmid.modem.0 get_cell_info */
+static int h_get_cell_info(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			   const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_cell_info *ci = modem->cell_info;
+	struct qmi_service *nas = uqmi_service_find(modem->qmi, QMI_SERVICE_NAS);
+	struct cell_op *op;
+
+	/* MM: no get_cell_info implementation (no NAS client): MM_CORE_ERROR_UNSUPPORTED */
+	if (!ci || !nas)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED,
+					      "Cannot get cell info: operation not supported");
+	/* MM: mm_iface_modem_abort_invocation_if_state_not_reached(ENABLED) */
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE,
+					      modem->mm_state == MODEM_STATE_FAILED ? "Modem is in failed state"
+										    : "Modem is not enabled");
+
+	op = talloc_zero(ci, struct cell_op);
+	if (!op)
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	op->modem = modem;
+	modem_log(modem, LOGL_INFO, "processing user request to retrieve cell info...");
+	list_add_tail(&op->list, &ci->ops);
+	ubus_defer_request(ctx, req, &op->req);
+	if (SEND_REQ(nas, qmi_set_nas_get_cell_location_info_request(_m), get_cell_info_cb, op, CELL_INFO_TIMEOUT_MS)) {
+		list_del(&op->list);
+		uqmid_ubus_deferred_done(&op->req, MODEM_ERR_FAILED, "Couldn't get cell info", NULL);
+		talloc_free(op);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method modem_cell_info_methods[] = {
+	UBUS_METHOD_NOARG("get_cell_info", h_get_cell_info),
+};
+
+const struct ubus_method *uqmid_cell_info_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_cell_info_methods);
+	return modem_cell_info_methods;
+}
+
+void uqmid_cell_info_init(struct modem *modem)
+{
+	struct modem_cell_info *ci = talloc_zero(modem, struct modem_cell_info);
+
+	if (!ci)
+		return;
+	ci->modem = modem;
+	INIT_LIST_HEAD(&ci->ops);
+	modem->cell_info = ci;
+}
+
+/* the modem goes away: the callbacks of the requests in flight are not called, the requests are failed here */
+void uqmid_cell_info_cleanup(struct modem *modem)
+{
+	struct modem_cell_info *ci = modem->cell_info;
+	struct cell_op *op, *tmp;
+
+	if (!ci)
+		return;
+
+	list_for_each_entry_safe(op, tmp, &ci->ops, list) {
+		list_del(&op->list);
+		uqmid_ubus_deferred_done(&op->req, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+		talloc_free(op);
+	}
+}

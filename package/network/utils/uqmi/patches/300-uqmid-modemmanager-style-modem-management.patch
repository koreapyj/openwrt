+static const struct ext_method m_uim_power_off = {
+	.name = "uim_power_off",
+	.service = QMI_SERVICE_UIM,
+	.change = true,
+	.timeout_ms = EXT_UIM_TIMEOUT_MS,
+	.what = "Power off the SIM card",

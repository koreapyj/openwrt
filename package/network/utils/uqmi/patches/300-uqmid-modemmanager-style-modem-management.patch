+/* send a NAS/WDS request: ENC is an expression encoding into _m */
+#define SEND_REQ(svc, ENC, cb, data, tmo) ({					\
+	struct qmi_msg *_m;							\
+	struct qmi_request *_r = uqmi_request_alloc((svc), &_m, (cb), (data), (tmo)); \
+	int _ret = -ENOMEM;							\
+	if (_r) {								\
+		if (ENC) {							\
+			talloc_free(_r);					\
+			_ret = -EINVAL;						\
+		} else {							\
+			_ret = uqmi_service_send_msg((svc), _r);		\
+		}								\
+	}									\
+	_ret;									\
+})

+
+/**
+ * @param device path to the control device. /dev/wwan0qmi0 or /dev/cdc-wdm0
+ * @return 0 on success, -EALREADY if known
+ */
+int
+uqmid_modem_add(const char *device)
+{
+	struct modem *modem;
+	int ret;
+
+	if (shutting_down)
+		return -ESHUTDOWN;
+
+	if (uqmid_modem_find_by_device(device))
+		return -EALREADY;
+
+	modem = talloc_zero(NULL, struct modem);
+	if (!modem)
+		return -ENOMEM;
+
+	modem->index = next_modem_index++;
+	modem->name = talloc_asprintf(modem, "%u", modem->index);
+	modem->device = talloc_strdup(modem, device);
+	if (!modem->name || !modem->device) {
+		ret = -ENOMEM;
+		goto err;
+	}
+	modem->mm_state = MODEM_STATE_UNKNOWN;
+	modem->power_state = MODEM_POWER_UNKNOWN;
+	INIT_LIST_HEAD(&modem->ops);
+	INIT_LIST_HEAD(&modem->bearers);
+	uqmid_ext_init(modem);
+	modem->sub_state = MODEM_STATE_ENABLED;
+	modem->ops_timer.cb = modem_ops_timer_cb;
+	uqmid_3gpp_init(modem);
+	uqmid_voice_init(modem);
+	uqmid_signal_init(modem);
+	uqmid_cell_info_init(modem);
+	uqmid_modes_bands_init(modem);
+	uqmid_profile_manager_init(modem);
+	uqmid_messaging_init(modem);
+	if (!modem->m3gpp || !modem->voice || !modem->messaging || !modem->signal ||
+	    !modem->cell_info) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	ret = wwan_discover(modem);
+	if (ret == -ENODEV) {
+		modem_log(modem, LOGL_ERROR, "%s is not a QMI control port", device);
+		goto err;
+	}
+	if (ret)
+		modem_log(modem, LOGL_ERROR, "Could not find the sysfs device of %s (%d)", device, ret);
+
+	modem->qmi = qmi_device_open(modem, device);
+	if (!modem->qmi) {
+		ret = -errno ? -errno : -EIO;
+		modem_log(modem, LOGL_ERROR, "Could not open %s: %s", device, strerror(-ret));
+		goto err;
+	}
+
+	modem->qmi->error_cb = modem_error_cb;
+	modem->qmi->error_cb_data = modem;
+	modem->qmi->closing_cb = modem_closed_cb;
+	modem->qmi->closing_cb_data = modem;
+	modem->sim.use_uim = true;
+
+	modem->fi = modem_fsm_alloc(modem);
+	modem->sim.fi = sim_fsm_alloc(modem);
+	list_add_tail(&modem->list, &uqmid_modems);
+	if (!modem->fi || !modem->sim.fi) {
+		modem_log(modem, LOGL_ERROR, "Could not allocate modem state machines");
+		uqmid_modem_remove(modem, true);
+		return -ENOMEM;
+	}
+
+	ret = uqmid_ubus_modem_add(modem);
+	if (ret) {
+		/* use the regular teardown, it needs no ubus object */
+		ret = -EIO;
+		uqmid_modem_remove(modem, false);
+		return ret;
+	}
+
+	modem_log(modem, LOGL_INFO, "added modem %s (physdev %s, %u net ports)", device,
+		  modem->physdev ? modem->physdev : "?", modem->n_net_ports);
+	uqmid_ubus_notify_modem_added(modem);
+	modem_fsm_start(modem);
+
+	return 0;
+
+err:
+	if (modem->qmi) {
+		qmi_device_close(modem->qmi, 0);
+		modem->qmi = NULL;
+	}
+
+	talloc_free(modem);
+	return ret;
+}

+int uqmi_sim_decode_eid(const uint8_t *eid, unsigned int n, char *out, size_t out_len)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	unsigned int i;
+
+	if (n != 16 || out_len < 33)
+		return -EINVAL;
+
+	for (i = 0; i < n; i++) {
+		out[i * 2] = hex[eid[i] >> 4];
+		out[i * 2 + 1] = hex[eid[i] & 0xf];
+	}
+	out[32] = 0;
+
+	return 32;
+}

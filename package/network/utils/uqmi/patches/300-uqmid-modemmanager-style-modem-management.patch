+/* the nicks of a mode mask as an array */
+static void add_mode_array(struct blob_buf *bb, const char *name, uint32_t mask)
+{
+	void *a = blobmsg_open_array(bb, name);
+	unsigned int i;
+
+	if (mask == MM_MODE_ANY) {
+		blobmsg_add_string(bb, NULL, "any");
+	} else {
+		for (i = 0; i < ARRAY_SIZE(mode_nicks); i++) {
+			if (mask & mode_nicks[i].value)
+				blobmsg_add_string(bb, NULL, mode_nicks[i].nick);
+		}
+	}
+	blobmsg_close_array(bb, a);
+}
+
+static void add_caps_array(struct blob_buf *bb, const char *name, uint32_t mask)
+{
+	void *a = blobmsg_open_array(bb, name);
+	unsigned int i;
+
+	if (mask == MM_CAP_NONE) {
+		blobmsg_add_string(bb, NULL, "none");
+	} else if (mask == MM_CAP_ANY) {
+		blobmsg_add_string(bb, NULL, "any");
+	} else {
+		for (i = 0; i < ARRAY_SIZE(cap_nicks); i++) {
+			if (mask & cap_nicks[i].value)
+				blobmsg_add_string(bb, NULL, cap_nicks[i].nick);
+		}
+	}
+	blobmsg_close_array(bb, a);
+}
+
+static void add_mode_comb(struct blob_buf *bb, const char *name, uint32_t allowed, uint32_t preferred)
+{
+	void *t = blobmsg_open_table(bb, name);
+	char str[64];
+
+	add_mode_array(bb, "allowed", allowed);
+	mode_mask_str(preferred, str, sizeof(str));
+	blobmsg_add_string(bb, "preferred", str);
+	blobmsg_close_table(bb, t);
+}
+
+static void add_band_array(struct blob_buf *bb, const char *name, const struct band_list *prop)
+{
+	struct band_list bl;
+	void *a = blobmsg_open_array(bb, name);
+	unsigned int i;
+
+	bl_get(prop, &bl);
+	for (i = 0; i < bl.n; i++) {
+		const char *nick = band_nick(bl.v[i]);
+
+		if (nick)
+			blobmsg_add_string(bb, NULL, nick);
+	}
+	blobmsg_close_array(bb, a);
+}
+
+void uqmid_modes_bands_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	struct modem_mb *mb = mbs(modem);
+	unsigned int i;
+	void *a;
+
+	if (!mb)
+		return;
+
+	/* CurrentCapabilities (a list of nicks, "none" until they are loaded) and SupportedCapabilities (a list of the
+	 * combinations, empty until they are loaded) */
+	add_caps_array(bb, "current_capabilities", mb->current_caps);
+	a = blobmsg_open_array(bb, "supported_capabilities");
+	for (i = 0; i < mb->n_supported_caps; i++)
+		add_caps_array(bb, NULL, mb->supported_caps[i]);
+	blobmsg_close_array(bb, a);
+
+	a = blobmsg_open_array(bb, "supported_modes");
+	for (i = 0; i < supported_modes_len(mb); i++) {
+		struct mode_comb c = supported_mode(mb, i);
+
+		add_mode_comb(bb, NULL, c.allowed, c.preferred);
+	}
+	blobmsg_close_array(bb, a);
+	add_mode_comb(bb, "current_modes", mb->current_allowed, mb->current_preferred);
+	add_band_array(bb, "supported_bands", &mb->supported_bands);
+	add_band_array(bb, "current_bands", &mb->current_bands);
+}
+
+bool uqmid_modes_bands_is_3gpp(struct modem *modem)
+{
+	struct modem_mb *mb = mbs(modem);
+
+	return mb && mb->caps_done && is_3gpp(mb);
+}
+
+void uqmid_modes_bands_init(struct modem *modem)
+{
+	struct modem_mb *mb = talloc_zero(modem, struct modem_mb);
+
+	if (!mb)
+		return;
+	mb->modem = modem;
+	/* the defaults of the skeleton */
+	mb->current_allowed = MM_MODE_ANY;
+	mb->current_preferred = MM_MODE_NONE;
+	modem->modes_bands = mb;
+}
+
+/* the modem goes away: the callbacks of the requests in flight are not called, the operations are aborted */
+void uqmid_modes_bands_cleanup(struct modem *modem)
+{
+	struct modem_mb *mb = mbs(modem);
+
+	if (!mb)
+		return;
+
+	mb->waiting_op = NULL;
+	mb->waiting_start = NULL;
+}

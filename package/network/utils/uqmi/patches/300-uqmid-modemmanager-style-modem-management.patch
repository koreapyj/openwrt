+			add_u32("nrarfcn", res->data.nr5g_arfcn);
+		blobmsg_add_double(&b, "rsrp", 0.1 * (double)n->rsrp);
+		blobmsg_add_double(&b, "rsrq", 0.1 * (double)n->rsrq);
+		blobmsg_add_double(&b, "sinr", 0.1 * (double)n->snr);
+		blobmsg_close_table(&b, t);

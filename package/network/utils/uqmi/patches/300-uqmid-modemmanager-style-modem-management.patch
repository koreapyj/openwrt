+const char *reg_state_name(enum reg_state state)
+{
+	switch (state) {
+	case REG_IDLE: return "idle";
+	case REG_HOME: return "home";
+	case REG_SEARCHING: return "searching";
+	case REG_DENIED: return "denied";
+	case REG_UNKNOWN: return "unknown";
+	case REG_ROAMING: return "roaming";
+	case REG_HOME_SMS_ONLY: return "home-sms-only";
+	case REG_ROAMING_SMS_ONLY: return "roaming-sms-only";
+	case REG_EMERGENCY_ONLY: return "emergency-only";
+	case REG_HOME_CSFB_NOT_PREFERRED: return "home-csfb-not-preferred";
+	case REG_ROAMING_CSFB_NOT_PREFERRED: return "roaming-csfb-not-preferred";
+	case REG_ATTACHED_RLOS: return "attached-rlos";
+	}
+
+	return "unknown";
+}
+
+/* mm_modem_3gpp_registration_state_is_registered() */
+bool reg_state_is_registered(enum reg_state state)
+{
+	return state == REG_HOME || state == REG_ROAMING || state == REG_HOME_SMS_ONLY ||
+	       state == REG_ROAMING_SMS_ONLY || state == REG_HOME_CSFB_NOT_PREFERRED ||
+	       state == REG_ROAMING_CSFB_NOT_PREFERRED;
+}
+
+bool reg_state_is_roaming(enum reg_state state)
+{
+	return state == REG_ROAMING || state == REG_ROAMING_SMS_ONLY || state == REG_ROAMING_CSFB_NOT_PREFERRED;
+}

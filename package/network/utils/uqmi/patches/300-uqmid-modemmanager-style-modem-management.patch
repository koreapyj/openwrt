+int tx_uim_refresh_register_file(struct modem *modem, struct qmi_service *uim, request_cb cb, uint16_t file_id,
+				 const uint16_t *path, unsigned int path_n)
+{
+	struct qmi_request *req = talloc_zero(uim, struct qmi_request);
+	struct qmi_msg *msg = talloc_zero_size(req, 1024);
+	struct qmi_uim_refresh_register_request rr = {};
+	uint8_t bytes[6];
+	unsigned int i;
+	/* the generated struct is an anonymous array element type, fill it in place */
+	typeof(*rr.data.info.files) file = {};
+
+	if (path_n * 2 > sizeof(bytes)) {
+		talloc_free(req);
+		return 1;
+	}
+
+	for (i = 0; i < path_n; i++) {
+		bytes[i * 2] = path[i] & 0xff;
+		bytes[i * 2 + 1] = path[i] >> 8;
+	}
+
+	file.file_id = file_id;
+	file.path_n = path_n * 2;
+	file.path = bytes;
+
+	rr.set.session = true;
+	rr.data.session.session_type = QMI_UIM_SESSION_TYPE_PRIMARY_GW_PROVISIONING;
+	rr.set.info = true;
+	rr.data.info.register_flag = true;
+	rr.data.info.vote_for_init = false;
+	rr.data.info.files_n = 1;
+	rr.data.info.files = &file;
+
+	if (qmi_set_uim_refresh_register_request(msg, &rr)) {
+		LOG_ERROR("Failed to encode refresh_register_request");
+		talloc_free(req);
+		return 1;
+	}
+
+	return tx_uim_send(modem, uim, req, msg, cb);

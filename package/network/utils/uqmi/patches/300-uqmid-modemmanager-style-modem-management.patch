+
+static int modem_chg(struct modem *modem, enum modem_fsm_state state, unsigned long secs, int T,
+		     enum modem_state_change_reason reason)
+{
+	enum modem_state old = modem->mm_state;
+	enum modem_state new = modem_fsm_mm_state(state);
+
+	if (!modem->fi)
+		return -ENODEV;
+
+	/* ENABLED is searching or registered if the registration subsystem says so (MM: update_state_internal()) */
+	if (new == MODEM_STATE_ENABLED)
+		new = modem->sub_state;
+
+	if (!(modem->fi->fsm->states[modem->fi->state].out_state_mask & S(state))) {
+		modem_log(modem, LOGL_ERROR, "state %s -> %s not permitted", osmo_fsm_inst_state_name(modem->fi),
+			  modem->fi->fsm->states[state].name);
+		return -EPERM;
+	}
+
+	/*
+	 * Publish the new state before entering it: entering a state may already
+	 * trigger the next change (e.g. a failing request in onenter).
+	 */
+	/* state_failed_reason is only valid in the failed state */
+	if (state != MODEM_ST_FAILED)
+		modem->failed_reason = MODEM_FAILED_REASON_NONE;
+
+	if (old != new) {
+		modem->mm_state = new;
+		modem_log(modem, LOGL_INFO, "state %s -> %s (reason %s)", modem_state_name(old),
+			  modem_state_name(new), modem_change_reason_name(reason));
+		uqmid_ubus_modem_state_changed(modem, old, new, reason);
+	}
+
+	return osmo_fsm_inst_state_chg(modem->fi, state, secs, T);
+}
+
+void modem_fsm_set_mm_state(struct modem *modem, enum modem_state state, enum modem_state_change_reason reason)
+{
+	enum modem_state old = modem->mm_state;
+
+	if (old == state)
+		return;
+
+	modem->mm_state = state;
+	modem_log(modem, LOGL_INFO, "state %s -> %s (reason %s)", modem_state_name(old), modem_state_name(state),
+		  modem_change_reason_name(reason));
+	uqmid_ubus_modem_state_changed(modem, old, state, reason);
+}
+
+int modem_fsm_set_state(struct modem *modem, enum modem_fsm_state state, enum modem_state_change_reason reason)
+{
+	return modem_chg(modem, state, 0, 0, reason);
+}
+
+void modem_fsm_failed(struct modem *modem, enum modem_state_failed_reason reason)
+{
+	if (modem->mm_state == MODEM_STATE_FAILED)
+		return;
+
+	/* set before notifying: the notification contains it */
+	modem->failed_reason = reason;
+	modem_log(modem, LOGL_ERROR, "modem failed (reason %s)", modem_failed_reason_name(reason));
+	modem_chg(modem, MODEM_ST_FAILED, 0, 0, MODEM_CHANGE_REASON_FAILURE);
+}
 

+/*
+ * uqmid -- carrier configuration (read only)
+ *
+ * ModemManager: Modem.CarrierConfiguration / CarrierConfigurationRevision,
+ * mm-shared-qmi.c mm_shared_qmi_load_carrier_config(). The active SOFTWARE
+ * configuration is read with PDC Get Selected Config; its description and
+ * version come with PDC Get Config Info. Both results are delivered as
+ * indications (carrying the token of the request). If no configuration is
+ * selected the modem uses its default one (MM: "default", no revision).
+ *
+ * Deviation: MM lists all configurations first and looks the active one up;
+ * only the active one is queried here (smaller requests, the SMD transport of
+ * the SoC modem drops QMUX messages of 1 KiB and more).
+ *
+ * A failure is not fatal: the properties stay empty.
+ */
+
+#include <string.h>
+
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "modem_tx.h"
+#include "qmi-enums.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sim_obj.h"
+#include "utils.h"
+
+/* MM: LOAD_CARRIER_CONFIG_STEP_TIMEOUT_SECS is 5, the client id has to be allocated first */
+#define CARRIER_CONFIG_TIMEOUT_MS 10000
+/* MM: DEFAULT_CONFIG_DESCRIPTION */
+#define DEFAULT_CONFIG_DESCRIPTION "default"
+#define PDC_ID_MAX 64
+
+enum {
+	PDC_IND_GET_SELECTED_CONFIG = 0x22,
+	PDC_IND_GET_CONFIG_INFO = 0x28,
+};
+
+struct carrier_cfg {
+	struct modem *modem;
+	struct qmi_service *pdc;
+	/* 0: waiting for the selected config, 1: for the config info */
+	int step;
+	uint32_t token;
+	uint8_t id[PDC_ID_MAX];
+	unsigned int id_n;
+	struct uloop_timeout timeout;
+	/* finished, waiting for the deferred teardown */
+	bool done;
+};
+
+static void carrier_config_selected_ind(struct qmi_service *service, struct qmi_msg *msg, void *data);
+static void carrier_config_info_ind(struct qmi_service *service, struct qmi_msg *msg, void *data);
+
+static void carrier_config_end(struct carrier_cfg *cc)
+{
+	struct modem *modem = cc->modem;
+
+	uloop_timeout_cancel(&cc->timeout);
+	uqmi_service_remove_indication(cc->pdc, PDC_IND_GET_SELECTED_CONFIG, carrier_config_selected_ind, cc);
+	uqmi_service_remove_indication(cc->pdc, PDC_IND_GET_CONFIG_INFO, carrier_config_info_ind, cc);
+	modem->carrier_ctx = NULL;
+	talloc_free(cc);
+}
+
+static void carrier_config_finish_cb(struct uloop_timeout *t)
+{
+	carrier_config_end(container_of(t, struct carrier_cfg, timeout));
+}
+
+/*
+ * Finish from within a callback. The indication list of the service is being
+ * walked (uqmi_service_handle_indication() keeps the next entry) so the
+ * indications must not be removed here: both entries of this context may be
+ * in the list and removing the one which is the saved "next" entry crashes the
+ * walk. Tear down from a uloop timeout instead.
+ */
+static void carrier_config_end_later(struct carrier_cfg *cc)
+{
+	cc->done = true;
+	cc->timeout.cb = carrier_config_finish_cb;
+	uloop_timeout_set(&cc->timeout, 0);
+}
+
+static void carrier_config_fail(struct carrier_cfg *cc, const char *why)
+{
+	if (cc->done)
+		return;
+
+	modem_log(cc->modem, LOGL_INFO, "couldn't load the carrier configuration: %s", why);
+	carrier_config_end_later(cc);
+}
+
+static void carrier_config_timeout_cb(struct uloop_timeout *t)
+{
+	struct carrier_cfg *cc = container_of(t, struct carrier_cfg, timeout);
+
+	carrier_config_fail(cc, "operation timed out");
+}
+
+static void carrier_config_req_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct carrier_cfg *cc = modem->carrier_ctx;
+
+	if (!cc || cc->done)
+		return;
+
+	/* the result comes as an indication, only a failed request ends it here */
+	if (!msg || req->ret)
+		carrier_config_fail(cc, qmi_get_error_str(req->ret));
+}
+
+static void carrier_config_selected_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct carrier_cfg *cc = data;
+	struct modem *modem = cc->modem;
+	struct qmi_pdc_get_selected_config_indication res = {};
+
+	if (cc->done || cc->step != 0 || qmi_parse_pdc_get_selected_config_indication(msg, &res))
+		return;
+	if (res.set.token && res.data.token != cc->token)
+		return;
+
+	/* NOT_PROVISIONED: no configs active */
+	if (res.set.indication_result && res.data.indication_result &&
+	    res.data.indication_result != QMI_PROTOCOL_ERROR_NOT_PROVISIONED) {
+		carrier_config_fail(cc, qmi_get_error_str(res.data.indication_result));
+		return;
+	}
+
+	if (!res.data.active_id_n) {
+		modem_log(modem, LOGL_INFO, "no carrier config currently selected (default in use)");
+		talloc_free(modem->carrier_config);
+		modem->carrier_config = talloc_strdup(modem, DEFAULT_CONFIG_DESCRIPTION);
+		carrier_config_end_later(cc);
+		return;
+	}
+
+	if (res.data.active_id_n > PDC_ID_MAX) {
+		carrier_config_fail(cc, "configuration id too long");
+		return;
+	}
+
+	cc->id_n = res.data.active_id_n;
+	memcpy(cc->id, res.data.active_id, cc->id_n);
+	cc->step = 1;
+	cc->token++;
+	uloop_timeout_set(&cc->timeout, CARRIER_CONFIG_TIMEOUT_MS);
+	if (tx_pdc_get_config_info(modem, cc->pdc, carrier_config_req_cb, cc->id, cc->id_n, cc->token))
+		carrier_config_fail(cc, "couldn't request the config info");
+}
+
+static void carrier_config_info_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct carrier_cfg *cc = data;
+	struct modem *modem = cc->modem;
+	struct qmi_pdc_get_config_info_indication res = {};
+
+	if (cc->done || cc->step != 1 || qmi_parse_pdc_get_config_info_indication(msg, &res))
+		return;
+	if (res.set.token && res.data.token != cc->token)
+		return;
+
+	if (res.set.indication_result && res.data.indication_result) {
+		carrier_config_fail(cc, qmi_get_error_str(res.data.indication_result));
+		return;
+	}
+
+	talloc_free(modem->carrier_config);
+	talloc_free(modem->carrier_config_revision);
+	modem->carrier_config = talloc_strdup(modem, res.data.description ? res.data.description : "");
+	modem->carrier_config_revision = res.set.version ? talloc_asprintf(modem, "%08X", res.data.version) : NULL;
+	modem_log(modem, LOGL_INFO, "carrier configuration '%s' revision %s", modem->carrier_config,
+		  modem->carrier_config_revision ? modem->carrier_config_revision : "-");
+	carrier_config_end_later(cc);
+}
+
+void uqmid_carrier_config_load(struct modem *modem)
+{
+	struct qmi_service *pdc = uqmi_service_find(modem->qmi, QMI_SERVICE_PDC);
+	struct carrier_cfg *cc;
+
+	if (!pdc) {
+		modem_log(modem, LOGL_DEBUG, "PDC not supported, no carrier configuration");
+		return;
+	}
+
+	if (modem->carrier_ctx)
+		return;
+
+	cc = talloc_zero(modem, struct carrier_cfg);
+	cc->modem = modem;
+	cc->pdc = pdc;
+	cc->token = 1;
+	cc->timeout.cb = carrier_config_timeout_cb;
+	modem->carrier_ctx = cc;
+
+	uqmi_service_register_indication(pdc, PDC_IND_GET_SELECTED_CONFIG, carrier_config_selected_ind, cc);
+	uqmi_service_register_indication(pdc, PDC_IND_GET_CONFIG_INFO, carrier_config_info_ind, cc);
+	uloop_timeout_set(&cc->timeout, CARRIER_CONFIG_TIMEOUT_MS);
+	if (tx_pdc_get_selected_config(modem, pdc, carrier_config_req_cb, cc->token))
+		carrier_config_fail(cc, "couldn't request the selected config");
+}
+
+void uqmid_carrier_config_cancel(struct modem *modem)
+{
+	if (modem->carrier_ctx)
+		carrier_config_end(modem->carrier_ctx);
+}

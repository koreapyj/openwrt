+
+struct modem_pm {
+	struct modem *modem;
+	/* the support check was started / the profile manager is supported (the interface is exported) */
+	bool checked;
+	bool supported;
+	/* MM: priv->apn_type_not_supported */
+	bool apn_type_not_supported;
+
+	/* the unsolicited events */
+	bool events_setup;
+	bool events_enabled;
+	struct qmi_service *ind_pdc;
+	struct qmi_service *ind_wds;
+
+	/* the Updated signal */

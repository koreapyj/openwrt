+void uqmid_profile_manager_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	struct modem_pm *pm = pm_of(modem);
+
+	/* MM: IndexField, "profile-id" for QMI */
+	if (pm && pm->supported)
+		blobmsg_add_string(bb, "profile_manager_index_field", "profile_id");
+}
+
+/*****************************************************************************/
+/* initialization: the support check */
+
+static void check_support_cb(struct modem_pm *pm, enum modem_error err, const char *msg,
+			     struct pm_profile **profiles, unsigned int n, void *data)
+{
+	if (err) {
+		/* This error shouldn't be treated as critical */
+		modem_log(pm->modem, LOGL_DEBUG, "profile management support check failed: couldn't load profile list: %s",
+			  msg);
+		return;
+	}
+
+	/* profile management is supported! The index field is "profile-id" (the default). */
+	pm->supported = true;
+	modem_log(pm->modem, LOGL_DEBUG, "profile management is supported (%u profiles)", n);
+}
+
+void uqmid_profile_manager_check_support(struct modem *modem)
+{
+	struct modem_pm *pm = pm_of(modem);
+
+	if (!pm || pm->checked || modem->dying)
+		return;
+
+	/* MM: only for 3GPP modems */
+	if (!uqmid_modes_bands_is_3gpp(modem))
+		return;
+
+	/* Set the checked flag so that we don't run it again. Initially, assume we don't support it. */
+	pm->checked = true;
+	pm->supported = false;
+
+	/* There is no explicit check support for the QMI profile management feature: try to query the list. */
+	list_profiles(pm, check_support_cb, NULL);
+}
+
+/*****************************************************************************/
+/* the unsolicited events (modem_3gpp_profile_manager_*_unsolicited_events()) */
+
+struct pm_events {
+	struct modem_pm *pm;
+	bool enable;
+	int step;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+};
+
+enum {
+	EV_FIRST,
+	EV_PROFILE_REFRESH,
+	EV_PROFILE_CHANGE,
+	EV_CONFIGURE_PROFILE_EVENT,
+	EV_LAST,
+};
+
+static void events_step(struct pm_events *ev);
+
+static void events_finish(struct pm_events *ev, const char *err)
+{
+	struct modem_pm *pm = ev->pm;
+	struct modem *modem = pm->modem;
+	void (*done)(struct modem *modem, void *data) = ev->done;
+	void *data = ev->data;
+
+	if (err)
+		/* This error shouldn't be treated as critical */
+		modem_log(modem, LOGL_DEBUG, "couldn't %s unsolicited profile management events: %s",
+			  ev->enable ? "enable" : "disable", err);
+	talloc_free(ev);
+	done(modem, data);
+}
+
+static void events_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct pm_events *ev = req->cb_data;
+	char err[200];
+
+	if (!msg || req->ret) {
+		pm_qmi_err(err, sizeof(err), "", msg, req);
+		events_finish(ev, err);
+		return;
+	}
+
+	ev->step++;
+	events_step(ev);
+}
+
+static void events_step(struct pm_events *ev)
+{
+	struct modem_pm *pm = ev->pm;
+	struct modem *modem = pm->modem;
+	struct qmi_service *pdc = uqmi_service_find(modem->qmi, QMI_SERVICE_PDC);
+	struct qmi_service *wds = pm_wds(pm);
+
+	if (pdc && !uqmi_service_valid(modem->qmi, pdc))
+		pdc = NULL;
+
+	switch (ev->step) {
+	case EV_FIRST:
+		ev->step++;
+		/* fall through */
+
+	case EV_PROFILE_REFRESH:
+		if (pdc) {
+			struct qmi_pdc_register_request rr = {};
+
+			qmi_set(&rr, enable_reporting, ev->enable);
+			if (SEND_REQ(pdc, qmi_set_pdc_register_request(_m, &rr), events_cb, ev, EVENTS_TIMEOUT_MS))
+				events_finish(ev, "couldn't send the PDC register request");
+			return;
+		}
+		ev->step++;
+		/* fall through */
+
+	case EV_PROFILE_CHANGE:
+		if (wds) {
+			struct qmi_wds_indication_register_request ir = {};
+
+			qmi_set(&ir, report_profile_changes, ev->enable);
+			if (SEND_REQ(wds, qmi_set_wds_indication_register_request(_m, &ir), events_cb, ev,
+				     EVENTS_TIMEOUT_MS))
+				events_finish(ev, "couldn't send the WDS indication register request");
+			return;
+		}
+		ev->step++;
+		/* fall through */
+
+	case EV_CONFIGURE_PROFILE_EVENT:
+		if (wds) {
+			struct qmi_wds_configure_profile_event_list_request cr = {};
+			struct {
+				uint8_t profile_type;
+				uint8_t profile_index;
+			} element = { PROFILE_TYPE_ALL, 0xFF };
+
+			/* like MM, also when disabling */
+			cr.data._register_n = 1;
+			cr.data._register = (void *)&element;
+			if (SEND_REQ(wds, qmi_set_wds_configure_profile_event_list_request(_m, &cr), events_cb, ev,
+				     EVENTS_TIMEOUT_MS))
+				events_finish(ev, "couldn't send the WDS configure profile event list request");
+			return;
+		}
+		ev->step++;
+		/* fall through */
+
+	case EV_LAST:
+		pm->events_enabled = ev->enable;
+		modem_log(modem, LOGL_DEBUG, "%s for refresh events", ev->enable ? "registered" : "unregistered");
+		events_finish(ev, NULL);
+		return;
+
+	default:
+		break;
+	}
+}
+
+/* common_enable_disable_unsolicited_events_3gpp_profile_manager() */
+static void events_enable_disable(struct modem_pm *pm, bool enable,
+				  void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem *modem = pm->modem;
+	struct qmi_service *pdc = uqmi_service_find(modem->qmi, QMI_SERVICE_PDC);
+	struct qmi_service *wds = pm_wds(pm);
+	struct pm_events *ev;
+
+	if (enable == pm->events_enabled) {
+		modem_log(modem, LOGL_DEBUG, "profile manager unsolicited events already %s; skipping",
+			  enable ? "enabled" : "disabled");
+		done(modem, data);
+		return;
+	}
+
+	/* Fail if none of the clients can be allocated */
+	if (!pdc && !wds) {
+		modem_log(modem, LOGL_DEBUG, "couldn't %s unsolicited profile management events: No support for profile refresh events",
+			  enable ? "enable" : "disable");
+		done(modem, data);
+		return;
+	}
+
+	ev = talloc_zero(pm, struct pm_events);
+	ev->pm = pm;
+	ev->enable = enable;
+	ev->done = done;
+	ev->data = data;
+	ev->step = EV_FIRST;
+	events_step(ev);
+}
+
+/* common_setup_cleanup_unsolicited_events_3gpp_profile_manager() */
+static void events_setup_cleanup(struct modem_pm *pm, bool enable)
+{
+	struct modem *modem = pm->modem;
+	struct qmi_service *pdc = uqmi_service_find(modem->qmi, QMI_SERVICE_PDC);
+	struct qmi_service *wds = pm_wds(pm);
+
+	if (enable) {
+		/* both clients are required (mm_shared_qmi_ensure_client()) */
+		if (!pdc || !wds) {
+			modem_log(modem, LOGL_DEBUG,
+				  "couldn't setup unsolicited profile management events: Couldn't find client for service '%s'",
+				  pdc ? "wds" : "pdc");
+			return;
+		}
+		if (pm->events_setup) {
+			modem_log(modem, LOGL_DEBUG, "profile manager unsolicited events already set up; skipping");
+			return;
+		}
+
+		pm->events_setup = true;
+		pm->ind_pdc = pdc;
+		pm->ind_wds = wds;
+		uqmi_service_register_indication(pdc, PDC_IND_REFRESH, pdc_refresh_ind, pm);
+		uqmi_service_register_indication(wds, WDS_IND_PROFILE_CHANGED, wds_profile_changed_ind, pm);
+		modem_log(modem, LOGL_DEBUG, "set up profile events handler");
+		return;
+	}
+
+	if (!pm->events_setup) {
+		modem_log(modem, LOGL_DEBUG, "profile manager unsolicited events already cleaned up; skipping");
+		return;
+	}
+
+	pm->events_setup = false;
+	if (pm->ind_pdc && uqmi_service_valid(modem->qmi, pm->ind_pdc))
+		uqmi_service_remove_indication(pm->ind_pdc, PDC_IND_REFRESH, pdc_refresh_ind, pm);
+	if (pm->ind_wds && uqmi_service_valid(modem->qmi, pm->ind_wds))
+		uqmi_service_remove_indication(pm->ind_wds, WDS_IND_PROFILE_CHANGED, wds_profile_changed_ind, pm);
+	pm->ind_pdc = pm->ind_wds = NULL;
+	modem_log(modem, LOGL_DEBUG, "cleaned up profile events handler");
+}
+
+struct pm_disable {
+	struct modem_pm *pm;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+};
+
+/* mm_iface_modem_3gpp_profile_manager_enable(): setup, then enable (errors are not critical) */
+void uqmid_profile_manager_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_pm *pm = pm_of(modem);
+
+	/* MM: only if the interface is exported */
+	if (!pm || !pm->supported) {
+		done(modem, data);
+		return;
+	}
+
+	events_setup_cleanup(pm, true);
+	events_enable_disable(pm, true, done, data);
+}
+
+static void pm_disable_events_done(struct modem *modem, void *data)
+{
+	struct pm_disable *pd = data;
+	struct modem_pm *pm = pd->pm;
+	void (*done)(struct modem *modem, void *data) = pd->done;
+	void *done_data = pd->data;
+
+	talloc_free(pd);
+
+	/* DISABLING_STEP_CLEANUP_UNSOLICITED_EVENTS */
+	events_setup_cleanup(pm, false);
+	done(modem, done_data);
+}
+
+/* mm_iface_modem_3gpp_profile_manager_disable(): disable, then cleanup */
+void uqmid_profile_manager_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_pm *pm = pm_of(modem);
+	struct pm_disable *pd;
+
+	if (!pm || !pm->supported) {
+		done(modem, data);
+		return;
+	}
+
+	pd = talloc_zero(pm, struct pm_disable);
+	pd->pm = pm;
+	pd->done = done;
+	pd->data = data;
+	events_enable_disable(pm, false, pm_disable_events_done, pd);
+}
+
+/*****************************************************************************/
+/* life cycle */
+
+void uqmid_profile_manager_init(struct modem *modem)
+{
+	struct modem_pm *pm = talloc_zero(modem, struct modem_pm);
+
+	if (!pm)
+		return;
+
+	pm->modem = modem;
+	pm->updated_timer.cb = pm_updated_timer_cb;
+	INIT_LIST_HEAD(&pm->delays);
+	INIT_LIST_HEAD(&pm->reqs);
+	modem->profile_manager = pm;
+}
+
+/* the modem goes away: the requests in flight are not answered by QMI anymore */
+void uqmid_profile_manager_cleanup(struct modem *modem)
+{
+	struct modem_pm *pm = pm_of(modem);
+	struct pm_req *rq, *tmp;
+	struct pm_delay *d, *dtmp;
+
+	if (!pm)
+		return;
+
+	uloop_timeout_cancel(&pm->updated_timer);
+	list_for_each_entry_safe(d, dtmp, &pm->delays, list) {
+		uloop_timeout_cancel(&d->timer);
+		list_del(&d->list);
+		talloc_free(d);
+	}
+	list_for_each_entry_safe(rq, tmp, &pm->reqs, list)
+		req_done(rq, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+	if (pm->events_setup)
+		events_setup_cleanup(pm, false);
+}

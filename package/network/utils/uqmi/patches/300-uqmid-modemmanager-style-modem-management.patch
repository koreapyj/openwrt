+/* syslog logging of uqmid, see logging.h */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include <syslog.h>
+#include <unistd.h>
+#include <libubox/ulog.h>
+
+#include "osmocom/logging.h"
+#include "log.h"
+
+static int log_level = LOGL_INFO;
+
+void uqmid_log_init(int level)
+{
+	int channels = ULOG_SYSLOG;
+
+	/* also log to the terminal if started by hand */
+	if (isatty(STDERR_FILENO))
+		channels |= ULOG_STDIO;
+
+	log_level = level;
+	ulog_open(channels, LOG_DAEMON, "uqmid");
+	ulog_threshold(LOG_DEBUG);
+}
+
+int uqmid_log_parse_level(const char *name)
+{
+	if (!strcasecmp(name, "err") || !strcasecmp(name, "error"))
+		return LOGL_ERROR;
+	if (!strcasecmp(name, "warn") || !strcasecmp(name, "warning") || !strcasecmp(name, "notice"))
+		return LOGL_NOTICE;
+	if (!strcasecmp(name, "info"))
+		return LOGL_INFO;
+	if (!strcasecmp(name, "debug"))
+		return LOGL_DEBUG;
+
+	return -1;
+}
+
+bool uqmid_log_enabled(int level)
+{
+	return level >= log_level;
+}
+
+void uqmid_log(int level, const char *fmt, ...)
+{
+	char buf[1024];
+	va_list ap;
+	int prio, len;
+
+	if (level < log_level)
+		return;
+
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+
+	/* the osmocom fsm code ends its messages with a newline */
+	len = strlen(buf);
+	while (len > 0 && buf[len - 1] == '\n')
+		buf[--len] = 0;
+
+	if (level >= LOGL_FATAL)
+		prio = LOG_CRIT;
+	else if (level >= LOGL_ERROR)
+		prio = LOG_ERR;
+	else if (level >= LOGL_NOTICE)
+		prio = LOG_NOTICE;
+	else if (level >= LOGL_INFO)
+		prio = LOG_INFO;
+	else
+		prio = LOG_DEBUG;
+
+	ulog(prio, "%s\n", buf);
+}

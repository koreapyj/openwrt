+/* the qmi device died (e.g. the port was removed) */
+static void modem_error_cb(struct qmi_dev *dev, void *data)
+{
+	struct modem *modem = data;
+
+	modem_log(modem, LOGL_ERROR, "Modem connection died.");
+	uqmid_modem_remove(modem, false);

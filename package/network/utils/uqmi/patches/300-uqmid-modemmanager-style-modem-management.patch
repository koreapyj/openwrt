+static enum modem_state modem_fsm_mm_state(enum modem_fsm_state state)
+{
+	switch (state) {
+	case MODEM_ST_IDLE:
+		return MODEM_STATE_UNKNOWN;
+	case MODEM_ST_RESYNC:

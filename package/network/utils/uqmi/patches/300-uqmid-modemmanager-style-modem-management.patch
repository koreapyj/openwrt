+static int enc_apdu(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_uim_send_apdu_request req = {
+		QMI_INIT(slot, a->slot),
+		QMI_INIT_ARRAY(apdu, a->apdu, a->apdu_n),
+	};
+
+	/* without a channel id the modem decides (the CLI sends 255 if --uim-channel-id is not given) */
+	if (a->has_channel)
+		qmi_set(&req, channel_id, a->channel_id);
+	return qmi_set_uim_send_apdu_request(msg, &req);
+}
+
+static int res_apdu(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_uim_send_apdu_response res = {};
+	char *str;
+	unsigned int i;
+
+	if (qmi_parse_uim_send_apdu_response(msg, &res))
+		return -1;
+	str = blobmsg_alloc_string_buffer(bb, "response", res.data.apdu_response_n * 2 + 1);
+	if (!str)
+		return -1;
+	for (i = 0; i < res.data.apdu_response_n; i++)
+		str += sprintf(str, "%02x", res.data.apdu_response[i]);
+	blobmsg_add_string_buffer(bb);
+	return 0;
+}

+	if (ext_parse_channel(tb[U_AID], true, a, err))
+		return -1;
+	return ext_parse_slot(modem, tb[U_SLOT], false, a, err);
+}
+
+static int enc_channel_close(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_uim_logical_channel_request req = {
+		QMI_INIT(slot, a->slot),
+		QMI_INIT(channel_id, a->channel_id),
+	};

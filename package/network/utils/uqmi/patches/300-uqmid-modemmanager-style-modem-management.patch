+/*****************************************************************************/
+/* nicks */
+
+struct nick {
+	uint32_t value;
+	const char *name;
+};
+
+/* MMBearerIpFamily */
+static const struct nick ip_nicks[] = {
+	{ IPF_IPV4, "ipv4" }, { IPF_IPV6, "ipv6" }, { IPF_IPV4V6, "ipv4v6" }, { IPF_NON_IP, "non-ip" },
+};
+
+/* MMBearerAllowedAuth */
+static const struct nick auth_nicks[] = {
+	{ AUTH_NONE, "none" }, { AUTH_PAP, "pap" }, { AUTH_CHAP, "chap" }, { 1U << 3, "mschap" },
+	{ 1U << 4, "mschapv2" }, { 1U << 5, "eap" },
+};
+
+/* MMBearerApnType */
+static const struct nick apn_nicks[] = {
+	{ APN_INITIAL, "initial" }, { APN_DEFAULT, "default" }, { APN_IMS, "ims" }, { APN_MMS, "mms" },
+	{ APN_MANAGEMENT, "management" }, { 1U << 5, "voice" }, { APN_EMERGENCY, "emergency" },
+	{ 1U << 7, "private" }, { 1U << 8, "purchase" }, { 1U << 9, "video-share" }, { 1U << 10, "local" },
+	{ 1U << 11, "app" }, { 1U << 12, "xcap" }, { APN_TETHERING, "tethering" },
+};
+
+/* MMBearerRoamingAllowance */
+static const struct nick roaming_nicks[] = {
+	{ 1U << 0, "home" }, { 1U << 1, "partner" }, { 1U << 2, "non-partner" },
+};
+
+/* MMBearerAccessTypePreference */
+static const struct nick access_nicks[] = {
+	{ 1, "3gpp-only" }, { 2, "3gpp-preferred" }, { 3, "non-3gpp-only" },
+};
+
+/* MMBearerProfileSource */
+static const struct nick source_nicks[] = {
+	{ 1, "admin" }, { 2, "user" }, { 3, "operator" }, { 4, "modem" }, { 5, "device" },
+};
+
+static bool nick_find(const struct nick *tbl, unsigned int n, const char *name, uint32_t *value)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (!strcasecmp(tbl[i].name, name)) {
+			*value = tbl[i].value;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+/*
+ * A mask: a nick, a list of nicks separated by '|' or ',' or an array of nicks. "none" and "unknown" are no bits,
+ * "any" (ip_type only) is all bits.
+ */
+static bool mask_parse_one(const struct nick *tbl, unsigned int n, bool any, const char *str, uint32_t *mask)
+{
+	char buf[64], *tok, *save;
+	uint32_t v;
+
+	snprintf(buf, sizeof(buf), "%s", str);
+	for (tok = strtok_r(buf, "|, ", &save); tok; tok = strtok_r(NULL, "|, ", &save)) {
+		if (!strcasecmp(tok, "none") || !strcasecmp(tok, "unknown"))
+			continue;
+		if (any && !strcasecmp(tok, "any")) {
+			*mask = IPF_ANY;
+			continue;
+		}
+		if (!nick_find(tbl, n, tok, &v))
+			return false;
+		*mask |= v;
+	}
+
+	return true;
+}
+
+static bool mask_parse(const struct nick *tbl, unsigned int n, bool any, struct blob_attr *attr, uint32_t *mask)
+{
+	struct blob_attr *cur;
+	int rem;
+
+	*mask = 0;
+	if (blobmsg_type(attr) == BLOBMSG_TYPE_STRING)
+		return mask_parse_one(tbl, n, any, blobmsg_get_string(attr), mask);
+	if (blobmsg_type(attr) != BLOBMSG_TYPE_ARRAY)
+		return false;
+	blobmsg_for_each_attr(cur, attr, rem) {
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || !mask_parse_one(tbl, n, any, blobmsg_get_string(cur), mask))
+			return false;
+	}
+
+	return true;
+}
+
+static bool enum_parse(const struct nick *tbl, unsigned int n, struct blob_attr *attr, uint32_t *value)
+{
+	const char *str;
+
+	if (blobmsg_type(attr) != BLOBMSG_TYPE_STRING)
+		return false;
+	str = blobmsg_get_string(attr);
+	if (!strcasecmp(str, "none") || !strcasecmp(str, "unknown")) {
+		*value = 0;
+		return true;
+	}
+
+	return nick_find(tbl, n, str, value);
+}
+
+static void mask_add(struct blob_buf *bb, const char *name, const struct nick *tbl, unsigned int n, uint32_t mask)
+{
+	void *a = blobmsg_open_array(bb, name);
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (mask & tbl[i].value)
+			blobmsg_add_string(bb, NULL, tbl[i].name);
+	}
+	blobmsg_close_array(bb, a);
+}
+
+static void enum_add(struct blob_buf *bb, const char *name, const struct nick *tbl, unsigned int n, uint32_t value)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (tbl[i].value == value) {
+			blobmsg_add_string(bb, name, tbl[i].name);
+			return;
+		}
+	}
+}
+
+/* the ip type is a string for a single family, an array otherwise */
+static void ip_type_add(struct blob_buf *bb, const char *name, uint32_t mask)
+{
+	unsigned int i, bits = 0;
+
+	if (mask == IPF_ANY) {
+		blobmsg_add_string(bb, name, "any");
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(ip_nicks); i++)
+		bits += !!(mask & ip_nicks[i].value);
+	if (bits == 1) {
+		for (i = 0; i < ARRAY_SIZE(ip_nicks); i++) {
+			if (mask & ip_nicks[i].value)
+				blobmsg_add_string(bb, name, ip_nicks[i].name);
+		}
+		return;
+	}
+	mask_add(bb, name, ip_nicks, ARRAY_SIZE(ip_nicks), mask);
+}
+
+/*****************************************************************************/
+/* the profile (mm-3gpp-profile.c) */
+
+static struct pm_profile *profile_new(void *ctx)
+{
+	struct pm_profile *p = talloc_zero(ctx, struct pm_profile);
+
+	if (!p)
+		return NULL;
+
+	/* mm_3gpp_profile_init(): some defaults */
+	p->id = PROFILE_ID_UNKNOWN;
+	p->enabled = true;
+
+	return p;
+}
+
+static void profile_set_str(struct pm_profile *p, char **dst, const char *value)
+{
+	TALLOC_FREE(*dst);
+	if (value)
+		*dst = talloc_strdup(p, value);
+}
+
+/* mm_3gpp_profile_get_dictionary() */
+static void profile_add(struct blob_buf *bb, const char *name, const struct pm_profile *p)
+{
+	void *t = blobmsg_open_table(bb, name);
+
+	blobmsg_add_u32(bb, "profile_id", (uint32_t)p->id);
+	if (p->name)
+		blobmsg_add_string(bb, "profile_name", p->name);
+	if (p->apn)
+		blobmsg_add_string(bb, "apn", p->apn);
+	if (p->allowed_auth != AUTH_UNKNOWN)
+		mask_add(bb, "allowed_auth", auth_nicks, ARRAY_SIZE(auth_nicks), p->allowed_auth);
+	if (p->user)
+		blobmsg_add_string(bb, "user", p->user);
+	if (p->password)
+		blobmsg_add_string(bb, "password", p->password);
+	if (p->ip_type != IPF_NONE)
+		ip_type_add(bb, "ip_type", p->ip_type);
+	if (p->apn_type)
+		mask_add(bb, "apn_type", apn_nicks, ARRAY_SIZE(apn_nicks), p->apn_type);
+	if (p->access_pref)
+		enum_add(bb, "access_type_preference", access_nicks, ARRAY_SIZE(access_nicks), p->access_pref);
+	if (p->source)
+		enum_add(bb, "profile_source", source_nicks, ARRAY_SIZE(source_nicks), p->source);
+	if (p->roaming)
+		mask_add(bb, "roaming_allowance", roaming_nicks, ARRAY_SIZE(roaming_nicks), p->roaming);
+	if (p->enabled_set)
+		blobmsg_add_u8(bb, "profile_enabled", p->enabled);
+	if (p->pcscf_using_pco_set)
+		blobmsg_add_u8(bb, "pcscf_using_pco", p->pcscf_using_pco);
+	if (p->im_cn_set)
+		blobmsg_add_u8(bb, "im_cn", p->im_cn);
+	blobmsg_close_table(bb, t);
+}
+
+static bool int_get(struct blob_attr *attr, int64_t *value)
+{
+	switch (blobmsg_type(attr)) {
+	case BLOBMSG_TYPE_INT8:
+		*value = blobmsg_get_u8(attr);
+		return true;
+	case BLOBMSG_TYPE_INT16:
+		*value = (int16_t)blobmsg_get_u16(attr);
+		return true;
+	case BLOBMSG_TYPE_INT32:
+		*value = (int32_t)blobmsg_get_u32(attr);
+		return true;
+	case BLOBMSG_TYPE_INT64:
+		*value = (int64_t)blobmsg_get_u64(attr);
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* mm_3gpp_profile_new_from_dictionary(): the invalid-args message or NULL */
+static const char *profile_parse(struct pm_profile *p, struct blob_attr *tbl, char *err, size_t len)
+{
+	struct blob_attr *cur;
+	int rem;
+
+	blobmsg_for_each_attr(cur, tbl, rem) {
+		const char *key = blobmsg_name(cur);
+		int64_t v;
+		uint32_t u;
+		bool ok;
+
+		if (!strcmp(key, "profile_id")) {
+			ok = int_get(cur, &v) && v >= INT32_MIN && v <= INT32_MAX;
+			if (ok)
+				p->id = v;
+		} else if (!strcmp(key, "profile_name")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_STRING;
+			if (ok)
+				profile_set_str(p, &p->name, blobmsg_get_string(cur));
+		} else if (!strcmp(key, "apn")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_STRING;
+			if (ok)
+				profile_set_str(p, &p->apn, blobmsg_get_string(cur));
+		} else if (!strcmp(key, "allowed_auth")) {
+			ok = mask_parse(auth_nicks, ARRAY_SIZE(auth_nicks), false, cur, &u);
+			if (ok)
+				p->allowed_auth = u;
+		} else if (!strcmp(key, "user")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_STRING;
+			if (ok)
+				profile_set_str(p, &p->user, blobmsg_get_string(cur));
+		} else if (!strcmp(key, "password")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_STRING;
+			if (ok)
+				profile_set_str(p, &p->password, blobmsg_get_string(cur));
+		} else if (!strcmp(key, "ip_type")) {
+			ok = mask_parse(ip_nicks, ARRAY_SIZE(ip_nicks), true, cur, &u);
+			if (ok)
+				p->ip_type = u;
+		} else if (!strcmp(key, "apn_type")) {
+			ok = mask_parse(apn_nicks, ARRAY_SIZE(apn_nicks), false, cur, &u);
+			if (ok)
+				p->apn_type = u;
+		} else if (!strcmp(key, "access_type_preference")) {
+			ok = enum_parse(access_nicks, ARRAY_SIZE(access_nicks), cur, &u);
+			if (ok)
+				p->access_pref = u;
+		} else if (!strcmp(key, "profile_enabled")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_BOOL;
+			if (ok) {
+				p->enabled = blobmsg_get_bool(cur);
+				p->enabled_set = true;
+			}
+		} else if (!strcmp(key, "pcscf_using_pco")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_BOOL;
+			if (ok) {
+				p->pcscf_using_pco = blobmsg_get_bool(cur);
+				p->pcscf_using_pco_set = true;
+			}
+		} else if (!strcmp(key, "im_cn")) {
+			ok = blobmsg_type(cur) == BLOBMSG_TYPE_BOOL;
+			if (ok) {
+				p->im_cn = blobmsg_get_bool(cur);
+				p->im_cn_set = true;
+			}
+		} else if (!strcmp(key, "profile_source")) {
+			ok = enum_parse(source_nicks, ARRAY_SIZE(source_nicks), cur, &u);
+			if (ok)
+				p->source = u;
+		} else if (!strcmp(key, "roaming_allowance")) {
+			ok = mask_parse(roaming_nicks, ARRAY_SIZE(roaming_nicks), false, cur, &u);
+			if (ok)
+				p->roaming = u;
+		} else {
+			/* mm_3gpp_profile_consume_variant() */
+			snprintf(err, len, "Invalid self dictionary, unexpected key '%.40s'", key);
+			return err;
+		}
+
+		if (!ok) {
+			snprintf(err, len, "Invalid value for '%.40s'", key);
+			return err;
+		}
+	}
+
+	return NULL;
+}
+
+static bool str_eq(const char *a, const char *b)
+{
+	/* cmp_str(): strict match, NULL and the empty string are equal */
+	return (!a && !b) || (a && b && !strcmp(a, b)) || (!a && !b[0]) || (!b && !a[0]);
+}
+
+/*
+ * mm_3gpp_profile_cmp() with the flags of the QMI check_format (no access type preference, no roaming allowance, no
+ * profile source) and the default APN comparison. MM compares the profile names by pointer (a->priv->profile_name !=
+ * b->priv->profile_name): the names are equal only if neither has one.
+ */
+static bool profile_cmp(const struct pm_profile *a, const struct pm_profile *b)
+{
+	if (!str_eq(a->apn, b->apn))
+		return false;
+	if (a->ip_type != b->ip_type)
+		return false;
+	if (a->id != b->id)
+		return false;
+	if (a->allowed_auth != b->allowed_auth || !str_eq(a->user, b->user) || !str_eq(a->password, b->password))
+		return false;
+	if (a->apn_type != b->apn_type)
+		return false;
+	if (a->name || b->name)
+		return false;
+	if (a->enabled != b->enabled || a->enabled_set != b->enabled_set)
+		return false;
+	/* uqmid extension: only a flag which was given (in b, the requested profile) must be the one of the profile */
+	if (b->pcscf_using_pco_set && (!a->pcscf_using_pco_set || a->pcscf_using_pco != b->pcscf_using_pco))
+		return false;
+	if (b->im_cn_set && (!a->im_cn_set || a->im_cn != b->im_cn))
+		return false;
+
+	return true;
+}
+
+/* log without the personal information (mm_log_3gpp_profile()) */
+static void profile_log(struct modem *modem, const char *what, const struct pm_profile *p)
+{
+	char ip[40] = "";
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ip_nicks); i++) {
+		if (p->ip_type & ip_nicks[i].value)
+			snprintf(ip + strlen(ip), sizeof(ip) - strlen(ip), "%s%s", ip[0] ? "," : "", ip_nicks[i].name);
+	}
+	modem_log(modem, LOGL_INFO, "%s: profile_id %d, apn '%s', ip_type '%s', user '%s', password '%s'", what, p->id,
+		  p->apn ? p->apn : "", ip, p->user ? "***" : "", p->password ? "***" : "");
+}

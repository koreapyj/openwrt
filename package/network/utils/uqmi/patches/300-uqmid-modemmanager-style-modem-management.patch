@@ -0,0 +1,1236 @@
+/*
+ * uqmid -- extension methods: QMI features without a ModemManager equivalent
+ *
+ * A uqmid extension (like the PDC methods, see pdc.c): ModemManager has no public methods for these, they are
+ * the "uqmid dialect" of the uqmi command line commands. Each method sends the QMI request of the command
+ * (the messages and TLVs are the ones of uqmi/commands-*.c) and returns the JSON the command prints (the
+ * formatting is shared in common/ext-fmt.c):
+ *
+ *  Reads, sent at once (no operation lock):
+ *   dms_get_versions            CTL Get Version Info                         {service_<id>: "<major>,<minor>"}
+ *   nas_get_tx_rx_info {radio}  NAS Get TX/RX Info                           {rx_chain_<n>: {...}, tx: {...}}
+ *   nas_get_lte_cphy_ca_info    NAS Get LTE Cphy CA Info                     {primary: {...}, secondary[_<n>]: {...}}
+ *   uim_get_sim_state           UIM Get Card Status                          {card_slot, card_application_state, pin1_*, pin2_*}
+ *   nas_get_network_roaming     NAS Get System Selection Preference          {roaming}
+ *   wda_get_data_format         WDA Get Data Format                          {qos-format, link-layer-protocol, ...}
+ *   wms_get_raw_message {...}   WMS Raw Read                                 {data}
+ *
+ *  Changes (user requests serialized per modem like enable, the reply carries state and power_state like theirs):
+ *   uim_power_off {slot}, uim_power_on {slot}
+ *   uim_channel_open {aid, slot}                                             {channel_id, sw1, sw2}
+ *   uim_channel_close {channel_id, slot}
+ *   uim_apdu_send {apdu, channel_id, slot}                                   {response}
+ *   nas_set_network_roaming {roaming, duration}
+ *   wda_set_data_format {type, ...}, ctl_set_data_format {mode}
+ *   wds_set_autoconnect {status}
+ *   voice_burst_dtmf {call_id, digits}
+ *   dms_fcc_auth
+ *
+ * The methods which change the modem behind the back of uqmid (SIM power, data format, roaming preference,
+ * autoconnect) can make the MM model of uqmid stale: the state is not re-read afterwards. The data format
+ * changes are refused while a data connection is being set up, is up or is being torn down (QMI: the data
+ * format can't be changed while a data call exists).
+ *
+ * Nothing here is ever run automatically.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/utils.h>
+#include <talloc.h>
+
+#include "ext-fmt.h"
+#include "extensions.h"
+#include "logging.h"
+#include "modem.h"
+#include "qmi-enums.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "ubus.h"
+#include "utils.h"
+#include "voice-util.h"
+
+#define EXT_TIMEOUT_MS 10000
+/* a card power cycle or an APDU may take a while */
+#define EXT_UIM_TIMEOUT_MS 30000
+/* the request message buffer is 1 KiB */
+#define EXT_APDU_MAX 512
+#define EXT_AID_MAX 16
+#define EXT_DIGITS_MAX 255
+#define EXT_MAX_POLICY 12
+
+static struct blob_buf b;
+
+struct ext_args {
+	int8_t radio;
+	uint8_t slot;
+	uint8_t channel_id;
+	bool has_channel;
+	uint8_t aid[EXT_AID_MAX];
+	unsigned int aid_n;
+	uint8_t apdu[EXT_APDU_MAX];
+	unsigned int apdu_n;
+	uint8_t roaming;
+	uint8_t duration;
+	bool has_duration;
+	uint32_t link;
+	struct {
+		uint32_t proto;
+		uint32_t count;
+		uint32_t size;
+	} dl, ul;
+	int flow_control;
+	uint16_t ctl_protocol;
+	uint8_t status;
+	uint8_t storage;
+	uint32_t index;
+	uint8_t call_id;
+	char digits[EXT_DIGITS_MAX + 1];
+};
+
+struct ext_method {
+	const char *name;
+	/* QMI_SERVICE_* (QMI_SERVICE_CTL: the control service of the device) */
+	int service;
+	/* a user request serialized per modem (changes the modem), else a read which is sent at once */
+	bool change;
+	/* wrong-state while a data connection is connecting, connected or disconnecting */
+	bool no_data_session;
+	unsigned int timeout_ms;
+	const char *what;
+	const struct blobmsg_policy *policy;
+	unsigned int n_policy;
+	/* the error is the message of the invalid-args reply */
+	int (*parse)(struct modem *modem, struct blob_attr **tb, struct ext_args *a, const char **err);
+	int (*encode)(struct qmi_msg *msg, struct ext_args *a);
+	/* NULL: no data. Non zero: the response can't be parsed */
+	int (*result)(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb);
+};
+
+struct ext_ctx {
+	/* modem->ext_reads (reads only) */
+	struct list_head list;
+	struct modem *modem;
+	const struct ext_method *m;
+	struct ext_args a;
+	/* reads: the deferred request */
+	struct ubus_request_data req;
+	/* changes: the operation which owns the context */
+	struct modem_op *op;
+	/* the QMI request in flight */
+	struct qmi_request *qreq;
+};
+
+/*****************************************************************************/
+/* arguments */
+
+static bool ext_attr_uint(struct blob_attr *attr, uint32_t min, uint32_t max, uint32_t *val)
+{
+	int64_t v;
+
+	switch (blobmsg_type(attr)) {
+	case BLOBMSG_TYPE_INT8:
+		v = blobmsg_get_u8(attr);
+		break;
+	case BLOBMSG_TYPE_INT16:
+		v = blobmsg_get_u16(attr);
+		break;
+	case BLOBMSG_TYPE_INT32:
+		v = (int32_t) blobmsg_get_u32(attr);
+		break;
+	case BLOBMSG_TYPE_INT64:
+		v = (int64_t) blobmsg_get_u64(attr);
+		break;
+	default:
+		return false;
+	}
+
+	if (v < min || v > max)
+		return false;
+
+	*val = v;
+	return true;
+}
+
+/* an optional number: 1 if present and valid, 0 if absent, -1 if invalid */
+static int ext_opt_uint(struct blob_attr *attr, uint32_t min, uint32_t max, uint32_t *val)
+{
+	if (!attr)
+		return 0;
+
+	return ext_attr_uint(attr, min, max, val) ? 1 : -1;
+}
+
+static const char *ext_str(struct blob_attr *attr)
+{
+	return attr ? blobmsg_get_string(attr) : NULL;
+}
+
+/* slot (1 or 2): optional, default the active slot */
+static int ext_parse_slot(struct modem *modem, struct blob_attr *attr, bool required, struct ext_args *a,
+			  const char **err)
+{
+	uint32_t v = 0;
+	int r = ext_opt_uint(attr, 1, 2, &v);
+
+	if (r < 0) {
+		*err = "slot has to be 1 or 2";
+		return -1;
+	}
+	if (r == 0) {
+		if (required) {
+			*err = "slot is required (1 or 2)";
+			return -1;
+		}
+		v = modem->sim.active_slot >= 1 && modem->sim.active_slot <= 2 ? modem->sim.active_slot : 1;
+	}
+	a->slot = v;
+	return 0;
+}
+
+static int ext_parse_channel(struct blob_attr *attr, bool required, struct ext_args *a, const char **err)
+{
+	uint32_t v = 0;
+	int r = ext_opt_uint(attr, 1, 4, &v);
+
+	if (r < 0 || (!r && required)) {
+		*err = "channel_id has to be a number from 1 to 4";
+		return -1;
+	}
+	a->has_channel = r > 0;
+	a->channel_id = v;
+	return 0;
+}
+
+/*****************************************************************************/
+/* methods */
+
+enum { N_RADIO };
+static const struct blobmsg_policy radio_policy[] = {
+	[N_RADIO] = { .name = "radio", .type = BLOBMSG_TYPE_STRING },
+};
+
+/* ---- dms_get_versions */
+
+static int enc_versions(struct qmi_msg *msg, struct ext_args *a)
+{
+	return qmi_set_ctl_get_version_info_request(msg);
+}
+
+static int res_versions(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_ctl_get_version_info_response res = {};
+
+	if (qmi_parse_ctl_get_version_info_response(msg, &res))
+		return -1;
+	ext_fmt_version_info(bb, &res);
+	return 0;
+}
+
+static const struct ext_method m_dms_get_versions = {
+	.name = "dms_get_versions",
+	.service = QMI_SERVICE_CTL,
+	.timeout_ms = EXT_TIMEOUT_MS,
+	.what = "Get version info",
+	.encode = enc_versions,
+	.result = res_versions,
+};
+
+/* ---- nas_get_tx_rx_info */
+
+static int parse_tx_rx(struct modem *modem, struct blob_attr **tb, struct ext_args *a, const char **err)
+{
+	const char *s = ext_str(tb[N_RADIO]);
+
+	if (!s || !ext_nas_radio_parse(s, &a->radio)) {
+		*err = "radio has to be gsm, umts, lte or 5gnr";
+		return -1;
+	}
+	return 0;
+}
+
+static int enc_tx_rx(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_nas_get_tx_rx_info_request req = {};
+
+	qmi_set(&req, radio_interface, a->radio);
+	return qmi_set_nas_get_tx_rx_info_request(msg, &req);
+}
+
+static int res_tx_rx(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_nas_get_tx_rx_info_response res = {};
+
+	if (qmi_parse_nas_get_tx_rx_info_response(msg, &res))
+		return -1;
+	ext_fmt_tx_rx_info(bb, a->radio, &res);
+	return 0;
+}
+
+static const struct ext_method m_nas_get_tx_rx_info = {
+	.name = "nas_get_tx_rx_info",
+	.service = QMI_SERVICE_NAS,
+	.timeout_ms = EXT_TIMEOUT_MS,
+	.what = "Get TX/RX info",
+	.policy = radio_policy,
+	.n_policy = ARRAY_SIZE(radio_policy),
+	.parse = parse_tx_rx,
+	.encode = enc_tx_rx,
+	.result = res_tx_rx,
+};
+
+/* ---- nas_get_lte_cphy_ca_info */
+
+static int enc_cphy_ca(struct qmi_msg *msg, struct ext_args *a)
+{
+	return qmi_set_nas_get_lte_cphy_ca_info_request(msg);
+}
+
+static int res_cphy_ca(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_nas_get_lte_cphy_ca_info_response res = {};
+
+	if (qmi_parse_nas_get_lte_cphy_ca_info_response(msg, &res))
+		return -1;
+	ext_fmt_lte_cphy_ca_info(bb, &res);
+	return 0;
+}
+
+static const struct ext_method m_nas_get_lte_cphy_ca_info = {
+	.name = "nas_get_lte_cphy_ca_info",
+	.service = QMI_SERVICE_NAS,
+	.timeout_ms = EXT_TIMEOUT_MS,
+	.what = "Get LTE Cphy CA info",
+	.encode = enc_cphy_ca,
+	.result = res_cphy_ca,
+};
+
+/* ---- uim_get_sim_state */
+
+static int enc_sim_state(struct qmi_msg *msg, struct ext_args *a)
+{
+	return qmi_set_uim_get_card_status_request(msg);
+}
+
+static int res_sim_state(struct qmi_msg *msg, struct ext_args *a, struct blob_buf *bb)
+{
+	struct qmi_uim_get_card_status_response res = {};
+
+	if (qmi_parse_uim_get_card_status_response(msg, &res))
+		return -1;
+	ext_fmt_uim_sim_state(bb, &res);
+	return 0;
+}
+
+static const struct ext_method m_uim_get_sim_state = {
+	.name = "uim_get_sim_state",
+	.service = QMI_SERVICE_UIM,
+	.timeout_ms = EXT_TIMEOUT_MS,
+	.what = "Get SIM state",
+	.encode = enc_sim_state,
+	.result = res_sim_state,
+};
+
+/* ---- uim_power_off, uim_power_on, uim_channel_open, uim_channel_close, uim_apdu_send */
+
+enum { U_SLOT, U_AID, U_CHANNEL };
+static const struct blobmsg_policy uim_slot_policy[] = {
+	[U_SLOT] = { .name = "slot", .type = BLOBMSG_TYPE_UNSPEC },
+};
+static const struct blobmsg_policy uim_open_policy[] = {
+	[U_SLOT] = { .name = "slot", .type = BLOBMSG_TYPE_UNSPEC },
+	[U_AID] = { .name = "aid", .type = BLOBMSG_TYPE_STRING },
+};
+/* U_AID is the channel id of uim_channel_close */
+static const struct blobmsg_policy uim_close_policy[] = {
+	[U_SLOT] = { .name = "slot", .type = BLOBMSG_TYPE_UNSPEC },
+	[U_AID] = { .name = "channel_id", .type = BLOBMSG_TYPE_UNSPEC },
+};
+/* U_AID is the APDU of uim_apdu_send */
+static const struct blobmsg_policy uim_apdu_policy[] = {
+	[U_SLOT] = { .name = "slot", .type = BLOBMSG_TYPE_UNSPEC },
+	[U_AID] = { .name = "apdu", .type = BLOBMSG_TYPE_STRING },
+	[U_CHANNEL] = { .name = "channel_id", .type = BLOBMSG_TYPE_UNSPEC },
+};
+
+/* the slot is required, the CLI needs --uim-slot */
+static int parse_uim_power(struct modem *modem, struct blob_attr **tb, struct ext_args *a, const char **err)
+{
+	return ext_parse_slot(modem, tb[U_SLOT], true, a, err);
+}
+
+static int enc_power_off(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_uim_power_off_sim_request req = { QMI_INIT(slot, a->slot) };
+
+	return qmi_set_uim_power_off_sim_request(msg, &req);
+}
+
+static int enc_power_on(struct qmi_msg *msg, struct ext_args *a)

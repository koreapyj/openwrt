+static int auth_from_name(const char *name, int *mask)
+{
+	char buf[32], *tok, *save;
+	int val;
+
+	snprintf(buf, sizeof(buf), "%s", name);
+	*mask = 0;
+	for (tok = strtok_r(buf, "|, ", &save); tok; tok = strtok_r(NULL, "|, ", &save)) {
+		if (!wds_name_to_val(wds_auth_names, wds_auth_names_n, tok, false, &val))
+			/* MM: mschap, mschapv2 and eap are not supported by QMI */
+			return -1;
+		*mask |= val;
+	}
+
+	return 0;
+}
+
+/* MM: mm_bearer_allowed_auth_to_qmi_authentication() */
+int uqmid_parse_allowed_auth(struct blob_attr *attr, int *auth)
+{
+	struct blob_attr *cur;
+	int rem, mask, all = 0;
+
+	if (blobmsg_type(attr) == BLOBMSG_TYPE_STRING) {
+		if (auth_from_name(blobmsg_get_string(attr), &all))
+			return -1;
+	} else if (blobmsg_type(attr) == BLOBMSG_TYPE_ARRAY) {
+		blobmsg_for_each_attr(cur, attr, rem) {
+			if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || auth_from_name(blobmsg_get_string(cur), &mask))
+				return -1;
+			all |= mask;
+		}
+	} else {
+		return -1;
+	}
+
+	*auth = all;
+	return 0;
+}
+
+void uqmid_add_allowed_auth(struct blob_buf *bb, const char *name, uint8_t qmi_auth)
+{
+	void *a = blobmsg_open_array(bb, name);
+
+	/* MM: mm_bearer_allowed_auth_from_qmi_authentication() */
+	if (qmi_auth == QMI_WDS_AUTHENTICATION_NONE)
+		blobmsg_add_string(bb, NULL, "none");
+	if (qmi_auth & QMI_WDS_AUTHENTICATION_PAP)
+		blobmsg_add_string(bb, NULL, "pap");
+	if (qmi_auth & QMI_WDS_AUTHENTICATION_CHAP)
+		blobmsg_add_string(bb, NULL, "chap");
+	blobmsg_close_array(bb, a);
+}
+
+enum modem_error uqmid_bearer_props_parse(void *ctx, struct blob_attr *apn, struct blob_attr *ip_type,
+					  struct blob_attr *auth, struct blob_attr *user, struct blob_attr *password,
+					  struct blob_attr *allow_roaming, struct blob_attr *profile_id,
+					  struct bearer_props *props, const char **msg)
+{
+	int ip = IP_TYPE_ANY;
+
+	memset(props, 0, sizeof(*props));
+	props->auth = -1;
+	props->profile_id = -1;
+
+	if (ip_type) {
+		ip = uqmid_parse_ip_type(blobmsg_get_string(ip_type));
+		if (ip < 0) {
+			*msg = "Unsupported IP type requested";
+			return MODEM_ERR_UNSUPPORTED;
+		}
+	}
+	props->ip_type = ip;
+
+	if (auth && uqmid_parse_allowed_auth(auth, &props->auth)) {
+		*msg = "Unsupported authentication methods";
+		return MODEM_ERR_UNSUPPORTED;
+	}
+
+	if (profile_id) {
+		int id = blobmsg_get_u32(profile_id);
+
+		if (id < 1 || id > 255) {
+			*msg = "Invalid profile id";
+			return MODEM_ERR_INVALID_ARGS;
+		}
+		props->profile_id = id;
+	}
+
+	if (apn)
+		props->apn = talloc_strdup(ctx, blobmsg_get_string(apn));
+	/* MM: user/password empty strings are no strings */
+	if (user && *blobmsg_get_string(user))
+		props->user = talloc_strdup(ctx, blobmsg_get_string(user));
+	if (password && *blobmsg_get_string(password))
+		props->password = talloc_strdup(ctx, blobmsg_get_string(password));
+	/* MM: mm_bearer_properties_new() defaults allow-roaming to TRUE */
+	props->allow_roaming = allow_roaming ? blobmsg_get_bool(allow_roaming) : true;
+
+	/* MM: 3GPP connection logic requires the APN property (unless the settings come from a profile), but it
+	 * may be empty: the network default is used then */
+	if (props->profile_id < 0 && !props->apn) {
+		*msg = "3GPP connection logic requires APN setting";
+		return MODEM_ERR_INVALID_ARGS;
+	}
+
+	return MODEM_ERR_NONE;
+}
+
+static const char *status_name(enum bearer_status status)
+{
+	switch (status) {
+	case BEARER_DISCONNECTED: return "disconnected";
+	case BEARER_CONNECTING: return "connecting";
+	case BEARER_CONNECTED: return "connected";
+	case BEARER_DISCONNECTING: return "disconnecting";
+	}
+
+	return "unknown";
+}
+
+/*****************************************************************************/
+/* connection error (MM: mm_error_from_wds_verbose_call_end_reason()) */
+
+static void set_error(struct conn_error *e, const char *name, const char *fmt, ...) __attribute__((format(printf, 3, 4)));
+
+static void set_error(struct conn_error *e, const char *name, const char *fmt, ...)
+{
+	va_list ap;
+
+	e->set = true;
+	snprintf(e->name, sizeof(e->name), "%s", name);
+	va_start(ap, fmt);
+	vsnprintf(e->message, sizeof(e->message), fmt, ap);
+	va_end(ap);
+}
+
+/* the 3GPP specific call end reasons (TS 24.008 session management causes) the MM errors are named after */
+static const char *call_end_3gpp_name(int reason)
+{
+	switch (reason) {
+	case 8: return "operator-determined-barring";
+	case 26: return "insufficient-resources";
+	case 27: return "missing-or-unknown-apn";
+	case 28: return "unknown-pdp-address-or-type";
+	case 29: return "user-authentication-failed";
+	case 30: return "activation-rejected-by-ggsn-sgw-or-pdn-gw";
+	case 31: return "activation-rejected-unspecified";
+	case 32: return "service-option-not-supported";
+	case 33: return "requested-service-option-not-subscribed";
+	case 34: return "service-option-temporarily-out-of-order";
+	case 35: return "nsapi-already-used";
+	case 36: return "regular-deactivation";
+	case 38: return "network-failure";
+	case 39: return "reactivation-requested";
+	case 50: return "pdp-type-ipv4-only-allowed";
+	case 51: return "pdp-type-ipv6-only-allowed";
+	case 52: return "single-address-bearers-only-allowed";
+	case 55: return "multiple-pdn-connections-for-given-apn-not-allowed";
+	default: return NULL;
+	}
+}
+
+static void error_from_start_network(struct conn_error *e, bool v4, const struct qmi_wds_start_network_response *res)
+{
+	if (res->set.verbose_call_end_reason) {
+		int type = res->data.verbose_call_end_reason.type;
+		int reason = res->data.verbose_call_end_reason.reason;
+		const char *name = type == QMI_WDS_VERBOSE_CALL_END_REASON_TYPE_3GPP ? call_end_3gpp_name(reason) : NULL;
+
+		if (name)
+			set_error(e, name, "Call failed: 3gpp error %d (%s)", reason, name);
+		else
+			set_error(e, "unknown", "Call failed: type %d reason %d (%s)", type, reason,
+				  v4 ? "ipv4" : "ipv6");
+		return;
+	}
+
+	if (res->set.call_end_reason) {
+		set_error(e, "unknown", "Call failed: call end reason %u", res->data.call_end_reason);
+		return;
+	}
+
+	set_error(e, "unknown", "Call failed");
+}
+
+/*****************************************************************************/
+/* helpers */
+
+static LIST_HEAD(laters);
+
+struct later {
+	struct list_head list;
+	struct uloop_timeout timer;
+	struct modem *modem;
+	bearer_cb cb;
+	void *data;
+	enum modem_error err;
+	char *msg;
+};
+
+static void later_cb(struct uloop_timeout *t)
+{
+	struct later *l = container_of(t, struct later, timer);
+	struct modem *modem = l->modem;
+	bearer_cb cb = l->cb;
+	void *data = l->data;
+	enum modem_error err = l->err;
+	char *msg = l->msg;
+
+	list_del(&l->list);
+	free(l);
+	cb(modem, err, msg ? msg : modem_error_message(err), data);
+	free(msg);
+}
+
+/* the callbacks are never called from within the calls which take them */
+static void complete_later(struct modem *modem, bearer_cb cb, void *data, enum modem_error err, const char *msg)
+{
+	struct later *l = calloc(1, sizeof(*l));
+
+	if (!l)
+		return;
+
+	l->modem = modem;
+	l->cb = cb;
+	l->data = data;
+	l->err = err;
+	l->msg = msg ? strdup(msg) : NULL;
+	l->timer.cb = later_cb;
+	list_add_tail(&l->list, &laters);
+	uloop_timeout_set(&l->timer, 0);
+}
+
+/* the modem is going away: the callbacks which wait are called with an error now */
+static void laters_abort(struct modem *modem)
+{
+	struct later *l, *tmp;
+
+	list_for_each_entry_safe(l, tmp, &laters, list) {
+		bearer_cb cb;
+		void *data;
+
+		if (l->modem != modem)
+			continue;
+
+		uloop_timeout_cancel(&l->timer);
+		list_del(&l->list);
+		cb = l->cb;
+		data = l->data;
+		free(l->msg);
+		free(l);
+		cb(modem, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), data);
+	}
+}
+
+#define SEND_REQ(svc, ENC, cb, data, tmo) ({					\
+	struct qmi_msg *_m;							\
+	struct qmi_request *_r = uqmi_request_alloc((svc), &_m, (cb), (data), (tmo)); \
+	int _ret = -ENOMEM;							\
+	if (_r) {								\
+		if (ENC) {							\
+			talloc_free(_r);					\
+			_ret = -EINVAL;						\
+		} else {							\
+			_ret = uqmi_service_send_msg((svc), _r);		\
+		}								\
+	}									\
+	_ret;									\
+})
+
+static void bearer_notify(struct bearer *bearer, const char *name, struct blob_buf *nb)
+{
+	if (bearer->ubus.id)
+		ubus_notify(ubus_ctx, &bearer->ubus, name, nb->head, -1);
+}
+
+static void modem_notify(struct modem *modem, const char *name, struct blob_buf *nb)
+{
+	if (modem->ubus.id)
+		ubus_notify(ubus_ctx, &modem->ubus, name, nb->head, -1);
+}
+
+static void conn_error_add(struct blob_buf *bb, const char *name, const struct conn_error *e)
+{
+	void *t = blobmsg_open_table(bb, name);
+
+	blobmsg_add_string(bb, "name", e->name);
+	blobmsg_add_string(bb, "message", e->message);
+	blobmsg_close_table(bb, t);
+}
+
+/* MM: bearer_update_status() and the modem state of bearer_status_changed() (mm-iface-modem.c) */
+static void bearer_set_status(struct bearer *bearer, enum bearer_status status)
+{
+	struct modem *modem = bearer->modem;
+	enum bearer_status old = bearer->status;
+	struct blob_buf nb = {};
+	struct bearer *other;
+	unsigned int others_connected = 0;
+	enum modem_state new_state;
+
+	if (old == status)
+		return;
+
+	bearer->status = status;
+	modem_log(modem, LOGL_INFO, "bearer %s: %s -> %s", bearer->ubus.name, status_name(old), status_name(status));
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "old", status_name(old));
+	blobmsg_add_string(&nb, "new", status_name(status));
+	bearer_notify(bearer, "status_changed", &nb);
+	blob_buf_free(&nb);
+
+	if (status == BEARER_CONNECTED || status == BEARER_DISCONNECTED) {
+		blob_buf_init(&nb, 0);
+		blobmsg_add_string(&nb, "path", bearer->ubus.name);
+		blobmsg_add_string(&nb, "interface", bearer->port >= 0 ? modem->net_ports[bearer->port].ifname : "");
+		if (status == BEARER_DISCONNECTED && bearer->error.set)
+			conn_error_add(&nb, "connection_error", &bearer->error);
+		modem_notify(modem, status == BEARER_CONNECTED ? "bearer.connected" : "bearer.disconnected", &nb);
+		blob_buf_free(&nb);
+	}
+
+	/* Don't log modem bearer-specific status changes if we're disabling or enabling */
+	if (modem->mm_state == MODEM_STATE_DISABLING || modem->mm_state == MODEM_STATE_ENABLING)
+		return;
+
+	/* If no other bearers are connected, change the modem state */
+	list_for_each_entry(other, &modem->bearers, list) {
+		if (other != bearer && other->status == BEARER_CONNECTED)
+			others_connected++;
+	}
+	if (others_connected)
+		return;
+
+	switch (status) {
+	case BEARER_CONNECTED:
+		new_state = MODEM_STATE_CONNECTED;
+		break;
+	case BEARER_CONNECTING:
+		new_state = MODEM_STATE_CONNECTING;
+		break;
+	case BEARER_DISCONNECTING:
+		new_state = MODEM_STATE_DISCONNECTING;
+		break;
+	default:
+		new_state = modem->sub_state;
+		break;
+	}
+
+	/* only the states from enabled on */
+	if (modem->mm_state >= MODEM_STATE_ENABLED)
+		uqmid_modem_update_state(modem, new_state, MODEM_CHANGE_REASON_USER_REQUESTED);
+}
+
+bool uqmid_bearers_busy(struct modem *modem)
+{
+	struct bearer *bearer;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		if (bearer->status != BEARER_DISCONNECTED)
+			return true;
+	}
+
+	return false;
+}
+
+bool uqmid_bearers_profile_in_use(struct modem *modem, int profile_id)
+{
+	struct bearer *bearer;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		if (bearer->props.profile_id == profile_id &&
+		    (bearer->status == BEARER_CONNECTED || bearer->status == BEARER_DISCONNECTING))
+			return true;
+	}
+
+	return false;
+}
+
+unsigned int uqmid_bearers_count_connected(struct modem *modem)
+{
+	struct bearer *bearer;
+	unsigned int n = 0;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		if (bearer->status == BEARER_CONNECTED)
+			n++;
+	}
+
+	return n;
+}
+
+/*****************************************************************************/
+/* the clients of a bearer */
+
+static void packet_service_status_ind(struct qmi_service *service, struct qmi_msg *msg, void *data);
+
+static void family_reset(struct bearer_family *fam)
+{
+	if (fam->wds) {
+		/* no late indication may reach a bearer which is gone */
+		if (fam->ind)
+			uqmi_service_remove_indication(fam->wds, WDS_IND_PACKET_SERVICE_STATUS,
+						       packet_service_status_ind, fam->owner);
+		uqmi_service_close(fam->wds);
+	}
+	fam->wds = NULL;
+	fam->ind = false;
+	fam->pdh = 0;
+	memset(&fam->cfg, 0, sizeof(fam->cfg));
+	memset(&fam->pcscf, 0, sizeof(fam->pcscf));
+}
+
+static bool bearer_has_connection(struct bearer *bearer)
+{
+	return bearer->fam[0].pdh || bearer->fam[1].pdh;
+}
+
+/*****************************************************************************/
+/* IP configuration (MM: get_ipv4_config(), get_ipv6_config()) */
+
+static bool config_from_settings(struct bearer *bearer, struct bearer_family *fam,
+				 const struct qmi_wds_get_current_settings_response *res)
+{
+	struct ip_config *c = &fam->cfg;
+	unsigned int ndns = 0;
+	bool v6 = fam->v6;
+
+	memset(c, 0, sizeof(*c));
+	snprintf(c->method, sizeof(c->method), "%s", bearer->raw_ip ? "static" : "dhcp");
+
+	if (!v6) {
+		/* IPv4 subnet mask and address are mandatory */
+		if (!res->set.ipv4_gateway_subnet_mask || !res->set.ipv4_address)
+			return false;
+
+		c->prefix = wds_netmask_to_prefix(res->data.ipv4_gateway_subnet_mask);
+		wds_ipv4_to_str(res->data.ipv4_address, c->address, sizeof(c->address));
+		if (res->set.ipv4_gateway_address)
+			wds_ipv4_to_str(res->data.ipv4_gateway_address, c->gateway, sizeof(c->gateway));
+		if (res->set.primary_ipv4_dns_address)
+			wds_ipv4_to_str(res->data.primary_ipv4_dns_address, c->dns[ndns++], sizeof(c->dns[0]));
+		if (res->set.secondary_ipv4_dns_address)
+			wds_ipv4_to_str(res->data.secondary_ipv4_dns_address, c->dns[ndns++], sizeof(c->dns[0]));
+	} else {
+		if (!res->set.ipv6_address)
+			return false;
+
+		wds_ipv6_to_str(res->data.ipv6_address.address, c->address, sizeof(c->address));
+		c->prefix = res->data.ipv6_address.prefix_length;
+		if (res->set.ipv6_gateway_address)
+			wds_ipv6_to_str(res->data.ipv6_gateway_address.address, c->gateway, sizeof(c->gateway));
+		if (res->set.ipv6_primary_dns_address)
+			wds_ipv6_to_str(res->data.ipv6_primary_dns_address, c->dns[ndns++], sizeof(c->dns[0]));
+		if (res->set.ipv6_secondary_dns_address)
+			wds_ipv6_to_str(res->data.ipv6_secondary_dns_address, c->dns[ndns++], sizeof(c->dns[0]));
+	}
+
+	if (res->set.mtu)
+		c->mtu = res->data.mtu;
+	c->valid = true;
+
+	return true;
+}
+
+/* the P-CSCF lists of the settings of a family (the V4 ones come with the IPv4 client, the V6 ones with the IPv6 one) */
+static void pcscf_from_settings(struct bearer_family *fam, const struct qmi_wds_get_current_settings_response *res)
+{
+	struct pcscf_config *p = &fam->pcscf;
+	unsigned int i;
+
+	memset(p, 0, sizeof(*p));
+
+	if (fam->v6) {
+		if (res->data.pcscf_ipv6_server_address_list)
+			for (i = 0; i < res->data.pcscf_ipv6_server_address_list_n && p->n_addr < PCSCF_MAX_ADDR; i++)
+				wds_ipv6_to_str(res->data.pcscf_ipv6_server_address_list[i].address,
+						p->addr[p->n_addr++], sizeof(p->addr[0]));
+	} else if (res->data.pcscf_server_address_list) {
+		for (i = 0; i < res->data.pcscf_server_address_list_n && p->n_addr < PCSCF_MAX_ADDR; i++)
+			wds_ipv4_to_str(res->data.pcscf_server_address_list[i], p->addr[p->n_addr++], sizeof(p->addr[0]));
+	}
+
+	/* the FQDN list is not family specific, it is kept with the family of the response it came with */
+	if (res->data.pcscf_domain_name_list)
+		for (i = 0; i < res->data.pcscf_domain_name_list_n && p->n_fqdn < PCSCF_MAX_FQDN; i++) {
+			if (!res->data.pcscf_domain_name_list[i] || !res->data.pcscf_domain_name_list[i][0])
+				continue;
+			snprintf(p->fqdn[p->n_fqdn++], sizeof(p->fqdn[0]), "%s", res->data.pcscf_domain_name_list[i]);
+		}
+}
+
+/*****************************************************************************/
+/* waiters of the disconnected state, stopping the network */
+
+static void waiters_complete(struct bearer *bearer, enum modem_error err, const char *msg)
+{
+	struct bearer_waiter *w, *tmp;
+	LIST_HEAD(local);
+
+	list_splice_init(&bearer->waiters, &local);
+	list_for_each_entry_safe(w, tmp, &local, list) {
+		list_del(&w->list);
+		complete_later(bearer->modem, w->cb, w->data, err, msg);
+		talloc_free(w);
+	}
+}
+
+/* all the clients are gone, the bearer is disconnected */
+static void bearer_disconnected(struct bearer *bearer)
+{
+	family_reset(&bearer->fam[0]);
+	family_reset(&bearer->fam[1]);
+	bearer->suspended = false;
+	uloop_timeout_cancel(&bearer->unreg_timer);
+	bearer_set_status(bearer, BEARER_DISCONNECTED);
+	bearer->port = -1;
+	waiters_complete(bearer, MODEM_ERR_NONE, NULL);
+}
+
+struct stop_ctx {
+	struct bearer *bearer;
+	bool force;
+	int fam;
+	enum modem_error err;
+	char msg[96];
+};
+
+static void stop_next(struct stop_ctx *sc);
+
+static void stop_network_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct stop_ctx *sc = req->cb_data;
+	struct bearer *bearer = sc->bearer;
+	struct bearer_family *fam = &bearer->fam[sc->fam];
+
+	/* No effect error, we're already disconnected */
+	if ((!msg || req->ret) && req->ret != QMI_PROTOCOL_ERROR_NO_EFFECT) {
+		modem_log(bearer->modem, LOGL_NOTICE, "couldn't stop the %s network: %d/%s", fam->v6 ? "IPv6" : "IPv4",
+			  req->ret, qmi_get_error_str(req->ret));
+		if (!sc->force && !sc->err) {
+			sc->err = req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED;
+			snprintf(sc->msg, sizeof(sc->msg), "Couldn't stop the %s network", fam->v6 ? "IPv6" : "IPv4");
+		}
+	} else {
+		/* Clear internal status */
+		family_reset(fam);
+	}
+
+	sc->fam++;
+	stop_next(sc);
+}
+
+static void stop_next(struct stop_ctx *sc)
+{
+	struct bearer *bearer = sc->bearer;
+
+	for (; sc->fam < 2; sc->fam++) {
+		struct bearer_family *fam = &bearer->fam[sc->fam];
+		struct qmi_wds_stop_network_request sr = {};
+
+		if (!fam->pdh || !fam->wds)
+			continue;
+
+		qmi_set(&sr, packet_data_handle, fam->pdh);
+		if (!SEND_REQ(fam->wds, qmi_set_wds_stop_network_request(_m, &sr), stop_network_cb, sc,
+			      DISCONNECTION_TIMEOUT_MS))
+			return;
+	}
+
+	/* done */
+	if (sc->err && !sc->force) {
+		/* MM: couldn't disconnect, the bearer is connected still */
+		bearer_set_status(bearer, BEARER_CONNECTED);
+		bearer->disconnecting = false;
+		waiters_complete(bearer, sc->err, sc->msg);
+	} else {
+		bearer->disconnecting = false;
+		bearer_disconnected(bearer);
+	}
+	talloc_free(sc);
+}
+
+static void bearer_stop_network(struct bearer *bearer, bool force)
+{
+	struct stop_ctx *sc;
+
+	bearer->disconnecting = true;
+	sc = talloc_zero(bearer, struct stop_ctx);
+	sc->bearer = bearer;
+	sc->force = force;
+	bearer_set_status(bearer, BEARER_DISCONNECTING);
+	stop_next(sc);
+}
+
+/*****************************************************************************/
+/* connect */
+
+enum {
+	CS_PORT,
+	CS_FORMAT_GET,
+	CS_FORMAT_SET,
+	CS_FORMAT_CTL,
+	CS_KERNEL,
+	CS_FAMILY,
+	CS_BIND,
+	CS_IP_FAMILY,
+	CS_START,
+	CS_SETTINGS,
+	CS_FAMILY_END,
+	CS_LAST,
+};
+
+struct connect_ctx {
+	struct uloop_timeout start;
+	struct bearer *bearer;
+	bearer_cb cb;
+	void *cb_data;
+	int step;
+	int fam;
+	bool ipv4, ipv6;
+	bool no_ip_family_pref;
+	bool sio_failed;
+	bool cancel;
+	bool wda_unsupported;
+};
+
+static void cc_step(struct connect_ctx *cc);
+
+static int cc_destructor(struct connect_ctx *cc)
+{
+	uloop_timeout_cancel(&cc->start);
+	return 0;
+}
+
+static void cc_start_cb(struct uloop_timeout *t)
+{
+	cc_step(container_of(t, struct connect_ctx, start));
+}
+
+static void cc_finish(struct connect_ctx *cc, enum modem_error err, const char *msg)
+{
+	struct bearer *bearer = cc->bearer;
+	bearer_cb cb = cc->cb;
+	void *data = cc->cb_data;
+	struct modem *modem = bearer->modem;
+	char *msg_copy = msg ? talloc_strdup(NULL, msg) : NULL;
+
+	bearer->cc = NULL;
+	talloc_free(cc);
+	cb(modem, err, msg_copy ? msg_copy : modem_error_message(err), data);
+	talloc_free(msg_copy);
+}
+
+/* the connect is answered once the bearer is disconnected again */
+struct fail_wait {
+	bearer_cb cb;
+	void *data;
+	enum modem_error err;
+	char msg[160];
+};
+
+static void fail_wait_cb(struct modem *modem, enum modem_error werr, const char *wmsg, void *data)
+{
+	struct fail_wait *fw = data;
+	bearer_cb cb = fw->cb;
+	void *cdata = fw->data;
+	enum modem_error err = fw->err;
+	char msg[160];
+
+	snprintf(msg, sizeof(msg), "%s", fw->msg);
+	talloc_free(fw);
+	/* aborted: the modem went away */
+	cb(modem, werr == MODEM_ERR_ABORTED ? werr : err, msg, cdata);
+}
+
+/* the connection failed (or was cancelled): stop what was started and report the error */
+static void cc_fail(struct connect_ctx *cc, enum modem_error err, const char *msg)
+{
+	struct bearer *bearer = cc->bearer;
+	struct bearer_family *fam;
+	bool stop = false;
+	int i;
+
+	if (cc->cancel) {
+		err = MODEM_ERR_ABORTED;
+		msg = "operation cancelled";
+	}
+
+	/* MM: the error of the connection, ipv4 preferred */
+	if (!bearer->error.set) {
+		fam = bearer->fam[0].err.set ? &bearer->fam[0] : &bearer->fam[1];
+		if (fam->err.set)
+			bearer->error = fam->err;
+		else
+			set_error(&bearer->error, cc->cancel ? "aborted" : "failed", "%s", msg ? msg : "Connection failed");
+	}
+
+	for (i = 0; i < 2; i++) {
+		if (bearer->fam[i].pdh && bearer->fam[i].wds)
+			stop = true;
+	}
+
+	modem_log(bearer->modem, LOGL_NOTICE, "bearer %s: connection failed: %s", bearer->ubus.name,
+		  bearer->error.message);
+
+	if (stop) {
+		struct fail_wait *fw = talloc_zero(bearer, struct fail_wait);
+		struct bearer_waiter *w = talloc_zero(bearer, struct bearer_waiter);
+
+		/* the network is stopped (errors don't matter), the connect is answered afterwards */
+		fw->cb = cc->cb;
+		fw->data = cc->cb_data;
+		fw->err = err;
+		snprintf(fw->msg, sizeof(fw->msg), "%s", msg ? msg : modem_error_message(err));
+		w->cb = fail_wait_cb;
+		w->data = fw;
+		list_add(&w->list, &bearer->waiters);
+		bearer->cc = NULL;
+		talloc_free(cc);
+		bearer_stop_network(bearer, true);
+		return;
+	}
+
+	bearer->disconnecting = true;
+	bearer_disconnected(bearer);
+	bearer->disconnecting = false;
+	cc_finish(cc, err, msg);
+}
+
+static void cc_next(struct connect_ctx *cc)
+{
+	cc->step++;
+	cc_step(cc);
+}
+
+/* mm_port_qmi_setup_data_format(): raw-ip is what the data port carries */
+static void cc_format_done(struct connect_ctx *cc, bool raw_ip)
+{
+	cc->bearer->raw_ip = raw_ip;
+	cc->step = CS_KERNEL;
+	cc_step(cc);
+}
+
+static void ctl_data_format_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct modem *modem = bearer->modem;
+	struct qmi_ctl_set_data_format_response res = {};
+	bool ok = msg && !req->ret && !qmi_parse_ctl_set_data_format_response(msg, &res);
+
+	if (bearer->cc != cc)
+		return;
+
+	if (ok) {
+		modem_log(modem, LOGL_INFO, "data format: raw-ip (CTL)");
+		modem->ctl_data_format_done = true;
+		cc_format_done(cc, true);
+		return;
+	}
+
+	modem_log(modem, LOGL_NOTICE, "couldn't set the data format through CTL: %d/%s", req->ret,
+		  qmi_get_error_str(req->ret));
+	/* the data port of a SoC modem (raw-ip only netdev) can't carry anything else */
+	if (bearer->port >= 0 && !strcmp(modem->net_ports[bearer->port].driver, "bam-dmux")) {
+		cc_fail(cc, MODEM_ERR_FAILED, "Couldn't set the raw-ip data format");
+		return;
+	}
+
+	/* 802.3 is what an usb device uses by default */
+	cc_format_done(cc, false);
+}
+
+static void cc_format_ctl(struct connect_ctx *cc)
+{
+	struct qmi_ctl_set_data_format_request sr = {};
+	struct qmi_service *ctl = cc->bearer->modem->qmi->ctrl;
+
+	/* MM: the control port is reopened with the raw-ip flag, which uses the CTL data format request (no QoS
+	 * header) */
+	qmi_set(&sr, format, QMI_CTL_DATA_FORMAT_QOS_FLOW_HEADER_ABSENT);
+	qmi_set(&sr, protocol, QMI_CTL_DATA_LINK_PROTOCOL_RAW_IP);
+	if (SEND_REQ(ctl, qmi_set_ctl_set_data_format_request(_m, &sr), ctl_data_format_cb, cc, STEP_TIMEOUT_MS))
+		cc_fail(cc, MODEM_ERR_FAILED, "Couldn't set the data format");
+}
+
+static void wda_set_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct modem *modem = bearer->modem;
+	struct qmi_wda_set_data_format_response res = {};
+
+	if (bearer->cc != cc)
+		return;
+
+	if (msg && !req->ret && !qmi_parse_wda_set_data_format_response(msg, &res) &&
+	    (!res.set.link_layer_protocol || res.data.link_layer_protocol == QMI_WDA_LINK_LAYER_PROTOCOL_RAW_IP)) {
+		modem_log(modem, LOGL_INFO, "data format: raw-ip (WDA)");
+		/* MM: no CTL data format request if WDA worked (a repeated CTL request is rejected with 70) */
+		cc_format_done(cc, true);
+		return;
+	}
+
+	/* MM: a failure here could indicate no support for WDA Set Data Format, if so, just go on with the plain
+	 * CTL based support */
+	modem_log(modem, LOGL_INFO, "couldn't set the data format through WDA (%d/%s), using CTL", req->ret,
+		  qmi_get_error_str(req->ret));
+	cc->wda_unsupported = true;
+	cc->step = CS_FORMAT_CTL;
+	cc_step(cc);
+}
+
+static void wda_get_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct modem *modem = bearer->modem;
+	struct qmi_wda_get_data_format_response res = {};
+
+	if (bearer->cc != cc)
+		return;
+
+	if (!msg || req->ret || qmi_parse_wda_get_data_format_response(msg, &res) || !res.set.link_layer_protocol) {
+		modem_log(modem, LOGL_INFO, "couldn't get the data format through WDA (%d/%s), using CTL", req->ret,
+			  qmi_get_error_str(req->ret));
+		cc->wda_unsupported = true;
+		cc->step = CS_FORMAT_CTL;
+		cc_step(cc);
+		return;
+	}
+
+	modem_log(modem, LOGL_DEBUG, "current data format: llp %u, aggregation ul %u dl %u",
+		  res.data.link_layer_protocol, res.set.uplink_data_aggregation_protocol ?
+		  res.data.uplink_data_aggregation_protocol : 0, res.set.downlink_data_aggregation_protocol ?
+		  res.data.downlink_data_aggregation_protocol : 0);
+
+	/* the right one already: nothing to set */
+	if (res.data.link_layer_protocol == QMI_WDA_LINK_LAYER_PROTOCOL_RAW_IP &&
+	    (!res.set.uplink_data_aggregation_protocol ||
+	     res.data.uplink_data_aggregation_protocol == QMI_WDA_DATA_AGGREGATION_PROTOCOL_DISABLED) &&
+	    (!res.set.downlink_data_aggregation_protocol ||
+	     res.data.downlink_data_aggregation_protocol == QMI_WDA_DATA_AGGREGATION_PROTOCOL_DISABLED)) {
+		cc_format_done(cc, true);
+		return;
+	}
+
+	cc->step = CS_FORMAT_SET;
+	cc_step(cc);
+}
+
+/* MM: mm_port_qmi_kernel_data_mode: raw-ip of a qmi_wwan netdev has to be enabled in the driver */
+static void cc_kernel(struct connect_ctx *cc)
+{
+	struct bearer *bearer = cc->bearer;
+	struct modem *modem = bearer->modem;
+	struct modem_net_port *np;
+	char path[64];
+	struct wwan_conf conf = {};
+
+	if (bearer->port < 0 || !bearer->raw_ip) {
+		cc_next(cc);
+		return;
+	}
+
+	np = &modem->net_ports[bearer->port];
+	snprintf(path, sizeof(path), "/sys/class/net/%s", np->ifname);
+	if (!wwan_read_configuration(path, &conf) && !conf.raw_ip) {
+		/* the interface has to be down while the data format is changed */
+		modem_log(modem, LOGL_INFO, "enabling raw-ip on %s", np->ifname);
+		wwan_ifupdown(np->ifname, false);
+		conf.raw_ip = true;
+		conf.pass_through = false;
+		if (wwan_set_configuration(path, &conf)) {
+			cc_fail(cc, MODEM_ERR_FAILED, "Couldn't enable raw-ip in the driver");
+			return;
+		}
+	}
+
+	cc_next(cc);
+}
+
+/* mm_base_modem_get_best_data_port(): the first net port which is not in use */
+static int select_port(struct modem *modem)
+{
+	struct bearer *other;
+	unsigned int i;
+
+	wwan_refresh_net_ports(modem);
+	for (i = 0; i < modem->n_net_ports; i++) {
+		bool used = false;
+
+		list_for_each_entry(other, &modem->bearers, list) {
+			if (other->port == (int)i && other->status != BEARER_DISCONNECTED)
+				used = true;
+		}
+		if (!used)
+			return i;
+	}
+
+	return -1;
+}
+
+static void bind_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct bearer_family *fam = &bearer->fam[cc->fam];
+
+	if (bearer->cc != cc)
+		return;
+
+	if (!msg || req->ret) {
+		if (req->ret == QMI_PROTOCOL_ERROR_DEVICE_UNSUPPORTED) {
+			/* Some firmwares only support this through "Bind Mux Data Port", even if multiplexing is disabled.
+			 * That is not supported here: go on without binding the client. */
+			modem_log(bearer->modem, LOGL_NOTICE, "binding to the data port is not supported, going on");
+			cc->sio_failed = true;
+		} else {
+			modem_log(bearer->modem, LOGL_NOTICE, "couldn't bind the data port: %d/%s", req->ret,
+				  qmi_get_error_str(req->ret));
+			set_error(&fam->err, "failed", "Couldn't bind data port: %s", qmi_get_error_str(req->ret));
+			cc_fail(cc, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED,
+				"Couldn't bind data port");
+			return;
+		}
+	}
+
+	cc_next(cc);
+}
+
+static void ip_family_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+
+	if (cc->bearer->cc != cc)
+		return;
+
+	if (!msg || req->ret)
+		modem_log(cc->bearer->modem, LOGL_DEBUG, "couldn't set the IP family preference: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+
+	cc_next(cc);
+}
+
+static void settings_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct bearer_family *fam = &bearer->fam[cc->fam];
+	struct qmi_wds_get_current_settings_response res = {};
+	bool ok;
+
+	if (bearer->cc != cc)
+		return;
+
+	ok = msg && !req->ret && !qmi_parse_wds_get_current_settings_response(msg, &res);
+	if (ok)
+		pcscf_from_settings(fam, &res);
+	ok = ok && config_from_settings(bearer, fam, &res);
+	if (!ok) {
+		/* When we're using static IP address, the current settings are mandatory */
+		if (bearer->raw_ip) {
+			modem_log(bearer->modem, LOGL_NOTICE, "failed to retrieve mandatory IP settings: %d/%s",
+				  req->ret, qmi_get_error_str(req->ret));
+			set_error(&fam->err, "failed", "Couldn't get the %s settings", fam->v6 ? "IPv6" : "IPv4");
+			/* the connection of this family is dropped, MM fails the whole connection here */
+			cc_fail(cc, MODEM_ERR_FAILED, "Couldn't get the IP settings");
+			return;
+		}
+
+		/* Otherwise, just go on as we're asking for DHCP */
+		memset(&fam->cfg, 0, sizeof(fam->cfg));
+		snprintf(fam->cfg.method, sizeof(fam->cfg.method), "dhcp");
+		fam->cfg.valid = true;
+	}
+
+	cc_next(cc);
+}
+
+static void start_network_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct connect_ctx *cc = req->cb_data;
+	struct bearer *bearer = cc->bearer;
+	struct bearer_family *fam = &bearer->fam[cc->fam];
+	struct qmi_wds_start_network_response res = {};
+	bool parsed = msg && !qmi_parse_wds_start_network_response(msg, &res);
+
+	if (bearer->cc != cc)
+		return;
+
+	if (!msg) {
+		set_error(&fam->err, req->ret == UQMID_ERROR_TIMEOUT ? "timeout" : "failed", "Couldn't start %s network: %s",
+			  fam->v6 ? "IPv6" : "IPv4", qmi_get_error_str(req->ret));
+	} else if (req->ret == QMI_PROTOCOL_ERROR_NO_EFFECT) {
+		/* No-effect errors should be ignored. The modem keeps the connection active as long as there is a WDS
+		 * client which requested to start the network. */
+		fam->pdh = GLOBAL_PACKET_DATA_HANDLE;
+	} else if (req->ret) {
+		modem_log(bearer->modem, LOGL_NOTICE, "couldn't start %s network: %d/%s", fam->v6 ? "IPv6" : "IPv4",
+			  req->ret, qmi_get_error_str(req->ret));
+		if (req->ret == QMI_PROTOCOL_ERROR_CALL_FAILED && parsed)
+			error_from_start_network(&fam->err, !fam->v6, &res);
+		else
+			set_error(&fam->err, "failed", "Couldn't start %s network: %s", fam->v6 ? "IPv6" : "IPv4",
+				  qmi_get_error_str(req->ret));
+	} else {
+		fam->pdh = parsed && res.set.packet_data_handle ? res.data.packet_data_handle : GLOBAL_PACKET_DATA_HANDLE;
+	}
+
+	/* the settings only of a connected family, otherwise the next family */
+	cc->step = fam->pdh ? CS_SETTINGS : CS_FAMILY_END;
+	cc_step(cc);
+}
+
+static void cc_family_begin(struct connect_ctx *cc)
+{
+	struct bearer *bearer = cc->bearer;
+	struct bearer_family *fam = &bearer->fam[cc->fam];
+
+	fam->v6 = cc->fam == 1;
+	fam->owner = bearer;
+	if (!(fam->v6 ? cc->ipv6 : cc->ipv4)) {
+		cc->step = CS_FAMILY_END;
+		cc_step(cc);
+		return;
+	}
+
+	/* MM: allocating IPv4/IPv6-specific WDS client. The client id is allocated with the first request. */
+	modem_log(bearer->modem, LOGL_INFO, "running %s connection setup", fam->v6 ? "IPv6" : "IPv4");
+	fam->wds = uqmi_service_create(bearer->modem->qmi, QMI_SERVICE_WDS);
+	cc_next(cc);
+}
+
+static void cc_step(struct connect_ctx *cc)
+{
+	struct bearer *bearer = cc->bearer;
+	struct modem *modem = bearer->modem;
+	struct bearer_family *fam = &bearer->fam[cc->fam];
+	struct bearer_props *p = &bearer->props;
+
+	/* MM: the connection was cancelled by the user (Disconnect) */
+	if (cc->cancel) {
+		cc_fail(cc, MODEM_ERR_ABORTED, "operation cancelled");
+		return;
+	}
+
+	switch (cc->step) {
+	case CS_PORT: {
+		struct qmi_service *wda;
+
+		/* Grab a data port */
+		bearer->port = select_port(modem);
+		if (bearer->port < 0) {
+			cc_fail(cc, MODEM_ERR_NOT_FOUND, "No valid data port found to launch connection");
+			return;
+		}
+		modem_log(modem, LOGL_INFO, "launching connection with QMI port (%s) and data port (%s, %s)",
+			  modem->port_name ? modem->port_name : "?", modem->net_ports[bearer->port].ifname,
+			  modem->net_ports[bearer->port].driver);
+
+		/* MM: setup data format. WDA first. */
+		wda = uqmi_service_find(modem->qmi, QMI_SERVICE_WDA);
+		if (!wda) {
+			cc->wda_unsupported = true;
+			cc->step = CS_FORMAT_CTL;
+			cc_step(cc);
+			return;
+		}
+		cc->step = CS_FORMAT_GET;
+		cc_step(cc);
+		return;
+	}
+
+	case CS_FORMAT_GET: {
+		struct qmi_wda_get_data_format_request gr = {};
+		struct qmi_service *wda = uqmi_service_find(modem->qmi, QMI_SERVICE_WDA);
+
+		if (SEND_REQ(wda, qmi_set_wda_get_data_format_request(_m, &gr), wda_get_cb, cc, STEP_TIMEOUT_MS)) {
+			cc->wda_unsupported = true;
+			cc->step = CS_FORMAT_CTL;
+			cc_step(cc);
+		}
+		return;
+	}
+
+	case CS_FORMAT_SET: {
+		struct qmi_wda_set_data_format_request sr = {};
+		struct qmi_service *wda = uqmi_service_find(modem->qmi, QMI_SERVICE_WDA);
+
+		qmi_set(&sr, qos_format, false);
+		qmi_set(&sr, link_layer_protocol, QMI_WDA_LINK_LAYER_PROTOCOL_RAW_IP);
+		qmi_set(&sr, uplink_data_aggregation_protocol, QMI_WDA_DATA_AGGREGATION_PROTOCOL_DISABLED);
+		qmi_set(&sr, downlink_data_aggregation_protocol, QMI_WDA_DATA_AGGREGATION_PROTOCOL_DISABLED);
+		if (SEND_REQ(wda, qmi_set_wda_set_data_format_request(_m, &sr), wda_set_cb, cc, STEP_TIMEOUT_MS)) {
+			cc->wda_unsupported = true;
+			cc->step = CS_FORMAT_CTL;
+			cc_step(cc);
+		}
+		return;
+	}
+
+	case CS_FORMAT_CTL:
+		cc_format_ctl(cc);
+		return;
+
+	case CS_KERNEL:
+		cc->step = CS_KERNEL;
+		cc_kernel(cc);
+		return;
+
+	case CS_FAMILY:
+		cc_family_begin(cc);
+		return;
+
+	case CS_BIND: {
+		struct modem_net_port *np = &modem->net_ports[bearer->port];
+		struct qmi_wds_bind_data_port_request br = {};
+
+		/* qcom-soc plugin: the SIO port A2_MUX_RMNET<dev_port> of a bam-dmux netdev */
+		if (cc->sio_failed || strcmp(np->driver, "bam-dmux") || np->dev_port < 0 || np->dev_port > 7) {
+			cc_next(cc);
+			return;
+		}
+
+		modem_log(modem, LOGL_DEBUG, "binding to data port: a2-mux-rmnet%d", np->dev_port);
+		qmi_set(&br, data_port, wds_sio_port_a2_mux_rmnet(np->dev_port));
+		if (SEND_REQ(fam->wds, qmi_set_wds_bind_data_port_request(_m, &br), bind_cb, cc, STEP_TIMEOUT_MS))
+			cc_fail(cc, MODEM_ERR_FAILED, "Couldn't bind data port");
+		return;
+	}
+
+	case CS_IP_FAMILY: {
+		struct qmi_wds_set_ip_family_request ir = {};
+
+		/* Packet service status indications of this client: MM connects them before starting the network */
+		if (!fam->ind) {
+			uqmi_service_register_indication(fam->wds, WDS_IND_PACKET_SERVICE_STATUS, packet_service_status_ind,
+							 bearer);
+			fam->ind = true;
+		}
+
+		/* If client is new enough, select IP family */
+		if (cc->no_ip_family_pref) {
+			cc_next(cc);
+			return;
+		}
+
+		modem_log(modem, LOGL_DEBUG, "setting default IP family to: %s", fam->v6 ? "IPv6" : "IPv4");
+		qmi_set(&ir, preference, fam->v6 ? QMI_WDS_IP_FAMILY_IPV6 : QMI_WDS_IP_FAMILY_IPV4);
+		if (SEND_REQ(fam->wds, qmi_set_wds_set_ip_family_request(_m, &ir), ip_family_cb, cc, STEP_TIMEOUT_MS))
+			cc_next(cc);
+		return;
+	}
+
+	case CS_START: {
+		struct qmi_wds_start_network_request sr = {};
+		int auth;
+
+		modem_log(modem, LOGL_INFO, "starting %s connection...", fam->v6 ? "IPv6" : "IPv4");
+		if (p->profile_id >= 0) {
+			/* When requesting to connect through a profile, add the profile-id setting */
+			qmi_set(&sr, profile_index_3gpp, p->profile_id);
+		} else {
+			/* If user gives empty string as APN, we also skip setting it in the request. */
+			if (p->apn && *p->apn)
+				sr.data.apn = p->apn;
+
+			/* Auth info (MM: no user and password is no authentication, the default is CHAP) */
+			if (!p->user && !p->password)
+				auth = QMI_WDS_AUTHENTICATION_NONE;
+			else
+				auth = p->auth >= 0 ? p->auth : QMI_WDS_AUTHENTICATION_CHAP;
+			qmi_set(&sr, authentication_preference, auth);
+			if (auth != QMI_WDS_AUTHENTICATION_NONE) {
+				if (p->user)
+					sr.data.username = p->user;
+				if (p->password)
+					sr.data.password = p->password;
+			}
+		}
+
+		/* Only add the IP family preference TLV if explicitly requested a given family */
+		if (!cc->no_ip_family_pref)
+			qmi_set(&sr, ip_family_preference, fam->v6 ? QMI_WDS_IP_FAMILY_IPV6 : QMI_WDS_IP_FAMILY_IPV4);
+
+		if (SEND_REQ(fam->wds, qmi_set_wds_start_network_request(_m, &sr), start_network_cb, cc,
+			     CONNECTION_TIMEOUT_MS))
+			cc_fail(cc, MODEM_ERR_FAILED, "Couldn't start the network");
+		return;
+	}
+
+	case CS_SETTINGS: {
+		struct qmi_wds_get_current_settings_request gr = {};
+
+		/* Retrieve and print IP configuration (MM: no PCO) */
+		modem_log(modem, LOGL_DEBUG, "getting %s configuration...", fam->v6 ? "IPv6" : "IPv4");
+		qmi_set(&gr, requested_settings,
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_DNS_ADDRESS |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_GRANTED_QOS |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_IP_ADDRESS |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_GATEWAY_INFO |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_MTU |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_DOMAIN_NAME_LIST |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_PCSCF_ADDRESS |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_PCSCF_SERVER_ADDRESS_LIST |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_PCSCF_DOMAIN_NAME_LIST |
+			QMI_WDS_GET_CURRENT_SETTINGS_REQUESTED_SETTINGS_IP_FAMILY);
+		if (SEND_REQ(fam->wds, qmi_set_wds_get_current_settings_request(_m, &gr), settings_cb, cc, STEP_TIMEOUT_MS))
+			cc_fail(cc, MODEM_ERR_FAILED, "Couldn't get the IP settings");
+		return;
+	}
+
+	case CS_FAMILY_END:
+		/* a family which didn't connect has no use for its client */
+		if (!fam->pdh)
+			family_reset(fam);
+		if (cc->fam == 0) {
+			cc->fam = 1;
+			cc->step = CS_FAMILY;
+			cc_step(cc);
+			return;
+		}
+		cc->step = CS_LAST;
+		cc_step(cc);
+		return;
+
+	case CS_LAST:
+		/* If one of IPv4 or IPv6 succeeds, we're connected */
+		if (!bearer->fam[0].pdh && !bearer->fam[1].pdh) {
+			cc_fail(cc, MODEM_ERR_FAILED, NULL);
+			return;
+		}
+
+		/* an error of the other family is only informational */
+		if (bearer->fam[0].err.set || bearer->fam[1].err.set)
+			modem_log(modem, LOGL_NOTICE, "connected, but %s failed: %s",
+				  bearer->fam[0].err.set ? "IPv4" : "IPv6",
+				  bearer->fam[0].err.set ? bearer->fam[0].err.message : bearer->fam[1].err.message);
+
+		clock_gettime(CLOCK_MONOTONIC, &bearer->connected_at);
+		bearer_set_status(bearer, BEARER_CONNECTED);
+		/* the registration may have changed while connecting */
+		uqmid_bearers_registration_changed(modem);
+		cc_finish(cc, MODEM_ERR_NONE, NULL);
+		return;
+
+	default:
+		break;
+	}
+}
+
+void uqmid_bearer_connect(struct bearer *bearer, bearer_cb cb, void *data)
+{
+	struct modem *modem = bearer->modem;
+	struct connect_ctx *cc;
+	enum conn_forbidden forbidden;
+	enum bearer_ip_type ip = bearer->props.ip_type;
+
+	/* If already connecting, return error, don't allow a second request. */
+	if (bearer->status == BEARER_CONNECTING) {
+		complete_later(modem, cb, data, MODEM_ERR_IN_PROGRESS, "Bearer already being connected");
+		return;
+	}
+
+	/* If currently disconnecting, return error, previous operation should finish before allowing to connect again. */
+	if (bearer->status == BEARER_DISCONNECTING) {
+		complete_later(modem, cb, data, MODEM_ERR_FAILED, "Bearer currently being disconnected");
+		return;
+	}
+
+	/* Check 3GPP roaming allowance, *only* roaming related here */
+	forbidden = uqmid_3gpp_connection_forbidden(modem, bearer->props.allow_roaming);
+	if (forbidden == CONN_FORBIDDEN_ROAMING) {
+		complete_later(modem, cb, data, MODEM_ERR_UNAUTHORIZED,
+			       "Not allowed to connect bearer in 3GPP network: 'Registered in roaming network, and roaming not allowed'");
+		return;
+	}
+
+	/* If already connected, done */
+	if (bearer->status == BEARER_CONNECTED) {
+		complete_later(modem, cb, data, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	if (modem->mm_state < MODEM_STATE_ENABLED) {
+		complete_later(modem, cb, data, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+		return;
+	}
+
+	if (!uqmi_service_find(modem->qmi, QMI_SERVICE_WDS)) {
+		complete_later(modem, cb, data, MODEM_ERR_UNSUPPORTED, "WDS is not available");
+		return;
+	}
+
+	cc = talloc_zero(bearer, struct connect_ctx);
+	talloc_set_destructor(cc, cc_destructor);
+	cc->start.cb = cc_start_cb;
+	cc->bearer = bearer;
+	cc->cb = cb;
+	cc->cb_data = data;
+	/* MM: mm_3gpp_normalize_ip_family(): no family preference (and IPv4) if none was requested */
+	if (ip == IP_TYPE_ANY) {
+		cc->no_ip_family_pref = true;
+		ip = IP_TYPE_IPV4;
+	}
+	cc->ipv4 = ip == IP_TYPE_IPV4 || ip == IP_TYPE_IPV4V6;
+	cc->ipv6 = ip == IP_TYPE_IPV6 || ip == IP_TYPE_IPV4V6;
+	cc->step = CS_PORT;
+
+	/* Clear previous connection error, if any */
+	memset(&bearer->error, 0, sizeof(bearer->error));
+	memset(&bearer->fam[0].err, 0, sizeof(bearer->fam[0].err));
+	memset(&bearer->fam[1].err, 0, sizeof(bearer->fam[1].err));
+	bearer->cc = cc;
+	modem_log(modem, LOGL_INFO, "bearer %s: connecting (apn '%s', ip type %s)...", bearer->ubus.name,
+		  bearer->props.apn ? bearer->props.apn : "", uqmid_ip_type_name(bearer->props.ip_type));
+	bearer_set_status(bearer, BEARER_CONNECTING);
+
+	/* not from within this call */
+	uloop_timeout_set(&cc->start, 0);
+}
+
+/*****************************************************************************/
+/* disconnect */
+
+void uqmid_bearer_disconnect(struct bearer *bearer, bearer_cb cb, void *data)
+{
+	struct modem *modem = bearer->modem;
+	struct bearer_waiter *w;
+
+	/* If already disconnected, done */
+	if (bearer->status == BEARER_DISCONNECTED) {
+		complete_later(modem, cb, data, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	w = talloc_zero(bearer, struct bearer_waiter);
+	w->cb = cb;
+	w->data = data;
+	list_add_tail(&w->list, &bearer->waiters);
+
+	/* already on its way down */
+	if (bearer->status == BEARER_DISCONNECTING)
+		return;
+
+	/* If currently connecting, try to cancel that operation, and wait to get disconnected. */
+	if (bearer->status == BEARER_CONNECTING) {
+		if (bearer->cc) {
+			bearer->cc->cancel = true;
+			bearer_set_status(bearer, BEARER_DISCONNECTING);
+			/* the connect is cancelled at its next step (a request is in flight) */
+		}
+		return;
+	}
+
+	/* Disconnecting! */
+	modem_log(modem, LOGL_INFO, "bearer %s: disconnecting...", bearer->ubus.name);
+	if (!bearer_has_connection(bearer)) {
+		/* no need to disconnect: QMI bearer is already disconnected */
+		bearer_disconnected(bearer);
+		return;
+	}
+	bearer_stop_network(bearer, false);
+}
+
+/*****************************************************************************/
+/* indications and the registration (MM: packet_service_status_indication_cb(), report_connection_status(),
+ * modem_3gpp_registration_state_changed()) */
+
+static void force_disconnect_cb(struct uloop_timeout *t)
+{
+	struct bearer *bearer = container_of(t, struct bearer, force_timer);
+
+	if (bearer->status != BEARER_CONNECTED)
+		return;
+
+	bearer->error = bearer->force_error;
+	/* the network was lost (or must not be used anymore): drop the connection, ignoring errors */
+	modem_log(bearer->modem, LOGL_INFO, "bearer %s: forcing disconnection: %s", bearer->ubus.name,
+		  bearer->error.message);
+	bearer_stop_network(bearer, true);
+}
+
+/* MM: mm_base_bearer_disconnect_force(). Never from within an indication callback. */
+static void bearer_disconnect_force(struct bearer *bearer, const char *name, const char *message)
+{
+	if (bearer->force_timer.pending)
+		return;
+
+	set_error(&bearer->force_error, name, "%s", message);
+	if (bearer->status == BEARER_CONNECTING) {
+		/* MM: the connection attempt is cancelled and the bearer ends up disconnected */
+		if (bearer->cc && !bearer->cc->cancel) {
+			bearer->cc->cancel = true;
+			set_error(&bearer->error, name, "%s", message);
+			bearer_set_status(bearer, BEARER_DISCONNECTING);
+		}
+		return;
+	}
+
+	bearer->force_timer.cb = force_disconnect_cb;
+	uloop_timeout_set(&bearer->force_timer, 0);
+}
+
+static void packet_service_status_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct bearer *bearer = data;
+	struct qmi_wds_packet_service_status_indication res = {};
+	struct conn_error e = {};
+
+	if (qmi_parse_wds_packet_service_status_indication(msg, &res) || !res.set.connection_status)
+		return;
+
+	if (res.data.connection_status.status == QMI_WDS_CONNECTION_STATUS_SUSPENDED)
+		bearer->suspended = true;
+	else if (res.data.connection_status.status == QMI_WDS_CONNECTION_STATUS_CONNECTED)
+		bearer->suspended = false;
+
+	if (res.data.connection_status.status != QMI_WDS_CONNECTION_STATUS_DISCONNECTED ||
+	    bearer->status != BEARER_CONNECTED)
+		return;
+
+	if (res.set.verbose_call_end_reason ||  res.set.call_end_reason) {
+		struct qmi_wds_start_network_response sr = {};
+
+		/* the call end reasons are the same */
+		sr.set.verbose_call_end_reason = res.set.verbose_call_end_reason;
+		sr.data.verbose_call_end_reason.type = res.data.verbose_call_end_reason.type;
+		sr.data.verbose_call_end_reason.reason = res.data.verbose_call_end_reason.reason;
+		sr.set.call_end_reason = res.set.call_end_reason;
+		sr.data.call_end_reason = res.data.call_end_reason;
+		error_from_start_network(&e, true, &sr);
+	} else {
+		set_error(&e, "unknown", "Call failed");
+	}
+
+	modem_log(bearer->modem, LOGL_NOTICE, "bearer %s: the network disconnected: %s", bearer->ubus.name, e.message);
+	bearer_disconnect_force(bearer, e.name, e.message);
+}
+
+static void unreg_cb(struct uloop_timeout *t)
+{
+	struct bearer *bearer = container_of(t, struct bearer, unreg_timer);
+
+	bearer_disconnect_force(bearer, "unregistered", "forcing bearer disconnection, not registered in 3GPP network");
+}
+
+void uqmid_bearers_registration_changed(struct modem *modem)
+{
+	struct bearer *bearer;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		enum conn_forbidden reason;
+
+		if (bearer->status == BEARER_DISCONNECTED || bearer->status == BEARER_DISCONNECTING)
+			continue;
+
+		reason = uqmid_3gpp_connection_forbidden(modem, bearer->props.allow_roaming);
+		if (reason == CONN_FORBIDDEN_NONE) {
+			uloop_timeout_cancel(&bearer->unreg_timer);
+			continue;
+		}
+
+		/* Modem is roaming and roaming not allowed, or emergency services only: report right away */
+		if (reason == CONN_FORBIDDEN_ROAMING || reason == CONN_FORBIDDEN_EMERGENCY_ONLY) {
+			uloop_timeout_cancel(&bearer->unreg_timer);
+			modem_log(modem, LOGL_INFO, "bearer %s not allowed to connect, %s", bearer->ubus.name,
+				  reason == CONN_FORBIDDEN_ROAMING ? "registered in roaming 3GPP network" :
+				  "emergency services only");
+			bearer_disconnect_force(bearer, reason == CONN_FORBIDDEN_ROAMING ? "roaming-not-allowed" :
+							 "emergency-only",
+						reason == CONN_FORBIDDEN_ROAMING ?
+						"Registered in roaming network, and roaming not allowed" :
+						"Emergency services only");
+			continue;
+		}
+
+		/* Modem reports being unregistered. If there is already a notification pending, nothing to do. */
+		if (bearer->unreg_timer.pending)
+			continue;
+
+		/* If the bearer is not connected, report right away */
+		if (bearer->status != BEARER_CONNECTED) {
+			modem_log(modem, LOGL_INFO, "bearer %s not allowed to connect, not registered in 3GPP network",
+				  bearer->ubus.name);
+			bearer_disconnect_force(bearer, "unregistered",
+						"Not registered in the network");
+			continue;
+		}
+
+		/* Otherwise, setup the new timeout */
+		modem_log(modem, LOGL_INFO, "connected bearer %s not registered in 3GPP network", bearer->ubus.name);
+		bearer->unreg_timer.cb = unreg_cb;
+		uloop_timeout_set(&bearer->unreg_timer, DEFERRED_UNREGISTRATION_TIMEOUT_MS);
+	}
+}
+
+/*****************************************************************************/
+/* bearers of the modem */
+
+struct bearer *uqmid_bearer_find(struct modem *modem, const char *path)
+{
+	struct bearer *bearer;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		if (bearer->ubus.name && !strcmp(bearer->ubus.name, path))
+			return bearer;
+	}
+
+	return NULL;
+}
+
+static bool str_eq(const char *a, const char *b)
+{
+	return !strcmp(a ? a : "", b ? b : "");
+}
+
+/* MM: mm_bearer_list_find_by_properties(): the same settings */
+struct bearer *uqmid_bearer_find_matching(struct modem *modem, const struct bearer_props *props)
+{
+	struct bearer *bearer;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		const struct bearer_props *p = &bearer->props;
+
+		if (str_eq(p->apn, props->apn) && str_eq(p->user, props->user) && str_eq(p->password, props->password) &&
+		    p->ip_type == props->ip_type && p->auth == props->auth && p->allow_roaming == props->allow_roaming &&
+		    p->profile_id == props->profile_id)
+			return bearer;
+	}
+
+	return NULL;
+}
+
+const char *uqmid_bearer_path(struct bearer *bearer)
+{
+	return bearer->ubus.name;
+}
+
+enum bearer_status uqmid_bearer_status(struct bearer *bearer)
+{
+	return bearer->status;
+}
+
+void uqmid_bearer_add_connection_error(struct bearer *bearer, struct blob_buf *bb, const char *name)
+{
+	if (bearer->error.set)
+		conn_error_add(bb, name, &bearer->error);
+}
+
+unsigned int uqmid_bearers_list(struct modem *modem, struct bearer **out, unsigned int max)
+{
+	struct bearer *bearer;
+	unsigned int n = 0;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		if (n < max)
+			out[n++] = bearer;
+	}
+
+	return n;
+}
+
+void uqmid_bearers_add_paths(struct modem *modem, struct blob_buf *bb, const char *name)
+{
+	struct bearer *bearer;
+	void *a = blobmsg_open_array(bb, name);
+
+	list_for_each_entry(bearer, &modem->bearers, list)
+		blobmsg_add_string(bb, NULL, bearer->ubus.name);
+	blobmsg_close_array(bb, a);
+}
+
+/*****************************************************************************/
+/* ubus: bearer object */
+
+static void add_ip_config(struct blob_buf *bb, const char *name, const struct bearer_family *fam)
+{
+	const struct ip_config *c = &fam->cfg;
+	void *t;
+	unsigned int i;
+
+	if (!fam->pdh || !c->valid)
+		return;
+
+	t = blobmsg_open_table(bb, name);
+	blobmsg_add_string(bb, "method", c->method);
+	if (c->address[0]) {
+		blobmsg_add_string(bb, "address", c->address);
+		blobmsg_add_u32(bb, "prefix", c->prefix);
+	}
+	if (c->gateway[0])
+		blobmsg_add_string(bb, "gateway", c->gateway);
+	for (i = 0; i < 3; i++) {
+		char key[8];
+
+		if (!c->dns[i][0])
+			continue;
+		snprintf(key, sizeof(key), "dns%u", i + 1);
+		blobmsg_add_string(bb, key, c->dns[i]);
+	}
+	if (c->mtu)
+		blobmsg_add_u32(bb, "mtu", c->mtu);
+	blobmsg_close_table(bb, t);
+}
+
+/* uqmid extension: "pcscf" (IPv6 then IPv4 addresses) and "pcscf_fqdn", the keys are omitted when empty */
+static void add_pcscf(struct blob_buf *bb, const struct bearer *bearer)
+{
+	static const int order[2] = { 1, 0 };
+	unsigned int i, f, n = 0;
+	void *a;
+
+	for (f = 0; f < 2; f++)
+		if (bearer->fam[f].pdh)
+			n += bearer->fam[f].pcscf.n_addr;
+	if (n) {
+		a = blobmsg_open_array(bb, "pcscf");
+		for (f = 0; f < 2; f++) {
+			const struct bearer_family *fam = &bearer->fam[order[f]];
+
+			if (!fam->pdh)
+				continue;
+			for (i = 0; i < fam->pcscf.n_addr; i++)
+				blobmsg_add_string(bb, NULL, fam->pcscf.addr[i]);
+		}
+		blobmsg_close_array(bb, a);
+	}
+
+	n = 0;
+	for (f = 0; f < 2; f++)
+		if (bearer->fam[f].pdh)
+			n += bearer->fam[f].pcscf.n_fqdn;
+	if (n) {
+		a = blobmsg_open_array(bb, "pcscf_fqdn");
+		for (f = 0; f < 2; f++) {
+			const struct bearer_family *fam = &bearer->fam[order[f]];
+
+			if (!fam->pdh)
+				continue;
+			for (i = 0; i < fam->pcscf.n_fqdn; i++) {
+				unsigned int j;
+				bool dup = false;
+
+				/* the FQDN list may come with both families */
+				for (j = 0; j < f && !dup; j++) {
+					const struct bearer_family *o = &bearer->fam[order[j]];
+					unsigned int k;
+
+					for (k = 0; o->pdh && k < o->pcscf.n_fqdn; k++)
+						if (!strcmp(o->pcscf.fqdn[k], fam->pcscf.fqdn[i]))
+							dup = true;
+				}
+				if (!dup)
+					blobmsg_add_string(bb, NULL, fam->pcscf.fqdn[i]);
+			}
+		}
+		blobmsg_close_array(bb, a);
+	}
+}
+
+static void bearer_add_properties(struct bearer *bearer, struct blob_buf *bb)
+{
+	struct modem *modem = bearer->modem;
+	const struct bearer_props *p = &bearer->props;
+	struct timespec now;
+	void *t;
+
+	blobmsg_add_string(bb, "path", bearer->ubus.name);
+	blobmsg_add_u32(bb, "index", bearer->index);
+	blobmsg_add_string(bb, "modem", modem->ubus.name ? modem->ubus.name : "");
+	blobmsg_add_string(bb, "status", status_name(bearer->status));
+	/* MM: Interface is the name of the net port while connected */
+	blobmsg_add_string(bb, "interface",
+			   bearer->port >= 0 && bearer->status != BEARER_DISCONNECTED ?
+			   modem->net_ports[bearer->port].ifname : "");
+	blobmsg_add_u8(bb, "connected", bearer->status == BEARER_CONNECTED);
+	blobmsg_add_u8(bb, "suspended", bearer->suspended);
+	if (bearer->error.set)
+		conn_error_add(bb, "connection_error", &bearer->error);
+	if (bearer->status == BEARER_CONNECTED) {
+		add_ip_config(bb, "ip4_config", &bearer->fam[0]);
+		add_ip_config(bb, "ip6_config", &bearer->fam[1]);
+		add_pcscf(bb, bearer);
+	}
+
+	/* MM: Stats (the duration of the connection) */
+	t = blobmsg_open_table(bb, "stats");
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	blobmsg_add_u32(bb, "duration", bearer->status == BEARER_CONNECTED ? now.tv_sec - bearer->connected_at.tv_sec : 0);
+	blobmsg_close_table(bb, t);
+
+	blobmsg_add_u32(bb, "ip_timeout", 20);
+	blobmsg_add_string(bb, "bearer_type", "default");
+
+	/* MM: Properties (the password is not shown) */
+	t = blobmsg_open_table(bb, "properties");
+	blobmsg_add_string(bb, "apn", p->apn ? p->apn : "");
+	blobmsg_add_string(bb, "ip_type", uqmid_ip_type_name(p->ip_type));
+	if (p->auth >= 0)
+		uqmid_add_allowed_auth(bb, "allowed_auth", p->auth);
+	blobmsg_add_string(bb, "user", p->user ? p->user : "");
+	blobmsg_add_u8(bb, "allow_roaming", p->allow_roaming);
+	if (p->profile_id >= 0)
+		blobmsg_add_u32(bb, "profile_id", p->profile_id);
+	blobmsg_close_table(bb, t);
+}
+
+static int bearer_get(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		      const char *method, struct blob_attr *msg)
+{
+	struct bearer *bearer = container_of(obj, struct bearer, ubus);
+
+	blob_buf_init(&b, 0);
+	bearer_add_properties(bearer, &b);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+struct bearer_ureq {
+	struct bearer *bearer;
+	struct ubus_request_data req;
+};
+
+static void connect_done(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct bearer_ureq *ur = data;
+	struct blob_buf rb = {};
+
+	blob_buf_init(&rb, 0);
+	if (err) {
+		if (ur->bearer->error.set)
+			conn_error_add(&rb, "connection_error", &ur->bearer->error);
+	} else {
+		bearer_add_properties(ur->bearer, &rb);
+	}
+	uqmid_ubus_deferred_done(&ur->req, err, msg, rb.head);
+	blob_buf_free(&rb);
+	talloc_free(ur);
+}
+
+/** ubus call uqmid.modem.0.bearer.0 connect */
+static int bearer_connect(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct bearer *bearer = container_of(obj, struct bearer, ubus);
+	struct bearer_ureq *ur = talloc_zero(bearer, struct bearer_ureq);
+
+	ur->bearer = bearer;
+	ubus_defer_request(ctx, req, &ur->req);
+	modem_log(bearer->modem, LOGL_INFO, "processing user request to connect bearer %s...", bearer->ubus.name);
+	uqmid_bearer_connect(bearer, connect_done, ur);
+
+	return UBUS_STATUS_OK;
+}
+
+static void disconnect_done(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct bearer_ureq *ur = data;
+
+	uqmid_ubus_deferred_done(&ur->req, err, msg, NULL);
+	talloc_free(ur);
+}
+
+/** ubus call uqmid.modem.0.bearer.0 disconnect */
+static int bearer_disconnect(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			     const char *method, struct blob_attr *msg)
+{
+	struct bearer *bearer = container_of(obj, struct bearer, ubus);
+	struct bearer_ureq *ur;
+
+	/* If already disconnecting, return error, don't allow a second request. */
+	if (bearer->status == BEARER_DISCONNECTING)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS, "Bearer already being disconnected");
+
+	ur = talloc_zero(bearer, struct bearer_ureq);
+	ur->bearer = bearer;
+	ubus_defer_request(ctx, req, &ur->req);
+	modem_log(bearer->modem, LOGL_INFO, "processing user request to disconnect bearer %s...", bearer->ubus.name);
+	uqmid_bearer_disconnect(bearer, disconnect_done, ur);
+
+	return UBUS_STATUS_OK;
+}
+
+static struct ubus_method bearer_methods[] = {
+	UBUS_METHOD_NOARG("get", bearer_get),
+	UBUS_METHOD_NOARG("connect", bearer_connect),
+	UBUS_METHOD_NOARG("disconnect", bearer_disconnect),
+};
+
+static struct ubus_object_type bearer_object_type = UBUS_OBJECT_TYPE("uqmid_bearer", bearer_methods);
+
+/*****************************************************************************/
+/* create and delete */
+
+static void props_copy(struct bearer *bearer, const struct bearer_props *props)
+{
+	struct bearer_props *p = &bearer->props;
+
+	*p = *props;
+	p->apn = props->apn ? talloc_strdup(bearer, props->apn) : NULL;
+	p->user = props->user ? talloc_strdup(bearer, props->user) : NULL;
+	p->password = props->password ? talloc_strdup(bearer, props->password) : NULL;
+}
+
+enum modem_error uqmid_bearer_create(struct modem *modem, const struct bearer_props *props, struct bearer **out,
+				     const char **msg)
+{
+	struct bearer *bearer;
+	struct blob_buf nb = {};
+	unsigned int n = 0;
+	int ret;
+
+	list_for_each_entry(bearer, &modem->bearers, list)
+		n++;
+	if (n >= MAX_BEARERS) {
+		*msg = "Cannot add new bearer: already reached maximum";
+		return MODEM_ERR_FAILED;
+	}
+
+	bearer = talloc_zero(modem, struct bearer);
+	bearer->modem = modem;
+	bearer->index = next_bearer_index++;
+	bearer->status = BEARER_DISCONNECTED;
+	bearer->port = -1;
+	INIT_LIST_HEAD(&bearer->waiters);
+	props_copy(bearer, props);
+
+	bearer->ubus.name = talloc_asprintf(bearer, "%s.bearer.%u", modem->ubus.name, bearer->index);
+	bearer->ubus.type = &bearer_object_type;
+	bearer->ubus.methods = bearer_methods;
+	bearer->ubus.n_methods = ARRAY_SIZE(bearer_methods);
+	ret = ubus_add_object(ubus_ctx, &bearer->ubus);
+	if (ret) {
+		LOG_ERROR("failed to publish ubus object '%s' (ret = %d).\n", bearer->ubus.name, ret);
+		talloc_free(bearer);
+		*msg = "Couldn't publish the bearer";
+		return MODEM_ERR_FAILED;
+	}
+
+	list_add_tail(&bearer->list, &modem->bearers);
+	modem_log(modem, LOGL_INFO, "added bearer %s (apn '%s', ip type %s)", bearer->ubus.name,
+		  props->apn ? props->apn : "", uqmid_ip_type_name(props->ip_type));
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", bearer->ubus.name);
+	modem_notify(modem, "bearer.added", &nb);
+	blob_buf_free(&nb);
+
+	*out = bearer;
+	return MODEM_ERR_NONE;
+}
+
+static void bearer_free(struct bearer *bearer)
+{
+	struct modem *modem = bearer->modem;
+	struct blob_buf nb = {};
+
+	uloop_timeout_cancel(&bearer->unreg_timer);
+	uloop_timeout_cancel(&bearer->force_timer);
+	if (bearer->ubus.id)
+		ubus_remove_object(ubus_ctx, &bearer->ubus);
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", bearer->ubus.name);
+	modem_notify(modem, "bearer.removed", &nb);
+	blob_buf_free(&nb);
+
+	list_del(&bearer->list);
+	talloc_free(bearer);
+}
+
+struct delete_ctx {
+	struct modem *modem;
+	struct ubus_request_data req;
+	char *path;
+};
+
+static void delete_done(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct delete_ctx *dc = data;
+	struct bearer *bearer = uqmid_bearer_find(modem, dc->path);
+
+	if (!err && bearer) {
+		modem_log(modem, LOGL_INFO, "deleting bearer %s", dc->path);
+		bearer_free(bearer);
+	}
+
+	uqmid_ubus_deferred_done(&dc->req, err, msg, NULL);
+	talloc_free(dc);
+}
+
+enum { CB_APN, CB_IP_TYPE, CB_AUTH, CB_USER, CB_PASSWORD, CB_ROAMING, CB_PROFILE, __CB_MAX };
+static const struct blobmsg_policy create_bearer_policy[__CB_MAX] = {
+	[CB_APN] = { .name = "apn", .type = BLOBMSG_TYPE_STRING },
+	[CB_IP_TYPE] = { .name = "ip_type", .type = BLOBMSG_TYPE_STRING },
+	[CB_AUTH] = { .name = "allowed_auth", .type = BLOBMSG_TYPE_UNSPEC },
+	[CB_USER] = { .name = "user", .type = BLOBMSG_TYPE_STRING },
+	[CB_PASSWORD] = { .name = "password", .type = BLOBMSG_TYPE_STRING },
+	[CB_ROAMING] = { .name = "allow_roaming", .type = BLOBMSG_TYPE_BOOL },
+	[CB_PROFILE] = { .name = "profile_id", .type = BLOBMSG_TYPE_INT32 },
+};
+
+/** ubus call uqmid.modem.0 create_bearer '{"apn":"internet","ip_type":"ipv4"}' -> {"path": "uqmid.modem.0.bearer.0"} */
+static int modem_create_bearer(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			       const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__CB_MAX];
+	struct bearer_props props;
+	struct bearer *bearer;
+	enum modem_error err;
+	const char *emsg = NULL;
+	void *tmp = talloc_new(NULL);
+
+	blobmsg_parse(create_bearer_policy, __CB_MAX, tb, blob_data(msg), blob_len(msg));
+
+	/* MM: the modem has to be enabled */
+	if (modem->mm_state < MODEM_STATE_ENABLED) {
+		talloc_free(tmp);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+	}
+
+	err = uqmid_bearer_props_parse(tmp, tb[CB_APN], tb[CB_IP_TYPE], tb[CB_AUTH], tb[CB_USER], tb[CB_PASSWORD],
+				       tb[CB_ROAMING], tb[CB_PROFILE], &props, &emsg);
+	if (!err)
+		err = uqmid_bearer_create(modem, &props, &bearer, &emsg);
+	talloc_free(tmp);
+	if (err)
+		return uqmid_ubus_reply_error(ctx, req, err, emsg);
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "path", bearer->ubus.name);
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+enum { DB_PATH, __DB_MAX };
+static const struct blobmsg_policy delete_bearer_policy[__DB_MAX] = {
+	[DB_PATH] = { .name = "path", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 delete_bearer '{"path": "uqmid.modem.0.bearer.0"}' (disconnects the bearer first) */
+static int modem_delete_bearer(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			       const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__DB_MAX];
+	struct bearer *bearer;
+	struct delete_ctx *dc;
+
+	blobmsg_parse(delete_bearer_policy, __DB_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[DB_PATH])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	bearer = uqmid_bearer_find(modem, blobmsg_get_string(tb[DB_PATH]));
+	if (!bearer)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_NOT_FOUND, "Cannot delete bearer: bearer not found");
+
+	dc = talloc_zero(modem, struct delete_ctx);
+	dc->modem = modem;
+	dc->path = talloc_strdup(dc, bearer->ubus.name);
+	ubus_defer_request(ctx, req, &dc->req);
+	modem_log(modem, LOGL_INFO, "processing user request to delete bearer %s...", dc->path);
+	uqmid_bearer_disconnect(bearer, delete_done, dc);
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method modem_bearer_methods[] = {
+	UBUS_METHOD("create_bearer", modem_create_bearer, create_bearer_policy),
+	UBUS_METHOD("delete_bearer", modem_delete_bearer, delete_bearer_policy),
+};
+
+const struct ubus_method *uqmid_bearer_modem_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_bearer_methods);
+	return modem_bearer_methods;
+}
+
+/*****************************************************************************/
+/* disable, removal of the modem */
+
+struct disc_all {
+	struct modem *modem;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+	unsigned int pending;
+	bool started;
+};
+
+static void disc_all_one(struct modem *modem, enum modem_error err, const char *msg, void *data)
+{
+	struct disc_all *da = data;
+
+	if (err)
+		modem_log(modem, LOGL_INFO, "couldn't disconnect a bearer while disabling: %s", msg ? msg : "");
+
+	if (--da->pending == 0 && da->started) {
+		void (*done)(struct modem *modem, void *data) = da->done;
+		void *ddata = da->data;
+
+		talloc_free(da);
+		done(modem, ddata);
+	}
+}
+
+void uqmid_bearers_disconnect_all(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct disc_all *da = talloc_zero(modem, struct disc_all);
+	struct bearer *bearer;
+
+	da->modem = modem;
+	da->done = done;
+	da->data = data;
+
+	list_for_each_entry(bearer, &modem->bearers, list) {
+		/* a connecting bearer is cancelled */
+		if (bearer->status == BEARER_DISCONNECTED)
+			continue;
+
+		da->pending++;
+		uqmid_bearer_disconnect(bearer, disc_all_one, da);
+	}
+
+	da->started = true;
+	if (!da->pending) {
+		talloc_free(da);
+		done(modem, data);
+	}
+}
+
+void uqmid_bearers_cleanup(struct modem *modem)
+{
+	struct bearer *bearer, *tmp;
+
+	laters_abort(modem);
+
+	list_for_each_entry_safe(bearer, tmp, &modem->bearers, list) {
+		struct bearer_waiter *w, *wtmp;
+
+		uloop_timeout_cancel(&bearer->unreg_timer);
+		uloop_timeout_cancel(&bearer->force_timer);
+
+		/* connect and disconnect requests which wait: the modem went away */
+		if (bearer->cc) {
+			bearer_cb cb = bearer->cc->cb;
+			void *data = bearer->cc->cb_data;
+
+			talloc_free(bearer->cc);
+			bearer->cc = NULL;
+			cb(modem, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), data);
+		}
+		list_for_each_entry_safe(w, wtmp, &bearer->waiters, list) {
+			list_del(&w->list);
+			w->cb(modem, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), w->data);
+			talloc_free(w);
+		}
+
+		/* the clients are released by the close of the device */
+		bearer->fam[0].wds = NULL;
+		bearer->fam[1].wds = NULL;
+		if (bearer->ubus.id)
+			ubus_remove_object(ubus_ctx, &bearer->ubus);
+		list_del(&bearer->list);
+		talloc_free(bearer);
+	}
+}

+/*****************************************************************************/
+/* registration state (MM: mm_iface_modem_3gpp_update_*_registration_state()) */
+
+/* MM: get_consolidated_reg_state() */
+static enum reg_state get_consolidated_reg_state(struct modem_3gpp *m)
+{
+#define IS_UNKNOWN_IDLE_DENIED(s) ((s) == REG_UNKNOWN || (s) == REG_IDLE || (s) == REG_DENIED)
+
+	if (m->cs == REG_HOME || m->cs == REG_ROAMING)
+		return m->cs;
+	if (m->ps == REG_HOME || m->ps == REG_ROAMING)
+		return m->ps;
+	if (m->eps == REG_HOME || m->eps == REG_ROAMING)
+		return m->eps;
+
+	/* Searching? */
+	if (m->cs == REG_SEARCHING || m->ps == REG_SEARCHING || m->eps == REG_SEARCHING)
+		return REG_SEARCHING;
+
+	/* If at least one state is DENIED and the others are UNKNOWN or IDLE, use DENIED */
+	if ((m->cs == REG_DENIED || m->ps == REG_DENIED || m->eps == REG_DENIED) && IS_UNKNOWN_IDLE_DENIED(m->cs) &&
+	    IS_UNKNOWN_IDLE_DENIED(m->ps) && IS_UNKNOWN_IDLE_DENIED(m->eps))
+		return REG_DENIED;
+
+	/* Emergency services? */
+	if (m->cs == REG_EMERGENCY_ONLY || m->ps == REG_EMERGENCY_ONLY || m->eps == REG_EMERGENCY_ONLY)
+		return REG_EMERGENCY_ONLY;
+
+	/* additional registration states reported on LTE, very low priority */
+	if (m->cs == REG_HOME_SMS_ONLY || m->cs == REG_ROAMING_SMS_ONLY || m->cs == REG_HOME_CSFB_NOT_PREFERRED ||
+	    m->cs == REG_ROAMING_CSFB_NOT_PREFERRED)
+		return m->cs;
+
+	/* Idle? */
+	if (m->cs == REG_IDLE || m->ps == REG_IDLE || m->eps == REG_IDLE)
+		return REG_IDLE;
+
+	return REG_UNKNOWN;
+#undef IS_UNKNOWN_IDLE_DENIED
+}
+
+/* the enable goes on once the registration state is published */
+static void m3_enable_continue(struct modem_3gpp *m);
+
+static void m3_registered_reloaded(struct modem_3gpp *m, void *data)
+{
+	enum reg_state new_state = (enum reg_state)(long)data;
+	enum reg_state old = m->state;
+
+	m->reloading = false;
+	if (!m->enabled) {
+		m3_enable_continue(m);
+		return;
+	}
+
+	modem_log(m->modem, LOGL_INFO, "3GPP registration state changed (%s -> %s), operator '%s' '%s'",
+		  reg_state_name(old), reg_state_name(new_state), m->operator_code ? m->operator_code : "",
+		  m->operator_name ? m->operator_name : "");
+	modem_log(m->modem, LOGL_INFO, "consolidated registration state: cs '%s', ps '%s', eps '%s' --> '%s'",
+		  reg_state_name(m->cs), reg_state_name(m->ps), reg_state_name(m->eps), reg_state_name(new_state));
+
+	m->state = new_state;
+	/* MM: the state is REGISTERED only after the operator is known */
+	uqmid_modem_update_subsystem_state(m->modem, MODEM_STATE_REGISTERED, MODEM_CHANGE_REASON_UNKNOWN);
+	m3_notify_registration(m, old);
+	uqmid_bearers_registration_changed(m->modem);
+	m3_enable_continue(m);
+}
+
+static void m3_refresh_signal(struct modem_3gpp *m);
+
+/* MM: update_registration_state() */
+static void m3_update_registration_state(struct modem_3gpp *m, enum reg_state new_state)
+{
+	enum reg_state old = m->state;
+
+	if (!m->enabled)
+		return;
+
+	/* Only set new state if different */
+	if (new_state == old)
+		return;
+
+	if (reg_state_is_registered(new_state)) {
+		/* If already reloading registration info, skip it */
+		if (m->reloading)
+			return;
+
+		/* the updates are ignored while disabling (and before the modem is enabled) */
+		if (m->modem->mm_state < MODEM_STATE_ENABLING) {
+			modem_log(m->modem, LOGL_DEBUG, "3GPP registration state change ignored as modem isn't enabled");
+			return;
+		}
+
+		modem_log(m->modem, LOGL_INFO, "3GPP registration state changed (%s -> registering)",
+			  reg_state_name(old));
+		/* Reload current registration info. ONLY update the state to REGISTERED after having loaded the
+		 * operator code/name. */
+		m->reloading = true;
+		m3_reload_registration_info(m, m3_registered_reloaded, (void *)(long)new_state);
+		m3_refresh_signal(m);
+		return;
+	}
+
+	modem_log(m->modem, LOGL_INFO, "3GPP registration state changed (%s -> %s)", reg_state_name(old),
+		  reg_state_name(new_state));
+	modem_log(m->modem, LOGL_INFO, "consolidated registration state: cs '%s', ps '%s', eps '%s' --> '%s'",
+		  reg_state_name(m->cs), reg_state_name(m->ps), reg_state_name(m->eps), reg_state_name(new_state));
+
+	/* update_non_registered_state(): Not registered neither in home nor roaming network */
+	TALLOC_FREE(m->operator_code);
+	TALLOC_FREE(m->operator_name);
+	m->state = new_state;
+	uqmid_modem_update_subsystem_state(m->modem,
+					   new_state == REG_SEARCHING ? MODEM_STATE_SEARCHING : MODEM_STATE_ENABLED,
+					   MODEM_CHANGE_REASON_UNKNOWN);
+	m3_notify_registration(m, old);
+	uqmid_bearers_registration_changed(m->modem);
+}
+
+static void m3_apply_registration(struct modem_3gpp *m)
+{
+	m3_update_registration_state(m, get_consolidated_reg_state(m));
+}
+
+static void m3_set_act(struct modem_3gpp *m, uint32_t act)
+{
+	if (!m->enabled || act == m->act)
+		return;
+
+	m->act = act;
+}
+
+/* a registration which was requested: all states are idle (MM: register_in_network_context_complete_failed()) */
+static void m3_set_idle(struct modem_3gpp *m)
+{
+	m->cs = m->ps = m->eps = REG_IDLE;
+	m3_apply_registration(m);
+	m3_set_act(m, 0);
+}
+
+static void m3_cache_operator(struct modem_3gpp *m, const char *op_id, const char *desc, bool new_desc)
+{
+	bool updated = false;
+
+	if (op_id && (!m->op_id || strcmp(m->op_id, op_id))) {
+		m3_set_str(m->modem, &m->op_id, op_id);
+		updated = true;
+	}
+	if (new_desc) {
+		if (!desc || !m->op_desc || strcmp(m->op_desc, desc)) {
+			m3_set_str(m->modem, &m->op_desc, desc);
+			updated = true;
+		}
+	}
+
+	if (updated && reg_state_is_registered(m->state) && !m->reloading)
+		m3_reload_registration_info(m, NULL, NULL);
+}
+
+/*****************************************************************************/
+/* system info (MM: common_process_system_info_3gpp(), mm_modem_registration_state_from_qmi_system_info()) */
+
+struct sysinfo_rat {
+	bool valid;
+	uint8_t status;
+	bool domain_valid;
+	uint8_t domain;
+	bool roaming_valid;
+	uint8_t roaming;
+	bool forbidden_valid;
+	bool forbidden;
+	bool netid_valid;
+	char mcc[4];
+	char mnc[4];
+};
+
+struct sysinfo {
+	struct sysinfo_rat gsm, wcdma, lte;
+};
+
+#define COPY_RAT(si, dst, r, status_member, info_member) do {						\
+	if ((r)->set.status_member) {									\
+		(si)->dst.valid = true;									\
+		(si)->dst.status = (r)->data.status_member.service_status;				\
+	}												\
+	if ((r)->set.info_member) {									\
+		(si)->dst.domain_valid = (r)->data.info_member.domain_valid;				\
+		(si)->dst.domain = (r)->data.info_member.domain;					\
+		(si)->dst.roaming_valid = (r)->data.info_member.roaming_status_valid;			\
+		(si)->dst.roaming = (r)->data.info_member.roaming_status;				\
+		(si)->dst.forbidden_valid = (r)->data.info_member.forbidden_valid;			\
+		(si)->dst.forbidden = (r)->data.info_member.forbidden;					\
+		(si)->dst.netid_valid = (r)->data.info_member.network_id_valid &&			\
+					(r)->data.info_member.mcc && (r)->data.info_member.mnc;		\
+		if ((si)->dst.netid_valid) {								\
+			memcpy((si)->dst.mcc, (r)->data.info_member.mcc, 3);				\
+			memcpy((si)->dst.mnc, (r)->data.info_member.mnc, 3);				\
+		}											\
+	}												\
+} while (0)
+
+static void sysinfo_from_response(struct sysinfo *si, const struct qmi_nas_get_system_info_response *r)
+{
+	COPY_RAT(si, gsm, r, gsm_service_status, gsm_system_info_v2);
+	COPY_RAT(si, wcdma, r, wcdma_service_status, wcdma_system_info_v2);
+	COPY_RAT(si, lte, r, lte_service_status, lte_system_info_v2);
+}
+
+static void sysinfo_from_indication(struct sysinfo *si, const struct qmi_nas_system_info_indication *r)
+{
+	COPY_RAT(si, gsm, r, gsm_service_status, gsm_system_info_v2);
+	COPY_RAT(si, wcdma, r, wcdma_service_status, wcdma_system_info_v2);
+	COPY_RAT(si, lte, r, lte_service_status, lte_system_info_v2);
+}
+
+/* MM: process_common_info() */
+static void sysinfo_common(struct modem *modem, const char *name, const struct sysinfo_rat *r, enum reg_state *cs,
+			   enum reg_state *ps, char *op_id)
+{
+	enum reg_state tmp;
+
+	/* If power save service status reported the modem is not actively searching for a network, "idle" */
+	if (r->status == QMI_NAS_SERVICE_STATUS_POWER_SAVE) {
+		if (cs)
+			*cs = REG_IDLE;
+		if (ps)
+			*ps = REG_IDLE;
+		return;
+	}
+
+	/* If no service status reported, the modem is actively searching for a network, "searching" */
+	if (r->status == QMI_NAS_SERVICE_STATUS_NONE) {
+		if (cs)
+			*cs = REG_SEARCHING;
+		if (ps)
+			*ps = REG_SEARCHING;
+		return;
+	}
+
+	/* When forbidden, the service status is usually reported as 'limited' or 'limited-regional'. If the
+	 * forbidden flag is explicitly reported, we report 'denied', otherwise 'emergency-services-only' */
+	if (r->forbidden_valid && r->forbidden) {
+		if (cs)
+			*cs = REG_DENIED;
+		if (ps)
+			*ps = REG_DENIED;
+	} else if (r->status == QMI_NAS_SERVICE_STATUS_LIMITED || r->status == QMI_NAS_SERVICE_STATUS_LIMITED_REGIONAL) {
+		if (cs)
+			*cs = REG_EMERGENCY_ONLY;
+		if (ps)
+			*ps = REG_EMERGENCY_ONLY;
+	} else if (r->domain_valid && r->domain != QMI_NAS_NETWORK_SERVICE_DOMAIN_NONE &&
+		   r->domain != QMI_NAS_NETWORK_SERVICE_DOMAIN_UNKNOWN &&
+		   r->status == QMI_NAS_SERVICE_STATUS_AVAILABLE) {
+		/* On a successful registration (either home or roaming) we require a valid domain and "available"
+		 * service status. (QMI_NAS_NETWORK_SERVICE_DOMAIN_CAMPED has the value 4 of "unknown" here.) */
+		tmp = r->roaming_valid && r->roaming == QMI_NAS_ROAMING_STATUS_ON ? REG_ROAMING : REG_HOME;
+
+		if (r->domain == QMI_NAS_NETWORK_SERVICE_DOMAIN_CS) {
+			if (cs)
+				*cs = tmp;
+			if (ps)
+				*ps = REG_IDLE;
+		} else if (r->domain == QMI_NAS_NETWORK_SERVICE_DOMAIN_PS) {
+			if (cs)
+				*cs = REG_IDLE;
+			if (ps)
+				*ps = tmp;
+		} else if (r->domain == QMI_NAS_NETWORK_SERVICE_DOMAIN_CS_PS) {
+			if (cs)
+				*cs = tmp;
+			if (ps)
+				*ps = tmp;
+		}
+	} else {
+		/* Issue a warning in case this ever happens and this logic needs to be updated */
+		modem_log(modem, LOGL_NOTICE, "unexpected %s system info: domain valid %s, domain %u, service status %u",
+			  name, r->domain_valid ? "yes" : "no", r->domain, r->status);
+		return;
+	}
+
+	/* Network ID report also in the case of registration denial */
+	if (r->netid_valid && op_id) {
+		memcpy(op_id, r->mcc, 3);
+		if ((uint8_t)r->mnc[2] == 0xFF)
+			memcpy(op_id + 3, r->mnc, 2), op_id[5] = 0;
+		else
+			memcpy(op_id + 3, r->mnc, 3), op_id[6] = 0;
+	}
+}
+
+static enum reg_state unregistered_state_fallback(enum reg_state umts, enum reg_state gsm)
+{
+	/* For 3G and 2G unregistered states, SEARCHING if one of them reports it, otherwise DENIED if one of them
+	 * reports it, otherwise the 3G one if not unknown and finally the 2G one. */
+	if (umts == REG_SEARCHING || gsm == REG_SEARCHING)
+		return REG_SEARCHING;
+	if (umts == REG_DENIED || gsm == REG_DENIED)
+		return REG_DENIED;
+	if (umts != REG_UNKNOWN)
+		return umts;
+	return gsm;
+}
+
+static void m3_process_sysinfo(struct modem_3gpp *m, const struct sysinfo *si)
+{
+	enum reg_state gsm_cs = REG_UNKNOWN, gsm_ps = REG_UNKNOWN, wcdma_cs = REG_UNKNOWN, wcdma_ps = REG_UNKNOWN;
+	enum reg_state lte_eps = REG_UNKNOWN, cs = REG_UNKNOWN, ps = REG_UNKNOWN, eps = REG_UNKNOWN;
+	char gsm_op[8] = "", wcdma_op[8] = "", lte_op[8] = "", op_id[8] = "";
+	uint32_t act = 0;
+	bool reg_info_set = false;
+
+	if (si->lte.valid)
+		sysinfo_common(m->modem, "LTE", &si->lte, NULL, &lte_eps, lte_op);
+	if (si->wcdma.valid)
+		sysinfo_common(m->modem, "WCDMA", &si->wcdma, &wcdma_cs, &wcdma_ps, wcdma_op);
+	if (si->gsm.valid)
+		sysinfo_common(m->modem, "GSM", &si->gsm, &gsm_cs, &gsm_ps, gsm_op);
+
+#define REG_INFO_SET(OP) do {			\
+	if (!reg_info_set && (OP)[0]) {		\
+		reg_info_set = true;		\
+		strcpy(op_id, (OP));		\
+	}					\
+} while (0)
+
+	/* Process 4G data */
+	eps = lte_eps;
+	if (reg_state_is_registered(lte_eps)) {
+		REG_INFO_SET(lte_op);
+		act |= ACT_LTE;
+	}
+
+	/* Process 2G/3G data */
+	if (reg_state_is_registered(wcdma_ps)) {
+		ps = wcdma_ps;
+		act |= ACT_UMTS;
+		REG_INFO_SET(wcdma_op);
+	} else if (reg_state_is_registered(gsm_ps)) {
+		ps = gsm_ps;
+		act |= ACT_GPRS;
+		REG_INFO_SET(gsm_op);
+	} else {
+		ps = unregistered_state_fallback(wcdma_ps, gsm_ps);
+	}
+	if (reg_state_is_registered(wcdma_cs)) {
+		cs = wcdma_cs;
+		act |= ACT_UMTS;
+		REG_INFO_SET(wcdma_op);
+	} else if (reg_state_is_registered(gsm_cs)) {
+		cs = gsm_cs;
+		act |= ACT_GSM;
+		REG_INFO_SET(gsm_op);
+	} else {
+		cs = unregistered_state_fallback(wcdma_cs, gsm_cs);
+	}
+#undef REG_INFO_SET
+
+	/* Cache current operator ID */
+	if (op_id[0]) {
+		m3_set_str(m->modem, &m->op_id, op_id);
+		TALLOC_FREE(m->op_desc);
+	}
+
+	m->cs = cs;
+	m->ps = ps;
+	m->eps = eps;
+	m3_apply_registration(m);
+
+	/* Update act */
+	m3_set_act(m, act);
+
+	/* Update operator name and operator description */
+	if (reg_state_is_registered(m->state) && !m->reloading)
+		m3_reload_registration_info(m, NULL, NULL);
+}
+
+/*****************************************************************************/
+/* serving system (MM: common_process_serving_system_3gpp()) */
+
+struct ss_info {
+	bool has_ss;
+	uint8_t reg, cs, ps, sel;
+	int8_t ifaces[16];
+	unsigned int n_ifaces;
+	uint8_t dcap[16];
+	unsigned int n_dcap;
+	bool roaming_set;
+	uint8_t roaming;
+	bool plmn_set;
+	uint16_t mcc, mnc;
+	char desc[64];
+	bool pcs_set;
+	bool pcs;
+	uint16_t pcs_mcc, pcs_mnc;
+};
+
+#define SS_COLLECT(NAME, TYPE)										\
+static void NAME(struct ss_info *si, const TYPE *r)							\
+{													\
+	unsigned int i;											\
+													\
+	if (r->set.serving_system) {									\
+		si->has_ss = true;									\
+		si->reg = r->data.serving_system.registration_state;					\
+		si->cs = r->data.serving_system.cs_attach_state;					\
+		si->ps = r->data.serving_system.ps_attach_state;					\
+		si->sel = r->data.serving_system.selected_network;					\
+		for (i = 0; i < r->data.serving_system.radio_interfaces_n && i < ARRAY_SIZE(si->ifaces); i++) \
+			si->ifaces[si->n_ifaces++] = r->data.serving_system.radio_interfaces[i];	\
+	}												\
+	for (i = 0; i < r->data.data_service_capability_n && i < ARRAY_SIZE(si->dcap); i++)		\
+		si->dcap[si->n_dcap++] = r->data.data_service_capability[i];				\
+	if (r->set.roaming_indicator) {									\
+		si->roaming_set = true;									\
+		si->roaming = r->data.roaming_indicator;						\
+	}												\
+	if (r->set.current_plmn) {									\
+		si->plmn_set = true;									\
+		si->mcc = r->data.current_plmn.mcc;							\
+		si->mnc = r->data.current_plmn.mnc;							\
+		snprintf(si->desc, sizeof(si->desc), "%s",						\
+			 r->data.current_plmn.description ? r->data.current_plmn.description : "");	\
+	}												\
+	if (r->set.mnc_pcs_digit_include_status) {							\
+		si->pcs_set = true;									\
+		si->pcs = r->data.mnc_pcs_digit_include_status.includes_pcs_digit;			\
+		si->pcs_mcc = r->data.mnc_pcs_digit_include_status.mcc;					\
+		si->pcs_mnc = r->data.mnc_pcs_digit_include_status.mnc;					\
+	}												\
+}
+
+SS_COLLECT(ss_from_response, struct qmi_nas_get_serving_system_response)
+SS_COLLECT(ss_from_indication, struct qmi_nas_serving_system_indication)
+
+/* MM: mm_modem_access_technology_from_qmi_radio_interface() */
+static uint32_t act_from_radio_interface(int8_t iface)
+{
+	switch (iface) {
+	case QMI_NAS_RADIO_INTERFACE_CDMA_1X: return ACT_1XRTT;
+	case QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO: return ACT_EVDO0;
+	case QMI_NAS_RADIO_INTERFACE_GSM: return ACT_GSM;
+	case QMI_NAS_RADIO_INTERFACE_UMTS: return ACT_UMTS;
+	case QMI_NAS_RADIO_INTERFACE_LTE: return ACT_LTE;
+	case QMI_NAS_RADIO_INTERFACE_5GNR: return ACT_5GNR;
+	default: return 0;
+	}
+}
+
+/* MM: mm_modem_access_technology_from_qmi_data_capability() */
+static uint32_t act_from_data_capability(uint8_t cap)
+{
+	switch (cap) {
+	case QMI_NAS_DATA_CAPABILITY_GPRS: return ACT_GPRS;
+	case QMI_NAS_DATA_CAPABILITY_EDGE: return ACT_EDGE;
+	case QMI_NAS_DATA_CAPABILITY_HSDPA: return ACT_HSDPA;
+	case QMI_NAS_DATA_CAPABILITY_HSUPA: return ACT_HSUPA;
+	case QMI_NAS_DATA_CAPABILITY_WCDMA: return ACT_UMTS;
+	case QMI_NAS_DATA_CAPABILITY_CDMA: return ACT_1XRTT;
+	case QMI_NAS_DATA_CAPABILITY_EVDO_REV_0: return ACT_EVDO0;
+	case QMI_NAS_DATA_CAPABILITY_EVDO_REV_A: return ACT_EVDOA;
+	case QMI_NAS_DATA_CAPABILITY_GSM: return ACT_GSM;
+	case QMI_NAS_DATA_CAPABILITY_EVDO_REV_B: return ACT_EVDOB;
+	case QMI_NAS_DATA_CAPABILITY_LTE: return ACT_LTE;
+	case QMI_NAS_DATA_CAPABILITY_HSDPA_PLUS:
+	case QMI_NAS_DATA_CAPABILITY_DC_HSDPA_PLUS: return ACT_HSPA_PLUS;
+	default: return 0;
+	}
+}
+
+/* MM: mm_modem_3gpp_registration_state_from_qmi_registration_state() */
+static enum reg_state reg_state_from_qmi(uint8_t attach, uint8_t reg, bool roaming)
+{
+	if (attach == QMI_NAS_ATTACH_STATE_UNKNOWN)
+		return REG_UNKNOWN;
+	if (attach == QMI_NAS_ATTACH_STATE_DETACHED)
+		return REG_IDLE;
+
+	switch (reg) {
+	case QMI_NAS_REGISTRATION_STATE_NOT_REGISTERED:
+		return REG_IDLE;
+	case QMI_NAS_REGISTRATION_STATE_REGISTERED:
+		return roaming ? REG_ROAMING : REG_HOME;
+	case QMI_NAS_REGISTRATION_STATE_NOT_REGISTERED_SEARCHING:
+		return REG_SEARCHING;
+	case QMI_NAS_REGISTRATION_STATE_REGISTRATION_DENIED:
+		return REG_DENIED;
+	default:
+		return REG_UNKNOWN;
+	}
+}
+
+static void m3_process_serving_system(struct modem_3gpp *m, const struct ss_info *si)
+{
+	enum reg_state cs, ps, state;
+	uint32_t act = 0;
+	unsigned int i;
+
+	if (!si->has_ss)
+		return;
+
+	if (si->n_dcap) {
+		for (i = 0; i < si->n_dcap; i++)
+			act |= act_from_data_capability(si->dcap[i]);
+	} else {
+		for (i = 0; i < si->n_ifaces; i++)
+			act |= act_from_radio_interface(si->ifaces[i]);
+	}
+
+	/* Only process 3GPP info. Seen the case already where 'selected_network' gives UNKNOWN but we still have
+	 * valid LTE info around. */
+	if (!(si->sel == QMI_NAS_NETWORK_TYPE_3GPP ||
+	      (si->sel == QMI_NAS_NETWORK_TYPE_UNKNOWN && (act & (ACT_GSM | ACT_GPRS | ACT_EDGE | ACT_UMTS | ACT_HSDPA |
+								   ACT_HSUPA | ACT_HSPA | ACT_HSPA_PLUS | ACT_LTE))))) {
+		bool updated = m->op_id || m->op_desc;
+
+		modem_log(m->modem, LOGL_DEBUG, "no 3GPP info given...");
+		TALLOC_FREE(m->op_id);
+		TALLOC_FREE(m->op_desc);
+		state = si->reg == QMI_NAS_REGISTRATION_STATE_NOT_REGISTERED_SEARCHING ? REG_SEARCHING : REG_UNKNOWN;
+		m->cs = m->ps = m->eps = state;
+		m3_apply_registration(m);
+		m3_set_act(m, 0);
+		if (updated && !reg_state_is_registered(m->state)) {
+			TALLOC_FREE(m->operator_code);
+			TALLOC_FREE(m->operator_name);
+		}
+		return;
+	}
+
+	/* Build MM registration states */
+	cs = reg_state_from_qmi(si->cs, si->reg, si->roaming_set && si->roaming == QMI_NAS_ROAMING_INDICATOR_STATUS_ON);
+	ps = reg_state_from_qmi(si->ps, si->reg, si->roaming_set && si->roaming == QMI_NAS_ROAMING_INDICATOR_STATUS_ON);
+
+	/* Get and cache operator ID/name */
+	if (si->plmn_set) {
+		char op_id[8];
+
+		/* When we don't have information about leading PCS digit, guess best */
+		if (si->mnc >= 100)
+			snprintf(op_id, sizeof(op_id), "%.3u%.3u", si->mcc, si->mnc);
+		else
+			snprintf(op_id, sizeof(op_id), "%.3u%.2u", si->mcc, si->mnc);
+		m3_cache_operator(m, op_id, si->desc, true);
+	}
+
+	/* If MNC comes with PCS digit, we must make sure the additional leading '0' is added */
+	if (si->pcs_set && si->pcs) {
+		char op_id[8];
+
+		snprintf(op_id, sizeof(op_id), "%.3u%.3u", si->pcs_mcc, si->pcs_mnc);
+		m3_cache_operator(m, op_id, NULL, false);
+	}
+
+	m->cs = cs;
+	m->ps = ps;
+	/* The "PS" state is the "EPS" one on LTE, unknown if not in LTE (or the old state would win) */
+	m->eps = act & ACT_LTE ? ps : REG_UNKNOWN;
+	m3_apply_registration(m);
+	m3_set_act(m, act);
+}
+
+/*****************************************************************************/
+/* registration checks (MM: modem_3gpp_run_registration_checks()) */
+
+struct check_ctx {
+	struct modem_3gpp *m;
+	void (*done)(struct modem_3gpp *m, int err, void *data);
+	void *data;
+};
+
+static void check_finish(struct check_ctx *cc, int err)
+{
+	struct modem_3gpp *m = cc->m;
+	void (*done)(struct modem_3gpp *m, int err, void *data) = cc->done;
+	void *data = cc->data;
+
+	talloc_free(cc);
+	if (done)
+		done(m, err, data);
+}
+
+static void get_serving_system_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct check_ctx *cc = req->cb_data;
+	struct qmi_nas_get_serving_system_response res = {};
+	struct ss_info si = {};
+
+	if (!msg || req->ret || qmi_parse_nas_get_serving_system_response(msg, &res)) {
+		modem_log(cc->m->modem, LOGL_DEBUG, "couldn't get the serving system: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+		check_finish(cc, req->ret ? req->ret : -EIO);
+		return;
+	}
+
+	if (cc->m->enabled) {
+		ss_from_response(&si, &res);
+		m3_process_serving_system(cc->m, &si);
+	}
+	check_finish(cc, 0);
+}
+
+static void get_system_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct check_ctx *cc = req->cb_data;
+	struct modem_3gpp *m = cc->m;
+	struct qmi_nas_get_system_info_response res = {};
+	struct sysinfo si = {};
+
+	if (!msg || req->ret || qmi_parse_nas_get_system_info_response(msg, &res)) {
+		/* MM: fall back to the serving system */
+		modem_log(m->modem, LOGL_DEBUG, "couldn't get the system info (%d/%s), using the serving system",
+			  req->ret, qmi_get_error_str(req->ret));
+		if (SEND_REQ(m->nas, qmi_set_nas_get_serving_system_request(_m), get_serving_system_cb, cc, 10000))
+			check_finish(cc, -EIO);
+		return;
+	}
+
+	if (m->enabled) {
+		sysinfo_from_response(&si, &res);
+		m3_process_sysinfo(m, &si);
+	}
+	check_finish(cc, 0);
+}
+
+static int m3_run_check(struct modem_3gpp *m, void (*done)(struct modem_3gpp *m, int err, void *data), void *data)
+{
+	struct check_ctx *cc;
+	int ret;
+
+	if (!m->nas)
+		return -ENOENT;
+
+	cc = talloc_zero(m, struct check_ctx);
+	cc->m = m;
+	cc->done = done;
+	cc->data = data;
+
+	ret = SEND_REQ(m->nas, qmi_set_nas_get_system_info_request(_m), get_system_info_cb, cc, 10000);
+	if (ret)
+		talloc_free(cc);
+
+	return ret;
+}
+
+static void periodic_check_done(struct modem_3gpp *m, int err, void *data)
+{
+	m->check_running = false;
+}
+
+static void periodic_check_cb(struct uloop_timeout *t)
+{
+	struct modem_3gpp *m = container_of(t, struct modem_3gpp, check_timer);
+
+	uloop_timeout_set(t, REGISTRATION_CHECK_TIMEOUT_MS);
+	if (m->check_running || !m->enabled)
+		return;
+
+	m->check_running = true;
+	if (m3_run_check(m, periodic_check_done, NULL))
+		m->check_running = false;
+}
+
+/*****************************************************************************/
+/* signal quality (MM: load_signal_quality(), signal_strength_get_quality(), nas_event_report_indication_cb()) */
+
+/* MM_RSSI_TO_QUALITY(): -113 dBm and below is 0%, -51 dBm and above is 100% */
+static unsigned int rssi_to_quality(int dbm)
+{
+	if (dbm <= -113)
+		return 0;
+	if (dbm >= -51)
+		return 100;
+
+	return (dbm + 113) * 100 / 62;
+}
+
+/* MM: qmi_dbm_valid() */
+static bool qmi_dbm_valid(int dbm, int radio_interface)
+{
+	switch (radio_interface) {
+	case QMI_NAS_RADIO_INTERFACE_CDMA_1X:
+	case QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO:
+	case QMI_NAS_RADIO_INTERFACE_UMTS:
+		return dbm > -125 && dbm < -30;
+	default:
+		return true;
+	}
+}
+
+static void m3_set_signal(struct modem_3gpp *m, unsigned int quality)
+{
+	if (!m->enabled)
+		return;
+
+	if (!m->signal_valid || m->signal != quality)
+		modem_log(m->modem, LOGL_DEBUG, "signal quality: %u%%", quality);
+	m->signal = quality;
+	m->signal_valid = true;
+}
+
+static void signal_timer_cb(struct uloop_timeout *t);
+
+/*
+ * MM: periodic_signal_check_step(), the end of a check. @quality is what this check loaded (0 if it failed or the
+ * modem said 0%).
+ */
+static void m3_signal_done(struct modem_3gpp *m, unsigned int quality)
+{
+	m->signal_running = false;
+	if (!m->enabled)
+		return;
+
+	/* Initially we poll at a higher frequency until we get a valid (not 0) signal quality, or after too many
+	 * retries */
+	if (!m->signal_initial_done)
+		m->signal_initial_done = quality != 0 || --m->signal_initial_retries == 0;
+
+	if (!m->signal_initial_done)
+		uloop_timeout_set(&m->signal_timer, SIGNAL_CHECK_INITIAL_TIMEOUT_MS);
+	else if (!m->signal_ind && !m->event_report_ind)
+		/* no polling if the modem tells us */
+		uloop_timeout_set(&m->signal_timer, SIGNAL_CHECK_TIMEOUT_MS);
+	else
+		uloop_timeout_cancel(&m->signal_timer);
+}
+
+static void get_signal_strength_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem_3gpp *m = req->cb_data;
+	struct qmi_nas_get_signal_strength_response res = {};
+	int best, i;
+	bool valid = false;
+	unsigned int quality = 0;
+
+	if (!msg || req->ret || qmi_parse_nas_get_signal_strength_response(msg, &res) || !res.set.signal_strength) {
+		modem_log(m->modem, LOGL_DEBUG, "couldn't get the signal strength: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+		m3_signal_done(m, 0);
+		return;
+	}
+
+	/* The mandatory one is always present, treat results as invalid if it is invalid */
+	best = res.data.signal_strength.strength;
+	if (qmi_dbm_valid(best, res.data.signal_strength.radio_interface)) {
+		valid = true;
+		/* On multimode devices we may get more */
+		for (i = 0; i < (int)res.data.strength_list_n; i++) {
+			if (qmi_dbm_valid(res.data.strength_list[i].strength, res.data.strength_list[i].radio_interface) &&
+			    res.data.strength_list[i].strength > best)
+				best = res.data.strength_list[i].strength;
+		}
+	}
+
+	if (valid && best < 0) {
+		quality = rssi_to_quality(best);
+		m3_set_signal(m, quality);
+	}
+	m3_signal_done(m, quality);
+}
+
+/* MM: common_signal_info_get_quality(), without 5G */
+static bool signal_info_quality(const int rssi[5], const int iface[5], unsigned int *quality)
+{
+	int rssi_max = -125, i;
+
+	for (i = 0; i < 5; i++) {
+		if (rssi[i] < 0 && qmi_dbm_valid(rssi[i], iface[i]) && rssi[i] > rssi_max)
+			rssi_max = rssi[i];
+	}
+
+	if (rssi_max < 0 && rssi_max > -125) {
+		*quality = rssi_to_quality(rssi_max);
+		return true;
+	}
+
+	return false;
+}
+
+static void get_signal_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem_3gpp *m = req->cb_data;
+	struct qmi_nas_get_signal_info_response res = {};
+	unsigned int quality;
+
+	if (!msg || req->ret || qmi_parse_nas_get_signal_info_response(msg, &res)) {
+		/* MM: falling back to get signal strength */
+		if (SEND_REQ(m->nas, qmi_set_nas_get_signal_strength_request(_m, &(struct qmi_nas_get_signal_strength_request){}),
+			     get_signal_strength_cb, m, 10000))
+			m3_signal_done(m, 0);
+		return;
+	}
+
+	{
+		int rssi[5] = { 0, 0, 0, 0, 0 };
+		static const int iface[5] = { QMI_NAS_RADIO_INTERFACE_CDMA_1X, QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO,
+					      QMI_NAS_RADIO_INTERFACE_GSM, QMI_NAS_RADIO_INTERFACE_UMTS,
+					      QMI_NAS_RADIO_INTERFACE_LTE };
+
+		if (res.set.cdma_signal_strength)
+			rssi[0] = res.data.cdma_signal_strength.rssi;
+		if (res.set.hdr_signal_strength)
+			rssi[1] = res.data.hdr_signal_strength.rssi;
+		if (res.set.gsm_signal_strength)
+			rssi[2] = res.data.gsm_signal_strength;
+		if (res.set.wcdma_signal_strength)
+			rssi[3] = res.data.wcdma_signal_strength.rssi;
+		if (res.set.lte_signal_strength)
+			rssi[4] = res.data.lte_signal_strength.rssi;
+
+		if (signal_info_quality(rssi, iface, &quality)) {
+			m3_set_signal(m, quality);
+			m3_signal_done(m, quality);
+		} else {
+			m3_signal_done(m, 0);
+		}
+	}
+}
+
+static void m3_signal_check(struct modem_3gpp *m)
+{
+	if (!m->enabled || !m->nas || m->signal_running)
+		return;
+
+	m->signal_running = true;
+	if (SEND_REQ(m->nas, qmi_set_nas_get_signal_info_request(_m), get_signal_info_cb, m, 10000))
+		m3_signal_done(m, 0);
+}
+
+/* MM: mm_iface_modem_refresh_signal(): ignored while a check runs, otherwise it starts over with the fast polling */
+static void m3_refresh_signal(struct modem_3gpp *m)
+{
+	if (!m->enabled || !m->nas || m->signal_running)
+		return;
+
+	uloop_timeout_cancel(&m->signal_timer);
+	m->signal_initial_retries = SIGNAL_CHECK_INITIAL_RETRIES;
+	m->signal_initial_done = false;
+	m3_signal_check(m);
+}
+
+void uqmid_3gpp_refresh_signal(struct modem *modem)
+{
+	m3_refresh_signal(m3(modem));
+}
+
+static void signal_timer_cb(struct uloop_timeout *t)
+{
+	struct modem_3gpp *m = container_of(t, struct modem_3gpp, signal_timer);
+
+	m3_signal_check(m);
+}
+
+static void nas_signal_info_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_3gpp *m = data;
+	struct qmi_nas_signal_info_indication res = {};
+	int rssi[5] = { 0, 0, 0, 0, 0 };
+	static const int iface[5] = { QMI_NAS_RADIO_INTERFACE_CDMA_1X, QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO,
+				      QMI_NAS_RADIO_INTERFACE_GSM, QMI_NAS_RADIO_INTERFACE_UMTS,
+				      QMI_NAS_RADIO_INTERFACE_LTE };
+	unsigned int quality;
+
+	if (qmi_parse_nas_signal_info_indication(msg, &res))
+		return;
+
+	if (res.set.cdma_signal_strength)
+		rssi[0] = res.data.cdma_signal_strength.rssi;
+	if (res.set.hdr_signal_strength)
+		rssi[1] = res.data.hdr_signal_strength.rssi;
+	if (res.set.gsm_signal_strength)
+		rssi[2] = res.data.gsm_signal_strength;
+	if (res.set.wcdma_signal_strength)
+		rssi[3] = res.data.wcdma_signal_strength.rssi;
+	if (res.set.lte_signal_strength)
+		rssi[4] = res.data.lte_signal_strength.rssi;
+
+	if (signal_info_quality(rssi, iface, &quality))
+		m3_set_signal(m, quality);
+
+	/* MM: nas_signal_info_indication_cb(): mm_iface_modem_signal_update() */
+	uqmid_signal_info_indication(m->modem, &res);
+}
+
+static void nas_event_report_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_3gpp *m = data;
+	struct qmi_nas_event_report_indication res = {};
+
+	if (qmi_parse_nas_event_report_indication(msg, &res) || !res.set.signal_strength)
+		return;
+
+	if (qmi_dbm_valid(res.data.signal_strength.strength, res.data.signal_strength.radio_interface))
+		m3_set_signal(m, rssi_to_quality(res.data.signal_strength.strength));
+}
+
+static void nas_system_info_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_3gpp *m = data;
+	struct qmi_nas_system_info_indication res = {};
+	struct sysinfo si = {};
+
+	if (!m->enabled || qmi_parse_nas_system_info_indication(msg, &res))
+		return;
+
+	sysinfo_from_indication(&si, &res);
+	m3_process_sysinfo(m, &si);
+}
+
+static void nas_serving_system_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_3gpp *m = data;
+	struct qmi_nas_serving_system_indication res = {};
+	struct ss_info si = {};
+
+	if (!m->enabled || qmi_parse_nas_serving_system_indication(msg, &res))
+		return;
+
+	ss_from_indication(&si, &res);
+	m3_process_serving_system(m, &si);
+}
+
+/*****************************************************************************/
+/* the initial EPS bearer settings: the default attach profile */
+
+/*
+ * MM: the WDS client of the modem is allocated at initialization and kept (mm_shared_qmi_peek_client(WDS)). The
+ * bearers have their own (see bearer.c), this one belongs to the initial EPS bearer.
+ */
+void uqmid_3gpp_probe(struct modem *modem)
+{
+	struct modem_3gpp *m = m3(modem);
+
+	if (m->wds)
+		return;
+
+	m->wds = uqmi_service_find(modem->qmi, QMI_SERVICE_WDS);
+	if (m->wds)
+		uqmi_service_ensure_client(m->wds);
+}
+
+static struct qmi_service *m3_wds(struct modem_3gpp *m)
+{
+	return m->wds && uqmi_service_valid(m->modem->qmi, m->wds) ? m->wds : NULL;
+}
+
+struct qmi_service *uqmid_3gpp_wds(struct modem *modem)
+{
+	return m3(modem)->wds ? m3_wds(m3(modem)) : NULL;
+}
+
+struct eps_load {
+	struct modem_3gpp *m;
+	void (*done)(struct modem_3gpp *m, int err, void *data);
+	void *data;
+};
+
+static void eps_load_finish(struct eps_load *el, int err)
+{
+	struct modem_3gpp *m = el->m;
+	void (*done)(struct modem_3gpp *m, int err, void *data) = el->done;
+	void *data = el->data;
+
+	m->eps_loading = false;
+	talloc_free(el);
+	if (done)
+		done(m, err, data);
+}
+
+static void eps_get_profile_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct eps_load *el = req->cb_data;
+	struct modem_3gpp *m = el->m;
+	struct qmi_wds_get_profile_settings_response res = {};
+
+	if (!msg || req->ret || qmi_parse_wds_get_profile_settings_response(msg, &res)) {
+		modem_log(m->modem, LOGL_INFO, "couldn't load the initial EPS bearer settings: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+		m->eps_valid = false;
+		eps_load_finish(el, req->ret ? req->ret : -EIO);
+		return;
+	}
+
+	m3_set_str(m->modem, &m->eps_apn, res.data.apn_name);
+	m3_set_str(m->modem, &m->eps_user, res.data.username);
+	m3_set_str(m->modem, &m->eps_password, res.data.password);
+	m->eps_pdp_type = res.set.pdp_type ? res.data.pdp_type : -1;
+	m->eps_auth = res.set.authentication ? res.data.authentication : 0;
+	m->eps_valid = true;
+	modem_log(m->modem, LOGL_INFO, "initial EPS bearer settings (profile %u): apn '%s' pdp type %d", m->attach_pdn,
+		  m->eps_apn ? m->eps_apn : "", m->eps_pdp_type);
+	eps_load_finish(el, 0);
+}
+
+static int eps_request_profile(struct eps_load *el)
+{
+	struct modem_3gpp *m = el->m;
+	struct qmi_wds_get_profile_settings_request pr = {};
+
+	pr.set.profile_id = 1;
+	pr.data.profile_id.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+	pr.data.profile_id.profile_index = m->attach_pdn;
+
+	return SEND_REQ(m3_wds(m), qmi_set_wds_get_profile_settings_request(_m, &pr), eps_get_profile_cb, el, 10000);
+}
+
+static void eps_attach_list_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct eps_load *el = req->cb_data;
+	struct modem_3gpp *m = el->m;
+	struct qmi_wds_get_lte_attach_pdn_list_response res = {};
+
+	if (msg && !req->ret && !qmi_parse_wds_get_lte_attach_pdn_list_response(msg, &res) &&
+	    res.data.current_list_n) {
+		m->attach_pdn = res.data.current_list[0];
+		modem_log(m->modem, LOGL_DEBUG, "default LTE attach PDN profile: %u", m->attach_pdn);
+	} else if (!m->attach_pdn) {
+		/* MM fails here. The default attach profile of the modems of the MSM8916 is the first one. */
+		modem_log(m->modem, LOGL_DEBUG, "couldn't get the LTE attach PDN list (%d/%s), assuming profile 1",
+			  req->ret, qmi_get_error_str(req->ret));
+		m->attach_pdn = 1;
+	}
+
+	if (eps_request_profile(el)) {
+		m->eps_valid = false;
+		eps_load_finish(el, -EIO);
+	}
+}
+
+/* MM: modem_3gpp_load_initial_eps_bearer_settings() */
+static void m3_load_eps(struct modem_3gpp *m, void (*done)(struct modem_3gpp *m, int err, void *data), void *data)
+{
+	struct eps_load *el = talloc_zero(m, struct eps_load);
+	struct qmi_service *wds = m3_wds(m);
+	int ret;
+
+	el->m = m;
+	el->done = done;
+	el->data = data;
+	m->eps_loading = true;
+
+	if (!wds) {
+		eps_load_finish(el, -ENOENT);
+		return;
+	}
+
+	/* The default attach PDN is assumed to never change during runtime: only load it the first time */
+	if (m->attach_pdn)
+		ret = eps_request_profile(el);
+	else
+		ret = SEND_REQ(wds, qmi_set_wds_get_lte_attach_pdn_list_request(_m), eps_attach_list_cb, el, 10000);
+	if (ret) {
+		m->eps_valid = false;
+		eps_load_finish(el, ret);
+	}
+}
+

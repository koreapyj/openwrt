+/* values */
+
+static void tech_init(struct sig_tech *t)
+{
+	unsigned int i;
+
+	t->present = true;
+	for (i = 0; i < SV_N; i++)
+		t->v[i] = NAN;
+}
+
+/* MM: if (!x) x = mm_signal_new() */
+static struct sig_tech *tech_get(struct sig_vals *vals, enum sig_tech_id id)
+{
+	struct sig_tech *t = &vals->t[id];
+
+	if (!t->present)
+		tech_init(t);
+	return t;
+}
+
+static bool vals_loaded(const struct sig_vals *vals)
+{
+	unsigned int i;
+
+	for (i = 0; i < SIG_N; i++)
+		if (vals->t[i].present)
+			return true;
+	return false;
+}
+
+static bool vals_equal(const struct sig_vals *x_, const struct sig_vals *y_)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < SIG_N; i++) {
+		if (x_->t[i].present != y_->t[i].present)
+			return false;
+		if (!x_->t[i].present)
+			continue;
+		for (j = 0; j < SV_N; j++) {
+			double x = x_->t[i].v[j], y = y_->t[i].v[j];
+
+			if (isnan(x) != isnan(y) || (!isnan(x) && x != y))
+				return false;
+		}
+	}
+	return true;
+}
+
+/* MM: get_db_from_sinr_level() */
+static double sinr_level_to_db(struct modem *modem, unsigned int level)
+{
+	switch (level) {
+	case QMI_NAS_EVDO_SINR_LEVEL_0: return -9.0;
+	case QMI_NAS_EVDO_SINR_LEVEL_1: return -6;
+	case QMI_NAS_EVDO_SINR_LEVEL_2: return -4.5;
+	case QMI_NAS_EVDO_SINR_LEVEL_3: return -3;
+	case QMI_NAS_EVDO_SINR_LEVEL_4: return -2;
+	case QMI_NAS_EVDO_SINR_LEVEL_5: return 1;
+	case QMI_NAS_EVDO_SINR_LEVEL_6: return 3;
+	case QMI_NAS_EVDO_SINR_LEVEL_7: return 6;
+	case QMI_NAS_EVDO_SINR_LEVEL_8: return 9;
+	default:
+		modem_log(modem, LOGL_NOTICE, "invalid SINR level '%u'", level);
+		return NAN;
+	}
+}
+
+/*
+ * MM: common_process_signal_info(), the same for the Get Signal Info response and the Signal Info indication
+ * (the structures have the same members). ECIO is in units of -0.5 dB, the SNR in 0.1 dB, the RSCP is a
+ * negated dBm value.
+ */
+#define PROCESS_SIGNAL_INFO(modem, r, vals)								\
+	do {												\
+		struct sig_tech *_t;									\
+													\
+		if ((r)->set.cdma_signal_strength) {							\
+			_t = tech_get((vals), SIG_CDMA);						\
+			_t->v[SV_RSSI] = (r)->data.cdma_signal_strength.rssi;				\
+			_t->v[SV_ECIO] = (r)->data.cdma_signal_strength.ecio * -0.5;			\
+		}											\
+		if ((r)->set.hdr_signal_strength) {							\
+			_t = tech_get((vals), SIG_EVDO);						\
+			_t->v[SV_RSSI] = (r)->data.hdr_signal_strength.rssi;				\
+			_t->v[SV_ECIO] = (r)->data.hdr_signal_strength.ecio * -0.5;			\
+			_t->v[SV_SINR] = sinr_level_to_db((modem), (r)->data.hdr_signal_strength.sinr);	\
+			_t->v[SV_IO] = (r)->data.hdr_signal_strength.io;				\
+		}											\
+		if ((r)->set.gsm_signal_strength) {							\
+			_t = tech_get((vals), SIG_GSM);							\
+			_t->v[SV_RSSI] = (r)->data.gsm_signal_strength;					\
+		}											\
+		if ((r)->set.wcdma_signal_strength) {							\
+			_t = tech_get((vals), SIG_UMTS);						\
+			_t->v[SV_RSSI] = (r)->data.wcdma_signal_strength.rssi;				\
+			_t->v[SV_ECIO] = (r)->data.wcdma_signal_strength.ecio * -0.5;			\
+		}											\
+		if ((r)->set.wcdma_rscp) {								\
+			_t = tech_get((vals), SIG_UMTS);						\
+			_t->v[SV_RSCP] = -1.0 * (r)->data.wcdma_rscp;					\
+		}											\
+		if ((r)->set.lte_signal_strength) {							\
+			_t = tech_get((vals), SIG_LTE);							\
+			_t->v[SV_RSSI] = (r)->data.lte_signal_strength.rssi;				\
+			_t->v[SV_RSRQ] = (r)->data.lte_signal_strength.rsrq;				\
+			_t->v[SV_RSRP] = (r)->data.lte_signal_strength.rsrp;				\
+			_t->v[SV_SNR] = 0.1 * (r)->data.lte_signal_strength.snr;			\
+		}											\
+		if ((r)->set._5g_signal_strength) {							\
+			if ((r)->data._5g_signal_strength.rsrp != NR5G_NOT_CONNECTED ||			\
+			    (r)->data._5g_signal_strength.snr != NR5G_NOT_CONNECTED) {			\
+				_t = tech_get((vals), SIG_NR5G);					\
+				if ((r)->data._5g_signal_strength.rsrp != NR5G_NOT_CONNECTED)		\
+					_t->v[SV_RSRP] = (r)->data._5g_signal_strength.rsrp;		\
+				if ((r)->data._5g_signal_strength.snr != NR5G_NOT_CONNECTED)		\
+					_t->v[SV_SNR] = 0.1 * (r)->data._5g_signal_strength.snr;	\
+			}										\
+		}											\
+		if ((r)->set._5g_signal_strength_extended &&						\
+		    (r)->data._5g_signal_strength_extended != NR5G_NOT_CONNECTED) {			\
+			_t = tech_get((vals), SIG_NR5G);						\
+			_t->v[SV_RSRQ] = (r)->data._5g_signal_strength_extended;			\
+		}											\
+	} while (0)
+
+/*
+ * MM: signal_load_values_get_signal_strength_ready(). Only what is in the RSSI list gets a technology, the other
+ * values are added to the technologies which exist.
+ */
+static void process_signal_strength(struct modem *modem, const struct qmi_nas_get_signal_strength_response *res,
+				    struct sig_vals *vals)
+{
+	unsigned int i;
+	struct sig_tech *t;
+
+	for (i = 0; i < res->data.rssi_list_n; i++) {
+		/* the RSSI is the magnitude of a negative dBm value (deviation: MM does not negate it) */
+		double rssi = -(double)res->data.rssi_list[i].rssi;
+
+		switch (res->data.rssi_list[i].radio_interface) {
+		case QMI_NAS_RADIO_INTERFACE_CDMA_1X:
+			tech_get(vals, SIG_CDMA)->v[SV_RSSI] = rssi;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO:
+			tech_get(vals, SIG_EVDO)->v[SV_RSSI] = rssi;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_GSM:
+			tech_get(vals, SIG_GSM)->v[SV_RSSI] = rssi;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_UMTS:
+			tech_get(vals, SIG_UMTS)->v[SV_RSSI] = rssi;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_LTE:
+			tech_get(vals, SIG_LTE)->v[SV_RSSI] = rssi;
+			break;
+		default:
+			break;
+		}
+	}
+
+	/* ECIO (CDMA, EV-DO and UMTS) */
+	for (i = 0; i < res->data.ecio_list_n; i++) {
+		double ecio = (double)res->data.ecio_list[i].ecio * -0.5;
+
+		switch (res->data.ecio_list[i].radio_interface) {
+		case QMI_NAS_RADIO_INTERFACE_CDMA_1X:
+			if (vals->t[SIG_CDMA].present)
+				vals->t[SIG_CDMA].v[SV_ECIO] = ecio;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_CDMA_1XEVDO:
+			if (vals->t[SIG_EVDO].present)
+				vals->t[SIG_EVDO].v[SV_ECIO] = ecio;
+			break;
+		case QMI_NAS_RADIO_INTERFACE_UMTS:
+			if (vals->t[SIG_UMTS].present)
+				vals->t[SIG_UMTS].v[SV_ECIO] = ecio;
+			break;
+		default:
+			break;
+		}
+	}
+
+	/* IO (EV-DO) */
+	if (res->set.io && vals->t[SIG_EVDO].present)
+		vals->t[SIG_EVDO].v[SV_IO] = res->data.io;
+
+	t = &vals->t[SIG_LTE];
+	/* RSRP (LTE) */
+	if (res->set.lte_rsrp && t->present)
+		t->v[SV_RSRP] = res->data.lte_rsrp;
+	/* RSRQ (LTE) */
+	if (res->set.rsrq && res->data.rsrq.radio_interface == QMI_NAS_RADIO_INTERFACE_LTE && t->present)
+		t->v[SV_RSRQ] = res->data.rsrq.rsrq;
+	/* SNR (LTE) */
+	if (res->set.lte_snr && t->present)
+		t->v[SV_SNR] = 0.1 * res->data.lte_snr;
+
+	/* SINR (EV-DO) */
+	if (res->set.sinr && vals->t[SIG_EVDO].present)
+		vals->t[SIG_EVDO].v[SV_SINR] = sinr_level_to_db(modem, res->data.sinr);
+}
+
+/*****************************************************************************/
+/* properties and the notification */
+
+static void add_tech(struct blob_buf *bb, enum sig_tech_id id, const struct sig_tech *t)
+{
+	void *tbl;
+	unsigned int i;
+
+	if (!t->present)
+		return;
+
+	tbl = blobmsg_open_table(bb, tech_names[id]);
+	for (i = 0; i < SV_N; i++)
+		if (!isnan(t->v[i]))
+			blobmsg_add_double(bb, value_names[i], t->v[i]);
+	blobmsg_close_table(bb, tbl);
+}
+
+static void add_properties(struct modem_signal *sg, struct blob_buf *bb)
+{
+	unsigned int i;
+
+	blobmsg_add_u32(bb, "rate", sg->rate);
+	blobmsg_add_u32(bb, "rssi_threshold", sg->rssi_threshold);
+	blobmsg_add_u8(bb, "error_rate_threshold", sg->error_rate_threshold);
+	for (i = 0; i < SIG_N; i++)
+		add_tech(bb, i, &sg->cur.t[i]);
+}
+
+static void notify_updated(struct modem_signal *sg)
+{
+	struct blob_buf nb = {};
+
+	if (!sg->modem->ubus.id)
+		return;
+
+	blob_buf_init(&nb, 0);
+	add_properties(sg, &nb);
+	ubus_notify(ubus_ctx, &sg->modem->ubus, "signal.updated", nb.head, -1);
+	blob_buf_free(&nb);
+}
+
+/* MM: info_log_signal_quality(): at most one info line per 300 s, no matter the technology */
+static void info_log_signal(struct modem_signal *sg, enum sig_tech_id id)
+{
+	struct timespec now;
+	char line[160];
+	size_t len = 0;
+	unsigned int i;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (!sg->info_log_started) {
+		sg->info_log_started = true;
+		sg->info_log_ts = now;
+	}
+	if (now.tv_sec - sg->info_log_ts.tv_sec < SIGNAL_INFO_LOG_RATE_SECS)
+		return;
+	sg->info_log_ts = now;
+
+	line[0] = 0;
+	for (i = 0; i < SV_N && len < sizeof(line); i++)
+		if (!isnan(sg->cur.t[id].v[i]))
+			len += snprintf(line + len, sizeof(line) - len, "%s%s: %.1f", len ? ", " : "", value_names[i],
+					sg->cur.t[id].v[i]);
+	modem_log(sg->modem, LOGL_INFO, "%s: %s", tech_names[id], line);
+}
+
+/* MM: internal_signal_update(): the new values replace all the old ones (a missing technology is cleared) */
+static void signal_set_values(struct modem_signal *sg, const struct sig_vals *nv)
+{
+	bool changed = !vals_equal(&sg->cur, nv);
+	unsigned int i;
+
+	sg->cur = *nv;
+	for (i = 0; i < SIG_N; i++) {
+		if (!nv->t[i].present)
+			continue;
+		modem_log(sg->modem, LOGL_DEBUG, "%s extended signal information updated", tech_names[i]);
+		if (i == SIG_GSM || i == SIG_UMTS || i == SIG_LTE || i == SIG_NR5G)
+			info_log_signal(sg, i);
+	}
+	if (changed)
+		notify_updated(sg);
+}
+
+static bool signal_idle(const struct modem_signal *sg)
+{
+	return !sg->enabled || (!sg->rate && !sg->rssi_threshold && !sg->error_rate_threshold);
+}
+
+/* MM: mm_iface_modem_signal_update() */
+static void signal_update(struct modem_signal *sg, const struct sig_vals *nv)
+{
+	if (signal_idle(sg)) {
+		modem_log(sg->modem, LOGL_DEBUG, "skipping extended signal information update...");
+		return;
+	}
+
+	signal_set_values(sg, nv);
+}
+
+/* MM: check_interface_reset() */
+static void check_interface_reset(struct modem_signal *sg)
+{
+	struct sig_vals empty = {};
+
+	if (signal_idle(sg)) {
+		modem_log(sg->modem, LOGL_DEBUG, "resetting extended signal information...");
+		signal_set_values(sg, &empty);
+	}
+}
+
+/*****************************************************************************/
+/* load the values (MM: signal_load_values()): Get Signal Info, Get Signal Strength if it gave nothing */
+
+struct sig_load {
+	struct modem_signal *sg;
+	struct sig_vals vals;
+};
+
+static void load_finish(struct sig_load *l, bool ok)
+{
+	struct modem_signal *sg = l->sg;
+
+	if (!ok)
+		/* MM: load_values_ready() */
+		modem_log(sg->modem, LOGL_NOTICE, "couldn't reload extended signal information: No way to load extended "
+			  "signal information");
+	else
+		signal_update(sg, &l->vals);
+	talloc_free(l);
+}
+
+static void get_signal_strength_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct sig_load *l = req->cb_data;
+	struct qmi_nas_get_signal_strength_response res = {};
+
+	if (l->sg->dying) {
+		talloc_free(l);
+		return;
+	}
+
+	/* a failure is not an error of its own: the result is "no way to load" then */
+	memset(&l->vals, 0, sizeof(l->vals));
+	if (msg && !req->ret && !qmi_parse_nas_get_signal_strength_response(msg, &res))
+		process_signal_strength(l->sg->modem, &res, &l->vals);
+	else
+		modem_log(l->sg->modem, LOGL_DEBUG, "couldn't get the signal strength: %s", req_error_str(req));
+
+	load_finish(l, vals_loaded(&l->vals));
+}
+
+static void get_signal_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct sig_load *l = req->cb_data;
+	struct modem *modem = l->sg->modem;
+	struct qmi_nas_get_signal_info_response res = {};
+	struct qmi_nas_get_signal_strength_request sr = {};
+
+	if (l->sg->dying) {
+		talloc_free(l);
+		return;
+	}
+
+	if (msg && !req->ret && !qmi_parse_nas_get_signal_info_response(msg, &res))
+		PROCESS_SIGNAL_INFO(modem, &res, &l->vals);
+	else
+		modem_log(modem, LOGL_DEBUG, "couldn't get signal info: %s: falling back to get signal strength",
+			  req_error_str(req));
+
+	/* if already loaded with signal info, don't try signal strength */
+	if (vals_loaded(&l->vals)) {
+		load_finish(l, true);
+		return;
+	}
+
+	qmi_set(&sr, request_mask, QMI_NAS_SIGNAL_STRENGTH_REQUEST_RSSI | QMI_NAS_SIGNAL_STRENGTH_REQUEST_ECIO |
+				   QMI_NAS_SIGNAL_STRENGTH_REQUEST_IO | QMI_NAS_SIGNAL_STRENGTH_REQUEST_SINR |
+				   QMI_NAS_SIGNAL_STRENGTH_REQUEST_RSRQ | QMI_NAS_SIGNAL_STRENGTH_REQUEST_LTE_SNR |
+				   QMI_NAS_SIGNAL_STRENGTH_REQUEST_LTE_RSRP);
+	if (SEND_REQ(nas_of(modem), qmi_set_nas_get_signal_strength_request(_m, &sr), get_signal_strength_cb, l,
+		     SIGNAL_REQ_TIMEOUT_MS))
+		load_finish(l, false);
+}
+
+/* MM: query_signal_values() */
+static void query_signal_values(struct modem_signal *sg)
+{
+	struct qmi_service *nas = nas_of(sg->modem);
+	struct sig_load *l;
+
+	modem_log(sg->modem, LOGL_DEBUG, "loading extended signal information...");
+	if (!nas) {
+		modem_log(sg->modem, LOGL_NOTICE, "couldn't reload extended signal information: NAS not available");
+		return;
+	}
+
+	l = talloc_zero(sg, struct sig_load);
+	if (!l)
+		return;
+	l->sg = sg;
+	if (SEND_REQ(nas, qmi_set_nas_get_signal_info_request(_m), get_signal_info_cb, l, SIGNAL_REQ_TIMEOUT_MS)) {
+		modem_log(sg->modem, LOGL_NOTICE, "couldn't reload extended signal information: request failed");
+		talloc_free(l);
+	}
+}
+
+/*****************************************************************************/
+/* polling (MM: polling_restart()) */
+
+static void poll_timer_cb(struct uloop_timeout *t)
+{
+	struct modem_signal *sg = container_of(t, struct modem_signal, poll_timer);
+
+	/* g_timeout_add_seconds() keeps on until the source is removed */
+	uloop_timeout_set(&sg->poll_timer, (sg->rate > 2147483 ? 2147483 : sg->rate) * 1000);
+	query_signal_values(sg);
+}
+
+static void polling_restart(struct modem_signal *sg)
+{
+	bool polling_setup = sg->enabled && sg->rate;
+
+	if (polling_setup)
+		modem_log(sg->modem, LOGL_INFO, "setting up extended signal information polling: rate %u seconds",
+			  sg->rate);
+	else
+		modem_log(sg->modem, LOGL_DEBUG, "cleaning up extended signal information polling");
+
+	uloop_timeout_cancel(&sg->poll_timer);
+	if (!polling_setup)
+		return;
+
+	uloop_timeout_set(&sg->poll_timer, (sg->rate > 2147483 ? 2147483 : sg->rate) * 1000);
+	/* also launch right away */
+	query_signal_values(sg);
+}
+
+/*****************************************************************************/
+/* thresholds (MM: thresholds_restart(), signal_setup_thresholds()) */
+
+struct thr_ctx {
+	struct modem_signal *sg;
+	unsigned int rssi;
+	void (*done)(struct modem_signal *sg, enum modem_error err, const char *msg, void *data);
+	void *data;
+};
+
+static void thr_finish(struct thr_ctx *c, enum modem_error err, const char *msg)
+{
+	struct modem_signal *sg = c->sg;
+
+	if (!err && sg->enabled)
+		/* MM: setup_thresholds_ready(): launch a query right away */
+		query_signal_values(sg);
+	c->done(sg, err, msg, c->data);
+	talloc_free(c);
+}
+
+static void thr_cb_error(struct thr_ctx *c, const struct qmi_request *req, const char *what)
+{
+	char msg[96];
+
+	snprintf(msg, sizeof(msg), "%s: %s", what, req_error_str(req));
+	thr_finish(c, req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED, msg);
+}
+
+static void config_signal_info_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct thr_ctx *c = req->cb_data;
+
+	if (c->sg->dying) {
+		talloc_free(c);
+		return;
+	}
+
+	if (!msg || req->ret)
+		thr_cb_error(c, req, "Couldn't config signal info");
+	else
+		thr_finish(c, MODEM_ERR_NONE, NULL);
+}
+
+/* MM: config_signal_info(), the v1 message: the thresholds of the RSSI */
+static void config_signal_info(struct thr_ctx *c)
+{
+	static int8_t default_thresholds[] = { -100, -97, -95, -92, -90, -85, -80, -75, -70, -65 };
+	struct qmi_nas_config_signal_info_request req = {};
+	int8_t list[128];
+	unsigned int n = 0;
+
+	if (c->rssi) {
+		int threshold = RSSI_MIN;
+
+		while (RSSI_MIN <= threshold && threshold <= RSSI_MAX && n < ARRAY_SIZE(list)) {
+			list[n++] = threshold;
+			threshold += c->rssi > 255 ? 255 : (int)c->rssi;
+		}
+		req.data.rssi_threshold_n = n;
+		req.data.rssi_threshold = list;
+	} else {
+		req.data.rssi_threshold_n = ARRAY_SIZE(default_thresholds);
+		req.data.rssi_threshold = default_thresholds;
+	}
+
+	if (SEND_REQ(nas_of(c->sg->modem), qmi_set_nas_config_signal_info_request(_m, &req), config_signal_info_cb, c,
+		     SIGNAL_REQ_TIMEOUT_MS))
+		thr_finish(c, MODEM_ERR_FAILED, "Couldn't send the signal info configuration");
+}
+
+static void config_signal_info_v2_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct thr_ctx *c = req->cb_data;
+
+	if (c->sg->dying) {
+		talloc_free(c);
+		return;
+	}
+
+	if (!msg || req->ret) {
+		if (msg && (req->ret == QMI_PROTOCOL_ERROR_INVALID_QMI_COMMAND ||
+			    req->ret == QMI_PROTOCOL_ERROR_NOT_SUPPORTED)) {
+			modem_log(c->sg->modem, LOGL_DEBUG,
+				  "couldn't config signal info using v2: %s, falling back to config signal info using v1",
+				  req_error_str(req));
+			config_signal_info(c);
+			return;
+		}
+		thr_cb_error(c, req, "Couldn't config signal info");
+		return;
+	}
+
+	thr_finish(c, MODEM_ERR_NONE, NULL);
+}
+
+/* MM: signal_setup_thresholds(): the delta (in 0.1 dBm) of the RSSI for all technologies, RSRP for 5G NR */
+static void setup_thresholds(struct modem_signal *sg, unsigned int rssi, bool error_rate,
+			     void (*done)(struct modem_signal *sg, enum modem_error err, const char *msg, void *data),
+			     void *data)
+{
+	struct qmi_nas_config_signal_info_v2_request req = {};
+	struct thr_ctx *c;
+	struct qmi_service *nas = nas_of(sg->modem);
+	unsigned int delta;
+
+	if (error_rate) {
+		done(sg, MODEM_ERR_UNSUPPORTED, "Setting error rate threshold not supported", data);
+		return;
+	}
+	if (!nas) {
+		done(sg, MODEM_ERR_UNSUPPORTED, "NAS not available", data);
+		return;
+	}
+
+	c = talloc_zero(sg, struct thr_ctx);
+	if (!c) {
+		done(sg, MODEM_ERR_FAILED, "Out of memory", data);
+		return;
+	}
+	c->sg = sg;
+	c->rssi = rssi;
+	c->done = done;
+	c->data = data;
+
+	delta = rssi ? rssi * 10 : DEFAULT_RSSI_DELTA_DBM * 10;
+	if (delta > 0xffff)
+		delta = 0xffff;
+	qmi_set(&req, cdma_rssi_delta, delta);
+	qmi_set(&req, hdr_rssi_delta, delta);
+	qmi_set(&req, gsm_rssi_delta, delta);
+	qmi_set(&req, wcdma_rssi_delta, delta);
+	qmi_set(&req, lte_rssi_delta, delta);
+	qmi_set(&req, nr5g_rsrp_delta, delta);
+	if (SEND_REQ(nas, qmi_set_nas_config_signal_info_v2_request(_m, &req), config_signal_info_v2_cb, c,
+		     SIGNAL_REQ_TIMEOUT_MS))
+		thr_finish(c, MODEM_ERR_FAILED, "Couldn't send the signal info configuration");
+}
+
+/*
+ * MM: thresholds_restart(). Note that MM hands over the thresholds which are set, also when the interface is
+ * disabled (it only logs "cleaning up").
+ */
+static void thresholds_restart(struct modem_signal *sg,
+			       void (*done)(struct modem_signal *sg, enum modem_error err, const char *msg, void *data),
+			       void *data)
+{
+	modem_log(sg->modem, LOGL_DEBUG,
+		  "%s extended signal information thresholds: interface %s, rssi threshold %u dBm, error rate threshold %s",
+		  sg->enabled && (sg->rssi_threshold || sg->error_rate_threshold) ? "setting up" : "cleaning up",
+		  sg->enabled ? "enabled" : "disabled", sg->rssi_threshold,
+		  sg->error_rate_threshold ? "enabled" : "disabled");
+
+	setup_thresholds(sg, sg->rssi_threshold, sg->error_rate_threshold, done, data);
+}
+
+/*****************************************************************************/
+/* enable / disable (MM: common_enable_disable()) */
+
+struct toggle {
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+};
+
+static void toggle_thresholds_done(struct modem_signal *sg, enum modem_error err, const char *msg, void *data)
+{
+	struct toggle *t = data;
+	struct modem *modem = sg->modem;
+	void (*done)(struct modem *modem, void *data) = t->done;
+	void *d = t->data;
+
+	if (err)
+		modem_log(modem, LOGL_DEBUG, "couldn't %s the signal interface: %s", sg->enabled ? "enable" : "disable",
+			  msg ? msg : modem_error_message(err));
+	talloc_free(t);
+	done(modem, d);
+}
+
+static void signal_toggle(struct modem *modem, bool enable, void (*done)(struct modem *modem, void *data),
+			  void *data)
+{
+	struct modem_signal *sg = msig(modem);
+	struct toggle *t;
+
+	/* no interface without the NAS service (MM: check_support()) */
+	if (!sg || !nas_of(modem)) {
+		done(modem, data);
+		return;
+	}
+
+	t = talloc_zero(sg, struct toggle);
+	if (!t) {
+		done(modem, data);
+		return;
+	}
+	t->done = done;
+	t->data = data;
+
+	sg->enabled = enable;
+	check_interface_reset(sg);
+	polling_restart(sg);
+	thresholds_restart(sg, toggle_thresholds_done, t);
+}
+
+void uqmid_signal_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	signal_toggle(modem, true, done, data);
+}
+
+void uqmid_signal_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	signal_toggle(modem, false, done, data);
+}
+
+/*****************************************************************************/
+/* indication (MM: nas_signal_info_indication_cb()) */
+
+void uqmid_signal_info_indication(struct modem *modem, const struct qmi_nas_signal_info_indication *ind)
+{
+	struct modem_signal *sg = msig(modem);
+	struct sig_vals vals = {};
+
+	if (!sg)
+		return;
+
+	PROCESS_SIGNAL_INFO(modem, ind, &vals);
+	signal_update(sg, &vals);
+}
+
+/*****************************************************************************/
+/* ubus */
+
+/* MM: mm_iface_modem_abort_invocation_if_state_not_reached(DISABLED) and the interface exists if there is NAS */
+static int check_available(struct ubus_context *ctx, struct modem *modem, struct ubus_request_data *req,
+			   bool need_state)
+{
+	if (!nas_of(modem))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED,
+					      "Extended Signal information not supported");
+	if (need_state && modem->mm_state < MODEM_STATE_DISABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE,
+					      modem->mm_state == MODEM_STATE_FAILED ? "Modem is in failed state"
+										    : "Modem is not initialized yet");
+	return 0;
+}
+
+enum { SS_RATE, __SS_MAX };
+
+static const struct blobmsg_policy signal_setup_policy[__SS_MAX] = {
+	[SS_RATE] = { .name = "rate", .type = BLOBMSG_TYPE_INT32 },
+};
+
+/** ubus call uqmid.modem.0 signal_setup {rate: 10} */
+static int h_signal_setup(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_signal *sg = msig(modem);
+	struct blob_attr *tb[__SS_MAX];
+	int ret;
+
+	blobmsg_parse(signal_setup_policy, __SS_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[SS_RATE] || (int32_t)blobmsg_get_u32(tb[SS_RATE]) < 0)
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	ret = check_available(ctx, modem, req, true);
+	if (ret)
+		return ret;
+
+	modem_log(modem, LOGL_INFO, "processing user request to setup signal polling...");
+	if (sg->rate != blobmsg_get_u32(tb[SS_RATE])) {
+		sg->rate = blobmsg_get_u32(tb[SS_RATE]);
+		notify_updated(sg);
+	}
+	polling_restart(sg);
+	check_interface_reset(sg);
+
+	blob_buf_init(&b, 0);
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static void setup_thresholds_done(struct modem_signal *sg, enum modem_error err, const char *msg, void *data)
+{
+	struct sig_op *op = data;
+
+	list_del(&op->list);
+	if (err) {
+		/* MM: setup_thresholds_restart_ready(): back to the previous thresholds */
+		sg->rssi_threshold = op->prev_rssi;
+		sg->error_rate_threshold = op->prev_error_rate;
+	} else {
+		notify_updated(sg);
+	}
+	uqmid_ubus_deferred_done(&op->req, err, msg, NULL);
+	talloc_free(op);
+}
+
+enum { ST_RSSI, ST_ERROR_RATE, __ST_MAX };
+
+static const struct blobmsg_policy signal_setup_thresholds_policy[__ST_MAX] = {
+	[ST_RSSI] = { .name = "rssi_threshold", .type = BLOBMSG_TYPE_INT32 },
+	[ST_ERROR_RATE] = { .name = "error_rate_threshold", .type = BLOBMSG_TYPE_BOOL },
+};
+
+/** ubus call uqmid.modem.0 signal_setup_thresholds {rssi_threshold: 5, error_rate_threshold: false} */
+static int h_signal_setup_thresholds(struct ubus_context *ctx, struct ubus_object *obj,
+				     struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_signal *sg = msig(modem);
+	struct blob_attr *tb[__ST_MAX];
+	unsigned int rssi = 0;
+	bool error_rate = false;
+	struct sig_op *op;
+	int ret;
+
+	blobmsg_parse(signal_setup_thresholds_policy, __ST_MAX, tb, blob_data(msg), blob_len(msg));
+	/* MM: mm_signal_threshold_properties_new_from_dictionary(): missing keys are 0 / false */
+	if (tb[ST_RSSI]) {
+		if ((int32_t)blobmsg_get_u32(tb[ST_RSSI]) < 0)
+			return UBUS_STATUS_INVALID_ARGUMENT;
+		rssi = blobmsg_get_u32(tb[ST_RSSI]);
+	}
+	if (tb[ST_ERROR_RATE])
+		error_rate = blobmsg_get_bool(tb[ST_ERROR_RATE]);
+
+	ret = check_available(ctx, modem, req, true);
+	if (ret)
+		return ret;
+
+	if (rssi == sg->rssi_threshold && error_rate == sg->error_rate_threshold) {
+		blob_buf_init(&b, 0);
+		return ubus_send_reply(ctx, req, b.head);
+	}
+
+	op = talloc_zero(sg, struct sig_op);
+	if (!op)
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	modem_log(modem, LOGL_INFO, "processing user request to setup signal thresholds...");
+	op->prev_rssi = sg->rssi_threshold;
+	op->prev_error_rate = sg->error_rate_threshold;
+	sg->rssi_threshold = rssi;
+	sg->error_rate_threshold = error_rate;
+	list_add_tail(&op->list, &sg->ops);
+	ubus_defer_request(ctx, req, &op->req);
+	thresholds_restart(sg, setup_thresholds_done, op);
+
+	return UBUS_STATUS_OK;
+}
+
+/** ubus call uqmid.modem.0 signal_get */
+static int h_signal_get(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	int ret;
+
+	ret = check_available(ctx, modem, req, false);
+	if (ret)
+		return ret;
+
+	blob_buf_init(&b, 0);
+	add_properties(msig(modem), &b);
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static const struct ubus_method modem_signal_methods[] = {
+	UBUS_METHOD("signal_setup", h_signal_setup, signal_setup_policy),
+	UBUS_METHOD("signal_setup_thresholds", h_signal_setup_thresholds, signal_setup_thresholds_policy),
+	UBUS_METHOD_NOARG("signal_get", h_signal_get),
+};
+
+const struct ubus_method *uqmid_signal_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_signal_methods);
+	return modem_signal_methods;
+}
+
+/*****************************************************************************/
+/* life cycle */
+
+void uqmid_signal_init(struct modem *modem)
+{
+	struct modem_signal *sg = talloc_zero(modem, struct modem_signal);
+
+	if (!sg)
+		return;
+
+	sg->modem = modem;
+	sg->poll_timer.cb = poll_timer_cb;
+	INIT_LIST_HEAD(&sg->ops);
+	modem->signal = sg;
+}
+
+/* the modem goes away: the callbacks of the requests in flight are not called, the user requests are failed here */
+void uqmid_signal_cleanup(struct modem *modem)
+{
+	struct modem_signal *sg = msig(modem);
+	struct sig_op *op, *tmp;
+
+	if (!sg)
+		return;
+
+	sg->dying = true;
+	sg->enabled = false;
+	uloop_timeout_cancel(&sg->poll_timer);
+	list_for_each_entry_safe(op, tmp, &sg->ops, list) {
+		list_del(&op->list);
+		uqmid_ubus_deferred_done(&op->req, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+		talloc_free(op);
+	}
+}

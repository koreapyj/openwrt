+	case MODEM_ST_GET_POWER:
+	case MODEM_ST_GET_CURRENT:
+	case MODEM_ST_WAIT_SIM:
+	case MODEM_ST_RETRY:
+		return MODEM_STATE_INITIALIZING;
+	case MODEM_ST_LOCKED:
+		return MODEM_STATE_LOCKED;
+	case MODEM_ST_DISABLED:
+		return MODEM_STATE_DISABLED;
+	case MODEM_ST_ENABLING:
+		return MODEM_STATE_ENABLING;
+	case MODEM_ST_ENABLED:
+		return MODEM_STATE_ENABLED;
+	case MODEM_ST_DISABLING:
+		return MODEM_STATE_DISABLING;
+	case MODEM_ST_FAILED:
+		return MODEM_STATE_FAILED;
+	case MODEM_ST_DESTROY:

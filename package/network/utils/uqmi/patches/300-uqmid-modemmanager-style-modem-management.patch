+/*****************************************************************************/
+/* band lists (MM: GArray of MMModemBand, mm-common-helpers.c) */
+
+static void bl_add(struct band_list *bl, unsigned int band)
+{
+	if (bl->n < MAX_BANDS)
+		bl->v[bl->n++] = band;
+}
+
+static int bl_cmp_band(const void *a, const void *b)
+{
+	return (int)*(const uint16_t *)a - (int)*(const uint16_t *)b;
+}
+
+/* mm_common_bands_garray_sort() */
+static void bl_sort(struct band_list *bl)
+{
+	qsort(bl->v, bl->n, sizeof(bl->v[0]), bl_cmp_band);
+}
+
+/* mm_common_bands_garray_cmp(): true if both lists have the same bands */
+static bool bl_equal(const struct band_list *a, const struct band_list *b)
+{
+	struct band_list da = *a, db = *b;
+	unsigned int i;
+
+	if (a->n != b->n)
+		return false;
+
+	bl_sort(&da);
+	bl_sort(&db);
+	for (i = 0; i < da.n; i++) {
+		if (da.v[i] != db.v[i])
+			return false;
+	}
+
+	return true;
+}
+
+/* mm_common_bands_variant_to_garray(): nothing set is [unknown] */
+static void bl_get(const struct band_list *prop, struct band_list *out)
+{
+	if (prop->n) {
+		*out = *prop;
+		return;
+	}
+	out->n = 0;
+	bl_add(out, MM_BAND_UNKNOWN);
+}
+
+/* the property after mm_common_bands_garray_to_variant() (a sorted copy): an empty list is "unknown" */
+static void bl_set_prop(struct band_list *prop, const struct band_list *bl)
+{
+	*prop = *bl;
+	bl_sort(prop);
+}
+
+static bool bl_is_single(const struct band_list *bl, unsigned int band)
+{
+	return bl->n == 1 && bl->v[0] == band;
+}
+
+static bool bl_contains(const struct band_list *bl, unsigned int band)
+{
+	unsigned int i;
+
+	for (i = 0; i < bl->n; i++) {
+		if (bl->v[i] == band)
+			return true;
+	}
+
+	return false;
+}

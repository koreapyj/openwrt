+	struct qmi_service *dms = uqmi_service_find(modem->qmi, QMI_SERVICE_DMS);
+
+	op->pstep = 0;
+	modem_log(modem, LOGL_INFO, "processing user request to reset modem...");
+	if (!dms || tx_dms_set_operating_mode(modem, dms, QMI_DMS_OPERATING_MODE_OFFLINE, dms_reset_offline_cb,

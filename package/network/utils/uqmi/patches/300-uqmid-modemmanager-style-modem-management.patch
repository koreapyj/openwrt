@@ -0,0 +1,2077 @@
+/*
+ * uqmid -- 3GPP profile manager (ModemManager: Modem3gppProfileManager)
+ *
+ * Methods (the keys of a profile are the MM property names of mm-3gpp-profile.c with '-' replaced by '_'):
+ *  - profile_list  -> {profiles: [{profile_id, profile_name?, apn?, allowed_auth?, user?, password?, ip_type?,
+ *                      apn_type?, pcscf_using_pco?, im_cn?, ...}]}
+ *  - profile_set {profile: {...}} -> {profile: {...}}: creates the profile if there is no profile_id (WDS Create
+ *    Profile), modifies the profile otherwise (WDS Modify Profile)
+ *  - profile_delete {profile_id} -> {state, power_state}
+ * Notification of the modem object: profile_manager.updated {} (MM: the Updated signal).
+ * The property profile_manager_index_field of the modem is "profile_id" (MM: IndexField).
+ *
+ * The values are the nicks of the MM enums: ip_type "ipv4", "ipv6", "ipv4v6", "non-ip" or "any" (a string, or an
+ * array of them), allowed_auth and apn_type and roaming_allowance (arrays of nicks), access_type_preference and
+ * profile_source (one nick), profile_enabled (boolean). The password is part of the profile like in MM (the
+ * dictionary has it; MM only hides it in the logs, so does uqmid).
+ *
+ * uqmid extension (MM has no such properties): the booleans pcscf_using_pco (WDS "PCSCF Address Using PCO", 0x1F) and
+ * im_cn (WDS "IMCN Flag", 0x22). The TLVs are only sent when the key was given, and the keys are only reported when
+ * the modem returned the TLV.
+ *
+ * Like in MM the methods need the state "enabled" (mm_iface_modem_abort_invocation_if_state_not_reached(ENABLED),
+ * error wrong-state "modem in <state> state") and are NOT serialized by the operation lock: MM only authorizes
+ * them (mm_base_modem_authorize()), they are not put into the operation FIFO. The interface exists if the profile
+ * list could be loaded when the modem was initialized (INITIALIZATION_STEP_CHECK_SUPPORT); MM does not export it
+ * otherwise, here the methods fail with the error unsupported.
+ *
+ * Set (mm_iface_modem_3gpp_profile_manager_set_profile(), index field "profile-id", strict always, as called by
+ * handle_set_auth_ready()) with the QMI format of modem_3gpp_profile_manager_check_format() (no new id, ids 1 to
+ * INT_MAX - 1, compare flags no access type preference, no roaming allowance, no profile source):
+ *  1. the IP type none or any becomes ipv4 (mm_3gpp_normalize_ip_family(from_user = TRUE)),
+ *  2. list before: all the profiles (a failure is only logged: an empty list),
+ *  3. select: with a profile_id the profile must be in the list (not-found "Profile 'N' not found"), if it is equal
+ *     to the requested one (mm_3gpp_profile_cmp()) it is reused and nothing is written; without a profile_id
+ *     nothing is selected (QMI cannot choose the id of a new profile),
+ *  4. with a profile_id: error if a connected bearer uses it ("Cannot use profile N: found an already connected
+ *     bearer"); QMI has no check/deactivate of an activated profile,
+ *  5. store: WDS Create Profile (no profile_id, the id is returned) or WDS Modify Profile, 10 s; an INVALID_PROFILE_TYPE
+ *     error is retried without the APN type TLV once (the modem does not support it, remembered),
+ *  6. list after: WDS Get Profile Settings of the stored profile ("Couldn't validate update of profile 'N': ...").
+ * While set and delete run the updated indications are ignored (mm_iface_modem_3gpp_profile_manager_update_ignore_*()),
+ * for 100 ms longer after a success.
+ *
+ * Deviations from MM:
+ *  - the profile_id of profile_delete must be 1..255 (MM passes it to a guint8 argument: 256 would be 0), the same
+ *    holds for the id of a set;
+ *  - a NULL string (profile name, APN, user, password) of the store requests is sent as an empty string (the
+ *    behaviour of libqmi for NULL is not known here);
+ *  - the wrong type of a value is invalid-args (MM: GVariant type errors).
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/uloop.h>
+#include <libubus.h>
+#include <talloc.h>
+
+#include "bearer.h"
+#include "logging.h"
+#include "modem.h"
+#include "modem_3gpp.h"
+#include "modem_modes_bands.h"
+#include "profile_manager.h"
+#include "qmi-enums-wds.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "ubus.h"
+#include "utils.h"
+
+/* the QMI indications: WDS Profile Changed, PDC Refresh */
+#define WDS_IND_PROFILE_CHANGED 0x00A8
+#define PDC_IND_REFRESH 0x002F
+
+/* mm-iface-modem-3gpp-profile-manager.c: UPDATED_TIMEOUT_SECS, DELAYED_UPDATE_IGNORE_STOP_TIMEOUT_MS */
+#define UPDATED_TIMEOUT_MS 2000
+#define DELAYED_UPDATE_IGNORE_STOP_MS 100
+
+/* mm-broadband-modem-qmi.c: the timeouts of the requests */
+#define LIST_TIMEOUT_MS 10000
+#define GET_TIMEOUT_MS 3000
+#define STORE_TIMEOUT_MS 10000
+#define EVENTS_TIMEOUT_MS 10000
+
+/* MM_3GPP_PROFILE_ID_UNKNOWN */
+#define PROFILE_ID_UNKNOWN (-1)
+/* QMI_WDS_PROFILE_TYPE_ALL */
+#define PROFILE_TYPE_ALL 255
+
+/* MMBearerIpFamily */
+#define IPF_NONE 0U
+#define IPF_IPV4 (1U << 0)
+#define IPF_IPV6 (1U << 1)
+#define IPF_IPV4V6 (1U << 2)
+#define IPF_NON_IP (1U << 3)
+#define IPF_ANY 0xFFFFFFFFU
+
+/* MMBearerAllowedAuth */
+#define AUTH_UNKNOWN 0U
+#define AUTH_NONE (1U << 0)
+#define AUTH_PAP (1U << 1)
+#define AUTH_CHAP (1U << 2)
+
+/* MMBearerApnType */
+#define APN_INITIAL (1U << 0)
+#define APN_DEFAULT (1U << 1)
+#define APN_IMS (1U << 2)
+#define APN_MMS (1U << 3)
+#define APN_MANAGEMENT (1U << 4)
+#define APN_EMERGENCY (1U << 6)
+#define APN_TETHERING (1U << 13)
+
+/* QmiWdsApnTypeMask (libqmi qmi-flags64-wds.h) */
+#define QAPN_DEFAULT (1ULL << 0)
+#define QAPN_IMS (1ULL << 1)
+#define QAPN_MMS (1ULL << 2)
+#define QAPN_DUN (1ULL << 3)
+#define QAPN_FOTA (1ULL << 6)
+#define QAPN_IA (1ULL << 8)
+#define QAPN_EMERGENCY (1ULL << 9)
+
+struct pm_profile {
+	int id;
+	char *name;
+	char *apn;
+	char *user;
+	char *password;
+	uint32_t ip_type;
+	uint32_t apn_type;
+	uint32_t allowed_auth;
+	uint32_t access_pref;
+	uint32_t roaming;
+	uint32_t source;
+	bool enabled;
+	bool enabled_set;
+	/* uqmid extension: the QMI profile PCSCF-using-PCO and IM CN flags (set: given / returned) */
+	bool pcscf_using_pco;
+	bool pcscf_using_pco_set;
+	bool im_cn;
+	bool im_cn_set;
+};
+
+/* a deferred user request */
+struct pm_req {
+	struct list_head list;
+	struct modem_pm *pm;
+	struct ubus_request_data req;
+};
+
+struct pm_delay {
+	struct list_head list;

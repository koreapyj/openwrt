+/*
+ * uqmid -- 3GPP interface of the modem (ModemManager: Modem3gpp)
+ *
+ * The user visible behaviour follows mm-iface-modem-3gpp.c (registration state consolidation, register,
+ * scan, initial EPS bearer settings), mm-broadband-modem-qmi.c (NAS system info / serving system) and
+ * mm-shared-qmi.c (register, scan).
+ */
+#ifndef __UQMID_MODEM_3GPP_H
+#define __UQMID_MODEM_3GPP_H
+
+#include <libubus.h>
+
+#include "modem.h"
+
+/* MMModem3gppRegistrationState */
+enum reg_state {
+	REG_IDLE = 0,
+	REG_HOME = 1,
+	REG_SEARCHING = 2,
+	REG_DENIED = 3,
+	REG_UNKNOWN = 4,
+	REG_ROAMING = 5,
+	REG_HOME_SMS_ONLY = 6,
+	REG_ROAMING_SMS_ONLY = 7,
+	REG_EMERGENCY_ONLY = 8,
+	REG_HOME_CSFB_NOT_PREFERRED = 9,
+	REG_ROAMING_CSFB_NOT_PREFERRED = 10,
+	REG_ATTACHED_RLOS = 11,
+};
+
+/* MMModemAccessTechnology (a mask) */
+#define ACT_POTS (1U << 0)
+#define ACT_GSM (1U << 1)
+#define ACT_GSM_COMPACT (1U << 2)
+#define ACT_GPRS (1U << 3)
+#define ACT_EDGE (1U << 4)
+#define ACT_UMTS (1U << 5)
+#define ACT_HSDPA (1U << 6)
+#define ACT_HSUPA (1U << 7)
+#define ACT_HSPA (1U << 8)
+#define ACT_HSPA_PLUS (1U << 9)
+#define ACT_1XRTT (1U << 10)
+#define ACT_EVDO0 (1U << 11)
+#define ACT_EVDOA (1U << 12)
+#define ACT_EVDOB (1U << 13)
+#define ACT_LTE (1U << 14)

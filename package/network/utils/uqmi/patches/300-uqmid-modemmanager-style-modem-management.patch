+static int parse_proto(struct blob_attr *attr, uint32_t *proto, const char **err)
+{
+	const char *s = ext_str(attr);
+	int val;
+
+	if (!attr)
+		return 0;
+	if (!s || !wds_name_to_val(ext_wda_aggregation_names, ext_wda_aggregation_names_n, s, true, &val)) {
+		*err = "the aggregation protocol has to be tlp, qc-cm, mbim, rndis, qmap or qmapv5";
+		return -1;
+	}
+	*proto = val;
+	return 0;
+}
+
+static int parse_count(struct blob_attr *attr, uint32_t *val, const char **err)
+{
+	if (ext_opt_uint(attr, 0, 0x7fffffff, val) < 0) {
+		*err = "the datagram count and size have to be numbers";
+		return -1;
+	}
+	return 0;
+}
+
+static int parse_wda_set(struct modem *modem, struct blob_attr **tb, struct ext_args *a, const char **err)
+{
+	const char *s = ext_str(tb[D_TYPE]);
+	uint32_t flow = 0;
+	int val, r;
+
+	if (!s || !wds_name_to_val(ext_wda_link_layer_names, ext_wda_link_layer_names_n, s, true, &val)) {
+		*err = "type has to be 802.3 or raw-ip";
+		return -1;
+	}
+	a->link = val;
+	/* like the CLI: not given is disabled and 0 */
+	a->dl.proto = a->ul.proto = QMI_WDA_DATA_AGGREGATION_PROTOCOL_DISABLED;
+	a->flow_control = -1;
+	if (parse_proto(tb[D_DL_PROTO], &a->dl.proto, err) || parse_proto(tb[D_UL_PROTO], &a->ul.proto, err) ||
+	    parse_count(tb[D_DL_COUNT], &a->dl.count, err) || parse_count(tb[D_DL_SIZE], &a->dl.size, err) ||
+	    parse_count(tb[D_UL_COUNT], &a->ul.count, err) || parse_count(tb[D_UL_SIZE], &a->ul.size, err))
+		return -1;
+	r = ext_opt_uint(tb[D_FLOW], 0, 1, &flow);
+	if (r < 0) {
+		*err = "flow_control has to be 0 or 1";
+		return -1;
+	}
+	if (r)
+		a->flow_control = flow;
+	return 0;
+}
+
+static int enc_wda_set(struct qmi_msg *msg, struct ext_args *a)
+{
+	struct qmi_wda_set_data_format_request req = {
+		QMI_INIT(link_layer_protocol, a->link),
+		QMI_INIT(uplink_data_aggregation_protocol, a->ul.proto),
+		QMI_INIT(uplink_data_aggregation_max_datagrams, a->ul.count),
+		QMI_INIT(uplink_data_aggregation_max_size, a->ul.size),
+		QMI_INIT(downlink_data_aggregation_protocol, a->dl.proto),
+		QMI_INIT(downlink_data_aggregation_max_datagrams, a->dl.count),
+		QMI_INIT(downlink_data_aggregation_max_size, a->dl.size),
+		QMI_INIT(downlink_minimum_padding, 0),
+	};
+
+	if (a->flow_control >= 0)
+		qmi_set(&req, flow_control, a->flow_control);
+	return qmi_set_wda_set_data_format_request(msg, &req);
+}

+/*****************************************************************************/
+/* QMI translations (mm-modem-helpers-qmi.c) */
+
+static uint32_t ip_from_qmi_pdp_type(uint8_t pdp_type)
+{
+	switch (pdp_type) {
+	case QMI_WDS_PDP_TYPE_IPV4: return IPF_IPV4;
+	case QMI_WDS_PDP_TYPE_IPV6: return IPF_IPV6;
+	case QMI_WDS_PDP_TYPE_IPV4_OR_IPV6: return IPF_IPV4V6;
+	default: return IPF_NONE;
+	}
+}
+
+static bool ip_to_qmi_pdp_type(uint32_t ip, uint8_t *pdp_type)
+{
+	switch (ip) {
+	case IPF_IPV4: *pdp_type = QMI_WDS_PDP_TYPE_IPV4; return true;
+	case IPF_IPV6: *pdp_type = QMI_WDS_PDP_TYPE_IPV6; return true;
+	case IPF_IPV4V6: *pdp_type = QMI_WDS_PDP_TYPE_IPV4_OR_IPV6; return true;
+	default: return false;
+	}
+}
+
+/* mm_bearer_allowed_auth_from_qmi_authentication() */
+static uint32_t auth_from_qmi(uint8_t auth)
+{
+	uint32_t out = 0;
+
+	if (auth == QMI_WDS_AUTHENTICATION_NONE)
+		return AUTH_NONE;
+	if (auth & QMI_WDS_AUTHENTICATION_PAP)
+		out |= AUTH_PAP;
+	if (auth & QMI_WDS_AUTHENTICATION_CHAP)
+		out |= AUTH_CHAP;
+
+	return out;
+}
+
+/* mm_bearer_allowed_auth_to_qmi_authentication(): false if the methods are not supported */
+static bool auth_to_qmi(uint32_t auth, uint8_t *out)
+{
+	if (auth == AUTH_UNKNOWN) {
+		*out = QMI_WDS_AUTHENTICATION_CHAP;
+		return true;
+	}
+	if (auth == AUTH_NONE) {
+		*out = QMI_WDS_AUTHENTICATION_NONE;
+		return true;
+	}
+
+	*out = QMI_WDS_AUTHENTICATION_NONE;
+	if (auth & AUTH_PAP)
+		*out |= QMI_WDS_AUTHENTICATION_PAP;
+	if (auth & AUTH_CHAP)
+		*out |= QMI_WDS_AUTHENTICATION_CHAP;
+
+	return *out != QMI_WDS_AUTHENTICATION_NONE;
+}
+
+/* mm_bearer_apn_type_to_qmi_apn_type() */
+static uint64_t apn_type_to_qmi(uint32_t apn_type)
+{
+	uint64_t value = 0;
+
+	if (apn_type == 0)
+		return QAPN_DEFAULT;
+	if (apn_type & APN_DEFAULT)
+		value |= QAPN_DEFAULT;
+	if (apn_type & APN_IMS)
+		value |= QAPN_IMS;
+	if (apn_type & APN_MMS)
+		value |= QAPN_MMS;
+	if (apn_type & APN_TETHERING)
+		value |= QAPN_DUN;
+	if (apn_type & APN_MANAGEMENT)
+		value |= QAPN_FOTA;
+	if (apn_type & APN_INITIAL)
+		value |= QAPN_IA;
+	if (apn_type & APN_EMERGENCY)
+		value |= QAPN_EMERGENCY;
+
+	return value;
+}
+
+/* mm_bearer_apn_type_from_qmi_apn_type() */
+static uint32_t apn_type_from_qmi(uint64_t apn_type)
+{
+	uint32_t value = 0;
+
+	if (apn_type & QAPN_DEFAULT)
+		value |= APN_DEFAULT;
+	if (apn_type & QAPN_IMS)
+		value |= APN_IMS;
+	if (apn_type & QAPN_MMS)
+		value |= APN_MMS;
+	if (apn_type & QAPN_DUN)
+		value |= APN_TETHERING;
+	if (apn_type & QAPN_FOTA)
+		value |= APN_MANAGEMENT;
+	if (apn_type & QAPN_IA)
+		value |= APN_INITIAL;
+	if (apn_type & QAPN_EMERGENCY)
+		value |= APN_EMERGENCY;
+
+	return value;
+}
+
+/* the message of a failed request (MM: the GError of libqmi), the error of the user request */
+static void pm_qmi_err(char *buf, size_t len, const char *prefix, struct qmi_msg *msg, struct qmi_request *req)
+{
+	if (req->ret == UQMID_ERROR_TIMEOUT)
+		snprintf(buf, len, "%sTransaction timed out", prefix);
+	else if (!msg && !req->ret)
+		snprintf(buf, len, "%srequest failed", prefix);
+	else if (req->ret > 0)
+		snprintf(buf, len, "%sQMI protocol error (%d): '%s'", prefix, req->ret, qmi_get_error_str(req->ret));
+	else
+		snprintf(buf, len, "%srequest failed (%d)", prefix, req->ret);
+}
+
+static enum modem_error pm_qmi_err_code(const struct qmi_request *req)
+{
+	return req->ret == UQMID_ERROR_TIMEOUT ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED;
+}
+
+/* qmi_wds_ds_profile_error_get_string() */
+static const char *ds_profile_error_name(unsigned int code)
+{
+	switch (code) {
+	case QMI_WDS_DS_PROFILE_ERROR_UNKNOWN: return "Unknown";
+	case QMI_WDS_DS_PROFILE_ERROR_FAIL: return "Fail";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_HANDLE: return "InvalidHandle";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_OPERATION: return "InvalidOperation";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_PROFILE_TYPE: return "InvalidProfileType";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_PROFILE_NUMBER: return "InvalidProfileNumber";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_PROFILE_ID: return "InvalidProfileId";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_ARGUMENT: return "InvalidArgument";
+	case QMI_WDS_DS_PROFILE_ERROR_REGISTRY_NOT_INITIALIZED: return "RegistryNotInitialized";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_PARAMETER_LENGTH: return "InvalidParameterLength";
+	case QMI_WDS_DS_PROFILE_ERROR_LIST_END: return "ListEnd";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_SUBSCRIPTION_ID: return "InvalidSubscriptionId";
+	case QMI_WDS_DS_PROFILE_ERROR_INVALID_PROFILE_FAMILY: return "InvalidProfileFamily";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_INVALID_PROFILE_FAMILY: return "3gppInvalidProfileFamily";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_ACCESS_ERROR: return "3gppAccessError";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_CONTEXT_NOT_DEFINED: return "3gppContextNotDefined";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_VALID_FLAG_NOT_SET: return "3gppValidFlagNotSet";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_READ_ONLY_FLAG_SET: return "3gppReadOnlyFlagSet";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP_OUT_OF_PROFILES: return "3gppOutOfProfiles";
+	case QMI_WDS_DS_PROFILE_ERROR_3GPP2_INVALID_PROFILE_ID: return "3gpp2InvalidProfileId";
+	default: return "unknown";
+	}
+}
+
+static struct qmi_service *pm_wds(struct modem_pm *pm)
+{
+	return uqmid_3gpp_wds(pm->modem);
+}
+
+/*****************************************************************************/
+/* get one profile (modem_3gpp_profile_manager_get_profile(): WDS Get Profile Settings, 3 s) */
+
+struct get_ctx {
+	struct modem_pm *pm;
+	unsigned int id;
+	void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile *profile, void *data);
+	void *data;
+};
+
+static void get_profile_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct get_ctx *g = req->cb_data;
+	struct modem_pm *pm = g->pm;
+	struct qmi_wds_get_profile_settings_response res = {};
+	struct pm_profile *p;
+	char err[200], full[260];
+	void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile *profile, void *data) = g->cb;
+	void *data = g->data;
+	unsigned int id = g->id;
+
+	talloc_free(g);
+
+	if (!msg || req->ret || qmi_parse_wds_get_profile_settings_response(msg, &res)) {
+		pm_qmi_err(err, sizeof(err), "", msg, req);
+		snprintf(full, sizeof(full), "Couldn't load settings from profile index %u: %s", id, err);
+		cb(pm, pm_qmi_err_code(req), full, NULL, data);
+		return;
+	}
+
+	/* just ignore the profile if it's disabled */
+	if (res.set.apn_disabled_flag && res.data.apn_disabled_flag) {
+		snprintf(full, sizeof(full), "Profile '%d' is internally disabled", id);
+		cb(pm, MODEM_ERR_FAILED, full, NULL, data);
+		return;
+	}
+
+	/* wds_profile_settings_to_3gpp_profile() */
+	p = profile_new(pm);
+	if (!p) {
+		cb(pm, MODEM_ERR_FAILED, "Out of memory", NULL, data);
+		return;
+	}
+
+	/* On 3GPP modems, the modem seems to force profile-index = pdp-context-number, and so, we're just going to rely
+	 * on the profile-index ourselves. */
+	p->id = id;
+	if (res.data.apn_name)
+		profile_set_str(p, &p->apn, res.data.apn_name);
+	if (res.data.profile_name)
+		profile_set_str(p, &p->name, res.data.profile_name);
+	if (res.set.pdp_type)
+		p->ip_type = ip_from_qmi_pdp_type(res.data.pdp_type);
+	if (res.set.authentication)
+		p->allowed_auth = auth_from_qmi(res.data.authentication);
+	/* ignore empty user/pass strings */
+	if (res.data.username && res.data.username[0])
+		profile_set_str(p, &p->user, res.data.username);
+	if (res.data.password && res.data.password[0])
+		profile_set_str(p, &p->password, res.data.password);
+
+	if (res.set.pcscf_address_using_pco) {
+		p->pcscf_using_pco = res.data.pcscf_address_using_pco;
+		p->pcscf_using_pco_set = true;
+	}
+	if (res.set.imcn_flag) {
+		p->im_cn = res.data.imcn_flag;
+		p->im_cn_set = true;
+	}
+
+	/* If loading APN type TLV fails, flag it as unsupported so that we don't try to use it any more. */
+	if (res.set.apn_type_mask) {
+		p->apn_type = apn_type_from_qmi(res.data.apn_type_mask);
+	} else if (!pm->apn_type_not_supported) {
+		modem_log(pm->modem, LOGL_DEBUG, "APN type flagged as not supported: not given in profile settings");
+		pm->apn_type_not_supported = true;
+	}
+
+	cb(pm, MODEM_ERR_NONE, NULL, p, data);
+}
+
+static void get_profile(struct modem_pm *pm, unsigned int id,
+			void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile *profile,
+				   void *data), void *data)
+{
+	struct qmi_service *wds = pm_wds(pm);
+	struct qmi_wds_get_profile_settings_request pr = {};
+	struct get_ctx *g;
+
+	if (!wds) {
+		cb(pm, MODEM_ERR_FAILED, "Couldn't find client for service 'wds'", NULL, data);
+		return;
+	}
+
+	g = talloc_zero(pm, struct get_ctx);
+	g->pm = pm;
+	g->id = id;
+	g->cb = cb;
+	g->data = data;
+
+	pr.set.profile_id = 1;
+	pr.data.profile_id.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+	pr.data.profile_id.profile_index = id;
+	if (SEND_REQ(wds, qmi_set_wds_get_profile_settings_request(_m, &pr), get_profile_cb, g, GET_TIMEOUT_MS)) {
+		talloc_free(g);
+		cb(pm, MODEM_ERR_FAILED, "Couldn't send the request", NULL, data);
+	}
+}
+
+/*****************************************************************************/
+/* list the profiles (modem_3gpp_profile_manager_list_profiles(): WDS Get Profile List, 10 s, then the settings of
+ * each profile one after the other) */
+
+struct pm_list {
+	struct modem_pm *pm;
+	void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile **profiles,
+		   unsigned int n, void *data);
+	void *data;
+	uint8_t index[256];
+	unsigned int n_index;
+	unsigned int i;
+	/* children of the list */
+	struct pm_profile **profiles;
+	unsigned int n;
+};
+
+static void list_finish(struct pm_list *l, enum modem_error err, const char *msg)
+{
+	struct modem_pm *pm = l->pm;
+	void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile **profiles,
+		   unsigned int n, void *data) = l->cb;
+	void *data = l->data;
+	char *msg_copy = msg ? talloc_strdup(NULL, msg) : NULL;
+
+	/* the profiles stay children of the list, the callback frees it */
+	cb(pm, err, msg_copy, err ? NULL : l->profiles, err ? 0 : l->n, data);
+	talloc_free(msg_copy);
+	talloc_free(l);
+}
+
+static void list_next(struct pm_list *l);
+
+static void list_profile_cb(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile *profile,
+			    void *data)
+{
+	struct pm_list *l = data;
+	char full[260];
+
+	if (!profile) {
+		/* "Couldn't load settings from profile index %u: " with the position in the list (MM: ctx->i) */
+		snprintf(full, sizeof(full), "Couldn't load settings from profile index %u: %s", l->i, msg);
+		list_finish(l, err, full);
+		return;
+	}
+
+	l->profiles[l->n++] = talloc_steal(l, profile);
+	/* Keep on */
+	l->i++;
+	list_next(l);
+}
+
+static void list_next(struct pm_list *l)
+{
+	if (l->i >= l->n_index) {
+		/* All done */
+		list_finish(l, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	get_profile(l->pm, l->index[l->i], list_profile_cb, l);
+}
+
+static void list_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct pm_list *l = req->cb_data;
+	struct qmi_wds_get_profile_list_response res = {};
+	char err[200];
+	unsigned int i;
+
+	if (!msg || req->ret || qmi_parse_wds_get_profile_list_response(msg, &res)) {
+		pm_qmi_err(err, sizeof(err), "", msg, req);
+		list_finish(l, pm_qmi_err_code(req), err);
+		return;
+	}
+
+	/* empty list? */
+	for (i = 0; i < res.data.profile_list_n && l->n_index < ARRAY_SIZE(l->index); i++)
+		l->index[l->n_index++] = res.data.profile_list[i].profile_index;
+	l->profiles = talloc_zero_array(l, struct pm_profile *, l->n_index ? l->n_index : 1);
+	l->i = 0;
+	list_next(l);
+}
+
+/* the callback frees nothing: the profiles are children of the list, which is freed after the callback. To keep them
+ * the callback takes them over (talloc_steal). */
+static void list_profiles(struct modem_pm *pm,
+			  void (*cb)(struct modem_pm *pm, enum modem_error err, const char *msg,
+				     struct pm_profile **profiles, unsigned int n, void *data), void *data)
+{
+	struct qmi_service *wds = pm_wds(pm);
+	struct qmi_wds_get_profile_list_request lr = {};
+	struct pm_list *l;
+
+	if (!wds) {
+		cb(pm, MODEM_ERR_FAILED, "Couldn't find client for service 'wds'", NULL, 0, data);
+		return;
+	}
+
+	l = talloc_zero(pm, struct pm_list);
+	l->pm = pm;
+	l->cb = cb;
+	l->data = data;
+
+	lr.set.profile_type = 1;
+	lr.data.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+	if (SEND_REQ(wds, qmi_set_wds_get_profile_list_request(_m, &lr), list_cb, l, LIST_TIMEOUT_MS)) {
+		talloc_free(l);
+		cb(pm, MODEM_ERR_FAILED, "Couldn't send the request", NULL, 0, data);
+	}
+}
+
+/*****************************************************************************/
+/* the Updated signal (mm_iface_modem_3gpp_profile_manager_updated() and the update ignore) */
+
+static void pm_updated_timer_cb(struct uloop_timeout *t)
+{
+	struct modem_pm *pm = container_of(t, struct modem_pm, updated_timer);
+	struct modem *modem = pm->modem;
+	struct blob_buf nb = {};
+
+	modem_log(modem, LOGL_INFO, "emitting profile manager updated...");
+	if (!modem->ubus.id)
+		return;
+
+	blob_buf_init(&nb, 0);
+	ubus_notify(ubus_ctx, &modem->ubus, "profile_manager.updated", nb.head, -1);
+	blob_buf_free(&nb);
+}
+
+static void pm_updated(struct modem_pm *pm)
+{
+	if (!pm->supported) {
+		modem_log(pm->modem, LOGL_INFO, "skipping profile manager updated signal: unsupported");
+		return;
+	}
+
+	if (pm->update_ignored > 0) {
+		modem_log(pm->modem, LOGL_INFO, "skipping profile manager updated signal: ignored");
+		return;
+	}
+
+	/* Throttle the amount of signals: one scheduled is enough */
+	if (pm->updated_timer.pending) {
+		modem_log(pm->modem, LOGL_INFO, "skipping profile manager updated signal: one already scheduled");
+		return;
+	}
+
+	modem_log(pm->modem, LOGL_INFO, "profile manager updated signal scheduled");
+	uloop_timeout_set(&pm->updated_timer, UPDATED_TIMEOUT_MS);
+}
+
+static void pm_update_ignore_start(struct modem_pm *pm)
+{
+	if (!pm->supported)
+		return;
+
+	pm->update_ignored++;
+	modem_log(pm->modem, LOGL_DEBUG, "ignoring profile manager updates during our own operations (%d ongoing)",
+		  pm->update_ignored);
+}
+
+static void pm_update_ignore_stop(struct modem_pm *pm)
+{
+	if (!pm->supported || pm->update_ignored <= 0)
+		return;
+
+	pm->update_ignored--;
+	if (pm->update_ignored > 0)
+		modem_log(pm->modem, LOGL_DEBUG,
+			  "still ignoring profile manager updates during our own operations (%d ongoing)",
+			  pm->update_ignored);
+	else
+		modem_log(pm->modem, LOGL_DEBUG, "no longer ignoring profile manager updates during our own operations");
+}
+
+static void pm_delay_cb(struct uloop_timeout *t)
+{
+	struct pm_delay *d = container_of(t, struct pm_delay, timer);
+	struct modem_pm *pm = d->pm;
+
+	list_del(&d->list);
+	talloc_free(d);
+	pm_update_ignore_stop(pm);
+}
+
+/* Wait some ms before actually enabling back the update requests */
+static void pm_update_ignore_stop_delayed(struct modem_pm *pm)
+{
+	struct pm_delay *d;
+
+	if (!pm->supported)
+		return;
+
+	d = talloc_zero(pm, struct pm_delay);
+	if (!d) {
+		pm_update_ignore_stop(pm);
+		return;
+	}
+
+	modem_log(pm->modem, LOGL_DEBUG, "delayed request to stop ignoring profile manager updates");
+	d->pm = pm;
+	d->timer.cb = pm_delay_cb;
+	list_add_tail(&d->list, &pm->delays);
+	uloop_timeout_set(&d->timer, DELAYED_UPDATE_IGNORE_STOP_MS);
+}
+
+/* QMI: WDS profile changed indication, PDC refresh indication */
+static void wds_profile_changed_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	modem_log(((struct modem_pm *)data)->modem, LOGL_DEBUG, "profile changed indication was received");
+	pm_updated(data);
+}
+
+static void pdc_refresh_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	modem_log(((struct modem_pm *)data)->modem, LOGL_DEBUG, "profile refresh indication was received");
+	pm_updated(data);
+}
+
+/*****************************************************************************/
+/* the user requests */
+
+static struct pm_req *req_new(struct modem_pm *pm, struct ubus_context *ctx, struct ubus_request_data *req)
+{
+	struct pm_req *rq = talloc_zero(pm, struct pm_req);
+
+	if (!rq)
+		return NULL;
+
+	rq->pm = pm;
+	ubus_defer_request(ctx, req, &rq->req);
+	list_add_tail(&rq->list, &pm->reqs);
+
+	return rq;
+}
+
+static void req_done(struct pm_req *rq, enum modem_error err, const char *msg, struct blob_attr *reply)
+{
+	list_del(&rq->list);
+	uqmid_ubus_deferred_done(&rq->req, err, msg, reply);
+	talloc_free(rq);
+}
+
+/* the gates of the handlers: the interface exists, mm_iface_modem_abort_invocation_if_state_not_reached(ENABLED) */
+static int pm_gate(struct ubus_context *ctx, struct ubus_request_data *req, struct modem *modem)
+{
+	struct modem_pm *pm = pm_of(modem);
+	char text[64];
+
+	/* MM does not export the interface if the profile management is not supported */
+	if (!pm || !pm->supported)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED, "Profile management not supported");
+
+	if (modem->mm_state < MODEM_STATE_ENABLED) {
+		snprintf(text, sizeof(text), "modem in %s state", modem_state_name(modem->mm_state));
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, text);
+	}
+
+	return -1;
+}
+
+/* the bearer list: a connected bearer uses the profile (mm_bearer_list_find_by_profile_id()) */
+static bool fail_if_connected_bearer(struct modem_pm *pm, int profile_id, char *msg, size_t len)
+{
+	if (!uqmid_bearers_profile_in_use(pm->modem, profile_id))
+		return true;
+
+	snprintf(msg, len, "Cannot use profile %d: found an already connected bearer", profile_id);
+	return false;
+}
+
+/* --- list --- */
+
+static void handle_list_ready(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile **profiles,
+			      unsigned int n, void *data)
+{
+	struct pm_req *rq = data;
+	unsigned int i;
+	void *a;
+
+	if (err) {
+		modem_log(pm->modem, LOGL_NOTICE, "failed listing 3GPP profiles: %s", msg);
+		req_done(rq, err, msg, NULL);
+		return;
+	}
+
+	modem_log(pm->modem, LOGL_INFO, "listed 3GPP profiles: %u found", n);
+	blob_buf_init(&b, 0);
+	a = blobmsg_open_array(&b, "profiles");
+	for (i = 0; i < n; i++) {
+		profile_log(pm->modem, "profile", profiles[i]);
+		profile_add(&b, NULL, profiles[i]);
+	}
+	blobmsg_close_array(&b, a);
+	req_done(rq, MODEM_ERR_NONE, NULL, b.head);
+}
+
+/** ubus call uqmid.modem.0 profile_list */
+static int h_profile_list(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_pm *pm = pm_of(modem);
+	struct pm_req *rq;
+	int ret = pm_gate(ctx, req, modem);
+
+	if (ret >= 0)
+		return ret;
+
+	rq = req_new(pm, ctx, req);
+	if (!rq)
+		return UBUS_STATUS_NO_MEMORY;
+
+	modem_log(modem, LOGL_INFO, "processing user request to list 3GPP profiles...");
+	list_profiles(pm, handle_list_ready, rq);
+
+	return UBUS_STATUS_OK;
+}
+
+/* --- set (mm_iface_modem_3gpp_profile_manager_set_profile()) --- */
+
+enum set_step {
+	SET_FIRST,
+	SET_CHECK_FORMAT,
+	SET_LIST_BEFORE,
+	SET_SELECT_PROFILE,
+	SET_CHECK_ACTIVATED_PROFILE,
+	SET_DEACTIVATE_PROFILE,
+	SET_STORE_PROFILE,
+	SET_LIST_AFTER,
+	SET_LAST,
+};
+
+struct pm_set {
+	struct modem_pm *pm;
+	struct pm_req *rq;
+	enum set_step step;
+	struct pm_profile *requested;
+	int profile_id;
+	struct pm_profile **before;
+	unsigned int n_before;
+	/* talloc context of the list of before, freed with the set */
+	void *before_ctx;
+	struct pm_profile *stored;
+	/* StoreProfileContext */
+	uint8_t qmi_pdp_type;
+	uint8_t qmi_auth;
+	uint64_t qmi_apn_type;
+};
+
+static void set_step(struct pm_set *s);
+
+static void set_finish(struct pm_set *s, enum modem_error err, const char *msg)
+{
+	struct modem_pm *pm = s->pm;
+	struct pm_req *rq = s->rq;
+
+	if (err) {
+		modem_log(pm->modem, LOGL_NOTICE, "failed setting 3GPP profile: %s", msg);
+		/* process profile manager updates right away on error */
+		pm_update_ignore_stop(pm);
+		req_done(rq, err, msg, NULL);
+		return;
+	}
+
+	profile_log(pm->modem, "3GPP profile set", s->stored);
+	/* delay processing profile manager updates on success */
+	pm_update_ignore_stop_delayed(pm);
+
+	blob_buf_init(&b, 0);
+	profile_add(&b, "profile", s->stored);
+	req_done(rq, MODEM_ERR_NONE, NULL, b.head);
+}
+
+static void set_next(struct pm_set *s)
+{
+	s->step++;
+	set_step(s);
+}
+
+/* profile_manager_get_profile_after_ready() */
+static void set_after_cb(struct modem_pm *pm, enum modem_error err, const char *msg, struct pm_profile *profile,
+			 void *data)
+{
+	struct pm_set *s = data;
+	char full[260];
+
+	if (!profile) {
+		snprintf(full, sizeof(full), "Couldn't validate update of profile '%d': %s", s->profile_id, msg);
+		set_finish(s, err, full);
+		return;
+	}
+
+	s->stored = talloc_steal(s, profile);
+	set_next(s);
+}
+
+/* modem_3gpp_profile_manager_store_profile(): the requests */
+static void store_run(struct pm_set *s);
+
+static void store_finish_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct pm_set *s = req->cb_data;
+	struct modem_pm *pm = s->pm;
+	bool create = s->profile_id == PROFILE_ID_UNKNOWN;
+	struct qmi_wds_create_profile_response cres = {};
+	struct qmi_wds_modify_profile_response mres = {};
+	unsigned int ext = 0;
+	bool have_ext = false;
+	char err[220], full[300];
+	int code = 0;
+
+	if (msg) {
+		if (create) {
+			code = qmi_parse_wds_create_profile_response(msg, &cres);
+			have_ext = cres.set.extended_error_code;
+			ext = cres.data.extended_error_code;
+		} else {
+			code = qmi_parse_wds_modify_profile_response(msg, &mres);
+			have_ext = mres.set.extended_error_code;
+			ext = mres.data.extended_error_code;
+		}
+		if (req->ret)
+			code = req->ret;
+	}
+
+	if (!msg || code) {
+		if (msg && code == QMI_PROTOCOL_ERROR_INVALID_PROFILE_TYPE && !pm->apn_type_not_supported) {
+			/* we'll retry the operation without APN type, which is a setting available only in newer devices. */
+			modem_log(pm->modem, LOGL_DEBUG, "APN type flagged as not supported: failed to %s profile",
+				  create ? "create" : "modify");
+			pm->apn_type_not_supported = true;
+			store_run(s);
+			return;
+		}
+
+		err[0] = 0;
+		if (msg && code == QMI_PROTOCOL_ERROR_EXTENDED_INTERNAL && have_ext)
+			snprintf(err, sizeof(err), "DS profile error: %s: ", ds_profile_error_name(ext));
+		pm_qmi_err(full, sizeof(full), create ? "Couldn't create profile: " : "Couldn't modify profile: ", msg, req);
+		if (err[0]) {
+			char tmp[300];
+
+			snprintf(tmp, sizeof(tmp), "%s%s", err, full);
+			snprintf(full, sizeof(full), "%s", tmp);
+		}
+		set_finish(s, pm_qmi_err_code(req), full);
+		return;
+	}
+
+	if (create) {
+		/* the id of the new profile (when creating with an unbound input profile id, store the one received) */
+		if (!cres.set.profile_identifier) {
+			set_finish(s, MODEM_ERR_FAILED, "Couldn't get the identifier of the created profile");
+			return;
+		}
+		s->profile_id = cres.data.profile_identifier.profile_index;
+	}
+
+	modem_log(pm->modem, LOGL_DEBUG, "stored profile '%d'", s->profile_id);
+	set_next(s);
+}
+
+static void store_run(struct pm_set *s)
+{
+	struct modem_pm *pm = s->pm;
+	struct pm_profile *r = s->requested;
+	struct qmi_service *wds = pm_wds(pm);
+	/* a NULL string is sent as an empty one */
+	char *name = r->name ? r->name : (char *)"";
+	char *apn = r->apn ? r->apn : (char *)"";
+	char *user = r->user ? r->user : (char *)"";
+	char *password = r->password ? r->password : (char *)"";
+	int ret;
+
+	if (!wds) {
+		set_finish(s, MODEM_ERR_FAILED, "Couldn't find client for service 'wds'");
+		return;
+	}
+
+	if (s->profile_id == PROFILE_ID_UNKNOWN) {
+		struct qmi_wds_create_profile_request cr = {};
+
+		/* when creating, we cannot select which profile id to use */
+		cr.set.profile_type = 1;
+		cr.data.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+		cr.data.profile_name = name;
+		cr.set.pdp_type = 1;
+		cr.data.pdp_type = s->qmi_pdp_type;
+		cr.data.apn_name = apn;
+		cr.set.authentication = 1;
+		cr.data.authentication = s->qmi_auth;
+		cr.data.username = user;
+		cr.data.password = password;
+		if (!pm->apn_type_not_supported) {
+			cr.set.apn_type_mask = 1;
+			cr.data.apn_type_mask = s->qmi_apn_type;
+		}
+		if (r->pcscf_using_pco_set) {
+			cr.set.pcscf_address_using_pco = 1;
+			cr.data.pcscf_address_using_pco = r->pcscf_using_pco;
+		}
+		if (r->im_cn_set) {
+			cr.set.imcn_flag = 1;
+			cr.data.imcn_flag = r->im_cn;
+		}
+		ret = SEND_REQ(wds, qmi_set_wds_create_profile_request(_m, &cr), store_finish_cb, s, STORE_TIMEOUT_MS);
+	} else {
+		struct qmi_wds_modify_profile_request mr = {};
+
+		mr.set.profile_identifier = 1;
+		mr.data.profile_identifier.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+		mr.data.profile_identifier.profile_index = s->profile_id;
+		mr.data.profile_name = name;
+		mr.set.pdp_type = 1;
+		mr.data.pdp_type = s->qmi_pdp_type;
+		mr.data.apn_name = apn;
+		mr.set.authentication = 1;
+		mr.data.authentication = s->qmi_auth;
+		mr.data.username = user;
+		mr.data.password = password;
+		if (!pm->apn_type_not_supported) {
+			mr.set.apn_type_mask = 1;
+			mr.data.apn_type_mask = s->qmi_apn_type;
+		}
+		if (r->pcscf_using_pco_set) {
+			mr.set.pcscf_address_using_pco = 1;
+			mr.data.pcscf_address_using_pco = r->pcscf_using_pco;
+		}
+		if (r->im_cn_set) {
+			mr.set.imcn_flag = 1;
+			mr.data.imcn_flag = r->im_cn;
+		}
+		ret = SEND_REQ(wds, qmi_set_wds_modify_profile_request(_m, &mr), store_finish_cb, s, STORE_TIMEOUT_MS);
+	}
+
+	if (ret)
+		set_finish(s, MODEM_ERR_FAILED, "Couldn't send the request");
+}
+
+/* modem_3gpp_profile_manager_store_profile(): the arguments of the requests */
+static void store_start(struct pm_set *s)
+{
+	struct pm_profile *r = s->requested;
+	char text[100], *p;
+	unsigned int i;
+
+	s->qmi_apn_type = apn_type_to_qmi(r->apn_type);
+
+	s->qmi_auth = QMI_WDS_AUTHENTICATION_NONE;
+	if (r->allowed_auth != AUTH_UNKNOWN || r->user || r->password) {
+		if (!auth_to_qmi(r->allowed_auth, &s->qmi_auth)) {
+			text[0] = 0;
+			for (i = 0; i < ARRAY_SIZE(auth_nicks); i++) {
+				if (r->allowed_auth & auth_nicks[i].value)
+					snprintf(text + strlen(text), sizeof(text) - strlen(text), "%s%s",
+						 text[0] ? ", " : "", auth_nicks[i].name);
+			}
+			p = talloc_asprintf(s, "Unsupported authentication methods (%s)", text);
+			set_finish(s, MODEM_ERR_UNSUPPORTED, p);
+			return;
+		}
+	}
+
+	if (!ip_to_qmi_pdp_type(r->ip_type, &s->qmi_pdp_type)) {
+		text[0] = 0;
+		for (i = 0; i < ARRAY_SIZE(ip_nicks); i++) {
+			if (r->ip_type & ip_nicks[i].value)
+				snprintf(text + strlen(text), sizeof(text) - strlen(text), "%s%s", text[0] ? ", " : "",
+					 ip_nicks[i].name);
+		}
+		p = talloc_asprintf(s, "Invalid IP type specified: %s", text);
+		set_finish(s, MODEM_ERR_FAILED, p);
+		return;
+	}
+
+	store_run(s);
+}
+
+static void set_list_before_cb(struct modem_pm *pm, enum modem_error err, const char *msg,
+			       struct pm_profile **profiles, unsigned int n, void *data)
+{
+	struct pm_set *s = data;
+
+	if (err) {
+		/* failures are only logged: no profiles known */
+		modem_log(pm->modem, LOGL_DEBUG, "failed checking currently defined contexts: %s", msg);
+	} else {
+		/* keep the profiles: they are children of the list which is freed after this callback */
+		unsigned int i;
+
+		s->before = talloc_zero_array(s, struct pm_profile *, n ? n : 1);
+		for (i = 0; i < n; i++)
+			s->before[i] = talloc_steal(s, profiles[i]);
+		s->n_before = n;
+	}
+
+	set_next(s);
+}
+
+/* mm_3gpp_profile_list_find_by_profile_id() */
+static struct pm_profile *find_by_id(struct pm_profile **list, unsigned int n, int id)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (list[i]->id == id)
+			return list[i];
+	}
+
+	return NULL;
+}
+
+static void set_step(struct pm_set *s)
+{
+	struct modem_pm *pm = s->pm;
+	struct modem *modem = pm->modem;
+	char text[160];
+
+	switch (s->step) {
+	case SET_FIRST:
+		s->step++;
+		/* fall through */
+
+	case SET_CHECK_FORMAT:
+		/*
+		 * modem_3gpp_profile_manager_check_format(): the generic WDS Create Profile does NOT allow specifying
+		 * a specific profile id: no new id, ids 1 to INT_MAX - 1, the default string comparison of the APN and
+		 * the flags (no access type preference, no roaming allowance, no profile source) are used below.
+		 */
+		modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): check format", s->step, SET_LAST);
+		s->step++;
+		/* fall through */
+
+	case SET_LIST_BEFORE:
+		modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): list before", s->step, SET_LAST);
+		list_profiles(pm, set_list_before_cb, s);
+		return;
+
+	case SET_SELECT_PROFILE:
+		if (s->profile_id != PROFILE_ID_UNKNOWN) {
+			struct pm_profile *existing;
+
+			modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): select profile (exact)", s->step,
+				  SET_LAST);
+			/* Look for the exact profile we want to use */
+			existing = find_by_id(s->before, s->n_before, s->profile_id);
+			if (!existing) {
+				snprintf(text, sizeof(text), "Profile '%d' not found", s->profile_id);
+				set_finish(s, MODEM_ERR_NOT_FOUND, text);
+				return;
+			}
+
+			/* If the profile is 100% equal to what we require, nothing to do */
+			if (profile_cmp(existing, s->requested)) {
+				modem_log(modem, LOGL_DEBUG, "reusing profile '%d'", s->profile_id);
+				s->stored = existing;
+			} else {
+				modem_log(modem, LOGL_DEBUG, "overwriting profile '%d'", s->profile_id);
+			}
+		} else {
+			/* strict, and QMI cannot choose the id of a new profile: nothing selected */
+			modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): select profile (none)", s->step,
+				  SET_LAST);
+		}
+		s->step++;
+		/* fall through */
+
+	case SET_CHECK_ACTIVATED_PROFILE:
+		/* If the modem/protocol doesn't allow preselecting the profile id of a new profile we're going to
+		 * create, then we won't have a profile id set at this point: skip this step. */
+		if (s->profile_id != PROFILE_ID_UNKNOWN) {
+			modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): check activated profile", s->step,
+				  SET_LAST);
+			/* A quick check on our own bearer list. If we have a known bearer connected using the same
+			 * profile id, we fail the operation right away. QMI has no query of the activated profile. */
+			if (!fail_if_connected_bearer(pm, s->profile_id, text, sizeof(text))) {
+				set_finish(s, MODEM_ERR_FAILED, text);
+				return;
+			}
+		}
+		/* QMI: no deactivate_profile */
+		s->step = SET_STORE_PROFILE;
+		/* fall through */
+
+	case SET_STORE_PROFILE:
+		/* if we're reusing an already existing profile, we can jump to the last step now */
+		if (s->stored) {
+			modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): profile already stored", s->step,
+				  SET_LAST);
+			s->step = SET_LAST;
+			set_step(s);
+			return;
+		}
+		modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): store profile", s->step, SET_LAST);
+		store_start(s);
+		return;
+
+	case SET_LIST_AFTER:
+		modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): list after", s->step, SET_LAST);
+		get_profile(pm, s->profile_id, set_after_cb, s);
+		return;
+
+	case SET_LAST:
+		modem_log(modem, LOGL_DEBUG, "set profile state (%d/%d): all done", s->step, SET_LAST);
+		set_finish(s, MODEM_ERR_NONE, NULL);
+		return;
+
+	default:
+		break;
+	}
+}
+
+enum { PS_PROFILE, __PS_MAX };
+static const struct blobmsg_policy profile_set_policy[__PS_MAX] = {
+	[PS_PROFILE] = { .name = "profile", .type = BLOBMSG_TYPE_TABLE },
+};
+
+/** ubus call uqmid.modem.0 profile_set '{"profile":{"apn":"internet","ip_type":"ipv4v6"}}' */
+static int h_profile_set(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			 const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_pm *pm = pm_of(modem);
+	struct blob_attr *tb[__PS_MAX];
+	struct pm_req *rq;
+	struct pm_set *s;
+	struct pm_profile *requested;
+	char err[100];
+	const char *perr;
+	int ret = pm_gate(ctx, req, modem);
+
+	if (ret >= 0)
+		return ret;
+
+	blobmsg_parse(profile_set_policy, __PS_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[PS_PROFILE])
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Missing requested profile settings");
+
+	/* mm_iface_modem_3gpp_profile_manager_set_profile() works on a copy, here the request is parsed into one */
+	requested = profile_new(pm);
+	if (!requested)
+		return UBUS_STATUS_NO_MEMORY;
+	perr = profile_parse(requested, tb[PS_PROFILE], err, sizeof(err));
+	if (perr) {
+		talloc_free(requested);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, perr);
+	}
+	/* the id must fit the QMI profile index */
+	if (requested->id != PROFILE_ID_UNKNOWN && (requested->id < 1 || requested->id > 255)) {
+		talloc_free(requested);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid profile id");
+	}
+
+	profile_log(modem, "processing user request to set 3GPP profile...", requested);
+
+	rq = req_new(pm, ctx, req);
+	if (!rq) {
+		talloc_free(requested);
+		return UBUS_STATUS_NO_MEMORY;
+	}
+
+	s = talloc_zero(rq, struct pm_set);
+	s->pm = pm;
+	s->rq = rq;
+	s->requested = talloc_steal(s, requested);
+	s->profile_id = requested->id;
+	s->step = SET_FIRST;
+
+	/* normalize IP family right away (mm_3gpp_normalize_ip_family(from_user = TRUE)) */
+	if (requested->ip_type == IPF_NONE || requested->ip_type == IPF_ANY)
+		requested->ip_type = IPF_IPV4;
+
+	/* Start ignoring our own indications */
+	pm_update_ignore_start(pm);
+
+	set_step(s);
+
+	return UBUS_STATUS_OK;
+}
+
+/* --- delete (modem_3gpp_profile_manager_delete_profile()) --- */
+
+struct pm_delete {
+	struct modem_pm *pm;
+	struct pm_req *rq;
+	int profile_id;
+};
+
+static void delete_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct pm_delete *d = req->cb_data;
+	struct modem_pm *pm = d->pm;
+	struct pm_req *rq = d->rq;
+	struct qmi_wds_delete_profile_response res = {};
+	char err[200], full[260];
+
+	if (!msg || req->ret || qmi_parse_wds_delete_profile_response(msg, &res)) {
+		pm_qmi_err(err, sizeof(err), "", msg, req);
+		snprintf(full, sizeof(full), "Couldn't delete profile: %s", err);
+		modem_log(pm->modem, LOGL_NOTICE, "failed deleting 3GPP profile: %s", full);
+		/* process profile manager updates right away on error */
+		pm_update_ignore_stop(pm);
+		req_done(rq, pm_qmi_err_code(req), full, NULL);
+		return;
+	}
+
+	modem_log(pm->modem, LOGL_INFO, "3GPP profile deleted");
+	/* delay processing profile manager updates on success */
+	pm_update_ignore_stop_delayed(pm);
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "state", modem_state_name(pm->modem->mm_state));
+	blobmsg_add_string(&b, "power_state", modem_power_state_name(pm->modem->power_state));
+	req_done(rq, MODEM_ERR_NONE, NULL, b.head);
+}
+
+enum { PD_PROFILE_ID, __PD_MAX };
+static const struct blobmsg_policy profile_delete_policy[__PD_MAX] = {
+	[PD_PROFILE_ID] = { .name = "profile_id", .type = BLOBMSG_TYPE_INT32 },
+};
+
+/** ubus call uqmid.modem.0 profile_delete '{"profile_id":3}' */
+static int h_profile_delete(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			    const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_pm *pm = pm_of(modem);
+	struct qmi_service *wds;
+	struct qmi_wds_delete_profile_request dr = {};
+	struct blob_attr *tb[__PD_MAX];
+	struct pm_delete *d;
+	struct pm_req *rq;
+	char text[100];
+	int id, ret = pm_gate(ctx, req, modem);
+
+	if (ret >= 0)
+		return ret;
+
+	blobmsg_parse(profile_delete_policy, __PD_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[PD_PROFILE_ID])
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Missing index field ('profile-id') in profile settings");
+	id = (int32_t)blobmsg_get_u32(tb[PD_PROFILE_ID]);
+	if (id == PROFILE_ID_UNKNOWN)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Missing index field ('profile-id') in profile settings");
+	if (id < 1 || id > 255)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid profile id");
+
+	if (!fail_if_connected_bearer(pm, id, text, sizeof(text)))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, text);
+
+	wds = pm_wds(pm);
+	if (!wds)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "Couldn't find client for service 'wds'");
+
+	modem_log(modem, LOGL_INFO, "processing user request to delete 3GPP profile %d...", id);
+	rq = req_new(pm, ctx, req);
+	if (!rq)
+		return UBUS_STATUS_NO_MEMORY;
+	d = talloc_zero(rq, struct pm_delete);
+	d->pm = pm;
+	d->rq = rq;
+	d->profile_id = id;
+
+	/* Start ignoring our own indications */
+	pm_update_ignore_start(pm);
+
+	modem_log(modem, LOGL_DEBUG, "deleting profile '%d'", id);
+	dr.set.profile_identifier = 1;
+	dr.data.profile_identifier.profile_type = QMI_WDS_PROFILE_TYPE_3GPP;
+	dr.data.profile_identifier.profile_index = id;
+	if (SEND_REQ(wds, qmi_set_wds_delete_profile_request(_m, &dr), delete_cb, d, STORE_TIMEOUT_MS)) {
+		pm_update_ignore_stop(pm);
+		req_done(rq, MODEM_ERR_FAILED, "Couldn't delete profile: couldn't send the request", NULL);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method pm_methods[] = {
+	UBUS_METHOD_NOARG("profile_list", h_profile_list),
+	UBUS_METHOD("profile_set", h_profile_set, profile_set_policy),
+	UBUS_METHOD("profile_delete", h_profile_delete, profile_delete_policy),
+};
+
+const struct ubus_method *uqmid_profile_manager_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(pm_methods);
+	return pm_methods;
+}

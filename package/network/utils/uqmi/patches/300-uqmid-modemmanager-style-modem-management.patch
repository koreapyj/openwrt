+int uqmid_parse_ip_type(const char *name)
+{
+	int pdp;
+
+	if (!strcmp(name, "any") || !*name)
+		return IP_TYPE_ANY;
+	/* ppp is not an IP type */
+	if (!wds_name_to_val(wds_pdp_type_names, wds_pdp_type_names_n, name, false, &pdp) || pdp == QMI_WDS_PDP_TYPE_PPP)
+		return -1;
+
+	switch (pdp) {
+	case QMI_WDS_PDP_TYPE_IPV4: return IP_TYPE_IPV4;
+	case QMI_WDS_PDP_TYPE_IPV6: return IP_TYPE_IPV6;
+	default: return IP_TYPE_IPV4V6;
+	}
+}
+
+const char *uqmid_ip_type_name(int ip_type)
+{
+	switch (ip_type) {
+	case IP_TYPE_IPV4: return "ipv4";
+	case IP_TYPE_IPV6: return "ipv6";
+	case IP_TYPE_IPV4V6: return "ipv4v6";
+	default: return "any";
+	}
+}
+
+/* MM: mm_bearer_ip_family_to_qmi_pdp_type() */
+int uqmid_ip_type_to_pdp_type(int ip_type)
+{
+	switch (ip_type) {
+	case IP_TYPE_IPV4: return QMI_WDS_PDP_TYPE_IPV4;
+	case IP_TYPE_IPV6: return QMI_WDS_PDP_TYPE_IPV6;
+	case IP_TYPE_IPV4V6: return QMI_WDS_PDP_TYPE_IPV4_OR_IPV6;
+	default: return -1;
+	}
+}

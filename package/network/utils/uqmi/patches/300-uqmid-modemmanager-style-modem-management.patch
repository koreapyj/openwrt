+/*****************************************************************************/
+/* operator name and code (MM: mm_iface_modem_3gpp_reload_current_registration_info()) */
+
+/* QMI network description encodings -> UTF-8 (MM: qmi_nas_read_string_from_network_description_encoded_array()) */
+static void decode_plmn_string(uint8_t encoding, const uint8_t *data, unsigned int n, char *out, size_t out_len)
+{
+	size_t pos = 0;
+	unsigned int i;
+
+	out[0] = 0;
+	if (!data || !n || out_len < 8)
+		return;
+
+	switch (encoding) {
+	case QMI_NAS_NETWORK_DESCRIPTION_ENCODING_UNICODE:
+		/* UCS-2 little endian */
+		for (i = 0; i + 1 < n && pos + 4 < out_len; i += 2) {
+			uint16_t cp = data[i] | (data[i + 1] << 8);
+
+			if (cp < 0x80) {
+				out[pos++] = cp;
+			} else if (cp < 0x800) {
+				out[pos++] = 0xc0 | (cp >> 6);
+				out[pos++] = 0x80 | (cp & 0x3f);
+			} else {
+				out[pos++] = 0xe0 | (cp >> 12);
+				out[pos++] = 0x80 | ((cp >> 6) & 0x3f);
+				out[pos++] = 0x80 | (cp & 0x3f);
+			}
+		}
+		break;
+	case QMI_NAS_NETWORK_DESCRIPTION_ENCODING_GSM: {
+		/* GSM 7 bit packed, only the part which is the same in ASCII is converted */
+		unsigned int septets = n * 8 / 7;
+
+		for (i = 0; i < septets && pos + 2 < out_len; i++) {
+			unsigned int bit = i * 7, byte = bit / 8, shift = bit % 8;
+			unsigned int v = data[byte] >> shift;
+			uint8_t c;
+
+			if (shift > 1 && byte + 1 < n)
+				v |= data[byte + 1] << (8 - shift);
+			c = v & 0x7f;
+			if (c == 0x00)
+				c = '@';
+			else if (c == 0x02)
+				c = '$';
+			else if (c < 0x20 || c >= 0x7f)
+				c = '?';
+			out[pos++] = c;
+		}
+		break;
+	}
+	default:
+		/* unspecified or ASCII-7 */
+		for (i = 0; i < n && pos + 2 < out_len; i++)
+			out[pos++] = data[i] >= 0x20 && data[i] < 0x7f ? data[i] : '?';
+		break;
+	}
+	out[pos] = 0;
+	/* trailing padding */
+	while (pos && (out[pos - 1] == ' ' || out[pos - 1] == '@'))
+		out[--pos] = 0;
+}
+
+struct reload_ctx {
+	struct modem_3gpp *m;
+	void (*done)(struct modem_3gpp *m, void *data);
+	void *data;
+};
+
+static void reload_finish(struct reload_ctx *rc)
+{
+	struct modem_3gpp *m = rc->m;
+	void (*done)(struct modem_3gpp *m, void *data) = rc->done;
+	void *data = rc->data;
+
+	talloc_free(rc);
+	if (done)
+		done(m, data);
+}
+
+static void get_plmn_name_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct reload_ctx *rc = req->cb_data;
+	struct modem_3gpp *m = rc->m;
+	struct qmi_nas_get_plmn_name_response res = {};
+	char name[96];
+
+	if (msg && !req->ret && !qmi_parse_nas_get_plmn_name_response(msg, &res) && res.set._3gpp_eons_plmn_name) {
+		const typeof(res.data._3gpp_eons_plmn_name) *e = &res.data._3gpp_eons_plmn_name;
+
+		/* MM: long name, then short name, then the service provider name */
+		decode_plmn_string(e->long_name_encoding, e->long_name, e->long_name_n, name, sizeof(name));
+		if (!name[0])
+			decode_plmn_string(e->short_name_encoding, e->short_name, e->short_name_n, name, sizeof(name));
+		if (!name[0])
+			decode_plmn_string(e->service_provider_name_encoding, e->service_provider_name,
+					   e->service_provider_name_n, name, sizeof(name));
+		if (name[0]) {
+			m3_set_str(m->modem, &m->op_desc, name);
+			m3_set_str(m->modem, &m->operator_name, name);
+		}
+	} else {
+		modem_log(m->modem, LOGL_DEBUG, "couldn't load the operator name: %d/%s", req->ret,
+			  qmi_get_error_str(req->ret));
+	}
+
+	reload_finish(rc);
+}
+
+/*
+ * The operator code is the cached id of the network (system info / serving system). The name is the description of
+ * the serving system or, if the modem didn't tell, the one of Get PLMN Name.
+ */
+static void m3_reload_registration_info(struct modem_3gpp *m, void (*done)(struct modem_3gpp *m, void *data),
+					void *data)
+{
+	struct reload_ctx *rc = talloc_zero(m, struct reload_ctx);
+	struct qmi_nas_get_plmn_name_request pr = {};
+	unsigned int mcc, mnc;
+	size_t len;
+	int ret;
+
+	rc->m = m;
+	rc->done = done;
+	rc->data = data;
+
+	m3_set_str(m->modem, &m->operator_code, m->op_id);
+	if (m->op_desc) {
+		m3_set_str(m->modem, &m->operator_name, m->op_desc);
+		reload_finish(rc);
+		return;
+	}
+
+	if (!m->op_id || !m->nas || (len = strlen(m->op_id)) < 5 || len > 6 ||
+	    sscanf(m->op_id, "%3u%3u", &mcc, &mnc) < 2) {
+		TALLOC_FREE(m->operator_name);
+		reload_finish(rc);
+		return;
+	}
+
+	/* "%3u%3u" of a 5 digit id reads the 2 digit mnc as is */
+	if (len == 5)
+		mnc = (m->op_id[3] - '0') * 10 + (m->op_id[4] - '0');
+	pr.set.plmn = 1;
+	pr.data.plmn.mcc = mcc;
+	pr.data.plmn.mnc = mnc;
+	if (len == 6 && mnc < 100)
+		qmi_set(&pr, mnc_pcs_digit_include_status, true);
+
+	ret = SEND_REQ(m->nas, qmi_set_nas_get_plmn_name_request(_m, &pr), get_plmn_name_cb, rc, 5000);
+	if (ret) {
+		TALLOC_FREE(m->operator_name);
+		reload_finish(rc);
+	}
+}

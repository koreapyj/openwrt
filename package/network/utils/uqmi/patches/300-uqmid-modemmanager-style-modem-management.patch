+	bool enabled;
+	bool dying;
+	/* newest first like the call list of MM */
+	struct list_head calls;
+	struct list_head ops;
+	unsigned int n_calls;
+};
+
+/*****************************************************************************/
+/* helpers */
+
+static struct modem_voice *mv(struct modem *modem)
+{
+	return modem->voice;
+}
+
+#define SEND_REQ(svc, ENC, cb, data, tmo) ({							\
+	struct qmi_msg *_m;									\
+	struct qmi_request *_r = uqmi_request_alloc((svc), &_m, (cb), (data), (tmo));		\
+	int _ret = -ENOMEM;									\
+	if (_r) {										\
+		if (ENC) {									\
+			talloc_free(_r);							\
+			_ret = -EINVAL;								\
+		} else {									\
+			_ret = uqmi_service_send_msg((svc), _r);				\
+		}										\
+	}											\
+	_ret;											\
+})
+
+static void modem_notify(struct modem *modem, const char *name, struct blob_buf *nb)
+{
+	if (modem->ubus.id)
+		ubus_notify(ubus_ctx, &modem->ubus, name, nb->head, -1);
+}
+
+static const char *req_error_str(const struct qmi_request *req)
+{
+	if (req->ret == UQMID_ERROR_TIMEOUT)
+		return "timed out";
+	if (req->ret == QMI_ERROR_CANCELLED)
+		return "cancelled";
+
+	return qmi_get_error_str(req->ret);
+}
+
+static enum modem_error req_error(const struct qmi_request *req)
+{
+	if (req->ret == UQMID_ERROR_TIMEOUT)
+		return MODEM_ERR_TIMEOUT;
+	if (req->ret == QMI_ERROR_CANCELLED)
+		return MODEM_ERR_ABORTED;
+
+	return MODEM_ERR_FAILED;
+}
+
+/* the voice client, NULL if the modem is not enabled (or voice is not supported) */
+static struct qmi_service *voice_client(struct modem_voice *v)
+{
+	if (v->dying || !v->enabled || !v->svc || !uqmi_service_valid(v->modem->qmi, v->svc))
+		return NULL;
+
+	return v->svc;
+}
+
+static struct call *call_find(struct modem_voice *v, uint32_t index)
+{
+	struct call *c;
+
+	list_for_each_entry(c, &v->calls, list) {
+		if (c->index == index)
+			return c;
+	}
+
+	return NULL;
+}
+
+static struct call *call_find_by_path(struct modem_voice *v, const char *path)
+{
+	struct call *c;
+
+	list_for_each_entry(c, &v->calls, list) {
+		if (!strcmp(c->ubus.name, path))
+			return c;
+	}
+
+	return NULL;
+}
+
+static struct call *call_find_by_qmi_id(struct modem_voice *v, uint8_t id)
+{
+	struct call *c;
+
+	if (!id)
+		return NULL;
+
+	list_for_each_entry(c, &v->calls, list) {
+		if (c->qmi_id == id)
+			return c;
+	}
+
+	return NULL;
+}
+
+/*****************************************************************************/
+/* request contexts */
+
+static struct vop *vop_new(struct modem_voice *v, struct ubus_context *ctx, struct ubus_request_data *req,
+			   enum vop_kind kind, uint32_t call_id)
+{
+	struct vop *op = talloc_zero(v, struct vop);
+
+	if (!op)
+		return NULL;
+
+	op->v = v;
+	op->kind = kind;
+	op->call_id = call_id;
+	list_add_tail(&op->list, &v->ops);
+	ubus_defer_request(ctx, req, &op->req);
+
+	return op;
+}
+
+static void vop_done(struct vop *op, enum modem_error err, const char *msg, struct blob_attr *reply)
+{
+	struct call *c;
+
+	if (op->kind == VOP_DTMF) {
+		c = call_find(op->v, op->call_id);
+		if (c)
+			c->dtmf_busy = false;
+	}
+
+	uloop_timeout_cancel(&op->timer);
+	list_del(&op->list);
+	uqmid_ubus_deferred_done(&op->req, err, msg, reply);
+	talloc_free(op);
+}
+
+static void vop_fail_req(struct vop *op, const struct qmi_request *req, const char *what)
+{
+	char msg[160];
+
+	snprintf(msg, sizeof(msg), "%s: QMI operation failed: %s", what, req_error_str(req));
+	vop_done(op, req_error(req), msg, NULL);
+}
+
+/*****************************************************************************/
+/* call objects (MM: MMBaseCall) */
+
+static void call_notify(struct call *c, const char *name, struct blob_buf *nb)
+{
+	if (c->ubus.id)
+		ubus_notify(ubus_ctx, &c->ubus, name, nb->head, -1);
+}
+
+/* uqmid extension: end_reason {value, name} of the call, if known */
+static void call_add_end_reason(struct call *c, struct blob_buf *bb)
+{
+	void *t;
+
+	if (c->has_end_reason) {
+		t = blobmsg_open_table(bb, "end_reason");
+		blobmsg_add_u32(bb, "value", c->end_reason);
+		blobmsg_add_string(bb, "name", voice_call_end_reason_name(c->end_reason));
+		blobmsg_close_table(bb, t);
+	}
+
+	/* cc_cause: the TS 24.008 Annex H cause value, only if the modem sent it */
+	if (c->has_cc_cause)
+		blobmsg_add_u32(bb, "cc_cause", c->cc_cause);
+}
+
+static void call_set_cc_cause(struct call *c, uint8_t cause)
+{
+	if (c->state == CALL_STATE_TERMINATED)
+		return;
+
+	c->has_cc_cause = true;
+	c->cc_cause = cause;
+}
+
+static void call_set_end_reason(struct call *c, uint16_t reason)
+{
+	if (c->state == CALL_STATE_TERMINATED)
+		return;
+
+	c->has_end_reason = true;
+	c->end_reason = reason;
+}
+
+/* mm_base_call_change_state() */
+static void call_change_state(struct call *c, enum call_state new, enum call_reason reason)
+{
+	struct modem *modem = c->v->modem;
+	enum call_state old = c->state;
+	struct blob_buf nb = {};
+
+	if (old == new)
+		return;
+
+	modem_log(modem, LOGL_INFO, "call %s state changed: %s -> %s (%s)", c->ubus.name ? c->ubus.name : "?",
+		  call_state_name(old), call_state_name(new), call_reason_name(reason));
+
+	/* uqmid extension: a call which the user ended (these reasons only come from requests of the user) has no
+	 * end reason from the network yet: it is client-end */
+	if (new == CALL_STATE_TERMINATED && !c->has_end_reason &&
+	    (reason == CALL_REASON_TERMINATED || reason == CALL_REASON_TRANSFERRED || reason == CALL_REASON_DEFLECTED))
+		call_set_end_reason(c, QMI_CALL_END_REASON_CLIENT_END);
+
+	/* reset index */
+	if (new == CALL_STATE_TERMINATED)
+		c->qmi_id = 0;
+
+	c->state = new;
+	c->reason = reason;
+
+	if (!c->ubus.id)
+		return;
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "old", call_state_name(old));
+	blobmsg_add_string(&nb, "new", call_state_name(new));
+	blobmsg_add_string(&nb, "reason", call_reason_name(reason));
+	if (new == CALL_STATE_TERMINATED)
+		call_add_end_reason(c, &nb);
+	call_notify(c, "state_changed", &nb);
+	blob_buf_free(&nb);
+
+	/* the same on the modem object for a single subscription (uqmid addition) */
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", c->ubus.name);
+	blobmsg_add_string(&nb, "old", call_state_name(old));
+	blobmsg_add_string(&nb, "new", call_state_name(new));
+	blobmsg_add_string(&nb, "reason", call_reason_name(reason));
+	if (new == CALL_STATE_TERMINATED)
+		call_add_end_reason(c, &nb);
+	modem_notify(modem, "voice.call_state_changed", &nb);
+	blob_buf_free(&nb);
+}
+
+static void call_add_properties(struct call *c, struct blob_buf *bb)
+{
+	void *t;
+
+	blobmsg_add_string(bb, "path", c->ubus.name);
+	blobmsg_add_string(bb, "state", call_state_name(c->state));
+	blobmsg_add_string(bb, "state_reason", call_reason_name(c->reason));
+	blobmsg_add_string(bb, "direction", call_direction_name(c->direction));
+	blobmsg_add_string(bb, "number", c->number ? c->number : "");
+	blobmsg_add_u8(bb, "multiparty", c->multiparty);
+	/* uqmid addition: the call id of the QMI VOICE service (0 if the call has none yet), the id the
+	 * `uqmi --voice-*` commands use; `uqmi --uqmid` maps it to the call object with this */
+	blobmsg_add_u32(bb, "qmi_call_id", c->qmi_id);
+	call_add_end_reason(c, bb);
+	/* no in-call audio setup: the audio of a call is not handled by uqmid */
+	blobmsg_add_string(bb, "audio_port", "");
+	t = blobmsg_open_table(bb, "audio_format");
+	blobmsg_close_table(bb, t);
+}
+
+static int call_get(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		    const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+
+	blob_buf_init(&b, 0);
+	call_add_properties(c, &b);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+static void call_set_number(struct call *c, const char *number)
+{
+	TALLOC_FREE(c->number);
+	if (number && *number)
+		c->number = talloc_strdup(c, number);
+}
+
+static struct ubus_object_type call_object_type;
+
+/* the call is not part of the list and not exported yet */
+static struct call *call_new(struct modem_voice *v, enum call_direction direction, const char *number)
+{
+	struct call *c = talloc_zero(v, struct call);
+
+	if (!c)
+		return NULL;
+
+	c->v = v;
+	c->index = next_call_index++;
+	c->direction = direction;
+	call_set_number(c, number);
+
+	return c;
+}
+
+/* mm_base_call_export() + mm_call_list_add_call() + the CallAdded signal */
+static int call_export(struct call *c)
+{
+	struct modem_voice *v = c->v;
+	struct modem *modem = v->modem;
+	struct blob_buf nb = {};
+	int ret;
+
+	c->ubus.name = talloc_asprintf(c, "%s.call.%u", modem->ubus.name, c->index);
+	c->ubus.type = &call_object_type;
+	c->ubus.methods = call_object_type.methods;
+	c->ubus.n_methods = call_object_type.n_methods;
+	ret = ubus_add_object(ubus_ctx, &c->ubus);
+	if (ret) {
+		LOG_ERROR("failed to publish ubus object '%s' (ret = %d).\n", c->ubus.name, ret);
+		return ret;
+	}
+
+	list_add(&c->list, &v->calls);
+	v->n_calls++;
+	modem_log(modem, LOGL_INFO, "added call %s (%s, number '%s')", c->ubus.name,
+		  call_direction_name(c->direction), c->number ? c->number : "");
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", c->ubus.name);
+	modem_notify(modem, "voice.call_added", &nb);
+	blob_buf_free(&nb);
+
+	return 0;
+}
+
+/* mm_call_list_delete_call() + the CallDeleted signal. The caller has hung the call up already if needed. */
+static void call_delete(struct call *c)
+{
+	struct modem_voice *v = c->v;
+	struct modem *modem = v->modem;
+	struct blob_buf nb = {};
+
+	if (c->ubus.id)
+		ubus_remove_object(ubus_ctx, &c->ubus);
+
+	list_del(&c->list);
+	v->n_calls--;
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "path", c->ubus.name);
+	modem_notify(modem, "voice.call_deleted", &nb);
+	blob_buf_free(&nb);
+
+	talloc_free(c);
+}
+
+/*****************************************************************************/
+/* mm_iface_modem_voice_authorize_outgoing_call() */
+
+static bool outgoing_allowed(struct modem *modem, const char *number)
+{
+	static const char *const always_valid_emergency_numbers[] = { "112", "911" };
+	static const char *const no_sim_valid_emergency_numbers[] = { "000", "08", "110", "999", "118", "119" };
+	unsigned int i;
+
+	/* If the modem is REGISTERED, we allow any kind of call, otherwise only emergency calls */
+	if (modem->mm_state >= MODEM_STATE_REGISTERED) {
+		modem_log(modem, LOGL_DEBUG, "voice call to %s allowed", number);
+		return true;
+	}
+
+	/* Identification of emergency numbers. 3GPP TS 22.101 */
+	for (i = 0; i < ARRAY_SIZE(always_valid_emergency_numbers); i++) {
+		if (!strcmp(number, always_valid_emergency_numbers[i])) {
+			modem_log(modem, LOGL_DEBUG, "voice call to %s allowed: emergency call number always valid",
+				  number);
+			return true;
+		}
+	}
+
+	if (!modem->sim.present) {
+		for (i = 0; i < ARRAY_SIZE(no_sim_valid_emergency_numbers); i++) {
+			if (!strcmp(number, no_sim_valid_emergency_numbers[i])) {
+				modem_log(modem, LOGL_DEBUG,
+					  "voice call to %s allowed: emergency call number valid when no SIM", number);
+				return true;
+			}
+		}
+	}
+
+	modem_log(modem, LOGL_DEBUG, "voice call to %s NOT allowed: not a valid emergency call number", number);
+	return false;
+}
+
+/*****************************************************************************/
+/* reported call state (mm_iface_modem_voice_report_all_calls()) */
+
+struct call_info {
+	uint8_t index;
+	char *number;
+	enum call_state state;
+	enum call_direction direction;
+	/* uqmid extension: the Call End Reason of the QMI indication */
+	bool has_end_reason;
+	uint16_t end_reason;
+	bool has_cc_cause;
+	uint8_t cc_cause;
+};
+
+/* match_single_call_info() */
+static bool match_single_call_info(struct modem_voice *v, struct call_info *info, struct call *c)
+{
+	struct modem *modem = v->modem;
+	enum call_state state = c->state;
+	enum call_direction direction = c->direction;
+	uint8_t idx = c->qmi_id;
+	bool match_direction_and_state = false;
+	bool match_number = false;
+	bool match_index = false;
+	bool match_terminated = false;
+
+	/* Match index */
+	if (info->index && info->index == idx)
+		match_index = true;
+
+	/* Match direction and state. We cannot apply this match if both call info and call have an index set and
+	 * they're different already. */
+	if (info->direction == direction && info->state == state && (!info->index || !idx || match_index))
+		match_direction_and_state = true;
+
+	/* Match number */
+	if (info->number && c->number && !strcmp(info->number, c->number))
+		match_number = true;
+
+	/* Match special terminated event (not possible with the full report of QMI: kept for completeness) */
+	if (info->state == CALL_STATE_TERMINATED && info->direction == CALL_DIR_UNKNOWN && !info->index &&
+	    !info->number && !c->multiparty)
+		match_terminated = true;
+
+	/* If no clear match, nothing to do */
+	if (!match_direction_and_state && !match_number && !match_index && !match_terminated)
+		return false;
+
+	modem_log(modem, LOGL_DEBUG,
+		  "call info matched (direction/state %s, number %s, index %s, terminated %s) with call %s",
+		  match_direction_and_state ? "yes" : "no", match_number ? "yes" : "no", match_index ? "yes" : "no",
+		  match_terminated ? "yes" : "no", c->ubus.name);
+
+	/* number of a known call which does not have one yet */
+	if (info->number && !c->number) {
+		modem_log(modem, LOGL_DEBUG, "  number set: %s", info->number);
+		call_set_number(c, info->number);
+	}
+
+	/* a known incoming/outgoing call which does not have a known call index yet */
+	if (info->index && !idx) {
+		modem_log(modem, LOGL_DEBUG, "  index set: %u", info->index);
+		c->qmi_id = info->index;
+	}
+
+	/* uqmid extension */
+	if (info->has_end_reason)
+		call_set_end_reason(c, info->end_reason);
+	if (info->has_cc_cause)
+		call_set_cc_cause(c, info->cc_cause);
+
+	/* Update state if it changed */
+	if (info->state != state) {
+		modem_log(modem, LOGL_DEBUG, "  state updated: %s", call_state_name(info->state));
+		call_change_state(c, info->state, CALL_REASON_UNKNOWN);
+	}
+
+	/* MM refreshes the incoming timeout here, the QMI calls skip it (MM_BASE_CALL_SKIP_INCOMING_TIMEOUT) */
+	return true;
+}
+
+static void create_incoming_call(struct modem_voice *v, const struct call_info *info)
+{
+	struct modem *modem = v->modem;
+	struct call *c;
+
+	if (v->n_calls >= MAX_CALLS) {
+		modem_log(modem, LOGL_NOTICE, "too many calls, ignoring the incoming call");
+		return;
+	}
+
+	modem_log(modem, LOGL_DEBUG, "creating new incoming call...");
+	c = call_new(v, CALL_DIR_INCOMING, info->number);
+	if (!c)
+		return;
+
+	/* the state is set before the object is exported: no signals */
+	c->state = info->state;
+	c->reason = CALL_REASON_INCOMING_NEW;
+	c->qmi_id = info->index;
+
+	if (call_export(c))
+		talloc_free(c);
+}
+
+static void report_all_calls(struct modem_voice *v, struct call_info *infos, unsigned int n)
+{
+	struct modem *modem = v->modem;
+	struct call *c, *tmp;
+	bool *used;
+	unsigned int i;
+
+	modem_log(modem, LOGL_DEBUG, "reported %u ongoing calls", n);
+	for (i = 0; i < n; i++)
+		modem_log(modem, LOGL_DEBUG, "call at index %u: direction %s, state %s, number %s", infos[i].index,
+			  call_direction_name(infos[i].direction), call_state_name(infos[i].state),
+			  infos[i].number ? infos[i].number : "n/a");
+
+	used = talloc_zero_array(v, bool, n ? n : 1);
+	if (!used)
+		return;
+
+	/* Iterate over all the calls already known to us. Whenever a known call is updated, its info is used up. */
+	list_for_each_entry_safe(c, tmp, &v->calls, list) {
+		bool found = false;
+
+		/* fully ignore already terminated calls */
+		if (c->state == CALL_STATE_TERMINATED)
+			continue;
+
+		for (i = 0; i < n && !found; i++) {
+			if (used[i])
+				continue;
+
+			if (match_single_call_info(v, &infos[i], c)) {
+				used[i] = true;
+				found = true;
+			}
+		}
+
+		if (found)
+			continue;
+
+		/* not found in list: this call is now terminated */
+		modem_log(modem, LOGL_DEBUG,
+			  "call %s with direction %s, state %s, number '%s', index %u not found in list, terminating",
+			  c->ubus.name, call_direction_name(c->direction), call_state_name(c->state),
+			  c->number ? c->number : "", c->qmi_id);
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+	}
+
+	/* What is left are the calls unknown to us. We only expect new incoming calls. */
+	for (i = 0; i < n; i++) {
+		struct call_info *info = &infos[i];
+
+		if (used[i])
+			continue;
+
+		/* Ignore unknown terminated calls, they may be due to an already processed event */
+		if (info->state == CALL_STATE_TERMINATED)
+			continue;
+
+		if (info->direction == CALL_DIR_OUTGOING) {
+			modem_log(modem, LOGL_NOTICE,
+				  "unexpected outgoing call to number '%s' reported in call list: state %s",
+				  info->number ? info->number : "n/a", call_state_name(info->state));
+			continue;
+		}
+
+		if (info->direction == CALL_DIR_INCOMING) {
+			/* We only expect either RINGING-IN or WAITING states */
+			if (info->state != CALL_STATE_RINGING_IN && info->state != CALL_STATE_WAITING) {
+				modem_log(modem, LOGL_NOTICE,
+					  "unexpected incoming call to number '%s' reported in call list: state %s",
+					  info->number ? info->number : "n/a", call_state_name(info->state));
+				continue;
+			}
+
+			create_incoming_call(v, info);
+			continue;
+		}
+
+		modem_log(modem, LOGL_NOTICE,
+			  "unexpected call to number '%s' reported in call list: state %s, direction unknown",
+			  info->number ? info->number : "n/a", call_state_name(info->state));
+	}
+
+	talloc_free(used);
+}
+
+static enum call_state qmi_to_call_state(uint8_t state)
+{
+	switch (state) {
+	case QMI_CALL_STATE_ORIGINATION:
+	case QMI_CALL_STATE_CC_IN_PROGRESS:
+		return CALL_STATE_DIALING;
+	case QMI_CALL_STATE_ALERTING:
+		return CALL_STATE_RINGING_OUT;
+	case QMI_CALL_STATE_SETUP:
+	case QMI_CALL_STATE_INCOMING:
+		return CALL_STATE_RINGING_IN;
+	case QMI_CALL_STATE_CONVERSATION:
+		return CALL_STATE_ACTIVE;
+	case QMI_CALL_STATE_HOLD:
+		return CALL_STATE_HELD;
+	case QMI_CALL_STATE_WAITING:
+		return CALL_STATE_WAITING;
+	case QMI_CALL_STATE_DISCONNECTING:
+	case QMI_CALL_STATE_END:
+		return CALL_STATE_TERMINATED;
+	case QMI_CALL_STATE_UNKNOWN:
+	default:
+		return CALL_STATE_UNKNOWN;
+	}
+}
+
+static enum call_direction qmi_to_call_direction(uint8_t direction)
+{
+	switch (direction) {
+	case QMI_CALL_DIRECTION_MO:
+		return CALL_DIR_OUTGOING;
+	case QMI_CALL_DIRECTION_MT:
+		return CALL_DIR_INCOMING;
+	default:
+		return CALL_DIR_UNKNOWN;
+	}
+}
+
+/* the call information of the (indication of the) All Call Status, the numbers are looked up by call id */
+static void report_qmi_calls(struct modem_voice *v, const struct voice_call_info *calls, unsigned int n_calls,
+			     const struct voice_call_number *numbers, unsigned int n_numbers,
+			     const struct voice_call_end *ends, unsigned int n_ends,
+			     const struct voice_call_cause *causes, unsigned int n_causes)
+{
+	struct call_info *infos;
+	unsigned int i, j, n = 0;
+
+	infos = talloc_zero_array(v, struct call_info, n_calls ? n_calls : 1);
+	if (!infos)
+		return;
+
+	for (i = 0; i < n_calls; i++) {
+		struct call_info *info = &infos[n];
+
+		/* When reporting the full list of calls, index and state are mandatory */
+		info->state = qmi_to_call_state(calls[i].state);
+		if (!calls[i].id || info->state == CALL_STATE_UNKNOWN)
+			continue;
+
+		info->index = calls[i].id;
+		info->direction = qmi_to_call_direction(calls[i].direction);
+		for (j = 0; j < n_numbers; j++) {
+			if (numbers[j].id == calls[i].id) {
+				if (numbers[j].number && numbers[j].number[0])
+					info->number = talloc_strdup(infos, numbers[j].number);
+				break;
+			}
+		}
+		for (j = 0; j < n_ends; j++) {
+			if (ends[j].id == calls[i].id) {
+				info->has_end_reason = true;
+				info->end_reason = ends[j].reason;
+				break;
+			}
+		}
+		for (j = 0; j < n_causes; j++) {
+			if (causes[j].id == calls[i].id) {
+				info->has_cc_cause = true;
+				info->cc_cause = causes[j].cause;
+				break;
+			}
+		}
+		n++;
+	}
+
+	/* uqmid extension: the end reasons of the calls which the call information does not list (the reason is
+	 * used when the call is terminated, also by a later report which does not have the call any more) */
+	for (j = 0; j < n_ends; j++) {
+		struct call *c = call_find_by_qmi_id(v, ends[j].id);
+
+		if (c)
+			call_set_end_reason(c, ends[j].reason);
+	}
+	for (j = 0; j < n_causes; j++) {
+		struct call *c = call_find_by_qmi_id(v, causes[j].id);
+
+		if (c)
+			call_set_cc_cause(c, causes[j].cause);
+	}
+
+	report_all_calls(v, infos, n);
+	talloc_free(infos);
+}
+
+/*****************************************************************************/
+/* indications */
+
+/* all_call_status_indication_cb() */
+static void all_call_status_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_voice *v = data;
+	struct voice_all_calls ind;
+
+	if (v->dying)
+		return;
+
+	if (!voice_parse_all_call_status(msg, &ind)) {
+		modem_log(v->modem, LOGL_DEBUG, "Ignoring All Call Status indication: call information not available");
+		return;
+	}
+
+	report_qmi_calls(v, ind.calls, ind.n_calls, ind.numbers, ind.n_numbers, ind.ends, ind.n_ends,
+		       ind.causes, ind.n_causes);
+}
+
+/* supplementary_service_indication_cb() */
+static void supplementary_service_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_voice *v = data;
+	struct qmi_voice_supplementary_service_indication res;
+	struct call *c;
+
+	if (v->dying)
+		return;
+
+	qmi_parse_voice_supplementary_service_indication(msg, &res);
+	if (!res.set.info) {
+		modem_log(v->modem, LOGL_DEBUG,
+			  "Ignoring supplementary service indication: no call id or notification type given");
+		return;
+	}
+
+	c = call_find_by_qmi_id(v, res.data.info.call_id);
+	if (!c) {
+		modem_log(v->modem, LOGL_DEBUG, "Ignoring supplementary service indication: no matching call exists");
+		return;
+	}
+
+	switch (res.data.info.notification_type) {
+	case QMI_SUPS_NOTIFY_CALL_IS_ON_HOLD:
+		call_change_state(c, CALL_STATE_HELD, CALL_REASON_UNKNOWN);
+		break;
+	case QMI_SUPS_NOTIFY_CALL_IS_RETRIEVED:
+		call_change_state(c, CALL_STATE_ACTIVE, CALL_REASON_UNKNOWN);
+		break;
+	case QMI_SUPS_NOTIFY_OUTGOING_CALL_IS_WAITING:
+		call_change_state(c, CALL_STATE_WAITING, CALL_REASON_REFUSED_OR_BUSY);
+		break;
+	default:
+		modem_log(v->modem, LOGL_DEBUG,
+			  "Ignoring supplementary service indication: unhandled notification type");
+		break;
+	}
+}
+
+/*****************************************************************************/
+/* call methods (MM: handle_start() ... handle_send_dtmf()) */
+
+static void start_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+	struct call *c = call_find(op->v, op->call_id);
+	struct qmi_voice_dial_call_response res = {};
+
+	if (!msg || req->ret) {
+		modem_log(op->v->modem, LOGL_INFO, "couldn't start call: %s", req_error_str(req));
+		/* Convert errors into call state updates */
+		if (c)
+			call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+		vop_fail_req(op, req, "Couldn't create call");
+		return;
+	}
+
+	qmi_parse_voice_dial_call_response(msg, &res);
+	if (!res.set.call_id || !res.data.call_id) {
+		if (c)
+			call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+		vop_done(op, MODEM_ERR_INVALID_ARGS, "Invalid call index", NULL);
+		return;
+	}
+
+	modem_log(op->v->modem, LOGL_INFO, "call is started (call id %u)", res.data.call_id);
+	/* the state of the call (dialing) follows the call status indications: MM_BASE_CALL_SUPPORTS_DIALING_TO_RINGING */
+	if (c && c->state != CALL_STATE_TERMINATED)
+		c->qmi_id = res.data.call_id;
+	vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+/** ubus call uqmid.modem.0.call.0 start */
+static int call_start(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		      const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+	struct modem_voice *v = c->v;
+	struct modem *modem = v->modem;
+	struct qmi_service *svc;
+	struct qmi_voice_dial_call_request dr = {};
+	struct vop *op;
+
+	/* We can only start call created by the user */
+	if (c->state != CALL_STATE_UNKNOWN || c->direction != CALL_DIR_OUTGOING)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED,
+					      "This call was not in unknown state, cannot start it");
+
+	svc = voice_client(v);
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	modem_log(modem, LOGL_INFO, "processing user request to start voice call %s...", c->ubus.name);
+
+	/* Disallow non-emergency calls when in emergency-only state */
+	if (!outgoing_allowed(modem, c->number ? c->number : "")) {
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNAUTHORIZED, "only emergency calls allowed");
+	}
+
+	call_change_state(c, CALL_STATE_DIALING, CALL_REASON_OUTGOING_STARTED);
+
+	op = vop_new(v, ctx, req, VOP_START, c->index);
+	if (!op) {
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+		return UBUS_STATUS_NO_MEMORY;
+	}
+
+	dr.data.calling_number = c->number;
+	if (SEND_REQ(svc, qmi_set_voice_dial_call_request(_m, &dr), start_cb, op, DIAL_TIMEOUT_MS)) {
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_UNKNOWN);
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't create call", NULL);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+static void accept_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+	struct call *c = call_find(op->v, op->call_id);
+
+	if (!msg || req->ret) {
+		if (c)
+			call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_ERROR);
+		vop_fail_req(op, req, "Couldn't accept call");
+		return;
+	}
+
+	modem_log(op->v->modem, LOGL_INFO, "call is accepted");
+	if (c)
+		call_change_state(c, CALL_STATE_ACTIVE, CALL_REASON_ACCEPTED);
+	vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+/** ubus call uqmid.modem.0.call.0 accept */
+static int call_accept(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		       const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+	struct modem_voice *v = c->v;
+	struct qmi_service *svc;
+	struct qmi_voice_answer_call_request ar = {};
+	struct vop *op;
+
+	/* We can only accept incoming call in ringing state */
+	if (c->state != CALL_STATE_RINGING_IN)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This call was not ringing, cannot accept");
+
+	svc = voice_client(v);
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	if (!c->qmi_id)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid call index");
+
+	modem_log(v->modem, LOGL_INFO, "processing user request to accept voice call %s (call id %u)...",
+		  c->ubus.name, c->qmi_id);
+
+	op = vop_new(v, ctx, req, VOP_ACCEPT, c->index);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	qmi_set(&ar, call_id, c->qmi_id);
+	if (SEND_REQ(svc, qmi_set_voice_answer_call_request(_m, &ar), accept_cb, op, CALL_TIMEOUT_MS))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't accept call", NULL);
+
+	return UBUS_STATUS_OK;
+}
+
+enum { DF_NUMBER, __DF_MAX };
+static const struct blobmsg_policy call_deflect_policy[__DF_MAX] = {
+	[DF_NUMBER] = { .name = "number", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0.call.0 deflect '{"number": "..."}' (not supported by QMI, like MM) */
+static int call_deflect(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+	struct blob_attr *tb[__DF_MAX];
+
+	blobmsg_parse(call_deflect_policy, __DF_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[DF_NUMBER])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	/* We can only deflect incoming call in ringing or waiting state */
+	if (c->state != CALL_STATE_RINGING_IN && c->state != CALL_STATE_WAITING)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED,
+					      "This call was not ringing/waiting, cannot deflect");
+
+	return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED,
+				      "Deflecting call is not supported by this modem");
+}
+
+static void hangup_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+	struct call *c = call_find(op->v, op->call_id);
+
+	/* we set it as terminated even if we got an error reported */
+	if (c)
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_TERMINATED);
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't hangup call");
+		return;
+	}
+
+	vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+/** ubus call uqmid.modem.0.call.0 hangup */
+static int call_hangup(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		       const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+	struct modem_voice *v = c->v;
+	struct qmi_service *svc;
+	struct qmi_voice_end_call_request er = {};
+	struct vop *op;
+
+	/* We can only hangup call in a valid state */
+	if (c->state == CALL_STATE_TERMINATED || c->state == CALL_STATE_UNKNOWN)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This call was not active, cannot hangup");
+
+	svc = voice_client(v);
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	modem_log(v->modem, LOGL_INFO, "processing user request to hangup voice call %s (call id %u)...",
+		  c->ubus.name, c->qmi_id);
+
+	op = vop_new(v, ctx, req, VOP_HANGUP, c->index);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	/* MM: an index of 0 is an invalid call index. The call is terminated anyway. */
+	if (!c->qmi_id) {
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_TERMINATED);
+		vop_done(op, MODEM_ERR_INVALID_ARGS, "Invalid call index", NULL);
+		return UBUS_STATUS_OK;
+	}
+
+	qmi_set(&er, call_id, c->qmi_id);
+	if (SEND_REQ(svc, qmi_set_voice_end_call_request(_m, &er), hangup_cb, op, CALL_TIMEOUT_MS)) {
+		call_change_state(c, CALL_STATE_TERMINATED, CALL_REASON_TERMINATED);
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't hangup call", NULL);
+	}
+
+	return UBUS_STATUS_OK;
+}
+
+/* mm-call-qmi.c: Start Continuous DTMF, 500 ms, Stop Continuous DTMF, for each character in turn */
+static void dtmf_next(struct vop *op);
+
+static void dtmf_stop_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't send DTMF character");
+		return;
+	}
+
+	op->pos++;
+	dtmf_next(op);
+}
+
+static void dtmf_timer_cb(struct uloop_timeout *t)
+{
+	struct vop *op = container_of(t, struct vop, timer);
+	struct call *c = call_find(op->v, op->call_id);
+	struct qmi_service *svc = voice_client(op->v);
+	struct qmi_voice_stop_continuous_dtmf_request sr = {};
+
+	op->stopping = true;
+	if (!svc || !c || !c->qmi_id) {
+		vop_done(op, MODEM_ERR_ABORTED, "The call is gone", NULL);
+		return;
+	}
+
+	sr.set.data = 1;
+	sr.data.data.call_id = c->qmi_id;
+	if (SEND_REQ(svc, qmi_set_voice_stop_continuous_dtmf_request(_m, &sr), dtmf_stop_cb, op, CALL_TIMEOUT_MS))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't send DTMF character", NULL);
+}
+
+static void dtmf_start_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't send DTMF character");
+		return;
+	}
+
+	/* Disable DTMF press after 500 ms */
+	op->timer.cb = dtmf_timer_cb;
+	uloop_timeout_set(&op->timer, DTMF_DURATION_MS);
+}
+
+static void dtmf_next(struct vop *op)
+{
+	struct call *c = call_find(op->v, op->call_id);
+	struct qmi_service *svc = voice_client(op->v);
+	struct qmi_voice_start_continuous_dtmf_request sr = {};
+
+	if (!op->digits[op->pos]) {
+		vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+		return;
+	}
+
+	if (!svc || !c || c->state != CALL_STATE_ACTIVE || !c->qmi_id) {
+		vop_done(op, MODEM_ERR_ABORTED, "The call is not active anymore", NULL);
+		return;
+	}
+
+	op->stopping = false;
+	/* Send DTMF character as ASCII number */
+	sr.set.data = 1;
+	sr.data.data.call_id = c->qmi_id;
+	sr.data.data.digit = (uint8_t)op->digits[op->pos];
+	if (SEND_REQ(svc, qmi_set_voice_start_continuous_dtmf_request(_m, &sr), dtmf_start_cb, op, CALL_TIMEOUT_MS))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't send DTMF character", NULL);
+}
+
+enum { DT_DTMF, __DT_MAX };
+static const struct blobmsg_policy call_send_dtmf_policy[__DT_MAX] = {
+	[DT_DTMF] = { .name = "dtmf", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0.call.0 send_dtmf '{"dtmf": "123#"}' */
+static int call_send_dtmf(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			  const char *method, struct blob_attr *msg)
+{
+	struct call *c = container_of(obj, struct call, ubus);
+	struct modem_voice *v = c->v;
+	struct blob_attr *tb[__DT_MAX];
+	struct vop *op;
+	const char *dtmf;
+
+	blobmsg_parse(call_send_dtmf_policy, __DT_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[DT_DTMF])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	dtmf = blobmsg_get_string(tb[DT_DTMF]);
+
+	if (!voice_client(v))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, "Modem is not enabled");
+
+	/* We can only send_dtmf when call is in ACTIVE state */
+	if (c->state != CALL_STATE_ACTIVE)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "This call was not active, cannot send dtmf");
+
+	if (!c->qmi_id)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "Invalid call index");
+
+	if (!voice_dtmf_valid(dtmf))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Invalid DTMF characters (0-9, *, #, A-D)");
+
+	if (c->dtmf_busy)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS, "Already sending DTMF");
+
+	modem_log(v->modem, LOGL_INFO, "processing user request to send DTMF on %s...", c->ubus.name);
+
+	op = vop_new(v, ctx, req, VOP_DTMF, c->index);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	op->digits = talloc_strdup(op, dtmf);
+	c->dtmf_busy = true;
+	dtmf_next(op);
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method call_methods[] = {
+	UBUS_METHOD_NOARG("get", call_get),
+	UBUS_METHOD_NOARG("start", call_start),
+	UBUS_METHOD_NOARG("accept", call_accept),
+	UBUS_METHOD("deflect", call_deflect, call_deflect_policy),
+	UBUS_METHOD_NOARG("hangup", call_hangup),
+	UBUS_METHOD("send_dtmf", call_send_dtmf, call_send_dtmf_policy),
+};
+
+static struct ubus_object_type call_object_type = UBUS_OBJECT_TYPE("uqmid_call", call_methods);

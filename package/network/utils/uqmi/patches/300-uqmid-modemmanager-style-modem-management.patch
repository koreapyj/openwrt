+/*
+ * uqmid -- SMS messaging (ModemManager: Modem.Messaging, mm-iface-modem-messaging.c and the Messaging parts
+ * of mm-broadband-modem-qmi.c; the SMS objects are in sms.c).
+ *
+ * The modem object has the messaging_* methods (List, Create, Delete, SetDefaultStorage), the properties
+ * messages, supported_storages and default_storage, and the notifications messaging.added / messaging.deleted.
+ *
+ * QMI: one WMS client is allocated when the modem is initialized and kept until the modem goes away (MM: qmi_services[]
+ * of mm-broadband-modem-qmi.c, it is never released). Enabling (mm_iface_modem_messaging_enable()):
+ *  1. default storage: Get Routes (class 0 and 1 routed with STORE_AND_NOTIFY, the table is logged), ME if the
+ *     modem does not tell (get_best_initial_default_sms_storage()), then Set Routes with it (a failure is only
+ *     a warning);
+ *  2. the SMS of the storages SM and ME are loaded (load_initial_sms_parts()): List Messages without a tag
+ *     first, on an error one list per tag (MT read, MT not read, MO sent, MO not sent), then a Raw Read per
+ *     message (3 s, errors are ignored);
+ *  3. the Event Report indication is registered and the new MT message indicator is enabled (errors ignored).
+ * Disabling switches the indicator off (the client stays). The SMS list lives from the enable until the
+ * disable (MM clears it at the disable, no Deleted signals).
+ *
+ * Event Report: a message which was stored (storage and index) is read with Raw Read; a transfer-route
+ * message is acknowledged (if the modem wants it) and used directly, it is not stored anywhere.
+ *
+ * Deviations from MM:
+ *  - the default storage is read at the first enable, not when the modem is initialized, and the list of
+ *    supported storages (sm, me) is static;
+ *  - a List Messages request which times out does not end the loading of the storage. The LG U+ UZ801
+ *    (MSM8916) never answers the list of the tag "MT read" (and has no list without a tag): that costs one
+ *    short timeout (3 s) per storage and the next tag is tried. After 3 timeouts the storage is given up;
+ *  - CDMA messages and cell broadcast messages are not supported (3GPP point to point only);
+ *  - the interface does not fail the enable of the modem.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <libubox/blobmsg.h>
+#include <talloc.h>
+
+#include "charsets.h"
+#include "messaging.h"
+#include "messaging_priv.h"
+
+#define WMS_IND_EVENT_REPORT 0x0001
+
+/* a List Messages request for one tag is answered or never: do not wait long (see the deviations) */
+#define WMS_LIST_TAG_TIMEOUT_MS 3000
+#define WMS_LIST_MAX_TIMEOUTS 3
+
+/* mem1 (list, read, delete) of mm-broadband-modem-qmi.c: sm and me */
+static const enum sms_storage supported_storages[] = { SMS_STORAGE_SM, SMS_STORAGE_ME };
+
+static struct blob_buf b;
+
+/*****************************************************************************/
+/* helpers */
+
+static enum sms_storage storage_from_qmi(uint8_t qmi_storage)
+{
+	switch (qmi_storage) {
+	case QMI_WMS_STORAGE_TYPE_UIM:
+		return SMS_STORAGE_SM;
+	case QMI_WMS_STORAGE_TYPE_NV:
+		return SMS_STORAGE_ME;
+	default:
+		return SMS_STORAGE_UNKNOWN;
+	}
+}
+
+static uint8_t storage_to_qmi(enum sms_storage storage)
+{
+	switch (storage) {
+	case SMS_STORAGE_SM:
+		return QMI_WMS_STORAGE_TYPE_UIM;
+	case SMS_STORAGE_ME:
+		return QMI_WMS_STORAGE_TYPE_NV;
+	default:
+		return QMI_WMS_STORAGE_TYPE_NONE;
+	}
+}
+
+/* mm_sms_state_from_qmi_message_tag() */
+static enum sms_state state_from_tag(uint8_t tag)
+{
+	switch (tag) {
+	case QMI_WMS_MESSAGE_TAG_TYPE_MT_READ:
+	case QMI_WMS_MESSAGE_TAG_TYPE_MT_NOT_READ:
+		return SMS_STATE_RECEIVED;
+	case QMI_WMS_MESSAGE_TAG_TYPE_MO_SENT:
+		return SMS_STATE_SENT;
+	case QMI_WMS_MESSAGE_TAG_TYPE_MO_NOT_SENT:
+		return SMS_STATE_STORED;
+	default:
+		return SMS_STATE_UNKNOWN;
+	}
+}
+
+static const char *const tag_names[] = { "MT-read", "MT-not-read", "MO-sent", "MO-not-sent" };
+
+/* add_new_read_sms_part(): true if the PDU was parsed (and the part taken) */
+static bool add_new_read_sms_part(struct modem_messaging *m, uint8_t storage, uint32_t index, uint8_t tag,
+				  uint8_t format, bool transfer_route, const uint8_t *data, size_t len)
+{
+	struct sms_part *part = NULL;
+	char err[100] = "";
+
+	switch (format) {
+	case QMI_WMS_MESSAGE_FORMAT_GSM_WCDMA_POINT_TO_POINT:
+		if (sms_part_3gpp_from_pdu(index, data, len, transfer_route, &part, err, sizeof(err)))
+			part = NULL;
+		break;
+	case QMI_WMS_MESSAGE_FORMAT_CDMA:
+		strcpy(err, "CDMA messages are not supported");
+		break;
+	case QMI_WMS_MESSAGE_FORMAT_GSM_WCDMA_BROADCAST:
+		strcpy(err, "cell broadcast messages are not supported");
+		break;
+	case QMI_WMS_MESSAGE_FORMAT_MWI:
+		strcpy(err, "don't know how to process 'message waiting indicator' messages");
+		break;
+	default:
+		snprintf(err, sizeof(err), "unhandled message format '%u'", format);
+		break;
+	}
+
+	if (part) {
+		modem_log(m->modem, LOGL_DEBUG, "correctly parsed PDU (%d)", (int)index);
+		sms_list_take_part(m, part, state_from_tag(tag), storage_from_qmi(storage));
+	} else {
+		/* Don't treat the error as critical */
+		modem_log(m->modem, LOGL_DEBUG, "error parsing PDU (%d): %s", (int)index, err);
+	}
+
+	return part != NULL;
+}
+
+/* Permanent diagnostic of a transfer-route message which could not be parsed (nothing else keeps the data: the
+ * message was not stored and it is acknowledged) */
+static void log_transfer_route_failure(struct modem_messaging *m, uint8_t ack_indicator, uint32_t transaction_id,
+				       uint8_t format, const uint8_t *data, size_t len)
+{
+	char hex[2 * 255 + 4];
+	size_t i, n = len > 255 ? 255 : len;
+
+	for (i = 0; i < n; i++)
+		snprintf(hex + 2 * i, 3, "%02X", data[i]);
+	strcpy(hex + 2 * n, len > n ? "..." : "");
+
+	modem_log(m->modem, LOGL_NOTICE,
+		  "transfer-route MT message could not be parsed: TLV 0x11 ack_indicator=%u transaction_id=%u format=0x%02x "
+		  "length=%zu data=%s",
+		  ack_indicator, transaction_id, format, len, hex[0] ? hex : "(empty)");
+}
+
+/*****************************************************************************/
+/* event report (MM: messaging_event_report_indication_cb()) */
+
+struct read_ctx {
+	struct modem_messaging *m;
+	uint8_t storage;
+	uint32_t index;
+};
+
+static void indication_read_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct read_ctx *ctx = req->cb_data;
+	struct qmi_wms_raw_read_response res = {};
+
+	/* Ignore errors */
+	if (!msg || req->ret) {
+		modem_log(ctx->m->modem, LOGL_DEBUG, "QMI operation failed: couldn't read raw message: %s",
+			  msg_req_error_str(req));
+	} else if (qmi_parse_wms_raw_read_response(msg, &res) || !res.set.raw_message_data) {
+		modem_log(ctx->m->modem, LOGL_DEBUG, "couldn't read raw message: invalid response");
+	} else if (!ctx->m->dying && ctx->m->active) {
+		add_new_read_sms_part(ctx->m, ctx->storage, ctx->index, res.data.raw_message_data.message_tag,
+				      res.data.raw_message_data.format, false, res.data.raw_message_data.raw_data,
+				      res.data.raw_message_data.raw_data_n);
+	}
+
+	talloc_free(ctx);
+}
+
+static void ack_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem_messaging *m = req->cb_data;
+
+	if (!msg || req->ret)
+		modem_log(m->modem, LOGL_DEBUG, "QMI operation failed: couldn't acknowledge the SMS: %s",
+			  msg_req_error_str(req));
+}
+
+static void event_report_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct modem_messaging *m = data;
+	struct qmi_wms_event_report_indication res = {};
+	struct qmi_service *svc = msg_client(m);
+
+	if (m->dying || !m->active || !svc)
+		return;
+
+	if (qmi_parse_wms_event_report_indication(msg, &res))
+		return;
+
+	/* Handle transfer-route MT messages */
+	if (res.set.transfer_route_mt_message) {
+		const typeof(res.data.transfer_route_mt_message) *tr = &res.data.transfer_route_mt_message;
+
+		modem_log(m->modem, LOGL_DEBUG, "Got transfer-route MT message");
+
+		/*
+		 * The generated parser keeps the Raw Data array in the static message buffer of qmi-message.c, which
+		 * every request encoder (the Send Ack below) resets and overwrites: the data has to be copied first,
+		 * otherwise the TPDU is garbage after the acknowledgement was built (MM's GArray is a copy).
+		 */
+		uint8_t raw[QMI_BUFFER_LEN];
+		size_t raw_len = tr->raw_data_n < sizeof(raw) ? tr->raw_data_n : sizeof(raw);
+
+		if (raw_len)
+			memcpy(raw, tr->raw_data, raw_len);
+
+		/* Match MM's messaging_event_report_indication_cb(): queue Send Ack first (if requested), then parse
+		 * the transfer-route TPDU synchronously below. The ACK response is asynchronous. */
+		/* If this is the first of a multi-part message, send an ACK to get the second part */
+		if (tr->ack_indicator == QMI_WMS_ACK_INDICATOR_SEND) {
+			struct qmi_wms_send_ack_request ar = {};
+
+			modem_log(m->modem, LOGL_DEBUG, "Need to ACK indicator");
+			ar.set.information = 1;
+			ar.data.information.transaction_id = tr->transaction_id;
+			ar.data.information.message_protocol = tr->format == QMI_WMS_MESSAGE_FORMAT_CDMA ?
+				QMI_WMS_MESSAGE_PROTOCOL_CDMA : QMI_WMS_MESSAGE_PROTOCOL_WCDMA;
+			ar.data.information.success = true;
+			if (SEND_REQ(svc, qmi_set_wms_send_ack_request(_m, &ar), ack_cb, m, WMS_SEND_TIMEOUT_MS))
+				modem_log(m->modem, LOGL_DEBUG, "couldn't send the SMS acknowledgement");
+		}
+
+		/* Defaults for transfer-route messages, which are not stored anywhere */
+		/* MM passes transfer_route=TRUE: the raw_data is a TPDU without an SMSC field. */
+		if (!add_new_read_sms_part(m, QMI_WMS_STORAGE_TYPE_NONE, SMS_PART_INVALID_INDEX,
+					   QMI_WMS_MESSAGE_TAG_TYPE_MT_NOT_READ, tr->format, true, raw, raw_len))
+			log_transfer_route_failure(m, tr->ack_indicator, tr->transaction_id, tr->format, raw, raw_len);
+		return;
+	}
+
+	if (res.set.mt_message) {
+		struct qmi_wms_raw_read_request rr = {};
+		struct read_ctx *ctx = talloc_zero(svc, struct read_ctx);
+
+		if (!ctx)
+			return;
+		ctx->m = m;
+		ctx->storage = res.data.mt_message.storage_type;
+		ctx->index = res.data.mt_message.memory_index;
+
+		modem_log(m->modem, LOGL_DEBUG, "new MT message at %s/%u", sms_storage_name(storage_from_qmi(ctx->storage)),
+			  ctx->index);
+
+		rr.set.message_memory_storage_id = 1;
+		rr.data.message_memory_storage_id.storage_type = ctx->storage;
+		rr.data.message_memory_storage_id.memory_index = ctx->index;
+		/* Default to 3GPP message mode if none given */
+		rr.set.message_mode = 1;
+		rr.data.message_mode = res.set.message_mode ? res.data.message_mode : QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+		if (SEND_REQ(svc, qmi_set_wms_raw_read_request(_m, &rr), indication_read_cb, ctx, WMS_READ_TIMEOUT_MS))
+			talloc_free(ctx);
+	}
+}
+
+/*****************************************************************************/
+/* enable and disable (MM: mm_iface_modem_messaging_enable() / _disable()) */
+
+struct sms_ref {
+	uint32_t index;
+};
+
+struct msg_toggle {
+	struct modem_messaging *m;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+
+	/* load_initial_sms_parts(): the storage (index of supported_storages) and the tag (-1: all) */
+	unsigned int storage_i;
+	int tag;
+	unsigned int timeouts;
+	struct sms_ref *entries;
+	unsigned int n_entries, pos;
+};
+
+static void toggle_finish(struct msg_toggle *t)
+{
+	void (*done)(struct modem *modem, void *data) = t->done;
+	void *data = t->data;
+	struct modem *modem = t->m->modem;
+
+	talloc_free(t);
+	done(modem, data);
+}
+
+/* the client is kept (MM never releases it before the modem is gone), only the event report is disconnected */
+static void release_client(struct modem_messaging *m)
+{
+	struct qmi_service *svc = m->svc;
+
+	if (svc && uqmi_service_valid(m->modem->qmi, svc) && m->events_registered)
+		uqmi_service_remove_indication(svc, WMS_IND_EVENT_REPORT, event_report_ind, m);
+	m->events_registered = false;
+}
+
+/*
+ * The WMS client id could not be allocated (the modem has no WMS service): every further request would try to
+ * allocate it again, so the enable ends here (MM: the messaging interface is not supported then).
+ */
+static bool wms_unavailable(struct msg_toggle *t)
+{
+	struct modem_messaging *m = t->m;
+	struct qmi_service *svc = msg_client(m);
+
+	if (svc && svc->state == SERVICE_READY)
+		return false;
+
+	modem_log(m->modem, LOGL_NOTICE, "the WMS service is not available, SMS messaging is not supported");
+	release_client(m);
+	m->active = false;
+	toggle_finish(t);
+	return true;
+}
+
+/* 3. unsolicited events */
+
+static void enable_events_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+
+	/* Not critical! */
+	if (!msg || req->ret)
+		modem_log(t->m->modem, LOGL_DEBUG, "couldn't enable unsolicited events: %s", msg_req_error_str(req));
+
+	toggle_finish(t);
+}
+
+static void enable_events(struct msg_toggle *t)
+{
+	struct modem_messaging *m = t->m;
+	struct qmi_service *svc = msg_client(m);
+	struct qmi_wms_set_event_report_request er = {};
+
+	if (!svc) {
+		toggle_finish(t);
+		return;
+	}
+
+	/* setup_unsolicited_events(): connect the Event Report indications */
+	if (!m->events_registered) {
+		uqmi_service_register_indication(svc, WMS_IND_EVENT_REPORT, event_report_ind, m);
+		m->events_registered = true;
+	}
+
+	/* enable_unsolicited_events() */
+	er.set.new_mt_message_indicator = 1;
+	er.data.new_mt_message_indicator.report = true;
+	if (SEND_REQ(svc, qmi_set_wms_set_event_report_request(_m, &er), enable_events_cb, t, WMS_TIMEOUT_MS))
+		toggle_finish(t);
+}
+
+/* 2. load the initial SMS parts */
+
+static void load_step(struct msg_toggle *t);
+
+static void load_next_storage(struct msg_toggle *t)
+{
+	TALLOC_FREE(t->entries);
+	t->n_entries = t->pos = 0;
+	t->storage_i++;
+	t->tag = -1;
+	t->timeouts = 0;
+	load_step(t);
+}
+
+static void load_next_tag(struct msg_toggle *t)
+{
+	TALLOC_FREE(t->entries);
+	t->n_entries = t->pos = 0;
+	t->tag++;
+	load_step(t);
+}
+
+static void load_read_next(struct msg_toggle *t);
+
+static void load_read_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+	struct qmi_wms_raw_read_response res = {};
+
+	/* Ignore errors, just keep on with the next messages */
+	if (!msg || req->ret) {
+		modem_log(t->m->modem, LOGL_DEBUG, "QMI operation failed: couldn't read raw message: %s",
+			  msg_req_error_str(req));
+	} else if (qmi_parse_wms_raw_read_response(msg, &res) || !res.set.raw_message_data) {
+		modem_log(t->m->modem, LOGL_DEBUG, "couldn't read raw message: invalid response");
+	} else {
+		add_new_read_sms_part(t->m, storage_to_qmi(supported_storages[t->storage_i]),
+				      t->entries[t->pos].index, res.data.raw_message_data.message_tag,
+				      res.data.raw_message_data.format, false, res.data.raw_message_data.raw_data,
+				      res.data.raw_message_data.raw_data_n);
+	}
+
+	/* Keep on reading parts */
+	t->pos++;
+	load_read_next(t);
+}
+
+static void load_read_next(struct msg_toggle *t)
+{
+	struct qmi_service *svc = msg_client(t->m);
+	struct qmi_wms_raw_read_request rr = {};
+
+	if (t->pos >= t->n_entries) {
+		/* If we just listed all SMS, we're done. Otherwise go to next tag. */
+		if (t->tag < 0)
+			load_next_storage(t);
+		else
+			load_next_tag(t);
+		return;
+	}
+
+	if (!svc) {
+		toggle_finish(t);
+		return;
+	}
+
+	rr.set.message_memory_storage_id = 1;
+	rr.data.message_memory_storage_id.storage_type = storage_to_qmi(supported_storages[t->storage_i]);
+	rr.data.message_memory_storage_id.memory_index = t->entries[t->pos].index;
+	rr.set.message_mode = 1;
+	rr.data.message_mode = QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+	if (SEND_REQ(svc, qmi_set_wms_raw_read_request(_m, &rr), load_read_cb, t, WMS_READ_TIMEOUT_MS)) {
+		t->pos++;
+		load_read_next(t);
+	}
+}
+
+static void load_list_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+	struct qmi_wms_list_messages_response res = {};
+	unsigned int i;
+
+	if (!msg || req->ret || qmi_parse_wms_list_messages_response(msg, &res)) {
+		/* Ignore error, keep on. A timeout is not the end of the storage (see the deviations). */
+		modem_log(t->m->modem, LOGL_DEBUG, "couldn't read SMS messages (%s%s): %s",
+			  sms_storage_name(supported_storages[t->storage_i]),
+			  t->tag < 0 ? "" : tag_names[t->tag], msg_req_error_str(req));
+		if (wms_unavailable(t))
+			return;
+		if (req->ret == UQMID_ERROR_TIMEOUT)
+			t->timeouts++;
+
+		if (t->timeouts >= WMS_LIST_MAX_TIMEOUTS) {
+			modem_log(t->m->modem, LOGL_NOTICE, "giving up loading the SMS of the storage '%s'",
+				  sms_storage_name(supported_storages[t->storage_i]));
+			load_next_storage(t);
+		} else {
+			load_next_tag(t);
+		}
+		return;
+	}
+
+	/* Keep the list: the response is gone after the callback */
+	TALLOC_FREE(t->entries);
+	t->n_entries = t->pos = 0;
+	if (res.data.message_list_n) {
+		t->entries = talloc_array(t, struct sms_ref, res.data.message_list_n);
+		if (t->entries) {
+			for (i = 0; i < res.data.message_list_n; i++)
+				t->entries[i].index = res.data.message_list[i].memory_index;
+			t->n_entries = res.data.message_list_n;
+		}
+	}
+
+	/* Start reading parts */
+	load_read_next(t);
+}
+
+static void load_step(struct msg_toggle *t)
+{
+	struct modem_messaging *m = t->m;
+	struct qmi_service *svc = msg_client(m);
+	struct qmi_wms_list_messages_request lr = {};
+	enum sms_storage storage;
+
+	/* the storages are done: the events follow */
+	if (t->storage_i >= ARRAY_SIZE(supported_storages)) {
+		enable_events(t);
+		return;
+	}
+
+	/* all tags done: the next storage */
+	if (t->tag >= (int)ARRAY_SIZE(tag_names)) {
+		load_next_storage(t);
+		return;
+	}
+
+	if (!svc) {
+		toggle_finish(t);
+		return;
+	}
+
+	storage = supported_storages[t->storage_i];
+	if (t->tag < 0)
+		modem_log(m->modem, LOGL_DEBUG, "loading all 3GPP messages from storage '%s'...", sms_storage_name(storage));
+	else
+		modem_log(m->modem, LOGL_DEBUG, "loading 3GPP %s messages from storage '%s'...", tag_names[t->tag],
+			  sms_storage_name(storage));
+
+	lr.set.storage_type = 1;
+	lr.data.storage_type = storage_to_qmi(storage);
+	lr.set.message_mode = 1;
+	lr.data.message_mode = QMI_WMS_MESSAGE_MODE_GSM_WCDMA;
+	if (t->tag >= 0) {
+		lr.set.message_tag = 1;
+		lr.data.message_tag = t->tag;
+	}
+	if (SEND_REQ(svc, qmi_set_wms_list_messages_request(_m, &lr), load_list_cb, t,
+		     t->tag < 0 ? WMS_TIMEOUT_MS : WMS_LIST_TAG_TIMEOUT_MS)) {
+		if (t->tag < 0)
+			t->tag = 0;
+		else
+			t->tag++;
+		load_step(t);
+	}
+}
+
+static void load_initial_sms_parts(struct msg_toggle *t)
+{
+	t->storage_i = 0;
+	t->tag = -1;
+	t->timeouts = 0;
+	load_step(t);
+}
+
+/* 1. the default storage */
+
+static const char *route_class_name(uint8_t c)
+{
+	static const char *const names[] = { "0", "1", "2", "3", "none", "cdma" };
+
+	return c < ARRAY_SIZE(names) ? names[c] : "unknown";
+}
+
+static const char *route_action_name(uint8_t a)
+{
+	switch (a) {
+	case QMI_WMS_RECEIPT_ACTION_DISCARD:
+		return "discard";
+	case QMI_WMS_RECEIPT_ACTION_STORE_AND_NOTIFY:
+		return "store-and-notify";
+	case QMI_WMS_RECEIPT_ACTION_TRANSFER_ONLY:
+		return "transfer-only";
+	case QMI_WMS_RECEIPT_ACTION_TRANSFER_AND_ACK:
+		return "transfer-and-ack";
+	default:
+		return "unknown";
+	}
+}
+
+static const char *route_storage_name(uint8_t s)
+{
+	switch (s) {
+	case QMI_WMS_STORAGE_TYPE_UIM:
+		return "sm";
+	case QMI_WMS_STORAGE_TYPE_NV:
+		return "me";
+	case QMI_WMS_STORAGE_TYPE_NONE:
+		return "none";
+	default:
+		return "unknown";
+	}
+}
+
+/* Log the whole routing table (info): what the modem does with each message class, which is what decides if an MT
+ * message is stored or transferred to the client (transfer-only: not stored, it only arrives in the Event Report) */
+static void log_routes(struct modem_messaging *m, const char *when, const struct qmi_wms_get_routes_response *res)
+{
+	unsigned int i;
+
+	modem_log(m->modem, LOGL_INFO, "SMS routes (%s): %u entries", when, (unsigned int)res->data.route_list_n);
+	for (i = 0; i < res->data.route_list_n; i++) {
+		const typeof(*res->data.route_list) *route = &res->data.route_list[i];
+
+		modem_log(m->modem, LOGL_INFO, "SMS routes (%s): [%u] type %u class %s storage %s action %s", when, i,
+			  route->message_type, route_class_name(route->message_class),
+			  route_storage_name(route->storage), route_action_name(route->receipt_action));
+	}
+}
+
+/* the routes after Set Routes (info log only) */
+static void get_routes_after_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+	struct qmi_wms_get_routes_response res = {};
+
+	if (!msg || req->ret || qmi_parse_wms_get_routes_response(msg, &res))
+		modem_log(t->m->modem, LOGL_INFO, "SMS routes (after): couldn't get SMS routes: %s", msg_req_error_str(req));
+	else
+		log_routes(t->m, "after", &res);
+
+	load_initial_sms_parts(t);
+}
+
+static void set_routes_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+
+	if (!msg || req->ret) {
+		modem_log(t->m->modem, LOGL_NOTICE, "could not set default storage: %s", msg_req_error_str(req));
+		if (wms_unavailable(t))
+			return;
+	}
+
+	/* Not in MM: show what the modem made of the routes */
+	if (!msg_client(t->m) ||
+	    SEND_REQ(msg_client(t->m), qmi_set_wms_get_routes_request(_m), get_routes_after_cb, t, WMS_TIMEOUT_MS))
+		load_initial_sms_parts(t);
+}
+
+/*
+ * Set Routes, class 0 and class 1 only, point to point, store and notify (MM: messaging_set_default_storage()
+ * "Just worry about Class 0 and Class 1 messages for now"). The other classes (2, 3, none) keep the routes of the
+ * modem (its carrier configuration): the log of the Get Routes shows them. The storage is chosen with the
+ * messaging_set_default_storage method, like MM's SetDefaultStorage.
+ */
+static int send_set_routes(struct modem_messaging *m, enum sms_storage storage, request_cb cb, void *data)
+{
+	struct qmi_service *svc = msg_client(m);
+	struct qmi_wms_set_routes_request sr = {};
+	typeof(*sr.data.route_list) routes[2] = {};
+
+	if (!svc)
+		return -ENODEV;
+
+	/* Build routes array and add it as input. Just worry about Class 0 and Class 1 messages for now */
+	routes[0].message_type = QMI_WMS_MESSAGE_TYPE_POINT_TO_POINT;
+	routes[0].message_class = QMI_WMS_MESSAGE_CLASS_0;
+	routes[0].storage = storage_to_qmi(storage);
+	routes[0].receipt_action = QMI_WMS_RECEIPT_ACTION_STORE_AND_NOTIFY;
+	routes[1] = routes[0];
+	routes[1].message_class = QMI_WMS_MESSAGE_CLASS_1;
+	sr.data.route_list_n = ARRAY_SIZE(routes);
+	sr.data.route_list = routes;
+
+	return SEND_REQ(svc, qmi_set_wms_set_routes_request(_m, &sr), cb, data, WMS_TIMEOUT_MS);
+}
+
+static void set_default_routes(struct msg_toggle *t)
+{
+	struct modem_messaging *m = t->m;
+
+	if (m->default_storage == SMS_STORAGE_UNKNOWN) {
+		/* get_best_initial_default_sms_storage(): MT (not supported by QMI), ME, SM */
+		m->default_storage = SMS_STORAGE_ME;
+		modem_log(m->modem, LOGL_DEBUG, "no default storage known, using '%s'",
+			  sms_storage_name(m->default_storage));
+	}
+	m->default_storage_known = true;
+
+	modem_log(m->modem, LOGL_DEBUG, "setting default messaging routes...");
+	if (send_set_routes(m, m->default_storage, set_routes_cb, t))
+		load_initial_sms_parts(t);
+}
+
+static void get_routes_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+	struct modem_messaging *m = t->m;
+	struct qmi_wms_get_routes_response res = {};
+	enum sms_storage storage = SMS_STORAGE_UNKNOWN;
+	unsigned int i;
+
+	if (!msg || req->ret || qmi_parse_wms_get_routes_response(msg, &res)) {
+		modem_log(m->modem, LOGL_DEBUG, "couldn't get SMS routes: %s", msg_req_error_str(req));
+		if (wms_unavailable(t))
+			return;
+	} else {
+		log_routes(m, "before", &res);
+		for (i = 0; i < res.data.route_list_n; i++) {
+			const typeof(*res.data.route_list) *route = &res.data.route_list[i];
+
+			if ((route->message_class == QMI_WMS_MESSAGE_CLASS_0 || route->message_class == QMI_WMS_MESSAGE_CLASS_1) &&
+			    route->receipt_action == QMI_WMS_RECEIPT_ACTION_STORE_AND_NOTIFY)
+				storage = storage_from_qmi(route->storage);
+			modem_log(m->modem, LOGL_DEBUG, "Default route defined for SMS Messaging is set to store at: %s",
+				  sms_storage_name(storage));
+		}
+		/* MM reads the default storage of the modem once; later (also after a disable/enable) the one which
+		 * was chosen (messaging_set_default_storage) is kept and set again */
+		if (!m->default_storage_known)
+			m->default_storage = storage;
+	}
+
+	set_default_routes(t);
+}
+
+void uqmid_messaging_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_messaging *m = msg_of(modem);
+	struct msg_toggle *t;
+
+	t = talloc_zero(m, struct msg_toggle);
+	t->m = m;
+	t->done = done;
+	t->data = data;
+
+	if (m->active) {
+		/* already enabled */
+		toggle_finish(t);
+		return;
+	}
+
+	if (!m->svc || !uqmi_service_valid(modem->qmi, m->svc)) {
+		modem_log(modem, LOGL_NOTICE, "the WMS service is not available, SMS messaging is not supported");
+		toggle_finish(t);
+		return;
+	}
+
+	m->dying = false;
+	m->active = true;
+
+	/* MM: Get Routes only to find the default storage the first time. uqmid does it at every enable for the log
+	 * of the routes (info) before and after Set Routes */
+	modem_log(modem, LOGL_DEBUG, "getting default messaging routes...");
+	if (SEND_REQ(m->svc, qmi_set_wms_get_routes_request(_m), get_routes_cb, t, WMS_TIMEOUT_MS))
+		set_default_routes(t);
+}
+
+static void disable_events_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct msg_toggle *t = req->cb_data;
+	struct modem_messaging *m = t->m;
+
+	if (!msg || req->ret)
+		modem_log(m->modem, LOGL_DEBUG, "couldn't disable unsolicited events: %s", msg_req_error_str(req));
+
+	release_client(m);
+	/* Clear SMS list */
+	sms_list_clear(m);
+	m->active = false;
+	toggle_finish(t);
+}
+
+void uqmid_messaging_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_messaging *m = msg_of(modem);
+	struct qmi_service *svc = msg_client(m);
+	struct qmi_wms_set_event_report_request er = {};
+	struct msg_toggle *t;
+
+	t = talloc_zero(m, struct msg_toggle);
+	t->m = m;
+	t->done = done;
+	t->data = data;
+
+	/* the user requests which wait for the WMS client end here: their requests are cancelled without callback */
+	if (svc)
+		uqmi_service_cancel_requests(svc, QMI_ERROR_CANCELLED, false);
+	sms_ops_abort(m);
+
+	if (!svc) {
+		release_client(m);
+		sms_list_clear(m);
+		m->active = false;
+		toggle_finish(t);
+		return;
+	}
+
+	er.set.new_mt_message_indicator = 1;
+	er.data.new_mt_message_indicator.report = false;
+	if (SEND_REQ(svc, qmi_set_wms_set_event_report_request(_m, &er), disable_events_cb, t, WMS_TIMEOUT_MS)) {
+		release_client(m);
+		sms_list_clear(m);
+		m->active = false;
+		toggle_finish(t);
+	}
+}
+
+/*****************************************************************************/
+/* methods of the modem object */
+
+static const char *const messaging_not_enabled = "Modem is not enabled";
+
+/** ubus call uqmid.modem.0 messaging_list -> {"messages": ["uqmid.modem.0.sms.0", ...]} */
+static int modem_messaging_list(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_messaging *m = msg_of(modem);
+	struct sms *sms;
+	void *a;
+
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, messaging_not_enabled);
+
+	modem_log(modem, LOGL_INFO, "processing user request to list SMS messages...");
+
+	blob_buf_init(&b, 0);
+	a = blobmsg_open_array(&b, "messages");
+	list_for_each_entry(sms, &m->smss, list)
+		blobmsg_add_string(&b, NULL, sms->ubus.name);
+	blobmsg_close_array(&b, a);
+	modem_log(modem, LOGL_INFO, "reported %u SMS messages available", m->n_smss);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+enum { CR_NUMBER, CR_TEXT, CR_DATA, CR_SMSC, CR_VALIDITY, CR_CLASS, CR_DRA, __CR_MAX };
+static const struct blobmsg_policy messaging_create_policy[__CR_MAX] = {
+	[CR_NUMBER] = { .name = "number", .type = BLOBMSG_TYPE_STRING },
+	[CR_TEXT] = { .name = "text", .type = BLOBMSG_TYPE_STRING },
+	[CR_DATA] = { .name = "data", .type = BLOBMSG_TYPE_STRING },
+	[CR_SMSC] = { .name = "smsc", .type = BLOBMSG_TYPE_STRING },
+	[CR_VALIDITY] = { .name = "validity", .type = BLOBMSG_TYPE_INT32 },
+	[CR_CLASS] = { .name = "class", .type = BLOBMSG_TYPE_INT32 },
+	[CR_DRA] = { .name = "delivery_report_request", .type = BLOBMSG_TYPE_BOOL },
+};
+
+/* hex string -> bytes (talloc'ed under @ctx), NULL if invalid */
+static uint8_t *hex_to_bytes(void *ctx, const char *hex, size_t *len)
+{
+	size_t n = strlen(hex), i;
+	uint8_t *out;
+
+	if (n % 2)
+		return NULL;
+
+	out = talloc_size(ctx, n / 2 ? n / 2 : 1);
+	if (!out)
+		return NULL;
+
+	for (i = 0; i < n; i += 2) {
+		unsigned int v;
+		char pair[3] = { hex[i], hex[i + 1], 0 };
+		char *end;
+
+		v = strtoul(pair, &end, 16);
+		if (*end || pair[0] == '+' || pair[0] == '-' || pair[0] == ' ') {
+			talloc_free(out);
+			return NULL;
+		}
+		out[i / 2] = v;
+	}
+
+	*len = n / 2;
+	return out;
+}
+
+/*
+ * ubus call uqmid.modem.0 messaging_create '{"number": "+821012345678", "text": "...", "smsc"?, "validity"?
+ * (minutes), "class"? (0-3), "delivery_report_request"?}' -> {"path": "uqmid.modem.0.sms.0"}
+ * "data" (hex string) replaces "text" for binary messages.
+ */
+static int modem_messaging_create(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_messaging *m = msg_of(modem);
+	struct blob_attr *tb[__CR_MAX];
+	const char *number, *text = NULL, *smsc = NULL;
+	uint8_t *data = NULL;
+	size_t data_len = 0;
+	int class = -1;
+	unsigned int validity = 0;
+	struct sms *sms;
+	char errtext[160];
+
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, messaging_not_enabled);
+
+	blobmsg_parse(messaging_create_policy, __CR_MAX, tb, blob_data(msg), blob_len(msg));
+
+	/* Don't create SMS from properties if either (text|data) or number is missing */
+	if (!tb[CR_NUMBER] || !*blobmsg_get_string(tb[CR_NUMBER]))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Cannot create SMS: mandatory parameter 'number' is missing");
+	if (!tb[CR_TEXT] && !tb[CR_DATA])
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Cannot create SMS: mandatory parameter 'text' or 'data' is missing");
+	/* Don't create SMS from properties if both text and data are given */
+	if (tb[CR_TEXT] && tb[CR_DATA])
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Cannot create SMS: both 'text' and 'data' given");
+
+	/* deviation: the properties are checked now, MM fails when the PDUs are created */
+	number = blobmsg_get_string(tb[CR_NUMBER]);
+	if (!sms_destination_valid(number)) {
+		snprintf(errtext, sizeof(errtext), "Cannot create SMS: invalid number '%.40s'", number);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, errtext);
+	}
+	if (tb[CR_SMSC]) {
+		smsc = blobmsg_get_string(tb[CR_SMSC]);
+		if (*smsc && !sms_address_valid(smsc)) {
+			snprintf(errtext, sizeof(errtext), "Cannot create SMS: invalid SMSC address '%.40s'", smsc);
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, errtext);
+		}
+		if (!*smsc)
+			smsc = NULL;
+	}
+	if (tb[CR_TEXT]) {
+		text = blobmsg_get_string(tb[CR_TEXT]);
+		if (!*text || !cs_utf8_valid(text))
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+						      "Cannot create SMS: 'text' is empty or not valid UTF-8");
+	} else {
+		data = hex_to_bytes(NULL, blobmsg_get_string(tb[CR_DATA]), &data_len);
+		if (!data || !data_len)
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+						      "Cannot create SMS: 'data' is empty or not a hex string");
+	}
+	if (tb[CR_CLASS]) {
+		class = (int32_t)blobmsg_get_u32(tb[CR_CLASS]);
+		if (class < 0 || class > 3) {
+			talloc_free(data);
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+						      "Cannot create SMS: 'class' must be 0 to 3");
+		}
+	}
+	if (tb[CR_VALIDITY]) {
+		int32_t v = blobmsg_get_u32(tb[CR_VALIDITY]);
+
+		/* relative validity in minutes, up to 63 weeks */
+		if (v < 0 || v > 635040) {
+			talloc_free(data);
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+						      "Cannot create SMS: 'validity' must be 0 to 635040 minutes");
+		}
+		validity = v;
+	}
+
+	if (m->n_smss >= MAX_SMS) {
+		talloc_free(data);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "Cannot create SMS: too many messages, delete some");
+	}
+
+	modem_log(modem, LOGL_INFO, "processing user request to create SMS message...");
+
+	sms = sms_create(m, number, text, data, data_len, smsc, validity, class,
+			 tb[CR_DRA] ? blobmsg_get_bool(tb[CR_DRA]) : false);
+	talloc_free(data);
+	if (!sms)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "Couldn't create the SMS");
+
+	modem_log(modem, LOGL_INFO, "created SMS message: %s", sms->ubus.name);
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "path", sms->ubus.name);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+enum { DL_PATH, __DL_MAX };
+static const struct blobmsg_policy messaging_delete_policy[__DL_MAX] = {
+	[DL_PATH] = { .name = "path", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 messaging_delete '{"path": "uqmid.modem.0.sms.0"}' */
+static int modem_messaging_delete(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_messaging *m = msg_of(modem);
+	struct blob_attr *tb[__DL_MAX];
+	const char *path;
+	struct sms *sms;
+	char text[PATH_LEN + 40];
+
+	blobmsg_parse(messaging_delete_policy, __DL_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[DL_PATH])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	path = blobmsg_get_string(tb[DL_PATH]);
+
+	/* We do allow deleting SMS messages while enabling or disabling, it doesn't interfere with the state
+	 * transition logic to do so. The main reason to allow this is that during modem enabling we're emitting
+	 * "Added" signals before we reach the enabled state, and so users listening to the signal may want to
+	 * delete the SMS message as soon as it's read. */
+	if (modem->mm_state < MODEM_STATE_DISABLING)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, messaging_not_enabled);
+
+	sms = sms_find_by_path(m, path);
+	if (!sms) {
+		snprintf(text, sizeof(text), "No SMS found with path '%.80s'", path);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_NOT_FOUND, text);
+	}
+
+	if (sms->busy)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_IN_PROGRESS,
+					      "Another operation on this SMS is running");
+
+	modem_log(modem, LOGL_INFO, "processing user request to delete SMS message '%s'...", path);
+
+	/* Delete all SMS parts */
+	sms_delete_deferred(sms, ctx, req);
+
+	return UBUS_STATUS_OK;
+}
+
+/* the routes after the user's Set Routes (info log only; the request is already answered) */
+static void set_default_storage_after_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem_messaging *m = req->cb_data;
+	struct qmi_wms_get_routes_response res = {};
+
+	if (m->dying)
+		return;
+	if (!msg || req->ret || qmi_parse_wms_get_routes_response(msg, &res))
+		modem_log(m->modem, LOGL_INFO, "SMS routes (after): couldn't get SMS routes: %s", msg_req_error_str(req));
+	else
+		log_routes(m, "after", &res);
+}
+
+static struct blob_buf reply_b;
+
+static void set_default_storage_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+	struct modem_messaging *m = op->m;
+
+	if (!msg || req->ret) {
+		modem_log(m->modem, LOGL_NOTICE, "could not set default storage: %s", msg_req_error_str(req));
+		mop_fail_req(op, req, "Couldn't set the default storage");
+		return;
+	}
+
+	m->default_storage = op->storage;
+	m->default_storage_known = true;
+	modem_log(m->modem, LOGL_INFO, "set the default storage successfully");
+	/* the usual reply of the operations: {"state", "power_state"} (MM: SetDefaultStorage has no output) */
+	blob_buf_init(&reply_b, 0);
+	blobmsg_add_string(&reply_b, "state", modem_state_name(m->modem->mm_state));
+	blobmsg_add_string(&reply_b, "power_state", modem_power_state_name(m->modem->power_state));
+	mop_done(op, MODEM_ERR_NONE, NULL, reply_b.head);
+	blob_buf_free(&reply_b);
+
+	/* Not in MM: show what the modem made of the routes (op is gone, the callback only needs @m) */
+	if (msg_client(m))
+		(void)SEND_REQ(msg_client(m), qmi_set_wms_get_routes_request(_m), set_default_storage_after_cb, m,
+			       WMS_TIMEOUT_MS);
+}
+
+/* the routes before the user's Set Routes (info log), then Set Routes */
+static void set_default_storage_before_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct mop *op = req->cb_data;
+	struct modem_messaging *m = op->m;
+	struct qmi_wms_get_routes_response res = {};
+
+	if (!msg || req->ret || qmi_parse_wms_get_routes_response(msg, &res))
+		modem_log(m->modem, LOGL_INFO, "SMS routes (before): couldn't get SMS routes: %s", msg_req_error_str(req));
+	else
+		log_routes(m, "before", &res);
+
+	if (send_set_routes(m, op->storage, set_default_storage_cb, op))
+		mop_done(op, MODEM_ERR_FAILED, "Couldn't set the default storage", NULL);
+}
+
+enum { SD_STORAGE, __SD_MAX };
+static const struct blobmsg_policy messaging_set_default_storage_policy[__SD_MAX] = {
+	[SD_STORAGE] = { .name = "storage", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 messaging_set_default_storage '{"storage": "sm"}' */
+static int modem_messaging_set_default_storage(struct ubus_context *ctx, struct ubus_object *obj,
+					       struct ubus_request_data *req, const char *method,
+					       struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_messaging *m = msg_of(modem);
+	struct blob_attr *tb[__SD_MAX];
+	enum sms_storage storage;
+	const char *name;
+	char text[100];
+	struct mop *op;
+
+	blobmsg_parse(messaging_set_default_storage_policy, __SD_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[SD_STORAGE])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	name = blobmsg_get_string(tb[SD_STORAGE]);
+
+	storage = sms_storage_from_name(name);
+	/* Check if the requested storage is supported or not */
+	if (storage == SMS_STORAGE_UNKNOWN || !msg_storage_supported(storage)) {
+		snprintf(text, sizeof(text), "Storage '%.20s' is not supported for storing", name);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_UNSUPPORTED, text);
+	}
+
+	if (!msg_client(m))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, messaging_not_enabled);
+
+	modem_log(modem, LOGL_INFO, "processing user request to set default storage '%s'...", sms_storage_name(storage));
+
+	op = mop_new(m, ctx, req, MOP_SET_DEFAULT_STORAGE, NULL);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	op->storage = storage;
+	if (SEND_REQ(msg_client(m), qmi_set_wms_get_routes_request(_m), set_default_storage_before_cb, op, WMS_TIMEOUT_MS))
+		mop_done(op, MODEM_ERR_FAILED, "Couldn't set the default storage", NULL);
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method modem_messaging_methods[] = {
+	UBUS_METHOD_NOARG("messaging_list", modem_messaging_list),
+	UBUS_METHOD("messaging_create", modem_messaging_create, messaging_create_policy),
+	UBUS_METHOD("messaging_delete", modem_messaging_delete, messaging_delete_policy),
+	UBUS_METHOD("messaging_set_default_storage", modem_messaging_set_default_storage,
+		    messaging_set_default_storage_policy),
+};
+
+const struct ubus_method *uqmid_messaging_modem_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_messaging_methods);
+	return modem_messaging_methods;
+}
+
+void uqmid_messaging_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	struct modem_messaging *m = msg_of(modem);
+	struct sms *sms;
+	unsigned int i;
+	void *a;
+
+	a = blobmsg_open_array(bb, "messages");
+	list_for_each_entry(sms, &m->smss, list)
+		blobmsg_add_string(bb, NULL, sms->ubus.name);
+	blobmsg_close_array(bb, a);
+
+	/* the storages which are allowed for both writing/sending and receiving */
+	a = blobmsg_open_array(bb, "supported_storages");
+	for (i = 0; i < ARRAY_SIZE(supported_storages); i++)
+		blobmsg_add_string(bb, NULL, sms_storage_name(supported_storages[i]));
+	blobmsg_close_array(bb, a);
+
+	blobmsg_add_string(bb, "default_storage", sms_storage_name(m->default_storage));
+}
+
+/*****************************************************************************/
+/* object life cycle */
+
+void uqmid_messaging_init(struct modem *modem)
+{
+	struct modem_messaging *m = talloc_zero(modem, struct modem_messaging);
+
+	if (!m)
+		return;
+
+	m->modem = modem;
+	INIT_LIST_HEAD(&m->smss);
+	INIT_LIST_HEAD(&m->ops);
+	modem->messaging = m;
+}
+
+/* MM: the WMS client is allocated with the other clients when the modem is initialized */
+void uqmid_messaging_probe(struct modem *modem)
+{
+	struct modem_messaging *m = msg_of(modem);
+
+	m->svc = uqmi_service_find(modem->qmi, QMI_SERVICE_WMS);
+	if (m->svc)
+		uqmi_service_ensure_client(m->svc);
+}
+
+/* the modem goes away: the user requests which wait are failed, the client is released by the close of the device */
+void uqmid_messaging_cleanup(struct modem *modem)
+{
+	struct modem_messaging *m = msg_of(modem);
+
+	if (!m)
+		return;
+
+	m->dying = true;
+
+	/* no callbacks of the queued requests anymore */
+	if (m->svc && uqmi_service_valid(modem->qmi, m->svc))
+		uqmi_service_cancel_requests(m->svc, QMI_ERROR_CANCELLED, false);
+	m->svc = NULL;
+
+	sms_ops_abort(m);
+	sms_list_clear(m);
+	m->active = false;
+}

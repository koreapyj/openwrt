+/* ICCIDs are 19 or 20 digits. Some operators use [A-F] in the operator specific part. */
+int uqmi_sim_decode_iccid(const uint8_t *bcd, unsigned int n, char *out, size_t out_len)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	unsigned int i, len = 0;
+
+	if (!n || out_len < n * 2 + 1)
+		return -EINVAL;
+
+	for (i = 0; i < n * 2; i++) {
+		uint8_t nib = (i & 1) ? bcd[i / 2] >> 4 : bcd[i / 2] & 0xf;
+
+		/* 0xF is the filler at the end */
+		if (nib == 0xf)

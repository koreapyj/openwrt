+	return qmi_set_uim_logical_channel_request(msg, &req);
+}
+
+static const struct ext_method m_uim_channel_close = {
+	.name = "uim_channel_close",
+	.service = QMI_SERVICE_UIM,
+	.change = true,
+	.timeout_ms = EXT_UIM_TIMEOUT_MS,
+	.what = "Close the logical channel",

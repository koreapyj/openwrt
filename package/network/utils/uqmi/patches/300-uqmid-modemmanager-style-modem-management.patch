+/*****************************************************************************/
+/* the voice methods of the modem object (MM: Modem.Voice) */
+
+static const char *const voice_not_enabled = "Modem is not enabled";
+
+/** ubus call uqmid.modem.0 voice_list_calls -> {"calls": ["uqmid.modem.0.call.0", ...]} */
+static int modem_voice_list_calls(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				  const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct call *c;
+	void *a;
+
+	modem_log(modem, LOGL_INFO, "processing user request to list voice calls...");
+
+	blob_buf_init(&b, 0);
+	a = blobmsg_open_array(&b, "calls");
+	list_for_each_entry(c, &v->calls, list)
+		blobmsg_add_string(&b, NULL, c->ubus.name);
+	blobmsg_close_array(&b, a);
+
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+enum { CC_NUMBER, __CC_MAX };
+static const struct blobmsg_policy create_call_policy[__CC_MAX] = {
+	[CC_NUMBER] = { .name = "number", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 voice_create_call '{"number": "114"}' -> {"path": "uqmid.modem.0.call.0"} */
+static int modem_voice_create_call(struct ubus_context *ctx, struct ubus_object *obj,
+				   struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct blob_attr *tb[__CC_MAX];
+	struct call *c;
+	const char *number = NULL;
+
+	blobmsg_parse(create_call_policy, __CC_MAX, tb, blob_data(msg), blob_len(msg));
+
+	/* Don't create CALL from properties if the number is missing */
+	if (!tb[CC_NUMBER] || !*(number = blobmsg_get_string(tb[CC_NUMBER])))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+					      "Cannot create call: mandatory parameter 'number' is missing");
+
+	/* deviation: the VOICE client is only there while the modem is enabled */
+	if (modem->mm_state < MODEM_STATE_ENABLED)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, voice_not_enabled);
+
+	if (v->n_calls >= MAX_CALLS)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED,
+					      "Cannot create call: too many calls, delete the terminated ones");
+
+	modem_log(modem, LOGL_INFO, "processing user request to create voice call...");
+
+	c = call_new(v, CALL_DIR_OUTGOING, number);
+	if (!c)
+		return UBUS_STATUS_NO_MEMORY;
+
+	if (call_export(c)) {
+		talloc_free(c);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_FAILED, "Couldn't publish the call");
+	}
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "path", c->ubus.name);
+	return ubus_send_reply(ctx, req, b.head);
+}
+
+enum { DC_PATH, __DC_MAX };
+static const struct blobmsg_policy delete_call_policy[__DC_MAX] = {
+	[DC_PATH] = { .name = "path", .type = BLOBMSG_TYPE_STRING },
+};
+
+/** ubus call uqmid.modem.0 voice_delete_call '{"path": "uqmid.modem.0.call.0"}' (a running call is hung up) */
+static int modem_voice_delete_call(struct ubus_context *ctx, struct ubus_object *obj,
+				   struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct blob_attr *tb[__DC_MAX];
+	struct qmi_service *svc;
+	struct call *c;
+	char text[PATH_LEN + 40];
+
+	blobmsg_parse(delete_call_policy, __DC_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[DC_PATH])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	c = call_find_by_path(v, blobmsg_get_string(tb[DC_PATH]));
+	if (!c) {
+		snprintf(text, sizeof(text), "No call found with path '%s'", blobmsg_get_string(tb[DC_PATH]));
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_NOT_FOUND, text);
+	}
+
+	modem_log(modem, LOGL_INFO, "processing user request to delete voice call %s...", c->ubus.name);
+
+	/* deviation: end a call which is not terminated yet, best effort and without waiting for the answer */
+	svc = voice_client(v);
+	if (svc && c->qmi_id && c->state != CALL_STATE_TERMINATED && c->state != CALL_STATE_UNKNOWN) {
+		struct qmi_voice_end_call_request er = {};
+
+		qmi_set(&er, call_id, c->qmi_id);
+		SEND_REQ(svc, qmi_set_voice_end_call_request(_m, &er), NULL, NULL, CALL_TIMEOUT_MS);
+	}
+
+	call_delete(c);
+
+	return UBUS_STATUS_OK;
+}
+
+/* the generic reply of the Manage Calls requests, the states of the calls follow like in MM */
+static void apply_ids(struct vop *op, enum call_state state, enum call_reason reason)
+{
+	unsigned int i;
+	struct call *c;
+
+	for (i = 0; i < op->n_ids; i++) {
+		c = call_find(op->v, op->ids[i]);
+		if (c)
+			call_change_state(c, state, reason);
+	}
+}
+
+static void manage_calls_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+	struct call *c;
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't process manage calls action");
+		return;
+	}
+
+	switch (op->kind) {
+	case VOP_HANGUP_ALL:
+		apply_ids(op, CALL_STATE_TERMINATED, CALL_REASON_TERMINATED);
+		break;
+	case VOP_HOLD_AND_ACCEPT:
+		apply_ids(op, CALL_STATE_HELD, CALL_REASON_UNKNOWN);
+		break;
+	case VOP_HANGUP_AND_ACCEPT:
+		apply_ids(op, CALL_STATE_TERMINATED, CALL_REASON_TERMINATED);
+		break;
+	case VOP_TRANSFER:
+		apply_ids(op, CALL_STATE_TERMINATED, CALL_REASON_TRANSFERRED);
+		break;
+	default:
+		break;
+	}
+
+	if (op->has_next && (op->kind == VOP_HOLD_AND_ACCEPT || op->kind == VOP_HANGUP_AND_ACCEPT)) {
+		c = call_find(op->v, op->next_id);
+		if (c)
+			call_change_state(c, CALL_STATE_ACTIVE, CALL_REASON_ACCEPTED);
+	}
+
+	vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+/* prepare_hangup_all_foreach() and the others: which calls are changed when the request worked */
+static void collect_calls(struct modem_voice *v, struct vop *op)
+{
+	struct call *c;
+
+	op->ids = talloc_zero_array(op, uint32_t, v->n_calls ? v->n_calls : 1);
+
+	list_for_each_entry(c, &v->calls, list) {
+		switch (op->kind) {
+		case VOP_HANGUP_ALL:
+			/* only the calls in progress: the waiting and held ones are terminated by the reports */
+			if (c->state == CALL_STATE_DIALING || c->state == CALL_STATE_RINGING_OUT ||
+			    c->state == CALL_STATE_RINGING_IN || c->state == CALL_STATE_ACTIVE)
+				op->ids[op->n_ids++] = c->index;
+			break;
+		case VOP_HOLD_AND_ACCEPT:
+		case VOP_HANGUP_AND_ACCEPT:
+			if (c->state == CALL_STATE_ACTIVE) {
+				op->ids[op->n_ids++] = c->index;
+			} else if (c->state == CALL_STATE_WAITING) {
+				op->next_id = c->index;
+				op->has_next = true;
+			} else if (c->state == CALL_STATE_HELD && !op->has_next) {
+				op->next_id = c->index;
+				op->has_next = true;
+			}
+			break;
+		case VOP_TRANSFER:
+			if (c->state == CALL_STATE_ACTIVE || c->state == CALL_STATE_HELD)
+				op->ids[op->n_ids++] = c->index;
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+static int voice_manage_calls(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			      enum vop_kind kind, uint8_t service_type, const char *what)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct qmi_service *svc = voice_client(v);
+	struct qmi_voice_manage_calls_request mr = {};
+	struct vop *op;
+
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, voice_not_enabled);
+
+	modem_log(modem, LOGL_INFO, "processing user request to %s...", what);
+
+	op = vop_new(v, ctx, req, kind, 0);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	collect_calls(v, op);
+
+	qmi_set(&mr, service_type, service_type);
+	if (SEND_REQ(svc, qmi_set_voice_manage_calls_request(_m, &mr), manage_calls_cb, op, MANAGE_TIMEOUT_MS))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't process manage calls action", NULL);
+
+	return UBUS_STATUS_OK;
+}
+
+/** ubus call uqmid.modem.0 voice_hangup_all */
+static int modem_voice_hangup_all(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				  const char *method, struct blob_attr *msg)
+{
+	return voice_manage_calls(ctx, obj, req, VOP_HANGUP_ALL, QMI_SUPS_END_ALL_CALLS, "hangup all voice calls");
+}
+
+/** ubus call uqmid.modem.0 voice_hold_and_accept */
+static int modem_voice_hold_and_accept(struct ubus_context *ctx, struct ubus_object *obj,
+				       struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	return voice_manage_calls(ctx, obj, req, VOP_HOLD_AND_ACCEPT, QMI_SUPS_HOLD_ACTIVE_ACCEPT_WAITING_OR_HELD,
+				  "hold and accept voice call");
+}
+
+/** ubus call uqmid.modem.0 voice_hangup_and_accept */
+static int modem_voice_hangup_and_accept(struct ubus_context *ctx, struct ubus_object *obj,
+					 struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	return voice_manage_calls(ctx, obj, req, VOP_HANGUP_AND_ACCEPT, QMI_SUPS_RELEASE_ACTIVE_ACCEPT_HELD_OR_WAITING,
+				  "hangup and accept voice call");
+}
+
+/** ubus call uqmid.modem.0 voice_transfer */
+static int modem_voice_transfer(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+				const char *method, struct blob_attr *msg)
+{
+	return voice_manage_calls(ctx, obj, req, VOP_TRANSFER, QMI_SUPS_EXPLICIT_CALL_TRANSFER,
+				  "transfer voice call");
+}
+
+static void cw_setup_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't setup call waiting");
+		return;
+	}
+
+	vop_done(op, MODEM_ERR_NONE, NULL, NULL);
+}
+
+enum { CW_ENABLE, __CW_MAX };
+static const struct blobmsg_policy call_waiting_setup_policy[__CW_MAX] = {
+	[CW_ENABLE] = { .name = "enable", .type = BLOBMSG_TYPE_BOOL },
+};
+
+/** ubus call uqmid.modem.0 voice_call_waiting_setup '{"enable": true}' */
+static int modem_voice_call_waiting_setup(struct ubus_context *ctx, struct ubus_object *obj,
+					  struct ubus_request_data *req, const char *method,
+					  struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct blob_attr *tb[__CW_MAX];
+	struct qmi_service *svc;
+	struct qmi_voice_set_supplementary_service_request sr = {};
+	struct vop *op;
+
+	blobmsg_parse(call_waiting_setup_policy, __CW_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[CW_ENABLE])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	svc = voice_client(v);
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, voice_not_enabled);
+
+	modem_log(modem, LOGL_INFO, "processing user request to setup call waiting...");
+
+	op = vop_new(v, ctx, req, VOP_CW_SETUP, 0);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	sr.set.supplementary_service_information = 1;
+	sr.data.supplementary_service_information.supplementary_service_action =
+		blobmsg_get_bool(tb[CW_ENABLE]) ? QMI_SUPS_ACTION_ACTIVATE : QMI_SUPS_ACTION_DEACTIVATE;
+	sr.data.supplementary_service_information.supplementary_service_reason = QMI_SUPS_REASON_CALL_WAITING;
+	/* MM: 30 s */
+	if (SEND_REQ(svc, qmi_set_voice_set_supplementary_service_request(_m, &sr), cw_setup_cb, op, 30000))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't setup call waiting", NULL);
+
+	return UBUS_STATUS_OK;
+}
+
+/* SupplementaryServiceInformationClass of mm-broadband-modem-qmi.c */
+#define CLASS_VOICE 0x01
+#define CLASS_FAX 0x04
+#define CLASS_SMS 0x08
+#define CLASS_DATACIRCUITSYNC 0x10
+
+static void cw_query_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct vop *op = req->cb_data;
+	struct qmi_voice_get_call_waiting_response res = {};
+	struct blob_buf rb = {};
+	bool status;
+	uint8_t class;
+
+	if (!msg || req->ret) {
+		vop_fail_req(op, req, "Couldn't query call waiting");
+		return;
+	}
+
+	qmi_parse_voice_get_call_waiting_response(msg, &res);
+	if (!res.set.service_class) {
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't get call waiting service class", NULL);
+		return;
+	}
+
+	class = res.data.service_class;
+	status = class == CLASS_VOICE || class == (CLASS_VOICE | CLASS_FAX | CLASS_SMS) ||
+		 class == (CLASS_VOICE | CLASS_FAX) || class == (CLASS_DATACIRCUITSYNC | CLASS_VOICE);
+
+	blob_buf_init(&rb, 0);
+	blobmsg_add_u8(&rb, "status", status);
+	vop_done(op, MODEM_ERR_NONE, NULL, rb.head);
+	blob_buf_free(&rb);
+}
+
+/** ubus call uqmid.modem.0 voice_call_waiting_query -> {"status": true} */
+static int modem_voice_call_waiting_query(struct ubus_context *ctx, struct ubus_object *obj,
+					  struct ubus_request_data *req, const char *method,
+					  struct blob_attr *msg)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct modem_voice *v = mv(modem);
+	struct qmi_service *svc = voice_client(v);
+	struct qmi_voice_get_call_waiting_request qr = {};
+	struct vop *op;
+
+	if (!svc)
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_WRONG_STATE, voice_not_enabled);
+
+	modem_log(modem, LOGL_INFO, "processing user request to query call waiting...");
+
+	op = vop_new(v, ctx, req, VOP_CW_QUERY, 0);
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	/* MM: 30 s */
+	if (SEND_REQ(svc, qmi_set_voice_get_call_waiting_request(_m, &qr), cw_query_cb, op, 30000))
+		vop_done(op, MODEM_ERR_FAILED, "Couldn't query call waiting", NULL);
+
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method modem_voice_methods[] = {
+	UBUS_METHOD_NOARG("voice_list_calls", modem_voice_list_calls),
+	UBUS_METHOD("voice_create_call", modem_voice_create_call, create_call_policy),
+	UBUS_METHOD("voice_delete_call", modem_voice_delete_call, delete_call_policy),
+	UBUS_METHOD_NOARG("voice_hangup_all", modem_voice_hangup_all),
+	UBUS_METHOD_NOARG("voice_hold_and_accept", modem_voice_hold_and_accept),
+	UBUS_METHOD_NOARG("voice_hangup_and_accept", modem_voice_hangup_and_accept),
+	UBUS_METHOD_NOARG("voice_transfer", modem_voice_transfer),
+	UBUS_METHOD("voice_call_waiting_setup", modem_voice_call_waiting_setup, call_waiting_setup_policy),
+	UBUS_METHOD_NOARG("voice_call_waiting_query", modem_voice_call_waiting_query),
+};
+
+const struct ubus_method *uqmid_voice_modem_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_voice_methods);
+	return modem_voice_methods;
+}
+
+void uqmid_voice_add_properties(struct modem *modem, struct blob_buf *bb)
+{
+	struct modem_voice *v = mv(modem);
+	struct call *c;
+	void *a;
+
+	a = blobmsg_open_array(bb, "calls");
+	list_for_each_entry(c, &v->calls, list)
+		blobmsg_add_string(bb, NULL, c->ubus.name);
+	blobmsg_close_array(bb, a);
+
+	/* If the modem is REGISTERED, we allow any kind of call, otherwise only emergency calls */
+	blobmsg_add_u8(bb, "emergency_only", modem->mm_state < MODEM_STATE_REGISTERED);
+}
+
+/*****************************************************************************/
+/* enable and disable (MM: mm_iface_modem_voice_enable() / _disable(), the QMI unsolicited events) */
+
+struct voice_toggle {
+	struct modem_voice *v;
+	void (*done)(struct modem *modem, void *data);
+	void *data;
+};
+
+static void voice_register_indications(struct modem_voice *v)
+{
+	uqmi_service_register_indication(v->svc, VOICE_IND_ALL_CALL_STATUS, all_call_status_ind, v);
+	uqmi_service_register_indication(v->svc, VOICE_IND_SUPPLEMENTARY_SERVICE, supplementary_service_ind, v);
+}
+
+/* disable: only the indications are unregistered, the client stays (MM never releases it before the modem is gone) */
+static void voice_deactivate(struct modem_voice *v)
+{
+	struct qmi_service *svc = v->svc;
+
+	v->enabled = false;
+	if (svc && uqmi_service_valid(v->modem->qmi, svc)) {
+		uqmi_service_remove_indication(svc, VOICE_IND_ALL_CALL_STATUS, all_call_status_ind, v);
+		uqmi_service_remove_indication(svc, VOICE_IND_SUPPLEMENTARY_SERVICE, supplementary_service_ind, v);
+	}
+}
+
+static void voice_toggle_finish(struct voice_toggle *t)
+{
+	void (*done)(struct modem *modem, void *data) = t->done;
+	void *data = t->data;
+	struct modem *modem = t->v->modem;
+
+	talloc_free(t);
+	done(modem, data);
+}
+
+static void enable_register_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct voice_toggle *t = req->cb_data;
+	struct modem_voice *v = t->v;
+
+	if (!msg || req->ret) {
+		/* MM: couldn't enable the voice interface, only a warning. No call state without the indications. */
+		modem_log(v->modem, LOGL_NOTICE, "couldn't register voice call indications: %s, voice not available",
+			  req_error_str(req));
+		voice_deactivate(v);
+	} else {
+		modem_log(v->modem, LOGL_DEBUG, "voice call indications registered");
+	}
+
+	voice_toggle_finish(t);
+}
+
+void uqmid_voice_enable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_voice *v = mv(modem);
+	struct voice_toggle *t;
+	struct qmi_voice_indication_register_request rr = {};
+
+	t = talloc_zero(v, struct voice_toggle);
+	t->v = v;
+	t->done = done;
+	t->data = data;
+
+	if (v->enabled) {
+		/* already enabled */
+		voice_toggle_finish(t);
+		return;
+	}
+
+	if (!v->svc || !uqmi_service_valid(modem->qmi, v->svc)) {
+		modem_log(modem, LOGL_NOTICE, "the VOICE service is not available, voice not supported");
+		voice_toggle_finish(t);
+		return;
+	}
+
+	v->dying = false;
+	v->enabled = true;
+	voice_register_indications(v);
+
+	/* common_voice_enable_disable_unsolicited_events(): call and supplementary service notifications */
+	qmi_set(&rr, call_notification_events, true);
+	qmi_set(&rr, supplementary_service_notification_events, true);
+	if (SEND_REQ(v->svc, qmi_set_voice_indication_register_request(_m, &rr), enable_register_cb, t,
+		     REGISTER_TIMEOUT_MS)) {
+		modem_log(modem, LOGL_NOTICE, "couldn't send the voice indication registration, voice not available");
+		voice_deactivate(v);
+		voice_toggle_finish(t);
+	}
+}
+
+static void disable_register_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct voice_toggle *t = req->cb_data;
+
+	if (!msg || req->ret)
+		modem_log(t->v->modem, LOGL_DEBUG, "couldn't unregister voice call indications: %s",
+			  req_error_str(req));
+
+	voice_deactivate(t->v);
+	voice_toggle_finish(t);
+}
+
+void uqmid_voice_disable(struct modem *modem, void (*done)(struct modem *modem, void *data), void *data)
+{
+	struct modem_voice *v = mv(modem);
+	struct voice_toggle *t;
+	struct qmi_voice_indication_register_request rr = {};
+
+	t = talloc_zero(v, struct voice_toggle);
+	t->v = v;
+	t->done = done;
+	t->data = data;
+
+	if (!voice_client(v)) {
+		voice_deactivate(v);
+		voice_toggle_finish(t);
+		return;
+	}
+
+	qmi_set(&rr, call_notification_events, false);
+	qmi_set(&rr, supplementary_service_notification_events, false);
+	if (SEND_REQ(v->svc, qmi_set_voice_indication_register_request(_m, &rr), disable_register_cb, t,
+		     REGISTER_TIMEOUT_MS)) {
+		voice_deactivate(v);
+		voice_toggle_finish(t);
+	}
+}
+
+/*****************************************************************************/
+/* object life cycle */
+
+void uqmid_voice_init(struct modem *modem)
+{
+	struct modem_voice *v = talloc_zero(modem, struct modem_voice);
+
+	if (!v)
+		return;
+
+	v->modem = modem;
+	INIT_LIST_HEAD(&v->calls);
+	INIT_LIST_HEAD(&v->ops);
+	modem->voice = v;
+}
+
+/* MM: the VOICE client is allocated with the other clients when the modem is initialized */
+void uqmid_voice_probe(struct modem *modem)
+{
+	struct modem_voice *v = mv(modem);
+
+	v->svc = uqmi_service_find(modem->qmi, QMI_SERVICE_VOICE);
+	if (v->svc)
+		uqmi_service_ensure_client(v->svc);
+}
+
+/* the modem goes away: the user requests which wait are failed, the client is released by the close of the device */
+void uqmid_voice_cleanup(struct modem *modem)
+{
+	struct modem_voice *v = mv(modem);
+	struct vop *op, *optmp;
+	struct call *c, *ctmp;
+
+	if (!v)
+		return;
+
+	v->dying = true;
+
+	/* no callbacks of the queued requests anymore: the contexts are freed here */
+	if (v->svc && uqmi_service_valid(modem->qmi, v->svc))
+		uqmi_service_cancel_requests(v->svc, QMI_ERROR_CANCELLED, false);
+	v->svc = NULL;
+	v->enabled = false;
+
+	list_for_each_entry_safe(op, optmp, &v->ops, list)
+		vop_done(op, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+
+	list_for_each_entry_safe(c, ctmp, &v->calls, list) {
+		if (c->ubus.id)
+			ubus_remove_object(ubus_ctx, &c->ubus);
+		list_del(&c->list);
+		talloc_free(c);
+	}
+	v->n_calls = 0;
+}

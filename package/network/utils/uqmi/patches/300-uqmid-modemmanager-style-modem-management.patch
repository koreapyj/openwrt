+++ b/uqmid/pdc.c
@@ -0,0 +1,900 @@
+/*
+ * uqmid -- PDC carrier configuration methods (MCFG/MBN files of the modem)
+ *
+ * A uqmid extension: ModemManager has no public PDC methods, it only reads the active configuration
+ * (Modem.CarrierConfiguration, see carrier_config.c) and selects/activates one by itself in
+ * mm-shared-qmi.c (mm_shared_qmi_set_carrier_config: Set Selected Config, then Activate Config; the modem
+ * resets afterwards). These methods are NV writing operator actions, nothing here is ever run automatically.
+ *
+ * The logic is the one of the uqmi command line tool (uqmi/commands-pdc.c): the results of PDC requests come
+ * as indications carrying the token of the request, multi-step operations are driven by them.
+ *
+ *  pdc_list        Get Selected Config, List Configs, Get Config Info per configuration (one request each)
+ *  pdc_selected    Get Selected Config
+ *  pdc_load        Load Config in chunks of 512 bytes (the SMD transport of the SoC modem drops QMUX messages
+ *                  of 1 KiB and more); each chunk is confirmed by an indication. The id of the configuration
+ *                  is the SHA1 of the whole file (like qmicli)
+ *  pdc_activate    Set Selected Config (indication), then Activate Config. The modem resets to apply the
+ *                  configuration: once the activation was requested (indication or silence for 10 s) or the
+ *                  modem went away the request is a success
+ *  pdc_deactivate  Deactivate Config (indication)
+ *  pdc_delete      Delete Config (the response is the result)
+ *
+ * All of them are user requests serialized per modem (the operation lock). Modem states: all of them need the
+ * modem to be at least disabled; loading, activating, deactivating and deleting additionally need that no
+ * data connection is up or being changed (connecting, connected, disconnecting).
+ *
+ * The carrier_configuration properties are refreshed after load, delete and deactivate. After an activation
+ * the modem resets and reads them again when it is probed.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/utils.h>
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "pdc-util.h"
+#include "pdc.h"
+#include "qmi-enums.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sim_obj.h"
+#include "ubus.h"
+#include "utils.h"
+
+/* the time to wait for each indication */
+#define PDC_IND_TIMEOUT_MS 10000
+#define PDC_LOAD_SIZE_MAX (16 * 1024 * 1024)
+
+enum {
+	PDC_IND_GET_SELECTED_CONFIG = 0x22,
+	PDC_IND_SET_SELECTED_CONFIG = 0x23,
+	PDC_IND_LIST_CONFIGS = 0x24,
+	PDC_IND_LOAD_CONFIG = 0x26,
+	PDC_IND_ACTIVATE_CONFIG = 0x27,
+	PDC_IND_GET_CONFIG_INFO = 0x28,
+	PDC_IND_DEACTIVATE_CONFIG = 0x2b,
+};
+
+static const uint16_t pdc_inds[] = {
+	PDC_IND_GET_SELECTED_CONFIG, PDC_IND_SET_SELECTED_CONFIG, PDC_IND_LIST_CONFIGS, PDC_IND_LOAD_CONFIG,
+	PDC_IND_ACTIVATE_CONFIG, PDC_IND_GET_CONFIG_INFO, PDC_IND_DEACTIVATE_CONFIG,
+};
+
+enum pdc_kind {
+	PDC_LIST,
+	PDC_SELECTED,
+	PDC_LOAD,
+	PDC_ACTIVATE,
+	PDC_DEACTIVATE,
+	PDC_DELETE,
+};
+
+enum pdc_step {
+	STEP_SELECTED,
+	STEP_LIST,
+	STEP_INFO,
+	STEP_LOAD,
+	STEP_SET_SELECTED,
+	STEP_ACTIVATE,
+	STEP_DEACTIVATE,
+	STEP_DELETE,
+};
+
+struct pdc_id {
+	uint8_t id[PDC_ID_MAX];
+	unsigned int n;
+};
+
+struct pdc_config {
+	struct pdc_id id;
+	char *description;
+	uint32_t version;
+	uint32_t size;
+};
+
+struct pdc_op {
+	struct modem *modem;
+	struct modem_op *op;
+	struct qmi_service *svc;
+	enum pdc_kind kind;
+	enum pdc_step step;
+	uint32_t type;
+	/* token of the request which is waited for */
+	uint32_t token;
+	struct uloop_timeout timer;
+
+	/* argument (activate, delete) or the id of a loaded configuration */
+	struct pdc_id id;
+
+	/* finished, waiting for the deferred completion */
+	bool done;
+	enum modem_error err;
+	char *msg;
+	/* refresh the carrier_configuration properties afterwards */
+	bool refresh;
+
+	/* selected configuration (list, selected) */
+	struct pdc_id active;
+	struct pdc_id pending;
+
+	/* list */
+	struct pdc_config *configs;
+	unsigned int n_configs;
+	unsigned int cur;
+
+	/* load */
+	char *file;
+	uint8_t *data;
+	size_t size;
+	size_t offset;
+	unsigned int chunks;
+};
+
+/* tokens of the other users of the PDC client (carrier_config.c) are small */
+static uint32_t pdc_token = 0x1000;
+
+static struct blob_buf b;
+
+static int pdc_type_from_attr(struct blob_attr *attr, uint32_t *type)
+{
+	*type = QMI_PDC_CONFIGURATION_TYPE_SOFTWARE;
+	if (!attr)
+		return 0;
+
+	return pdc_type_parse(blobmsg_get_string(attr), type) ? 0 : -1;
+}
+
+/*****************************************************************************/
+/* ids */
+
+static void pdc_id_set(struct pdc_id *id, const uint8_t *data, unsigned int n)
+{
+	id->n = 0;
+	if (n && n <= PDC_ID_MAX) {
+		memcpy(id->id, data, n);
+		id->n = n;
+	}
+}
+
+static void pdc_id_add(const char *name, const struct pdc_id *id)
+{
+	char str[PDC_ID_STR_MAX];
+
+	if (pdc_id_format(id->id, id->n, str))
+		blobmsg_add_string(&b, name, str);
+}
+
+/*****************************************************************************/
+/* completion */
+
+static void pdc_remove_indications(struct pdc_op *p);
+
+static int pdc_destructor(struct pdc_op *p)
+{
+	uloop_timeout_cancel(&p->timer);
+	pdc_remove_indications(p);
+	if (p->modem->pdc_ctx == p)
+		p->modem->pdc_ctx = NULL;
+
+	return 0;
+}
+
+static void pdc_ind(struct qmi_service *service, struct qmi_msg *msg, void *data);
+
+static void pdc_remove_indications(struct pdc_op *p)
+{
+	unsigned int i;
+
+	if (!p->svc || !p->modem->qmi || !uqmi_service_valid(p->modem->qmi, p->svc))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(pdc_inds); i++)
+		uqmi_service_remove_indication(p->svc, pdc_inds[i], pdc_ind, p);
+}
+
+/* add the data of the result to the reply of the request */
+static void pdc_set_result(struct pdc_op *p)
+{
+	struct modem *modem = p->modem;
+
+	talloc_free(modem->op_result);
+	modem->op_result = talloc_memdup(modem, b.head, blob_pad_len(b.head));
+}
+
+static void pdc_finish_cb(struct uloop_timeout *t)
+{
+	struct pdc_op *p = container_of(t, struct pdc_op, timer);
+	struct modem *modem = p->modem;
+	bool refresh = p->refresh && !p->err;
+	struct modem_op *op = p->op;
+
+	pdc_remove_indications(p);
+
+	/* frees p */
+	uqmid_modem_op_done(op, p->err, p->msg);
+
+	if (refresh && !modem->dying)
+		uqmid_carrier_config_load(modem);
+}
+
+/*
+ * Finish. Done later (not from the callback of an indication or a response): the service is walking its
+ * lists and the op owns this context.
+ */
+static void pdc_finish(struct pdc_op *p, enum modem_error err, const char *msg)
+{
+	if (p->done)
+		return;
+
+	p->done = true;
+	p->err = err;
+	if (msg) {
+		modem_log(p->modem, err ? LOGL_NOTICE : LOGL_INFO, "pdc %s: %s", err ? "failed" : "done", msg);
+		p->msg = talloc_strdup(p, msg);
+	}
+	p->timer.cb = pdc_finish_cb;
+	uloop_timeout_set(&p->timer, 0);
+}
+
+static void pdc_fail(struct pdc_op *p, const char *why)
+{
+	pdc_finish(p, MODEM_ERR_FAILED, why);
+}
+
+/*****************************************************************************/
+/* results */
+
+static void pdc_result_list(struct pdc_op *p)
+{
+	unsigned int i;
+	void *a, *t;
+
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "type", pdc_type_name(p->type));
+	a = blobmsg_open_array(&b, "configs");
+	for (i = 0; i < p->n_configs; i++) {
+		struct pdc_config *cfg = &p->configs[i];
+		bool active = pdc_id_equal(cfg->id.id, cfg->id.n, p->active.id, p->active.n);
+		bool pending = pdc_id_equal(cfg->id.id, cfg->id.n, p->pending.id, p->pending.n);
+
+		t = blobmsg_open_table(&b, NULL);
+		pdc_id_add("id", &cfg->id);
+		blobmsg_add_string(&b, "description", cfg->description ? cfg->description : "");
+		blobmsg_printf(&b, "version", "%08X", cfg->version);
+		blobmsg_add_u32(&b, "total_size", cfg->size);
+		blobmsg_add_u8(&b, "active", active);
+		/* the selected one is the one which becomes active, else the active one */
+		blobmsg_add_u8(&b, "selected", p->pending.n ? pending : active);
+		blobmsg_add_u8(&b, "pending", pending);
+		blobmsg_close_table(&b, t);
+	}
+	blobmsg_close_array(&b, a);
+	pdc_set_result(p);
+}
+
+static void pdc_result_selected(struct pdc_op *p)
+{
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "type", pdc_type_name(p->type));
+	/* a missing key is "none" */
+	if (p->pending.n)
+		pdc_id_add("selected", &p->pending);
+	else if (p->active.n)
+		pdc_id_add("selected", &p->active);
+	if (p->active.n)
+		pdc_id_add("active", &p->active);
+	if (p->pending.n)
+		pdc_id_add("pending", &p->pending);
+	pdc_set_result(p);
+}
+
+static void pdc_result_id(struct pdc_op *p, const char *status)
+{
+	blob_buf_init(&b, 0);
+	blobmsg_add_string(&b, "type", pdc_type_name(p->type));
+	if (p->id.n)
+		pdc_id_add("id", &p->id);
+	if (p->kind == PDC_LOAD)
+		blobmsg_add_u32(&b, "size", p->size);
+	if (status)
+		blobmsg_add_string(&b, "status", status);
+	pdc_set_result(p);
+}
+
+/*****************************************************************************/
+/* requests */
+
+static void pdc_timeout_cb(struct uloop_timeout *t);
+static void pdc_arm(struct pdc_op *p)
+{
+	p->timer.cb = pdc_timeout_cb;
+	uloop_timeout_set(&p->timer, PDC_IND_TIMEOUT_MS);
+}
+
+static void pdc_req_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct pdc_op *p = modem->pdc_ctx;
+
+	if (!p || p->done)
+		return;
+
+	if (!msg || req->ret) {
+		/* the modem restarts while it applies a configuration */
+		if (modem->dying)
+			return;
+		pdc_fail(p, qmi_get_error_str(req->ret));
+		return;
+	}
+
+	/* the result of everything but the deletion comes as an indication */
+	if (p->step == STEP_DELETE) {
+		modem_log(modem, LOGL_INFO, "deleted the %s configuration", pdc_type_name(p->type));
+		pdc_result_id(p, NULL);
+		pdc_finish(p, MODEM_ERR_NONE, NULL);
+	}
+}
+
+#define PDC_SEND(p, name, ...)                                                                                         \
+	({                                                                                                             \
+		struct qmi_msg *_msg;                                                                                  \
+		struct qmi_request *_req = uqmi_request_alloc((p)->svc, &_msg, pdc_req_cb, (p)->modem, 0);             \
+		struct qmi_pdc_##name##_request _r = { __VA_ARGS__ };                                                  \
+		int _ret = -ENOMEM;                                                                                    \
+                                                                                                                       \
+		(p)->token = ++pdc_token;                                                                              \
+		_r.set.token = 1;                                                                                      \
+		_r.data.token = (p)->token;                                                                            \
+		if (_req) {                                                                                            \
+			if (qmi_set_pdc_##name##_request(_msg, &_r)) {                                                 \
+				talloc_free(_req);                                                                     \
+				_ret = -EINVAL;                                                                        \
+			} else {                                                                                       \
+				_ret = uqmi_service_send_msg((p)->svc, _req);                                          \
+			}                                                                                              \
+		}                                                                                                      \
+		_ret;                                                                                                  \
+	})
+
+static void pdc_send_done(struct pdc_op *p, int ret, const char *what)
+{
+	if (ret) {
+		char text[64];
+
+		snprintf(text, sizeof(text), "couldn't send %s", what);
+		pdc_fail(p, text);
+		return;
+	}
+
+	pdc_arm(p);
+}
+
+static void pdc_request_selected(struct pdc_op *p)
+{
+	p->step = STEP_SELECTED;
+	pdc_send_done(p, PDC_SEND(p, get_selected_config, QMI_INIT(config_type, p->type)), "Get Selected Config");
+}
+
+static void pdc_request_list(struct pdc_op *p)
+{
+	p->step = STEP_LIST;
+	pdc_send_done(p, PDC_SEND(p, list_configs, QMI_INIT(config_type, p->type)), "List Configs");
+}
+
+static void pdc_request_info(struct pdc_op *p)
+{
+	struct pdc_config *cfg = &p->configs[p->cur];
+
+	p->step = STEP_INFO;
+	pdc_send_done(p, PDC_SEND(p, get_config_info,
+				  QMI_INIT_SEQUENCE(type_with_id_v2, .config_type = p->type, .id_n = cfg->id.n,
+						    .id = cfg->id.id)),
+		      "Get Config Info");
+}
+
+static void pdc_request_chunk(struct pdc_op *p)
+{
+	size_t len = p->size - p->offset;
+
+	if (len > PDC_LOAD_CHUNK_SIZE)
+		len = PDC_LOAD_CHUNK_SIZE;
+
+	p->step = STEP_LOAD;
+	modem_log(p->modem, LOGL_DEBUG, "pdc load: sending %zu bytes at offset %zu of %zu (chunk %u)", len, p->offset,
+		  p->size, p->chunks + 1);
+	/* the offset is advanced before the response: the indication tells what the modem wants next */
+	if (PDC_SEND(p, load_config,
+		     QMI_INIT_SEQUENCE(config_chunk, .type = p->type, .id_n = p->id.n, .id = p->id.id,
+				       .total_size = p->size, .chunk_n = len, .chunk = p->data + p->offset))) {
+		pdc_fail(p, "couldn't send Load Config");
+		return;
+	}
+	p->offset += len;
+	p->chunks++;
+	pdc_arm(p);
+}
+
+static void pdc_request_set_selected(struct pdc_op *p)
+{
+	p->step = STEP_SET_SELECTED;
+	pdc_send_done(p, PDC_SEND(p, set_selected_config,
+				  QMI_INIT_SEQUENCE(type_with_id_v2, .config_type = p->type, .id_n = p->id.n,
+						    .id = p->id.id)),
+		      "Set Selected Config");
+}
+
+static void pdc_request_activate(struct pdc_op *p)
+{
+	p->step = STEP_ACTIVATE;
+	/* the modem restarts to apply the configuration, a request which loses its modem was a success */
+	p->op->gone_ok = true;
+	pdc_send_done(p, PDC_SEND(p, activate_config, QMI_INIT(config_type, p->type)), "Activate Config");
+}
+
+/*****************************************************************************/
+/* indications */
+
+#define PDC_PARSE(p, name, res)                                                                                        \
+	({                                                                                                             \
+		memset(&(res), 0, sizeof(res));                                                                        \
+		qmi_parse_pdc_##name##_indication(msg, &(res)) || !pdc_token_valid((res).set.token, (res).data.token, (p)->token); \
+	})
+
+/* returns true (and fails the operation) if the indication reports an error */
+static bool pdc_ind_failed(struct pdc_op *p, bool set, uint16_t result, bool allow_not_provisioned)
+{
+	if (!pdc_result_failed(set, result, allow_not_provisioned))
+		return false;
+
+	pdc_fail(p, qmi_get_error_str(result));
+	return true;
+}
+
+static void pdc_ind_selected(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_get_selected_config_indication res;
+
+	if (PDC_PARSE(p, get_selected_config, res) || p->step != STEP_SELECTED)
+		return;
+	/* not provisioned: nothing is selected yet */
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, true))
+		return;
+
+	pdc_id_set(&p->active, res.data.active_id, res.data.active_id_n);
+	pdc_id_set(&p->pending, res.data.pending_id, res.data.pending_id_n);
+	modem_log(p->modem, LOGL_DEBUG, "pdc: %s configuration, %s active, %s pending", pdc_type_name(p->type),
+		  p->active.n ? "an" : "no", p->pending.n ? "one" : "none");
+
+	if (p->kind == PDC_LIST) {
+		pdc_request_list(p);
+		return;
+	}
+
+	pdc_result_selected(p);
+	pdc_finish(p, MODEM_ERR_NONE, NULL);
+}
+
+static void pdc_ind_list(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_list_configs_indication res;
+	unsigned int i;
+
+	if (PDC_PARSE(p, list_configs, res) || p->step != STEP_LIST)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	p->configs = talloc_zero_array(p, struct pdc_config, res.data.configs_n ? res.data.configs_n : 1);
+	if (!p->configs) {
+		pdc_fail(p, "out of memory");
+		return;
+	}
+
+	for (i = 0; i < res.data.configs_n; i++) {
+		if (res.data.configs[i].id_n > PDC_ID_MAX) {
+			pdc_fail(p, "configuration id too long");
+			return;
+		}
+		pdc_id_set(&p->configs[i].id, res.data.configs[i].id, res.data.configs[i].id_n);
+	}
+	p->n_configs = res.data.configs_n;
+	modem_log(p->modem, LOGL_DEBUG, "pdc: %u %s configurations", p->n_configs, pdc_type_name(p->type));
+
+	if (!p->n_configs) {
+		pdc_result_list(p);
+		pdc_finish(p, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	p->cur = 0;
+	pdc_request_info(p);
+}
+
+static void pdc_ind_info(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_get_config_info_indication res;
+	struct pdc_config *cfg;
+
+	if (PDC_PARSE(p, get_config_info, res) || p->step != STEP_INFO)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	cfg = &p->configs[p->cur];
+	cfg->size = res.data.total_size;
+	cfg->version = res.data.version;
+	if (res.data.description)
+		cfg->description = talloc_strdup(p, res.data.description);
+
+	if (++p->cur < p->n_configs) {
+		pdc_request_info(p);
+		return;
+	}
+
+	pdc_result_list(p);
+	pdc_finish(p, MODEM_ERR_NONE, NULL);
+}
+
+static void pdc_ind_load(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_load_config_indication res;
+
+	if (PDC_PARSE(p, load_config, res) || p->step != STEP_LOAD)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	if (res.set.frame_reset && res.data.frame_reset) {
+		pdc_fail(p, "frame reset requested by the modem");
+		return;
+	}
+
+	if (!res.set.remaining_size) {
+		pdc_fail(p, "invalid Load Config indication");
+		return;
+	}
+
+	modem_log(p->modem, LOGL_DEBUG, "pdc load: modem received %u, remaining %u", res.set.received ? res.data.received : 0,
+		  res.data.remaining_size);
+
+	if (res.data.remaining_size) {
+		if (p->offset >= p->size) {
+			pdc_fail(p, "the modem expects more data than the file contains");
+			return;
+		}
+
+		pdc_request_chunk(p);
+		return;
+	}
+
+	modem_log(p->modem, LOGL_INFO, "loaded %zu bytes in %u chunks", p->size, p->chunks);
+	pdc_result_id(p, NULL);
+	pdc_finish(p, MODEM_ERR_NONE, NULL);
+}
+
+static void pdc_ind_set_selected(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_set_selected_config_indication res;
+
+	if (PDC_PARSE(p, set_selected_config, res) || p->step != STEP_SET_SELECTED)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	pdc_request_activate(p);
+}
+
+static void pdc_ind_activate(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_activate_config_indication res;
+
+	if (PDC_PARSE(p, activate_config, res) || p->step != STEP_ACTIVATE)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	modem_log(p->modem, LOGL_INFO, "activation of the %s configuration requested", pdc_type_name(p->type));
+	pdc_result_id(p, "activation-requested");
+	pdc_finish(p, MODEM_ERR_NONE, NULL);
+}
+
+static void pdc_ind_deactivate(struct pdc_op *p, struct qmi_msg *msg)
+{
+	struct qmi_pdc_deactivate_config_indication res;
+
+	if (PDC_PARSE(p, deactivate_config, res) || p->step != STEP_DEACTIVATE)
+		return;
+	if (pdc_ind_failed(p, res.set.indication_result, res.data.indication_result, false))
+		return;
+
+	modem_log(p->modem, LOGL_INFO, "deactivation of the %s configuration requested", pdc_type_name(p->type));
+	pdc_result_id(p, "deactivation-requested");
+	pdc_finish(p, MODEM_ERR_NONE, NULL);
+}
+
+static void pdc_ind(struct qmi_service *service, struct qmi_msg *msg, void *data)
+{
+	struct pdc_op *p = data;
+
+	if (p->done)
+		return;
+
+	switch (le16_to_cpu(msg->svc.message)) {
+	case PDC_IND_GET_SELECTED_CONFIG:
+		pdc_ind_selected(p, msg);
+		break;
+	case PDC_IND_LIST_CONFIGS:
+		pdc_ind_list(p, msg);
+		break;
+	case PDC_IND_GET_CONFIG_INFO:
+		pdc_ind_info(p, msg);
+		break;
+	case PDC_IND_LOAD_CONFIG:
+		pdc_ind_load(p, msg);
+		break;
+	case PDC_IND_SET_SELECTED_CONFIG:
+		pdc_ind_set_selected(p, msg);
+		break;
+	case PDC_IND_ACTIVATE_CONFIG:
+		pdc_ind_activate(p, msg);
+		break;
+	case PDC_IND_DEACTIVATE_CONFIG:
+		pdc_ind_deactivate(p, msg);
+		break;
+	}
+}
+
+static void pdc_timeout_cb(struct uloop_timeout *t)
+{
+	struct pdc_op *p = container_of(t, struct pdc_op, timer);
+
+	if (p->done)
+		return;
+
+	/* no configuration stored: the modem does not send any indication */
+	if (p->step == STEP_LIST) {
+		pdc_result_list(p);
+		pdc_finish(p, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	/* the modem restarts to apply the configuration, the indication might never arrive */
+	if (p->step == STEP_ACTIVATE) {
+		modem_log(p->modem, LOGL_INFO, "no indication of the activation, assuming it was requested");
+		pdc_result_id(p, "activation-requested");
+		pdc_finish(p, MODEM_ERR_NONE, NULL);
+		return;
+	}
+
+	pdc_finish(p, MODEM_ERR_TIMEOUT, "timed out waiting for the modem");
+}
+
+/*****************************************************************************/
+/* operation start (the op got its turn) */
+
+static bool pdc_state_ok(struct modem *modem, bool write)
+{
+	if (modem->mm_state < MODEM_STATE_DISABLED)
+		return false;
+
+	if (write && modem->mm_state >= MODEM_STATE_DISCONNECTING)
+		return false;
+
+	return true;
+}
+
+static int pdc_load_file(struct pdc_op *p)
+{
+	FILE *f = fopen(p->file, "rb");
+	long size;
+
+	if (!f)
+		return -1;
+
+	if (fseek(f, 0, SEEK_END) || (size = ftell(f)) <= 0 || size > PDC_LOAD_SIZE_MAX || fseek(f, 0, SEEK_SET)) {
+		fclose(f);
+		return -2;
+	}
+
+	p->data = talloc_size(p, size);
+	if (!p->data || fread(p->data, 1, size, f) != (size_t)size) {
+		fclose(f);
+		return -3;
+	}
+	fclose(f);
+
+	p->size = size;
+	return 0;
+}
+
+static void pdc_start(struct modem_op *op)
+{
+	struct pdc_op *p = op->priv;
+	struct modem *modem = p->modem;
+	bool write = p->kind != PDC_LIST && p->kind != PDC_SELECTED;
+
+	if (!pdc_state_ok(modem, write)) {
+		uqmid_modem_op_done(op, MODEM_ERR_WRONG_STATE,
+				    write ? "The modem has to be disabled or enabled, without a data connection"
+					  : "The modem has to be at least disabled");
+		return;
+	}
+
+	p->svc = uqmi_service_find(modem->qmi, QMI_SERVICE_PDC);
+	if (!p->svc) {
+		uqmid_modem_op_done(op, MODEM_ERR_UNSUPPORTED, "The modem has no PDC service");
+		return;
+	}
+
+	/* one context per modem (the op lock already guarantees it) */
+	if (modem->pdc_ctx) {
+		uqmid_modem_op_done(op, MODEM_ERR_IN_PROGRESS, NULL);
+		return;
+	}
+	modem->pdc_ctx = p;
+
+	switch (p->kind) {
+	case PDC_LIST:
+	case PDC_SELECTED:
+		break;
+	case PDC_LOAD:
+		switch (pdc_load_file(p)) {
+		case -1:
+			uqmid_modem_op_done(op, MODEM_ERR_FAILED, "Couldn't open the file");
+			return;
+		case -2:
+			uqmid_modem_op_done(op, MODEM_ERR_INVALID_ARGS, "Invalid file size");
+			return;
+		case -3:
+			uqmid_modem_op_done(op, MODEM_ERR_FAILED, "Couldn't read the file");
+			return;
+		}
+		/* the id of the configuration is the SHA1 of the file (like qmicli) */
+		p->id.n = pdc_id_from_file(p->id.id, p->data, p->size);
+		break;
+	default:
+		break;
+	}
+
+	uqmi_service_register_indication(p->svc, PDC_IND_GET_SELECTED_CONFIG, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_SET_SELECTED_CONFIG, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_LIST_CONFIGS, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_LOAD_CONFIG, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_ACTIVATE_CONFIG, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_GET_CONFIG_INFO, pdc_ind, p);
+	uqmi_service_register_indication(p->svc, PDC_IND_DEACTIVATE_CONFIG, pdc_ind, p);
+
+	modem_log(modem, LOGL_INFO, "processing user request to pdc %d (%s configuration)...", p->kind,
+		  pdc_type_name(p->type));
+
+	switch (p->kind) {
+	case PDC_LIST:
+	case PDC_SELECTED:
+		pdc_request_selected(p);
+		break;
+	case PDC_LOAD:
+		modem_log(modem, LOGL_INFO, "pdc load: %zu bytes from '%s'", p->size, p->file);
+		pdc_request_chunk(p);
+		break;
+	case PDC_ACTIVATE:
+		pdc_request_set_selected(p);
+		break;
+	case PDC_DEACTIVATE:
+		p->step = STEP_DEACTIVATE;
+		op->gone_ok = true;
+		pdc_send_done(p, PDC_SEND(p, deactivate_config, QMI_INIT(config_type, p->type)),
+			      "Deactivate Config");
+		break;
+	case PDC_DELETE:
+		p->step = STEP_DELETE;
+		pdc_send_done(p, PDC_SEND(p, delete_config, QMI_INIT(config_type, p->type),
+					  QMI_INIT_PTR(id, p->id.id), .data.id_n = p->id.n),
+			      "Delete Config");
+		break;
+	}
+}
+
+static int pdc_submit(struct modem *modem, struct ubus_request_data *req,
+		      enum pdc_kind kind, uint32_t type, const struct pdc_id *id, const char *file)
+{
+	struct modem_op *op = uqmid_modem_op_alloc(modem, req, pdc_start);
+	struct pdc_op *p;
+
+	if (!op)
+		return UBUS_STATUS_NO_MEMORY;
+
+	p = talloc_zero(op, struct pdc_op);
+	p->modem = modem;
+	p->op = op;
+	p->kind = kind;
+	p->type = type;
+	p->refresh = kind == PDC_LOAD || kind == PDC_DELETE;
+	if (id)
+		p->id = *id;
+	if (file)
+		p->file = talloc_strdup(p, file);
+	talloc_set_destructor(p, pdc_destructor);
+	op->priv = p;
+	uqmid_modem_op_submit(op);
+
+	return UBUS_STATUS_OK;
+}
+
+/*****************************************************************************/
+/* ubus */
+
+enum { P_TYPE, P_ID, P_FILE, __P_MAX };
+static const struct blobmsg_policy pdc_type_policy[__P_MAX] = {
+	[P_TYPE] = { .name = "type", .type = BLOBMSG_TYPE_STRING },
+};
+static const struct blobmsg_policy pdc_id_policy[__P_MAX] = {
+	[P_TYPE] = { .name = "type", .type = BLOBMSG_TYPE_STRING },
+	[P_ID] = { .name = "id", .type = BLOBMSG_TYPE_STRING },
+};
+static const struct blobmsg_policy pdc_file_policy[__P_MAX] = {
+	[P_TYPE] = { .name = "type", .type = BLOBMSG_TYPE_STRING },
+	[P_FILE] = { .name = "file", .type = BLOBMSG_TYPE_STRING },
+};
+
+static int pdc_method(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		      struct blob_attr *msg, const struct blobmsg_policy *policy, enum pdc_kind kind)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[__P_MAX];
+	struct pdc_id id = {};
+	const char *file = NULL;
+	uint32_t type;
+
+	blobmsg_parse(policy, __P_MAX, tb, blob_data(msg), blob_len(msg));
+	if (pdc_type_from_attr(tb[P_TYPE], &type))
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "type has to be software or platform");
+
+	if (policy == pdc_id_policy) {
+		if (!tb[P_ID] || !pdc_id_parse(blobmsg_get_string(tb[P_ID]), id.id, &id.n))
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS,
+						      "id has to be a hex string");
+	} else if (policy == pdc_file_policy) {
+		if (!tb[P_FILE] || !*blobmsg_get_string(tb[P_FILE]))
+			return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, "file is required");
+		file = blobmsg_get_string(tb[P_FILE]);
+	}
+
+	return pdc_submit(modem, req, kind, type, &id, file);
+}
+
+#define PDC_HANDLER(name, policy, kind)                                                                                \
+	static int modem_##name(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,    \
+				const char *method, struct blob_attr *msg)                                           \
+	{                                                                                                              \
+		return pdc_method(ctx, obj, req, msg, policy, kind);                                                   \
+	}
+
+PDC_HANDLER(pdc_list, pdc_type_policy, PDC_LIST)
+PDC_HANDLER(pdc_selected, pdc_type_policy, PDC_SELECTED)
+PDC_HANDLER(pdc_load, pdc_file_policy, PDC_LOAD)
+PDC_HANDLER(pdc_activate, pdc_id_policy, PDC_ACTIVATE)
+PDC_HANDLER(pdc_deactivate, pdc_type_policy, PDC_DEACTIVATE)
+PDC_HANDLER(pdc_delete, pdc_id_policy, PDC_DELETE)
+
+static const struct ubus_method modem_pdc_methods[] = {
+	UBUS_METHOD("pdc_list", modem_pdc_list, pdc_type_policy),
+	UBUS_METHOD("pdc_selected", modem_pdc_selected, pdc_type_policy),
+	UBUS_METHOD("pdc_load", modem_pdc_load, pdc_file_policy),
+	UBUS_METHOD("pdc_activate", modem_pdc_activate, pdc_id_policy),
+	UBUS_METHOD("pdc_deactivate", modem_pdc_deactivate, pdc_type_policy),
+	UBUS_METHOD("pdc_delete", modem_pdc_delete, pdc_id_policy),
+};
+
+const struct ubus_method *uqmid_pdc_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_pdc_methods);
+	return modem_pdc_methods;
+}

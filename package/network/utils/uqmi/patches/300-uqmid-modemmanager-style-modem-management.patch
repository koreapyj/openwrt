+void uqmid_modem_shutdown_all(void)
+{
+	struct modem *modem;
+
+	shutting_down = true;
+	list_for_each_entry(modem, &uqmid_modems, list)
+		uqmid_modem_remove(modem, true);
+
+	if (list_empty(&uqmid_modems))
+		uloop_end();

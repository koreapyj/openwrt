+static void m3_notify_registration(struct modem_3gpp *m, enum reg_state old)
+{
+	struct modem *modem = m->modem;
+	struct blob_buf nb = {};
+
+	if (!modem->ubus.id)
+		return;
+
+	blob_buf_init(&nb, 0);
+	blobmsg_add_string(&nb, "old", reg_state_name(old));
+	blobmsg_add_string(&nb, "new", reg_state_name(m->state));
+	blobmsg_add_string(&nb, "operator_code", m->operator_code ? m->operator_code : "");
+	blobmsg_add_string(&nb, "operator_name", m->operator_name ? m->operator_name : "");
+	ubus_notify(ubus_ctx, &modem->ubus, "registration_state_changed", nb.head, -1);
+	blob_buf_free(&nb);
+}

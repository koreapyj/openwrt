+#ifndef __UQMID_MESSAGING_PRIV_H
+#define __UQMID_MESSAGING_PRIV_H
+
+/* shared by messaging.c (the interface) and sms.c (the SMS objects) */
+
+#include <errno.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/list.h>
+#include <libubus.h>
+#include <talloc.h>
+
+#include "logging.h"
+#include "modem.h"
+#include "qmi-errors.h"
+#include "qmi-message.h"
+#include "services.h"
+#include "sms_part.h"
+#include "ubus.h"
+#include "utils.h"
+
+/* mm-iface-modem-messaging.c and mm-sms-qmi.c: 5 s (list, delete, write, set routes), 3 s (raw read) */
+#define WMS_TIMEOUT_MS 5000
+#define WMS_READ_TIMEOUT_MS 3000
+/* MM_BASE_SMS_DEFAULT_SEND_TIMEOUT */
+#define WMS_SEND_TIMEOUT_MS (5 * 60 * 1000)
+/* uqmid: the SMS objects are limited, a modem could be flooded with SMS */
+#define MAX_SMS 512
+
+/* MMSmsState (the numeric values are the same) */
+enum sms_state {
+	SMS_STATE_UNKNOWN = 0,
+	SMS_STATE_STORED = 1,
+	SMS_STATE_RECEIVING = 2,
+	SMS_STATE_RECEIVED = 3,
+	SMS_STATE_SENDING = 4,
+	SMS_STATE_SENT = 5,
+};
+
+/* MMSmsStorage (the numeric values are the same). Only sm and me are supported by QMI. */
+enum sms_storage {
+	SMS_STORAGE_UNKNOWN = 0,
+	SMS_STORAGE_SM = 1,
+	SMS_STORAGE_ME = 2,
+	SMS_STORAGE_MT = 3,
+	SMS_STORAGE_SR = 4,
+	SMS_STORAGE_BM = 5,
+	SMS_STORAGE_TA = 6,
+};
+
+struct modem_messaging;
+
+/* mm-base-sms.c */
+struct sms {
+	struct list_head list;
+	struct modem_messaging *m;
+	struct ubus_object ubus;
+	/* the number in the object name */
+	uint32_t index;
+	enum sms_state state;
+	enum sms_storage storage;
+	enum sms_pdu_type pdu_type;
+	char *number;
+	char *smsc;
+	char *text;
+	uint8_t *data;
+	size_t data_len;
+	char *timestamp;
+	char *discharge_timestamp;
+	/* -1 if not used */
+	int class;
+	/* relative validity in minutes, 0 if unknown */
+	unsigned int validity;
+	bool delivery_report_request;
+	unsigned int message_reference;
+	unsigned int delivery_state;
+	/* multipart */
+	bool multipart;
+	unsigned int max_parts;
+	unsigned int multipart_reference;
+	/* text and data are complete */
+	bool assembled;
+	/* the parts, sorted by the concat sequence */
+	struct sms_part *parts;
+	unsigned int n_parts;
+	/* a send, store or delete is running */
+	bool busy;
+};
+
+struct modem_messaging {
+	struct modem *modem;
+	/* the WMS client: allocated when the modem is initialized, kept until the modem goes away (NULL if the
+	 * modem has no WMS service) */
+	struct qmi_service *svc;
+	bool dying;
+	/* MM: the SMS list exists (from the enable until the disable) */
+	bool active;
+	/* MM: default-storage, UNKNOWN until Get Routes or the enable chose one */
+	enum sms_storage default_storage;
+	bool default_storage_known;
+	/* newest first like the SMS list of MM */

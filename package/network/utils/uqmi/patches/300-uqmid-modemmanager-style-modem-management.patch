+/*****************************************************************************/
+/* requests */
+
+static int ext_destructor(struct ext_ctx *x)
+{
+	if (!list_empty(&x->list))
+		list_del_init(&x->list);
+	if (x->modem->ext_cur == x)
+		x->modem->ext_cur = NULL;
+
+	return 0;
+}
+
+/* the context of the request in flight; NULL if it was finished (the modem went away) */
+static struct ext_ctx *ext_find(struct modem *modem, struct qmi_request *req)
+{
+	struct ext_ctx *x;
+
+	if (modem->ext_cur && modem->ext_cur->qreq == req)
+		return modem->ext_cur;
+	list_for_each_entry(x, &modem->ext_reads, list) {
+		if (x->qreq == req)
+			return x;
+	}
+
+	return NULL;
+}
+
+/* frees x */
+static void ext_finish(struct ext_ctx *x, enum modem_error err, const char *msg)
+{
+	struct modem *modem = x->modem;
+
+	if (x->op) {
+		/* the data is added to the reply of the operation (pdc.c) */
+		if (!err && b.head && blob_len(b.head)) {
+			talloc_free(modem->op_result);
+			modem->op_result = talloc_memdup(modem, b.head, blob_pad_len(b.head));
+		}
+		/* frees x */
+		uqmid_modem_op_done(x->op, err, msg);
+		return;
+	}
+
+	list_del_init(&x->list);
+	uqmid_ubus_deferred_done(&x->req, err, msg, err ? NULL : b.head);
+	talloc_free(x);
+}
+
+static void ext_req_cb(struct qmi_service *service, struct qmi_request *req, struct qmi_msg *msg)
+{
+	struct modem *modem = req->cb_data;
+	struct ext_ctx *x = ext_find(modem, req);
+	const struct ext_method *m;
+	static char text[160];
+
+	if (!x)
+		return;
+
+	m = x->m;
+	x->qreq = NULL;
+	blob_buf_init(&b, 0);
+	if (!msg || req->ret) {
+		bool timeout = req->ret == UQMID_ERROR_TIMEOUT;
+
+		modem_log(modem, LOGL_NOTICE, "%s: %s failed: %d/%s", m->name, m->what, req->ret,
+			  timeout ? "timed out" : qmi_get_error_str(req->ret));
+		snprintf(text, sizeof(text), "%s failed: %s", m->what, timeout ? "timed out" : qmi_get_error_str(req->ret));
+		ext_finish(x, timeout ? MODEM_ERR_TIMEOUT : MODEM_ERR_FAILED, text);
+		return;
+	}
+	if (m->result && m->result(msg, &x->a, &b)) {
+		modem_log(modem, LOGL_NOTICE, "%s: couldn't parse the response", m->name);
+		snprintf(text, sizeof(text), "%s failed: invalid response", m->what);
+		ext_finish(x, MODEM_ERR_FAILED, text);
+		return;
+	}
+
+	modem_log(modem, LOGL_INFO, "%s: done", m->name);
+	ext_finish(x, MODEM_ERR_NONE, NULL);
+}
+
+/* the service of a method, NULL if the modem has none */
+static struct qmi_service *ext_service(struct modem *modem, const struct ext_method *m)
+{
+	if (!modem->qmi || modem->dying)
+		return NULL;
+	if (m->service == QMI_SERVICE_CTL)
+		return modem->qmi->ctrl;
+
+	return uqmi_service_find(modem->qmi, m->service);
+}
+
+/* the checks of a request; the error is returned with its message */
+static enum modem_error ext_check(struct modem *modem, const struct ext_method *m, struct qmi_service **svc,
+				  const char **msg)
+{
+	*svc = ext_service(modem, m);
+	if (!*svc) {
+		/* the services are known once the modem was probed */
+		if (modem->dying || modem->mm_state <= MODEM_STATE_INITIALIZING) {
+			*msg = "Modem is not probed yet";
+			return MODEM_ERR_WRONG_STATE;
+		}
+		*msg = "Operation not supported by the modem";
+		return MODEM_ERR_UNSUPPORTED;
+	}
+	if (m->no_data_session && modem->mm_state >= MODEM_STATE_DISCONNECTING) {
+		*msg = "Not possible while a data connection is being set up, is up or is being torn down";
+		return MODEM_ERR_WRONG_STATE;
+	}
+
+	return MODEM_ERR_NONE;
+}
+
+/* encode and queue; 0 if the callback is going to be called (x may be finished already) */
+static int ext_queue(struct ext_ctx *x, struct qmi_service *svc)
+{
+	struct qmi_request *qreq;
+	struct qmi_msg *msg;
+	int ret;
+
+	qreq = uqmi_request_alloc(svc, &msg, ext_req_cb, x->modem, x->m->timeout_ms);
+	if (!qreq)
+		return -ENOMEM;
+	if (x->m->encode(msg, &x->a)) {
+		talloc_free(qreq);
+		return -EINVAL;
+	}
+
+	x->qreq = qreq;
+	ret = uqmi_service_send_msg(svc, qreq);
+	if (ret)
+		x->qreq = NULL;
+
+	return ret;
+}
+
+static void ext_queue_failed(struct ext_ctx *x)
+{
+	static char text[96];
+
+	snprintf(text, sizeof(text), "%s failed: couldn't send the request", x->m->what);
+	blob_buf_init(&b, 0);
+	ext_finish(x, MODEM_ERR_FAILED, text);
+}
+
+static void ext_op_start(struct modem_op *op)
+{
+	struct ext_ctx *x = op->priv;
+	struct modem *modem = op->modem;
+	struct qmi_service *svc;
+	const char *msg;
+	enum modem_error err = ext_check(modem, x->m, &svc, &msg);
+
+	/* the state is evaluated when the request gets its turn */
+	if (err) {
+		uqmid_modem_op_done(op, err, msg);
+		return;
+	}
+
+	modem_log(modem, LOGL_INFO, "processing user request %s...", x->m->name);
+	modem->ext_cur = x;
+	if (ext_queue(x, svc))
+		ext_queue_failed(x);
+}
+
+static int ext_call(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+		    struct blob_attr *msg, const struct ext_method *m)
+{
+	struct modem *modem = container_of(obj, struct modem, ubus);
+	struct blob_attr *tb[EXT_MAX_POLICY] = {};
+	struct qmi_service *svc;
+	struct ext_ctx *x;
+	const char *err_msg = NULL;
+	enum modem_error err;
+
+	if (m->n_policy)
+		blobmsg_parse(m->policy, m->n_policy, tb, blob_data(msg), blob_len(msg));
+
+	x = talloc_zero(modem, struct ext_ctx);
+	if (!x)
+		return UBUS_STATUS_NO_MEMORY;
+	INIT_LIST_HEAD(&x->list);
+	x->modem = modem;
+	x->m = m;
+	talloc_set_destructor(x, ext_destructor);
+
+	if (m->parse && m->parse(modem, tb, &x->a, &err_msg)) {
+		talloc_free(x);
+		return uqmid_ubus_reply_error(ctx, req, MODEM_ERR_INVALID_ARGS, err_msg);
+	}
+
+	err = ext_check(modem, m, &svc, &err_msg);
+	if (err) {
+		talloc_free(x);
+		return uqmid_ubus_reply_error(ctx, req, err, err_msg);
+	}
+
+	if (m->change) {
+		struct modem_op *op = uqmid_modem_op_alloc(modem, req, ext_op_start);
+
+		if (!op) {
+			talloc_free(x);
+			return UBUS_STATUS_NO_MEMORY;
+		}
+		talloc_steal(op, x);
+		x->op = op;
+		op->priv = x;
+		uqmid_modem_op_submit(op);
+		return UBUS_STATUS_OK;
+	}
+
+	modem_log(modem, LOGL_INFO, "processing user request %s...", m->name);
+	list_add_tail(&x->list, &modem->ext_reads);
+	ubus_defer_request(ctx, req, &x->req);
+	if (ext_queue(x, svc))
+		ext_queue_failed(x);
+
+	return UBUS_STATUS_OK;
+}
+
+#define EXT_HANDLER(id)                                                                                        \
+	static int h_##id(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,   \
+			  const char *method, struct blob_attr *msg)                                           \
+	{                                                                                                      \
+		return ext_call(ctx, obj, req, msg, &m_##id);                                                  \
+	}
+
+EXT_HANDLER(dms_get_versions)
+EXT_HANDLER(nas_get_tx_rx_info)
+EXT_HANDLER(nas_get_lte_cphy_ca_info)
+EXT_HANDLER(uim_get_sim_state)
+EXT_HANDLER(uim_power_off)
+EXT_HANDLER(uim_power_on)
+EXT_HANDLER(uim_channel_open)
+EXT_HANDLER(uim_channel_close)
+EXT_HANDLER(uim_apdu_send)
+EXT_HANDLER(nas_get_network_roaming)
+EXT_HANDLER(nas_set_network_roaming)
+EXT_HANDLER(wda_get_data_format)
+EXT_HANDLER(wda_set_data_format)
+EXT_HANDLER(ctl_set_data_format)
+EXT_HANDLER(wds_set_autoconnect)
+EXT_HANDLER(wms_get_raw_message)
+EXT_HANDLER(voice_burst_dtmf)
+EXT_HANDLER(dms_fcc_auth)
+
+static const struct ubus_method modem_ext_methods[] = {
+	UBUS_METHOD_NOARG("dms_get_versions", h_dms_get_versions),
+	UBUS_METHOD("nas_get_tx_rx_info", h_nas_get_tx_rx_info, radio_policy),
+	UBUS_METHOD_NOARG("nas_get_lte_cphy_ca_info", h_nas_get_lte_cphy_ca_info),
+	UBUS_METHOD_NOARG("uim_get_sim_state", h_uim_get_sim_state),
+	UBUS_METHOD("uim_power_off", h_uim_power_off, uim_slot_policy),
+	UBUS_METHOD("uim_power_on", h_uim_power_on, uim_slot_policy),
+	UBUS_METHOD("uim_channel_open", h_uim_channel_open, uim_open_policy),
+	UBUS_METHOD("uim_channel_close", h_uim_channel_close, uim_close_policy),
+	UBUS_METHOD("uim_apdu_send", h_uim_apdu_send, uim_apdu_policy),
+	UBUS_METHOD_NOARG("nas_get_network_roaming", h_nas_get_network_roaming),
+	UBUS_METHOD("nas_set_network_roaming", h_nas_set_network_roaming, roaming_policy),
+	UBUS_METHOD_NOARG("wda_get_data_format", h_wda_get_data_format),
+	UBUS_METHOD("wda_set_data_format", h_wda_set_data_format, wda_set_policy),
+	UBUS_METHOD("ctl_set_data_format", h_ctl_set_data_format, ctl_set_policy),
+	UBUS_METHOD("wds_set_autoconnect", h_wds_set_autoconnect, autoconnect_policy),
+	UBUS_METHOD("wms_get_raw_message", h_wms_get_raw_message, raw_msg_policy),
+	UBUS_METHOD("voice_burst_dtmf", h_voice_burst_dtmf, burst_policy),
+	UBUS_METHOD_NOARG("dms_fcc_auth", h_dms_fcc_auth),
+};
+
+const struct ubus_method *uqmid_ext_ubus_methods(unsigned int *n)
+{
+	*n = ARRAY_SIZE(modem_ext_methods);
+	return modem_ext_methods;
+}
+
+void uqmid_ext_init(struct modem *modem)
+{
+	INIT_LIST_HEAD(&modem->ext_reads);
+}
+
+/* the modem goes away: the callbacks of the requests in flight are not called, the reads are failed here (the
+ * change operation is failed by the operation queue) */
+void uqmid_ext_cleanup(struct modem *modem)
+{
+	struct ext_ctx *x, *tmp;
+
+	list_for_each_entry_safe(x, tmp, &modem->ext_reads, list) {
+		list_del_init(&x->list);
+		uqmid_ubus_deferred_done(&x->req, MODEM_ERR_ABORTED, modem_error_message(MODEM_ERR_ABORTED), NULL);
+		talloc_free(x);
+	}
+}

+static void op_set_power_start(struct modem_op *op)
+{
+	struct modem *modem = op->modem;
+	enum modem_state state = modem->mm_state;
+
+	/* Going into LOW is allowed even when enabled or connected, the modem will
+	 * automatically transition to disabled state in that case. */
+	if (op->power == MODEM_POWER_LOW && state > MODEM_STATE_DISABLED) {
+		modem_log(modem, LOGL_INFO, "will automatically disable after setting low-power mode");
+		op->disable_after_update = true;
+	}

+static int put_utf8(char *out, size_t out_len, size_t *pos, uint32_t cp)
+{
+	char tmp[4];
+	int l;
+
+	if (cp < 0x80) {
+		tmp[0] = cp;
+		l = 1;
+	} else if (cp < 0x800) {
+		tmp[0] = 0xc0 | (cp >> 6);
+		tmp[1] = 0x80 | (cp & 0x3f);
+		l = 2;
+	} else {
+		tmp[0] = 0xe0 | (cp >> 12);
+		tmp[1] = 0x80 | ((cp >> 6) & 0x3f);
+		tmp[2] = 0x80 | (cp & 0x3f);
+		l = 3;
+	}
+
+	if (*pos + l + 1 > out_len)
+		return -ENOMEM;
+
+	memcpy(out + *pos, tmp, l);
+	*pos += l;
+	return 0;
+}
+
+/*
+ * First byte is the display condition, the rest is the name in the GSM 7 bit
+ * default alphabet (unpacked) with 0xFF as filler. TS 31.102 allows UCS2
+ * (leading 0x80) as well.
+ */
+int uqmi_sim_decode_spn(const uint8_t *ef_spn, unsigned int n, char *out, size_t out_len)
+{
+	size_t pos = 0;
+	unsigned int i;
+
+	if (!out_len)
+		return -EINVAL;
+
+	while (n > 1 && ef_spn[n - 1] == 0xff)
+		n--;
+	if (n <= 1)
+		return -ENODATA;
+
+	if (ef_spn[1] == 0x80) {
+		for (i = 2; i + 1 < n; i += 2) {
+			uint32_t cp = (ef_spn[i] << 8) | ef_spn[i + 1];
+
+			if (cp == 0xffff)
+				break;
+			if (put_utf8(out, out_len, &pos, cp))
+				return -ENOMEM;
+		}
+	} else {
+		for (i = 1; i < n; i++) {
+			if (put_utf8(out, out_len, &pos, gsm7_default[ef_spn[i] & 0x7f]))
+				return -ENOMEM;
+		}
+	}
+	out[pos] = 0;
+
+	return pos;
+}

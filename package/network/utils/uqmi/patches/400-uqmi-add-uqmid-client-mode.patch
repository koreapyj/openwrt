+/* the profile id argument "3gpp,<idx>" */
+static int ub_profile_arg(const char *arg, uint32_t *index)
+{
+	int ret = uqmi_ub_parse_profile_id(arg, index);
+
+	if (ret == UB_MAP_NA)
+		return ub_fail("3gpp2 profiles: not available with --uqmid");
+	if (ret)
+		return ub_fail("Invalid argument");
+	return 0;
+}

+int uqmi_ub_opmode_to_power(const char *mode, const char **power)
+{
+	if (!strcmp(mode, "online")) {
+		*power = "on";
+		return 0;
+	}
+	if (!strcmp(mode, "low_power") || !strcmp(mode, "persistent_low_power") ||
+	    !strcmp(mode, "mode_only_low_power")) {
+		*power = "low";
+		return 0;
+	}
+	if (!strcmp(mode, "offline")) {
+		*power = "off";
+		return 0;
+	}
+	if (!strcmp(mode, "reset"))
+		return 1;
+	if (!strcmp(mode, "factory_test") || !strcmp(mode, "shutting_down"))
+		return UB_MAP_NA;
+
+	return UB_MAP_INVALID;
+}

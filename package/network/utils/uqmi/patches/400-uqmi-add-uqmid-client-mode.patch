+bool uqmi_ub_path_index(const char *path, const char *kind, uint32_t *index)
+{
+	char key[32];
+	const char *p;
+	char *end;
+	unsigned long val;
+
+	if (!path)
+		return false;
+	snprintf(key, sizeof(key), ".%s.", kind);
+	p = strstr(path, key);
+	if (!p)
+		return false;
+	p += strlen(key);
+	if (!isdigit((unsigned char) *p))
+		return false;
+	val = strtoul(p, &end, 10);
+	if (*end)
+		return false;
+	*index = val;
+	return true;
+}

+/*****************************************************************************/
+/* the commands */
+
+struct ub_cmd {
+	const char *name;
+	int (*fn)(char *arg);
+};
+
+/* the names of the options and commands of the command line; not in the table: not available */
+static const struct ub_cmd ub_cmds[] = {
+	{ "get-versions", cmd_get_versions },
+	{ "set-data-format", cmd_ctl_set_data_format },
+

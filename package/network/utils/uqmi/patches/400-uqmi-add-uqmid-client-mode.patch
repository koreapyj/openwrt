+static const struct ub_cmd *ub_find_cmd(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(ub_cmds) / sizeof(ub_cmds[0]); i++) {
+		if (!strcmp(ub_cmds[i].name, name))
+			return &ub_cmds[i];
+	}
+	return NULL;
+}
+
+/* the options first, then the commands, like the direct mode; stops at the first failure */
+static bool ub_run_commands(bool options)
+{
+	const struct uqmi_cmd *cmds;
+	unsigned int n, i;
+
+	cmds = uqmi_get_commands(&n);
+	for (i = 0; i < n; i++) {
+		const struct ub_cmd *cmd;
+		bool is_option = cmds[i].handler->type == CMD_TYPE_OPTION;
+		int res;
+
+		if (is_option != options)
+			continue;
+
+		blob_buf_init(&status, 0);
+		cmd = ub_find_cmd(cmds[i].handler->name);
+		res = cmd ? cmd->fn(cmds[i].arg) : ub_na(cmds[i].handler->name);
+		ub_print_result();
+		if (res)
+			return false;
+	}
+
+	return true;
+}
+
+int uqmi_ubus_run(const char *device, long timeout_ms)
+{
+	bool ok;
+
+	G.timeout = timeout_ms > 0 && timeout_ms < INT_MAX ? timeout_ms : UB_DEFAULT_TIMEOUT_MS;
+
+	G.ctx = ubus_connect(NULL);
+	if (!G.ctx) {
+		fprintf(stderr, "Failed to connect to ubus\n");
+		return 2;
+	}
+
+	if (ub_select_modem(device)) {
+		ub_print_result();
+		ubus_free(G.ctx);
+		return 2;
+	}
+	if (ubus_lookup_id(G.ctx, G.modem, &G.modem_id)) {
+		ub_fail("%s: object not found", G.modem);
+		ub_print_result();
+		ubus_free(G.ctx);
+		return 2;
+	}
+
+	ok = ub_run_commands(true) && ub_run_commands(false);
+	if (ok) {
+		blob_buf_init(&status, 0);
+		ok = !ub_run_pending_selection();
+		ub_print_result();
+	}
+
+	blob_buf_free(&args);
+	ubus_free(G.ctx);
+
+	return ok ? 0 : -1;
+}

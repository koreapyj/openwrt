+static int cmd_network_scan(char *arg)
+{
+	static const struct {
+		const char *uqmid;
+		const char *cli;
+	} stat_map[] = {
+		{ "current", "current_serving" }, { "available", "available" }, { "forbidden", "forbidden" },
+	};
+	struct blob_attr *r, *nets, *net, *tech;
+	unsigned int i, mcc, mnc;
+	size_t rem, rem2;
+	void *t, *c, *info, *stat;
+
+	if (ub_modem("scan", NULL, &r))
+		return -1;
+
+	nets = jget(r, "networks");
+	t = blobmsg_open_table(&status, NULL);
+	c = blobmsg_open_array(&status, "network_info");
+	blobmsg_for_each_attr(net, nets, rem) {
+		const char *code = jstr(net, "operator_code"), *desc = jstr(net, "operator_long"), *st = jstr(net, "status");
+
+		if (!code || !uqmi_ub_plmn_split(code, &mcc, &mnc))
+			continue;
+		info = blobmsg_open_table(&status, NULL);
+		blobmsg_add_u32(&status, "mcc", mcc);
+		blobmsg_add_u32(&status, "mnc", mnc);
+		if (desc && *desc)
+			blobmsg_add_string(&status, "description", desc);
+		stat = blobmsg_open_array(&status, "status");
+		for (i = 0; st && i < sizeof(stat_map) / sizeof(stat_map[0]); i++) {
+			if (!strcmp(st, stat_map[i].uqmid))
+				blobmsg_add_string(&status, NULL, stat_map[i].cli);
+		}
+		blobmsg_close_array(&status, stat);
+		blobmsg_close_table(&status, info);
+	}
+	blobmsg_close_array(&status, c);
+
+	c = blobmsg_open_array(&status, "radio_access_technology");
+	blobmsg_for_each_attr(net, nets, rem) {
+		const char *code = jstr(net, "operator_code");
+
+		if (!code || !uqmi_ub_plmn_split(code, &mcc, &mnc))
+			continue;
+		blobmsg_for_each_attr(tech, jget(net, "access_technology"), rem2) {
+			const char *radio = blobmsg_type(tech) == BLOBMSG_TYPE_STRING ?
+					    uqmi_ub_radio_of_access_tech(blobmsg_get_string(tech)) : NULL;
+
+			if (!radio)
+				continue;
+			info = blobmsg_open_table(&status, NULL);
+			blobmsg_add_u32(&status, "mcc", mcc);
+			blobmsg_add_u32(&status, "mnc", mnc);
+			blobmsg_add_string(&status, "radio", radio);
+			blobmsg_close_table(&status, info);
+		}
+	}
+	blobmsg_close_array(&status, c);
+	blobmsg_close_table(&status, t);
+	free(r);
+
+	return 0;
+}

+/*****************************************************************************/
+/* PDC */
+
+static int opt_pdc_config_type(char *arg)
+{
+	uint32_t type;
+
+	if (!pdc_type_parse(arg, &type))
+		return ub_fail("Invalid value (valid: software, platform)");
+	G.pdc_type = arg;
+	return 0;
+}
+
+static int ub_pdc_call(const char *method, const char *id, const char *file, struct blob_attr **r)
+{
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "type", G.pdc_type);
+	if (id)
+		blobmsg_add_string(&args, "id", id);
+	if (file)
+		blobmsg_add_string(&args, "file", file);
+	return ub_modem(method, &args, r);
+}
+
+static int cmd_pdc_list_configs(char *arg)
+{
+	struct blob_attr *r, *cur;
+	const char *type;
+	size_t rem;
+	void *a, *c;
+
+	if (ub_pdc_call("pdc_list", NULL, NULL, &r))
+		return -1;
+
+	type = jstr(r, "type");
+	a = blobmsg_open_array(&status, NULL);
+	blobmsg_for_each_attr(cur, jget(r, "configs"), rem) {
+		const char *s;
+		uint32_t version = 0;
+
+		c = blobmsg_open_table(&status, NULL);
+		blobmsg_add_string(&status, "type", type ? type : G.pdc_type);
+		s = jstr(cur, "id");
+		if (s)
+			blobmsg_add_string(&status, "id", s);
+		s = jstr(cur, "description");
+		blobmsg_add_string(&status, "description", s ? s : "");
+		uqmi_ub_parse_hex(jstr(cur, "version"), &version);
+		blobmsg_printf(&status, "version", "0x%x", version);
+		blobmsg_add_u32(&status, "size", jint_or(cur, "total_size", 0));
+		blobmsg_add_u8(&status, "active", jbool(cur, "active"));
+		blobmsg_add_u8(&status, "pending", jbool(cur, "pending"));
+		blobmsg_close_table(&status, c);
+	}
+	blobmsg_close_array(&status, a);
+	free(r);
+
+	return 0;
+}
+
+static int cmd_pdc_get_selected_config(char *arg)
+{
+	struct blob_attr *r;
+	const char *s;
+	void *c;
+
+	if (ub_pdc_call("pdc_selected", NULL, NULL, &r))
+		return -1;
+
+	c = blobmsg_open_table(&status, NULL);
+	s = jstr(r, "type");
+	blobmsg_add_string(&status, "type", s ? s : G.pdc_type);
+	if ((s = jstr(r, "active")))
+		blobmsg_add_string(&status, "active", s);
+	if ((s = jstr(r, "pending")))
+		blobmsg_add_string(&status, "pending", s);
+	blobmsg_close_table(&status, c);
+	free(r);
+
+	return 0;
+}
+
+static int ub_pdc_emit(struct blob_attr *r, const char *const *keys)
+{
+	void *c = blobmsg_open_table(&status, NULL);
+	int64_t v;
+	const char *s;
+	unsigned int i;
+
+	for (i = 0; keys[i]; i++) {
+		if (!strcmp(keys[i], "size")) {
+			if (jint(r, "size", &v))
+				blobmsg_add_u32(&status, "size", v);
+		} else if ((s = jstr(r, keys[i]))) {
+			blobmsg_add_string(&status, keys[i], s);
+		}
+	}
+	blobmsg_close_table(&status, c);
+
+	return 0;
+}
+
+static int cmd_pdc_load_config(char *arg)
+{
+	static const char *const keys[] = { "type", "id", "size", NULL };
+	char real[PATH_MAX];
+	struct blob_attr *r;
+
+	/* uqmid reads the file: its working directory is another one */
+	if (!realpath(arg, real))
+		return ub_fail("Failed to open file");
+	if (ub_pdc_call("pdc_load", NULL, real, &r))
+		return -1;
+	ub_pdc_emit(r, keys);
+	free(r);
+
+	return 0;
+}
+
+static int cmd_pdc_activate_config(char *arg)
+{
+	static const char *const keys[] = { "type", "id", "status", NULL };
+	uint8_t id[PDC_ID_MAX];
+	unsigned int n;
+	struct blob_attr *r;
+
+	if (!pdc_id_parse(arg, id, &n))
+		return ub_fail("Invalid configuration ID (expected hex string)");
+	if (ub_pdc_call("pdc_activate", arg, NULL, &r))
+		return -1;
+	ub_pdc_emit(r, keys);
+	free(r);
+
+	return 0;
+}
+
+static int cmd_pdc_deactivate_config(char *arg)
+{
+	static const char *const keys[] = { "type", "status", NULL };
+	struct blob_attr *r;
+
+	if (ub_pdc_call("pdc_deactivate", NULL, NULL, &r))
+		return -1;
+	ub_pdc_emit(r, keys);
+	free(r);
+
+	return 0;
+}
+
+static int cmd_pdc_delete_config(char *arg)
+{
+	uint8_t id[PDC_ID_MAX];
+	unsigned int n;
+
+	if (!pdc_id_parse(arg, id, &n))
+		return ub_fail("Invalid configuration ID (expected hex string)");
+	return ub_pdc_call("pdc_delete", arg, NULL, NULL);
+}

+int uqmi_ub_parse_network_modes(const char *arg, const char *names[UB_MAX_MODES], unsigned int *n)
+{
+	static const struct {
+		const char *cli;
+		const char *nick;
+	} modes[] = {
+		{ "gsm", "2g" },
+		{ "umts", "3g" },
+		{ "lte", "4g" },
+		{ "5gnr", "5g" },
+	};
+	char buf[128], *word, *save = NULL;
+	unsigned int i, cnt = 0;
+	bool any = false;
+
+	if (strlen(arg) >= sizeof(buf))
+		return UB_MAP_INVALID;
+	strcpy(buf, arg);
+
+	for (word = strtok_r(buf, ",", &save); word; word = strtok_r(NULL, ",", &save)) {
+		bool found = false;
+
+		if (!strcmp(word, "all")) {
+			any = true;
+			continue;
+		}
+		if (!strcmp(word, "cdma") || !strcmp(word, "td-scdma"))
+			return UB_MAP_NA;
+
+		for (i = 0; i < sizeof(modes) / sizeof(modes[0]); i++) {
+			unsigned int j;
+			bool dup = false;
+
+			if (strcmp(word, modes[i].cli))
+				continue;
+			found = true;
+			for (j = 0; j < cnt; j++)
+				dup |= !strcmp(names[j], modes[i].nick);
+			if (!dup && cnt < UB_MAX_MODES)
+				names[cnt++] = modes[i].nick;
+		}
+		if (!found)
+			return UB_MAP_INVALID;
+	}
+
+	if (any) {
+		names[0] = "any";
+		cnt = 1;
+	}
+	if (!cnt)
+		return UB_MAP_INVALID;
+
+	*n = cnt;
+	return 0;
+}

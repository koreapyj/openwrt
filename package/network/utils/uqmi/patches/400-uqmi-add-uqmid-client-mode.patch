+bool uqmi_ub_device_match(const char *device, const char *node, const char *port, const char *physdev)
+{
+	const char *base;
+
+	if (!device || !*device)
+		return false;
+
+	base = strrchr(device, '/');
+	base = base ? base + 1 : device;
+
+	if (node && *node) {
+		const char *nbase = strrchr(node, '/');
+
+		if (!strcmp(device, node) || !strcmp(device, nbase ? nbase + 1 : node))
+			return true;
+	}
+	if (port && *port && (!strcmp(device, port) || !strcmp(base, port)))
+		return true;
+	if (physdev && *physdev && !strcmp(device, physdev))
+		return true;
+
+	return false;
+}

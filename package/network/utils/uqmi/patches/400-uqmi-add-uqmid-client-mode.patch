+static int cmd_uim_open_logical_channel(char *arg)
+{
+	uint8_t aid[16];
+	unsigned int len;
+	struct blob_attr *r;
+
+	if (!G.uim_slot)
+		return ub_fail("UIM-Slot not set");
+	if (!ext_hex_parse(arg, aid, sizeof(aid), &len))
+		return ub_fail("Invalid AID argument");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "aid", arg);
+	blobmsg_add_u32(&args, "slot", G.uim_slot);
+	if (ub_modem("uim_channel_open", &args, &r))

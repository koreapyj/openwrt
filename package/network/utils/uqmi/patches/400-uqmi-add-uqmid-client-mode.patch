+int uqmi_ub_parse_profile_id(const char *arg, uint32_t *index)
+{
+	char type[8];
+	const char *comma = strchr(arg, ',');
+	size_t n;
+
+	if (!comma)
+		return UB_MAP_INVALID;
+	n = comma - arg;
+	if (n >= sizeof(type))
+		return UB_MAP_INVALID;
+	memcpy(type, arg, n);
+	type[n] = '\0';
+
+	if (!uqmi_ub_parse_uint(comma + 1, 0xffffffffu, index))
+		return UB_MAP_INVALID;
+	if (!strcasecmp(type, "3gpp"))
+		return 0;
+	if (!strcasecmp(type, "3gpp2"))
+		return UB_MAP_NA;
+	return UB_MAP_INVALID;

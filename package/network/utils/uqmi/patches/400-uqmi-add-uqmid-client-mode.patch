 IF(BUILD_UQMID)
 	FIND_PATH(talloc_include_dir talloc.h)
-	FIND_PATH(ubus_include_dir libubus.h)
 	IF(BUILD_STATIC)
 		FIND_LIBRARY(talloc_library NAMES libtalloc.a)

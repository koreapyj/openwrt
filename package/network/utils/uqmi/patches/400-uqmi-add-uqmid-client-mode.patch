--- /dev/null
+++ b/uqmi/ubus-client.c
@@ -0,0 +1,2980 @@
+/*
+ * uqmi --uqmid: the uqmi commands on top of the ubus API of uqmid (uqmid/README.md, "uqmi --uqmid")
+ *
+ * uqmi does not open the device in this mode. For every command the QMI request of the direct mode is replaced
+ * by the call(s) of the uqmid method which does the same, and the reply is printed in the form of the command.
+ * The common/ext-fmt and sms-json code of the direct mode is used where the reply of uqmid is the same.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#include <arpa/inet.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include <libubox/blobmsg.h>
+#include <libubox/blobmsg_json.h>
+#include <libubox/uloop.h>
+#include <libubus.h>
+
+#include "uqmi.h"
+#include "commands.h"
+#include "ext-fmt.h"
+#include "pdc-util.h"
+#include "sms-json.h"
+#include "sms_part.h"
+#include "ubus-client.h"
+#include "ubus-map.h"
+#include "wds-util.h"
+
+/* the longest request of uqmid is a network scan or a message send (300 s) */
+#define UB_DEFAULT_TIMEOUT_MS	(10 * 60 * 1000)
+#define UB_PATH_LEN		128
+
+static struct {
+	struct ubus_context *ctx;
+	int timeout;
+	char modem[UB_PATH_LEN];
+	uint32_t modem_id;
+
+	/* the options of the commands (the static variables of commands-*.c in the direct mode) */
+	const char *apn, *auth, *username, *password, *ip_family, *profile;
+	bool autoconnect;
+	const char *pdp_type, *no_roaming;
+	const char *pin, *puk, *new_pin;
+
+	const char *modes, *preference, *roaming, *duration;
+	const char *mcc, *mnc;
+	bool plmn_pending;
+
+	const char *storage;	/* "sim" or "me" */
+	const char *send_smsc, *send_target;
+	bool send_flash;
+
+	int uim_slot, channel_id;
+
+	const char *dl_proto, *ul_proto;
+	bool dl_proto_set, ul_proto_set;
+	uint32_t dl_count, dl_size, ul_count, ul_size;
+	int flow_control;
+
+	const char *pdc_type;
+} G = {
+	.storage = "sim",
+	.channel_id = -1,
+	.flow_control = -1,
+	.pdc_type = "software",
+};
+
+static struct blob_buf args;
+
+/*****************************************************************************/
+/* output */
+
+static void ub_print_result(void)
+{
+	char *str;
+
+	if (!blob_len(status.head))
+		return;
+
+	str = blobmsg_format_json_indent(blob_data(status.head), false, single_line ? -1 : 0);
+	if (!str)
+		return;
+
+	printf("%s\n", str);
+	free(str);
+}
+
+/*
+ * the errors are added to the result like uqmi_add_error() of the direct mode (a JSON string on stdout, printed
+ * with the result of the command)
+ */
+static int __attribute__((format(printf, 1, 2))) ub_fail(const char *fmt, ...)
+{
+	char text[512];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(text, sizeof(text), fmt, ap);
+	va_end(ap);
+
+	if (!status.head)
+		blob_buf_init(&status, 0);
+	blobmsg_add_string(&status, NULL, text);
+
+	return -1;
+}
+
+static int ub_na(const char *name)
+{
+	return ub_fail("--%s: not available with --uqmid", name);
+}
+
+/*****************************************************************************/
+/* the replies: a table (blobmsg) which is freed by the caller */
+
+static struct blob_attr *jget(struct blob_attr *tbl, const char *key)
+{
+	struct blob_attr *cur;
+	size_t rem;
+
+	if (!tbl)
+		return NULL;
+	blobmsg_for_each_attr(cur, tbl, rem) {
+		if (!strcmp(blobmsg_name(cur), key))
+			return cur;
+	}
+	return NULL;
+}
+
+static const char *jstr(struct blob_attr *tbl, const char *key)
+{
+	struct blob_attr *a = jget(tbl, key);
+
+	return a && blobmsg_type(a) == BLOBMSG_TYPE_STRING ? blobmsg_get_string(a) : NULL;
+}
+
+static bool jint(struct blob_attr *tbl, const char *key, int64_t *val)
+{
+	struct blob_attr *a = jget(tbl, key);
+
+	if (!a)
+		return false;
+	switch (blobmsg_type(a)) {
+	case BLOBMSG_TYPE_INT8:
+		*val = blobmsg_get_u8(a);
+		return true;
+	case BLOBMSG_TYPE_INT16:
+		*val = (int16_t) blobmsg_get_u16(a);
+		return true;
+	case BLOBMSG_TYPE_INT32:
+		*val = (int32_t) blobmsg_get_u32(a);
+		return true;
+	case BLOBMSG_TYPE_INT64:
+		*val = (int64_t) blobmsg_get_u64(a);
+		return true;
+	case BLOBMSG_TYPE_DOUBLE:
+		*val = uqmi_ub_round(blobmsg_get_double(a));
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int64_t jint_or(struct blob_attr *tbl, const char *key, int64_t def)
+{
+	int64_t v;
+
+	return jint(tbl, key, &v) ? v : def;
+}
+
+static bool jnum(struct blob_attr *tbl, const char *key, double *val)
+{
+	struct blob_attr *a = jget(tbl, key);
+	int64_t v;
+
+	if (!a)
+		return false;
+	if (blobmsg_type(a) == BLOBMSG_TYPE_DOUBLE) {
+		*val = blobmsg_get_double(a);
+		return true;
+	}
+	if (!jint(tbl, key, &v))
+		return false;
+	*val = v;
+	return true;
+}
+
+static bool jbool(struct blob_attr *tbl, const char *key)
+{
+	struct blob_attr *a = jget(tbl, key);
+
+	return a && blobmsg_type(a) == BLOBMSG_TYPE_BOOL && blobmsg_get_bool(a);
+}
+
+static bool jarray_has(struct blob_attr *tbl, const char *key, const char *str)
+{
+	struct blob_attr *arr = jget(tbl, key), *cur;
+	size_t rem;
+
+	if (!arr)
+		return false;
+	blobmsg_for_each_attr(cur, arr, rem) {
+		if (blobmsg_type(cur) == BLOBMSG_TYPE_STRING && !strcmp(blobmsg_get_string(cur), str))
+			return true;
+	}
+	return false;
+}
+
+static const char *jarray_first(struct blob_attr *tbl, const char *key)
+{
+	struct blob_attr *arr = jget(tbl, key), *cur;
+	size_t rem;
+
+	if (!arr)
+		return NULL;
+	blobmsg_for_each_attr(cur, arr, rem) {
+		if (blobmsg_type(cur) == BLOBMSG_TYPE_STRING)
+			return blobmsg_get_string(cur);
+	}
+	return NULL;
+}
+
+/*****************************************************************************/
+/* ubus calls */
+
+struct ub_reply {
+	struct blob_attr *data;
+};
+
+static struct blob_attr *ub_table_of(struct blob_attr *msg)
+{
+	struct blob_buf rb = {};
+	struct blob_attr *cur, *ret;
+	size_t rem;
+	void *t;
+
+	blob_buf_init(&rb, 0);
+	t = blobmsg_open_table(&rb, NULL);
+	if (msg) {
+		blob_for_each_attr(cur, msg, rem)
+			blobmsg_add_blob(&rb, cur);
+	}
+	blobmsg_close_table(&rb, t);
+	ret = blob_memdup(blob_data(rb.head));
+	blob_buf_free(&rb);
+
+	return ret;
+}
+
+static void ub_data_cb(struct ubus_request *req, int type, struct blob_attr *msg)
+{
+	struct ub_reply *r = req->priv;
+
+	if (!r->data)
+		r->data = ub_table_of(msg);
+}
+
+/* calls a method; the reply (a table, never NULL on success) is returned in @reply if given */
+static int ub_invoke(const char *path, const char *method, struct blob_buf *a, struct blob_attr **reply)
+{
+	struct ub_reply r = {};
+	uint32_t id;
+	int ret;
+
+	if (ubus_lookup_id(G.ctx, path, &id))
+		return ub_fail("%s: object not found", path);
+
+	ret = ubus_invoke(G.ctx, id, method, a ? a->head : NULL, ub_data_cb, &r, G.timeout);
+	if (ret) {
+		/* the {error, message} of uqmid */
+		const char *name = jstr(r.data, "error"), *msg = jstr(r.data, "message");
+
+		if (name)
+			ub_fail("%s: %s", name, msg ? msg : ubus_strerror(ret));
+		else
+			ub_fail("%s %s: %s", path, method, ubus_strerror(ret));
+		free(r.data);
+		return -1;
+	}
+
+	if (!r.data)
+		r.data = ub_table_of(NULL);
+	if (reply)
+		*reply = r.data;
+	else
+		free(r.data);
+
+	return 0;
+}
+
+static int ub_modem(const char *method, struct blob_buf *a, struct blob_attr **reply)
+{
+	return ub_invoke(G.modem, method, a, reply);
+}
+
+/* the SIM object of the modem */
+static int ub_sim(char *path, size_t len)
+{
+	struct blob_attr *m;
+	const char *sim;
+	int ret = -1;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+	sim = jstr(m, "sim");
+	if (!sim || !strcmp(sim, "/"))
+		ub_fail("No SIM");
+	else if (strlen(sim) >= len)
+		ub_fail("Invalid SIM path");
+	else {
+		strcpy(path, sim);
+		ret = 0;
+	}
+	free(m);
+
+	return ret;
+}
+
+/* the changes reply {state, power_state, ...}: only the data of the command is printed */
+static void ub_emit_filtered(struct blob_attr *tbl)
+{
+	struct blob_attr *cur;
+	size_t rem;
+	void *t = blobmsg_open_table(&status, NULL);
+
+	blobmsg_for_each_attr(cur, tbl, rem) {
+		if (!strcmp(blobmsg_name(cur), "state") || !strcmp(blobmsg_name(cur), "power_state"))
+			continue;
+		blobmsg_add_blob(&status, cur);
+	}
+	blobmsg_close_table(&status, t);
+}
+
+/* a modem call whose reply is printed as it is (the extension reads) */
+static int ub_modem_passthrough(const char *method)
+{
+	struct blob_attr *r;
+
+	if (ub_modem(method, NULL, &r))
+		return -1;
+	ub_emit_filtered(r);
+	free(r);
+	return 0;
+}
+
+static int ub_modem_simple(const char *method)
+{
+	return ub_modem(method, NULL, NULL);
+}
+
+static bool ub_state_enabled(const char *state)
+{
+	static const char *const names[] = { "enabled", "searching", "registered", "connecting", "connected",
+					     "disconnecting" };
+	unsigned int i;
+
+	for (i = 0; state && i < sizeof(names) / sizeof(names[0]); i++) {
+		if (!strcmp(state, names[i]))
+			return true;
+	}
+	return false;
+}
+
+/*****************************************************************************/
+/* the modem of the device option */
+
+static int ub_select_modem(const char *device)
+{
+	struct blob_attr *list, *modems, *cur;
+	const char *found = NULL;
+	char found_path[UB_PATH_LEN] = "";
+	unsigned int n = 0;
+	size_t rem;
+
+	if (ub_invoke("uqmid", "list", NULL, &list))
+		return -1;
+
+	modems = jget(list, "modems");
+	blobmsg_for_each_attr(cur, modems, rem) {
+		const char *path = jstr(cur, "path");
+
+		if (!path || strlen(path) >= sizeof(found_path))
+			continue;
+		n++;
+		if (device && !uqmi_ub_device_match(device, jstr(cur, "device"), jstr(cur, "port"),
+						    jstr(cur, "physdev")))
+			continue;
+		if (!found) {
+			found = path;
+			strcpy(found_path, path);
+		} else if (device) {
+			/* the first match wins, like the netifd protocol */
+			break;
+		}
+	}
+	free(list);
+
+	if (!device && n > 1)
+		return ub_fail("More than one modem found, select one with --device");
+	if (!found_path[0])
+		return device ? ub_fail("No modem found for device %s", device) : ub_fail("No modem found");
+
+	strcpy(G.modem, found_path);
+	return ub_invoke(G.modem, "get", NULL, NULL) ? -1 : 0;
+}

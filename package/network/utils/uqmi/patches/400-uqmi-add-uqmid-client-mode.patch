+	else if (!strcasecmp(arg, "ipv6"))
+		*ip_type = "ipv6";
+	else if (!strcasecmp(arg, "unspecified"))
+		*ip_type = "";
+	else
+		return UB_MAP_INVALID;
+	return 0;

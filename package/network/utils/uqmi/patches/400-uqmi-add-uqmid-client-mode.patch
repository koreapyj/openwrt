+
+static int cmd_dms_get_capabilities(char *arg)
+{
+	static const struct {
+		const char *cap;
+		const char *radio[2];
+	} map[] = {
+		{ "cdma-evdo", { "cdma1x", "cdma1xevdo" } },
+		{ "gsm-umts", { "gsm", "umts" } },
+		{ "lte", { "lte" } },
+		{ "lte-advanced", { "lte" } },
+		{ "5gnr", { "5gnr" } },
+	};
+	static const char *const order[] = { "cdma1x", "cdma1xevdo", "gsm", "umts", "lte", "5gnr" };
+	struct blob_attr *m, *sup, *combo, *cap;
+	bool have[6] = {};
+	unsigned int i, j, k;
+	size_t rem, rem2;
+	const char *sim;
+	void *t, *a;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+
+	/* all the radio interfaces of the supported combinations (else the current ones) */
+	sup = jget(m, "supported_capabilities");
+	blobmsg_for_each_attr(combo, sup, rem) {
+		blobmsg_for_each_attr(cap, combo, rem2) {
+			if (blobmsg_type(cap) != BLOBMSG_TYPE_STRING)
+				continue;
+			for (i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+				if (strcmp(blobmsg_get_string(cap), map[i].cap))
+					continue;
+				for (j = 0; j < 2 && map[i].radio[j]; j++) {
+					for (k = 0; k < 6; k++)
+						have[k] |= !strcmp(order[k], map[i].radio[j]);
+				}
+			}
+		}
+	}
+	if (!have[0] && !have[1] && !have[2] && !have[3] && !have[4] && !have[5]) {
+		blobmsg_for_each_attr(cap, jget(m, "current_capabilities"), rem2) {
+			for (i = 0; blobmsg_type(cap) == BLOBMSG_TYPE_STRING && i < sizeof(map) / sizeof(map[0]); i++) {
+				if (strcmp(blobmsg_get_string(cap), map[i].cap))
+					continue;
+				for (j = 0; j < 2 && map[i].radio[j]; j++) {
+					for (k = 0; k < 6; k++)
+						have[k] |= !strcmp(order[k], map[i].radio[j]);
+				}
+			}
+		}
+	}
+
+	sim = jstr(m, "sim");
+	t = blobmsg_open_table(&status, NULL);
+	/* the channel rates and the data service capability are not known to uqmid */
+	blobmsg_add_string(&status, "sim", sim && strcmp(sim, "/") ? "supported" : "not supported");
+	a = blobmsg_open_array(&status, "networks");
+	for (k = 0; k < 6; k++) {
+		if (have[k])
+			blobmsg_add_string(&status, NULL, order[k]);
+	}
+	blobmsg_close_array(&status, a);
+	blobmsg_close_table(&status, t);
+	free(m);
+
+	return 0;
+}
+
+static int cmd_dms_get_pin_status(char *arg)
+{
+	struct blob_attr *r;
+	const char *s;
+	int64_t v;
+	void *t;
+	int i;
+
+	/* the UIM card status gives the PIN states and the retries of both PINs */
+	if (ub_modem("uim_get_sim_state", NULL, &r))
+		return -1;
+
+	t = blobmsg_open_table(&status, NULL);
+	for (i = 1; i <= 2; i++) {
+		char key[32];
+
+		snprintf(key, sizeof(key), "pin%d_status", i);
+		s = jstr(r, key);
+		if (!s)
+			continue;
+		blobmsg_add_string(&status, key, s);
+		snprintf(key, sizeof(key), "pin%d_verify_tries", i);
+		blobmsg_add_u32(&status, key, jint(r, key, &v) ? v : 0);
+		snprintf(key, sizeof(key), "pin%d_unlock_tries", i);
+		v = jint_or(r, key, 0);
+		snprintf(key, sizeof(key), "pin%d_unblock_tries", i);
+		blobmsg_add_u32(&status, key, v);
+	}
+	blobmsg_close_table(&status, t);
+	free(r);
+
+	return 0;
+}

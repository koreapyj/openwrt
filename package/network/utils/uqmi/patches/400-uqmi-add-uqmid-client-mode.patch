+static void ub_add_auth(struct blob_buf *b, const char *key, const char *cli)
+{
+	const char *names[2];
+	int n = uqmi_ub_auth_names(cli, names), i;
+	void *a = blobmsg_open_array(b, key);
+
+	for (i = 0; i < n; i++)
+		blobmsg_add_string(b, NULL, names[i]);
+	blobmsg_close_array(b, a);
+}
+
+static int ub_enable_modem(void)
+{
+	struct blob_attr *m;
+	const char *state;
+	int ret = 0;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+	state = jstr(m, "state");
+	if (state && !strcmp(state, "disabled")) {
+		/* like the direct mode the modem is used as it is: a bearer needs an enabled modem */
+		blob_buf_init(&args, 0);
+		blobmsg_add_u8(&args, "enable", true);
+		ret = ub_modem("enable", &args, NULL);
+	} else if (!ub_state_enabled(state)) {
+		ret = ub_fail("wrong-state: modem in %s state", state ? state : "unknown");
+	}
+	free(m);
+
+	return ret;
+}
+
+static int cmd_start_network(char *arg)
+{
+	struct blob_attr *r;
+	uint32_t index, profile = 0;
+	char path[UB_PATH_LEN];
+	const char *p;
+	int ret;
+
+	if (G.autoconnect)
+		return ub_fail("--autoconnect: not available with --uqmid");
+	if (G.profile && !uqmi_ub_parse_uint(G.profile, 0xffffffffu, &profile))
+		return ub_fail("Invalid profile");
+	if (ub_enable_modem())
+		return -1;
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "apn", G.apn ? G.apn : "");
+	if (G.ip_family) {
+		const char *ip_type = "";
+
+		uqmi_ub_ip_family_to_ip_type(G.ip_family, &ip_type);
+		if (*ip_type)
+			blobmsg_add_string(&args, "ip_type", ip_type);
+	}
+	if (G.auth)
+		ub_add_auth(&args, "allowed_auth", G.auth);
+	if (G.username)
+		blobmsg_add_string(&args, "user", G.username);
+	if (G.password)
+		blobmsg_add_string(&args, "password", G.password);
+	if (G.profile)
+		blobmsg_add_u32(&args, "profile_id", profile);
+	if (ub_modem("create_bearer", &args, &r))
+		return -1;
+	p = jstr(r, "path");
+	if (!p || strlen(p) >= sizeof(path) || !uqmi_ub_path_index(p, "bearer", &index)) {
+		free(r);
+		return ub_fail("Invalid bearer path");
+	}
+	strcpy(path, p);
+	free(r);
+
+	ret = ub_invoke(path, "connect", NULL, NULL);
+	if (ret) {
+		/* nothing is left behind by a failed start */
+		blob_buf_init(&args, 0);
+		blobmsg_add_string(&args, "path", path);
+		ub_modem("delete_bearer", &args, NULL);
+		return -1;
+	}
+
+	/* the packet data handle of the direct mode is the number of the bearer object */
+	blobmsg_add_u32(&status, NULL, index);
+	return 0;
+}
+
+static int cmd_stop_network(char *arg)
+{
+	uint32_t index;
+	char path[UB_PATH_LEN];
+
+	if (!uqmi_ub_parse_uint(arg, 0xffffffffu, &index))
+		return ub_fail("Invalid handle");
+
+	/* the bearer is disconnected and removed */
+	snprintf(path, sizeof(path), "%s.bearer.%u", G.modem, index);
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "path", path);
+	return ub_modem("delete_bearer", &args, NULL);
+}
+
+/* the connected bearer (get reply in @bearer), else the first one; -1 on an error, 1 without a bearer */
+static int ub_find_bearer(struct blob_attr **bearer)
+{
+	struct blob_attr *m, *cur, *first = NULL;
+	size_t rem;
+	int ret = 1;
+
+	*bearer = NULL;
+	if (ub_modem("get", NULL, &m))
+		return -1;
+
+	blobmsg_for_each_attr(cur, jget(m, "bearers"), rem) {
+		struct blob_attr *b;
+		const char *st;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING)
+			continue;
+		if (ub_invoke(blobmsg_get_string(cur), "get", NULL, &b)) {
+			free(first);
+			free(m);
+			return -1;
+		}
+		st = jstr(b, "status");
+		if (st && !strcmp(st, "connected")) {
+			free(first);
+			first = b;
+			break;
+		}
+		if (!first)
+			first = b;
+		else
+			free(b);
+	}
+	free(m);
+
+	if (first) {
+		*bearer = first;
+		ret = 0;
+	}
+	return ret;
+}
+
+static int cmd_get_packet_service_status(char *arg)
+{
+	struct blob_attr *b;
+	const char *st = "disconnected";
+	int ret = ub_find_bearer(&b);
+
+	if (ret < 0)
+		return -1;
+	if (!ret) {
+		if (jbool(b, "connected"))
+			st = jbool(b, "suspended") ? "suspended" : "connected";
+		free(b);
+	}
+	blobmsg_add_string(&status, NULL, st);
+
+	return 0;
+}
+
+static void ub_add_ipv4(const char *name, const char *addr)
+{
+	if (addr)
+		blobmsg_add_string(&status, name, addr);
+}
+
+static int cmd_get_current_settings(char *arg)
+{
+	struct blob_attr *b, *v4, *v6, *props;
+	const char *ip_type, *s;
+	int ret = ub_find_bearer(&b);
+	void *t, *c;
+	char mask[INET_ADDRSTRLEN];
+	int64_t v;
+
+	if (ret < 0)
+		return -1;
+	if (ret || !jbool(b, "connected")) {
+		free(b);
+		return ub_fail("Not connected");
+	}
+
+	props = jget(b, "properties");
+	v4 = jget(b, "ip4_config");
+	v6 = jget(b, "ip6_config");
+	ip_type = jstr(props, "ip_type");
+
+	t = blobmsg_open_table(&status, NULL);
+	if (ip_type && (!strcmp(ip_type, "ipv4") || !strcmp(ip_type, "ipv6") || !strcmp(ip_type, "ipv4v6")))
+		blobmsg_add_string(&status, "pdp-type", ip_type);
+	if (v4 || v6)
+		blobmsg_add_string(&status, "ip-family", v4 ? "ipv4" : "ipv6");
+	if (jint(v4, "mtu", &v) || jint(v6, "mtu", &v))
+		blobmsg_add_u32(&status, "mtu", v);
+
+	c = blobmsg_open_table(&status, "ipv4");
+	ub_add_ipv4("ip", jstr(v4, "address"));
+	ub_add_ipv4("dns1", jstr(v4, "dns1"));
+	ub_add_ipv4("dns2", jstr(v4, "dns2"));
+	ub_add_ipv4("gateway", jstr(v4, "gateway"));
+	if (jint(v4, "prefix", &v)) {
+		blobmsg_add_string(&status, "subnet",
+				   wds_ipv4_to_str(uqmi_ub_prefix_to_mask(v), mask, sizeof(mask)));
+	}
+	blobmsg_close_table(&status, c);
+
+	c = blobmsg_open_table(&status, "ipv6");
+	if ((s = jstr(v6, "address"))) {
+		blobmsg_add_string(&status, "ip", s);
+		blobmsg_add_u32(&status, "ip-prefix-length", jint_or(v6, "prefix", 0));
+	}
+	ub_add_ipv4("gateway", jstr(v6, "gateway"));
+	ub_add_ipv4("dns1", jstr(v6, "dns1"));
+	ub_add_ipv4("dns2", jstr(v6, "dns2"));
+	blobmsg_close_table(&status, c);
+
+	/* the domain names are not known to uqmid */
+	c = blobmsg_open_table(&status, "domain-names");
+	blobmsg_close_table(&status, c);
+	blobmsg_close_table(&status, t);
+	free(b);
+
+	return 0;
+}

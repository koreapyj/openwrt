+static bool all_digits(const char *s)
+{
+	if (!*s)
+		return false;
+	for (; *s; s++) {
+		if (!isdigit((unsigned char) *s))
+			return false;
+	}
+	return true;
+}
+
+bool uqmi_ub_plmn_operator_id(const char *mcc, const char *mnc, char *buf, size_t len)
+{
+	size_t ml, nl;
+	int n;
+
+	if (!mcc || !mnc || !all_digits(mcc) || !all_digits(mnc))
+		return false;
+	ml = strlen(mcc);
+	nl = strlen(mnc);
+	if (ml > 3 || nl > 3)
+		return false;
+
+	/* the CLI takes numbers: "1" is MNC 01, a third digit is kept */
+	n = snprintf(buf, len, "%0*lu%0*lu", 3, strtoul(mcc, NULL, 10), nl == 3 ? 3 : 2, strtoul(mnc, NULL, 10));
+	return n > 0 && (size_t) n < len;
+}
+
+bool uqmi_ub_plmn_split(const char *code, unsigned int *mcc, unsigned int *mnc)
+{
+	size_t len;
+	char buf[4];
+
+	if (!code || !all_digits(code))
+		return false;
+	len = strlen(code);
+	if (len != 5 && len != 6)
+		return false;
+
+	memcpy(buf, code, 3);
+	buf[3] = '\0';
+	*mcc = strtoul(buf, NULL, 10);
+	*mnc = strtoul(code + 3, NULL, 10);
+	return true;
+}

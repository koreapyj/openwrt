From: Yoonji Park <koreapyj@dcmys.kr>
Subject: [PATCH] uqmi: add --uqmid client mode

uqmid owns the control device, so uqmi can not talk to the modem
directly while the daemon is running. Add a --uqmid option which
translates the uqmi commands into calls of the uqmid ubus API and prints
the results and errors in the same form as the direct mode.
---
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,15 +12,18 @@ SET(CMAKE_SHARED_LIBRARY_LINK_C_FLAGS "")
 FIND_PATH(ubox_include_dir libubox/usock.h)
 FIND_PATH(blobmsg_json_include_dir libubox/blobmsg_json.h)
 FIND_PATH(json_include_dir json-c/json.h json/json.h json.h)
+FIND_PATH(ubus_include_dir libubus.h)
 
 IF(BUILD_STATIC)
   FIND_LIBRARY(json_library NAMES libjson.a libjson-c.a)
   FIND_LIBRARY(blobmsg_json_library NAMES libblobmsg_json.a)
   FIND_LIBRARY(ubox_library NAMES libubox.a)
+  FIND_LIBRARY(ubus_library NAMES libubus.a)
 ELSE(BUILD_STATIC)
   FIND_LIBRARY(json_library NAMES json-c json)
   FIND_LIBRARY(blobmsg_json_library NAMES blobmsg_json)

+		return ub_fail("UIM-Slot not set. Use --uim-slot <slot> to set it.");
+	if (G.channel_id < 1)
+		return ub_fail("Invalid channel-id set.");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_u32(&args, "channel_id", G.channel_id);
+	blobmsg_add_u32(&args, "slot", G.uim_slot);
+	return ub_modem("uim_channel_close", &args, NULL);
+}
+
+static int cmd_uim_send_apdu(char *arg)
+{
+	uint8_t apdu[1024];
+	unsigned int len;
+	struct blob_attr *r;
+
+	if (!G.uim_slot)
+		return ub_fail("UIM-Slot not set. Use --uim-slot <slot> to set it.");
+	if (!ext_hex_parse(arg, apdu, sizeof(apdu), &len))
+		return ub_fail("Invalid APDU argument");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "apdu", arg);
+	/* without --uim-channel-id the direct mode sends the channel id 255 (-1) */
+	blobmsg_add_u32(&args, "channel_id", G.channel_id < 0 ? 255 : G.channel_id);
+	blobmsg_add_u32(&args, "slot", G.uim_slot);
+	if (ub_modem("uim_apdu_send", &args, &r))
+		return -1;
+	ub_emit_filtered(r);
+	free(r);
+
+	return 0;
+}
+
+/*****************************************************************************/
+/* WMS */
+
+static int opt_storage(char *arg)
+{
+	if (strcmp(arg, "sim") && strcmp(arg, "me"))
+		return ub_fail("Invalid value (sim or me)");
+	G.storage = arg;
+	return 0;
+}
+
+/* the sms object of the message with that storage index in the selected storage; false if none */
+static int ub_find_sms(uint32_t index, char *path, size_t len)
+{
+	struct blob_attr *r, *cur;
+	const char *want = uqmi_ub_storage_name(G.storage);
+	size_t rem;
+	int ret = 1;
+
+	if (ub_modem("messaging_list", NULL, &r))
+		return -1;
+	blobmsg_for_each_attr(cur, jget(r, "messages"), rem) {
+		struct blob_attr *s, *idx;
+		const char *st;
+		size_t rem2;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || ub_invoke(blobmsg_get_string(cur), "get", NULL, &s))
+			continue;
+		st = jstr(s, "storage");
+		if (st && !strcmp(st, want)) {
+			blobmsg_for_each_attr(idx, jget(s, "indices"), rem2) {
+				if (blobmsg_type(idx) == BLOBMSG_TYPE_INT32 && blobmsg_get_u32(idx) == index &&
+				    strlen(blobmsg_get_string(cur)) < len) {
+					strcpy(path, blobmsg_get_string(cur));
+					ret = 0;
+				}
+			}
+		}
+		free(s);
+		if (!ret)
+			break;
+	}
+	free(r);
+
+	return ret;
+}
+
+static int cmd_list_messages(char *arg)
+{
+	struct blob_attr *r, *cur;
+	const char *want = uqmi_ub_storage_name(G.storage);
+	size_t rem;
+	void *a;
+
+	if (ub_modem("messaging_list", NULL, &r))
+		return -1;
+
+	/* the received messages of the storage (the direct mode lists the unread ones) */
+	a = blobmsg_open_array(&status, NULL);
+	blobmsg_for_each_attr(cur, jget(r, "messages"), rem) {
+		struct blob_attr *s, *idx;
+		const char *st, *type;
+		size_t rem2;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || ub_invoke(blobmsg_get_string(cur), "get", NULL, &s))
+			continue;
+		st = jstr(s, "storage");
+		type = jstr(s, "pdu_type");
+		if (st && !strcmp(st, want) && type && !strcmp(type, "deliver")) {
+			blobmsg_for_each_attr(idx, jget(s, "indices"), rem2) {
+				if (blobmsg_type(idx) == BLOBMSG_TYPE_INT32)
+					blobmsg_add_u32(&status, NULL, blobmsg_get_u32(idx));
+			}
+		}
+		free(s);
+	}
+	blobmsg_close_array(&status, a);
+	free(r);
+
+	return 0;
+}
+
+static int ub_message_id(const char *arg, uint32_t *id)
+{
+	char *err;
+
+	*id = strtoul(arg, &err, 10);
+	if (err && *err)
+		return ub_fail("Invalid message ID");
+	return 0;
+}
+
+static int cmd_delete_message(char *arg)
+{
+	char path[UB_PATH_LEN];
+	uint32_t id;
+	int ret;
+
+	if (ub_message_id(arg, &id))
+		return -1;
+	ret = ub_find_sms(id, path, sizeof(path));
+	if (ret < 0)
+		return -1;
+	if (ret)
+		return ub_fail("Message %u not found", id);
+
+	/* all the parts of a multipart message are deleted with it */
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "path", path);
+	return ub_modem("messaging_delete", &args, NULL);
+}
+
+static int ub_raw_message(char *arg, struct blob_attr **r)
+{
+	uint32_t id;
+
+	if (ub_message_id(arg, &id))
+		return -1;
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "storage", G.storage);
+	blobmsg_add_u32(&args, "index", id);
+	return ub_modem("wms_get_raw_message", &args, r);
+}
+
+static int cmd_get_message(char *arg)
+{
+	uint8_t pdu[SMS_PDU_MAX];
+	struct blob_attr *r;
+	char err[128] = "";
+	const char *s;
+	int len;
+	void *c;
+
+	if (ub_raw_message(arg, &r))
+		return -1;
+	s = jstr(r, "data");
+	len = s ? uqmi_ub_parse_raw_sms(s, pdu, sizeof(pdu)) : -1;
+	if (len < 0) {
+		free(r);
+		return ub_fail("Invalid message data");
+	}
+
+	/* the raw message is decoded like in the direct mode */
+	c = blobmsg_open_table(&status, NULL);
+	if (uqmi_sms_pdu_to_blob(&status, pdu, len, err, sizeof(err)))
+		fprintf(stderr, "There was an error reading message: %s\n", err);
+	blobmsg_close_table(&status, c);
+	free(r);
+
+	return 0;
+}
+
+static int cmd_get_raw_message(char *arg)
+{
+	struct blob_attr *r;
+	const char *s;
+
+	if (ub_raw_message(arg, &r))
+		return -1;
+	s = jstr(r, "data");
+	if (s)
+		blobmsg_add_string(&status, NULL, s);
+	free(r);
+
+	return 0;
+}
+
+static int opt_send_smsc(char *arg)
+{
+	G.send_smsc = arg;
+	return 0;
+}
+
+static int opt_send_target(char *arg)
+{
+	G.send_target = arg;
+	return 0;
+}
+
+static int opt_send_flash(char *arg)
+{
+	G.send_flash = true;
+	return 0;
+}
+
+static int cmd_send_message(char *arg)
+{
+	struct blob_attr *r;
+	char path[UB_PATH_LEN];
+	const char *p;
+	int ret;
+
+	if (!G.send_target || !*G.send_target)
+		return ub_fail("Missing argument");
+	if ((G.send_smsc && strlen(G.send_smsc) > 16) || strlen(G.send_target) > 16)
+		return ub_fail("Argument too long");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "number", G.send_target);
+	blobmsg_add_string(&args, "text", arg);
+	if (G.send_smsc && *G.send_smsc)
+		blobmsg_add_string(&args, "smsc", G.send_smsc);
+	/* the direct mode: the longest relative validity (63 weeks) and the class 0 of a flash message */
+	blobmsg_add_u32(&args, "validity", 63 * 7 * 24 * 60);
+	if (G.send_flash)
+		blobmsg_add_u32(&args, "class", 0);
+	if (ub_modem("messaging_create", &args, &r))
+		return -1;
+	p = jstr(r, "path");
+	if (!p || strlen(p) >= sizeof(path)) {
+		free(r);
+		return ub_fail("Invalid message path");
+	}
+	strcpy(path, p);
+	free(r);
+
+	ret = ub_invoke(path, "send", NULL, NULL);
+
+	/* the sent message is not kept (the direct mode does not store it either) */
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "path", path);
+	if (ub_modem("messaging_delete", &args, NULL) && !ret)
+		ret = -1;
+
+	return ret;
+}
+
+/*****************************************************************************/
+/* VOICE */
+
+static bool ub_call_id(const char *arg, uint32_t *id)
+{
+	if (uqmi_ub_parse_uint(arg, 0xff, id))
+		return true;
+	ub_fail("Invalid call ID");
+	return false;
+}
+
+/* the call object with the QMI call id; 1 if there is none */
+static int ub_find_call(uint32_t id, char *path, size_t len)
+{
+	struct blob_attr *r, *cur;
+	size_t rem;
+	int ret = 1;
+
+	if (ub_modem("voice_list_calls", NULL, &r))
+		return -1;
+	blobmsg_for_each_attr(cur, jget(r, "calls"), rem) {
+		struct blob_attr *c;
+		const char *st;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || ub_invoke(blobmsg_get_string(cur), "get", NULL, &c))
+			continue;
+		st = jstr(c, "state");
+		if ((uint32_t) jint_or(c, "qmi_call_id", 0) == id && st && strcmp(st, "terminated") &&
+		    strlen(blobmsg_get_string(cur)) < len) {
+			strcpy(path, blobmsg_get_string(cur));
+			ret = 0;
+		}
+		free(c);
+		if (!ret)
+			break;
+	}
+	free(r);
+
+	return ret;
+}
+
+static int cmd_voice_dial(char *arg)
+{
+	struct blob_attr *r, *c;
+	char path[UB_PATH_LEN];
+	const char *p;
+	int64_t id;
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "number", arg);
+	if (ub_modem("voice_create_call", &args, &r))
+		return -1;
+	p = jstr(r, "path");
+	if (!p || strlen(p) >= sizeof(path)) {
+		free(r);
+		return ub_fail("Invalid call path");
+	}
+	strcpy(path, p);
+	free(r);
+
+	if (ub_invoke(path, "start", NULL, NULL)) {
+		blob_buf_init(&args, 0);
+		blobmsg_add_string(&args, "path", path);
+		ub_modem("voice_delete_call", &args, NULL);
+		return -1;
+	}
+	if (ub_invoke(path, "get", NULL, &c))
+		return -1;
+	if (!jint(c, "qmi_call_id", &id) || !id) {
+		free(c);
+		return ub_fail("The call has no call id");
+	}
+	free(c);
+
+	blobmsg_add_u32(&status, NULL, id);
+	return 0;
+}
+
+static int ub_call_method(char *arg, const char *method)
+{
+	char path[UB_PATH_LEN];
+	uint32_t id;
+	int ret;
+
+	if (!ub_call_id(arg, &id))
+		return -1;
+	ret = ub_find_call(id, path, sizeof(path));
+	if (ret < 0)
+		return -1;
+	if (ret)
+		return ub_fail("Call %u not found", id);
+
+	return ub_invoke(path, method, NULL, NULL);
+}
+
+static int cmd_voice_end_call(char *arg)
+{
+	return ub_call_method(arg, "hangup");
+}
+
+static int cmd_voice_answer_call(char *arg)
+{
+	return ub_call_method(arg, "accept");
+}
+
+/* the "calls" of --voice-get-all-call-info and of the indications of the active calls */
+static int ub_add_calls(struct blob_buf *b, const char *name)
+{
+	struct blob_attr *m, *r, *cur;
+	const char *mode;
+	size_t rem;
+	void *a, *t;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+	mode = uqmi_ub_call_mode_name(jarray_first(m, "access_technologies"));
+	if (ub_modem("voice_list_calls", NULL, &r)) {
+		free(m);
+		return -1;
+	}
+
+	a = blobmsg_open_array(b, name);
+	blobmsg_for_each_attr(cur, jget(r, "calls"), rem) {
+		struct blob_attr *c;
+		const char *st, *num;
+		int64_t id;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || ub_invoke(blobmsg_get_string(cur), "get", NULL, &c))
+			continue;
+		st = jstr(c, "state");
+		/* the calls the modem knows: the ended ones have no call id any more */
+		if (jint(c, "qmi_call_id", &id) && id && st && strcmp(st, "terminated") && strcmp(st, "unknown")) {
+			t = blobmsg_open_table(b, NULL);
+			blobmsg_add_u32(b, "id", id);
+			blobmsg_add_string(b, "state", uqmi_ub_call_state_name(st));
+			blobmsg_add_string(b, "type", "voice");
+			blobmsg_add_string(b, "direction", uqmi_ub_call_direction_name(jstr(c, "direction")));
+			blobmsg_add_string(b, "mode", mode);
+			num = jstr(c, "number");
+			if (num && *num)
+				blobmsg_add_string(b, "number", num);
+			blobmsg_close_table(b, t);
+		}
+		free(c);
+	}
+	blobmsg_close_array(b, a);
+	free(r);
+	free(m);
+
+	return 0;
+}
+
+static int cmd_voice_get_all_call_info(char *arg)
+{
+	return ub_add_calls(&status, NULL);
+}
+
+static int cmd_voice_burst_dtmf(char *arg)
+{
+	uint32_t id;
+	const char *digits = uqmi_ub_split_call_arg(arg, &id);
+
+	if (!digits)
+		return ub_fail("Invalid argument (expected <id>,<value>)");
+	if (strlen(digits) > 0xff)
+		return ub_fail("Too many digits");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_u32(&args, "call_id", id);
+	blobmsg_add_string(&args, "digits", digits);
+	return ub_modem("voice_burst_dtmf", &args, NULL);
+}
+
+static int cmd_voice_start_dtmf(char *arg)
+{
+	char path[UB_PATH_LEN];
+	uint32_t id;
+	const char *digit = uqmi_ub_split_call_arg(arg, &id);
+	int ret;
+
+	if (!digit)
+		return ub_fail("Invalid argument (expected <id>,<value>)");
+	if (digit[1])
+		return ub_fail("Only a single digit is allowed");
+	ret = ub_find_call(id, path, sizeof(path));
+	if (ret < 0)
+		return -1;
+	if (ret)
+		return ub_fail("Call %u not found", id);
+
+	/* uqmid sends the digit for 500 ms (start and stop continuous DTMF) */
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "dtmf", digit);
+	return ub_invoke(path, "send_dtmf", &args, NULL);
+}
+
+static int cmd_voice_stop_dtmf(char *arg)
+{
+	uint32_t id;
+	char path[UB_PATH_LEN];
+	int ret;
+
+	if (!ub_call_id(arg, &id))
+		return -1;
+	ret = ub_find_call(id, path, sizeof(path));
+	if (ret < 0)
+		return -1;
+	if (ret)
+		return ub_fail("Call %u not found", id);
+
+	/* the tone of send_dtmf is stopped by uqmid itself */
+	return 0;
+}
+
+static struct ubus_subscriber ub_subscriber;
+static struct uloop_timeout ub_ind_timer;
+static struct blob_buf ub_ind_buf;
+
+/* one line per call state change: {"event":"all_call_status","calls":[...]} */
+static void ub_ind_timer_cb(struct uloop_timeout *t)
+{
+	char *str;
+
+	blob_buf_init(&ub_ind_buf, 0);
+	blobmsg_add_string(&ub_ind_buf, "event", "all_call_status");
+	if (ub_add_calls(&ub_ind_buf, "calls"))
+		return;
+
+	str = blobmsg_format_json_indent(ub_ind_buf.head, true, -1);
+	if (str) {
+		printf("%s\n", str);
+		fflush(stdout);
+		free(str);
+	}
+}
+
+static int ub_notify_cb(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req,
+			const char *method, struct blob_attr *msg)
+{
+	if (!strncmp(method, "voice.call_", 11))
+		uloop_timeout_set(&ub_ind_timer, 20);
+	return 0;
+}
+
+static int cmd_voice_indications(char *arg)
+{
+	ub_ind_timer.cb = ub_ind_timer_cb;
+	ub_subscriber.cb = ub_notify_cb;
+
+	ubus_add_uloop(G.ctx);
+	if (ubus_register_subscriber(G.ctx, &ub_subscriber))
+		return ub_fail("Failed to register the ubus subscriber");
+	if (ubus_subscribe(G.ctx, &ub_subscriber, G.modem_id))
+		return ub_fail("Failed to subscribe to %s", G.modem);
+
+	/* runs until -t expires or SIGINT / SIGTERM */
+	uloop_run();
+	uloop_timeout_cancel(&ub_ind_timer);
+	blob_buf_free(&ub_ind_buf);
+
+	return 0;
+}

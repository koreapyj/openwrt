 	ELSE(BUILD_STATIC)
 		FIND_LIBRARY(talloc_library NAMES talloc)
-		FIND_LIBRARY(ubus_library NAMES ubus)
 	ENDIF(BUILD_STATIC)
 
 	ADD_SUBDIRECTORY(uqmid)

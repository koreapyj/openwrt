+/* a 3gpp type argument of --get-profile-list, --create-profile and --get-default-profile */
+static int ub_profile_type_arg(const char *arg)
+{
+	if (!strcasecmp(arg, "3gpp"))
+		return 0;
+	if (!strcasecmp(arg, "3gpp2"))
+		return ub_fail("3gpp2 profiles: not available with --uqmid");
+	return ub_fail("Invalid value (valid: 3gpp or 3gpp2)");
+}
+
+static int cmd_get_profile_list(char *arg)
+{
+	struct blob_attr *r, *cur;
+	size_t rem;
+	void *root, *p, *t;
+	const char *name;
+
+	if (ub_profile_type_arg(arg))
+		return -1;
+	if (ub_modem("profile_list", NULL, &r))
+		return -1;
+
+	root = blobmsg_open_table(&status, NULL);
+	p = blobmsg_open_array(&status, "profiles");
+	blobmsg_for_each_attr(cur, jget(r, "profiles"), rem) {
+		t = blobmsg_open_table(&status, NULL);
+		blobmsg_add_u32(&status, "index", jint_or(cur, "profile_id", 0));
+		name = jstr(cur, "profile_name");
+		blobmsg_add_string(&status, "name", name ? name : "");
+		blobmsg_close_table(&status, t);
+	}
+	blobmsg_close_array(&status, p);
+	blobmsg_close_table(&status, root);
+	free(r);
+
+	return 0;
+}
+
+/* the profile of the list with that index (a copy of the table), NULL if there is none */
+static int ub_get_profile(uint32_t index, struct blob_attr **profile)
+{
+	struct blob_attr *r, *cur;
+	size_t rem;
+
+	*profile = NULL;
+	if (ub_modem("profile_list", NULL, &r))
+		return -1;
+	blobmsg_for_each_attr(cur, jget(r, "profiles"), rem) {
+		if ((uint32_t) jint_or(cur, "profile_id", -1) == index) {
+			*profile = blob_memdup(cur);
+			break;
+		}
+	}
+	free(r);
+
+	return 0;
+}
+
+static int cmd_get_profile_settings(char *arg)
+{
+	struct blob_attr *p;
+	uint32_t index;
+	const char *s;
+	void *t;
+
+	if (ub_profile_arg(arg, &index) || ub_get_profile(index, &p))
+		return -1;
+	if (!p)
+		return ub_fail("Profile %u not found", index);
+
+	t = blobmsg_open_table(&status, NULL);
+	s = jstr(p, "apn");
+	blobmsg_add_string(&status, "apn", s ? s : "");
+	s = jstr(p, "ip_type");
+	if (s && (!strcmp(s, "ipv4") || !strcmp(s, "ipv6") || !strcmp(s, "ipv4v6")))
+		blobmsg_add_string(&status, "pdp-type", s);
+	s = jstr(p, "user");
+	blobmsg_add_string(&status, "username", s ? s : "");
+	s = jstr(p, "password");
+	blobmsg_add_string(&status, "password", s ? s : "");
+	blobmsg_add_string(&status, "auth",
+			   uqmi_ub_auth_cli_name(jarray_has(p, "allowed_auth", "pap"), jarray_has(p, "allowed_auth", "chap")));
+	/* the profile of uqmid has no roaming flag and no APN disabled flag */
+	blobmsg_add_u8(&status, "no-roaming", false);
+	blobmsg_add_u8(&status, "apn-disabled", false);
+	blobmsg_close_table(&status, t);
+	free(p);
+
+	return 0;
+}
+
+/* the "profile" argument of profile_set: the current profile (if any) with the given options on top */
+static void ub_add_profile(struct blob_buf *b, struct blob_attr *cur, bool has_id, uint32_t index)
+{
+	struct blob_attr *attr;
+	size_t rem;
+	void *t = blobmsg_open_table(b, "profile");
+
+	if (cur) {
+		blobmsg_for_each_attr(attr, cur, rem) {
+			const char *n = blobmsg_name(attr);
+
+			if (!strcmp(n, "profile_id") ||
+			    (G.apn && !strcmp(n, "apn")) ||
+			    (G.pdp_type && !strcmp(n, "ip_type")) ||
+			    (G.auth && !strcmp(n, "allowed_auth")) ||
+			    (G.username && !strcmp(n, "user")) ||
+			    (G.password && !strcmp(n, "password")))
+				continue;
+			blobmsg_add_blob(b, attr);
+		}
+	}
+	if (has_id)
+		blobmsg_add_u32(b, "profile_id", index);
+	if (G.apn)
+		blobmsg_add_string(b, "apn", G.apn);
+	if (G.pdp_type)
+		blobmsg_add_string(b, "ip_type", G.pdp_type);
+	if (G.auth)
+		ub_add_auth(b, "allowed_auth", G.auth);
+	if (G.username)
+		blobmsg_add_string(b, "user", G.username);
+	if (G.password)
+		blobmsg_add_string(b, "password", G.password);
+	blobmsg_close_table(b, t);
+}
+
+static int cmd_create_profile(char *arg)
+{
+	struct blob_attr *r;
+	void *t;
+
+	if (ub_profile_type_arg(arg))
+		return -1;
+
+	blob_buf_init(&args, 0);
+	ub_add_profile(&args, NULL, false, 0);
+	if (ub_modem("profile_set", &args, &r))
+		return -1;
+
+	if (jint_or(jget(r, "profile"), "profile_id", -1) >= 0) {
+		t = blobmsg_open_table(&status, NULL);
+		blobmsg_add_u32(&status, "created-profile", jint_or(jget(r, "profile"), "profile_id", 0));
+		blobmsg_close_table(&status, t);
+	}
+	free(r);
+
+	return 0;
+}
+
+static int cmd_modify_profile(char *arg)
+{
+	struct blob_attr *cur;
+	uint32_t index;
+
+	if (ub_profile_arg(arg, &index) || ub_get_profile(index, &cur))
+		return -1;
+	if (!cur)
+		return ub_fail("Profile %u not found", index);
+
+	/* profile_set replaces the profile: the fields which were not given stay as they are */
+	blob_buf_init(&args, 0);
+	ub_add_profile(&args, cur, true, index);
+	free(cur);
+
+	return ub_modem("profile_set", &args, NULL);
+}
+
+static int cmd_delete_profile(char *arg)
+{
+	uint32_t index;
+
+	if (ub_profile_arg(arg, &index))
+		return -1;
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_u32(&args, "profile_id", index);
+	return ub_modem("profile_delete", &args, NULL);
+}
+
+static int cmd_get_default_profile(char *arg)
+{
+	struct blob_attr *m;
+	int64_t id;
+	void *t;
+	int ret = 0;
+
+	if (ub_profile_type_arg(arg) || ub_modem("get", NULL, &m))
+		return -1;
+
+	/* the default (attach) profile of the modem: the profile of the initial EPS bearer settings */
+	if (jint(jget(m, "initial_eps_bearer_settings"), "profile_id", &id)) {
+		t = blobmsg_open_table(&status, NULL);
+		blobmsg_add_u32(&status, "default-profile", id);
+		blobmsg_close_table(&status, t);
+	} else {
+		ret = ub_fail("Default profile not known");
+	}
+	free(m);
+
+	return ret;
+}

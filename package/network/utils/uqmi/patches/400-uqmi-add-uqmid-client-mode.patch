+static int cmd_set_autoconnect_settings(char *arg)
+{
+	uint8_t st;
+
+	if (!ext_wds_autoconnect_parse(arg, &st))
+		return ub_fail("Invalid value (valid: disabled, enabled, paused)");
+
+	blob_buf_init(&args, 0);
+	blobmsg_add_string(&args, "status", arg);
+	return ub_modem("wds_set_autoconnect", &args, NULL);
+}

--- /dev/null
+++ b/common/test/test_ubus_map.c
@@ -0,0 +1,162 @@
+/* host test: the argument / value translation of uqmi --uqmid (uqmi/ubus-map.c) */
+#include <stdio.h>
+#include <string.h>
+#include "ubus-map.h"
+
+static int fails;
+
+#define CHECK(cond) do { if (!(cond)) { printf("FAIL line %d: %s\n", __LINE__, #cond); fails++; } } while (0)
+#define STREQ(a, b) CHECK(!strcmp((a), (b)))
+
+int main(void)
+{
+	const char *names[UB_MAX_MODES], *s;
+	unsigned int n, mcc, mnc;
+	uint32_t v;
+	uint8_t raw[8];
+	char buf[16];
+
+	/* device matching of uqmid.proto.sh */
+	CHECK(uqmi_ub_device_match("/dev/wwan0qmi0", "/dev/wwan0qmi0", "wwan0qmi0", "/sys/devices/x"));
+	CHECK(uqmi_ub_device_match("wwan0qmi0", "/dev/wwan0qmi0", "wwan0qmi0", NULL));
+	CHECK(uqmi_ub_device_match("/dev/wwan0qmi0", NULL, "wwan0qmi0", NULL));
+	CHECK(uqmi_ub_device_match("cdc-wdm0", "/dev/cdc-wdm0", "cdc-wdm0", NULL));
+	CHECK(uqmi_ub_device_match("/sys/devices/x", "/dev/cdc-wdm0", "cdc-wdm0", "/sys/devices/x"));
+	CHECK(!uqmi_ub_device_match("/dev/cdc-wdm1", "/dev/cdc-wdm0", "cdc-wdm0", "/sys/devices/x"));
+	CHECK(!uqmi_ub_device_match("", "/dev/cdc-wdm0", "cdc-wdm0", NULL));
+	CHECK(!uqmi_ub_device_match(NULL, "/dev/cdc-wdm0", "cdc-wdm0", NULL));
+
+	CHECK(uqmi_ub_path_index("uqmid.modem.2.bearer.17", "bearer", &v) && v == 17);
+	CHECK(uqmi_ub_path_index("uqmid.modem.2", "modem", &v) && v == 2);
+	CHECK(!uqmi_ub_path_index("uqmid.modem.2", "bearer", &v));
+	CHECK(!uqmi_ub_path_index("uqmid.modem.2.bearer.x", "bearer", &v));
+
+	/* operating modes */
+	CHECK(uqmi_ub_opmode_to_power("online", &s) == 0); STREQ(s, "on");
+	CHECK(uqmi_ub_opmode_to_power("low_power", &s) == 0); STREQ(s, "low");
+	CHECK(uqmi_ub_opmode_to_power("persistent_low_power", &s) == 0); STREQ(s, "low");
+	CHECK(uqmi_ub_opmode_to_power("offline", &s) == 0); STREQ(s, "off");
+	CHECK(uqmi_ub_opmode_to_power("reset", &s) == 1);
+	CHECK(uqmi_ub_opmode_to_power("factory_test", &s) == UB_MAP_NA);
+	CHECK(uqmi_ub_opmode_to_power("bogus", &s) == UB_MAP_INVALID);
+	STREQ(uqmi_ub_power_to_opmode("on"), "online");
+	STREQ(uqmi_ub_power_to_opmode("low"), "low_power");
+	STREQ(uqmi_ub_power_to_opmode("off"), "offline");
+	STREQ(uqmi_ub_power_to_opmode("unknown"), "unknown");
+	STREQ(uqmi_ub_power_to_opmode(NULL), "unknown");
+
+	/* network modes */
+	CHECK(uqmi_ub_parse_network_modes("lte,umts", names, &n) == 0 && n == 2);
+	STREQ(names[0], "4g"); STREQ(names[1], "3g");
+	CHECK(uqmi_ub_parse_network_modes("gsm,gsm", names, &n) == 0 && n == 1);
+	CHECK(uqmi_ub_parse_network_modes("lte,all", names, &n) == 0 && n == 1);
+	STREQ(names[0], "any");
+	CHECK(uqmi_ub_parse_network_modes("5gnr", names, &n) == 0 && n == 1);
+	STREQ(names[0], "5g");
+	CHECK(uqmi_ub_parse_network_modes("cdma", names, &n) == UB_MAP_NA);
+	CHECK(uqmi_ub_parse_network_modes("lte,foo", names, &n) == UB_MAP_INVALID);
+	CHECK(uqmi_ub_parse_network_modes("", names, &n) == UB_MAP_INVALID);
+	STREQ(uqmi_ub_preferred_mode("gsm"), "2g");
+	STREQ(uqmi_ub_preferred_mode("wcdma"), "3g");
+	STREQ(uqmi_ub_preferred_mode("auto"), "none");
+
+	/* auth, ip family, pdp type */
+	CHECK(uqmi_ub_auth_names("both", names) == 2); STREQ(names[0], "pap"); STREQ(names[1], "chap");
+	CHECK(uqmi_ub_auth_names("CHAP", names) == 1); STREQ(names[0], "chap");
+	CHECK(uqmi_ub_auth_names("none", names) == 1); STREQ(names[0], "none");
+	CHECK(uqmi_ub_auth_names("eap", names) == UB_MAP_INVALID);
+	STREQ(uqmi_ub_auth_cli_name(true, true), "both");
+	STREQ(uqmi_ub_auth_cli_name(true, false), "pap");
+	STREQ(uqmi_ub_auth_cli_name(false, true), "chap");
+	STREQ(uqmi_ub_auth_cli_name(false, false), "none");
+	CHECK(uqmi_ub_ip_family_to_ip_type("ipv6", &s) == 0); STREQ(s, "ipv6");
+	CHECK(uqmi_ub_ip_family_to_ip_type("unspecified", &s) == 0); STREQ(s, "");
+	CHECK(uqmi_ub_ip_family_to_ip_type("ipv4v6", &s) == UB_MAP_INVALID);
+	CHECK(uqmi_ub_pdp_to_ip_type("ipv4v6", &s) == 0); STREQ(s, "ipv4v6");
+	CHECK(uqmi_ub_pdp_to_ip_type("ppp", &s) == UB_MAP_NA);
+	CHECK(uqmi_ub_pdp_to_ip_type("x", &s) == UB_MAP_INVALID);
+
+	/* PLMN */
+	CHECK(uqmi_ub_plmn_operator_id("450", "06", buf, sizeof(buf))); STREQ(buf, "45006");
+	CHECK(uqmi_ub_plmn_operator_id("450", "6", buf, sizeof(buf))); STREQ(buf, "45006");
+	CHECK(uqmi_ub_plmn_operator_id("310", "260", buf, sizeof(buf))); STREQ(buf, "310260");
+	CHECK(uqmi_ub_plmn_operator_id("310", "026", buf, sizeof(buf))); STREQ(buf, "310026");
+	CHECK(!uqmi_ub_plmn_operator_id("4500", "06", buf, sizeof(buf)));
+	CHECK(!uqmi_ub_plmn_operator_id("450", "x", buf, sizeof(buf)));
+	CHECK(!uqmi_ub_plmn_operator_id("450", NULL, buf, sizeof(buf)));
+	CHECK(uqmi_ub_plmn_split("45006", &mcc, &mnc) && mcc == 450 && mnc == 6);
+	CHECK(uqmi_ub_plmn_split("310260", &mcc, &mnc) && mcc == 310 && mnc == 260);
+	CHECK(!uqmi_ub_plmn_split("4500", &mcc, &mnc));
+	CHECK(!uqmi_ub_plmn_split("", &mcc, &mnc));
+
+	/* radio, registration, storage */
+	STREQ(uqmi_ub_radio_of_access_tech("lte"), "lte");
+	STREQ(uqmi_ub_radio_of_access_tech("hsdpa"), "umts");
+	STREQ(uqmi_ub_radio_of_access_tech("edge"), "gsm");
+	CHECK(!uqmi_ub_radio_of_access_tech("unknown"));
+	CHECK(!uqmi_ub_radio_of_access_tech(NULL));
+	STREQ(uqmi_ub_registration_name("home"), "registered");
+	STREQ(uqmi_ub_registration_name("roaming"), "registered");
+	STREQ(uqmi_ub_registration_name("searching"), "searching");
+	STREQ(uqmi_ub_registration_name("idle"), "not_registered");
+	STREQ(uqmi_ub_registration_name("denied"), "registering_denied");
+	STREQ(uqmi_ub_registration_name("unknown"), "unknown");
+	STREQ(uqmi_ub_storage_name("sim"), "sm");
+	STREQ(uqmi_ub_storage_name("me"), "me");
+	CHECK(!uqmi_ub_storage_name("x"));
+
+	/* voice */
+	STREQ(uqmi_ub_call_state_name("dialing"), "origination");
+	STREQ(uqmi_ub_call_state_name("ringing-out"), "alerting");
+	STREQ(uqmi_ub_call_state_name("ringing-in"), "incoming");
+	STREQ(uqmi_ub_call_state_name("active"), "conversation");
+	STREQ(uqmi_ub_call_state_name("held"), "hold");
+	STREQ(uqmi_ub_call_state_name("terminated"), "end");
+	STREQ(uqmi_ub_call_state_name("bogus"), "unknown");
+	STREQ(uqmi_ub_call_direction_name("incoming"), "mt");
+	STREQ(uqmi_ub_call_direction_name("outgoing"), "mo");
+	STREQ(uqmi_ub_call_direction_name("unknown"), "unknown");
+	STREQ(uqmi_ub_call_mode_name("lte"), "lte");
+	STREQ(uqmi_ub_call_mode_name("hspa"), "umts");
+	STREQ(uqmi_ub_call_mode_name(NULL), "unknown");
+	CHECK((s = uqmi_ub_split_call_arg("3,1234", &v)) && v == 3); STREQ(s, "1234");
+	CHECK(!uqmi_ub_split_call_arg("3,", &v));
+	CHECK(!uqmi_ub_split_call_arg("300,1", &v));
+	CHECK(!uqmi_ub_split_call_arg("x,1", &v));
+	CHECK(!uqmi_ub_split_call_arg("", &v));
+
+	/* numbers */
+	CHECK(uqmi_ub_parse_profile_id("3gpp,2", &v) == 0 && v == 2);
+	CHECK(uqmi_ub_parse_profile_id("3GPP,0x10", &v) == 0 && v == 16);
+	CHECK(uqmi_ub_parse_profile_id("3gpp2,1", &v) == UB_MAP_NA);
+	CHECK(uqmi_ub_parse_profile_id("3gpp", &v) == UB_MAP_INVALID);
+	CHECK(uqmi_ub_parse_profile_id("lte,1", &v) == UB_MAP_INVALID);
+	CHECK(uqmi_ub_parse_profile_id("3gpp,1x", &v) == UB_MAP_INVALID);
+	CHECK(uqmi_ub_parse_uint("255", 255, &v) && v == 255);
+	CHECK(!uqmi_ub_parse_uint("256", 255, &v));
+	CHECK(!uqmi_ub_parse_uint("-1", 255, &v));
+	CHECK(!uqmi_ub_parse_uint("", 255, &v));
+	CHECK(uqmi_ub_parse_hex("0000002A", &v) && v == 42);
+	CHECK(!uqmi_ub_parse_hex("zz", &v));
+	CHECK(!uqmi_ub_parse_hex(NULL, &v));
+	CHECK(uqmi_ub_parse_cell_hex("1A2B3C", &v) && v == 0x1a2b3c);
+	CHECK(uqmi_ub_prefix_to_mask(24) == 0xffffff00u);
+	CHECK(uqmi_ub_prefix_to_mask(0) == 0);
+	CHECK(uqmi_ub_prefix_to_mask(32) == 0xffffffffu);
+	CHECK(uqmi_ub_prefix_to_mask(30) == 0xfffffffcu);
+	CHECK(uqmi_ub_round(-95.4) == -95);
+	CHECK(uqmi_ub_round(-95.6) == -96);
+	CHECK(uqmi_ub_ecio_raw(-7.5) == 15);
+	CHECK(uqmi_ub_ecio_raw(0) == 0);
+
+	/* raw message of --get-raw-message */
+	CHECK(uqmi_ub_parse_raw_sms("07 91 28", raw, sizeof(raw)) == 3 && raw[0] == 0x07 && raw[1] == 0x91 && raw[2] == 0x28);
+	CHECK(uqmi_ub_parse_raw_sms("", raw, sizeof(raw)) == 0);
+	CHECK(uqmi_ub_parse_raw_sms("0g", raw, sizeof(raw)) == -1);
+	CHECK(uqmi_ub_parse_raw_sms("0 1", raw, sizeof(raw)) == -1);
+	CHECK(uqmi_ub_parse_raw_sms("00 01 02 03 04 05 06 07 08", raw, sizeof(raw)) == -1);
+
+	if (!fails)
+		printf("ok\n");
+	return fails ? 1 : 0;
+}

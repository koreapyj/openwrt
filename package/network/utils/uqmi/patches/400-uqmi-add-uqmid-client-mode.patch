+
+/* the selection preferences which were given (the hidden --__set-system-selection of the direct mode) */
+static int ub_run_pending_selection(void)
+{
+	bool modes = G.modes || G.preference;
+
+	if ((modes || G.plmn_pending) && G.duration && !strcmp(G.duration, "power-cycle"))
+		return ub_fail("--network-change-duration power-cycle: not available with --uqmid");
+
+	if (modes) {
+		const char *names[UB_MAX_MODES];
+		const char *preferred = "none";
+		struct blob_attr *m = NULL, *cur_modes = NULL;
+		unsigned int n = 0, i;
+		void *a;
+
+		if (ub_modem("get", NULL, &m))
+			return -1;
+		cur_modes = jget(m, "current_modes");
+
+		if (G.modes) {
+			uqmi_ub_parse_network_modes(G.modes, names, &n);
+			/* the order preference of the modem stays if it is still allowed */
+			if (!G.preference) {
+				const char *cur = jstr(cur_modes, "preferred");
+
+				for (i = 0; cur && i < n; i++) {
+					if (!strcmp(cur, names[i]))
+						preferred = cur;
+				}
+			}
+		}
+		if (G.preference)
+			preferred = uqmi_ub_preferred_mode(G.preference);
+
+		blob_buf_init(&args, 0);
+		a = blobmsg_open_array(&args, "allowed");
+		if (G.modes) {
+			for (i = 0; i < n; i++)
+				blobmsg_add_string(&args, NULL, names[i]);
+		} else {
+			/* only the acquisition order changes: the allowed modes stay */
+			struct blob_attr *cur;
+			size_t rem;
+
+			blobmsg_for_each_attr(cur, jget(cur_modes, "allowed"), rem) {
+				if (blobmsg_type(cur) == BLOBMSG_TYPE_STRING)
+					blobmsg_add_string(&args, NULL, blobmsg_get_string(cur));
+			}
+		}
+		blobmsg_close_array(&args, a);
+		blobmsg_add_string(&args, "preferred", preferred);
+		free(m);
+
+		if (ub_modem("set_current_modes", &args, NULL))
+			return -1;
+	}
+
+	if (G.roaming) {
+		blob_buf_init(&args, 0);
+		blobmsg_add_string(&args, "roaming", G.roaming);
+		if (G.duration)
+			blobmsg_add_string(&args, "duration", G.duration);
+		if (ub_modem("nas_set_network_roaming", &args, NULL))
+			return -1;
+	}
+
+	if (G.plmn_pending) {
+		char id[16] = "";
+
+		if (ub_mcc_nonzero() && !uqmi_ub_plmn_operator_id(G.mcc, G.mnc, id, sizeof(id)))
+			return ub_fail("Invalid MCC/MNC value");
+
+		/* an empty operator id is the automatic selection */
+		blob_buf_init(&args, 0);
+		if (id[0])
+			blobmsg_add_string(&args, "operator_id", id);
+		if (ub_modem("register", &args, NULL))
+			return -1;
+	}
+
+	return 0;
+}
+
+static void ub_add_signal_tables(struct blob_attr *sig)
+{
+	struct blob_attr *cdma = jget(sig, "cdma"), *evdo = jget(sig, "evdo"), *gsm = jget(sig, "gsm");
+	struct blob_attr *umts = jget(sig, "umts"), *lte = jget(sig, "lte"), *nr = jget(sig, "nr5g");
+	bool endc = lte && nr;
+	double v;
+	void *a = NULL, *c;
+
+	/* the shape of the direct mode: one table, an array of two with EN-DC */
+	if (endc)
+		a = blobmsg_open_array(&status, NULL);
+
+	c = blobmsg_open_table(&status, NULL);
+	if (cdma) {
+		blobmsg_add_string(&status, "type", "cdma");
+		blobmsg_add_u32(&status, "rssi", jnum(cdma, "rssi", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_u32(&status, "ecio", jnum(cdma, "ecio", &v) ? uqmi_ub_ecio_raw(v) : 0);
+	}
+	if (evdo) {
+		blobmsg_add_string(&status, "type", "hdr");
+		blobmsg_add_u32(&status, "rssi", jnum(evdo, "rssi", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_u32(&status, "ecio", jnum(evdo, "ecio", &v) ? uqmi_ub_ecio_raw(v) : 0);
+		blobmsg_add_u32(&status, "io", jnum(evdo, "io", &v) ? uqmi_ub_round(v) : 0);
+	}
+	if (gsm) {
+		blobmsg_add_string(&status, "type", "gsm");
+		blobmsg_add_u32(&status, "signal", jnum(gsm, "rssi", &v) ? uqmi_ub_round(v) : 0);
+	}
+	if (umts) {
+		blobmsg_add_string(&status, "type", "wcdma");
+		blobmsg_add_u32(&status, "rssi", jnum(umts, "rssi", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_u32(&status, "ecio", jnum(umts, "ecio", &v) ? uqmi_ub_ecio_raw(v) : 0);
+	}
+	if (lte) {
+		blobmsg_add_string(&status, "type", "lte");
+		blobmsg_add_u32(&status, "rssi", jnum(lte, "rssi", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_u32(&status, "rsrq", jnum(lte, "rsrq", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_u32(&status, "rsrp", jnum(lte, "rsrp", &v) ? uqmi_ub_round(v) : 0);
+		blobmsg_add_double(&status, "snr", jnum(lte, "snr", &v) ? v : 0);
+	}
+	if (nr) {
+		if (endc) {
+			blobmsg_close_table(&status, c);
+			c = blobmsg_open_table(&status, NULL);
+		}
+		blobmsg_add_string(&status, "type", "5gnr");
+		if (jnum(nr, "rsrp", &v))
+			blobmsg_add_u32(&status, "rsrp", uqmi_ub_round(v));
+		if (jnum(nr, "snr", &v))
+			blobmsg_add_double(&status, "snr", v);
+		if (jnum(nr, "rsrq", &v))
+			blobmsg_add_u32(&status, "rsrq", uqmi_ub_round(v));
+	}
+	blobmsg_close_table(&status, c);
+
+	if (endc)
+		blobmsg_close_array(&status, a);
+}
+
+static bool ub_signal_has_values(struct blob_attr *sig)
+{
+	static const char *const techs[] = { "cdma", "evdo", "gsm", "umts", "lte", "nr5g" };
+	unsigned int i;
+
+	for (i = 0; i < sizeof(techs) / sizeof(techs[0]); i++) {
+		if (jget(sig, techs[i]))
+			return true;
+	}
+	return false;
+}
+
+static int cmd_get_signal_info(char *arg)
+{
+	struct blob_attr *sig = NULL;
+	bool temp = false;
+	int ret = 0;
+	unsigned int i;
+
+	if (ub_modem("signal_get", NULL, &sig))
+		return -1;
+
+	/*
+	 * uqmid only keeps the values while a refresh rate or a threshold is set: use a refresh rate for the
+	 * time of the request if there is none
+	 */
+	if (!ub_signal_has_values(sig) && !jint_or(sig, "rate", 0) && !jint_or(sig, "rssi_threshold", 0)) {
+		blob_buf_init(&args, 0);
+		blobmsg_add_u32(&args, "rate", 30);
+		if (ub_modem("signal_setup", &args, NULL)) {
+			free(sig);
+			return -1;
+		}
+		temp = true;
+		for (i = 0; i < 10; i++) {
+			usleep(500 * 1000);
+			free(sig);
+			sig = NULL;
+			if (ub_modem("signal_get", NULL, &sig)) {
+				ret = -1;
+				break;
+			}
+			if (ub_signal_has_values(sig))
+				break;
+		}
+	}
+
+	if (!ret) {
+		if (ub_signal_has_values(sig))
+			ub_add_signal_tables(sig);
+		else
+			blobmsg_close_table(&status, blobmsg_open_table(&status, NULL));
+	}
+	free(sig);
+
+	if (temp) {
+		blob_buf_init(&args, 0);
+		blobmsg_add_u32(&args, "rate", 0);
+		ub_modem("signal_setup", &args, NULL);
+	}
+
+	return ret;
+}
+
+static bool ub_registered(const char *s)
+{
+	return s && (!strncmp(s, "home", 4) || !strncmp(s, "roaming", 7));
+}
+
+static int cmd_get_serving_system(char *arg)
+{
+	struct blob_attr *m, *tech;
+	const char *reg, *code, *name;
+	unsigned int mcc, mnc;
+	size_t rem;
+	void *c, *a;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+
+	reg = jstr(m, "registration_state");
+	code = jstr(m, "operator_code");
+	name = jstr(m, "operator_name");
+
+	c = blobmsg_open_table(&status, NULL);
+	blobmsg_add_string(&status, "registration", uqmi_ub_registration_name(reg));
+	a = blobmsg_open_array(&status, "radio_interface");
+	blobmsg_for_each_attr(tech, jget(m, "access_technologies"), rem) {
+		const char *radio = blobmsg_type(tech) == BLOBMSG_TYPE_STRING ?
+				    uqmi_ub_radio_of_access_tech(blobmsg_get_string(tech)) : NULL;
+
+		if (radio)
+			blobmsg_add_string(&status, "radio", radio);
+	}
+	blobmsg_close_array(&status, a);
+	if (code && uqmi_ub_plmn_split(code, &mcc, &mnc)) {
+		blobmsg_add_u32(&status, "plmn_mcc", mcc);
+		blobmsg_add_u32(&status, "plmn_mnc", mnc);
+		if (name && *name)
+			blobmsg_add_string(&status, "plmn_description", name);
+	}
+	if (ub_registered(reg))
+		blobmsg_add_u8(&status, "roaming", !strncmp(reg, "roaming", 7));
+	blobmsg_close_table(&status, c);
+	free(m);
+
+	return 0;
+}
+
+static int cmd_get_system_info(char *arg)
+{
+	struct blob_attr *m, *tech;
+	const char *reg, *code;
+	size_t rem;
+	void *t, *c;
+
+	if (ub_modem("get", NULL, &m))
+		return -1;
+
+	reg = jstr(m, "registration_state");
+	code = jstr(m, "operator_code");
+
+	/*
+	 * Reduced form: only the registration and the PLMN are known to uqmid (no domain, no cell, no tracking
+	 * area), for the radio interfaces the modem is using
+	 */
+	t = blobmsg_open_table(&status, NULL);
+	if (ub_registered(reg)) {
+		blobmsg_for_each_attr(tech, jget(m, "access_technologies"), rem) {
+			const char *radio = blobmsg_type(tech) == BLOBMSG_TYPE_STRING ?
+					    uqmi_ub_radio_of_access_tech(blobmsg_get_string(tech)) : NULL;
+			const char *key = NULL;
+			char mnc[4] = "";
+
+			if (!radio)
+				continue;
+			if (!strcmp(radio, "gsm"))
+				key = "gsm";
+			else if (!strcmp(radio, "umts"))
+				key = "wcdma";
+			else if (!strcmp(radio, "lte") || !strcmp(radio, "5gnr"))
+				key = radio;
+			if (!key)
+				continue;
+
+			c = blobmsg_open_table(&status, key);
+			blobmsg_add_string(&status, "service_status", "available");
+			blobmsg_add_string(&status, "true_service_status", "available");
+			blobmsg_add_string(&status, "roaming_status", !strncmp(reg, "roaming", 7) ? "on" : "off");
+			if (code && strlen(code) >= 5 && strlen(code) <= 6) {
+				char mcc[4];
+
+				memcpy(mcc, code, 3);
+				mcc[3] = '\0';
+				snprintf(mnc, sizeof(mnc), "%s", code + 3);
+				blobmsg_add_string(&status, "mcc", mcc);
+				blobmsg_add_string(&status, "mnc", mnc);
+			}
+			blobmsg_close_table(&status, c);
+		}
+	}
+	blobmsg_close_table(&status, t);
+	free(m);
+
+	return 0;
+}

+static bool ub_cell_hex(struct blob_attr *cell, const char *key, uint32_t *val)
+{
+	const char *s = jstr(cell, key);
+
+	return s && uqmi_ub_parse_cell_hex(s, val);
+}
+
+static void ub_add_lte_cell(struct blob_attr *cell)
+{
+	uint32_t pci = 0;
+	double v;
+	void *c = blobmsg_open_table(&status, NULL);
+
+	ub_cell_hex(cell, "physical_ci", &pci);
+	blobmsg_add_u32(&status, "physical_cell_id", pci);
+	blobmsg_add_double(&status, "rsrq", jnum(cell, "rsrq", &v) ? v : 0);
+	blobmsg_add_double(&status, "rsrp", jnum(cell, "rsrp", &v) ? v : 0);
+	blobmsg_close_table(&status, c);
+}
+
+/*
+ * The direct mode puts the cell tables without a name into the object of the frequency, which is not valid
+ * JSON: here they are the array "cells", and the frequencies of interfrequency_lte_info are an array too.
+ */
+static int cmd_get_cell_location_info(char *arg)
+{
+	struct blob_attr *r, *cells, *cell, *other;
+	int64_t serving_earfcn = -1, earfcn;
+	uint32_t val;
+	size_t rem, rem2;
+	bool have_serving = false;
+	void *t, *c, *freq, *list;
+	double v;
+
+	if (ub_modem("get_cell_info", NULL, &r))
+		return -1;
+
+	cells = jget(r, "cells");
+	t = blobmsg_open_table(&status, NULL);
+
+	/* the serving LTE cell and the intra-frequency cells */
+	blobmsg_for_each_attr(cell, cells, rem) {
+		const char *type = jstr(cell, "cell_type");
+
+		if (type && !strcmp(type, "lte") && jbool(cell, "serving")) {
+			have_serving = true;
+			serving_earfcn = jint_or(cell, "earfcn", -1);
+			c = blobmsg_open_table(&status, "intrafrequency_lte_info");
+			if (ub_cell_hex(cell, "tac", &val))
+				blobmsg_add_u32(&status, "tracking_area_code", val);
+			if (ub_cell_hex(cell, "ci", &val)) {
+				blobmsg_add_u32(&status, "enodeb_id", val / 256);
+				blobmsg_add_u32(&status, "cell_id", val % 256);
+			}
+			if (serving_earfcn >= 0) {
+				blobmsg_add_u32(&status, "channel", serving_earfcn);
+				ext_fmt_earfcn(&status, serving_earfcn);
+			}
+			if (ub_cell_hex(cell, "physical_ci", &val))
+				blobmsg_add_u32(&status, "serving_cell_id", val);
+			list = blobmsg_open_array(&status, "cells");
+			ub_add_lte_cell(cell);
+			blobmsg_for_each_attr(other, cells, rem2) {
+				const char *ot = jstr(other, "cell_type");
+
+				if (other == cell || !ot || strcmp(ot, "lte") || jint_or(other, "earfcn", -2) != serving_earfcn)
+					continue;
+				ub_add_lte_cell(other);
+			}
+			blobmsg_close_array(&status, list);
+			blobmsg_close_table(&status, c);
+			break;
+		}
+	}
+
+	/* the cells of the other frequencies, one table per channel */
+	{
+		int64_t done[16];
+		unsigned int n_done = 0, i;
+		bool open = false;
+
+		blobmsg_for_each_attr(cell, cells, rem) {
+			const char *type = jstr(cell, "cell_type");
+			bool seen = false;
+
+			if (!type || strcmp(type, "lte") || jbool(cell, "serving"))
+				continue;
+			earfcn = jint_or(cell, "earfcn", -1);
+			if (earfcn < 0 || (have_serving && earfcn == serving_earfcn))
+				continue;
+			for (i = 0; i < n_done; i++)
+				seen |= done[i] == earfcn;
+			if (seen || n_done >= 16)
+				continue;
+			done[n_done++] = earfcn;
+
+			if (!open) {
+				c = blobmsg_open_array(&status, "interfrequency_lte_info");
+				open = true;
+			}
+			freq = blobmsg_open_table(&status, NULL);
+			blobmsg_add_u32(&status, "channel", earfcn);
+			ext_fmt_earfcn(&status, earfcn);
+			list = blobmsg_open_array(&status, "cells");
+			blobmsg_for_each_attr(other, cells, rem2) {
+				const char *ot = jstr(other, "cell_type");
+
+				if (ot && !strcmp(ot, "lte") && !jbool(other, "serving") &&
+				    jint_or(other, "earfcn", -1) == earfcn)
+					ub_add_lte_cell(other);
+			}
+			blobmsg_close_array(&status, list);
+			blobmsg_close_table(&status, freq);
+		}
+		if (open)
+			blobmsg_close_array(&status, c);
+	}
+
+	blobmsg_for_each_attr(cell, cells, rem) {
+		const char *type = jstr(cell, "cell_type");
+
+		if (!type || strcmp(type, "nr5g") || !jbool(cell, "serving"))
+			continue;
+		c = blobmsg_open_table(&status, "nr5g_cell_information");
+		if (ub_cell_hex(cell, "ci", &val)) {
+			blobmsg_add_u32(&status, "enodeb_id", val / 256);
+			blobmsg_add_u32(&status, "cell_id", val % 256);
+		}
+		if (ub_cell_hex(cell, "physical_ci", &val))
+			blobmsg_add_u32(&status, "physical_cell_id", val);
+		blobmsg_add_double(&status, "rsrq", jnum(cell, "rsrq", &v) ? v : 0);
+		blobmsg_add_double(&status, "rsrp", jnum(cell, "rsrp", &v) ? v : 0);
+		blobmsg_add_double(&status, "snr", jnum(cell, "sinr", &v) ? v : 0);
+		blobmsg_close_table(&status, c);
+		if (jint(cell, "nrarfcn", &earfcn)) {
+			c = blobmsg_open_table(&status, "nr5g_arfcn");
+			blobmsg_add_u32(&status, "arfcn", earfcn);
+			blobmsg_close_table(&status, c);
+		}
+		break;
+	}
+
+	blobmsg_close_table(&status, t);
+	free(r);
+
+	return 0;
+}

+int uqmi_ub_parse_raw_sms(const char *str, uint8_t *out, size_t max)
+{
+	size_t n = 0;
+
+	while (*str) {
+		unsigned int v;
+		int used;
+
+		if (*str == ' ') {
+			str++;
+			continue;
+		}
+		if (n >= max || sscanf(str, "%2x%n", &v, &used) != 1 || used != 2)
+			return -1;
+		out[n++] = v;
+		str += 2;
+	}
+	return n;
+}

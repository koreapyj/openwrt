+		static const char *names[] = { "ipv4", "ipv6", "ipv4v6" };
+
+		*ip_type = names[!strcasecmp(arg, "ipv6") ? 1 : !strcasecmp(arg, "ipv4v6") ? 2 : 0];
+		return 0;
+	}
+	if (!strcasecmp(arg, "ppp"))
+		return UB_MAP_NA;
+	return UB_MAP_INVALID;

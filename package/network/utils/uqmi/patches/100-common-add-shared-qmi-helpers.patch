+#ifndef __UQMI_SMS_PART_H
+#define __UQMI_SMS_PART_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * One SMS PDU (ModemManager: MMSmsPart, mm-sms-part.c and mm-sms-part-3gpp.c). Pure C, no dependencies, so the
+ * codec can be tested on the build host.
+ */
+
+#define SMS_PART_INVALID_INDEX 0xffffffffu
+/* a PDU of a part never gets bigger than this (MM: PDU_SIZE) */
+#define SMS_PDU_MAX 200
+/* MMSmsDeliveryState: no delivery state known */
+#define SMS_DELIVERY_STATE_UNKNOWN 0x100
+
+/* MMSmsPduType (the numeric values are the same) */
+enum sms_pdu_type {
+	SMS_PDU_UNKNOWN = 0,
+	SMS_PDU_DELIVER = 1,
+	SMS_PDU_SUBMIT = 2,
+	SMS_PDU_STATUS_REPORT = 3,
+};
+
+/* MMSmsEncoding (the numeric values are the same) */
+enum sms_encoding {
+	SMS_ENC_UNKNOWN = 0,
+	SMS_ENC_GSM7 = 1,
+	SMS_ENC_8BIT = 2,
+	SMS_ENC_UCS2 = 3,
+};
+
+struct sms_part {
+	unsigned int index;
+	enum sms_pdu_type pdu_type;
+	enum sms_encoding encoding;
+	char *smsc;
+	char *number;
+	/* ISO8601: YYYY-MM-DDTHH:MM:SS+HH:MM */
+	char *timestamp;
+	char *discharge_timestamp;
+	/* UTF-8 */
+	char *text;
+	uint8_t *data;
+	size_t data_len;
+	/* -1 if not used */
+	int class;
+	/* minutes, 0 if no validity period */
+	unsigned int validity_relative;
+	bool delivery_report_request;
+	unsigned int message_reference;
+	/* not a MMSmsDeliveryState, the TP-STATUS */
+	unsigned int delivery_state;
+	bool should_concat;
+	unsigned int concat_reference;
+	unsigned int concat_max;
+	unsigned int concat_sequence;
+
+	/* list of the parts of a message, sorted by the concat sequence (owned by the message) */
+	struct sms_part *next;
+};
+
+struct sms_part *sms_part_new(unsigned int index, enum sms_pdu_type type);
+void sms_part_free(struct sms_part *part);
+
+/* take over a malloc()ed string / buffer */
+void sms_part_take_text(struct sms_part *part, char *text);
+void sms_part_take_data(struct sms_part *part, uint8_t *data, size_t len);
+/* copy */
+void sms_part_set_number(struct sms_part *part, const char *number);
+void sms_part_set_smsc(struct sms_part *part, const char *smsc);
+
+/*
+ * mm_sms_part_3gpp_new_from_binary_pdu(): decode a SMS-DELIVER, SMS-SUBMIT or SMS-STATUS-REPORT PDU with the
+ * SMSC address in front (@transfer_route: without it). Returns 0 and the part, or -1 and a message in @err.
+ */
+int sms_part_3gpp_from_pdu(unsigned int index, const uint8_t *pdu, size_t len, bool transfer_route,
+			   struct sms_part **out, char *err, size_t errlen);
+
+/*
+ * mm_sms_part_3gpp_get_submit_pdu(): encode a SMS-SUBMIT PDU into @pdu (SMS_PDU_MAX bytes). The text is

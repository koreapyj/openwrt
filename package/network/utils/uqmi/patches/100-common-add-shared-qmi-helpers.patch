+#ifndef __UQMI_CHARSETS_H
+#define __UQMI_CHARSETS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Character set conversions of the SMS codec (ModemManager: mm-charsets.c). Pure C, no dependencies, so the
+ * codec can be tested on the build host.
+ */
+
+/* UTF-8. cs_utf8_decode() returns the number of bytes of the character at @s, 0 if it is not valid UTF-8. */
+size_t cs_utf8_decode(const char *s, size_t len, uint32_t *cp);
+size_t cs_utf8_encode(uint32_t cp, char out[4]);
+bool cs_utf8_valid(const char *s);
+
+/*
+ * GSM 03.38 default alphabet with the extension table. cs_gsm7_char_len() is the number of septets of a code
+ * point (1 default alphabet, 2 extension table), 0 if it can't be represented.
+ */
+unsigned cs_gsm7_char_len(uint32_t cp);
+bool cs_gsm7_can_encode(const char *utf8);
+/* malloc()ed unpacked septets, NULL if the text is not valid UTF-8 or not representable */
+uint8_t *cs_gsm7_from_utf8(const char *utf8, size_t *n_septets);
+/* malloc()ed NUL terminated UTF-8 of unpacked septets */
+char *cs_gsm7_to_utf8(const uint8_t *septets, size_t n);
+/* mm_charset_gsm_unpack(): @bit_offset is in bits. Reads are bounded by @src_len. @out has room for @n_septets. */
+void cs_gsm7_unpack(const uint8_t *src, size_t src_len, size_t n_septets, unsigned bit_offset, uint8_t *out);
+/* mm_charset_gsm_pack(): @out has room for (n * 7 + shift + 7) / 8 bytes, which is returned */
+size_t cs_gsm7_pack(const uint8_t *septets, size_t n, unsigned shift, uint8_t *out);
+
+/* UTF-16 big endian (MM always assumes UTF-16 instead of UCS-2) */
+unsigned cs_utf16_len(uint32_t cp);
+/* malloc()ed, NULL if the text is not valid UTF-8 */
+uint8_t *cs_utf8_to_utf16be(const char *utf8, size_t *len);
+/* malloc()ed NUL terminated UTF-8. Invalid surrogates become U+FFFD, a trailing odd byte is dropped. */
+char *cs_utf16be_to_utf8(const uint8_t *buf, size_t len);
+
+#endif /* __UQMI_CHARSETS_H */

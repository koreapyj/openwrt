+void ext_fmt_wda_data_format(struct blob_buf *b, const struct qmi_wda_get_data_format_response *res)
+{
+	const char *s;
+
+	blobmsg_add_u8(b, "qos-format", res->data.qos_format);
+	s = wds_val_to_name(ext_wda_link_layer_names, ext_wda_link_layer_names_n, res->data.link_layer_protocol);
+	blobmsg_add_string(b, "link-layer-protocol", s ? s : "unknown");
+	s = wds_val_to_name(ext_wda_aggregation_names, ext_wda_aggregation_names_n,
+			    res->data.uplink_data_aggregation_protocol);
+	blobmsg_add_string(b, "data-aggregation-protocol", s ? s : "unknown");
+	blobmsg_add_u32(b, "uplink-data-aggregation-max-datagrams", res->data.uplink_data_aggregation_max_datagrams);
+	blobmsg_add_u32(b, "uplink-data-aggregation-max-size", res->data.uplink_data_aggregation_max_size);
+	s = wds_val_to_name(ext_wda_aggregation_names, ext_wda_aggregation_names_n,
+			    res->data.downlink_data_aggregation_protocol);
+	blobmsg_add_string(b, "downlink-data-aggregation-protocol", s ? s : "unknown");
+	blobmsg_add_u32(b, "downlink-data-aggregation-max-datagrams",
+			res->data.downlink_data_aggregation_max_datagrams);
+	blobmsg_add_u32(b, "downlink-data-aggregation-max-size", res->data.downlink_data_aggregation_max_size);
+	blobmsg_add_u32(b, "download-minimum-padding", res->data.download_minimum_padding);
+	blobmsg_add_u8(b, "flow-control", res->data.flow_control);
+}

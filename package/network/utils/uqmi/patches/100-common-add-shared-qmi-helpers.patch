+
+/* the longest configuration id (bytes) and the buffer size of its hex string incl. the terminator */
+#define PDC_ID_MAX		64
+#define PDC_ID_STR_MAX		(PDC_ID_MAX * 2 + 1)
+
+/*
+ * Load Config chunk size: the SMD transport of the SoC modem drops QMUX messages of 1 KiB and more

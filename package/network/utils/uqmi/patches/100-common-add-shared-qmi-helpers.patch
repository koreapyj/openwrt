+bool voice_dtmf_digit_valid(char c)
+{
+	return c && strchr("0123456789*#ABCDabcd", c);
+}
+
+bool voice_dtmf_valid(const char *s)
+{
+	if (!*s)
+		return false;
+
+	for (; *s; s++) {
+		if (!voice_dtmf_digit_valid(*s))
+			return false;
+	}
+
+	return true;
+}

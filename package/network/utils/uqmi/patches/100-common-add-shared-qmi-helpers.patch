+/*
+ * Host test of the shared SMS codec (charsets.c, sms_part.c). Reference PDUs come from gen_vectors.py, an
+ * independent implementation: test_sms vectors.txt
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "charsets.h"
+#include "sms_part.h"
+
+static int failures, checks;
+
+#define CHECK(cond, ...)                                                                          \
+	do {                                                                                      \
+		checks++;                                                                         \
+		if (!(cond)) {                                                                    \
+			failures++;                                                               \
+			printf("FAIL %s:%d: %s: ", __FILE__, __LINE__, #cond);                    \
+			printf(__VA_ARGS__);                                                      \
+			printf("\n");                                                             \
+		}                                                                                 \
+	} while (0)
+
+static char *vec[64][2];
+static int n_vec;
+
+static const char *getv(const char *name)
+{
+	int i;
+
+	for (i = 0; i < n_vec; i++)
+		if (!strcmp(vec[i][0], name))
+			return vec[i][1];
+	printf("missing vector %s\n", name);
+	exit(2);
+}
+
+static size_t unhex(const char *h, uint8_t *out)
+{
+	size_t n = strlen(h) / 2, i;
+
+	for (i = 0; i < n; i++) {
+		unsigned int v;
+
+		sscanf(h + 2 * i, "%2x", &v);
+		out[i] = v;
+	}
+
+	return n;
+}
+
+static void tohex(const uint8_t *b, size_t n, char *out)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		sprintf(out + 2 * i, "%02X", b[i]);
+	out[2 * n] = 0;
+}
+
+static struct sms_part *decode(const char *name, bool transfer)
+{
+	uint8_t pdu[300];
+	size_t n = unhex(getv(name), pdu);
+	struct sms_part *p = NULL;
+	char err[100] = "";
+	int r = sms_part_3gpp_from_pdu(5, pdu, n, transfer, &p, err, sizeof(err));
+
+	CHECK(r == 0, "%s: %s", name, err);
+	return r ? NULL : p;
+}
+
+static void expect_encode(struct sms_part *p, const char *name)
+{
+	uint8_t pdu[SMS_PDU_MAX];
+	char hex[2 * SMS_PDU_MAX + 1], err[100] = "";
+	size_t n = 0;
+	int r = sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err));
+
+	CHECK(r == 0, "%s: %s", name, err);
+	if (r)
+		return;
+	tohex(pdu, n, hex);
+	CHECK(!strcmp(hex, getv(name)), "%s:\n got %s\n exp %s", name, hex, getv(name));
+}
+
+static void test_decode(void)
+{
+	struct sms_part *p;
+
+	p = decode("deliver_gsm7_hello", false);
+	CHECK(p->pdu_type == SMS_PDU_DELIVER && p->encoding == SMS_ENC_GSM7, "type");
+	CHECK(!strcmp(p->smsc, "+821029190200"), "smsc %s", p->smsc);
+	CHECK(!strcmp(p->number, "+31641600986"), "number %s", p->number);
+	CHECK(!strcmp(p->text, "Hellohello"), "text %s", p->text);
+	CHECK(!strcmp(p->timestamp, "2026-11-19T12:34:56+09:00"), "ts %s", p->timestamp);
+	CHECK(p->class == -1 && !p->should_concat && !p->data, "misc");
+	sms_part_free(p);
+
+	p = decode("deliver_ucs2_ko", false);
+	CHECK(p->encoding == SMS_ENC_UCS2, "enc");
+	CHECK(!strcmp(p->text, "안녕하세요 테스트"), "ko text %s", p->text);
+	CHECK(!strcmp(p->number, "+821012345678"), "number %s", p->number);
+	sms_part_free(p);
+
+	p = decode("deliver_ucs2_emoji_class1", false);
+	CHECK(!strcmp(p->text, "좋아요👍"), "emoji text %s", p->text);
+	CHECK(p->class == 1, "class %d", p->class);
+	sms_part_free(p);
+
+	p = decode("deliver_gsm7_part2_of_2", false);
+	CHECK(p->should_concat && p->concat_reference == 0x2a && p->concat_max == 2 && p->concat_sequence == 2,
+	      "concat %u %u %u", p->concat_reference, p->concat_max, p->concat_sequence);
+	CHECK(!strcmp(p->text, getv("deliver_gsm7_part2_text")), "udh gsm7 text '%s'", p->text);
+	sms_part_free(p);
+
+	p = decode("deliver_ucs2_part1_of_3_16bit", false);
+	CHECK(p->should_concat && p->concat_reference == 0x1234 && p->concat_max == 3 && p->concat_sequence == 1,
+	      "concat16 %u %u %u", p->concat_reference, p->concat_max, p->concat_sequence);
+	CHECK(!strcmp(p->text, "안녕"), "udh ucs2 text '%s'", p->text);
+	sms_part_free(p);
+
+	p = decode("deliver_alpha_sender", false);
+	CHECK(!strcmp(p->number, "KTbill"), "alpha '%s'", p->number);
+	CHECK(!strcmp(p->text, "Hi"), "text");
+	CHECK(!p->smsc, "no smsc");
+	sms_part_free(p);
+
+	p = decode("deliver_8bit_data", false);
+	CHECK(p->encoding == SMS_ENC_8BIT && !p->text && p->data_len == 5 && p->data[3] == 0xff, "8bit");
+	sms_part_free(p);
+
+	p = decode("status_report", false);
+	CHECK(p->pdu_type == SMS_PDU_STATUS_REPORT && p->message_reference == 0x2b, "sr");
+	CHECK(!strcmp(p->discharge_timestamp, "2026-11-19T12:34:58+09:00"), "discharge %s", p->discharge_timestamp);
+	CHECK(p->delivery_state == 0 && !p->text && !p->data, "sr state");
+	sms_part_free(p);
+
+	p = decode("deliver_neg_tz", false);
+	CHECK(!strcmp(p->timestamp, "2026-01-02T03:04:05-05:00"), "neg tz %s", p->timestamp);
+	CHECK(!strcmp(p->number, "+15551234567"), "number %s", p->number);
+	sms_part_free(p);
+
+	/* MM: transfer-route raw data has no leading SMSC field. Pass the actual TPDU unchanged with the flag. */
+	p = decode("transfer_route_deliver_no_smsc", true);
+	CHECK(p->pdu_type == SMS_PDU_DELIVER && p->encoding == SMS_ENC_UCS2, "transfer route type/encoding");
+	CHECK(!strcmp(p->number, "+821012345678"), "transfer route number %s", p->number);
+	CHECK(!strcmp(p->text, "안녕하세요"), "transfer route Korean text %s", p->text);
+	sms_part_free(p);
+
+	/* Extra empty SMSC length (a firmware quirk) is retried only after the no-SMSC parse sees a zero-length OA. */
+	p = decode("transfer_route_deliver_empty_smsc_prefix", true);
+	CHECK(p->pdu_type == SMS_PDU_DELIVER && !strcmp(p->text, "안녕하세요"), "transfer route empty SMSC fallback");
+	sms_part_free(p);
+
+	/* Firmware quirk: a transfer-route message with a full SMSC-prefixed PDU is decoded by the fallback */
+	p = decode("transfer_route_deliver_with_smsc", true);
+	CHECK(p->pdu_type == SMS_PDU_DELIVER && !strcmp(p->text, "안녕하세요"), "transfer route with-SMSC fallback");
+	CHECK(p->smsc && !strcmp(p->smsc, "+821029190200"), "with-SMSC fallback smsc");
+	CHECK(!strcmp(p->number, "+821012345678"), "with-SMSC fallback number %s", p->number);
+	sms_part_free(p);
+
+	/* the fallback is only for transfer-route messages and never hides garbage */
+	{
+		uint8_t pdu[300], junk[] = { 0x00, 0x00, 0x00, 0x00, 0x00 };
+		struct sms_part *q = NULL;
+		char err[100] = "";
+		size_t n = unhex(getv("transfer_route_deliver_with_smsc"), pdu);
+
+		CHECK(sms_part_3gpp_from_pdu(1, pdu, n, false, &q, err, sizeof(err)) == 0 && q, "normal full PDU");
+		sms_part_free(q);
+		q = NULL;
+		CHECK(sms_part_3gpp_from_pdu(1, junk, sizeof(junk), true, &q, err, sizeof(err)) == -1 && err[0],
+		      "garbage transfer-route fails with an error: '%s'", err);
+		CHECK(!strstr(err, "SMSC"), "first (no-SMSC) error reported: '%s'", err);
+	}
+}
+
+static void test_decode_errors(void)
+{
+	uint8_t pdu[300];
+	struct sms_part *p = NULL;
+	char err[100];
+	size_t n = unhex(getv("deliver_ucs2_ko"), pdu), i, fails = 0;
+
+	/* every truncation must be rejected or decoded, never crash (run under valgrind/ASAN too) */
+	for (i = 0; i < n; i++) {
+		err[0] = 0;
+		p = NULL;
+		if (sms_part_3gpp_from_pdu(1, pdu, i, false, &p, err, sizeof(err)))
+			fails++;
+		else
+			sms_part_free(p);
+	}
+	CHECK(fails > 20, "truncated PDUs rejected (%zu)", fails);
+
+	n = unhex(getv("deliver_gsm7_part2_of_2"), pdu);
+	for (i = 0; i < n; i++) {
+		p = NULL;
+		if (!sms_part_3gpp_from_pdu(1, pdu, i, false, &p, err, sizeof(err)))
+			sms_part_free(p);
+	}
+	/* garbage UDHL */
+	{
+		uint8_t bad[300];
+		size_t m = unhex(getv("deliver_gsm7_part2_of_2"), bad);
+		/* UDL byte is just before the UDH: make the UDH longer than the data */
+		bad[m - 23] = 0xf0;
+		p = NULL;
+		if (!sms_part_3gpp_from_pdu(1, bad, m, false, &p, err, sizeof(err)))
+			sms_part_free(p);
+	}
+	/* unhandled message type 3 */
+	{
+		uint8_t bad[] = { 0x00, 0x03, 0x00 };
+
+		CHECK(sms_part_3gpp_from_pdu(1, bad, sizeof(bad), false, &p, err, sizeof(err)) == -1, "type 3");
+	}
+}
+
+static struct sms_part *new_submit(const char *number, const char *smsc)
+{
+	struct sms_part *p = sms_part_new(SMS_PART_INVALID_INDEX, SMS_PDU_SUBMIT);
+
+	sms_part_set_number(p, number);
+	if (smsc)
+		sms_part_set_smsc(p, smsc);
+	return p;
+}
+
+static void test_encode(void)
+{
+	struct sms_part *p;
+
+	p = new_submit("+821012345678", NULL);
+	p->encoding = SMS_ENC_GSM7;
+	sms_part_take_text(p, strdup("hello world"));
+	expect_encode(p, "submit_gsm7");
+	sms_part_free(p);
+
+	p = new_submit("+821012345678", "+821029190200");
+	p->encoding = SMS_ENC_UCS2;
+	p->class = 1;
+	p->delivery_report_request = true;
+	p->validity_relative = 1440; /* 24 h -> 167 */
+	sms_part_take_text(p, strdup("안녕하세요 테스트"));
+	expect_encode(p, "submit_ucs2_ko_smsc_class1_dra_vp");
+	sms_part_free(p);
+
+	p = new_submit("+821012345678", NULL);
+	p->encoding = SMS_ENC_GSM7;
+	p->concat_reference = 7;
+	p->concat_max = 2;
+	p->concat_sequence = 1;
+	p->delivery_report_request = true; /* not the last part: no SRR */
+	sms_part_take_text(p, strdup(getv("submit_gsm7_part1_text")));
+	expect_encode(p, "submit_gsm7_part1_of_2");
+	sms_part_free(p);
+
+	p = new_submit("01012345678", NULL);
+	p->encoding = SMS_ENC_UCS2;
+	p->concat_reference = 9;
+	p->concat_max = 2;
+	p->concat_sequence = 2;
+	p->delivery_report_request = true; /* the last part */
+	sms_part_take_text(p, strdup("끝"));
+	expect_encode(p, "submit_ucs2_part2_of_2_dra");
+	sms_part_free(p);
+
+	p = new_submit("+821012345678", NULL);
+	p->encoding = SMS_ENC_8BIT;
+	{
+		uint8_t *d = malloc(10);
+		int i;
+
+		for (i = 0; i < 10; i++)
+			d[i] = i;
+		sms_part_take_data(p, d, 10);
+	}
+	expect_encode(p, "submit_8bit");
+	sms_part_free(p);
+
+	/* alphanumeric destinations (TON 5, GSM 7-bit packed) */
+	{
+		static const struct {
+			const char *num, *smsc, *vec;
+		} alpha[] = {
+			{ "KTbill", NULL, "submit_alpha_da" },
+			{ "+KTbill", NULL, "submit_alpha_da" }, /* the '+' is dropped like before */
+			{ "Foo[1]_x@", NULL, "submit_alpha_da_ext" },
+			{ "ABCDEFGHIJKLMNOP", NULL, "submit_alpha_da_16" },
+			{ "A", "+821029190200", "submit_alpha_da_1" },
+		};
+		size_t i;
+
+		for (i = 0; i < sizeof(alpha) / sizeof(alpha[0]); i++) {
+			p = new_submit(alpha[i].num, alpha[i].smsc);
+			p->encoding = SMS_ENC_GSM7;
+			sms_part_take_text(p, strdup("hello world"));
+			expect_encode(p, alpha[i].vec);
+			sms_part_free(p);
+		}
+	}
+
+	/* errors */
+	{
+		uint8_t pdu[SMS_PDU_MAX];
+		size_t n;
+		char err[100];
+
+		static const char *const bad[] = { "", "+", "한글", "ABCDEFGHIJKLMNOPQ", "[[[[[[[[[" };
+		size_t i;
+
+		for (i = 0; i < sizeof(bad) / sizeof(bad[0]); i++) {
+			p = new_submit(bad[i], NULL);
+			p->encoding = SMS_ENC_GSM7;
+			sms_part_take_text(p, strdup("x"));
+			CHECK(sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err)) == -1, "invalid number %s", bad[i]);
+			sms_part_free(p);
+		}
+
+		p = new_submit("+821012345678", "KTbill");
+		p->encoding = SMS_ENC_GSM7;
+		sms_part_take_text(p, strdup("x"));
+		CHECK(sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err)) == -1, "alphanumeric SMSC");
+		sms_part_free(p);
+
+		p = new_submit("+821012345678", NULL);
+		p->encoding = SMS_ENC_GSM7;
+		sms_part_take_text(p, strdup("한글"));
+		CHECK(sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err)) == -1, "not gsm7");
+		sms_part_free(p);
+
+		p = new_submit("+821012345678", NULL);
+		p->encoding = SMS_ENC_GSM7;
+		sms_part_take_text(p, strdup(""));
+		CHECK(sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err)) == -1, "empty text");
+		sms_part_free(p);
+
+		p = new_submit("+821012345678", NULL);
+		p->encoding = SMS_ENC_UCS2;
+		{
+			char *big = malloc(200);
+
+			memset(big, 'a', 199);
+			big[199] = 0;
+			sms_part_take_text(p, big);
+		}
+		CHECK(sms_part_3gpp_get_submit_pdu(p, pdu, &n, err, sizeof(err)) == -1, "too big");
+		sms_part_free(p);
+	}
+}
+
+static char *repeat(const char *s, size_t n)
+{
+	size_t l = strlen(s);
+	char *r = malloc(l * n + 1), *w = r;
+
+	while (n--) {
+		memcpy(w, s, l);
+		w += l;
+	}
+	*w = 0;
+	return r;
+}
+
+static size_t count_chars(const char *s)
+{
+	size_t n = 0;
+
+	for (; *s; s++)
+		if (((unsigned char)*s & 0xc0) != 0x80)
+			n++;
+	return n;
+}
+
+static void check_split(const char *text, bool exp_gsm7, size_t exp_parts, const char *what)
+{
+	struct sms_chunk *c;
+	size_t n, i, total = 0;
+	bool gsm7;
+
+	CHECK(!sms_split_text(text, &gsm7, &c, &n), "%s split", what);
+	CHECK(gsm7 == exp_gsm7, "%s gsm7 %d", what, gsm7);
+	CHECK(n == exp_parts, "%s parts %zu (expected %zu)", what, n, exp_parts);
+	for (i = 0; i < n; i++)
+		total += c[i].len;
+	CHECK(total == strlen(text), "%s chunks cover the text", what);
+	free(c);
+}
+
+/* split, encode every part, decode it again and compare the reassembled text */
+static void roundtrip(const char *text, const char *what)
+{
+	struct sms_chunk *c;
+	size_t n, i, plen;
+	bool gsm7;
+	char *all = calloc(1, strlen(text) + 1), err[100];
+	unsigned int refs = 0;
+
+	CHECK(!sms_split_text(text, &gsm7, &c, &n), "%s split", what);
+	for (i = 0; i < n; i++) {
+		struct sms_part *p = new_submit("+821012345678", NULL), *d = NULL;
+		uint8_t pdu[SMS_PDU_MAX];
+		char *chunk = strndup(text + c[i].off, c[i].len);
+
+		p->encoding = gsm7 ? SMS_ENC_GSM7 : SMS_ENC_UCS2;
+		sms_part_take_text(p, chunk);
+		if (n > 1) {
+			p->concat_reference = 0x55;
+			p->concat_max = n;
+			p->concat_sequence = i + 1;
+		}
+		CHECK(!sms_part_3gpp_get_submit_pdu(p, pdu, &plen, err, sizeof(err)), "%s encode %zu: %s", what, i, err);
+		/* the PDU must fit a SMS: 140 bytes of user data plus the header */
+		CHECK(plen <= 12 + 2 + 2 + 12 + 1 + 140, "%s pdu size %zu", what, plen);
+		CHECK(!sms_part_3gpp_from_pdu(0, pdu, plen, false, &d, err, sizeof(err)), "%s decode %zu: %s", what, i, err);
+		if (d) {
+			CHECK(d->pdu_type == SMS_PDU_SUBMIT, "type");
+			CHECK(d->should_concat == (n > 1), "concat");
+			if (n > 1)
+				CHECK(d->concat_sequence == i + 1 && d->concat_max == n && d->concat_reference == 0x55,
+				      "udh %zu", i);
+			CHECK(d->text && !strcmp(d->text, chunk), "%s chunk %zu '%s' vs '%s'", what, i, d->text, chunk);
+			if (d->text)
+				strcat(all, d->text);
+			refs++;
+			sms_part_free(d);
+		}
+		sms_part_free(p);
+	}
+	CHECK(refs == n && !strcmp(all, text), "%s reassembled", what);
+	free(all);
+	free(c);
+}
+
+static void test_split(void)
+{
+	char *t, *t2;
+	struct sms_chunk *c;
+	size_t n, i;
+	bool gsm7;
+	uint8_t pdu[SMS_PDU_MAX];
+
+	/* GSM7: 160 single, 161 -> 2 parts (153 + 8), 200 characters -> 153 + 47 */
+	t = repeat("a", 160);
+	check_split(t, true, 1, "gsm7 160");
+	free(t);
+	t = repeat("a", 161);
+	check_split(t, true, 2, "gsm7 161");
+	free(t);
+	t = repeat("The quick brown fox jumps over the lazy dog. ", 5); /* 225 */
+	t[200] = 0;
+	check_split(t, true, 2, "gsm7 200");
+	CHECK(!sms_split_text(t, &gsm7, &c, &n) && c[0].len == 153 && c[1].len == 47, "153 + 47");
+	free(c);
+	roundtrip(t, "gsm7 200");
+	free(t);
+	t = repeat("a", 306);
+	check_split(t, true, 2, "gsm7 306");
+	free(t);
+	t = repeat("a", 307);
+	check_split(t, true, 3, "gsm7 307");
+	free(t);
+
+	/* an extension character (2 septets) never straddles a chunk: 152 + euro */
+	t = repeat("a", 152);
+	t2 = malloc(400);
+	sprintf(t2, "%s€%s", t, "tail text making it multipart");
+	CHECK(!sms_split_text(t2, &gsm7, &c, &n) && gsm7 && n == 2, "ext split");
+	CHECK(c[0].len == 152 && !strncmp(t2 + c[1].off, "€", 3), "ext moved to the next chunk (%zu)", c[0].len);
+	free(c);
+	roundtrip(t2, "gsm7 ext boundary");
+	free(t);
+	free(t2);
+	roundtrip("[brackets] {and} ~tilde^ |pipe| \\back\\ 5€", "gsm7 ext single");
+
+	/* UCS2 / UTF-16: 70 characters single, 71 -> 2 parts (67 + 4) */
+	t = repeat("가", 70);
+	check_split(t, false, 1, "ucs2 70");
+	roundtrip(t, "ucs2 70");
+	free(t);
+	t = repeat("가", 71);
+	check_split(t, false, 2, "ucs2 71");
+	CHECK(!sms_split_text(t, &gsm7, &c, &n) && count_chars(t + c[0].off) >= 67 && c[0].len == 67 * 3 && c[1].len == 4 * 3,
+	      "67 + 4");
+	free(c);
+	roundtrip(t, "ucs2 71");
+	free(t);
+	t = repeat("안녕하세요 테스트 ", 12); /* 108 characters */
+	check_split(t, false, 2, "ucs2 108");
+	roundtrip(t, "ucs2 108");
+	free(t);
+	t = repeat("가", 200);
+	check_split(t, false, 3, "ucs2 200"); /* 67 + 67 + 66 */
+	roundtrip(t, "ucs2 200");
+	free(t);
+
+	/* surrogate pairs (4 bytes) stay together: 66 chars + emoji at the boundary */
+	t = repeat("가", 66);
+	t2 = malloc(1000);
+	{ char *r = repeat("나", 10); sprintf(t2, "%s👍%s", t, r); free(r); }
+	CHECK(!sms_split_text(t2, &gsm7, &c, &n) && !gsm7 && n == 2, "emoji split");
+	CHECK(c[0].len == 66 * 3 && !strncmp(t2 + c[1].off, "👍", 4), "emoji moved to the next chunk (%zu)", c[0].len);
+	free(c);
+	roundtrip(t2, "ucs2 emoji boundary");
+	free(t);
+	free(t2);
+
+	/* mixed: a single Korean character makes it UCS2 */
+	check_split("hello 안녕", false, 1, "mixed");
+
+	/* binary */
+	CHECK(!sms_split_data(140, &c, &n) && n == 1 && c[0].len == 140, "data 140");
+	free(c);
+	CHECK(!sms_split_data(141, &c, &n) && n == 2 && c[0].len == 134 && c[1].len == 7 && c[1].off == 134, "data 141");
+	free(c);
+	CHECK(!sms_split_data(402, &c, &n) && n == 3 && c[2].len == 134 && c[2].off == 268, "data 402");
+	free(c);
+	/* 134 bytes of data with UDH fit the PDU */
+	{
+		struct sms_part *p = new_submit("+821012345678", "+821029190200");
+		uint8_t *d = calloc(1, 134);
+		size_t plen;
+		char err[100];
+
+		p->encoding = SMS_ENC_8BIT;
+		p->concat_reference = 1;
+		p->concat_max = 2;
+		p->concat_sequence = 1;
+		sms_part_take_data(p, d, 134);
+		CHECK(!sms_part_3gpp_get_submit_pdu(p, pdu, &plen, err, sizeof(err)), "134 byte part: %s", err);
+		CHECK(pdu[plen - 134 - 6 - 1] == 140, "UDL 140");
+		sms_part_free(p);
+	}
+	(void)i;
+
+	/* invalid UTF-8 */
+	CHECK(sms_split_text("bad \xff", &gsm7, &c, &n) == -1, "invalid utf-8");
+}
+
+static void test_charsets(void)
+{
+	uint8_t sept[16], packed[16], out[16];
+	size_t n;
+	unsigned int shift;
+	char *s;
+
+	/* pack/unpack with every shift */
+	for (shift = 0; shift < 7; shift++) {
+		size_t i;
+
+		for (i = 0; i < 9; i++)
+			sept[i] = (i * 13 + 5) & 0x7f;
+		n = cs_gsm7_pack(sept, 9, shift, packed);
+		CHECK(n == (9 * 7 + shift + 7) / 8, "pack len");
+		cs_gsm7_unpack(packed, n, 9, shift, out);
+		CHECK(!memcmp(sept, out, 9), "pack/unpack shift %u", shift);
+	}
+
+	/* the whole default alphabet round-trips */
+	{
+		uint32_t cp;
+		unsigned int c = 0;
+		char tmp[8];
+
+		for (cp = 0; cp < 0x110000; cp++) {
+			size_t l;
+			uint8_t *g;
+			char *back;
+			size_t ng;
+
+			if (!cs_gsm7_char_len(cp))
+				continue;
+			if (cp >= 0xd800 && cp <= 0xdfff)
+				continue;
+			l = cs_utf8_encode(cp, tmp);
+			tmp[l] = 0;
+			g = cs_gsm7_from_utf8(tmp, &ng);
+			back = g ? cs_gsm7_to_utf8(g, ng) : NULL;
+			CHECK(g && back && !strcmp(back, tmp) && ng == cs_gsm7_char_len(cp), "gsm7 U+%04X", cp);
+			free(g);
+			free(back);
+			c++;
+		}
+		CHECK(c == 127 + 10, "alphabet size %u", c);
+	}
+
+	/* UTF-16 */
+	{
+		size_t l;
+		uint8_t *u = cs_utf8_to_utf16be("A가👍", &l);
+
+		CHECK(l == 2 + 2 + 4 && u[0] == 0 && u[1] == 'A' && u[2] == 0xac && u[3] == 0x00 && u[4] == 0xd8 &&
+			      u[5] == 0x3d && u[6] == 0xdc && u[7] == 0x4d, "utf16 encode");
+		s = cs_utf16be_to_utf8(u, l);
+		CHECK(!strcmp(s, "A가👍"), "utf16 decode");
+		free(s);
+		free(u);
+		/* lone surrogate and odd length */
+		{
+			uint8_t bad[] = { 0xd8, 0x3d, 0x00, 0x41, 0x00 };
+
+			s = cs_utf16be_to_utf8(bad, sizeof(bad));
+			CHECK(!strcmp(s, "\xef\xbf\xbd" "A"), "lone surrogate '%s'", s);
+			free(s);
+		}
+	}
+
+	CHECK(cs_utf8_valid("안녕") && !cs_utf8_valid("\xc0\x80") && !cs_utf8_valid("\xed\xa0\x80") &&
+		      !cs_utf8_valid("\xf4\x90\x80\x80") && !cs_utf8_valid("\xe2\x82"), "utf8 validation");
+}
+
+static void test_validity(void)
+{
+	CHECK(sms_validity_to_relative(5) == 0 && sms_validity_to_relative(6) == 1, "5 min steps");
+	CHECK(sms_validity_to_relative(720) == 143 && sms_validity_to_relative(721) == 144, "12h");
+	CHECK(sms_validity_to_relative(1440) == 167 && sms_validity_to_relative(2880) == 168, "days");
+	CHECK(sms_validity_to_relative(43200) == 196 && sms_validity_to_relative(50400) == 197, "weeks");
+	CHECK(sms_validity_to_relative(635040) == 255 && sms_validity_to_relative(9999999) == 255, "max");
+	CHECK(sms_relative_to_validity(0) == 5 && sms_relative_to_validity(143) == 720 &&
+		      sms_relative_to_validity(167) == 1440 && sms_relative_to_validity(168) == 2880 &&
+		      sms_relative_to_validity(196) == 43200 && sms_relative_to_validity(197) == 50400 &&
+		      sms_relative_to_validity(255) == 635040, "relative to minutes");
+}
+
+static void test_address(void)
+{
+	CHECK(sms_address_valid("+821012345678") && sms_address_valid("114") && sms_address_valid("*123#"), "valid");
+	CHECK(!sms_address_valid("") && !sms_address_valid("+") && !sms_address_valid("12 34") &&
+		      !sms_address_valid("abcdefg") && !sms_address_valid("123456789012345678901"), "invalid");
+	CHECK(sms_destination_valid("114") && sms_destination_valid("+821012345678") && sms_destination_valid("KTbill") &&
+		      sms_destination_valid("12 34") && sms_destination_valid("abcdefg") &&
+		      sms_destination_valid("ABCDEFGHIJKLMNOP"), "destination valid");
+	CHECK(!sms_destination_valid("") && !sms_destination_valid("+") && !sms_destination_valid("한글") &&
+		      !sms_destination_valid("ABCDEFGHIJKLMNOPQ"), "destination invalid");
+}
+
+int main(int argc, char **argv)
+{
+	char line[4096];
+	FILE *f;
+
+	if (argc < 2 || !(f = fopen(argv[1], "r"))) {
+		fprintf(stderr, "usage: %s vectors.txt\n", argv[0]);
+		return 2;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		char *eq = strchr(line, '=');
+
+		line[strcspn(line, "\n")] = 0;
+		if (!eq)
+			continue;
+		*eq = 0;
+		vec[n_vec][0] = strdup(line);
+		vec[n_vec][1] = strdup(eq + 1);
+		n_vec++;
+	}
+	fclose(f);
+
+	test_charsets();
+	test_validity();
+	test_address();
+	test_decode();
+	test_decode_errors();
+	test_encode();
+	test_split();
+
+	printf("%d checks, %d failures\n", checks, failures);
+	return failures ? 1 : 0;
+}

+ */
+
+#include <stdio.h>
+
+#include "qmi-enums.h"
+#include "qmi-enums-private.h"
+#include "mbim.h"
+#include "qmi-frame.h"
+
+/* marker + qmux header: enough to know the frame length */
+#define QMI_FRAME_PREFIX	(offsetof(struct qmi_msg, flags))
+#define QMI_FRAME_MARKER	0x01
+
+int qmi_frame_parse(const void *buf, size_t len, struct qmi_frame_info *info)
+{
+	const struct qmi_msg *msg = buf;
+	struct qmi_frame_info tmp;
+	size_t hdr, total;
+
+	if (len >= 1 && msg->marker != QMI_FRAME_MARKER)
+		return QMI_FRAME_INVALID;
+
+	if (len < QMI_FRAME_PREFIX)
+		return QMI_FRAME_NEED_MORE;
+
+	total = (size_t) le16_to_cpu(msg->qmux.len) + 1;
+	tmp.ctl = msg->qmux.service == QMI_SERVICE_CTL;
+	hdr = QMI_FRAME_PREFIX + sizeof(msg->flags) +
+	      (tmp.ctl ? sizeof(struct qmi_ctl) : sizeof(struct qmi_svc));
+	if (total < hdr)
+		return QMI_FRAME_INVALID;
+
+	if (len < total)
+		return QMI_FRAME_NEED_MORE;
+
+	tmp.service = msg->qmux.service;
+	tmp.client = msg->qmux.client;
+	tmp.flags = msg->flags;
+	tmp.len = total;
+	tmp.tlv_ofs = hdr;
+	if (tmp.ctl) {
+		tmp.tid = msg->ctl.transaction;
+		tmp.message = le16_to_cpu(msg->ctl.message);
+		tmp.tlv_len = le16_to_cpu(msg->ctl.tlv_len);
+		tmp.indication = msg->flags & QMI_CTL_FLAG_INDICATION;
+		tmp.response = msg->flags & QMI_CTL_FLAG_RESPONSE;
+	} else {
+		tmp.tid = le16_to_cpu(msg->svc.transaction);
+		tmp.message = le16_to_cpu(msg->svc.message);
+		tmp.tlv_len = le16_to_cpu(msg->svc.tlv_len);
+		tmp.indication = msg->flags & QMI_SERVICE_FLAG_INDICATION;
+		tmp.response = msg->flags & QMI_SERVICE_FLAG_RESPONSE;
+	}
+
+	if (tmp.tlv_len > total - hdr)
+		return QMI_FRAME_INVALID;
+
+	if (info)
+		*info = tmp;
+
+	return total;
+}
+
+int qmi_mbim_deframe(const void *buf, size_t len, size_t *consume,
+		     const void **qmi, size_t *qmi_len)
+{
+	const struct mbim_command_message *mbim = buf;
+	size_t total;
+
+	if (len < sizeof(*mbim))
+		return QMI_FRAME_NEED_MORE;
+
+	total = le32_to_cpu(mbim->header.length);
+	if (total < sizeof(*mbim))
+		return QMI_FRAME_INVALID;
+
+	if (len < total)
+		return QMI_FRAME_NEED_MORE;
+
+	*consume = total;
+	if (!is_mbim_qmi((struct mbim_command_message *) mbim))
+		return QMI_MBIM_SKIP;
+
+	*qmi = (const uint8_t *) buf + sizeof(*mbim);
+	*qmi_len = total - sizeof(*mbim);
+	return QMI_MBIM_QMI;
+}
+
+void qmi_frame_dump(qmi_frame_dump_cb cb, void *priv, const char *dir,
+		    const void *buf, size_t len)
+{
+	struct qmi_frame_info info;
+	const uint8_t *p;
+	size_t left;
+	char line[256];
+	int n, r;
+
+	r = qmi_frame_parse(buf, len, &info);
+	if (r <= 0) {
+		snprintf(line, sizeof(line), "%s invalid/incomplete frame (%zu bytes)", dir, len);
+		cb(priv, line);
+		return;
+	}
+
+	snprintf(line, sizeof(line), "%s svc=0x%02x cid=%u flags=0x%02x tid=%u msg=0x%04x tlv_len=%u len=%u",
+		 dir, info.service, info.client, info.flags, info.tid, info.message, info.tlv_len, info.len);
+	cb(priv, line);
+
+	p = (const uint8_t *) buf + info.tlv_ofs;
+	left = info.tlv_len;
+	while (left >= sizeof(struct tlv)) {
+		const struct tlv *tlv = (const struct tlv *) p;
+		size_t dlen = le16_to_cpu(tlv->len), i;
+
+		if (dlen + sizeof(*tlv) > left)
+			break;
+
+		n = snprintf(line, sizeof(line), "    tlv 0x%02x len=%zu:", tlv->type, dlen);
+		for (i = 0; i < dlen && i < 32 && n < (int) sizeof(line) - 4; i++)
+			n += snprintf(line + n, sizeof(line) - n, " %02x", tlv->data[i]);
+		if (i < dlen)
+			snprintf(line + n, sizeof(line) - n, " ...");
+		cb(priv, line);
+
+		p += dlen + sizeof(*tlv);
+		left -= dlen + sizeof(*tlv);
+	}
+}

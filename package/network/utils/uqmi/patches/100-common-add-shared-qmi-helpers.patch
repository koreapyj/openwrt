+const struct wds_name wds_ip_family_names[] = {
+	{ "ipv4", QMI_WDS_IP_FAMILY_IPV4 },
+	{ "ipv6", QMI_WDS_IP_FAMILY_IPV6 },
+	{ "unspecified", QMI_WDS_IP_FAMILY_UNSPECIFIED },
+};
+const unsigned int wds_ip_family_names_n = 3;
+
+const struct wds_name wds_pdp_type_names[] = {
+	{ "ipv4", QMI_WDS_PDP_TYPE_IPV4 },
+	{ "ppp", QMI_WDS_PDP_TYPE_PPP },
+	{ "ipv6", QMI_WDS_PDP_TYPE_IPV6 },
+	{ "ipv4v6", QMI_WDS_PDP_TYPE_IPV4_OR_IPV6 },
+};
+const unsigned int wds_pdp_type_names_n = 4;
+
+const struct wds_name wds_auth_names[] = {
+	{ "none", QMI_WDS_AUTHENTICATION_NONE },
+	{ "pap", QMI_WDS_AUTHENTICATION_PAP },
+	{ "chap", QMI_WDS_AUTHENTICATION_CHAP },
+	{ "both", QMI_WDS_AUTHENTICATION_PAP | QMI_WDS_AUTHENTICATION_CHAP },
+};
+const unsigned int wds_auth_names_n = 4;
+
+bool wds_name_to_val(const struct wds_name *tbl, unsigned int n, const char *name, bool icase, int *val)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if ((icase ? strcasecmp(tbl[i].name, name) : strcmp(tbl[i].name, name)) != 0)
+			continue;
+
+		*val = tbl[i].val;
+		return true;
+	}
+
+	return false;
+}
+
+const char *wds_val_to_name(const struct wds_name *tbl, unsigned int n, int val)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (tbl[i].val == val)
+			return tbl[i].name;
+	}
+
+	return NULL;
+}
+
+int wds_sio_port_a2_mux_rmnet(int n)
+{
+	if (n < 0 || n > 7)
+		return -1;
+
+	return QMI_SIO_PORT_A2_MUX_RMNET0 + n;
+}
+
+bool wds_sio_port_parse(const char *arg, uint16_t *port)
+{
+	unsigned long val;
+	char *end;
+
+	if (!strncasecmp(arg, "a2-mux-rmnet", 12)) {
+		/* QMI_SIO_PORT_A2_MUX_RMNET0..7 (BAM-DMUX channels) */
+		val = strtoul(arg + 12, &end, 10);
+		if (end == arg + 12 || *end || val > 7)
+			return false;
+
+		*port = QMI_SIO_PORT_A2_MUX_RMNET0 + val;
+		return true;
+	}
+
+	val = strtoul(arg, &end, 0);
+	if (end == arg || *end || !val || val > 0xffff)
+		return false;
+
+	*port = val;
+	return true;
+}
+
+char *wds_ipv4_to_str(uint32_t addr, char *buf, size_t len)
+{
+	struct in_addr a = { .s_addr = htonl(addr) };
+
+	return (char *)inet_ntop(AF_INET, &a, buf, len);
+}
+
+char *wds_ipv6_to_str(const uint16_t *words, char *buf, size_t len)
+{
+	struct in6_addr a;
+	unsigned int i;
+
+	for (i = 0; i < 8; i++) {
+		a.s6_addr[i * 2] = words[i] >> 8;
+		a.s6_addr[i * 2 + 1] = words[i] & 0xff;
+	}
+
+	return (char *)inet_ntop(AF_INET6, &a, buf, len);
+}
+
+unsigned int wds_netmask_to_prefix(uint32_t mask)
+{
+	unsigned int n = 0;
+
+	while (mask & 0x80000000u) {
+		n++;
+		mask <<= 1;
+	}
+
+	return n;
+}

+/* host test: shared PDC helpers (common/pdc-util.c). Usage: test_pdc */
+#include <stdio.h>
+#include <string.h>
+#include "pdc-util.h"
+#include "qmi-enums-pdc.h"
+
+static int fails;
+
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+
+int main(void)
+{
+	uint8_t id[PDC_ID_MAX], id2[PDC_ID_MAX], long_id[PDC_ID_MAX + 1];
+	char str[PDC_ID_STR_MAX], big[PDC_ID_MAX * 2 + 4];
+	unsigned int n = 0, n2 = 0;
+	uint32_t type = 99;
+
+	/* parse: both cases, round trip prints lowercase */
+	CHECK(pdc_id_parse("00FfaB10", id, &n) && n == 4);
+	CHECK(id[0] == 0 && id[1] == 0xff && id[2] == 0xab && id[3] == 0x10);
+	CHECK(pdc_id_format(id, n, str) && !strcmp(str, "00ffab10"));
+	CHECK(pdc_id_parse(str, id2, &n2) && pdc_id_equal(id, n, id2, n2));
+
+	/* parse: rejects */
+	CHECK(!pdc_id_parse("", id, &n));
+	CHECK(!pdc_id_parse("abc", id, &n));
+	CHECK(!pdc_id_parse("zz", id, &n));
+	CHECK(!pdc_id_parse("0x", id, &n));
+	CHECK(!pdc_id_parse("ab cd", id, &n));
+	memset(big, 'a', sizeof(big));
+	big[PDC_ID_MAX * 2] = '\0';
+	CHECK(pdc_id_parse(big, id, &n) && n == PDC_ID_MAX);
+	big[PDC_ID_MAX * 2] = 'a';
+	big[PDC_ID_MAX * 2 + 2] = '\0';
+	CHECK(!pdc_id_parse(big, id, &n));
+
+	/* format limits */
+	memset(long_id, 0x5a, sizeof(long_id));
+	CHECK(pdc_id_format(long_id, PDC_ID_MAX, str) && strlen(str) == PDC_ID_MAX * 2);
+	CHECK(!pdc_id_format(long_id, PDC_ID_MAX + 1, str) && !str[0]);
+	CHECK(pdc_id_format(id, 0, str) && !str[0]);
+
+	/* equal: empty never matches */
+	CHECK(!pdc_id_equal(id, 0, id, 0));
+	CHECK(!pdc_id_equal(id, 4, id, 3));
+	id2[0] = 0x01;
+	CHECK(!pdc_id_equal(id, 4, id2, 4));
+
+	/* file id: SHA1 of the data ("abc") */
+	n = pdc_id_from_file(id, "abc", 3);
+	CHECK(n == 20);
+	CHECK(pdc_id_format(id, n, str) && !strcmp(str, "a9993e364706816aba3e25717850c26c9cd0d89d"));
+	n = pdc_id_from_file(id, "", 0);
+	CHECK(pdc_id_format(id, n, str) && !strcmp(str, "da39a3ee5e6b4b0d3255bfef95601890afd80709"));
+
+	/* type names */
+	CHECK(pdc_type_parse("software", &type) && type == QMI_PDC_CONFIGURATION_TYPE_SOFTWARE);
+	CHECK(pdc_type_parse("platform", &type) && type == QMI_PDC_CONFIGURATION_TYPE_PLATFORM);
+	type = 99;
+	CHECK(!pdc_type_parse("Software", &type) && !pdc_type_parse("", &type) && type == 99);
+	CHECK(!strcmp(pdc_type_name(QMI_PDC_CONFIGURATION_TYPE_SOFTWARE), "software"));
+	CHECK(!strcmp(pdc_type_name(QMI_PDC_CONFIGURATION_TYPE_PLATFORM), "platform"));
+	CHECK(!strcmp(pdc_type_name(2), "unknown") && !strcmp(pdc_type_name(0xffffffff), "unknown"));
+
+	/* tokens */
+	CHECK(pdc_token_valid(false, 5, 7));
+	CHECK(pdc_token_valid(true, 7, 7));
+	CHECK(!pdc_token_valid(true, 5, 7));
+
+	/* results */
+	CHECK(!pdc_result_failed(false, 3, false));
+	CHECK(!pdc_result_failed(true, 0, false));
+	CHECK(pdc_result_failed(true, 3, false));
+	CHECK(pdc_result_failed(true, PDC_ERROR_NOT_PROVISIONED, false));
+	CHECK(!pdc_result_failed(true, PDC_ERROR_NOT_PROVISIONED, true));
+	CHECK(pdc_result_failed(true, 3, true));
+
+	CHECK(PDC_LOAD_CHUNK_SIZE == 512);
+
+	if (fails)
+		return 1;
+	printf("test_pdc: ok\n");
+	return 0;
+}

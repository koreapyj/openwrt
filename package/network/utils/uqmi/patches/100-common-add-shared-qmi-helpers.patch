+const char *voice_call_end_reason_name(unsigned int val)
+{
+	unsigned int lo = 0, hi = N(call_end_reasons);
+
+	while (lo < hi) {
+		unsigned int mid = (lo + hi) / 2;
+
+		if (call_end_reasons[mid].val == val)
+			return call_end_reasons[mid].name;
+		if (call_end_reasons[mid].val < val)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+
+	return "unknown";
+}

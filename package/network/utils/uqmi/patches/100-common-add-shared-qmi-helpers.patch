+#!/usr/bin/env python3
+# Independent reference encoder for the host test vectors (not the code under test).
+import sys
+
+GSM = ("@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\x1bÆæßÉ !\"#¤%&'()*+,-./0123456789:;<=>?"
+       "¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà")
+EXT = {'\f':0x0a,'^':0x14,'{':0x28,'}':0x29,'\\':0x2f,'[':0x3c,'~':0x3d,']':0x3e,'|':0x40,'€':0x65}
+
+def gsm7(text):
+    out=[]
+    for ch in text:
+        if ch in EXT: out += [0x1b, EXT[ch]]
+        else: out.append(GSM.index(ch))
+    return out
+
+def pack(sept, shift=0):
+    bits = 0; nb = shift; out = bytearray(); acc = 0
+    # build a bit string LSB first
+    bitlist = [0]*shift
+    for s in sept:
+        for i in range(7): bitlist.append((s>>i)&1)
+    while len(bitlist)%8: bitlist.append(0)
+    for i in range(0,len(bitlist),8):
+        out.append(sum(b<<j for j,b in enumerate(bitlist[i:i+8])))
+    return bytes(out)
+
+def bcd(num):
+    num = num.lstrip('+')
+    if len(num)%2: num += 'F'
+    return bytes(int(num[i+1],16)<<4 | int(num[i],16) for i in range(0,len(num),2))
+
+def addr(num, smsc=False):
+    if num.startswith('alpha:'):
+        # TON alphanumeric (0xD0), GSM 7-bit packed, length = useful semi-octets
+        sept = gsm7(num[6:]); p = pack(sept)
+        return bytes([(len(sept)*7+3)//4, 0xD0]) + p
+    t = 0x91 if num.startswith('+') else 0x81
+    b = bcd(num)
+    ln = len(b)+1 if smsc else len(num.lstrip('+'))
+    return bytes([ln, t]) + b
+
+def ts(y,mo,d,h,mi,s,tz_q):
+    def sw(v): return ((v%10)<<4)|(v//10)
+    neg = tz_q<0; q=abs(tz_q)
+    tzb = ((q%10)<<4)|(q//10)
+    if neg: tzb |= 0x08
+    return bytes([sw(y%100),sw(mo),sw(d),sw(h),sw(mi),sw(s),tzb])
+
+def hexs(b): return b.hex().upper()
+
+def deliver(smsc, oa, dcs, tsb, ud, udl, udhi=False, pid=0):
+    first = 0x04 | (0x40 if udhi else 0)
+    oab = addr(oa) if not oa.startswith('alpha:') else None
+    return (addr(smsc, True) if smsc else b'\x00') + bytes([first]) + oab + bytes([pid, dcs]) + tsb + bytes([udl]) + ud
+
+vec = {}
+t = ts(26,11,19,12,34,56,36)
+# 1 GSM7 Hellohello
+vec['deliver_gsm7_hello'] = hexs(deliver('+821029190200','+31641600986',0x00,t,pack(gsm7('Hellohello')),10))
+# 2 UCS2 Korean
+ko = '안녕하세요 테스트'
+u = ko.encode('utf-16-be')
+vec['deliver_ucs2_ko'] = hexs(deliver('+821029190200','+821012345678',0x08,t,u,len(u)))
+# 2b UCS2 with emoji (surrogates) class 1 (dcs 0x19 -> ucs2 + class valid)
+em = '좋아요👍'
+u = em.encode('utf-16-be')
+vec['deliver_ucs2_emoji_class1'] = hexs(deliver('+821029190200','+821012345678',0x09|0x10 if False else 0x19,t,u,len(u)))
+# 3 multipart GSM7 part 2/2 with 8-bit ref 0x2A
+txt2 = 'second part ' + 'ä€~' 
+udh = bytes([0x05,0x00,0x03,0x2A,0x02,0x02])
+sept = gsm7(txt2)
+ud = udh + pack(sept, 1)
+vec['deliver_gsm7_part2_of_2'] = hexs(deliver('+821029190200','+821012345678',0x00,t,ud,7+len(sept),udhi=True))
+vec['deliver_gsm7_part2_text'] = txt2
+# 4 multipart UCS2 16-bit ref 0x1234 part 1/3
+txt4 = '안녕'
+u = txt4.encode('utf-16-be')
+udh = bytes([0x06,0x08,0x04,0x12,0x34,0x03,0x01])
+vec['deliver_ucs2_part1_of_3_16bit'] = hexs(deliver('+821029190200','+821012345678',0x08,t,udh+u,len(udh)+len(u),udhi=True))
+# 5 alphanumeric sender "KTbill" gsm7 text
+alpha = 'KTbill'
+ab = pack(gsm7(alpha))
+oa = bytes([len(ab)*8//4 if False else (len(gsm7(alpha))*7+3)//4, 0xD0]) + ab
+body = pack(gsm7('Hi'))
+pdu = b'\x00' + bytes([0x04]) + oa + bytes([0,0]) + t + bytes([2]) + body
+vec['deliver_alpha_sender'] = hexs(pdu)
+# 6 8-bit data
+data = bytes([1,2,3,0xff,0x80])
+vec['deliver_8bit_data'] = hexs(deliver(None,'+821012345678',0x04,t,data,len(data)))
+# 7 status report: MR 0x2B, RA +821012345678, scts, dt, st=0
+sr = b'\x00' + bytes([0x06, 0x2B]) + addr('+821012345678') + ts(26,11,19,12,34,56,36) + ts(26,11,19,12,34,58,36) + bytes([0x00])
+vec['status_report'] = hexs(sr)
+# 8 negative tz timestamp deliver
+vec['deliver_neg_tz'] = hexs(deliver(None,'+15551234567',0x00,ts(26,1,2,3,4,5,-20),pack(gsm7('ok')),2))
+# 9 transfer-route DELIVER: QMI raw data is a TPDU (no SMSC length/address bytes)
+tr_text = '안녕하세요'.encode('utf-16-be')
+tr = deliver(None,'+821012345678',0x08,ts(26,11,19,12,34,56,36),tr_text,len(tr_text))
+tr = tr[1:] # discard the empty SMSC-length octet generated by deliver(None,...)
+vec['transfer_route_deliver_no_smsc'] = hexs(tr)
+# Firmware compatibility case: an otherwise TPDU transfer-route indication with an extra empty SMSC length 00.
+vec['transfer_route_deliver_empty_smsc_prefix'] = hexs(b'\x00' + tr)
+
+# Firmware compatibility case: a transfer-route indication carrying a full PDU with a real SMSC field (the shape of
+# a stored message). The no-SMSC parse fails ("Couldn't read address"), the with-SMSC fallback decodes it.
+vec['transfer_route_deliver_with_smsc'] = hexs(deliver('+821029190200','+821012345678',0x08,ts(26,11,19,12,34,56,36),tr_text,len(tr_text)))
+
+# ---- encode expectations (SUBMIT)
+def submit(smsc, da, dcs, ud, udl, mr=0, vp=None, udhi=False, srr=False):
+    first = 0x01 | (0x40 if udhi else 0) | (0x20 if srr else 0) | (0x10 if vp is not None else 0)
+    return (addr(smsc, True) if smsc else b'\x00') + bytes([first, mr]) + addr(da) + bytes([0, dcs]) + (bytes([vp]) if vp is not None else b'') + bytes([udl]) + ud
+s = gsm7('hello world')
+vec['submit_gsm7'] = hexs(submit(None,'+821012345678',0x00,pack(s),len(s)))
+u = ko.encode('utf-16-be')
+vec['submit_ucs2_ko_smsc_class1_dra_vp'] = hexs(submit('+821029190200','+821012345678',0x08|0x10|1,u,len(u),vp=167,srr=True))
+# multipart gsm7 part 1 of 2 ref 0x07
+s = gsm7('abc' * 51)  # 153
+udh = bytes([0x05,0,3,7,2,1])
+vec['submit_gsm7_part1_of_2'] = hexs(submit(None,'+821012345678',0x00,udh+pack(s,1),7+len(s),udhi=True))
+vec['submit_gsm7_part1_text'] = 'abc'*51
+# multipart ucs2 part 2 of 2 (last: dra set) ref 9
+u = '끝'.encode('utf-16-be')
+udh = bytes([0x05,0,3,9,2,2])
+vec['submit_ucs2_part2_of_2_dra'] = hexs(submit(None,'01012345678',0x08,udh+u,6+len(u),udhi=True,srr=True))
+# 8 bit
+d = bytes(range(10))
+vec['submit_8bit'] = hexs(submit(None,'+821012345678',0x04,d,len(d)))
+
+# alphanumeric destinations (old uqmi: strlen() as length and TON 0xC1/0xD1, a spec bug; here 23.040 semantics)
+s = gsm7('hello world')
+vec['submit_alpha_da'] = hexs(submit(None,'alpha:KTbill',0x00,pack(s),len(s)))
+vec['submit_alpha_da_ext'] = hexs(submit(None,'alpha:Foo[1]_x@',0x00,pack(s),len(s)))
+vec['submit_alpha_da_16'] = hexs(submit(None,'alpha:ABCDEFGHIJKLMNOP',0x00,pack(s),len(s)))
+vec['submit_alpha_da_1'] = hexs(submit('+821029190200','alpha:A',0x00,pack(s),len(s)))
+
+for k,v in vec.items():
+    print('%s=%s' % (k, v))

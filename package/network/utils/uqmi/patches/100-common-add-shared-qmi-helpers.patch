+/*
+ * Raw QMI voice service tables shared by the uqmi CLI and uqmid: call state / type / direction / mode
+ * values and names, DTMF digit validation and the plain-struct form of the All Call Status
+ * indication. No control flow of either side, no talloc/ubus here.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#ifndef __VOICE_UTIL_H
+#define __VOICE_UTIL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct qmi_msg;
+
+/* QmiVoiceCallState */
+enum {
+	QMI_CALL_STATE_UNKNOWN = 0x00,
+	QMI_CALL_STATE_ORIGINATION = 0x01,
+	QMI_CALL_STATE_INCOMING = 0x02,
+	QMI_CALL_STATE_CONVERSATION = 0x03,
+	QMI_CALL_STATE_CC_IN_PROGRESS = 0x04,
+	QMI_CALL_STATE_ALERTING = 0x05,
+	QMI_CALL_STATE_HOLD = 0x06,
+	QMI_CALL_STATE_WAITING = 0x07,
+	QMI_CALL_STATE_DISCONNECTING = 0x08,
+	QMI_CALL_STATE_END = 0x09,
+	QMI_CALL_STATE_SETUP = 0x0a,
+};
+
+/* QmiVoiceCallDirection */
+enum {
+	QMI_CALL_DIRECTION_UNKNOWN = 0x00,
+	QMI_CALL_DIRECTION_MO = 0x01,
+	QMI_CALL_DIRECTION_MT = 0x02,
+};
+
+/* QmiVoiceCallEndReason: the end reason of a call, QMI_CALL_END_REASON_CLIENT_END is the call ended by the client */
+#define QMI_CALL_END_REASON_CLIENT_END	29
+
+/* names of the QMI values ("unknown" for anything not in the table) */
+const char *voice_call_state_name(unsigned int val);
+const char *voice_call_type_name(unsigned int val);
+const char *voice_call_direction_name(unsigned int val);
+const char *voice_call_mode_name(unsigned int val);
+/* the libqmi nick of a QmiVoiceCallEndReason ("user-busy", "unassigned-number", ...), "unknown" if not in the table */
+const char *voice_call_end_reason_name(unsigned int val);
+
+/* DTMF digits: 0-9 * # A-D (any case); a non-empty string of those */
+bool voice_dtmf_digit_valid(char c);
+bool voice_dtmf_valid(const char *s);
+
+#define VOICE_MAX_CALLS		32
+
+struct voice_call_info {
+	uint8_t id;
+	uint8_t state;
+	uint8_t type;
+	uint8_t direction;
+	uint8_t mode;
+};
+
+struct voice_call_number {
+	uint8_t id;
+	const char *number;	/* points into the parsed message */
+};
+
+struct voice_call_end {
+	uint8_t id;
+	uint16_t reason;	/* QmiVoiceCallEndReason */
+};
+
+struct voice_call_cause {
+	uint8_t id;
+	uint8_t cause;		/* TS 24.008 Annex H cause value */
+};
+
+struct voice_all_calls {
+	unsigned int n_calls;
+	struct voice_call_info calls[VOICE_MAX_CALLS];
+	unsigned int n_numbers;
+	struct voice_call_number numbers[VOICE_MAX_CALLS];
+	/* the Call End Reason TLV (optional): the end reason of the calls which are ending */
+	unsigned int n_ends;
+	struct voice_call_end ends[VOICE_MAX_CALLS];
+	/* the Raw Call End Cause Code TLV (optional) */
+	unsigned int n_causes;
+	struct voice_call_cause causes[VOICE_MAX_CALLS];
+};
+
+/*
+ * Parses an All Call Status indication into out (at most VOICE_MAX_CALLS calls and numbers). Returns
+ * false if the call information is missing (out is empty then). voice-parse.c, needs qmi-message.h.
+ */
+bool voice_parse_all_call_status(struct qmi_msg *msg, struct voice_all_calls *out);
+
+#endif

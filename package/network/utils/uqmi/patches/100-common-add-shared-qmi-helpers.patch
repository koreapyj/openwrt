+		[QMI_NAS_DL_BANDWIDTH_5] = "5",
+		[QMI_NAS_DL_BANDWIDTH_10] = "10",
+		[QMI_NAS_DL_BANDWIDTH_15] = "15",
+		[QMI_NAS_DL_BANDWIDTH_20] = "20",
+		[QMI_NAS_DL_BANDWIDTH_INVALID] = "invalid",

+/*
+ * Pure (transport independent) helpers for QMUX frames: parsing/validation,
+ * MBIM de-framing, indication filtering and the debug dump. Shared by the
+ * uqmi CLI (synchronous, nested uloop) and uqmid (asynchronous); no I/O, no
+ * talloc/ubus here.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#ifndef __QMI_FRAME_H
+#define __QMI_FRAME_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "qmi-struct.h"
+
+/* return values of qmi_frame_parse() / qmi_mbim_deframe(): > 0 is a length */
+#define QMI_FRAME_NEED_MORE	0
+#define QMI_FRAME_INVALID	(-1)
+
+/* client id the modem uses to broadcast an indication to every client of a service */
+#define QMI_FRAME_CID_BROADCAST	0xff
+
+/* message id of the CTL SYNC indication */
+#define QMI_FRAME_CTL_SYNC	0x0027
+
+struct qmi_frame_info {
+	uint8_t service;
+	uint8_t client;
+	bool ctl;		/* CTL header (8 bit transaction id), else service header */
+	bool response;
+	bool indication;
+	uint8_t flags;		/* raw message flags */
+	uint16_t tid;		/* transaction id, host order (8 bit for CTL) */
+	uint16_t message;	/* message id, host order */
+	uint16_t tlv_len;	/* length of the TLV area, host order */
+	unsigned int tlv_ofs;	/* offset of the TLV area from the start of the frame */
+	unsigned int len;	/* total frame length including the 0x01 marker */
+};
+
+/*
+ * Check the QMUX frame at the start of buf.
+ *
+ * Returns the total frame length (> 0) and fills *info when buf holds a
+ * complete valid frame, QMI_FRAME_NEED_MORE when more bytes are needed, or
+ * QMI_FRAME_INVALID (bad marker, length shorter than the headers or TLV area
+ * longer than the frame). *info is only written on success; info may be NULL.
+ */
+int qmi_frame_parse(const void *buf, size_t len, struct qmi_frame_info *info);
+
+/*
+ * De-frame a QMI message tunnelled in an MBIM command done message.
+ *
+ * Returns QMI_FRAME_NEED_MORE (incomplete MBIM message), QMI_FRAME_INVALID
+ * (bogus MBIM length; drop the buffered data), QMI_MBIM_SKIP (a complete MBIM
+ * message that is not QMI; consume "consume" bytes) or QMI_MBIM_QMI (qmi and qmi_len
+ * point at the tunnelled QMUX data, consume "consume" bytes afterwards).
+ */
+#define QMI_MBIM_SKIP	1
+#define QMI_MBIM_QMI	2
+int qmi_mbim_deframe(const void *buf, size_t len, size_t *consume,
+		     const void **qmi, size_t *qmi_len);
+
+/* true for an indication that is meant for the client owning own_cid (own or broadcast cid) */
+static inline bool qmi_frame_ind_for_client(uint8_t msg_cid, int own_cid)
+{
+	return msg_cid == QMI_FRAME_CID_BROADCAST || (int) msg_cid == own_cid;
+}
+
+/*
+ * CTL SYNC indication: sent by the modem e.g. on boot to tell that all client
+ * ids have been deallocated, so outstanding requests will never be answered.
+ */
+static inline bool qmi_frame_is_ctl_sync(const struct qmi_frame_info *info)
+{
+	return info->ctl && info->indication && info->message == QMI_FRAME_CTL_SYNC;
+}
+
+/* one line of dump output (no trailing newline) */
+typedef void (*qmi_frame_dump_cb)(void *priv, const char *line);
+
+/*
+ * Dump one QMUX frame (header summary + one line per TLV, data cut at 32
+ * bytes) through cb. dir is the prefix of the header line ("RX"/"TX").
+ */
+void qmi_frame_dump(qmi_frame_dump_cb cb, void *priv, const char *dir,
+		    const void *buf, size_t len);
+
+#endif /* __QMI_FRAME_H */

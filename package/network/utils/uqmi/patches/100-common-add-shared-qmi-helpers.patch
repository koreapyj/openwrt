+void ext_fmt_tx_rx_info(struct blob_buf *b, int8_t radio, const struct qmi_nas_get_tx_rx_info_response *resp)
+{
+	const struct qmi_nas_get_tx_rx_info_response res = *resp;
+	void *c, *t;
+
+	t = blobmsg_open_table(b, NULL);
+	if (res.set.rx_chain_0_info) {
+		c = blobmsg_open_table(b, "rx_chain_0");

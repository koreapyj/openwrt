+/*
+ * Pure helpers for the QMI PDC service, see pdc-util.h.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#include <string.h>
+
+#include "pdc-util.h"
+#include "qmi-enums-pdc.h"
+#include "sha1.h"
+
+static const char *const pdc_type_names[] = {
+	[QMI_PDC_CONFIGURATION_TYPE_PLATFORM] = "platform",
+	[QMI_PDC_CONFIGURATION_TYPE_SOFTWARE] = "software",
+};
+
+#define PDC_N_TYPES (sizeof(pdc_type_names) / sizeof(pdc_type_names[0]))
+
+static int hex_val(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+
+	return -1;
+}
+
+bool pdc_id_parse(const char *str, uint8_t id[PDC_ID_MAX], unsigned int *len)
+{
+	size_t n = strlen(str), i;
+
+	if (!n || n % 2 || n > PDC_ID_MAX * 2)
+		return false;
+
+	for (i = 0; i < n; i += 2) {
+		int hi = hex_val(str[i]), lo = hex_val(str[i + 1]);
+
+		if (hi < 0 || lo < 0)
+			return false;
+		id[i / 2] = hi << 4 | lo;
+	}
+	*len = n / 2;
+
+	return true;
+}
+
+bool pdc_id_format(const uint8_t *id, unsigned int len, char str[PDC_ID_STR_MAX])
+{
+	static const char digits[] = "0123456789abcdef";
+	unsigned int i;
+
+	str[0] = '\0';
+	if (len > PDC_ID_MAX)
+		return false;
+
+	for (i = 0; i < len; i++) {
+		str[i * 2] = digits[id[i] >> 4];
+		str[i * 2 + 1] = digits[id[i] & 0xf];
+	}
+	str[len * 2] = '\0';
+
+	return true;
+}
+
+bool pdc_id_equal(const uint8_t *a, unsigned int a_n, const uint8_t *b, unsigned int b_n)
+{
+	return a_n && a_n == b_n && !memcmp(a, b, a_n);
+}
+
+unsigned int pdc_id_from_file(uint8_t id[PDC_ID_MAX], const void *data, size_t size)
+{
+	sha1(id, data, size);
+
+	return SHA1_DIGEST_SIZE;
+}
+
+const char *pdc_type_name(uint32_t type)
+{
+	if (type < PDC_N_TYPES && pdc_type_names[type])
+		return pdc_type_names[type];
+
+	return "unknown";
+}
+
+bool pdc_type_parse(const char *name, uint32_t *type)
+{
+	unsigned int i;
+
+	for (i = 0; i < PDC_N_TYPES; i++) {
+		if (pdc_type_names[i] && !strcmp(name, pdc_type_names[i])) {
+			*type = i;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+bool pdc_token_valid(bool set, uint32_t token, uint32_t expected)
+{
+	return !set || token == expected;
+}
+
+bool pdc_result_failed(bool set, uint16_t result, bool allow_not_provisioned)
+{
+	if (!set || !result)
+		return false;
+
+	return !(allow_not_provisioned && result == PDC_ERROR_NOT_PROVISIONED);
+}

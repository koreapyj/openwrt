+/* host test: shared QMUX frame helpers (common/qmi-frame.c). Usage: test_frame */
+#include <stdio.h>
+#include <string.h>
+#include "qmi-frame.h"
+#include "mbim.h"
+
+static int fails;
+
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+
+/* build a QMUX frame; ctl selects the 8 bit transaction CTL header */
+static size_t build(uint8_t *b, int ctl, uint8_t flags, uint8_t cid, uint16_t tid, uint16_t msgid,
+		    const uint8_t *tlvs, uint16_t tlv_len)
+{
+	size_t hdr = ctl ? 5 : 6, n = 0, total = 1 + 5 + 1 + hdr + tlv_len;
+
+	b[n++] = 1;
+	b[n++] = (total - 1) & 0xff; b[n++] = (total - 1) >> 8;
+	b[n++] = 0;			/* qmux flags */
+	b[n++] = ctl ? 0 : 0x01;	/* service: CTL / WDS */
+	b[n++] = cid;
+	b[n++] = flags;
+	b[n++] = tid & 0xff;
+	if (!ctl)
+		b[n++] = tid >> 8;
+	b[n++] = msgid & 0xff; b[n++] = msgid >> 8;
+	b[n++] = tlv_len & 0xff; b[n++] = tlv_len >> 8;
+	if (tlv_len)
+		memcpy(b + n, tlvs, tlv_len);
+	return n + tlv_len;
+}
+
+static void line(void *priv, const char *l) { int *n = priv; printf("  dump: %s\n", l); (*n)++; }
+
+int main(void)
+{
+	static const uint8_t tlv[] = { 0x02, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x01, 0x00, 0xaa };
+	uint8_t b[256], m[512];
+	struct qmi_frame_info i;
+	size_t n, k, consume, qlen;
+	const void *q;
+	int dumped = 0;
+
+	/* service response with TLVs */
+	n = build(b, 0, 0x02, 3, 0x1234, 0x0020, tlv, sizeof(tlv));
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n);
+	CHECK(!i.ctl && i.response && !i.indication && i.service == 1 && i.client == 3);
+	CHECK(i.tid == 0x1234 && i.message == 0x20 && i.tlv_len == sizeof(tlv) && i.len == n && i.tlv_ofs == n - sizeof(tlv));
+
+	/* service indication, broadcast cid */
+	n = build(b, 0, 0x04, 0xff, 7, 0x0001, NULL, 0);
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n);
+	CHECK(i.indication && !i.response && i.client == 0xff);
+	CHECK(qmi_frame_ind_for_client(i.client, 5));
+	CHECK(qmi_frame_ind_for_client(5, 5) && !qmi_frame_ind_for_client(4, 5));
+
+	/* CTL response: 8 bit tid, other flag bits */
+	n = build(b, 1, 0x01, 0, 0x42, 0x0022, tlv, sizeof(tlv));
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n);
+	CHECK(i.ctl && i.response && !i.indication && i.tid == 0x42 && i.message == 0x22);
+	CHECK(!qmi_frame_is_ctl_sync(&i));
+
+	/* CTL SYNC indication; the same bits in a service message are no SYNC */
+	n = build(b, 1, 0x02, 0, 0, QMI_FRAME_CTL_SYNC, NULL, 0);
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n);
+	CHECK(i.ctl && i.indication && !i.response && qmi_frame_is_ctl_sync(&i));
+	n = build(b, 0, 0x04, 1, 0, QMI_FRAME_CTL_SYNC, NULL, 0);
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n && !qmi_frame_is_ctl_sync(&i));
+	/* CTL response flag with the SYNC id is not an indication */
+	n = build(b, 1, 0x01, 0, 0, QMI_FRAME_CTL_SYNC, NULL, 0);
+	CHECK(qmi_frame_parse(b, n, &i) == (int) n && !qmi_frame_is_ctl_sync(&i));
+
+	/* the same flag byte means different things for CTL (0x02 = ind) and service (0x02 = resp) */
+	n = build(b, 1, 0x02, 0, 1, 1, NULL, 0);
+	qmi_frame_parse(b, n, &i);
+	CHECK(i.indication && !i.response);
+	n = build(b, 0, 0x02, 1, 1, 1, NULL, 0);
+	qmi_frame_parse(b, n, &i);
+	CHECK(i.response && !i.indication);
+
+	/* truncated at every length: need more, never invalid, never overread (ASan) */
+	n = build(b, 0, 0x02, 3, 1, 0x20, tlv, sizeof(tlv));
+	for (k = 0; k < n; k++)
+		CHECK(qmi_frame_parse(b, k, &i) == QMI_FRAME_NEED_MORE);
+
+	/* trailing data after the frame does not change the length */
+	memcpy(m, b, n);
+	memset(m + n, 0xee, 20);
+	CHECK(qmi_frame_parse(m, n + 20, &i) == (int) n);
+
+	/* bad marker */
+	b[0] = 0x02;
+	CHECK(qmi_frame_parse(b, n, &i) == QMI_FRAME_INVALID);
+	CHECK(qmi_frame_parse(b, 1, &i) == QMI_FRAME_INVALID);
+	b[0] = 1;
+
+	/* bad length: shorter than the headers (service header needs 13 bytes, CTL 12) */
+	b[1] = 5; b[2] = 0;
+	CHECK(qmi_frame_parse(b, n, &i) == QMI_FRAME_INVALID);
+	n = build(b, 1, 0x01, 0, 1, 1, NULL, 0);
+	b[1] = 10; b[2] = 0;	/* total 11 < 12 */
+	CHECK(qmi_frame_parse(b, n, &i) == QMI_FRAME_INVALID);
+	b[1] = 11;		/* total 12 */
+	CHECK(qmi_frame_parse(b, n, &i) == 12);
+	/* bad length: TLV area longer than the frame */
+	n = build(b, 0, 0x02, 3, 1, 0x20, tlv, sizeof(tlv));
+	b[n - sizeof(tlv) - 2] = sizeof(tlv) + 1;
+	CHECK(qmi_frame_parse(b, n, &i) == QMI_FRAME_INVALID);
+
+	/* NULL info is allowed */
+	n = build(b, 0, 0x02, 3, 1, 0x20, tlv, sizeof(tlv));
+	CHECK(qmi_frame_parse(b, n, NULL) == (int) n);
+
+	/* dump: header line + 2 TLVs */
+	qmi_frame_dump(line, &dumped, "RX", b, n);
+	CHECK(dumped == 3);
+	dumped = 0;
+	qmi_frame_dump(line, &dumped, "RX", b, 3);
+	CHECK(dumped == 1);
+
+	/* MBIM: command done carrying a QMI frame */
+	{
+		struct mbim_command_message mb;
+		static const uint8_t qmiuuid[16] = { 0xd1, 0xa3, 0x0b, 0xc2, 0xf9, 0x7a, 0x6e, 0x43,
+						     0xbf, 0x65, 0xc7, 0xe2, 0x4f, 0xb0, 0xf0, 0xd3 };
+		size_t total = sizeof(mb) + n;
+
+		memset(&mb, 0, sizeof(mb));
+		mb.header.type = MBIM_MESSAGE_TYPE_COMMAND_DONE;
+		mb.header.length = total;
+		mb.command_id = MBIM_CID_QMI_MSG;
+		memcpy(mb.service_id, qmiuuid, 16);
+		mb.buffer_length = n;
+		memcpy(m, &mb, sizeof(mb));
+		memcpy(m + sizeof(mb), b, n);
+		memset(m + total, 0xee, 16);
+
+		CHECK(qmi_mbim_deframe(m, total + 16, &consume, &q, &qlen) == QMI_MBIM_QMI);
+		CHECK(consume == total && q == m + sizeof(mb) && qlen == n);
+		CHECK(qmi_frame_parse(q, qlen, &i) == (int) n && i.message == 0x20);
+		for (k = 0; k < total; k++)
+			CHECK(qmi_mbim_deframe(m, k, &consume, &q, &qlen) == QMI_FRAME_NEED_MORE);
+
+		/* other MBIM message: skipped as a whole */
+		mb.command_id = 5;
+		memcpy(m, &mb, sizeof(mb));
+		CHECK(qmi_mbim_deframe(m, total, &consume, &q, &qlen) == QMI_MBIM_SKIP && consume == total);
+
+		/* bogus MBIM length */
+		mb.header.length = 4;
+		memcpy(m, &mb, sizeof(mb));
+		CHECK(qmi_mbim_deframe(m, total, &consume, &q, &qlen) == QMI_FRAME_INVALID);
+	}
+
+	printf(fails ? "%d FAILURES\n" : "all ok\n", fails);
+	return fails != 0;
+}

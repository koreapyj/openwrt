+const char *ext_nas_roaming_name(bool set, uint8_t pref)
+{
+	if (!set)
+		return "unknown";
+
+	switch (pref) {
+	case QMI_NAS_ROAMING_PREFERENCE_ANY:
+		return "any";
+	case QMI_NAS_ROAMING_PREFERENCE_OFF:
+		return "off";
+	case QMI_NAS_ROAMING_PREFERENCE_NOT_OFF:
+		return "only";
+	case QMI_NAS_ROAMING_PREFERENCE_NOT_FLASHING:
+		return "not-flashing";
+	}
+
+	return "unknown";
+}
+
+bool ext_nas_roaming_parse(const char *name, uint8_t *pref)
+{
+	if (!strcmp(name, "any"))
+		*pref = QMI_NAS_ROAMING_PREFERENCE_ANY;
+	else if (!strcmp(name, "only"))
+		*pref = QMI_NAS_ROAMING_PREFERENCE_NOT_OFF;
+	else if (!strcmp(name, "off"))
+		*pref = QMI_NAS_ROAMING_PREFERENCE_OFF;
+	else
+		return false;
+
+	return true;
+}

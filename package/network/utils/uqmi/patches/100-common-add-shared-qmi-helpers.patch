+/* All Call Status indication -> plain struct, see voice-util.h */
+
+#include <string.h>
+
+#include "qmi-message.h"
+#include "voice-util.h"
+
+bool voice_parse_all_call_status(struct qmi_msg *msg, struct voice_all_calls *out)
+{
+	struct qmi_voice_all_call_status_indication res;
+	unsigned int i;
+
+	memset(out, 0, sizeof(*out));
+	memset(&res, 0, sizeof(res));
+	qmi_parse_voice_all_call_status_indication(msg, &res);
+
+	if (!res.data.call_information)
+		return false;
+
+	out->n_calls = res.data.call_information_n;
+	if (out->n_calls > VOICE_MAX_CALLS)
+		out->n_calls = VOICE_MAX_CALLS;
+	for (i = 0; i < out->n_calls; i++) {
+		out->calls[i].id = res.data.call_information[i].id;
+		out->calls[i].state = res.data.call_information[i].state;
+		out->calls[i].type = res.data.call_information[i].type;
+		out->calls[i].direction = res.data.call_information[i].direction;
+		out->calls[i].mode = res.data.call_information[i].mode;
+	}
+
+	out->n_numbers = res.data.remote_party_number_n;
+	if (out->n_numbers > VOICE_MAX_CALLS)
+		out->n_numbers = VOICE_MAX_CALLS;
+	for (i = 0; i < out->n_numbers; i++) {
+		out->numbers[i].id = res.data.remote_party_number[i].id;
+		out->numbers[i].number = res.data.remote_party_number[i].type;
+	}
+
+	out->n_ends = res.data.call_end_reason_n;
+	if (out->n_ends > VOICE_MAX_CALLS)
+		out->n_ends = VOICE_MAX_CALLS;
+	for (i = 0; i < out->n_ends; i++) {
+		out->ends[i].id = res.data.call_end_reason[i].id;
+		out->ends[i].reason = res.data.call_end_reason[i].reason;
+	}
+
+	out->n_causes = res.data.raw_call_end_cause_code_n;
+	if (out->n_causes > VOICE_MAX_CALLS)
+		out->n_causes = VOICE_MAX_CALLS;
+	for (i = 0; i < out->n_causes; i++) {
+		out->causes[i].id = res.data.raw_call_end_cause_code[i].id;
+		out->causes[i].cause = res.data.raw_call_end_cause_code[i].cause;
+	}
+
+	return true;
+}

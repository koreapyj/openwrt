+/* host test: the CLI's decode -> JSON path (uqmi/sms-json.c) on vectors.txt PDUs. Usage: test_json vectors.txt */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "sms-json.h"
+
+static int fails;
+
+static void run(const char *name, const char *hex, const char *expect)
+{
+	uint8_t pdu[256];
+	struct blob_buf b = { .len = 0 };
+	char err[128] = "";
+	size_t n = strlen(hex) / 2, i;
+
+	for (i = 0; i < n; i++) { unsigned v; sscanf(hex + 2 * i, "%2x", &v); pdu[i] = v; }
+	b.out[0] = 0;
+	if (uqmi_sms_pdu_to_blob(&b, pdu, n, err, sizeof(err))) { printf("FAIL %s: %s\n", name, err); fails++; return; }
+	if (strcmp(b.out, expect)) { printf("FAIL %s:\n got  %s\n want %s\n", name, b.out, expect); fails++; }
+	else printf("ok %s: %s\n", name, b.out);
+}
+
+static char *find(FILE *f, const char *key)
+{
+	static char line[1024];
+	size_t kl = strlen(key);
+
+	rewind(f);
+	while (fgets(line, sizeof(line), f))
+		if (!strncmp(line, key, kl) && line[kl] == '=') { line[strcspn(line, "\r\n")] = 0; return line + kl + 1; }
+	return NULL;
+}
+
+int main(int argc, char **argv)
+{
+	FILE *f = fopen(argv[1], "r");
+	char *h;
+
+	if (!f) return 2;
+	h = find(f, "deliver_gsm7_hello");
+	run("gsm7", h, "\"smsc\":\"+821029190200\",\"sender\":\"+31641600986\",\"timestamp\":\"2026-11-19 12:34:56\",\"text\":\"Hellohello\"");
+	h = find(f, "deliver_ucs2_ko");
+	run("ucs2", h, "\"smsc\":\"+821029190200\",\"sender\":\"+821012345678\",\"timestamp\":\"2026-11-19 12:34:56\",\"ucs-2\":\"c548b155d558c138c6940020d14cc2a4d2b8\",\"text\":\"\xec\x95\x88\xeb\x85\x95\xed\x95\x98\xec\x84\xb8\xec\x9a\x94 \xed\x85\x8c\xec\x8a\xa4\xed\x8a\xb8\"");
+	return fails ? 1 : 0;
+}

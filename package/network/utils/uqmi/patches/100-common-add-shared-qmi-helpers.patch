+/*
+ * uqmi -- character sets of the SMS codec (ModemManager: mm-charsets.c).
+ *
+ * The alphabets are the ones of ETSI GSM 03.38 (the same mapping as MM's gsm_def_utf8_alphabet and
+ * gsm_ext_utf8_alphabet), kept as code points here.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "charsets.h"
+
+#define GSM_ESCAPE 0x1b
+
+/* default alphabet, index = septet. 0x1b is the escape to the extension table. */
+static const uint16_t gsm_def[128] = {
+	/* 0x00 */ 0x0040, 0x00a3, 0x0024, 0x00a5, 0x00e8, 0x00e9, 0x00f9, 0x00ec,
+	/* 0x08 */ 0x00f2, 0x00c7, 0x000a, 0x00d8, 0x00f8, 0x000d, 0x00c5, 0x00e5,
+	/* 0x10 */ 0x0394, 0x005f, 0x03a6, 0x0393, 0x039b, 0x03a9, 0x03a0, 0x03a8,
+	/* 0x18 */ 0x03a3, 0x0398, 0x039e, 0x00a0, 0x00c6, 0x00e6, 0x00df, 0x00c9,
+	/* 0x20 */ 0x0020, 0x0021, 0x0022, 0x0023, 0x00a4, 0x0025, 0x0026, 0x0027,
+	/* 0x28 */ 0x0028, 0x0029, 0x002a, 0x002b, 0x002c, 0x002d, 0x002e, 0x002f,
+	/* 0x30 */ 0x0030, 0x0031, 0x0032, 0x0033, 0x0034, 0x0035, 0x0036, 0x0037,
+	/* 0x38 */ 0x0038, 0x0039, 0x003a, 0x003b, 0x003c, 0x003d, 0x003e, 0x003f,
+	/* 0x40 */ 0x00a1, 0x0041, 0x0042, 0x0043, 0x0044, 0x0045, 0x0046, 0x0047,
+	/* 0x48 */ 0x0048, 0x0049, 0x004a, 0x004b, 0x004c, 0x004d, 0x004e, 0x004f,
+	/* 0x50 */ 0x0050, 0x0051, 0x0052, 0x0053, 0x0054, 0x0055, 0x0056, 0x0057,
+	/* 0x58 */ 0x0058, 0x0059, 0x005a, 0x00c4, 0x00d6, 0x00d1, 0x00dc, 0x00a7,
+	/* 0x60 */ 0x00bf, 0x0061, 0x0062, 0x0063, 0x0064, 0x0065, 0x0066, 0x0067,
+	/* 0x68 */ 0x0068, 0x0069, 0x006a, 0x006b, 0x006c, 0x006d, 0x006e, 0x006f,
+	/* 0x70 */ 0x0070, 0x0071, 0x0072, 0x0073, 0x0074, 0x0075, 0x0076, 0x0077,
+	/* 0x78 */ 0x0078, 0x0079, 0x007a, 0x00e4, 0x00f6, 0x00f1, 0x00fc, 0x00e0,
+};
+
+static const struct {
+	uint8_t gsm;
+	uint16_t cp;
+} gsm_ext[] = {
+	{ 0x0a, 0x000c }, /* form feed */
+	{ 0x14, 0x005e }, /* ^ */
+	{ 0x28, 0x007b }, /* { */
+	{ 0x29, 0x007d }, /* } */
+	{ 0x2f, 0x005c }, /* \ */
+	{ 0x3c, 0x005b }, /* [ */
+	{ 0x3d, 0x007e }, /* ~ */
+	{ 0x3e, 0x005d }, /* ] */
+	{ 0x40, 0x007c }, /* | */
+	{ 0x65, 0x20ac }, /* euro */
+};
+
+#define ARRAY_LEN(a) (sizeof(a) / sizeof((a)[0]))
+
+/*****************************************************************************/
+/* UTF-8 */
+
+size_t cs_utf8_decode(const char *s, size_t len, uint32_t *cp)
+{
+	const unsigned char *p = (const unsigned char *)s;
+	uint32_t c;
+	size_t n, i;
+
+	if (!len)
+		return 0;
+
+	c = p[0];
+	if (c < 0x80) {
+		*cp = c;
+		return 1;
+	}
+	if (c >= 0xc2 && c <= 0xdf) {
+		n = 2;
+		c &= 0x1f;
+	} else if (c >= 0xe0 && c <= 0xef) {
+		n = 3;
+		c &= 0x0f;
+	} else if (c >= 0xf0 && c <= 0xf4) {
+		n = 4;
+		c &= 0x07;
+	} else {
+		return 0;
+	}
+
+	if (len < n)
+		return 0;
+
+	for (i = 1; i < n; i++) {
+		if ((p[i] & 0xc0) != 0x80)
+			return 0;
+		c = (c << 6) | (p[i] & 0x3f);
+	}
+
+	/* overlong forms, surrogates and out of range */
+	if ((n == 3 && c < 0x800) || (n == 4 && c < 0x10000) || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff))
+		return 0;
+
+	*cp = c;
+	return n;
+}
+
+size_t cs_utf8_encode(uint32_t cp, char out[4])
+{
+	if (cp < 0x80) {
+		out[0] = cp;
+		return 1;
+	}
+	if (cp < 0x800) {
+		out[0] = 0xc0 | (cp >> 6);
+		out[1] = 0x80 | (cp & 0x3f);
+		return 2;
+	}
+	if (cp < 0x10000) {
+		out[0] = 0xe0 | (cp >> 12);
+		out[1] = 0x80 | ((cp >> 6) & 0x3f);
+		out[2] = 0x80 | (cp & 0x3f);
+		return 3;
+	}
+	out[0] = 0xf0 | (cp >> 18);
+	out[1] = 0x80 | ((cp >> 12) & 0x3f);
+	out[2] = 0x80 | ((cp >> 6) & 0x3f);
+	out[3] = 0x80 | (cp & 0x3f);
+	return 4;
+}
+
+bool cs_utf8_valid(const char *s)
+{
+	size_t len = strlen(s);
+	uint32_t cp;
+
+	while (len) {
+		size_t n = cs_utf8_decode(s, len, &cp);
+
+		if (!n)
+			return false;
+		s += n;
+		len -= n;
+	}
+
+	return true;
+}
+
+/*****************************************************************************/
+/* GSM 03.38 */
+
+/* utf8_to_gsm_char(): 1 default alphabet, 2 extension table, 0 none */
+unsigned cs_gsm7_char_len(uint32_t cp)
+{
+	unsigned i;
+
+	for (i = 0; i < ARRAY_LEN(gsm_def); i++) {
+		/* the escape code (0x1b) is not a character */
+		if (i != GSM_ESCAPE && gsm_def[i] == cp)
+			return 1;
+	}
+	for (i = 0; i < ARRAY_LEN(gsm_ext); i++) {
+		if (gsm_ext[i].cp == cp)
+			return 2;
+	}
+
+	return 0;
+}
+
+bool cs_gsm7_can_encode(const char *utf8)
+{
+	size_t len = strlen(utf8);
+	uint32_t cp;
+
+	while (len) {
+		size_t n = cs_utf8_decode(utf8, len, &cp);
+
+		if (!n || !cs_gsm7_char_len(cp))
+			return false;
+		utf8 += n;
+		len -= n;
+	}
+
+	return true;
+}
+
+uint8_t *cs_gsm7_from_utf8(const char *utf8, size_t *n_septets)
+{
+	size_t len = strlen(utf8), o = 0;
+	uint8_t *out = malloc(len * 2 + 1);
+	uint32_t cp;
+
+	if (!out)
+		return NULL;
+
+	while (len) {
+		size_t n = cs_utf8_decode(utf8, len, &cp);
+		unsigned i, l = n ? cs_gsm7_char_len(cp) : 0;
+
+		if (!l)
+			goto err;
+
+		if (l == 1) {
+			for (i = 0; i < ARRAY_LEN(gsm_def); i++) {
+				if (i != GSM_ESCAPE && gsm_def[i] == cp) {
+					out[o++] = i;
+					break;
+				}
+			}
+		} else {
+			for (i = 0; i < ARRAY_LEN(gsm_ext); i++) {
+				if (gsm_ext[i].cp == cp) {
+					out[o++] = GSM_ESCAPE;
+					out[o++] = gsm_ext[i].gsm;
+					break;
+				}
+			}
+		}
+		utf8 += n;
+		len -= n;
+	}
+
+	*n_septets = o;
+	return out;
+
+err:
+	free(out);
+	return NULL;
+}
+
+char *cs_gsm7_to_utf8(const uint8_t *septets, size_t n)
+{
+	char *out = malloc(n * 3 + 1);
+	size_t i, o = 0;
+
+	if (!out)
+		return NULL;
+
+	for (i = 0; i < n; i++) {
+		uint8_t c = septets[i] & 0x7f;
+		uint32_t cp = 0;
+
+		if (c == GSM_ESCAPE) {
+			unsigned j;
+
+			/* a trailing escape code is dropped */
+			if (i + 1 >= n)
+				break;
+			c = septets[++i] & 0x7f;
+			/* an unknown extension is displayed as the default alphabet character (03.38) */
+			cp = gsm_def[c];
+			for (j = 0; j < ARRAY_LEN(gsm_ext); j++) {
+				if (gsm_ext[j].gsm == c) {
+					cp = gsm_ext[j].cp;
+					break;
+				}
+			}
+			if (c == GSM_ESCAPE)
+				cp = 0x20;
+		} else {
+			cp = gsm_def[c];
+		}
+		o += cs_utf8_encode(cp, out + o);
+	}
+
+	out[o] = '\0';
+	return out;
+}
+
+/* mm_charset_gsm_unpack() */
+void cs_gsm7_unpack(const uint8_t *src, size_t src_len, size_t n_septets, unsigned bit_offset, uint8_t *out)
+{
+	size_t i;
+
+	for (i = 0; i < n_septets; i++) {
+		size_t start_bit = bit_offset + i * 7;
+		size_t byte = start_bit / 8;
+		unsigned offset = start_bit % 8;
+		unsigned bits_here = offset ? (8 - offset) : 7;
+		unsigned bits_in_next = 7 - bits_here;
+		uint8_t c = 0;
+
+		if (byte < src_len)
+			c = (src[byte] >> offset) & (0xff >> (8 - bits_here));
+		if (bits_in_next && byte + 1 < src_len)
+			c |= (src[byte + 1] & (0xff >> (8 - bits_in_next))) << bits_here;
+		out[i] = c;
+	}
+}
+
+/* mm_charset_gsm_pack() */
+size_t cs_gsm7_pack(const uint8_t *septets, size_t n, unsigned shift, uint8_t *out)
+{
+	size_t plen = (n * 7 + shift + 7) / 8;
+	size_t i, octet = 0;
+	unsigned lshift = shift;
+
+	memset(out, 0, plen);
+	for (i = 0; i < n; i++) {
+		out[octet] |= (septets[i] & 0x7f) << lshift;
+		if (lshift > 1)
+			out[octet + 1] = (septets[i] & 0x7f) >> (8 - lshift);
+		if (lshift)
+			octet++;
+		lshift = lshift ? lshift - 1 : 7;
+	}
+
+	return plen;
+}
+
+/*****************************************************************************/
+/* UTF-16BE */
+
+unsigned cs_utf16_len(uint32_t cp)
+{
+	return cp >= 0x10000 ? 4 : 2;
+}
+
+uint8_t *cs_utf8_to_utf16be(const char *utf8, size_t *len)
+{
+	size_t l = strlen(utf8), o = 0;
+	uint8_t *out = malloc(l * 2 + 2);
+	uint32_t cp;
+
+	if (!out)
+		return NULL;
+
+	while (l) {
+		size_t n = cs_utf8_decode(utf8, l, &cp);
+
+		if (!n) {
+			free(out);
+			return NULL;
+		}
+		if (cp >= 0x10000) {
+			uint32_t v = cp - 0x10000;
+			uint16_t hi = 0xd800 | (v >> 10), lo = 0xdc00 | (v & 0x3ff);
+
+			out[o++] = hi >> 8;
+			out[o++] = hi & 0xff;
+			out[o++] = lo >> 8;
+			out[o++] = lo & 0xff;
+		} else {
+			out[o++] = cp >> 8;
+			out[o++] = cp & 0xff;
+		}
+		utf8 += n;
+		l -= n;
+	}
+
+	*len = o;
+	return out;
+}
+
+char *cs_utf16be_to_utf8(const uint8_t *buf, size_t len)
+{
+	char *out = malloc(len / 2 * 4 + 1);
+	size_t i, o = 0;
+
+	if (!out)
+		return NULL;
+
+	for (i = 0; i + 1 < len; i += 2) {
+		uint32_t u = (buf[i] << 8) | buf[i + 1];
+
+		if (u >= 0xd800 && u <= 0xdbff) {
+			uint32_t lo = 0;
+
+			if (i + 3 < len)
+				lo = (buf[i + 2] << 8) | buf[i + 3];
+			if (lo >= 0xdc00 && lo <= 0xdfff) {
+				u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00);
+				i += 2;
+			} else {
+				u = 0xfffd;
+			}
+		} else if (u >= 0xdc00 && u <= 0xdfff) {
+			u = 0xfffd;
+		}
+		o += cs_utf8_encode(u, out + o);
+	}
+
+	out[o] = '\0';
+	return out;
+}

+bool ext_nas_radio_parse(const char *name, int8_t *radio)
+{
+	if (!strcmp(name, "5gnr"))
+		*radio = QMI_NAS_RADIO_INTERFACE_5GNR;
+	else if (!strcmp(name, "lte"))
+		*radio = QMI_NAS_RADIO_INTERFACE_LTE;
+	else if (!strcmp(name, "umts"))
+		*radio = QMI_NAS_RADIO_INTERFACE_UMTS;
+	else if (!strcmp(name, "gsm"))
+		*radio = QMI_NAS_RADIO_INTERFACE_GSM;
+	else
+		return false;
+
+	return true;
+}

+char *ext_hex_spaced(char *buf, const uint8_t *data, unsigned int n)
+{
+	char *p = buf;
+	unsigned int i;
+
+	*p = 0;
+	for (i = 0; i < n; i++)
+		p += sprintf(p, &" %02x"[i ? 0 : 1], data[i]);
+
+	return buf;
+}
+
+static int ext_hex_nibble(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+
+	return -1;
+}
+
+bool ext_hex_parse(const char *str, uint8_t *out, unsigned int max, unsigned int *len)
+{
+	size_t n = strlen(str);
+	unsigned int i;
+
+	if (!n || n % 2 || n / 2 > max)
+		return false;
+
+	for (i = 0; i < n / 2; i++) {
+		int hi = ext_hex_nibble(str[2 * i]);
+		int lo = ext_hex_nibble(str[2 * i + 1]);
+
+		if (hi < 0 || lo < 0)
+			return false;
+		out[i] = hi << 4 | lo;
+	}
+
+	*len = n / 2;
+	return true;
+}

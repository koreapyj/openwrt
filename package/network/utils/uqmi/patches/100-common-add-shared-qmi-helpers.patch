+static void
+print_chain_info(struct blob_buf *b, int8_t radio, bool tuned, int32_t rssi, int32_t ecio, int32_t rsrp, int32_t rscp, uint32_t phase)
+{
+	blobmsg_add_u8(b, "tuned", tuned);
+	blobmsg_add_double(b, "rssi", (double) rssi*0.1);
+	if (radio == QMI_NAS_RADIO_INTERFACE_5GNR) {
+		blobmsg_add_double(b, "rsrp", (double) rsrp*-0.1);
+	}
+	else if (radio == QMI_NAS_RADIO_INTERFACE_LTE) {
+		blobmsg_add_double(b, "rsrq", (double) ecio*-0.1);
+		blobmsg_add_double(b, "rsrp", (double) rsrp*-0.1);
+	}
+	else if (radio == QMI_NAS_RADIO_INTERFACE_UMTS) {
+		blobmsg_add_double(b, "ecio", (double) ecio*-0.1);
+		blobmsg_add_double(b, "rscp", (double) rscp*-0.1);
+	}
+	if (phase != 0xFFFFFFFF)
+		blobmsg_add_double(b, "phase", (double) phase*0.01);
+}

+/*
+ * uqmi -- SMS PDU codec (ModemManager: mm-sms-part.c, mm-sms-part-3gpp.c and the text splitting of
+ * mm-charsets.c, mm-base-sms.c).
+ *
+ * Deviations from MM:
+ *  - a part without user data (UDL 0) decodes to an empty text (MM drops the PDU: "no elements to decode");
+ *  - invalid UTF-16 (lone surrogates) is replaced by U+FFFD instead of failing the PDU;
+ *  - the timestamps are ISO8601 with a colon in the time zone offset (+09:00);
+ *  - the validity period is rounded up to the next valid TP-VP step (MM rounds with an off by one in some
+ *    ranges).
+ */
+
+#include <ctype.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "charsets.h"
+#include "sms_part.h"
+
+#define SMS_TP_MTI_MASK 0x03
+#define SMS_TP_MTI_SMS_DELIVER 0x00
+#define SMS_TP_MTI_SMS_SUBMIT 0x01
+#define SMS_TP_MTI_SMS_STATUS_REPORT 0x02
+
+#define SMS_NUMBER_TYPE_MASK 0x70
+#define SMS_NUMBER_TYPE_INTL 0x10
+#define SMS_NUMBER_TYPE_ALPHA 0x50
+
+#define SMS_NUMBER_PLAN_MASK 0x0f
+#define SMS_NUMBER_PLAN_TELEPHONE 0x01
+
+#define SMS_DCS_CODING_UCS2 0x08
+#define SMS_DCS_CODING_8BIT 0x04
+#define SMS_DCS_CODING_DEFAULT 0x00
+#define SMS_DCS_CLASS_VALID 0x10
+#define SMS_DCS_CLASS_MASK 0x03
+
+#define SMS_ADDRESS_MAX_DIGITS 20
+#define SMS_ALPHA_MAX_SEPTETS 16
+/* the longest encoded address value: 20 digits, or 16 septets (14 bytes) */
+#define SMS_ADDRESS_MAX_BYTES 14
+
+static const char sms_bcd_chars[] = "0123456789*#abc\0\0";
+
+static void set_err(char *err, size_t errlen, const char *fmt, ...) __attribute__((format(printf, 3, 4)));
+static void set_err(char *err, size_t errlen, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (!err || !errlen)
+		return;
+
+	va_start(ap, fmt);
+	vsnprintf(err, errlen, fmt, ap);
+	va_end(ap);
+}
+
+/*****************************************************************************/
+/* the part */
+
+struct sms_part *sms_part_new(unsigned int index, enum sms_pdu_type type)
+{
+	struct sms_part *part = calloc(1, sizeof(*part));
+
+	if (!part)
+		return NULL;
+
+	part->index = index;
+	part->pdu_type = type;
+	part->encoding = SMS_ENC_UNKNOWN;
+	part->delivery_state = SMS_DELIVERY_STATE_UNKNOWN;
+	part->class = -1;
+
+	return part;
+}
+
+void sms_part_free(struct sms_part *part)
+{
+	if (!part)
+		return;
+
+	free(part->smsc);
+	free(part->number);
+	free(part->timestamp);
+	free(part->discharge_timestamp);
+	free(part->text);
+	free(part->data);
+	free(part);
+}
+
+void sms_part_take_text(struct sms_part *part, char *text)
+{
+	free(part->text);
+	part->text = text;
+}
+
+void sms_part_take_data(struct sms_part *part, uint8_t *data, size_t len)
+{
+	free(part->data);
+	part->data = data;
+	part->data_len = data ? len : 0;
+}
+
+static void set_str(char **field, const char *value)
+{
+	free(*field);
+	*field = value ? strdup(value) : NULL;
+}
+
+void sms_part_set_number(struct sms_part *part, const char *number)
+{
+	set_str(&part->number, number);
+}
+
+void sms_part_set_smsc(struct sms_part *part, const char *smsc)
+{
+	set_str(&part->smsc, smsc);
+}
+
+/*****************************************************************************/
+/* addresses and timestamps */
+
+static void semi_octets_to_bcd_string(char *dest, const uint8_t *octets, int num_octets)
+{
+	int i;
+
+	for (i = 0; i < num_octets; i++) {
+		*dest++ = sms_bcd_chars[octets[i] & 0xf];
+		*dest++ = sms_bcd_chars[(octets[i] >> 4) & 0xf];
+	}
+	*dest++ = '\0';
+}
+
+static bool char_to_bcd(char in, uint8_t *out)
+{
+	unsigned int z;
+
+	if (in >= '0' && in <= '9') {
+		*out = in - '0';
+		return true;
+	}
+
+	for (z = 10; z < 15; z++) {
+		if (in == sms_bcd_chars[z]) {
+			*out = z;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static size_t string_to_bcd_semi_octets(uint8_t *buf, const char *string)
+{
+	size_t slen = strlen(string), addrlen = slen, i;
+	uint8_t bcd;
+
+	if (!slen)
+		return 0;
+	if (addrlen % 2)
+		addrlen++;
+
+	for (i = 0; i < addrlen; i += 2) {
+		if (!char_to_bcd(string[i], &bcd))
+			return 0;
+		buf[i / 2] = bcd & 0xf;
+
+		if (i >= slen - 1) {
+			/* PDU address gets padded with 0xF if string is odd length */
+			bcd = 0xf;
+		} else if (!char_to_bcd(string[i + 1], &bcd)) {
+			return 0;
+		}
+		buf[i / 2] |= bcd << 4;
+	}
+
+	return addrlen / 2;
+}
+
+/* sms_decode_address(): @len_digits is in semi-octets, the caller has checked that the bytes are there */
+static char *decode_address(const uint8_t *address, size_t avail, unsigned int len_digits)
+{
+	uint8_t addrtype = address[0] & SMS_NUMBER_TYPE_MASK;
+	uint8_t addrplan = address[0] & SMS_NUMBER_PLAN_MASK;
+	char *utf8;
+
+	address++;
+	avail--;
+
+	if (addrtype == SMS_NUMBER_TYPE_ALPHA) {
+		size_t n = (len_digits * 4) / 7;
+		uint8_t *unpacked = malloc(n + 1);
+
+		if (!unpacked)
+			return NULL;
+		cs_gsm7_unpack(address, avail, n, 0, unpacked);
+		utf8 = cs_gsm7_to_utf8(unpacked, n);
+		free(unpacked);
+	} else if (addrtype == SMS_NUMBER_TYPE_INTL && addrplan == SMS_NUMBER_PLAN_TELEPHONE) {
+		/* International telephone number, format as "+1234567890" */
+		utf8 = malloc(len_digits + 4);
+		if (!utf8)
+			return NULL;
+		utf8[0] = '+';
+		semi_octets_to_bcd_string(utf8 + 1, address, (len_digits + 1) / 2);
+	} else {
+		/* All non-alphanumeric types and plans are just digits */
+		utf8 = malloc(len_digits + 3);
+		if (!utf8)
+			return NULL;
+		semi_octets_to_bcd_string(utf8, address, (len_digits + 1) / 2);
+	}
+
+	return utf8;
+}
+
+static char *decode_timestamp(const uint8_t *ts)
+{
+	unsigned int year = 2000 + (ts[0] & 0xf) * 10 + ((ts[0] >> 4) & 0xf);
+	unsigned int month = (ts[1] & 0xf) * 10 + ((ts[1] >> 4) & 0xf);
+	unsigned int day = (ts[2] & 0xf) * 10 + ((ts[2] >> 4) & 0xf);
+	unsigned int hour = (ts[3] & 0xf) * 10 + ((ts[3] >> 4) & 0xf);
+	unsigned int minute = (ts[4] & 0xf) * 10 + ((ts[4] >> 4) & 0xf);
+	unsigned int second = (ts[5] & 0xf) * 10 + ((ts[5] >> 4) & 0xf);
+	int quarters = (ts[6] & 0x7) * 10 + ((ts[6] >> 4) & 0xf);
+	int offset = quarters * 15;
+	char buf[40];
+
+	if (ts[6] & 0x08)
+		offset = -offset;
+
+	snprintf(buf, sizeof(buf), "%04u-%02u-%02uT%02u:%02u:%02u%c%02d:%02d", year, month, day, hour, minute, second,
+		 offset < 0 ? '-' : '+', (offset < 0 ? -offset : offset) / 60, (offset < 0 ? -offset : offset) % 60);
+
+	return strdup(buf);
+}
+
+bool sms_address_valid(const char *address)
+{
+	size_t n = 0;
+	uint8_t bcd;
+
+	if (*address == '+')
+		address++;
+
+	for (; *address; address++, n++) {
+		if (!char_to_bcd(*address, &bcd))
+			return false;
+	}
+
+	return n >= 1 && n <= SMS_ADDRESS_MAX_DIGITS;
+}
+
+/* an alphanumeric address (TON 5): up to 16 GSM 03.38 septets, an escaped extension character counts 2 */
+static bool alpha_septets(const char *address, uint8_t **septets, size_t *n)
+{
+	*septets = NULL;
+	if (!*address || !cs_utf8_valid(address))
+		return false;
+	*septets = cs_gsm7_from_utf8(address, n);
+	if (!*septets)
+		return false;
+	if (*n < 1 || *n > SMS_ALPHA_MAX_SEPTETS) {
+		free(*septets);
+		*septets = NULL;
+		return false;
+	}
+	return true;
+}
+
+bool sms_destination_valid(const char *address)
+{
+	uint8_t *septets;
+	size_t n;
+	bool ok;
+
+	if (sms_address_valid(address))
+		return true;
+	if (*address == '+')
+		address++;
+	ok = alpha_septets(address, &septets, &n);
+	free(septets);
+	return ok;
+}
+
+unsigned int sms_part_3gpp_encode_address(const char *address, uint8_t *buf, size_t buflen, bool is_smsc)
+{
+	size_t len;
+
+	if (buflen < 2 + SMS_ADDRESS_MAX_BYTES)
+		return 0;
+
+	if (!sms_address_valid(address)) {
+		/* Not BCD-able: an alphanumeric destination. TP-DA only, an SMSC is always a number. A leading '+'
+		 * is dropped as it always was. */
+		uint8_t *septets;
+		size_t n;
+
+		if (is_smsc)
+			return 0;
+		if (*address == '+')
+			address++;
+		if (!alpha_septets(address, &septets, &n))
+			return 0;
+		len = cs_gsm7_pack(septets, n, 0, &buf[2]);
+		free(septets);
+		buf[1] = 0x80 | SMS_NUMBER_TYPE_ALPHA; /* NPI is unused for TON 5 */
+		/* TP-DA length: useful semi-octets (23.040 9.1.2.5) */
+		buf[0] = (n * 7 + 3) / 4;
+		return len + 2;
+	}
+
+	/* Handle number type & plan */
+	buf[1] = 0x80; /* Bit 7 always 1 */
+	if (address[0] == '+') {
+		buf[1] |= SMS_NUMBER_TYPE_INTL;
+		address++;
+	}
+	buf[1] |= SMS_NUMBER_PLAN_TELEPHONE;
+
+	len = string_to_bcd_semi_octets(&buf[2], address);
+	if (is_smsc)
+		buf[0] = len + 1; /* addr length + size byte */
+	else
+		buf[0] = strlen(address); /* number of digits in address */
+
+	return len ? len + 2 : 0;
+}
+
+/*****************************************************************************/
+/* encodings and validity */
+
+/* sms_encoding_type() */
+static enum sms_encoding encoding_type(int dcs)
+{
+	switch ((dcs >> 4) & 0xf) {
+	/* General data coding group */
+	case 0:
+	case 1:
+	case 2:
+	case 3:
+		switch (dcs & 0x0c) {
+		case 0x08:
+			return SMS_ENC_UCS2;
+		case 0x04:
+			return SMS_ENC_8BIT;
+		default:
+			/* 0x00 and the reserved 0x0c: treat it as default alphabet */
+			return SMS_ENC_GSM7;
+		}
+	/* Message waiting group (default alphabet) */
+	case 0xc:
+	case 0xd:
+		return SMS_ENC_GSM7;
+	/* Message waiting group (UCS2 alphabet) */
+	case 0xe:
+		return SMS_ENC_UCS2;
+	/* Data coding/message class group */
+	case 0xf:
+		return (dcs & 0x04) ? SMS_ENC_8BIT : SMS_ENC_GSM7;
+	/* Reserved coding group values - spec says to treat it as default alphabet */
+	default:
+		return SMS_ENC_GSM7;
+	}
+}
+
+unsigned int sms_relative_to_validity(uint8_t relative)
+{
+	if (relative <= 143)
+		return (relative + 1) * 5;
+	if (relative <= 167)
+		return 720 + (relative - 143) * 30;
+	if (relative <= 196)
+		return (relative - 166) * 1440;
+
+	return (relative - 192) * 10080;
+}
+
+uint8_t sms_validity_to_relative(unsigned int validity)
+{
+	unsigned int v;
+
+	if (validity == 0)
+		return 167; /* 24 hours */
+
+	/* 5 minute units up to 12 hours */
+	if (validity <= 720)
+		return (validity + 4) / 5 - 1;
+
+	/* 12 hours + 30 minute units up to 1 day */
+	if (validity <= 1440)
+		return 143 + (validity - 720 + 29) / 30;
+
+	/* 2 days up to 30 days */
+	if (validity <= 43200)
+		return 166 + (validity + 1439) / 1440;
+
+	/* 5 weeks up to 63 weeks */
+	v = (validity + 10079) / 10080;
+	if (v > 63)
+		v = 63;
+
+	return 192 + v;
+}
+
+/*****************************************************************************/
+/* decode */
+
+#define PDU_SIZE_CHECK(required, what)                                                           \
+	do {                                                                                      \
+		if (pdu_len < (size_t)(required)) {                                               \
+			set_err(err, errlen, "PDU too short, %s: %zu < %zu", what, pdu_len,       \
+				(size_t)(required));                                              \
+			goto fail;                                                                \
+		}                                                                                 \
+	} while (0)
+
+static int sms_part_3gpp_decode(unsigned int index, const uint8_t *pdu, size_t pdu_len, bool transfer_route,
+				struct sms_part **out, char *err, size_t errlen)
+{
+	struct sms_part *part = sms_part_new(index, SMS_PDU_UNKNOWN);
+	size_t offset = 0;
+	unsigned int smsc_addr_size_bytes, tp_addr_size_digits, tp_addr_size_bytes;
+	uint8_t pdu_type, validity_format = 0;
+	bool has_udh = false;
+	/* the following offsets are OPTIONAL, as STATUS REPORTs may not have them; 0 is "absent" */
+	size_t tp_pid_offset = 0, tp_dcs_offset = 0, tp_user_data_len_offset = 0;
+	enum sms_encoding user_data_encoding = SMS_ENC_UNKNOWN;
+	char *address;
+
+	if (!part) {
+		set_err(err, errlen, "out of memory");
+		return -1;
+	}
+
+	if (!transfer_route) {
+		/* SMSC, in address format, precedes the TPDU. First byte represents the number of BYTES for the
+		 * address value */
+		PDU_SIZE_CHECK(1, "cannot read SMSC address length");
+		smsc_addr_size_bytes = pdu[offset++];
+		if (smsc_addr_size_bytes > 0) {
+			PDU_SIZE_CHECK(offset + smsc_addr_size_bytes, "cannot read SMSC address");
+			/* SMSC may not be given in DELIVER PDUs */
+			address = decode_address(&pdu[1], smsc_addr_size_bytes, 2 * (smsc_addr_size_bytes - 1));
+			if (!address) {
+				set_err(err, errlen, "Couldn't read SMSC address");
+				goto fail;
+			}
+			part->smsc = address;
+			offset += smsc_addr_size_bytes;
+		}
+	}
+
+	/* TP-MTI (1 byte) */
+	PDU_SIZE_CHECK(offset + 1, "cannot read TP-MTI");
+
+	pdu_type = pdu[offset] & SMS_TP_MTI_MASK;
+	switch (pdu_type) {
+	case SMS_TP_MTI_SMS_DELIVER:
+		part->pdu_type = SMS_PDU_DELIVER;
+		break;
+	case SMS_TP_MTI_SMS_SUBMIT:
+		part->pdu_type = SMS_PDU_SUBMIT;
+		break;
+	case SMS_TP_MTI_SMS_STATUS_REPORT:
+		part->pdu_type = SMS_PDU_STATUS_REPORT;
+		break;
+	default:
+		set_err(err, errlen, "Unhandled message type: 0x%02x", pdu_type);
+		goto fail;
+	}
+
+	/* Delivery report was requested? */
+	if (pdu[offset] & 0x20)
+		part->delivery_report_request = true;
+
+	/* PDU with validity? (only in SUBMIT PDUs) */
+	if (pdu_type == SMS_TP_MTI_SMS_SUBMIT)
+		validity_format = pdu[offset] & 0x18;
+
+	/* PDU with user data header? */
+	if (pdu[offset] & 0x40)
+		has_udh = true;
+
+	offset++;
+
+	/* TP-MR (1 byte, in STATUS_REPORT and SUBMIT PDUs) */
+	if (pdu_type == SMS_TP_MTI_SMS_STATUS_REPORT || pdu_type == SMS_TP_MTI_SMS_SUBMIT) {
+		PDU_SIZE_CHECK(offset + 1, "cannot read message reference");
+		part->message_reference = pdu[offset];
+		offset++;
+	}
+
+	/* TP-DA or TP-OA or TP-RA. First byte represents the number of DIGITS in the number. Round the sender
+	 * address length up to an even number of semi-octets, and thus an integral number of octets. */
+	PDU_SIZE_CHECK(offset + 1, "cannot read number of digits in number");
+	tp_addr_size_digits = pdu[offset++];
+	tp_addr_size_bytes = (tp_addr_size_digits + 1) >> 1;
+
+	if (tp_addr_size_bytes == 0) {
+		set_err(err, errlen, "Couldn't read address: field missing");
+		goto fail;
+	}
+	/* +1 due to the Type of Address byte */
+	PDU_SIZE_CHECK(offset + 1 + tp_addr_size_bytes, "cannot read number");
+	address = decode_address(&pdu[offset], 1 + tp_addr_size_bytes, tp_addr_size_digits);
+	if (!address) {
+		set_err(err, errlen, "Couldn't read address");
+		goto fail;
+	}
+	part->number = address;
+	offset += 1 + tp_addr_size_bytes;
+
+	/* Get timestamps and indexes for TP-PID, TP-DCS and TP-UDL/TP-UD */
+	if (pdu_type == SMS_TP_MTI_SMS_DELIVER) {
+		PDU_SIZE_CHECK(offset + 9, "cannot read PID/DCS/Timestamp"); /* 1+1+7=9 */
+
+		/* TP-PID (1 byte) */
+		tp_pid_offset = offset++;
+		/* TP-DCS (1 byte) */
+		tp_dcs_offset = offset++;
+		/* Timestamp (7 bytes) */
+		part->timestamp = decode_timestamp(&pdu[offset]);
+		offset += 7;
+
+		tp_user_data_len_offset = offset;
+	} else if (pdu_type == SMS_TP_MTI_SMS_SUBMIT) {
+		PDU_SIZE_CHECK(offset + 2 + !!validity_format, "cannot read PID/DCS/Validity"); /* 1+1=2 */
+
+		/* TP-PID (1 byte) */
+		tp_pid_offset = offset++;
+		/* TP-DCS (1 byte) */
+		tp_dcs_offset = offset++;
+
+		/* TP-Validity-Period */
+		if (validity_format) {
+			switch (validity_format) {
+			case 0x10:
+				/* relative format */
+				part->validity_relative = sms_relative_to_validity(pdu[offset]);
+				offset++;
+				break;
+			default:
+				/* enhanced (0x08) and absolute (0x18) formats are not decoded: 7 bytes */
+				PDU_SIZE_CHECK(offset + 7, "cannot read validity");
+				offset += 7;
+				break;
+			}
+		}
+
+		tp_user_data_len_offset = offset;
+	} else {
+		/* We have 2 timestamps in status report PDUs: first, the timestamp for when the PDU was received
+		 * in the SMSC, second, the timestamp for when the PDU was forwarded by the SMSC */
+		PDU_SIZE_CHECK(offset + 15, "cannot read Timestamps/TP-STATUS"); /* 7+7+1=15 */
+
+		part->timestamp = decode_timestamp(&pdu[offset]);
+		offset += 7;
+		part->discharge_timestamp = decode_timestamp(&pdu[offset]);
+		offset += 7;
+
+		/* TP-STATUS (1 byte) */
+		part->delivery_state = pdu[offset];
+		offset++;
+
+		/* TP-PI (1 byte) OPTIONAL */
+		if (offset < pdu_len) {
+			size_t next_optional_field_offset = offset + 1;
+
+			/* TP-PID? */
+			if (pdu[offset] & 0x01)
+				tp_pid_offset = next_optional_field_offset++;
+			/* TP-DCS? */
+			if (pdu[offset] & 0x02)
+				tp_dcs_offset = next_optional_field_offset++;
+			/* TP-UserData? */
+			if (pdu[offset] & 0x04)
+				tp_user_data_len_offset = next_optional_field_offset;
+		}
+	}
+
+	if (tp_pid_offset > 0)
+		PDU_SIZE_CHECK(tp_pid_offset + 1, "cannot read TP-PID");
+
+	/* Grab user data encoding and message class */
+	if (tp_dcs_offset > 0) {
+		PDU_SIZE_CHECK(tp_dcs_offset + 1, "cannot read TP-DCS");
+
+		/* Encoding given in the 'alphabet' bits */
+		user_data_encoding = encoding_type(pdu[tp_dcs_offset]);
+		part->encoding = user_data_encoding;
+
+		/* Class */
+		if (pdu[tp_dcs_offset] & SMS_DCS_CLASS_VALID)
+			part->class = pdu[tp_dcs_offset] & SMS_DCS_CLASS_MASK;
+	}
+
+	if (tp_user_data_len_offset > 0) {
+		unsigned int tp_user_data_size_elements, tp_user_data_size_bytes;
+		size_t tp_user_data_offset;
+		unsigned int bit_offset = 0;
+
+		PDU_SIZE_CHECK(tp_user_data_len_offset + 1, "cannot read TP-UDL");
+		tp_user_data_size_elements = pdu[tp_user_data_len_offset];
+
+		if (user_data_encoding == SMS_ENC_GSM7)
+			tp_user_data_size_bytes = (7 * (tp_user_data_size_elements + 1)) / 8;
+		else
+			tp_user_data_size_bytes = tp_user_data_size_elements;
+
+		tp_user_data_offset = tp_user_data_len_offset + 1;
+		PDU_SIZE_CHECK(tp_user_data_offset + tp_user_data_size_bytes, "cannot read TP-UD");
+
+		if (has_udh) {
+			unsigned int udhl, udhl_elements;
+			size_t end, i;
+
+			PDU_SIZE_CHECK(tp_user_data_offset + 1, "cannot read UDH length");
+			udhl = pdu[tp_user_data_offset] + 1;
+			end = tp_user_data_offset + udhl;
+
+			PDU_SIZE_CHECK(tp_user_data_offset + udhl, "cannot read UDH");
+			if (udhl > tp_user_data_size_bytes) {
+				set_err(err, errlen, "udhl length (%u) is greater than data size (%u)", udhl,
+					tp_user_data_size_bytes);
+				goto fail;
+			}
+
+			for (i = tp_user_data_offset + 1; (i + 1) < end;) {
+				uint8_t ie_id = pdu[i++];
+				uint8_t ie_len = pdu[i++];
+
+				switch (ie_id) {
+				case 0x00:
+					if (i + 2 >= end)
+						break;
+					/* Ignore the IE if one of the following is true: it claims to be part 0 of M,
+					 * or it claims to be part N of M, N > M */
+					if (pdu[i + 2] == 0 || pdu[i + 2] > pdu[i + 1])
+						break;
+
+					part->should_concat = true;
+					part->concat_reference = pdu[i];
+					part->concat_max = pdu[i + 1];
+					part->concat_sequence = pdu[i + 2];
+					break;
+				case 0x08:
+					if (i + 3 >= end)
+						break;
+					/* Concatenated short message, 16-bit reference */
+					if (pdu[i + 3] == 0 || pdu[i + 3] > pdu[i + 2])
+						break;
+
+					part->should_concat = true;
+					part->concat_reference = (pdu[i] << 8) | pdu[i + 1];
+					part->concat_max = pdu[i + 2];
+					part->concat_sequence = pdu[i + 3];
+					break;
+				default:
+					break;
+				}
+
+				i += ie_len;
+			}
+
+			/* Move past the user data headers to prevent it from being decoded into garbage text */
+			tp_user_data_offset += udhl;
+			tp_user_data_size_bytes -= udhl;
+			if (user_data_encoding == SMS_ENC_GSM7) {
+				/* Find the number of bits we need to add to the length of the user data to get a
+				 * multiple of 7 (the padding) */
+				bit_offset = (7 - udhl % 7) % 7;
+				udhl_elements = (udhl * 8 + bit_offset) / 7;
+			} else {
+				udhl_elements = udhl;
+			}
+
+			if (udhl_elements > tp_user_data_size_elements) {
+				set_err(err, errlen, "udhl length (%u) is greater than data size (%u)", udhl_elements,
+					tp_user_data_size_elements);
+				goto fail;
+			}
+			tp_user_data_size_elements -= udhl_elements;
+		}
+
+		switch (user_data_encoding) {
+		case SMS_ENC_GSM7: {
+			uint8_t *unpacked = malloc(tp_user_data_size_elements + 1);
+
+			if (!unpacked)
+				goto fail;
+			/* mm_sms_decode_text() */
+			cs_gsm7_unpack(&pdu[tp_user_data_offset], pdu_len - tp_user_data_offset,
+				       tp_user_data_size_elements, bit_offset, unpacked);
+			part->text = cs_gsm7_to_utf8(unpacked, tp_user_data_size_elements);
+			free(unpacked);
+			if (!part->text)
+				goto fail;
+			break;
+		}
+		case SMS_ENC_UCS2:
+			/* Always assume UTF-16 instead of UCS-2! */
+			part->text = cs_utf16be_to_utf8(&pdu[tp_user_data_offset], tp_user_data_size_elements);
+			if (!part->text)
+				goto fail;
+			break;
+		case SMS_ENC_8BIT:
+		case SMS_ENC_UNKNOWN:
+		default:
+			/* 8-bit encoding is usually binary data, and we have no idea what actual encoding the data
+			 * is in so we can't convert it */
+			PDU_SIZE_CHECK(tp_user_data_offset + tp_user_data_size_bytes, "cannot read user data");
+			part->data = malloc(tp_user_data_size_bytes ? tp_user_data_size_bytes : 1);
+			if (!part->data)
+				goto fail;
+			memcpy(part->data, &pdu[tp_user_data_offset], tp_user_data_size_bytes);
+			part->data_len = tp_user_data_size_bytes;
+			break;
+		}
+	}
+
+	*out = part;
+	return 0;
+
+fail:
+	if (err && errlen && !err[0])
+		set_err(err, errlen, "invalid PDU");
+	sms_part_free(part);
+	return -1;
+}
+
+/*
+ * mm_sms_part_3gpp_new_from_binary_pdu() accepts a @transfer_route flag: an Event Report's transfer-route
+ * message contains a TPDU without the leading SMSC address. The normal parse below follows that rule exactly.
+ *
+ * Some WMS implementations prepend an empty SMSC-length octet anyway (00 + TPDU). In that shape byte 2 is
+ * the TPDU's originating-address length, while it would be a Type-of-Address octet in a normal no-SMSC TPDU.
+ * If it is not a valid Type-of-Address (bit 7 is clear), try the TPDU one byte later. If that does not decode,
+ * continue with the standard no-SMSC parse; valid transfer-route PDUs are never shifted.
+ *
+ * Deviation from MM (firmware quirk fallback): if the no-SMSC parse of a transfer-route message fails, the data
+ * is parsed once more as a full PDU with the SMSC field (like a stored message). A transfer-route TPDU which
+ * decodes is never affected; the first error is reported if the fallback fails too.
+ */
+int sms_part_3gpp_from_pdu(unsigned int index, const uint8_t *pdu, size_t pdu_len, bool transfer_route,
+			   struct sms_part **out, char *err, size_t errlen)
+{
+	char first_err[100];
+	int ret;
+
+	if (transfer_route && pdu_len >= 3 && pdu[0] == 0 && (pdu[1] & SMS_TP_MTI_MASK) != 3 &&
+	    pdu[2] > 0 && pdu[2] <= SMS_ADDRESS_MAX_DIGITS && !(pdu[2] & 0x80)) {
+		if (err && errlen)
+			err[0] = '\0';
+		ret = sms_part_3gpp_decode(index, pdu + 1, pdu_len - 1, true, out, err, errlen);
+		if (!ret)
+			return 0;
+	}
+
+	if (err && errlen)
+		err[0] = '\0';
+	ret = sms_part_3gpp_decode(index, pdu, pdu_len, transfer_route, out, err, errlen);
+	if (!ret || !transfer_route)
+		return ret;
+
+	/* keep the error of the standard parse, try with the SMSC field */
+	snprintf(first_err, sizeof(first_err), "%s", err ? err : "");
+	if (err && errlen)
+		err[0] = '\0';
+	if (!sms_part_3gpp_decode(index, pdu, pdu_len, false, out, err, errlen))
+		return 0;
+	if (err && errlen)
+		set_err(err, errlen, "%s", first_err);
+	return -1;
+}
+
+/*****************************************************************************/
+/* encode */
+
+int sms_part_3gpp_get_submit_pdu(const struct sms_part *part, uint8_t *pdu, size_t *pdulen, char *err,
+				 size_t errlen)
+{
+	size_t offset = 0, udl_pos;
+	unsigned int len, shift = 0;
+	bool concat = part->concat_sequence != 0;
+
+	if (part->pdu_type != SMS_PDU_SUBMIT) {
+		set_err(err, errlen, "Invalid PDU type to generate a 'submit' PDU");
+		return -1;
+	}
+	if (!part->number || (!part->text && !part->data)) {
+		set_err(err, errlen, "The part needs a number and a text or data");
+		return -1;
+	}
+
+	memset(pdu, 0, SMS_PDU_MAX);
+
+	if (part->smsc) {
+		len = sms_part_3gpp_encode_address(part->smsc, pdu, SMS_PDU_MAX, true);
+		if (len == 0) {
+			set_err(err, errlen, "Invalid SMSC address '%s'", part->smsc);
+			return -1;
+		}
+		offset += len;
+	} else {
+		/* No SMSC, use default */
+		pdu[offset++] = 0x00;
+	}
+
+	/* First BYTE */
+	pdu[offset] = 0;
+
+	/* TP-VP present; format RELATIVE */
+	if (part->validity_relative > 0)
+		pdu[offset] |= 0x10;
+
+	/* Concatenation sequence only found in multipart SMS */
+	if (concat)
+		pdu[offset] |= 0x40; /* UDHI */
+
+	/* Delivery report requested in singlepart messages or in the last PDU of multipart messages */
+	if (part->delivery_report_request && (!concat || part->concat_max == part->concat_sequence))
+		pdu[offset] |= 0x20;
+
+	/* TP-MTI = SMS-SUBMIT */
+	pdu[offset++] |= 0x01;
+
+	/* TP-MR (1 byte): filled by device */
+	pdu[offset++] = 0x00;
+
+	/* Destination address */
+	len = sms_part_3gpp_encode_address(part->number, &pdu[offset], SMS_PDU_MAX - offset, false);
+	if (len == 0) {
+		set_err(err, errlen, "Invalid number '%s'", part->number);
+		return -1;
+	}
+	offset += len;
+
+	/* TP-PID (1 byte) */
+	pdu[offset++] = 0x00;
+
+	/* TP-DCS (1 byte) */
+	pdu[offset] = 0x00;
+	if (part->class >= 0 && part->class <= 3) {
+		pdu[offset] |= SMS_DCS_CLASS_VALID;
+		pdu[offset] |= part->class;
+	}
+
+	switch (part->encoding) {
+	case SMS_ENC_UCS2:
+		pdu[offset] |= SMS_DCS_CODING_UCS2;
+		break;
+	case SMS_ENC_GSM7:
+		pdu[offset] |= SMS_DCS_CODING_DEFAULT;
+		break;
+	case SMS_ENC_8BIT:
+	case SMS_ENC_UNKNOWN:
+	default:
+		pdu[offset] |= SMS_DCS_CODING_8BIT;
+		break;
+	}
+	offset++;
+
+	/* TP-Validity-Period (1 byte), only if TP-VPF was set in first byte */
+	if (part->validity_relative > 0)
+		pdu[offset++] = sms_validity_to_relative(part->validity_relative);
+
+	/* TP-User-Data-Length: set later */
+	udl_pos = offset++;
+
+	/* Build UDH */
+	if (concat) {
+		pdu[offset++] = 0x05; /* udh len */
+		pdu[offset++] = 0x00; /* mid */
+		pdu[offset++] = 0x03; /* data len */
+		pdu[offset++] = (uint8_t)part->concat_reference;
+		pdu[offset++] = (uint8_t)part->concat_max;
+		pdu[offset++] = (uint8_t)part->concat_sequence;
+
+		/* if a UDH is present and the data encoding is the default 7-bit alphabet, the user data must be
+		 * 7-bit word aligned after the UDH. This means up to 6 bits of zeros need to be inserted at the
+		 * start of the message. In our case the UDH is 6 bytes long, 48bits. The next multiple of 7 is
+		 * therefore 49, so we only need to include one bit of padding. */
+		shift = 1;
+	}
+
+	if (part->encoding == SMS_ENC_GSM7) {
+		size_t n = 0, packlen;
+		uint8_t *unpacked;
+
+		if (!part->text) {
+			set_err(err, errlen, "Failed to convert message text to GSM");
+			return -1;
+		}
+		unpacked = cs_gsm7_from_utf8(part->text, &n);
+		if (!unpacked || n == 0) {
+			free(unpacked);
+			set_err(err, errlen, "Failed to convert message text to GSM");
+			return -1;
+		}
+
+		/* Set real data length, in septets. If we had UDH, add 7 septets */
+		if (n + (concat ? 7 : 0) > 255 || offset + (n * 7 + shift + 7) / 8 > SMS_PDU_MAX) {
+			free(unpacked);
+			set_err(err, errlen, "Packed user data is too large for PDU");
+			return -1;
+		}
+		pdu[udl_pos] = concat ? 7 + n : n;
+
+		packlen = cs_gsm7_pack(unpacked, n, shift, &pdu[offset]);
+		free(unpacked);
+		offset += packlen;
+	} else if (part->encoding == SMS_ENC_UCS2) {
+		size_t n = 0;
+		uint8_t *utf16;
+
+		if (!part->text) {
+			set_err(err, errlen, "Failed to convert message text to UTF-16");
+			return -1;
+		}
+		/* Always assume UTF-16 instead of UCS-2! */
+		utf16 = cs_utf8_to_utf16be(part->text, &n);
+		if (!utf16 || n == 0) {
+			free(utf16);
+			set_err(err, errlen, "Failed to convert message text to UTF-16");
+			return -1;
+		}
+
+		/* Set real data length, in octets. If we had UDH, add 6 octets */
+		if (offset + n > SMS_PDU_MAX || n + (concat ? 6 : 0) > 255) {
+			free(utf16);
+			set_err(err, errlen, "User data is too large for PDU");
+			return -1;
+		}
+		pdu[udl_pos] = concat ? 6 + n : n;
+		memcpy(&pdu[offset], utf16, n);
+		free(utf16);
+		offset += n;
+	} else {
+		if (!part->data) {
+			set_err(err, errlen, "The part has no data");
+			return -1;
+		}
+		/* Set real data length, in octets. If we had UDH, add 6 octets */
+		if (offset + part->data_len > SMS_PDU_MAX || part->data_len + (concat ? 6 : 0) > 255) {
+			set_err(err, errlen, "User data is too large for PDU");
+			return -1;
+		}
+		pdu[udl_pos] = concat ? 6 + part->data_len : part->data_len;
+		memcpy(&pdu[offset], part->data, part->data_len);
+		offset += part->data_len;
+	}
+
+	*pdulen = offset;
+	return 0;
+}
+
+/*****************************************************************************/
+/* splitting */
+
+int sms_split_text(const char *text, bool *gsm7, struct sms_chunk **chunks, size_t *n_chunks)
+{
+	size_t len = strlen(text), pos = 0, total = 0, chunk_len = 0, chunk_start = 0, n = 0;
+	struct sms_chunk *c;
+	bool is_gsm7;
+	uint32_t cp;
+
+	if (!cs_utf8_valid(text))
+		return -1;
+
+	is_gsm7 = cs_gsm7_can_encode(text);
+	*gsm7 = is_gsm7;
+
+	/* every character is at least one byte of the text: a chunk per character is the maximum */
+	c = calloc(len + 1, sizeof(*c));
+	if (!c)
+		return -1;
+
+	/* Chunks: with more than one the user data of a part is 140 - 6 = 134 bytes, which are up to 153 GSM7
+	 * characters (134 * 8 = 1072; 1072 / 7 = 153.14), or 67 UCS2 characters. A single part is up to 160 GSM7
+	 * septets or 140 bytes of UTF-16. */
+	while (pos < len) {
+		size_t cl = cs_utf8_decode(text + pos, len - pos, &cp);
+		unsigned int w = is_gsm7 ? cs_gsm7_char_len(cp) : cs_utf16_len(cp);
+		unsigned int max = is_gsm7 ? 153 : 134;
+
+		if (chunk_len + w > max) {
+			c[n].off = chunk_start;
+			c[n].len = pos - chunk_start;
+			n++;
+			chunk_start = pos;
+			chunk_len = w;
+		} else {
+			chunk_len += w;
+		}
+
+		total += w;
+		pos += cl;
+	}
+
+	/* No splitting needed? */
+	if (total <= (is_gsm7 ? 160u : 140u)) {
+		c[0].off = 0;
+		c[0].len = len;
+		*chunks = c;
+		*n_chunks = 1;
+		return 0;
+	}
+
+	/* Otherwise add the last one */
+	c[n].off = chunk_start;
+	c[n].len = pos - chunk_start;
+	n++;
+
+	*chunks = c;
+	*n_chunks = n;
+	return 0;
+}
+
+int sms_split_data(size_t data_len, struct sms_chunk **chunks, size_t *n_chunks)
+{
+	struct sms_chunk *c;
+	size_t n, i;
+
+	if (data_len <= 140) {
+		n = 1;
+	} else {
+		n = data_len / 134;
+		if (data_len % 134)
+			n++;
+	}
+
+	c = calloc(n, sizeof(*c));
+	if (!c)
+		return -1;
+
+	for (i = 0; i < n; i++) {
+		if (data_len <= 140) {
+			c[i].off = 0;
+			c[i].len = data_len;
+		} else {
+			c[i].off = i * 134;
+			c[i].len = data_len - i * 134 < 134 ? data_len - i * 134 : 134;
+		}
+	}
+
+	*chunks = c;
+	*n_chunks = n;
+	return 0;
+}

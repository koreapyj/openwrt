+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WDS_UTIL_H
+#define __WDS_UTIL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct wds_name {
+	const char *name;
+	int val;
+};
+
+/* name tables (the CLI order is kept; values are the QMI values) */
+extern const struct wds_name wds_ip_family_names[];
+extern const unsigned int wds_ip_family_names_n;
+extern const struct wds_name wds_pdp_type_names[];
+extern const unsigned int wds_pdp_type_names_n;
+extern const struct wds_name wds_auth_names[];
+extern const unsigned int wds_auth_names_n;
+
+/* name -> value in a table above; false if not found */
+bool wds_name_to_val(const struct wds_name *tbl, unsigned int n, const char *name, bool icase, int *val);
+
+/* value -> name in a table above, NULL if not found */
+const char *wds_val_to_name(const struct wds_name *tbl, unsigned int n, int val);
+
+/* QMI_SIO_PORT_A2_MUX_RMNET<n> for n 0..7, -1 otherwise */
+int wds_sio_port_a2_mux_rmnet(int n);
+
+/* "a2-mux-rmnet<0-7>" (any case) or a SIO port number (1..0xffff, strtoul base 0); false if invalid */
+bool wds_sio_port_parse(const char *arg, uint16_t *port);
+
+/* address of a QMI host-order uint32 / 8 host-order uint16 words; returns buf */
+char *wds_ipv4_to_str(uint32_t addr, char *buf, size_t len);
+char *wds_ipv6_to_str(const uint16_t *words, char *buf, size_t len);
+
+/* number of leading one bits of a host-order netmask */
+unsigned int wds_netmask_to_prefix(uint32_t mask);
+
+#endif

+bool pdc_id_format(const uint8_t *id, unsigned int len, char str[PDC_ID_STR_MAX]);
+
+/* an empty id never matches */
+bool pdc_id_equal(const uint8_t *a, unsigned int a_n, const uint8_t *b, unsigned int b_n);
+
+/*
+ * The id of a configuration is the SHA1 of the whole file (like qmicli); id has to hold at least
+ * PDC_ID_MAX bytes, returns the id length

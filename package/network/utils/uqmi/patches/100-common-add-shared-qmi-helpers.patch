+ * Boston, MA 02110-1301 USA.
+ */
+
+#include <string.h>
+
+#include "sha1.h"
+
+#define ROL(_x, _n) (((_x) << (_n)) | ((_x) >> (32 - (_n))))
+
+static void sha1_block(uint32_t state[5], const uint8_t *p)
+{
+	uint32_t w[80], a, b, c, d, e, f, k, t;
+	int i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = (uint32_t)p[i * 4] << 24 | (uint32_t)p[i * 4 + 1] << 16 |
+		       (uint32_t)p[i * 4 + 2] << 8 | p[i * 4 + 3];
+	for (; i < 80; i++)
+		w[i] = ROL(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+
+	a = state[0]; b = state[1]; c = state[2]; d = state[3]; e = state[4];
+
+	for (i = 0; i < 80; i++) {
+		if (i < 20) {
+			f = (b & c) | (~b & d);
+			k = 0x5a827999;
+		} else if (i < 40) {
+			f = b ^ c ^ d;
+			k = 0x6ed9eba1;
+		} else if (i < 60) {
+			f = (b & c) | (b & d) | (c & d);
+			k = 0x8f1bbcdc;
+		} else {
+			f = b ^ c ^ d;
+			k = 0xca62c1d6;
+		}
+
+		t = ROL(a, 5) + f + e + k + w[i];
+		e = d;
+		d = c;
+		c = ROL(b, 30);
+		b = a;
+		a = t;
+	}
+
+	state[0] += a; state[1] += b; state[2] += c; state[3] += d; state[4] += e;
+}
+
+void sha1(uint8_t digest[SHA1_DIGEST_SIZE], const void *data, size_t len)
+{
+	uint32_t state[5] = { 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0 };
+	const uint8_t *p = data;
+	uint8_t tail[128] = {};
+	uint64_t bits = (uint64_t)len * 8;
+	size_t rem = len % 64;
+	size_t tail_len = rem < 56 ? 64 : 128;
+	size_t i;
+
+	for (i = 0; i + 64 <= len; i += 64)
+		sha1_block(state, p + i);
+
+	memcpy(tail, p + i, rem);
+	tail[rem] = 0x80;
+	for (i = 0; i < 8; i++)
+		tail[tail_len - 1 - i] = bits >> (8 * i);
+
+	sha1_block(state, tail);
+	if (tail_len == 128)
+		sha1_block(state, tail + 64);
+
+	for (i = 0; i < SHA1_DIGEST_SIZE; i++)
+		digest[i] = state[i / 4] >> (24 - 8 * (i % 4));
+}
